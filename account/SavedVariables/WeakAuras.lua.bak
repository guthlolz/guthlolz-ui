["displayText_format_c2_abbreviate"] = false,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["custom_type"] = "stateupdate",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(allstates, event, boss, mode, wave, composition)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            icon = 134301,\n            text = aura_env.buildWaveText({\n                    {count = 10, name = \"Ghouls\"},\n                    {count = 4, name = \"Crypt Fiends\"},\n                    {count = 2, name = \"Necromancers\"},\n                    {count = 6, name = \"Abominations\"},\n                    {count = 1, name = \"Frost Wyrm\"},\n            }),\n        }\n        return true\n    end\n    \n    if event == \"STATUS\" then\n        aura_env.throttle = GetTime() + 3\n        return false\n    end\n    \n    if aura_env.throttle and GetTime() < aura_env.throttle then\n        return false\n    end\n    \n    if event == \"WA_FJI_HYJAL_WAVE\" and mode == \"current\" and composition then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            autoHide = true,\n            duration = 3.5,\n            expirationTime = GetTime() + 3.5,\n            wave = wave,\n            boss = boss,\n            text = aura_env.buildWaveText(composition),\n        }\n        return true\n    end\nend",
