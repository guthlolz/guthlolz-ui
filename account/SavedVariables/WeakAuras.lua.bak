["shadowYOffset"] = -1,
["displayText_format_p_time_precision"] = 1,
["desaturateBackground"] = false,
["cooldownSwipe"] = true,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "OPTIONS NAME_PLATE_UNIT_ADDED NAME_PLATE_UNIT_REMOVED WA_SUPREMUS_TARGET_CHECK WA_SUPREMUS_KITE_PHASE WA_SUPREMUS_TANK_PHASE ENCOUNTER_END WA_FJI_ENCOUNTER_END",
["spellIds"] = {
},
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        if aura_env.ticker then\n            aura_env.ticker:Cancel()\n            aura_env.ticker = nil\n        end\n        \n        allstates[\"nameplate1\"] = {\n            show = true,\n            changed = true,\n            unit = \"nameplate1\",\n            target = \"player\",\n            targetGUID = WeakAuras.myGUID,\n            progressType = \"timed\",\n            duration = 13,\n            expirationTime = GetTime() + 13,\n        }\n        return true\n    end\n    \n    if event == \"NAME_PLATE_UNIT_REMOVED\" then\n        local unit = ...\n        if allstates[unit] then\n            allstates[unit].show = false\n            allstates[unit].changed = true\n            aura_env.cancelTicker()\n            return true\n        end\n    end\n    \n    if event == \"WA_SUPREMUS_KITE_PHASE\" then\n        aura_env.allow = true\n        \n        for _, plateData in pairs(C_NamePlate.GetNamePlates()) do\n            local unit = plateData.UnitFrame.displayedUnit\n            local guid = unit and UnitGUID(unit)\n            local npcID = select(6, strsplit(\"-\", guid or \"\"))\n            \n            if npcID == \"22898\" then\n                if not aura_env.ticker then\n                    aura_env.ticker = C_Timer.NewTicker(0.1, function()\n                            WeakAuras.ScanEvents(\"WA_SUPREMUS_TARGET_CHECK\")\n                    end)\n                end\n                \n                local unitTarget = unit .. \"target\"\n                local targetUnit = UnitExists(unitTarget) and unitTarget or nil\n                local targetGUID = targetUnit and UnitGUID(targetUnit) or nil\n                \n                allstates[unit] = {\n                    show = true,\n                    changed = true,\n                    unit = unit,\n                    target = targetUnit,\n                    targetGUID = targetGUID,\n                }\n                return true\n            end\n        end\n        return false\n    end\n    \n    if event == \"WA_SUPREMUS_TANK_PHASE\" or event == \"ENCOUNTER_END\" or event == \"WA_FJI_ENCOUNTER_END\" then\n        aura_env.allow = false\n        return\n    end\n    \n    if not aura_env.allow then\n        return false\n    end\n    \n    if event == \"NAME_PLATE_UNIT_ADDED\" then\n        local unit = ...\n        local guid = UnitGUID(unit)\n        local npcID = select(6, strsplit(\"-\", guid or \"\"))\n        \n        if npcID == \"22898\" then\n            if not aura_env.ticker then\n                aura_env.ticker = C_Timer.NewTicker(0.1, function()\n                        WeakAuras.ScanEvents(\"WA_SUPREMUS_TARGET_CHECK\")\n                end)\n            end\n            \n            local unitTarget = unit .. \"target\"\n            local targetUnit = UnitExists(unitTarget) and unitTarget or nil\n            local targetGUID = targetUnit and UnitGUID(targetUnit) or nil\n            \n            allstates[unit] = {\n                show = true,\n                changed = true,\n                unit = unit,\n                target = targetUnit,\n                targetGUID = targetGUID,\n            }\n            return true\n        end\n    end\n    \n    if event == \"WA_SUPREMUS_TARGET_CHECK\" then\n        for unit, state in pairs(allstates) do\n            if state.show and UnitExists(unit) then\n                local unitTarget = unit .. \"target\"\n                local targetUnit = UnitExists(unitTarget) and unitTarget or nil\n                local targetGUID = targetUnit and UnitGUID(targetUnit) or nil\n                \n                state.target = targetUnit\n                state.targetGUID = targetGUID\n                state.changed = true\n            end\n        end\n        return true\n    end\nend",
["check"] = "event",
["subeventPrefix"] = "SPELL",
["custom_hide"] = "timed",
["debuffType"] = "HELPFUL",
