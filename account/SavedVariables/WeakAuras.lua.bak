{
["type"] = "space",
["variableWidth"] = true,
["height"] = 1,
["useHeight"] = false,
["width"] = 1,
},
{
["type"] = "description",
["fontSize"] = "medium",
["text"] = "Setup Teams for the Cubes on Magtheridon. If set, an Overview Aura will show, showing Debuff Status / Channel Activity. Many Raid Groups will want to use the \"Chain Stun\" strategy, so the Aura flexibly supports up to 4 teams. Only 1 team is required to kill the Boss with the 30s debuff nerf.",
["width"] = 2,
},
{
["type"] = "space",
["variableWidth"] = true,
["height"] = 1,
["useHeight"] = false,
["width"] = 1,
},
{
["useName"] = true,
["type"] = "header",
["text"] = "TEAM(s) SETUP",
["width"] = 2,
},
{
["type"] = "description",
["fontSize"] = "medium",
["text"] = "Input your team(s) string below.\n\nFormat:\n1-Name,Name,Name,Name,Name,2-Name,Name,Name,Name,Name\n\nYou can use up to 4 teams.",
["width"] = 2,
},
{
["type"] = "input",
["useDesc"] = true,
["desc"] = "Input string.",
["multiline"] = true,
["name"] = "Teams",
["key"] = "teams",
["default"] = "",
["length"] = 10,
["width"] = 2,
["useLength"] = false,
},
{
["type"] = "description",
["fontSize"] = "medium",
["text"] = "The first Player following the team number will be assigned to the first Mark in the dropdown section below. The second to the second, etc.\n\nExample:\n\n1-Fojji,Enori,Trupster,Joardee,Rumi\n\nFojji is assigned to the |TInterface/TargetingFrame/UI-RaidTargetingIcon_8:14:14|t Mark\nEnori is assigned to the |TInterface/TargetingFrame/UI-RaidTargetingIcon_7:14:14|t Mark\n\nYou can change the Marks here:",
["width"] = 2,
},
{
["width"] = 0.4,
["type"] = "select",
["values"] = {
