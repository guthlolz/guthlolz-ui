["desaturateForeground"] = false,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, unit)\n    if event == \"OPTIONS\" then\n        if aura_env.ticker then\n            aura_env.ticker:Cancel()\n            aura_env.ticker = nil\n        end\n        \n        local rnd = math.random(8,25)\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            range = rnd,\n            isSafe = rnd and (rnd >= 25) or false,\n        }\n        \n        aura_env.updateSafety(allstates)\n        return true\n    end\n    \n    if not _G.FJI_HEALER and not _G.FJI_RANGED then\n        return false\n    end\n    \n    if event == \"NAME_PLATE_UNIT_ADDED\" then\n        local guid = UnitGUID(unit)\n        local npcID = select(6, strsplit(\"-\", guid or \"\"))\n        \n        if npcID == \"21299\" then\n            if not aura_env.ticker then\n                aura_env.ticker = C_Timer.NewTicker(0.2, function()\n                        WeakAuras.ScanEvents(\"WA_WITCH_RANGE_CHECK\")\n                end)\n            end\n            \n            local range = WeakAuras.GetRange(unit)\n            \n            allstates[unit] = {\n                show = true,\n                changed = true,\n                unit = unit,\n                range = range,\n                isSafe = range and (range >= 25) or false,\n            }\n            \n            aura_env.updateSafety(allstates)\n            return true\n        end\n    end\n    \n    if event == \"NAME_PLATE_UNIT_REMOVED\" then\n        if allstates[unit] then\n            allstates[unit].show = false\n            allstates[unit].changed = true\n        end\n        \n        aura_env.checkTicker(allstates)\n        aura_env.updateSafety(allstates)\n        return true\n    end\n    \n    if event == \"WA_WITCH_RANGE_CHECK\" then\n        for unit, state in pairs(allstates) do\n            if state.show and UnitExists(unit) then\n                local range = WeakAuras.GetRange(unit)\n                state.range = range\n                state.isSafe = range and (range >= 25) or false\n                state.changed = true\n            end\n        end\n        \n        aura_env.updateSafety(allstates)\n        return true\n    end\nend",
["spellIds"] = {
},
["events"] = "NAME_PLATE_UNIT_ADDED NAME_PLATE_UNIT_REMOVED WA_WITCH_RANGE_CHECK",
["check"] = "event",
["unit"] = "player",
["custom_hide"] = "timed",
["customVariables"] = "{\n    isSafe = \"bool\", \n    range = \"number\",\n}",
},
["untrigger"] = {
},
},
["disjunctive"] = "any",
["activeTriggerMode"] = -10,
},
["displayText_format_p_format"] = "timed",
["internalVersion"] = 90,
["progressSource"] = {
-1,
"",
},
["animation"] = {
["start"] = {
["type"] = "none",
["easeType"] = "none",
["duration_type"] = "seconds",
["easeStrength"] = 3,
["preset"] = "fade",
},
["main"] = {
["type"] = "none",
["easeType"] = "none",
["duration_type"] = "seconds",
["easeStrength"] = 3,
["preset"] = "pulse",
},
["finish"] = {
["type"] = "none",
["easeType"] = "none",
["duration_type"] = "seconds",
["easeStrength"] = 3,
["preset"] = "fade",
},
},
["customText"] = "",
["justify"] = "CENTER",
["width"] = 32,
["endAngle"] = 360,
["discrete_rotation"] = 0,
["actions"] = {
["start"] = {
},
["finish"] = {
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.unsafe = false\naura_env.edge = false\n\nfunction aura_env.checkTicker(allstates)\n    local active = false\n    for unit, state in pairs(allstates) do\n        if state.show then\n            active = true\n            break\n        end\n    end\n    \n    if not active and aura_env.ticker then\n        aura_env.ticker:Cancel()\n        aura_env.ticker = nil\n    end\nend\n\nfunction aura_env.updateSafety(allstates)\n    local unsafe = false\n    local edge = false\n    \n    for _, state in pairs(allstates) do\n        if state.show then\n            if state.range == 20 then\n                edge = true\n            end\n            \n            if state.isSafe == false then\n                unsafe = true\n                break\n            end\n        end\n    end\n    \n    if edge ~= aura_env.edge then\n        aura_env.edge = edge\n        \n        if edge then\n            WeakAuras.ScanEvents(\"WA_WITCH_EDGE\")\n        else\n            WeakAuras.ScanEvents(\"WA_WITCH_NOT_EDGE\")\n        end\n    end\n    \n    if unsafe ~= aura_env.unsafe then\n        aura_env.unsafe = unsafe\n        \n        if unsafe then\n            WeakAuras.ScanEvents(\"WA_WITCH_NOT_SAFE\")\n        else\n            WeakAuras.ScanEvents(\"WA_WITCH_SAFE\")\n        end\n    end\nend",
["do_custom"] = true,
},
},
