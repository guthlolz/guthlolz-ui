["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.spellID = 41371\naura_env.shellHits = {}\naura_env.soundHandle = nil\naura_env.throttle = 0\n\nfunction aura_env.stopSound(fadeMS)\n    if aura_env.soundHandle then\n        StopSound(aura_env.soundHandle, fadeMS or 0)\n        aura_env.soundHandle = nil\n    end\nend\n\nfunction aura_env.getRandomSound()\n    local sounds = {\n        \"Interface\\\\AddOns\\\\FojjiCore\\\\sound\\\\DinosaurEat.ogg\",\n        \"Interface\\\\AddOns\\\\FojjiCore\\\\sound\\\\RetroShot.ogg\",\n        \"Interface\\\\AddOns\\\\FojjiCore\\\\sound\\\\Heavenly.ogg\",\n        \"Interface\\\\AddOns\\\\FojjiCore\\\\sound\\\\SadTrombone.ogg\",\n        \"Interface\\\\AddOns\\\\FojjiCore\\\\sound\\\\Squish.ogg\",\n    }\n    return sounds[math.random(#sounds)]\nend",
},
