["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 1.995,\n            expirationTime = GetTime() + 1.995,\n            autoHide = true,\n            icon = 135854,\n            hasTarget = true,\n            target = WeakAuras.myGUID,\n            isPlayer = true,\n        }\n        return true\n    end\n    \n    if event == \"WA_COILSKAR_SEACALLER_DIED\" then\n        local guid = ...\n        if allstates[guid] then\n            allstates[guid].show = false\n            allstates[guid].changed = true\n            return true\n        end\n    end\n    \n    if event == \"WA_COILSKAR_GEYSER_TARGET\" then\n        local guid,_,srcGUID = ...\n        \n        allstates[srcGUID] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 1.995,\n            expirationTime = GetTime() + 1.995,\n            autoHide = true,\n            icon = 135854,\n            hasTarget = true,\n            target = guid,\n            isPlayer = guid == WeakAuras.myGUID,\n        }\n        return true\n    end\nend",
