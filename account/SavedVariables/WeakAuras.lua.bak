["GCD History Cast Control"] = {
["iconSource"] = -1,
["wagoID"] = "skeIgJi-X",
["xOffset"] = 0,
["adjustedMax"] = "",
["adjustedMin"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["cooldownSwipe"] = true,
["url"] = "https://wago.io/skeIgJi-X/1",
["icon"] = true,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "event",
["debuffType"] = "HELPFUL",
["names"] = {
},
["event"] = "Health",
["unit"] = "player",
["spellIds"] = {
},
["events"] = "PLAYER_ENTERING_WORLD, UNIT_SPELLCAST_START, UNIT_SPELLCAST_CHANNEL_START, UNIT_SPELLCAST_CHANNEL_STOP, UNIT_SPELLCAST_INTERRUPTED, UNIT_SPELLCAST_FAILED, UNIT_SPELLCAST_FAILED_QUIET, UNIT_SPELLCAST_SUCCEEDED:player, CURRENT_SPELL_CAST_CHANGED",
["custom"] = "function(event, ...)\n    local function getIcon(spellId)\n        local _, _, icon = GetSpellInfo(spellId)\n        return icon\n    end\n\n    local function makeHistoryKey(token, spellId, interrupted)\n        local tokenPart = token and tostring(token) or \"notoken\"\n        local spellPart = spellId and tostring(spellId) or \"nospell\"\n        local interruptPart = interrupted and \"1\" or \"0\"\n        return tokenPart .. \":\" .. spellPart .. \":\" .. interruptPart\n    end\n\n    local function clearCasting()\n        aura_env.casting = false\n        aura_env.icon = nil\n        aura_env.currentSpellId = nil\n        aura_env.currentCastType = nil\n        aura_env.currentToken = nil\n    end\n\n    local function sameCurrent(token, spellId)\n        if token and aura_env.currentToken and token == aura_env.currentToken then\n            return true\n        end\n\n        if spellId and aura_env.currentSpellId and spellId == aura_env.currentSpellId then\n            return true\n        end\n\n        return false\n    end\n\n    local function pushSpell(spellId, interrupted, token)\n        if aura_env.IsBlacklisted(spellId) then\n            return\n        end\n\n        local now = GetTime()\n        local historyKey = makeHistoryKey(token, spellId, interrupted)\n\n        if aura_env.lastHistoryKey == historyKey and (now - aura_env.lastHistoryAt) <= aura_env.historyDedupeWindow then\n            return\n        end\n\n        aura_env.lastHistoryKey = historyKey\n        aura_env.lastHistoryAt = now\n\n        WeakAuras.ScanEvents(\"ANOU_GCDHISTORY_ADD\", aura_env.curRegister, getIcon(spellId), now, interrupted and true or false)\n\n        local xoff = math.max(0, 1 - (now - aura_env.lastT)) * aura_env.iconStep\n        aura_env.lastT = now\n\n        if xoff > 0 then\n            for i = 1, aura_env.maxRegister do\n                if i ~= aura_env.curRegister then\n                    WeakAuras.ScanEvents(\"ANOU_GCDHISTORY_OFFSET\", i, xoff)\n                end\n            end\n        end\n\n        aura_env.curRegister = aura_env.curRegister + 1\n        if aura_env.curRegister > aura_env.maxRegister then\n            aura_env.curRegister = 1\n        end\n    end\n\n    if event == \"PLAYER_ENTERING_WORLD\" then\n        aura_env.playerGUID = UnitGUID(\"player\")\n        aura_env.lastT = 0\n        aura_env.curRegister = 1\n        aura_env.lastHistoryKey = nil\n        aura_env.lastHistoryAt = 0\n        clearCasting()\n        return false\n    end\n\n    if event == \"CURRENT_SPELL_CAST_CHANGED\" then\n        if not UnitCastingInfo(\"player\") and not UnitChannelInfo(\"player\") then\n            clearCasting()\n        end\n        return aura_env.casting\n    end\n\n    if event == \"UNIT_SPELLCAST_START\" then\n        local unit, token, spellId = ...\n\n        if unit == \"player\" and not aura_env.IsBlacklisted(spellId) then\n            aura_env.icon = getIcon(spellId)\n            aura_env.casting = true\n            aura_env.currentSpellId = spellId\n            aura_env.currentCastType = \"cast\"\n            aura_env.currentToken = token\n        end\n\n        return aura_env.casting\n    end\n\n    if event == \"UNIT_SPELLCAST_CHANNEL_START\" then\n        local unit, token, spellId = ...\n\n        if unit == \"player\" and not aura_env.IsBlacklisted(spellId) then\n            aura_env.icon = getIcon(spellId)\n            aura_env.casting = true\n            aura_env.currentSpellId = spellId\n            aura_env.currentCastType = \"channel\"\n            aura_env.currentToken = token\n        end\n\n        return aura_env.casting\n    end\n\n    if event == \"UNIT_SPELLCAST_CHANNEL_STOP\" then\n        local unit, token, spellId = ...\n\n        if unit == \"player\" and sameCurrent(token, spellId) then\n            clearCasting()\n        end\n\n        return aura_env.casting\n    end\n\n    if event == \"UNIT_SPELLCAST_INTERRUPTED\" then\n        local unit, token, spellId = ...\n\n        if unit == \"player\" then\n            token = token or aura_env.currentToken\n            spellId = spellId or aura_env.currentSpellId\n\n            if spellId and not aura_env.IsBlacklisted(spellId) then\n                pushSpell(spellId, true, token)\n            end\n\n            if sameCurrent(token, spellId) then\n                clearCasting()\n            end\n        end\n\n        return aura_env.casting\n    end\n\n    if event == \"UNIT_SPELLCAST_FAILED\" or event == \"UNIT_SPELLCAST_FAILED_QUIET\" then\n        local unit, token, spellId = ...\n\n        if unit == \"player\" and sameCurrent(token, spellId) then\n            clearCasting()\n        end\n\n        return aura_env.casting\n    end\n\n    if event == \"UNIT_SPELLCAST_SUCCEEDED\" then\n        local unit, token, spellId = ...\n\n        if unit ~= \"player\" then\n            return aura_env.casting\n        end\n\n        if aura_env.IsBlacklisted(spellId) then\n            return aura_env.casting\n        end\n\n        pushSpell(spellId, false, token)\n\n        if aura_env.currentCastType == \"cast\" and sameCurrent(token, spellId) then\n            clearCasting()\n        end\n\n        return aura_env.casting\n    end\n\n    return aura_env.casting\nend",
["customIcon"] = "function()\n    return aura_env.icon\nend",
