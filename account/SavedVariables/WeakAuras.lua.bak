["[T4] FojjiCore Check"] = {
["outline"] = "OUTLINE",
["wagoID"] = "ASKpBvm6n",
["authorOptions"] = {
},
["displayText_format_p_time_dynamic_threshold"] = 5,
["customText"] = "",
["yOffset"] = -100,
["anchorPoint"] = "CENTER",
["displayText_format_c_abbreviate_max"] = 8,
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
["do_custom"] = false,
["custom"] = "\n",
["sound"] = "Interface\\AddOns\\WeakAuras\\Media\\Sounds\\BikeHorn.ogg",
["do_sound"] = false,
},
["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.requiredVersion = \"1.6.6\"\naura_env.fojjiVersion = type(_G.FojjiCore_Version) == \"string\" and _G.FojjiCore_Version or nil\n\nfunction aura_env.versionAtLeast(current, required)\n    local function split(ver)\n        local major, minor, patch = string.match(ver or \"0.0.0\", \"^(%d+)%.(%d+)%.(%d+)\")\n        return tonumber(major) or 0, tonumber(minor) or 0, tonumber(patch) or 0\n    end\n    local c1, c2, c3 = split(current)\n    local r1, r2, r3 = split(required)\n    if c1 > r1 then return true end\n    if c1 < r1 then return false end\n    if c2 > r2 then return true end\n    if c2 < r2 then return false end\n    return c3 >= r3\nend\n\naura_env.fojji_url = \"https://www.curseforge.com/wow/addons/fojjicore\"\naura_env.fojji_url_msg = \"|cFF00FFFF|Hurl:\" .. aura_env.fojji_url .. \"|h[\" .. aura_env.fojji_url .. \"]|h|r\"",
},
["finish"] = {
["do_custom"] = false,
["custom"] = "",
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "event",
["custom_hide"] = "timed",
["duration"] = "15",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["unit"] = "player",
["custom"] = "function(event, ...)\n    local _, _, _, difficulty, _, _, _, Id = GetInstanceInfo()\n    \n    if (Id == 544 or Id == 565) then\n        if not C_AddOns.IsAddOnLoaded(\"FojjiCore\") then\n            print(\"|cFFFF0000WARNING!|r\")\n            print(\"|cFF40C7EBFojjiCore|r Missing.\")\n            print(\"You won't have Sounds & Textures and Auras will be broken.\")\n            print(\"Download from:\")\n            print(aura_env.fojji_url_msg)\n            return true\n        end\n        \n        if not aura_env.fojjiVersion or not aura_env.versionAtLeast(aura_env.fojjiVersion, aura_env.requiredVersion) then\n            print(\"|cFFFF0000WARNING!|r\")\n            print(\"|cFF40C7EBFojjiCore|r is outdated (Found v\" .. tostring(aura_env.fojjiVersion or \"?\") ..\n            \", Requires v\" .. aura_env.requiredVersion .. \" or higher).\")\n            print(\"You won't have Sounds & Textures and Auras will be broken.\")\n            print(\"Download from:\")\n            print(aura_env.fojji_url_msg)\n            return true\n        end\n    end\nend",
["events"] = "ZONE_CHANGED_NEW_AREA",
["spellIds"] = {
},
["check"] = "event",
["subeventSuffix"] = "_CAST_START",
["names"] = {
},
