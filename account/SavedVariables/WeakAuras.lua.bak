["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, key, time, count, _, text)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 2.5,\n            expirationTime = GetTime() + 2.5,\n            progressType = \"timed\",\n            icon = 135851,\n            autoHide = true,\n            damage = \"25%\",\n        }\n        return true\n    end\n    if event == \"WA_NUMEN_TIMER\" and key == \"HYDROSS_MARK_FROST\" and time == 0 then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 2.5,\n            expirationTime = GetTime() + 2.5,\n            progressType = \"timed\",\n            icon = 135851,\n            autoHide = true,\n            damage = text,\n            type = \"Frost\",\n        }\n        return true\n    end\n    \n    if event == \"WA_NUMEN_TIMER\" and key == \"HYDROSS_MARK_NATURE\" and time == 0 then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 2.5,\n            expirationTime = GetTime() + 2.5,\n            progressType = \"timed\",\n            icon = 136030,\n            autoHide = true,\n            damage = text,\n            type = \"Nature\",\n        }\n        return true\n    end\nend",
