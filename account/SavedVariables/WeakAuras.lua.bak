["CT:[T5][Leotheras] Whirlwind"] = {
["outline"] = "OUTLINE",
["wagoID"] = "gSs1_GQRl",
["color"] = {
1,
1,
1,
1,
},
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["shadowYOffset"] = -1,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiT5RaidPack/3",
["actions"] = {
["start"] = {
},
["finish"] = {
["custom"] = "aura_env.count = 1\naura_env.nuTimer(nil)\naura_env.preWarnCancel()",
["do_sound"] = false,
["do_message"] = false,
["do_custom"] = true,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.key = \"LEOTHERAS_WHIRLWIND\"\naura_env.count = 1\naura_env.cdStart = 15\naura_env.cdWindow = 27\naura_env.cdP2Start = 18.5\naura_env.cdHumanStart = 15\naura_env.whirlwind = 37640\n\nfunction aura_env.nuTimer(countdown, count)\n    WeakAuras.ScanEvents(\"WA_NUMEN_TIMER\", aura_env.key, countdown, count)\nend\n\nfunction aura_env.updateState(allstates)\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n    }\nend\n\nfunction aura_env.hideState(allstates)\n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\nend\n\nfunction aura_env.preWarn(duration, preWarnTime, count)\n    if not preWarnTime then\n        preWarnTime = 3\n    end\n    \n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\n    \n    aura_env.preWarnTimer = C_Timer.NewTimer(duration - preWarnTime, function()\n            WeakAuras.ScanEvents(\"WA_\" .. aura_env.key .. \"_PREWARN\", preWarnTime, count)\n            aura_env.preWarnTimer = nil\n    end)\nend\n\nfunction aura_env.preWarnCancel()\n    WeakAuras.ScanEvents(\"WA_\" .. aura_env.key .. \"_PREWARN_CANCEL\")\n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\nend",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, eID, subEvent, _, sourceGUID, _, _, _, destGUID, _, _, _, spellId)\n    if event == \"WA_LEOTHERAS_P1_START\" then\n        aura_env.updateState(allstates)\n        aura_env.count = 1\n        aura_env.p2 = false\n        aura_env.whirlwindCount = 0\n        \n        aura_env.preWarn(aura_env.cdStart, 3, aura_env.count)\n        aura_env.nuTimer(aura_env.cdStart, aura_env.count)\n        return true\n        \n    elseif event == \"WA_FJI_ENCOUNTER_END\" or event == \"ENCOUNTER_END\" or event == \"WA_LEOTHERAS_DEMON_START\" then\n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        return true\n        \n    elseif event == \"WA_LEOTHERAS_P2_START\" then\n        aura_env.p2 = true\n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        aura_env.preWarn(aura_env.cdP2Start, 3, aura_env.count)\n        aura_env.nuTimer(aura_env.cdP2Start, aura_env.count)\n        return true\n        \n    elseif event == \"WA_LEOTHERAS_HUMAN_START\" then\n        aura_env.preWarn(aura_env.cdHumanStart, 3, aura_env.count)\n        aura_env.nuTimer(aura_env.cdHumanStart, aura_env.count)\n        return true\n    end\n    \n    if spellId ~= aura_env.whirlwind then\n        return false\n    end\n    \n    if subEvent == \"SPELL_AURA_APPLIED\" then\n        aura_env.nuTimer(0, aura_env.count)\n        aura_env.count = aura_env.count + 1\n        \n        if not aura_env.p2 then\n            aura_env.whirlwindCount = aura_env.whirlwindCount + 1\n            \n            if aura_env.whirlwindCount < 3 then\n                aura_env.preWarn(aura_env.cdWindow, 3, aura_env.count)\n                aura_env.nuTimer(aura_env.cdWindow, aura_env.count)\n            end\n        else\n            aura_env.preWarn(aura_env.cdWindow, 3, aura_env.count)\n            aura_env.nuTimer(aura_env.cdWindow, aura_env.count)\n        end\n        return true\n    end\nend",
["spellIds"] = {
},
["events"] = "WA_FJI_ENCOUNTER_END, ENCOUNTER_END, CLEU:SPELL_AURA_APPLIED, WA_LEOTHERAS_P1_START, WA_LEOTHERAS_DEMON_START, WA_LEOTHERAS_HUMAN_START, WA_LEOTHERAS_P2_START",
