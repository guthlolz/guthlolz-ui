},
["icon_side"] = "RIGHT",
["xOffset"] = 0,
["preferToUpdate"] = false,
["sparkHeight"] = 30,
["adjustedMin"] = "",
["information"] = {
["showNilIsFalse"] = true,
["forceEvents"] = true,
},
["sparkRotationMode"] = "AUTO",
["semver"] = "1.0.47",
["actions"] = {
["start"] = {
["do_glow"] = false,
["do_custom"] = false,
},
["init"] = {
["custom"] = "local swingRegion = WeakAuras.GetRegion(\"[LvL]  MainHand Swing Bar (Twist)\")\nlocal swingBar = swingRegion and swingRegion.bar\n\naura_env.swingBar = swingBar\naura_env.swingSpeed = UnitAttackSpeed(\"player\") or 2.0\naura_env.swingExpiration = 0\n\naura_env.UpdateGCDTick = function()\n    local bar = aura_env.swingBar\n    if not bar then return end\n    \n    local w = bar:GetWidth()\n    local h = bar:GetHeight()\n    if w <= 0 then return end\n    \n    local now = GetTime()\n    \n    local start, duration = GetSpellCooldown(29515)\n    if not start or duration == 0 then\n        if aura_env.gcdTick then aura_env.gcdTick:Hide() end\n        return\n    end\n    local gcd_remaining = (start + duration) - now\n    if gcd_remaining <= 0 then\n        if aura_env.gcdTick then aura_env.gcdTick:Hide() end\n        return\n    end\n    \n    if aura_env.swingExpiration == 0 then\n        if aura_env.gcdTick then aura_env.gcdTick:Hide() end\n        return\n    end\n    \n    local speed = aura_env.swingSpeed\n    if speed <= 0 then speed = 1 end\n    \n    local swingRemaining = aura_env.swingExpiration - now\n    local swingElapsed\n    if swingRemaining <= 0 then\n        swingElapsed = 0\n    else\n        swingElapsed = speed - swingRemaining\n        if swingElapsed < 0 then swingElapsed = 0 end\n    end\n    \n    local gcd_end = (swingElapsed + gcd_remaining) / speed\n    if gcd_end > 1 then\n        gcd_end = gcd_end - 1\n    end\n    \n    if not aura_env.gcdTick then\n        aura_env.gcdTick = CreateFrame(\"Frame\", nil, bar)\n        aura_env.gcdTick:SetFrameLevel(bar:GetFrameLevel() - 1)\n        aura_env.gcdTick.bg = aura_env.gcdTick:CreateTexture(nil, \"ARTWORK\")\n        aura_env.gcdTick.bg:SetAllPoints(aura_env.gcdTick)\n    end\n    \n    aura_env.gcdTick:SetFrameLevel(bar:GetFrameLevel() - 1)\n    aura_env.gcdTick.bg:SetDrawLayer(\"ARTWORK\")\n    aura_env.gcdTick.bg:SetColorTexture(0.6, 0.2, 1, 1)\n    aura_env.gcdTick:SetHeight(h)\n    aura_env.gcdTick:SetWidth(2)\n    aura_env.gcdTick:ClearAllPoints()\n    aura_env.gcdTick:SetPoint(\"LEFT\", bar, \"LEFT\", w * gcd_end, 0)\n    aura_env.gcdTick:Show()\nend\n\naura_env.HideGCDTick = function()\n    if aura_env.gcdTick then aura_env.gcdTick:Hide() end\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "aura_env.HideGCDTick()",
["do_custom"] = true,
},
},
