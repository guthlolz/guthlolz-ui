["triggers"] = {
{
["trigger"] = {
["customVariables"] = "{\n    expirationTime = true\n}",
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_type"] = "stateupdate",
["unit"] = "player",
["duration"] = "",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"player\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            icon = 132215,\n            duration = 3,\n            expirationTime = GetTime() + 3,\n            unit = \"player\",\n        }\n        return true \n    end\n    \n    if not _G.FJI_TANK and not _G.FJI_HEALER and not UnitIsGroupLeader(\"player\") then\n        return false\n    end\n    \n    if event == \"WA_FJI_ENCOUNTER_START\" or event == \"ENCOUNTER_START\" or event == \"ENCOUNTER_END\" or event == \"WA_FJI_ENCOUNTER_END\" then\n        aura_env.lastHurtful = nil\n        for _, state in pairs(allstates) do\n            state.show = false\n            state.changed = true\n        end\n        return true\n    end\n    \n    if event == \"WA_GRUUL_HURTFUL_TARGET\" or event == \"WA_GRUUL_HURTFUL_TARGET_MISS\" then\n        local _, name = ...\n        aura_env.lastHurtful = name\n        for _, state in pairs(allstates) do\n            state.show = false\n            state.changed = true\n        end\n        return true\n    end\n    \n    if event == \"WA_GRUUL_HURTFUL_STRIKE_PREWARN\" then\n        local duration = ...\n        if aura_env.lastHurtful == nil then\n            return false\n        end\n        \n        if UnitIsDead(aura_env.lastHurtful) then\n            return false\n        end\n        \n        allstates[aura_env.lastHurtful] = {\n            show = true,\n            changed = true,\n            duration = duration,\n            expirationTime = GetTime() + duration,\n            progressType = \"timed\",\n            unit = aura_env.lastHurtful\n        }\n        return true\n    elseif event == \"WA_NUMEN_TIMER\" then\n        local key, time = ...\n        if key == \"GRUUL_HURTFUL_STRIKE\" and (time == 0 or time == nil) then\n            for _, state in pairs(allstates) do\n                state.show = false\n                state.changed = true\n            end\n            return true\n        end\n    elseif event == \"WA_GRUUL_HURTFUL_STRIKE_CANCEL\" then\n        for _, state in pairs(allstates) do\n            state.show = false\n            state.changed = true\n        end\n        return true\n    end\nend",
["events"] = "WA_FJI_ENCOUNTER_START ENCOUNTER_START WA_FJI_ENCOUNTER_END ENCOUNTER_END WA_GRUUL_HURTFUL_TARGET WA_GRUUL_HURTFUL_TARGET_MISS WA_GRUUL_HURTFUL_STRIKE_PREWARN WA_NUMEN_TIMER WA_GRUUL_HURTFUL_STRIKE_CANCEL",
