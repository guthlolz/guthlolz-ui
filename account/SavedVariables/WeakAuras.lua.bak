["init"] = {
["custom"] = "aura_env.poisonNames = {\n    mindnumbing = \"Numb\",\n    instant     = \"Instant\",\n    deadly      = \"Deadly\",\n    wound       = \"Wound\",\n    crippling   = \"Crippling\",\n}\n\naura_env.mindnumbing = {\n    [5237]  = 24, -- Mind-numbing Poison\n    [6951]  = 38, -- Mind-numbing Poison II\n    [9186]  = 52, -- Mind-numbing Poison III\n}\n\naura_env.instant = {\n    [6947]  = 20, -- Instant Poison\n    [6949]  = 28, -- Instant Poison II\n    [6950]  = 36, -- Instant Poison III\n    [8926]  = 44, -- Instant Poison IV\n    [8927]  = 52, -- Instant Poison V\n    [8928]  = 60, -- Instant Poison VI\n    [22053] = 68, -- Instant Poison VII\n}\n\naura_env.crippling = {\n    [3775]  = 20, -- Crippling Poison\n    [3776]  = 50, -- Crippling Poison II\n}\n\naura_env.deadly = {\n    [2892]  = 30, -- Deadly Poison\n    [2893]  = 38, -- Deadly Poison II\n    [8984]  = 46, -- Deadly Poison III\n    [8985]  = 54, -- Deadly Poison IV\n    [20844] = 62, -- Deadly Poison V\n    [22054] = 70, -- Deadly Poison VI\n}\n\naura_env.wound = {\n    [10918] = 32, -- Wound Poison\n    [10920] = 40, -- Wound Poison II\n    [10921] = 48, -- Wound Poison III\n    [10922] = 56, -- Wound Poison IV\n    [22055] = 64, -- Wound Poison V\n}",
