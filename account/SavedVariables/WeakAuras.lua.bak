["init"] = {
["custom"] = "aura_env.npcID = \"22250\"\naura_env.pendingCasts = {}\naura_env.assigned = {}\n\nfunction aura_env.getNpcID(guid)\n    local _,_,_,_,_,npcID = strsplit(\"-\", guid)\n    return npcID\nend\n\nfunction aura_env.getNextPendingCast()\n    local now = GetTime()\n    \n    while #aura_env.pendingCasts > 0 do\n        local expire = aura_env.pendingCasts[1]\n        \n        if expire and expire > now then\n            tremove(aura_env.pendingCasts, 1)\n            return expire\n        end\n        \n        tremove(aura_env.pendingCasts, 1)\n    end\nend",
["do_custom"] = true,
},
},
