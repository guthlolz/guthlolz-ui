["parent"] = "[BT] Gurtogg Team #2",
["actions"] = {
["start"] = {
["do_custom"] = false,
},
["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.teamSoaks = {}\naura_env.teamMarks = {}\naura_env.encounterActive = false\naura_env.timer = nil\naura_env.currentCount = nil\naura_env.expirationTime = nil\n\nlocal TEAM = {}\nlocal teamNumber = 2\nlocal PRE_SOAK_TIME = 5\nlocal TIMER_KEY = \"GURTOGG_BLOODBOIL\"\nlocal ENCOUNTER_ID = 605\n\nlocal function CancelTimer()\n    if aura_env.timer then\n        aura_env.timer:Cancel()\n        aura_env.timer = nil\n    end\nend\n\nlocal function HideStates(allStates)\n    for _,state in pairs(allStates) do\n        state.show = false\n        state.changed = true\n    end\n    return true\nend\n\nlocal function ResetData()\n    wipe(aura_env.teamSoaks)\n    wipe(aura_env.teamMarks)\n    wipe(TEAM)\n    CancelTimer()\n    aura_env.currentCount = nil\n    aura_env.expirationTime = nil\nend\n\nlocal function IsMeInTeam()\n    for _,guid in ipairs(TEAM) do\n        if guid == WeakAuras.myGUID then\n            return true\n        end\n    end\n    return false\nend\n\nlocal function GetTeamCounts(count)\n    local soakAmount = aura_env.teamSoaks[teamNumber]\n    \n    if not soakAmount then\n        return nil\n    end\n    \n    local firstCount = 1\n    local cycleLength = 0\n    \n    for i = 1,3 do\n        if aura_env.teamSoaks[i] then\n            cycleLength = cycleLength + aura_env.teamSoaks[i]\n        end\n    end\n    \n    for i = 1,teamNumber - 1 do\n        if not aura_env.teamSoaks[i] then\n            return nil\n        end\n        \n        firstCount = firstCount + aura_env.teamSoaks[i]\n    end\n    \n    local lastCount = firstCount + soakAmount - 1\n    \n    if not count or cycleLength == 0 then\n        return firstCount,lastCount\n    end\n    \n    local cycle = math.floor((count - 1) / cycleLength)\n    local offset = cycle * cycleLength\n    \n    return firstCount + offset,lastCount + offset\nend\n\nlocal function CreateStateDisplay(allStates,soakAmount)\n    HideStates(allStates)\n    \n    allStates[1] = {\n        show = true,\n        changed = true,\n        isHeader = true,\n        team = teamNumber,\n        soakAmount = soakAmount,\n        soak = false,\n        raidMark = aura_env.teamMarks[teamNumber],\n    }\n    \n    for idx,guid in ipairs(TEAM) do\n        allStates[guid] = {\n            show = true,\n            changed = true,\n            guid = guid,\n            isMe = guid == WeakAuras.myGUID,\n            index = idx,\n            stacks = 0,\n            bloodboil = false,\n            progressType = \"static\",\n            value = 1,\n            total = 1,\n        }\n    end\n    \n    return true\nend\n\nlocal function ScheduleSoak()\n    CancelTimer()\n    \n    if not aura_env.encounterActive or not IsMeInTeam() then\n        return\n    end\n    \n    local count = aura_env.currentCount\n    local expirationTime = aura_env.expirationTime\n    \n    if not count or not expirationTime then\n        return\n    end\n    \n    local firstCount = GetTeamCounts(count)\n    \n    if not firstCount or count ~= firstCount then\n        return\n    end\n    \n    local remaining = expirationTime - GetTime()\n    \n    if remaining <= 0 then\n        return\n    end\n    \n    local delay = remaining - PRE_SOAK_TIME\n    \n    if delay > 0 then\n        aura_env.timer = C_Timer.NewTimer(delay,function()\n                aura_env.timer = nil\n                \n                if not aura_env.encounterActive or not IsMeInTeam() then\n                    return\n                end\n                \n                local first = GetTeamCounts(count)\n                \n                if not first or count ~= first then\n                    return\n                end\n                \n                local time = math.max(0,expirationTime - GetTime())\n                WeakAuras.ScanEvents(\"WA_GURTOGG_BLOODBOIL_SOAK\",time,teamNumber,aura_env.teamMarks[teamNumber])\n        end)\n    else\n        WeakAuras.ScanEvents(\"WA_GURTOGG_BLOODBOIL_SOAK\",remaining,teamNumber,aura_env.teamMarks[teamNumber])\n    end\nend\n\nfunction aura_env.CHAT_MSG_RAID_LEADER(allStates,msg)\n    if msg == \"Bloodboil Soak Teams\" then\n        CancelTimer()\n        wipe(aura_env.teamSoaks)\n        wipe(aura_env.teamMarks)\n        wipe(TEAM)\n        return false\n    end\n    \n    local raidMark,tNum,soakAmount,namesStr = msg:match(\"^({rt[1-8]})TEAM([1-3])%-Soak (%d+)%-(.+)$\")\n    \n    if not tNum then\n        tNum,soakAmount,namesStr = msg:match(\"^TEAM([1-3])%-Soak (%d+)%-(.+)$\")\n    end\n    \n    tNum = tonumber(tNum)\n    soakAmount = tonumber(soakAmount)\n    \n    if not tNum or not soakAmount or not namesStr then\n        return false\n    end\n    \n    aura_env.teamSoaks[tNum] = soakAmount\n    aura_env.teamMarks[tNum] = raidMark\n    \n    if tNum ~= teamNumber then\n        if aura_env.encounterActive then\n            ScheduleSoak()\n        end\n        return false\n    end\n    \n    local nameToGuid = {}\n    \n    for unit in WA_IterateGroupMembers() do\n        local guid = UnitGUID(unit)\n        local name,realm = UnitName(unit)\n        \n        if guid and name then\n            nameToGuid[name] = guid\n            \n            if realm and realm ~= \"\" then\n                nameToGuid[name .. \"-\" .. realm] = guid\n            end\n        end\n    end\n    \n    wipe(TEAM)\n    \n    for _,raw in ipairs({strsplit(\",\",namesStr)}) do\n        local name = strtrim(raw)\n        \n        if name ~= \"\" then\n            local guid = nameToGuid[name]\n            \n            if guid then\n                tinsert(TEAM,guid)\n            end\n        end\n    end\n    \n    if aura_env.encounterActive then\n        ScheduleSoak()\n        return CreateStateDisplay(allStates,soakAmount)\n    end\n    \n    return false\nend\n\nfunction aura_env.WA_NUMEN_TIMER(allStates,key,countdown,count)\n    if key ~= TIMER_KEY then\n        return false\n    end\n    \n    if countdown == nil then\n        CancelTimer()\n        aura_env.currentCount = nil\n        aura_env.expirationTime = nil\n        return false\n    end\n    \n    if not count then\n        return false\n    end\n    \n    if countdown > 0 then\n        aura_env.currentCount = count\n        aura_env.expirationTime = GetTime() + countdown\n        ScheduleSoak()\n        return false\n    end\n    \n    if countdown == 0 then\n        aura_env.currentCount = nil\n        aura_env.expirationTime = nil\n        CancelTimer()\n        \n        if not IsMeInTeam() then\n            return false\n        end\n        \n        local _,lastCount = GetTeamCounts(count)\n        \n        if lastCount and count == lastCount then\n            WeakAuras.ScanEvents(\"WA_GURTOGG_BLOODBOIL_STOP\",count,teamNumber,aura_env.teamMarks[teamNumber])\n        end\n    end\n    \n    return false\nend\n\nfunction aura_env.WA_GURTOGG_BLOODBOIL_SOAK(allStates,time,team,raidMark)\n    if team ~= teamNumber then\n        return false\n    end\n    \n    local state = allStates[1]\n    \n    if not state or not state.isHeader then\n        return false\n    end\n    \n    state.soak = true\n    state.raidMark = raidMark\n    state.changed = true\n    return true\nend\n\nfunction aura_env.WA_GURTOGG_BLOODBOIL_STOP(allStates,count,team,raidMark)\n    if team ~= teamNumber then\n        return false\n    end\n    \n    local state = allStates[1]\n    \n    if not state or not state.isHeader then\n        return false\n    end\n    \n    state.soak = false\n    state.raidMark = raidMark\n    state.changed = true\n    return true\nend\n\nfunction aura_env.WA_GURTOGG_RAGE_PHASE(allStates)\n    local state = allStates[1]\n    \n    if not state or not state.isHeader then\n        return false\n    end\n    \n    state.soak = false\n    state.changed = true\n    return true\nend\n\nfunction aura_env.WA_GURTOGG_BLOODBOIL_APPLIED(allStates,destGUID,amount)\n    local state = allStates[destGUID]\n    \n    if not state then\n        return false\n    end\n    \n    state.progressType = \"timed\"\n    state.duration = 24\n    state.expirationTime = GetTime() + 24\n    state.stacks = amount or 1\n    state.bloodboil = true\n    state.changed = true\n    return true\nend\n\nfunction aura_env.WA_GURTOGG_BLOODBOIL_REMOVED(allStates,destGUID)\n    local state = allStates[destGUID]\n    \n    if not state then\n        return false\n    end\n    \n    state.progressType = \"static\"\n    state.value = 1\n    state.total = 1\n    state.stacks = 0\n    state.bloodboil = false\n    state.changed = true\n    return true\nend\n\nfunction aura_env.UNIT_HEALTH(allStates,unit)\n    local guid = UnitGUID(unit)\n    \n    if not guid then\n        return false\n    end\n    \n    local state = allStates[guid]\n    \n    if not state then\n        return false\n    end\n    \n    local dead = UnitIsDeadOrGhost(unit) and true or false\n    \n    if state.isDead ~= dead then\n        state.isDead = dead\n        state.changed = true\n        return true\n    end\n    \n    return false\nend\n\nlocal function UpdateConnection(allStates,unit)\n    local guid = UnitGUID(unit)\n    \n    if not guid then\n        return false\n    end\n    \n    local state = allStates[guid]\n    \n    if not state then\n        return false\n    end\n    \n    local disconnected = not UnitIsConnected(unit)\n    \n    if state.isDisconnected ~= disconnected then\n        state.isDisconnected = disconnected\n        state.changed = true\n        return true\n    end\n    \n    return false\nend\n\nfunction aura_env.UNIT_FLAGS(allStates,unit)\n    return UpdateConnection(allStates,unit)\nend\n\nfunction aura_env.UNIT_CONNECTION(allStates,unit)\n    return UpdateConnection(allStates,unit)\nend\n\nlocal function EncounterStart(allStates,eID)\n    if eID ~= ENCOUNTER_ID or aura_env.encounterActive then\n        return false\n    end\n    \n    aura_env.encounterActive = true\n    \n    if aura_env.currentCount and aura_env.expirationTime then\n        ScheduleSoak()\n    end\n    \n    return false\nend\n\nfunction aura_env.ENCOUNTER_START(allStates,eID)\n    return EncounterStart(allStates,eID)\nend\n\nfunction aura_env.WA_FJI_ENCOUNTER_START(allStates,eID)\n    return EncounterStart(allStates,eID)\nend\n\nlocal function EncounterEnd(allStates)\n    aura_env.encounterActive = false\n    ResetData()\n    \n    for _,state in pairs(allStates) do\n        state.show = false\n        state.changed = true\n        state.stacks = 0\n        state.bloodboil = false\n    end\n    \n    return true\nend\n\nfunction aura_env.ENCOUNTER_END(allStates)\n    return EncounterEnd(allStates)\nend\n\nfunction aura_env.WA_FJI_ENCOUNTER_END(allStates)\n    return EncounterEnd(allStates)\nend\n\nfunction aura_env.STATUS(allStates)\n    return HideStates(allStates)\nend\n\nfunction aura_env.OPTIONS(allStates)\n    local guid = WeakAuras.myGUID\n    \n    allStates[1] = {\n        show = true,\n        changed = true,\n        isHeader = true,\n        team = teamNumber,\n        soakAmount = 2,\n        soak = false,\n        raidMark = \"{rt4}\",\n    }\n    \n    for i = 2,4 do\n        allStates[i] = {\n            show = true,\n            changed = true,\n            guid = guid,\n            index = i - 1,\n            stacks = math.random(1,3),\n            bloodboil = true,\n            progressType = \"timed\",\n            duration = 24,\n            expirationTime = GetTime() + 24,\n            isMe = i == 2,\n        }\n    end\n    \n    allStates[5] = {\n        show = true,\n        changed = true,\n        guid = guid,\n        index = 4,\n        stacks = 0,\n        bloodboil = false,\n        progressType = \"static\",\n        value = 1,\n        total = 1,\n    }\n    \n    allStates[6] = {\n        show = true,\n        changed = true,\n        guid = guid,\n        index = 5,\n        stacks = 0,\n        bloodboil = false,\n        progressType = \"static\",\n        value = 1,\n        total = 1,\n    }\n    \n    return true\nend",
},
["finish"] = {
