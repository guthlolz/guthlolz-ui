["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "{\n    isSafe = \"bool\", \n    range = \"number\",\n}",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "NAME_PLATE_UNIT_ADDED NAME_PLATE_UNIT_REMOVED WA_BEHEMOTH_RANGE_CHECK PLAYER_TARGET_CHANGED PLAYER_REGEN_ENABLED WA_BEHEMOTH_ABILITIES_DETECT",
["spellIds"] = {
},
["custom"] = "function(allstates,event,unit,...)\n    if event == \"OPTIONS\" then\n        if aura_env.ticker then\n            aura_env.ticker:Cancel()\n            aura_env.ticker = nil\n        end\n        \n        local rnd = math.random(1,35)\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            range = rnd,\n            isSafe = not aura_env.isUnsafeRange(rnd),\n            icon = 132337\n        }\n        \n        aura_env.updateSafety(allstates)\n        return true\n    end\n    \n    if event == \"WA_BEHEMOTH_ABILITIES_DETECT\" then\n        local spell,guid = unit,...\n        if not guid or spell ~= \"Meteor / Comet\" then\n            return false\n        end\n        \n        aura_env.blacklist[guid] = true\n        \n        for stateUnit,state in pairs(allstates) do\n            if stateUnit ~= \"\" and state.guid == guid then\n                state.show = false\n                state.changed = true\n            end\n        end\n        \n        aura_env.checkTicker(allstates)\n        aura_env.updateSafety(allstates)\n        return true\n    end\n    \n    if event == \"PLAYER_REGEN_ENABLED\" then\n        for _,state in pairs(allstates) do\n            state.show = false\n            state.changed = true\n        end\n        \n        wipe(aura_env.blacklist)\n        aura_env.checkTicker(allstates)\n        aura_env.updateSafety(allstates)\n        return true\n    end\n    \n    if event == \"PLAYER_TARGET_CHANGED\" or event == \"STATUS\" then\n        aura_env.checkTicker(allstates)\n        aura_env.updateSafety(allstates)\n        return true\n    end\n    \n    if event == \"NAME_PLATE_UNIT_ADDED\" then\n        if aura_env.isTrackedUnit(unit) then\n            local range = WeakAuras.GetRange(unit)\n            \n            allstates[unit] = {\n                show = true,\n                changed = true,\n                unit = unit,\n                guid = UnitGUID(unit),\n                range = range,\n                isSafe = not aura_env.isUnsafeRange(range),\n                icon = 132337\n            }\n            \n            aura_env.checkTicker(allstates)\n            aura_env.updateSafety(allstates)\n            return true\n        end\n    end\n    \n    if event == \"NAME_PLATE_UNIT_REMOVED\" then\n        if allstates[unit] then\n            allstates[unit].show = false\n            allstates[unit].changed = true\n        end\n        \n        aura_env.checkTicker(allstates)\n        aura_env.updateSafety(allstates)\n        return true\n    end\n    \n    if event == aura_env.events.rangeCheck then\n        for unit,state in pairs(allstates) do\n            if unit ~= \"\" and state.show and UnitExists(unit) then\n                local guid = UnitGUID(unit)\n                \n                if aura_env.blacklist[guid] then\n                    state.show = false\n                    state.changed = true\n                else\n                    local range = WeakAuras.GetRange(unit)\n                    state.range = range\n                    state.isSafe = not aura_env.isUnsafeRange(range)\n                    state.changed = true\n                end\n            end\n        end\n        \n        aura_env.checkTicker(allstates)\n        aura_env.updateSafety(allstates)\n        return true\n    end\nend",
["check"] = "event",
