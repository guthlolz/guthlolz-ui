["[MH] Current Wave Header"] = {
["outline"] = "OUTLINE",
["wagoID"] = "2XzLgw2qF",
["color"] = {
0.40000003576279,
0.78039222955704,
0.90980398654938,
0.80000001192093,
},
["displayText_format_waveCount_format"] = "none",
["customText"] = "function()\n    local state = aura_env.state\n    return string.format(\"(%d/8)\", state.waveCount)\nend",
["yOffset"] = 4,
["anchorPoint"] = "TOPLEFT",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
},
["finish"] = {
},
["init"] = {
["custom"] = "function aura_env.updateState(allstates, waveCount)\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n        waveCount = waveCount,\n    }\n    \n    return true\nend\n\nfunction aura_env.hideState(allstates)\n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\n    \n    return false\nend",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["custom_type"] = "stateupdate",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        return aura_env.updateState(allstates, 5)\n    end\n    \n    if event == \"WA_FJI_HYJAL_WAVE\" then\n        local _, status, waveCount = ...\n        \n        if status == \"spawn\" then\n            return aura_env.hideState(allstates)\n        end\n        \n        if status ~= \"current\" then\n            return false\n        end\n        return aura_env.updateState(allstates, waveCount)\n    end\n    \n    if event == \"WA_FJI_HYJAL_WIPE\" then\n        return aura_env.hideState(allstates)\n    end\n    return false\nend",
["events"] = "ENCOUNTER_START, WA_FJI_HYJAL_WAVE, WA_FJI_HYJAL_WIPE",
["spellIds"] = {
},
["names"] = {
},
["check"] = "event",
["subeventPrefix"] = "SPELL",
["debuffType"] = "HELPFUL",
["customVariables"] = "{\n    usable = \"bool\",\n    name = \"string\",\n}",
