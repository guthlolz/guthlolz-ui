["displayText_format_c1_abbreviate_max"] = 8,
["desaturateBackground"] = false,
["displayText_format_c2_abbreviate"] = false,
["cooldownSwipe"] = true,
["displayText_format_c1_abbreviate"] = false,
["customTextUpdate"] = "event",
["displayText_format_c_realm_name"] = "never",
["desaturateForeground"] = false,
["triggers"] = {
{
["trigger"] = {
["onUpdateThrottle"] = 0.01,
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Combat Log",
["names"] = {
},
["type"] = "custom",
["custom"] = "function(allStates, event, ...)\n    if event == \"WA_FJI_ENCOUNTER_START\" or event == \"ENCOUNTER_START\" then\n        local eID = ...\n        if eID ~= 731 then\n            return false\n        end\n        WeakAuras.WatchForPlayerMoving()\n        aura_env.speed = 0\n        return\n    end\n    \n    local state = allStates[0]\n    \n    if event == \"FRAME_UPDATE\" then\n        if not state then\n            return false\n        end\n        local now = GetTime()\n        state.value = state.value + (now - state.lastFrame) * aura_env.speed\n        state.lastFrame = now\n        state.changed = true\n        return true\n    end\n    \n    if event == \"PLAYER_MOVE_SPEED_UPDATE\" then\n        aura_env.speed = GetUnitSpeed(\"player\")\n        if state and aura_env.speed == 0 and state.value > state.total then\n            state.show = false\n            state.changed = true\n            return true\n        end\n        return false\n    end\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local _,subevent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId,_,_ = ...\n        local npcID = select(6, strsplit(\"-\", sourceGUID or \"\"))\n        if npcID ~= \"19516\" or spellId ~= 34172 or destGUID ~= WeakAuras.myGUID then\n            return false\n        end\n        allStates[0] = {\n            show = true,\n            changed = true,\n            progressType = \"static\",\n            value = 0,\n            total = 20,\n            autoHide = true,\n            duration = 8,\n            expirationTime = GetTime() + 8,\n            lastFrame = GetTime(),\n        }\n        return true\n    end\nend",
["spellIds"] = {
},
["unit"] = "player",
["check"] = "event",
["events"] = "WA_FJI_ENCOUNTER_START ENCOUNTER_START FRAME_UPDATE PLAYER_MOVE_SPEED_UPDATE COMBAT_LOG_EVENT_UNFILTERED:SPELL_CAST_SUCCESS",
["subeventPrefix"] = "SPELL",
["customVariables"] = "{\n    expirationTime = true,\n    duration = true,\n    value = true,\n    total = true,\n}",
},
["untrigger"] = {
},
},
["disjunctive"] = "any",
["customTriggerLogic"] = "",
["activeTriggerMode"] = -10,
},
["sparkRotation"] = 0,
["displayText_format_1.name_format"] = "Unit",
["progressSource"] = {
-1,
"",
},
["animation"] = {
["start"] = {
["colorR"] = 0.97254908084869,
["duration"] = "0.3",
["duration_type"] = "seconds",
["colorA"] = 1,
["alphaType"] = "custom",
["colorB"] = 1,
["colorG"] = 0,
["alphaFunc"] = "",
["easeStrength"] = 5,
["translateType"] = "bounce",
["use_translate"] = true,
["use_alpha"] = false,
["scaleType"] = "pulse",
["type"] = "none",
["preset"] = "bounceDecay",
["easeType"] = "none",
["translateFunc"] = "function(progress, startX, startY, deltaX, deltaY)\n    local bounceDistance = math.sin(progress * math.pi)\n    return startX + (bounceDistance * deltaX), startY + (bounceDistance * deltaY)\nend\n",
["scaley"] = 1.3,
["alpha"] = 1,
["x"] = 1,
["y"] = 0,
["colorType"] = "straightHSV",
["use_color"] = false,
["scaleFunc"] = "function(progress, startX, startY, scaleX, scaleY)\n    local angle = (progress * 2 * math.pi) - (math.pi / 2)\n    return startX + (((math.sin(angle) + 1)/2) * (scaleX - 1)), startY + (((math.sin(angle) + 1)/2) * (scaleY - 1))\nend\n",
["colorFunc"] = "function(progress, r1, g1, b1, a1, r2, g2, b2, a2)\n    return WeakAuras.GetHSVTransition(progress, r1, g1, b1, a1, r2, g2, b2, a2)\nend\n",
["rotate"] = 0,
["use_scale"] = true,
["scalex"] = 1.3,
},
["main"] = {
["translateType"] = "straightTranslate",
["scalex"] = 1,
["colorB"] = 0.52941179275513,
["colorG"] = 0.55686277151108,
["use_translate"] = false,
["colorA"] = 1,
["type"] = "none",
["duration"] = "1",
["easeType"] = "none",
["translateFunc"] = "function(progress, startX, startY, deltaX, deltaY)\n    return startX + (progress * deltaX), startY + (progress * deltaY)\nend\n",
["use_color"] = false,
["alpha"] = 0,
["rotate"] = 0,
["y"] = 0,
["x"] = 0,
["scaley"] = 1,
["duration_type"] = "seconds",
["colorFunc"] = "function(progress, r1, g1, b1, a1, r2, g2, b2, a2)\n    local angle = (progress * 2 * math.pi) - (math.pi / 2)\n    local newProgress = ((math.sin(angle) + 1)/2);\n    return r1 + (newProgress * (r2 - r1)),\n         g1 + (newProgress * (g2 - g1)),\n         b1 + (newProgress * (b2 - b1)),\n         a1 + (newProgress * (a2 - a1))\nend\n",
["easeStrength"] = 3,
["colorType"] = "pulseColor",
["colorR"] = 1,
},
