["subeventPrefix"] = "SPELL",
["spellIds"] = {
},
["custom"] = "function()    \n    local poisonEnchantIDs = {\n        [323]  = true,  -- Instant Poison\n        [324]  = true,  -- Instant Poison II\n        [325]  = true,  -- Instant Poison III\n        [623]  = true,  -- Instant Poison IV\n        [624]  = true,  -- Instant Poison V\n        [625]  = true,  -- Instant Poison VI\n        [2641] = true,  -- Instant Poison VII\n        [3768] = true,  -- Instant Poison VIII\n        [3769] = true,  -- Instant Poison IX\n        [22]   = true,  -- Crippling Poison\n        [603]  = true,  -- Criplling Poison II\n        [35]   = true,  -- Mind-numbing Poison\n        [23]   = true,  -- Mind-numbing Poison II\n        [643]  = true,  -- Mind-numbing Poison III\n        [7]    = true,  -- Deadly Poison \n        [8]    = true,  -- Deadly Poison II\n        [626]  = true,  -- Deadly Poison III\n        [627]  = true,  -- Deadly Poison IV\n        [2630] = true,  -- Deadly Poison V\n        [2642] = true,  -- Deadly Poison VI\n        [2643] = true,  -- Deadly Poison VII\n        [3770 ] = true,  -- Deadly Poison VIII\n        [3771 ] = true,  -- Deadly Poison IX\n        [703]  = true,  -- Wound Poison \n        [704]  = true,  -- Wound Poison II\n        [705]  = true,  -- Wound Poison III\n        [706]  = true,  -- Wound Poison IV  \n        [2644] = true,  -- Wound Poison V\n        [3772 ] = true,  -- Wound Poison VI\n        [3773 ] = true,  -- Wound Poison VII\n        [2640] = true,  -- Anesthetic Poison\n        [3774] = true,  -- Anesthetic Poison\n        [1783] = true,  -- Windfury Totem 1        \n        [563]  = true,  -- Windfury Totem 2       \n        [564]  = true,  -- Windfury Totem 3  \n        [2638] = true,  -- Windfury Totem 4\n        [2639] = true,  -- Windfury Totem 5\n        [40]   = true,  -- Rough Sharpening Stone\n        [13]   = true,  -- Coarse Sharpening Stone\n        [14]   = true,  -- Solid Sharpening Stone\n        [483]  = true,  -- Heavy Sharpening Stone\n        [1643] = true,  -- Dense Sharpening Stone \n        [2506] = true,  -- Elemental Sharpening Stone\n        [2712] = true,  -- Fel Sharpening Stone\n        [2713] = true,  -- Adamantite Sharpening Stone\n        [26]   = true,  -- Frost Oil\n        [2684] = true   -- Consecrated Sharpening Stone\n    }\n    \n    local _,_,_,_,hasOffHandEnchant,offHandExpiration,offHandCharges,offHandEnchantID = GetWeaponEnchantInfo()\n    \n    if (hasOffHandEnchant == true) then\n        if (not poisonEnchantIDs[offHandEnchantID]) then\n            hasOffHandEnchant = false\n        end\n    end\n    \n    aura_env.hasOffHandEnchant = hasOffHandEnchant\n    aura_env.offHandExpiration = offHandExpiration\n    aura_env.offHandCharges = offHandCharges\n    aura_env.offHandEnchantID = offHandEnchantID\n    \n    return hasOffHandEnchant\nend",
