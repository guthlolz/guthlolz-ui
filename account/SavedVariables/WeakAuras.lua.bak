["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 12.5,\n            expirationTime = GetTime() + 12.5,\n            progressType = \"timed\",\n            icon = 136129,\n            autoHide = true,\n        }\n        return true\n    end\n    \n    if event == \"ENCOUNTER_START\" or event == \"WA_LEOTHERAS_HUMAN_START\" then\n        aura_env.allow = false\n        return false\n    end\n    \n    if event == \"WA_LEOTHERAS_DEMON_START\" then\n        aura_env.allow = true\n        return false\n    end\n    \n    if event == \"WA_LEOTHERAS_P2_START\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 12.5,\n            expirationTime = GetTime() + 12.5,\n            progressType = \"timed\",\n            icon = 136129,\n            autoHide = true,\n            attackable = aura_env.allow\n        }\n        return true\n    end\nend",
["spellIds"] = {
},
["events"] = "WA_LEOTHERAS_P2_START WA_LEOTHERAS_DEMON_START WA_LEOTHERAS_HUMAN_START ENCOUNTER_START",
["check"] = "event",
