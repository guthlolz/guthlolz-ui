["triggers"] = {
{
["trigger"] = {
["duration"] = "20",
["subeventPrefix"] = "SPELL",
["customIcon"] = "function()\n    return aura_env.icon\nend",
["custom_hide"] = "timed",
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["debuffType"] = "HELPFUL",
["event"] = "Health",
["customStacks"] = "function()\n    return aura_env.casts\nend",
["custom"] = "function(allstates,event,...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"static\",\n            castsLeft = math.random(1,10),\n            icon = select(3,GetSpellInfo(2061)),\n            spellId = 2061,\n        }\n        return true\n    end\n    \n    if event == \"UNIT_POWER_UPDATE\" then\n        local unit,powerType = ...\n        \n        if unit ~= \"player\" or powerType ~= \"MANA\" or not allstates[\"\"] or not allstates[\"\"].spellId then\n            return false\n        end\n        \n        local spellCost = GetSpellPowerCost(allstates[\"\"].spellId)\n        \n        if not spellCost or not spellCost[1] or spellCost[1].cost <= 0 then\n            return false\n        end\n        \n        allstates[\"\"].castsLeft = math.max(0,floor((UnitPower(\"player\") - 3050) / spellCost[1].cost))\n        allstates[\"\"].changed = true\n        return true\n    end\n    \n    if event == \"STATUS\" then\n        if not allstates[\"\"] or not allstates[\"\"].spellId then\n            return false\n        end\n        \n        local spellId = allstates[\"\"].spellId\n        local spellCost = GetSpellPowerCost(spellId)\n        \n        if not spellCost or not spellCost[1] or spellCost[1].cost <= 0 then\n            return false\n        end\n        \n        allstates[\"\"].show = true\n        allstates[\"\"].changed = true\n        allstates[\"\"].castsLeft = math.max(0,floor((UnitPower(\"player\") - 3050) / spellCost[1].cost))\n        allstates[\"\"].icon = select(3,GetSpellInfo(spellId))\n        return true\n    end\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local _,subEvent,_,sourceGUID,_,_,_,_,_,_,_,spellId = ...\n        \n        if sourceGUID ~= WeakAuras.myGUID then\n            return false\n        end\n        \n        if subEvent ~= \"SPELL_CAST_SUCCESS\" or not aura_env.spells[spellId] then\n            return false\n        end\n        \n        local spellCost = GetSpellPowerCost(spellId)\n        \n        if not spellCost or not spellCost[1] or spellCost[1].cost <= 0 then\n            return false\n        end\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"static\",\n            castsLeft = math.max(0,floor((UnitPower(\"player\") - 3050) / spellCost[1].cost)),\n            icon = select(3,GetSpellInfo(spellId)),\n            spellId = spellId,\n        }\n        return true\n    end\n    \n    return false\nend",
["events"] = "CLEU:SPELL_CAST_SUCCESS UNIT_POWER_UPDATE:player",
