["custom"] = "local locale = GetLocale()\n\naura_env.locales = {\n    [\"enUS\"] = {\n        gaze = \"sets eyes on ([^%s]+)!\",\n        pull = \"Energy. Power. My people are addicted to it\",\n        sangYell = \"You have persevered against some of my best advisors... but none can withstand the might of the Blood Hammer. Behold, Lord Sanguinar!\",\n        teloYell = \"Well done, you have proven worthy to test your skills against my master engineer, Telonicus.\",\n        caperYell = \"Capernian will see to it that your stay here is a short one.\",\n        p2 = \"As you see, I have many weapons in my arsenal....\",\n        p3 = \"Perhaps I underestimated you. It would be unfair to make you fight all four advisors at once, but... fair treatment was never shown to my people. I'm just returning the favor.\",\n        p4 = \"Alas, sometimes one must take matters into one's own hands. Balamore shanal!\",\n        p5 = \"I have not come this far to be stopped! The future I have planned will not be jeopardized! Now you will taste true power!!\",\n    },\n    [\"frFR\"] = {\n        gaze = \"pose ses yeux sur ([^%s]+) !\",\n        pull = \"^L'énergie. La puissance.\",\n        sangYell = \"Vous avez tenu tête à certains de mes plus talentueux conseillers… Mais personne ne peut résister à la puissance du Marteau de sang. Je vous présente le seigneur Sanguinar !\",\n        teloYell = \"Bien, vous êtes dignes de mesurer votre talent à celui de mon maître ingénieur, Telonicus.\",\n        caperYell = \"Capernian fera en sorte que votre séjour ici ne se prolonge pas.\",\n        p2 = \"Comme vous le voyez, j'ai plus d'une corde à mon arc…\",\n        p3 = \"Peut-être vous ai-je sous-estimés. Il ne serait pas très loyal de vous faire combattre mes quatre conseillers en même temps, mais… mon peuple n'a jamais été traité avec loyauté. Je ne fais que rendre la politesse.\",\n        p4 = \"Il est hélas parfois nécessaire de prendre les choses en main soi-même. Balamore shanal !\",\n        p5 = \"Je ne suis pas arrivé si loin pour échouer maintenant ! Je ne laisserai pas l'avenir que je prépare être remis en cause ! Vous allez goûter à ma vraie puissance !\",\n    },\n    [\"deDE\"] = {\n        gaze = \"behält ([^%s]+) im Blickfeld!\",\n        pull = \"^Energie. Kraft.\",\n        sangYell = \"Ihr habt gegen einige meiner besten Berater bestanden... aber niemand kommt gegen die Macht des Bluthammers an. Erzittert vor Lord Sanguinar!\",\n        teloYell = \"Gut gemacht. Ihr habt Euch würdig erwiesen, gegen meinen Meisteringenieur Telonicus anzutreten.\",\n        caperYell = \"Capernian wird dafür sorgen, dass Euer Aufenthalt hier nicht lange währt.\",\n        p2 = \"Wie Ihr seht, habe ich viele Waffen in meinem Arsenal...\",\n        p3 = \"Vielleicht habe ich Euch unterschätzt. Es wäre ungerecht, Euch gegen meine vier Berater gleichzeitig kämpfen zu lassen, aber... mein Volk wurde auch nie gerecht behandelt. Ich vergelte nur Gleiches mit Gleichem.\",\n        p4 = \"Ach, manchmal muss man die Dinge selbst in die Hand nehmen. Balamore shanal!\",\n        p5 = \"Ich bin nicht so weit gekommen, um jetzt noch aufgehalten zu werden! Die Zukunft, die ich geplant habe, wird nicht gefährdet werden. Jetzt bekommt Ihr wahre Macht zu spüren!\",\n    },\n    [\"esES\"] = {\n        gaze = \"mira a ([^%s]+)!\",\n        pull = \"^Energía. Poder.\",\n        sangYell = \"Habéis sobrevivido a algunos de mis mejores consejeros... pero nadie puede resistir el poder del Martillo de Sangre. ¡He aquí Lord Sanguinar!\",\n        teloYell = \"Bien hecho. Parecéis dignos de probar vuestras habilidades con mi maestro ingeniero Telonicus.\",\n        caperYell = \"Capernian se encargará de que vuestra visita sea breve.\",\n        p2 = \"Como veis, dispongo de un amplio arsenal...\",\n        p3 = \"Quizás os subestimé. Sería injusto que os enfrentarais a los cuatro consejeros al mismo tiempo, pero... nunca se le ha brindado un trato justo a mi gente. Así que os devuelvo el favor.\",\n        p4 = \"Desafortunadamente hay veces en las que tienes que hacer las cosas con tus propias manos. ¡Balamore shanal!\",\n        p5 = \"¡No he llegado hasta aquí para que me detengáis! ¡El futuro que he planeado no se pondrá en peligro! ¡Vais a probar el verdadero poder!\",\n    },\n    [\"koKR\"] = {\n        gaze = \"노려봅니다!\",\n        pull = \"^나의 백성은\",\n        sangYell = \"최고의 조언가를 상대로 잘도 버텨냈군. 허나 그 누구도 붉은 망치의 힘에는 대항할 수 없지. 보아라, 군주 생귀나르를!\",\n        teloYell = \"좋아, 그 정도 실력이면 수석기술자 텔로니쿠스를 상대해 볼만하겠어.\",\n        caperYell = \"카퍼니안, 놈들이 여기 온 것을 후회하게 해 줘라.\",\n        p2 = \"보다시피 내 무기고에는 굉장한 무기가 아주 많지.\",\n        p3 = \"네놈들을 과소평가했나 보군. 모두를 한꺼번에 상대하라는 건 불공평한 처사지만, 나의 백성도 공평한 대접을 받은 적 없기는 매한가지. 받은 대로 돌려주겠다.\",\n        p4 = \"때론 직접 나서야 할 때도 있는 법이지. 발라모어 샤날!\",\n        p5 = \"이대로 물러날 내가 아니다! 반드시 내가 설계한 미래를 실현하리라! 이제 진정한 힘을 느껴 보아라!\",\n    },\n    [\"ruRU\"] = {\n        gaze = \"бросает взгляд на ([^%s]+)!\",\n        pull = \"^^Сила. Могущество\",\n        sangYell = \"Вы справились с моими лучшими советниками... Но перед мощью Кровавого Молота не устоит никто. Узрите лорда Сангвинара!\",\n        teloYell = \"Неплохо, теперь вы можете потягаться с моим главным инженером Телоникусом.\",\n        caperYell = \"Каперниан проследит, чтобы вы не задержались здесь надолго.\",\n        p2 = \"Как видите, оружия у меня предостаточно...\",\n        p3 = \"Возможно, я недооценил вас. Было бы несправедливо заставлять вас драться с четырьмя советниками сразу, но... Мои люди тоже никогда не знали справедливости. Я лишь возвращаю долг.\",\n        p4 = \"Увы, иногда приходится брать все в свои руки. Баламоре шаналь!\",\n        p5 = \"Я не затем ступил на этот путь, чтобы остановиться на полдороги! Мои планы должны сбыться – и они сбудутся! Узрите же истинную мощь!\",\n    },\n    [\"zhCN\"] = {\n        gaze = \"凝视着([^%s]+)！\",\n        pull = \"魔法，能量，我的人民陷入其中不能自拔……自从太阳之井被摧毁之后就是如此。欢迎来到未来。真遗憾，你们无法阻止什么。没有人可以阻止我了！Selama ashal’anore！\",\n        sangYell = \"你们击败了我最强大的顾问……但是没有人能战胜鲜血之锤。出来吧，萨古纳尔男爵！\",\n        teloYell = \"干得不错。看来你们有能力挑战我的首席技师，塔隆尼库斯。\",\n        caperYell = \"卡波妮娅会很快解决你们的。\",\n        p2 = \"你们看，我的个人收藏中有许多武器……\",\n        p3 = \"也许我确实低估了你们。虽然让你们同时面对我的四位顾问显得有些不公平，但是我的人民从来都没有得到过公平的待遇。我只是在以牙还牙。\",\n        p4 = \"唉，有些时候，有些事情，必须得亲自解决才行。Balamore shanal！\",\n        p5 = \"我的心血是不会被你们轻易浪费的！我精心谋划的未来是不会被你们轻易破坏的！感受我真正的力量吧！\",\n    },\n    [\"zhTW\"] = {\n        gaze = \"凝視著(.+)!\",\n        pull = \"能量。力量。我的人民陷入其中不能自拔……自從太陽之井被摧毀之後就顯得更加明顯。歡迎來到未來。真遺憾，你們無法阻止什麼。沒有人可以阻止我了﹗(薩拉斯語)為了人民的正義!\",\n        sangYell = \"你已經努力的打敗了我的幾位最忠誠的諫言者...但是沒有人可以抵抗血錘的力量。等著看桑古納爾領主的力量吧!\",\n        teloYell = \"做得好，你已經證明你的實力足以挑戰我的工程大師泰隆尼卡斯。\",\n        caperYell = \"卡普尼恩將保證你們不會在這裡停留太久。\",\n        p2 = \"你們看，我的個人收藏中有許多武器...\",\n        p3 = \"也許我低估了你。要你一次對付四位諫言者也許對你來說是不太公平，但是...我的人民從未得到公平的對待。我只是以牙還牙而已。\",\n        p4 = \"唉，有些時候，有些事情，必須得親自解決才行。(薩拉斯語)受死吧!\",\n        p5 = \"我的心血是不會被你們輕易浪費的!我精心謀劃的未來是不會被你們輕易破壞的!感受我真正的力量吧!\",\n    }\n}\n\naura_env.currentLocale = aura_env.locales[locale] or aura_env.locales[\"enUS\"]",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates,event,...)\n    if event == \"CHAT_MSG_MONSTER_EMOTE\" then\n        local msg, _, _, _, target = ...\n        \n        if msg:find(aura_env.currentLocale.gaze) or msg == aura_env.currentLocale.gaze then\n            WeakAuras.ScanEvents(\"WA_THALADRED_GAZE_TARGET\", UnitGUID(target), target)\n            return true\n        end\n    end\n    \n    if event == \"CHAT_MSG_MONSTER_YELL\" then\n        local msg = ...\n        \n        if msg:find(aura_env.currentLocale.p2) or msg == aura_env.currentLocale.p2 then\n            WeakAuras.ScanEvents(\"WA_KAELTHAS_P2_START\")\n            return true\n        elseif msg:find(aura_env.currentLocale.p3) or msg == aura_env.currentLocale.p3 then\n            C_Timer.After(10, function()\n                    WeakAuras.ScanEvents(\"WA_KAELTHAS_P3_START\")\n            end)\n            return true\n        elseif msg:find(aura_env.currentLocale.p4) or msg == aura_env.currentLocale.p4 then\n            WeakAuras.ScanEvents(\"WA_KAELTHAS_P4_START\")\n            return true\n        elseif msg:find(aura_env.currentLocale.p5) or msg == aura_env.currentLocale.p5 then\n            WeakAuras.ScanEvents(\"WA_KAELTHAS_P5_START\")\n            return true\n        elseif msg:find(aura_env.currentLocale.sangYell) or msg == aura_env.currentLocale.sangYell then\n            WeakAuras.ScanEvents(\"WA_KAELTHAS_SANGUINAR_YELL\")\n            return true\n        elseif msg:find(aura_env.currentLocale.caperYell) or msg == aura_env.currentLocale.caperYell then\n            WeakAuras.ScanEvents(\"WA_KAELTHAS_CAPERNIAN_YELL\")\n            return true\n        elseif msg:find(aura_env.currentLocale.teloYell) or msg == aura_env.currentLocale.teloYell then\n            WeakAuras.ScanEvents(\"WA_KAELTHAS_TELONICUS_YELL\")\n            return true\n        elseif msg:find(aura_env.currentLocale.pull) or msg == aura_env.currentLocale.pull then\n            WeakAuras.ScanEvents(\"WA_KAELTHAS_THALADRED_YELL\")\n            WeakAuras.ScanEvents(\"WA_FJI_ENCOUNTER_START\", 733)\n            return true\n        end\n    end\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local _,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId = ...\n        \n        if subEvent == \"UNIT_DIED\" then\n            local npcID = select(6, strsplit(\"-\", destGUID))\n            \n            if npcID == \"20064\" then\n                WeakAuras.ScanEvents(\"WA_KAELTHAS_THALADRED_DIED\")\n            elseif npcID == \"20060\" then\n                WeakAuras.ScanEvents(\"WA_KAELTHAS_SANGUINAR_DIED\")\n            elseif npcID == \"20062\" then\n                WeakAuras.ScanEvents(\"WA_KAELTHAS_CAPERNIAN_DIED\")\n            elseif npcID == \"20063\" then\n                WeakAuras.ScanEvents(\"WA_KAELTHAS_TELONICUS_DIED\")\n            elseif npcID == \"21268\" then\n                WeakAuras.ScanEvents(\"WA_KAELTHAS_BOW_DIED\")\n            elseif npcID == \"21269\" then\n                WeakAuras.ScanEvents(\"WA_KAELTHAS_AXE_DIED\")\n            elseif npcID == \"21270\" then\n                WeakAuras.ScanEvents(\"WA_KAELTHAS_MACE_DIED\")\n            elseif npcID == \"21271\" then\n                WeakAuras.ScanEvents(\"WA_KAELTHAS_DAGGER_DIED\")\n            elseif npcID == \"21272\" then\n                WeakAuras.ScanEvents(\"WA_KAELTHAS_SWORD_DIED\")\n            elseif npcID == \"21273\" then\n                WeakAuras.ScanEvents(\"WA_KAELTHAS_SHIELD_DIED\")\n            elseif npcID == \"21274\" then\n                WeakAuras.ScanEvents(\"WA_KAELTHAS_STAFF_DIED\")\n            elseif npcID == \"21364\" then\n                WeakAuras.ScanEvents(\"WA_KAELTHAS_EGG_DIED\", destGUID)\n            end\n            return true\n        end\n    end\nend",
["spellIds"] = {
},
