["actions"] = {
["start"] = {
["message"] = "",
["do_custom"] = false,
["do_message"] = false,
["message_type"] = "RAID",
},
["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.command = \"!fojjiBT\"\naura_env.respond = \"WA_FJI_BT_VERSION_CHECK_RESPOND\"\naura_env.request = \"WA_FJI_BT_VERSION_CHECK_REQUEST\"",
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_hide"] = "timed",
["custom_type"] = "stateupdate",
["subeventSuffix"] = "_CAST_START",
["duration"] = "1",
["event"] = "Health",
["unit"] = "player",
["subeventPrefix"] = "SPELL",
["events"] = "CHAT_MSG_RAID_LEADER, WA_FJI_BT_VERSION_CHECK_RESPOND",
["spellIds"] = {
},
["custom"] = "function(a, e, ...)\n    if e == \"OPTIONS\" then\n        for i = 1, 25 do\n            a[i] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = 10,\n                expirationTime = GetTime() + 10,\n                autoHide = true,\n                name = WeakAuras.me,\n                version1 = math.random(2) == 1 and \"|cFFff0000x|r\" or \"1.0.0\",\n                version2 = math.random(2) == 1 and \"|cFFff0000x|r\" or \"1.0.0\",\n            }\n        end\n        return true\n    end\n    \n    if e == \"CHAT_MSG_RAID_LEADER\" then\n        local msg, _, _, _, _, _, _, _, _, _, _, guid = ...\n        \n        if msg == aura_env.command and guid == WeakAuras.myGUID then\n            if UnitIsGroupLeader(\"player\") then\n                _G.SyncEvents(\"RAID\", nil, aura_env.request)\n            end\n            \n            for unit in WA_IterateGroupMembers() do\n                if UnitExists(unit) then\n                    local name = UnitName(unit)\n                    \n                    a[name] = {\n                        show = true,\n                        changed = true,\n                        progressType = \"timed\",\n                        duration = 20,\n                        expirationTime = GetTime() + 20,\n                        autoHide = true,\n                        name = name,\n                        version1 = \"|cFFff0000x|r\",\n                        version2 = \"|cFFff0000x|r\",\n                    }\n                end\n            end\n            return true\n        end\n    end\n    \n    if e == aura_env.respond then\n        local name, version, part = ...\n        \n        if a[name] then\n            a[name].changed = true\n            \n            if part == \"part1\" then\n                a[name].version1 = version\n            elseif part == \"part2\" then\n                a[name].version2 = version\n            end\n            \n            return true\n        end\n    end\n    \n    return false\nend",
["check"] = "event",
["names"] = {
},
["customVariables"] = "{\n    version1 = \"string\",\n    version2 = \"string\",\n}",
