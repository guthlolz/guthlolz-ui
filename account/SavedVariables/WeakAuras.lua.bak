},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates,event,eID,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId)\n    if event == \"WA_FJI_ENCOUNTER_START\" or event == \"ENCOUNTER_START\" then\n        if eID ~= 624 then\n            return false\n        end\n        \n        aura_env.updateState(allstates)\n        aura_env.count = 1\n        \n        aura_env.preWarn(aura_env.cdStart, 3, aura_env.count)\n        aura_env.nuTimer(aura_env.cdStart, aura_env.count)\n        return true\n        \n    elseif event == \"WA_FJI_ENCOUNTER_END\" or event == \"ENCOUNTER_END\" then\n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        return true\n        \n    elseif event == \"WA_LURKER_BELOW_EMERGE\" then\n        aura_env.preWarn(aura_env.cdAfterEmerge, 3, aura_env.count)\n        aura_env.nuTimer(aura_env.cdAfterEmerge, aura_env.count)\n        return true\n        \n    elseif event == \"WA_LURKER_BELOW_SUBMERGE\" then\n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        return true\n    end\n    \n    if event == \"WA_LURKER_BELOW_SPOUT\" then\n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        aura_env.preWarn(aura_env.cdSpout, 3, aura_env.count)\n        aura_env.nuTimer(aura_env.cdSpout, aura_env.count)\n        return true\n    end\n    \n    if spellId ~= aura_env.geyser then\n        return false\n    end\n    \n    if subEvent == \"SPELL_CAST_SUCCESS\" then\n        aura_env.nuTimer(0, aura_env.count)\n        aura_env.count = aura_env.count + 1\n        aura_env.preWarn(aura_env.cdWindow, 3, aura_env.count)\n        aura_env.nuTimer(aura_env.cdWindow, aura_env.count)\n        return true\n    end\nend",
["spellIds"] = {
},
["events"] = "ENCOUNTER_START, ENCOUNTER_END, WA_FJI_ENCOUNTER_END, WA_FJI_ENCOUNTER_START, CLEU:SPELL_CAST_SUCCESS, WA_LURKER_BELOW_EMERGE, WA_LURKER_BELOW_SUBMERGE, WA_LURKER_BELOW_SPOUT",
