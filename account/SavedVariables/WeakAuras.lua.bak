["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_hide"] = "timed",
["custom_type"] = "stateupdate",
["subeventSuffix"] = "_CAST_START",
["duration"] = "24",
["event"] = "Chat Message",
["unit"] = "player",
["subeventPrefix"] = "SPELL",
["events"] = "CHAT_MSG_MONSTER_SAY, WA_FJI_AKAMA_DOOR",
["spellIds"] = {
},
["custom"] = "function(allstates, event, ...)\n    if event == \"CHAT_MSG_MONSTER_SAY\" then\n        local msg = ...\n        \n        if msg and (msg:find(aura_env.currentLocale.akamaDoor) or msg == aura_env.currentLocale.akamaDoor) then\n            aura_env.startTimer()\n            aura_env.showState(allstates)\n            _G.SyncEvents(\"RAID\", nil, \"WA_FJI_AKAMA_DOOR\")\n            return true\n        end\n    end\n    \n    if event == \"WA_FJI_AKAMA_DOOR\" then\n        if aura_env.hasActiveTimer() or allstates[\"\"] then\n            return false\n        end\n        \n        aura_env.startTimer()\n        return aura_env.showState(allstates)\n    end\n    \n    if event == \"STATUS\" then\n        return aura_env.showState(allstates)\n    end\nend",
["check"] = "event",
