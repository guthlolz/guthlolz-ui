{
["trigger"] = {
["unit"] = "player",
["type"] = "custom",
["events"] = "UNIT_DAMAGE:player",
["custom_type"] = "stateupdate",
["check"] = "event",
["debuffType"] = "HELPFUL",
["custom"] = "function(allstates,event)\n    if event == \"OPTIONS\" then\n        local damage = math.random(0,200)\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"static\",\n            value = 1,\n            total = 1,\n            damage = damage,\n            text = damage > 100 and \"Big Boi\" or \"Unlucky\",\n        }\n        return true\n    end\n    \n    local _,_,_,_,_,_,modifier = UnitDamage(\"player\")\n    local damage = (modifier or 1)*100\n    \n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n        progressType = \"static\",\n        value = 1,\n        total = 1,\n        damage = damage,\n        text = damage > 100 and \"Big Boi\" or \"Unlucky\",\n    }\n    return true\nend",
["customVariables"] = "{\n    damage = \"number\",\n}",
},
