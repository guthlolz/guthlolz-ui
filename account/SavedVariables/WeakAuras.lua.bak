["event"] = "Health",
["subeventPrefix"] = "SPELL",
["unit"] = "player",
["custom"] = "function(allstates,event,text,_,_,_,playerName)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 10,\n            expirationTime = GetTime() + 10,\n            autoHide = true,\n            name = WeakAuras.me,\n        }\n        return true\n    end\n    \n    if event == \"CHAT_MSG_LOOT\" then\n        if string.find(text,\"Warglaive of Azzinoth\") then\n            if GetTime() - aura_env.throttle < 120 then\n                return false\n            end\n            aura_env.throttle = GetTime()\n            \n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = 6,\n                expirationTime = GetTime() + 6,\n                autoHide = true,\n                name = playerName,\n            }\n            return true\n        end\n    end\nend",
