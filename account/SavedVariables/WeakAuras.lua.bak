["trigger"] = {
["type"] = "custom",
["custom_hide"] = "timed",
["custom_type"] = "stateupdate",
["subeventSuffix"] = "_CAST_START",
["duration"] = "20",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 1.7,\n            expirationTime = GetTime() + 1.7,\n            autoHide = true,\n            icon = 136116,\n            hasTarget = true,\n            target = WeakAuras.myGUID,\n            isPlayer = true,\n        }\n        return true\n    end\n    \n    if event == \"WA_NUMEN_TIMER\" then\n        local key, time, count = ...\n        \n        if key == \"ARCHIMONDE_BURST\" then\n            if time == 0 then\n                allstates[\"\"] = {\n                    show = true,\n                    changed = true,\n                    progressType = \"timed\",\n                    duration = 1.7,\n                    expirationTime = GetTime() + 1.7,\n                    autoHide = true,\n                    icon = 136116,\n                    hasTarget = false,\n                    target = \"\",\n                }\n                return true\n            elseif time == nil then\n                if allstates[\"\"] then\n                    allstates[\"\"].show = false\n                    allstates[\"\"].changed = true\n                    return true\n                end\n            end\n        end\n    elseif event == \"WA_ARCHIMONDE_BURST_TARGET\" then\n        local guid = ...\n        \n        if allstates[\"\"] then\n            allstates[\"\"].hasTarget = true\n            allstates[\"\"].target = guid\n            allstates[\"\"].changed = true\n            allstates[\"\"].isPlayer = guid == WeakAuras.myGUID\n            return true\n        end\n    end\nend",
["events"] = "WA_NUMEN_TIMER, WA_ARCHIMONDE_BURST_TARGET",
