["displayText_format_unitName_pad_mode"] = "left",
["yOffset"] = 2,
["anchorPoint"] = "TOP",
["displayText_format_c_abbreviate_max"] = 8,
["displayText_format_p_time_format"] = 0,
["displayText_format_count_format"] = "none",
["actions"] = {
["start"] = {
["message_custom"] = "",
["message_type"] = "TTS",
["do_message"] = false,
["message"] = "",
["message_tts_voice"] = 1,
["custom"] = "",
["do_sound"] = false,
["message_format_c_format"] = "none",
["message_format_C_format"] = "none",
["do_custom"] = false,
["sound"] = "Interface\\Addons\\FojjiCore\\sound\\fojjiPop1.ogg",
},
["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.encounterActive = false\naura_env.assignmentReceived = false\naura_env.currentKick = 1\n\nlocal ENCOUNTER_ID = 606\n\nlocal function IsEnabled()\n    return aura_env.config.option.enable == true\nend\n\nlocal function GetConfig()\n    if not IsEnabled() then\n        return nil\n    end\n    \n    local kick = tonumber(aura_env.config.option.kick)\n    local rotation = tonumber(aura_env.config.option.rotation)\n    \n    if not rotation or rotation < 1 then\n        return nil\n    end\n    \n    if not kick or kick < 1 or kick > rotation then\n        return nil\n    end\n    \n    return kick,rotation\nend\n\nlocal function SendNext()\n    if not aura_env.encounterActive or aura_env.assignmentReceived then\n        return\n    end\n    \n    local kick = GetConfig()\n    \n    if not kick or aura_env.currentKick ~= kick then\n        return\n    end\n    \n    WeakAuras.ScanEvents(\"WA_RELIQUARY_PLAYER_KICK_NEXT\",kick)\nend\n\nfunction aura_env.CHAT_MSG_RAID_LEADER(states,msg)\n    if not IsEnabled() then\n        return false\n    end\n    \n    if not msg then\n        return false\n    end\n    \n    if msg == \"Reliquary Interrupt Rotation\" or msg:match(\"^TEAM[1-5]%-.+$\") then\n        aura_env.assignmentReceived = true\n    end\n    \n    return false\nend\n\nfunction aura_env.WA_RELIQUARY_SS_CAST(states,castTime)\n    if not IsEnabled() or not aura_env.encounterActive or aura_env.assignmentReceived then\n        return false\n    end\n    \n    if not castTime then\n        return false\n    end\n    \n    local kick = GetConfig()\n    \n    if kick and aura_env.currentKick == kick then\n        WeakAuras.ScanEvents(\"WA_RELIQUARY_PLAYER_KICK_NOW\",castTime)\n    end\n    \n    return false\nend\n\nlocal function AdvanceKick()\n    if not IsEnabled() or not aura_env.encounterActive or aura_env.assignmentReceived then\n        return false\n    end\n    \n    local _,rotation = GetConfig()\n    \n    if not rotation then\n        return false\n    end\n    \n    aura_env.currentKick = aura_env.currentKick%rotation+1\n    SendNext()\n    return false\nend\n\nfunction aura_env.WA_RELIQUARY_SS_INTERRUPT()\n    return AdvanceKick()\nend\n\nfunction aura_env.WA_RELIQUARY_SS_SUCCESS()\n    return AdvanceKick()\nend\n\nlocal function EncounterStart(eID)\n    if eID ~= ENCOUNTER_ID or aura_env.encounterActive then\n        return false\n    end\n    \n    aura_env.encounterActive = true\n    aura_env.assignmentReceived = false\n    aura_env.currentKick = 1\n    \n    SendNext()\n    return false\nend\n\nfunction aura_env.ENCOUNTER_START(states,eID)\n    return EncounterStart(eID)\nend\n\nlocal function EncounterEnd()\n    aura_env.encounterActive = false\n    aura_env.assignmentReceived = false\n    aura_env.currentKick = 1\n    return false\nend\n\nfunction aura_env.ENCOUNTER_END()\n    return EncounterEnd()\nend\n\nfunction aura_env.WA_RELIQUARY_P2_END()\n    return EncounterEnd()\nend\n\nfunction aura_env.STATUS()\n    return false\nend\n\nfunction aura_env.OPTIONS()\n    return false\nend",
},
["finish"] = {
["do_custom"] = false,
["custom"] = "",
},
},
