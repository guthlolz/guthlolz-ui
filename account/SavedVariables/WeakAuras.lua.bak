["custom_hide"] = "timed",
["custom_type"] = "stateupdate",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(allstates,event,key,cooldown,count,guid,text)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            name = \"Wave 2\",\n            duration = 90,\n            expirationTime = GetTime() + 90,\n            progressType = \"timed\",\n            icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\ragewinterchill.jpg\",\n        }\n        return true\n    end\n    \n    if event ~= \"WA_NUMEN_TIMER\" or not aura_env.spellKeys[key] then\n        return false\n    end\n    \n    if cooldown == nil or cooldown == 0 then\n        aura_env.hideState(allstates,key,guid)\n        return true\n    end\n    \n    local bar = aura_env.spellKeys[key]\n    local name,icon = bar.name,bar.icon\n    local autoHide = bar.autoHide or false\n    local roleIcon = \"\"\n    \n    if bar.role then\n        local roles = type(bar.role) == \"table\" and bar.role or {bar.role}\n        local firstRole = roles[1]\n        \n        if firstRole == \"TANK\" then\n            roleIcon = \"|A:groupfinder-icon-role-large-tank:16:16|a \"\n        elseif firstRole == \"HEALER\" then\n            roleIcon = \"|A:groupfinder-icon-role-large-heal:16:16|a \"\n        end\n    end\n    \n    if bar.roleRestrict and bar.role then\n        local playerRole = UnitGroupRolesAssigned(\"player\")\n        local isRL = UnitIsGroupLeader(\"player\")\n        local allowed = false\n        \n        if bar.includeRL and isRL then\n            allowed = true\n        elseif type(bar.role) == \"table\" then\n            for _,r in ipairs(bar.role) do\n                if r == playerRole then\n                    allowed = true\n                    break\n                end\n            end\n        else\n            allowed = bar.role == playerRole\n        end\n        \n        if not allowed then\n            return false\n        end\n    end\n    \n    local displayName = roleIcon .. name\n    local extraText = bar.useText and (text or \"\") or nil\n    \n    aura_env.updateState(allstates,key,cooldown,count,displayName,icon,autoHide,extraText,guid)\n    return true\nend",
["events"] = "WA_NUMEN_TIMER, STATUS, OPTIONS",
