["CT:[T5][Kaelthas] Mind Control"] = {
["outline"] = "OUTLINE",
["wagoID"] = "gSs1_GQRl",
["color"] = {
1,
1,
1,
1,
},
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["shadowYOffset"] = -1,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiT5RaidPack/3",
["actions"] = {
["start"] = {
},
["finish"] = {
["custom"] = "aura_env.count = 1\naura_env.nuTimer(nil)\naura_env.preWarnCancel()",
["do_sound"] = false,
["do_message"] = false,
["do_custom"] = true,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.key = \"KAELTHAS_MIND_CONTROL\"\naura_env.count = 1\naura_env.cdStart = 12\naura_env.cdWindow = 15\naura_env.mindControl = 36797\n\nfunction aura_env.nuTimer(countdown, count)\n    WeakAuras.ScanEvents(\"WA_NUMEN_TIMER\", aura_env.key, countdown, count)\nend\n\nfunction aura_env.updateState(allstates)\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n    }\nend\n\nfunction aura_env.hideState(allstates)\n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\nend\n\nfunction aura_env.preWarn(duration, preWarnTime, count)\n    if not preWarnTime then\n        preWarnTime = 3\n    end\n    \n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\n    \n    aura_env.preWarnTimer = C_Timer.NewTimer(duration - preWarnTime, function()\n            WeakAuras.ScanEvents(\"WA_\" .. aura_env.key .. \"_PREWARN\", preWarnTime, count)\n            aura_env.preWarnTimer = nil\n    end)\nend\n\nfunction aura_env.preWarnCancel()\n    WeakAuras.ScanEvents(\"WA_\" .. aura_env.key .. \"_PREWARN_CANCEL\")\n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\nend",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates,event,...)\n    if event == \"WA_FJI_ENCOUNTER_START\" or event == \"ENCOUNTER_START\" then\n        local eID = ...\n        if eID ~= 733 then\n            return false\n        end\n        \n        aura_env.updateState(allstates)\n        aura_env.count = 1\n        return true\n        \n    elseif event == \"WA_FJI_ENCOUNTER_END\" or event == \"ENCOUNTER_END\" or event == \"WA_KAELTHAS_P5_START\" then\n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        return true\n        \n    elseif event == \"WA_KAELTHAS_P4_START\" then\n        aura_env.preWarn(aura_env.cdStart, 3, aura_env.count)\n        aura_env.nuTimer(aura_env.cdStart, aura_env.count)\n        return true\n    end\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local _,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId = ...\n        \n        if spellId ~= aura_env.mindControl then\n            return false\n        end\n        \n        if subEvent == \"SPELL_AURA_APPLIED\" then\n            WeakAuras.ScanEvents(\"WA_KAELTHAS_MIND_CONTROL_APPLIED\", destGUID)\n            return true\n        elseif subEvent == \"SPELL_AURA_REMOVED\" then\n            WeakAuras.ScanEvents(\"WA_KAELTHAS_MIND_CONTROL_REMOVED\", destGUID)\n            return true\n        elseif subEvent == \"SPELL_CAST_SUCCESS\" then\n            aura_env.nuTimer(0, aura_env.count)\n            aura_env.count = aura_env.count + 1\n            aura_env.preWarn(aura_env.cdWindow, 3, aura_env.count)\n            aura_env.nuTimer(aura_env.cdWindow, aura_env.count)\n            return true\n        end\n    end\nend",
["spellIds"] = {
},
["events"] = "ENCOUNTER_START, WA_FJI_ENCOUNTER_START, ENCOUNTER_END, WA_FJI_ENCOUNTER_END, CLEU:SPELL_CAST_SUCCESS:SPELL_AURA_REMOVED:SPELL_AURA_APPLIED, WA_KAELTHAS_P4_START, WA_KAELTHAS_P5_START",
["check"] = "event",
["unit"] = "player",
["custom_hide"] = "timed",
["customVariables"] = "",
