["height"] = 15,
["textureSource"] = "LSM",
["displayText_format_1.destGuid_color"] = "class",
["sparkBlendMode"] = "BLEND",
["useAdjustededMax"] = false,
["fontSize"] = 14,
["source"] = "import",
["displayText_format_1.sourceGuid_realm_name"] = "never",
["xOffset"] = 0,
["sparkTexture"] = "Interface\\AddOns\\WeakAuras\\Media\\Textures\\Square_White",
["actions"] = {
["start"] = {
["do_custom"] = false,
},
["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.saved = aura_env.saved or {}\n\nlocal TEAM = {}\nlocal CHANNEL_DURATION = 10\nlocal EXHAUSTION_DURATION = 30\nlocal teamNumber = 3\n\nlocal function WipeTables()\n    aura_env.saved = {}\n    wipe(TEAM)\nend\n\nlocal function CreateStateDisplay(allStates)\n    for _, state in pairs(allStates) do\n        state.show = false\n        state.changed = true\n    end\n    \n    allStates[1] = {\n        show = true,\n        changed = true,\n        isHeader = true,\n    }\n    \n    for idx, guid in ipairs(TEAM) do\n        local isMe = guid == WeakAuras.myGUID\n        \n        allStates[guid] = {\n            show = true,\n            changed = true,\n            guid = guid,\n            isMe = isMe,\n            index = idx,\n            progressType = \"static\",\n            value = 1,\n            total = 1,\n        }\n    end\n    \n    return true\nend\n\nfunction aura_env.CHAT_MSG_RAID_LEADER(allStates, msg)\n    local tNum, namesStr = msg:match(\"^TEAM(%d)%-(.+)$\")\n    tNum = tonumber(tNum)\n    if not tNum or not namesStr then\n        return false\n    end\n    if tNum ~= teamNumber then\n        return false\n    end\n    \n    local nameToGuid = {}\n    for unit in WA_IterateGroupMembers() do\n        local guid = UnitGUID(unit)\n        local name, realm = UnitName(unit)\n        if guid and name then\n            nameToGuid[name] = guid\n            if realm and realm ~= \"\" then\n                nameToGuid[name .. \"-\" .. realm] = guid\n            end\n        end\n    end\n    \n    WipeTables()\n    namesStr = namesStr:gsub(\"%{rt%d%}\", \"\")\n    for _, raw in ipairs({ strsplit(\",\", namesStr) }) do\n        local name = strtrim(raw)\n        if name ~= \"\" then\n            local guid = nameToGuid[name]\n            if guid then\n                tinsert(TEAM, guid)\n            end\n        end\n    end\n    \n    aura_env.saved.team = CopyTable(TEAM)\n    return CreateStateDisplay(allStates)\nend\n\nfunction aura_env.UNIT_HEALTH(allStates, unit)\n    local guid = UnitGUID(unit)\n    if not guid then\n        return false\n    end\n    \n    local state = allStates[guid]\n    if not state then\n        return false\n    end\n    \n    local dead = UnitIsDeadOrGhost(unit) and true or false\n    if state.isDead ~= dead then\n        state.isDead = dead\n        state.changed = true\n        return true\n    end\n    \n    return false\nend\n\nfunction aura_env.UNIT_FLAGS(allStates, unit)\n    local guid = UnitGUID(unit)\n    if not guid then\n        return false\n    end\n    \n    local state = allStates[guid]\n    if not state then\n        return false\n    end\n    \n    local disconnected = (not UnitIsConnected(unit)) and true or false\n    if state.isDisconnected ~= disconnected then\n        state.isDisconnected = disconnected\n        state.changed = true\n        return true\n    end\n    \n    return false\nend\n\nfunction aura_env.WA_FJI_MAGTHERIDON_CHANNEL_START(allStates, guid)\n    local s = allStates[guid]\n    if s then\n        s.progressType = \"timed\"\n        s.duration = CHANNEL_DURATION\n        s.expirationTime = GetTime() + CHANNEL_DURATION\n        s.changed = true\n        s.channeling = true\n        s.icon = 136230\n    end\n    return true\nend\n\nfunction aura_env.WA_FJI_MAGTHERIDON_CHANNEL_STOP(allStates, guid)\n    local s = allStates[guid]\n    if s then\n        s.changed = true\n        s.channeling = false\n    end\n    return true\nend\n\nfunction aura_env.WA_MIND_EXHAUSTION_APPLIED(allStates, destGUID)\n    local s = allStates[destGUID]\n    if s then\n        s.progressType = \"timed\"\n        s.duration = EXHAUSTION_DURATION\n        s.expirationTime = GetTime() + EXHAUSTION_DURATION\n        s.exhaustion = true\n        s.changed = true\n        s.icon = 136222\n    end\n    return true\nend\n\nfunction aura_env.WA_MIND_EXHAUSTION_REMOVED(allStates, guid)\n    local s = allStates[guid]\n    if s then\n        s.progressType = \"static\"\n        s.exhaustion = false\n        s.changed = true\n        s.value = 1\n        s.total = 1\n    end\n    return true\nend\n\nfunction aura_env.WA_FJI_ENCOUNTER_END(allStates)\n    for _, state in pairs(allStates) do\n        state.channeling = false\n        state.exhaustion = false\n        state.changed = true\n        state.progressType = \"static\"\n        state.value = 1\n        state.total = 1\n    end\n    return true\nend\n\nfunction aura_env.WA_FJI_MAGTHERIDON_KILLED(allStates)\n    for _, state in pairs(allStates) do\n        state.show = false\n        state.changed = true\n    end\n    aura_env.saved = {}\n    return true\nend\n\nfunction aura_env.STATUS(allStates)\n    local savedTeam = aura_env.saved and aura_env.saved.team\n    if savedTeam and #savedTeam > 0 then\n        for _, savedGuid in ipairs(savedTeam) do\n            local found = false\n            for unit in WA_IterateGroupMembers() do\n                if UnitGUID(unit) == savedGuid then\n                    found = true\n                    break\n                end\n            end\n            if not found then\n                WipeTables()\n                for _, state in pairs(allStates) do\n                    state.show = false\n                    state.changed = true\n                end\n                return true\n            end\n        end\n        for _, guid in ipairs(savedTeam) do\n            tinsert(TEAM, guid)\n        end\n        return CreateStateDisplay(allStates)\n    end\n    return false\nend\n\nfunction aura_env.OPTIONS(allStates)\n    local guid = WeakAuras.myGUID\n    allStates[1] = {\n        show = true,\n        changed = true,\n        isHeader = true,\n    }\n    allStates[2] = {\n        show = true,\n        changed = true,\n        progressType = \"timed\",\n        duration = EXHAUSTION_DURATION,\n        expirationTime = EXHAUSTION_DURATION + GetTime(),\n        guid = guid,\n        icon = 136222,\n        exhaustion = true,\n    }\n    allStates[3] = {\n        show = true,\n        changed = true,\n        progressType = \"timed\",\n        duration = EXHAUSTION_DURATION,\n        expirationTime = EXHAUSTION_DURATION + GetTime(),\n        guid = guid,\n        icon = 136222,\n        exhaustion = true,\n        isDisconnected = true,\n    }\n    allStates[4] = {\n        show = true,\n        changed = true,\n        progressType = \"timed\",\n        duration = EXHAUSTION_DURATION,\n        expirationTime = EXHAUSTION_DURATION + GetTime(),\n        guid = guid,\n        icon = 136222,\n        exhaustion = true,\n        isDead = true,\n    }\n    for i = 5, 6 do\n        allStates[i] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = EXHAUSTION_DURATION,\n            expirationTime = EXHAUSTION_DURATION + GetTime(),\n            guid = guid,\n            icon = 136230,\n            channeling = true,\n        }\n    end\n    return true\nend",
},
["finish"] = {
["do_custom"] = false,
["hide_all_glows"] = false,
},
},
