["custom_hide"] = "timed",
["custom"] = "function(event, button)\n    if event ~= \"WA_TRINKET_TRACKER_CLICK_SLOT_2\" then\n        return false\n    end\n    if button ~= \"LeftButton\" then\n        return true\n    end\n    \n    local trinket2 = ItemLocation:CreateFromEquipmentSlot(14)\n    if C_Item.DoesItemExist(trinket2) then\n        aura_env.trinket1ID = C_Item.GetItemID(trinket2)\n    end\n    \n    aura_env.UnequipItemBySlot(14)\n    C_Timer.After(0.5, function()\n            WeakAuras.ScanEvents(\"WA_TRINKET_TRACKER_EQUIP_SLOT_2\", aura_env.trinket2ID)\n    end)\nend",
