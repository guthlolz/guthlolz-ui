["custom"] = "aura_env.saved = aura_env.saved or {}\naura_env.saved.detectedMobs = aura_env.saved.detectedMobs or {}\naura_env.seen = {}\n\naura_env.npcID = \"21251\"\naura_env.duration = 30\n\naura_env.spells = {\n    SPELL_CAST_SUCCESS = {\n        [39031] = {\n            spell = \"Frenzy / Atrophic\",\n            icon = 136146,\n        },\n        [39044] = {\n            spell = \"Geyser / Parasite\",\n            icon = 135793,\n        },\n        [38971] = {\n            spell = \"Geyser / Parasite\",\n            icon = 135793,\n        },\n        [38976] = {\n            spell = \"Quake / Infection\",\n            icon = 135801,\n        },\n        [39032] = {\n            spell = \"Quake / Infection\",\n            icon = 135801,\n        },\n    },\n    SPELL_DAMAGE = {\n        [39015] = {\n            spell = \"Frenzy / Atrophic\",\n            icon = 136146,\n        },\n    },\n    SPELL_MISSED = {\n        [39015] = {\n            spell = \"Frenzy / Atrophic\",\n            icon = 136146,\n        },\n    },\n    SPELL_AURA_APPLIED = {\n        [39015] = {\n            spell = \"Frenzy / Atrophic\",\n            icon = 136146,\n        },\n    },\n}\n\naura_env.optionSpells = {\n    {\n        spell = \"Frenzy / Atrophic\",\n        icon = 136146,\n    },\n    {\n        spell = \"Geyser / Parasite\",\n        icon = 135793,\n    },\n    {\n        spell = \"Quake / Infection\",\n        icon = 135801,\n    },\n}",
