["CT:[MH][Trash] Spell Cast Success CDs"] = {
["outline"] = "OUTLINE",
["wagoID"] = "2XzLgw2qF",
["authorOptions"] = {
},
["displayText"] = "",
["customText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
["do_glow"] = false,
["do_custom"] = false,
["sound"] = "Interface\\Addons\\FojjiCore\\sound\\fojjiSnap.ogg",
["do_sound"] = false,
},
["finish"] = {
["custom"] = "for key,guids in pairs(aura_env.count) do\n    for guid in pairs(guids) do\n        aura_env.nuTimer(key,nil,nil,guid)\n    end\nend\n\nfor key in pairs(aura_env.spells) do\n    aura_env.count[key] = {}\n    aura_env.firstSeen[key] = {}\n    aura_env.lastCast[key] = {}\nend",
["do_sound"] = false,
["do_message"] = false,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
["do_custom"] = true,
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.spells = {\n    TRASH_GHOUL_FRENZY = {\n        cdStart = 19,\n        cdWindow = 20,\n        spellID = 31540,\n        npcID = \"17895\",\n    },\n    \n    --[[TRASH_NECRO_UNHOLYFRENZY = {\n        cdStart = 19,\n        cdWindow = 20,\n        spellID = 31626,\n        npcID = \"17899\",\n    },--]]\n    \n    TRASH_ABOM_KNOCKDOWN = {\n        cdStart = 10,\n        cdWindow = 11.3,\n        spellID = 31610,\n        npcID = \"17898\",\n    },\n    \n    TRASH_BANSHEE_SHELL = {\n        cdStart = 10,\n        cdWindow = 12,\n        spellID = 31662,\n        npcID = \"17905\",\n    },\n    \n    TRASH_BANSHEE_CURSE = {\n        cdStart = 6,\n        cdWindow = 11,\n        spellID = 31651,\n        npcID = \"17905\",\n    },\n    \n    TRASH_DOOMGUARD_CRIPPLE = {\n        cdStart = 2,\n        cdWindow = 8,\n        spellID = 31406,\n        npcID = \"17864\",\n    },\n    \n    TRASH_DOOMGUARD_WARSTOMP = {\n        cdStart = 6,\n        cdWindow = 13,\n        spellID = 31408,\n        npcID = \"17864\",\n    },\n}\n\naura_env.bySpellID = {}\naura_env.byNpcID = {}\naura_env.count = {}\naura_env.firstSeen = {}\naura_env.lastCast = {}\naura_env.debug = false\n\nfor key,data in pairs(aura_env.spells) do\n    data.key = key\n    data.spellName = GetSpellInfo(data.spellID)\n    \n    aura_env.bySpellID[data.spellID] = data\n    \n    if not aura_env.byNpcID[data.npcID] then\n        aura_env.byNpcID[data.npcID] = {}\n    end\n    aura_env.byNpcID[data.npcID][key] = data\n    \n    aura_env.count[key] = {}\n    aura_env.firstSeen[key] = {}\n    aura_env.lastCast[key] = {}\nend\n\nfunction aura_env.debugPrint(msg)\n    if aura_env.debug then\n        print(\"|cff3399ffFojji|r \"..msg)\n    end\nend\n\nfunction aura_env.nuTimer(key,countdown,count,guid)\n    WeakAuras.ScanEvents(\"WA_NUMEN_TIMER\",key,countdown,count,guid)\nend\n\nfunction aura_env.updateState(allstates)\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n    }\nend\n\nfunction aura_env.hideState(allstates)\n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\n    return false\nend",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["custom_type"] = "stateupdate",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(allstates,event,...)\n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local _,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId = ...\n        \n        if subEvent == \"SPELL_DAMAGE\" or subEvent == \"RANGE_DAMAGE\" or subEvent == \"SPELL_AURA_APPLIED\" then\n            local npcID = select(6,strsplit(\"-\",destGUID))\n            local npcSpells = aura_env.byNpcID[npcID]\n            \n            if npcSpells then\n                local found = false\n                \n                for key,data in pairs(npcSpells) do\n                    if not aura_env.count[key][destGUID] then\n                        aura_env.firstSeen[key][destGUID] = GetTime()\n                        aura_env.count[key][destGUID] = 1\n                        aura_env.nuTimer(key,data.cdStart,1,destGUID)\n                        found = true\n                    end\n                end\n                \n                if found then\n                    aura_env.updateState(allstates)\n                    return true\n                end\n            end\n        end\n        \n        if subEvent == \"UNIT_DIED\" then\n            local npcID = select(6,strsplit(\"-\",destGUID))\n            local npcSpells = aura_env.byNpcID[npcID]\n            \n            if npcSpells then\n                for key,data in pairs(npcSpells) do\n                    aura_env.count[key][destGUID] = nil\n                    aura_env.firstSeen[key][destGUID] = nil\n                    aura_env.lastCast[key][destGUID] = nil\n                    aura_env.nuTimer(key,nil,nil,destGUID)\n                end\n                \n                return true\n            end\n        end\n        \n        local data = aura_env.bySpellID[spellId]\n        \n        if not data then\n            return false\n        end\n        \n        if subEvent == \"SPELL_CAST_SUCCESS\" then\n            local now = GetTime()\n            local count = aura_env.count[data.key][sourceGUID] or 1\n            \n            if aura_env.lastCast[data.key][sourceGUID] then\n                aura_env.debugPrint(string.format(\"NPC %s - %s (%d): %.1fs after previous.\",data.npcID,data.spellName,count,now-aura_env.lastCast[data.key][sourceGUID]))\n            elseif aura_env.firstSeen[data.key][sourceGUID] then\n                aura_env.debugPrint(string.format(\"NPC %s - First %s (%d): %.1fs after detection.\",data.npcID,data.spellName,count,now-aura_env.firstSeen[data.key][sourceGUID]))\n            end\n            \n            aura_env.lastCast[data.key][sourceGUID] = now\n            \n            aura_env.updateState(allstates)\n            aura_env.nuTimer(data.key,0,count,sourceGUID)\n            aura_env.count[data.key][sourceGUID] = count+1\n            aura_env.nuTimer(data.key,data.cdWindow,aura_env.count[data.key][sourceGUID],sourceGUID)\n            return true\n        end\n    end\n    \n    return false\nend",
["events"] = "CLEU:SPELL_CAST_SUCCESS:SPELL_DAMAGE:RANGE_DAMAGE:SPELL_AURA_APPLIED:UNIT_DIED",
["spellIds"] = {
},
