["custom"] = "function(allstates,event,...)\n    if event == \"STATUS\" then\n        aura_env.shown = false\n        return false\n    end\n    \n    if event == \"PLAYER_ENTERING_WORLD\" or event == \"ZONE_CHANGED\" then\n        print(event)\n        if aura_env.shown or UnitAffectingCombat(\"player\") then\n            return false\n        end\n        \n        if aura_env.isArchimondeAvailable() then\n            aura_env.createClickable(allstates)\n            aura_env.shown = true\n            return true\n        end\n        \n        return false\n    end\n    \n    if event == \"WA_ARCHIMONDE_CREATE_CLICKABLE\" then\n        if UnitAffectingCombat(\"player\") then\n            aura_env.scheduleCreate()\n            return false\n        end\n        \n        if aura_env.shown then\n            return false\n        end\n        \n        aura_env.createClickable(allstates)\n        aura_env.shown = true\n        return true\n    end\n    \n    if event == \"PLAYER_TARGET_CHANGED\" then\n        if aura_env.shown or UnitAffectingCombat(\"player\") then\n            return false\n        end\n        \n        local guid = UnitGUID(\"target\")\n        local npcID = guid and select(6,strsplit(\"-\",guid))\n        \n        if npcID == \"17948\" or npcID == \"17968\" then\n            aura_env.scheduleCreate()\n        end\n    end\n    \n    return false\nend",
["spellIds"] = {
},
["subeventSuffix"] = "_CAST_START",
["check"] = "event",
["names"] = {
},
["events"] = "PLAYER_TARGET_CHANGED WA_ARCHIMONDE_CREATE_CLICKABLE PLAYER_ENTERING_WORLD ZONE_CHANGED STATUS",
