["events"] = "WA_NUMEN_TIMER",
["custom"] = "function(a, e, key, time, count)\n    if e == \"WA_NUMEN_TIMER\" then\n        if key ~= \"MAULGAR_SPELL_SHIELD\" then\n            return false\n        end\n        \n        if time == 0 or time == nil then\n            if a[\"\"] then\n                a[\"\"].show = false\n                a[\"\"].changed = true\n            end\n        elseif time > 0 then\n            a[\"\"] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = time,\n                expirationTime = GetTime() + time,\n            }\n            return true\n        end\n    end\nend",
