},
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["shadowYOffset"] = -1,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiT5RaidPack/3",
["actions"] = {
["start"] = {
["do_glow"] = false,
["sound"] = "Interface\\Addons\\FojjiCore\\sound\\fojjiSnap.ogg",
["do_custom"] = false,
["do_sound"] = false,
},
["finish"] = {
["custom"] = "\n\n",
["do_sound"] = false,
["do_message"] = false,
["do_custom"] = false,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
},
["init"] = {
["custom"] = "aura_env.spellID = 38591\n\nfunction aura_env.unitTargetScan(sourceGUID)\n    local unit = \"target\"\n    if UnitExists(unit) and UnitGUID(unit) == sourceGUID then \n        return unit \n    end\n    unit = \"focus\"\n    if UnitExists(unit) and UnitGUID(unit) == sourceGUID then \n        return unit \n    end\n    for i = 1,40 do\n        unit = \"nameplate\"..i\n        if UnitExists(unit) and UnitGUID(unit) == sourceGUID then \n            return unit \n        end\n    end\n    return nil\nend",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, ...)\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local _,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId = ...\n        \n        if spellId ~= aura_env.spellID then\n            return false\n        end\n        \n        if subEvent == \"SPELL_CAST_START\" then\n            C_Timer.After(0.1, function()\n                    local unit = aura_env.unitTargetScan(sourceGUID)\n                    if unit and UnitExists(unit..\"target\") then\n                        WeakAuras.ScanEvents(\"WA_TRASH_SHATTER_ARMOR_TARGET\", sourceGUID, UnitGUID(unit..\"target\"), unit..\"target\")\n                    end\n            end)\n            return true\n        end\n    end\nend",
["spellIds"] = {
},
["events"] = "CLEU:SPELL_CAST_START",
["check"] = "event",
["unit"] = "player",
["custom_hide"] = "timed",
["customVariables"] = "",
