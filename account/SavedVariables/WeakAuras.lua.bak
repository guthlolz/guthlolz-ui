["sparkOffsetY"] = 0,
["gradientOrientation"] = "HORIZONTAL",
["textureWrapMode"] = "CLAMPTOBLACKADDITIVE",
["foregroundTexture"] = "Interface\\AddOns\\WeakAuras\\Media\\Textures\\Ring_10px.tga",
