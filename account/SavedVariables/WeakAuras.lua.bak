["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["custom_type"] = "stateupdate",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(allstates, event, boss, mode, wave, composition)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            wave = math.random(1,8),\n        }\n        return true\n    end\n    \n    if event == \"STATUS\" then\n        aura_env.throttle = GetTime() + 3\n        return false\n    end\n    \n    if aura_env.throttle and GetTime() < aura_env.throttle then\n        return false\n    end\n    \n    if event == \"WA_FJI_HYJAL_WAVE\" and mode == \"current\" and wave then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            autoHide = true,\n            duration = 3.5,\n            expirationTime = GetTime() + 3.5,\n            wave = wave,\n            boss = boss,\n        }\n        return true\n    end\nend",
["events"] = "WA_FJI_HYJAL_WAVE STATUS",
