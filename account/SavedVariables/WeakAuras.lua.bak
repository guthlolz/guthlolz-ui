["desaturateBackground"] = false,
["cooldownSwipe"] = true,
["automaticWidth"] = "Auto",
["customTextUpdate"] = "event",
["adjustedMax"] = "",
["desaturateForeground"] = false,
["triggers"] = {
{
["trigger"] = {
["duration"] = "2",
["unit"] = "player",
["debuffType"] = "HELPFUL",
["type"] = "custom",
["custom_type"] = "stateupdate",
["custom_hide"] = "timed",
["names"] = {
},
["event"] = "Health",
["events"] = "CLEU:SPELL_CAST_START:SPELL_INTERRUPT:SPELL_CAST_SUCCESS, NAME_PLATE_UNIT_ADDED, NAME_PLATE_UNIT_REMOVED, RAID_TARGET_UPDATE, WA_WARDER_MARKS_UPDATED",
["customDuration"] = "",
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            rotation = 1,\n            unit = unit,\n            status = \"Casting\",\n            raidMark = \"{rt\" .. math.random(1,8) .. \"}\"\n        }\n        return true\n    end\n    \n    if event == \"STATUS\" then\n        aura_env.iterateNameplatesAndUpdate()\n        return true\n    end\n    \n    if event == \"RAID_TARGET_UPDATE\" then\n        aura_env.onRaidTargetUpdate()\n        return\n    end\n    \n    if event == \"WA_WARDER_MARKS_UPDATED\" then\n        local guid, unit, raidMark = ...\n        local npcId = select(6, strsplit(\"-\", guid or \"\"))\n        if not guid or npcId ~= aura_env.npcId then return end\n        aura_env.marks[guid] = raidMark\n        aura_env.updateState(allstates, guid, \"Idle\", unit)\n        return true\n    end\n    \n    if event == \"NAME_PLATE_UNIT_ADDED\" then\n        local unit = ...\n        local guid = UnitGUID(unit)\n        local raidMark = GetRaidTargetIndex(unit)\n        aura_env.marks[guid] = raidMark\n        aura_env.updateState(allstates, guid, \"Idle\", unit)\n        return true\n    end\n    \n    if event == \"NAME_PLATE_UNIT_REMOVED\" then\n        local unit = ...\n        local guid = UnitGUID(unit)\n        if allstates[guid] then\n            allstates[guid].show = false\n            allstates[guid].changed = true\n            return true\n        end\n    end\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local _, subEvent, _, sourceGUID, _, _, _, destGUID, _, _, _, spellId, _, _, extraSpellId = ...\n        \n        if subEvent == \"SPELL_CAST_START\" and aura_env.trackedSpells[spellId] then\n            local duration = aura_env.trackedSpells[spellId] or aura_env.castTime\n            aura_env.updateVisibleNameplateUnits(allstates, sourceGUID, \"Casting\", duration)\n            return true\n        end\n        \n        if subEvent == \"SPELL_INTERRUPT\" and aura_env.trackedSpells[extraSpellId] then\n            local count = (aura_env.interruptCounts[destGUID] or 1) % aura_env.rotation + 1\n            aura_env.interruptCounts[destGUID] = count\n            WeakAuras.ScanEvents(\"WA_GUARDIAN_INTERRUPTED\", sourceGUID, destGUID, spellId)\n            aura_env.updateVisibleNameplateUnits(allstates, destGUID, \"Idle\")\n            return true\n        end\n        \n        if subEvent == \"SPELL_CAST_SUCCESS\" and aura_env.trackedSpells[spellId] then\n            local count = (aura_env.interruptCounts[sourceGUID] or 1) % aura_env.rotation + 1\n            aura_env.interruptCounts[sourceGUID] = count\n            aura_env.updateVisibleNameplateUnits(allstates, sourceGUID, \"Idle\")\n            return true\n        end\n    end\nend",
["spellIds"] = {
},
["dynamicDuration"] = false,
["check"] = "event",
["subeventSuffix"] = "_CAST_START",
["subeventPrefix"] = "SPELL",
["customVariables"] = "{\n    status = \"string\",\n    rotation = \"number\",\n}",
