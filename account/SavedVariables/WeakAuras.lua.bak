{
["trigger"] = {
["type"] = "custom",
["events"] = "TRIGGER:1:13:14",
["custom_type"] = "stateupdate",
["check"] = "event",
["debuffType"] = "HELPFUL",
["custom"] = "function(allstates, event, triggerNum, triggerStates)\n    local now = GetTime()\n    \n    if triggerNum == 1 then\n        local expiration, duration\n        \n        for _, state in pairs(triggerStates or {}) do\n            if state.expirationTime and state.duration then\n                expiration = state.expirationTime\n                duration = state.duration\n                break\n            end\n        end\n        \n        if not expiration or not duration then\n            return false\n        end\n        \n        aura_env.swingExp = expiration\n        aura_env.swingDur = duration\n        \n        if aura_env.gcdExp then\n            aura_env.placeTickReal()\n        end\n        \n        return false\n        \n    elseif triggerNum == 13 then\n        local expiration\n        \n        for _, state in pairs(triggerStates or {}) do\n            if state.expirationTime and state.duration then\n                expiration = state.expirationTime\n                break\n            end\n        end\n        \n        if not expiration then\n            return false\n        end\n        \n        aura_env.gcdExp = expiration\n        \n        if aura_env.hasActiveSwing(now) then\n            aura_env.placeTickReal()\n        else\n            aura_env.placeTickVirtual()\n        end\n        \n        return false\n        \n    elseif triggerNum == 14 then\n        aura_env.gcdExp = nil\n        return false\n    end\nend",
["unit"] = "player",
},
["untrigger"] = {
},
},
