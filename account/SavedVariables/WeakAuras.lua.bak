["custom_type"] = "status",
["subeventSuffix"] = "_CAST_START",
["auraspellids"] = {
"34775",
},
["useName"] = false,
["event"] = "Health",
["customStacks"] = "function()\n    return aura_env.stacks\nend",
["customDuration"] = "function()\n    return aura_env.duration, aura_env.expirationTime\nend",
["custom"] = "function(event, unit)\n    if event == \"PLAYER_EQUIPMENT_CHANGED\" then\n        local trinketItemId = GetInventoryItemID(\"player\", aura_env.slot)\n        aura_env.trinketItemId = trinketItemId\n        aura_env.expirationTime = nil\n        aura_env.duration = nil\n        aura_env.icon = nil\n        aura_env.trinketBuffId = nil\n        if trinketItemId and aura_env.trinketBuffs[trinketItemId] then\n            aura_env.trinketBuffId = aura_env.trinketBuffs[trinketItemId]\n        end\n    end\n    \n    if unit ~= \"player\" then\n        return false\n    end\n    \n    if not aura_env.trinketBuffId then\n        return false\n    end\n    \n    local name, icon, count, _, duration, expirationTime, _, _, _, spellId = WA_GetUnitBuff(\"player\", aura_env.trinketBuffId)\n    \n    aura_env.name = name\n    aura_env.icon = icon\n    aura_env.stacks = count\n    aura_env.duration = duration\n    aura_env.expirationTime = expirationTime\n    \n    return spellId ~= nil\nend",
["spellIds"] = {
},
["events"] = "UNIT_AURA:player  PLAYER_EQUIPMENT_CHANGED",
["check"] = "event",
["unit"] = "player",
["useExactSpellId"] = true,
["useIgnoreName"] = false,
},
["untrigger"] = {
},
},
