["custom"] = "function(allstates, event)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 3,\n            expirationTime = GetTime() + 3,\n            name = \"Phase 2\",\n            autoHide = true,\n            icon = 136221,\n        }\n        return true\n    end\n    \n    if event == \"WA_SOLARIAN_P2_START\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 3,\n            expirationTime = GetTime() + 3,\n            name = \"Phase 2\",\n            autoHide = true,\n            icon = 136221,\n        }\n        return true\n    end\n    \n    if event == \"WA_SOLARIAN_SPLIT\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 3,\n            expirationTime = GetTime() + 3,\n            name = \"Add Phase\",\n            autoHide = true,\n            icon = 135736,\n        }\n        return true\n    end\nend",
