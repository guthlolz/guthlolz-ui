["Tankadin Stats"] = {
["controlledChildren"] = {
"Raw Stats",
"Righteous Fury Reminder",
},
["borderBackdrop"] = "Blizzard Dialog Background Dark",
["wagoID"] = "sHcW3qEUL",
["authorOptions"] = {
},
["preferToUpdate"] = false,
["yOffset"] = 40,
["anchorPoint"] = "LEFT",
["borderColor"] = {
1,
1,
1,
1,
},
["url"] = "https://wago.io/sHcW3qEUL/3",
["actions"] = {
["start"] = {
},
["init"] = {
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["unit"] = "player",
["type"] = "aura2",
["spellIds"] = {
},
["subeventSuffix"] = "_CAST_START",
["subeventPrefix"] = "SPELL",
["debuffType"] = "HELPFUL",
["event"] = "Health",
["names"] = {
},
},
["untrigger"] = {
},
},
},
["internalVersion"] = 90,
["selfPoint"] = "CENTER",
["desc"] = "Originally by Bluedawn of Paladin Classic with initial customizations by Kaias and based on the work by Komanchi, this Tankadin statistics suite has been overhauled for my own tastes and is maintained by Sister Sadb of Dreamscythe. This version features some small updates, a lot of reordering, and a few mechanical changes to provide real-time defensive clarity.\n\nCore mechanics and display logic:\n- Crit: Displays current critical strike reduction. The dynamic reference scale (5.2/5.4/5.6) highlights meeting the un-crit cap for levels 71, 72, and 73 respectively. Meeting the level 73 cap turns the primary value green.\n- Crush: Shows live Combat Table Coverage (CTC) against a level 73 boss. The reference value (102.4%) is color-coded to identify gear capability: Green for natural uncrushable status and Blue for status requiring the Libram of Repentance.\n- Shear: Calculates specific coverage for Illidan's Shear. Since this ability cannot be missed, the calculation is restricted to Dodge + Parry + Block with a requirement of 101.8%.\n- SWR: Calculates coverage while under the effect of Sunwell Radiance. This adjusts for the aura's 20% Dodge reduction and 5% Miss reduction to show true coverage in Sunwell Plateau.\n- Mob Calculations: Damage Reduction (DR) and Effective HP (EHP) are calculated against a level 73 boss by default. When a target is selected, a secondary comparison in parentheses displays dynamic stats adjusted for that specific mob's level. Comparison values are color-coded: Red for higher level, Green for lower level, and Grey for mobs that no longer grant experience (CharLevel - 9).\n\nTerminology and Abbreviations:\n- DR = Total Damage Reduction combining Physical Armor mitigation and Improved Righteous Fury talents.\n- EHP = Effective Health Pool based on maximum health, armor, and damage reduction talents.\n- SH/MH = Spell Hit and Melee Hit percentages including all ratings and modifiers.\n\nThese updates utilize a high-frequency status trigger (UNIT_AURA, UNIT_RESISTANCES, UNIT_HEALTH, etc.) to ensure that stats, aura swaps, and talent modifiers update the display in real-time without event throttling.",
["version"] = 3,
