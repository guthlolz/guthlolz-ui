{
["fontSize"] = "large",
["text"] = "|TInterface\\AddOns\\FojjiCore\\textures\\TBC Icon\\illidan.jpg:14:14|t Fojji - Black Temple Raiding Pack [Customization] |TInterface\\AddOns\\FojjiCore\\textures\\TBC Icon\\illidan.jpg:14:14|t",
["type"] = "description",
