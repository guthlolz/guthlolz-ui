["init"] = {
["custom"] = "aura_env.playerGUID = UnitGUID(\"player\")\naura_env.casting = false\naura_env.icon = nil\naura_env.lastT = 0\naura_env.curRegister = 1\naura_env.maxRegister = 6\naura_env.iconSize = 38\naura_env.iconStep = aura_env.iconSize + 4\naura_env.currentSpellId = nil\naura_env.currentCastType = nil\naura_env.currentToken = nil\naura_env.userBlacklistText = \"\"\naura_env.lastHistoryKey = nil\naura_env.lastHistoryAt = 0\naura_env.historyDedupeWindow = 0.20\naura_env.builtinBlacklist = {\n    [75] = true,\n}\n\naura_env.parsedBlacklist = {}\naura_env.parsedBlacklistSource = nil\naura_env.ParseBlacklist = function()\n    local source = tostring(aura_env.userBlacklistText or \"\")\n    if aura_env.parsedBlacklistSource == source then\n        return\n    end\n    \n    wipe(aura_env.parsedBlacklist)\n    \n    for id in string.gmatch(source, \"%d+\") do\n        aura_env.parsedBlacklist[tonumber(id)] = true\n    end\n    \n    aura_env.parsedBlacklistSource = source\nend\n\naura_env.IsBlacklisted = function(spellId)\n    if not spellId then\n        return true\n    end\n    \n    aura_env.ParseBlacklist()\n    \n    if aura_env.builtinBlacklist[spellId] then\n        return true\n    end\n    \n    if aura_env.parsedBlacklist[spellId] then\n        return true\n    end\n    \n    return false\nend",
["do_custom"] = true,
},
