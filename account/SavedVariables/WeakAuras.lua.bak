["events"] = "PLAYER_ENTERING_WORLD, ZONE_CHANGED, ZONE_CHANGED_NEW_AREA, PLAYER_EQUIPMENT_CHANGED",
["spellIds"] = {
},
["names"] = {
},
["check"] = "event",
["custom"] = "function()\n    local mh = GetInventoryItemID(\"player\", 16)\n    local oh = GetInventoryItemID(\"player\", 17)\n    \n    if not mh then\n        return true\n    end\n    \n    local isTwoHand = false\n    if mh then\n        local _, _, _, _, _, _, _, _, equipLoc = GetItemInfo(mh)\n        if equipLoc == \"INVTYPE_2HWEAPON\" then\n            isTwoHand = true\n        end\n    end\n    \n    if not oh and not isTwoHand then\n        return true\n    end\n    \n    return false\nend",
["unit"] = "player",
["subeventPrefix"] = "SPELL",
},
["untrigger"] = {
["custom"] = "function()\n    local mh = GetInventoryItemID(\"player\", 16)\n    if not mh then\n        return false\n    end\n    \n    local _,_,_,_,_,_,_,_,equipLoc = GetItemInfo(mh)\n    \n    if equipLoc == \"INVTYPE_2HWEAPON\" then\n        return true\n    end\n    \n    return GetInventoryItemID(\"player\", 17) ~= nil\nend",
},
},
