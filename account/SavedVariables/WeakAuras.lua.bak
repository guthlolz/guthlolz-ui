["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["custom_hide"] = "timed",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["subeventSuffix"] = "_CAST_START",
["unit"] = "player",
["events"] = "CHAT_MSG_RAID_LEADER STATUS WA_FJI_MAGTHERIDON_KILLED",
["custom"] = "function(allstates, event, msg)\n    if event == \"OPTIONS\" then\n        local prev = { 8, 7, 4, 5, 3 }\n        for i = 1, 5 do\n            local m = prev[i]\n            allstates[i] = allstates[i] or {}\n            allstates[i].show = true\n            allstates[i].changed = true\n            allstates[i].markIndex = m\n            allstates[i].mark = \"{rt\" .. m .. \"}\"\n            allstates[i].location = aura_env.LOCATIONS[i]\n        end\n        return true\n    end\n    \n    if event == \"WA_FJI_MAGTHERIDON_KILLED\" then\n        for _, state in pairs(allstates) do\n            state.show = false\n            state.changed = true\n        end\n        aura_env.saved.marks = nil\n        aura_env.saved.teams = nil\n        return true\n    end\n    \n    if event == \"STATUS\" then\n        return aura_env.updateState(allstates)\n    end\n    \n    if event ~= \"CHAT_MSG_RAID_LEADER\" then\n        return false\n    end\n    \n    do\n        local tNum, namesStr = msg:match(\"^TEAM(%d)%-(.+)$\")\n        tNum = tonumber(tNum)\n        if tNum and namesStr then\n            local nameToGuid = {}\n            for unit in WA_IterateGroupMembers() do\n                local guid = UnitGUID(unit)\n                local name, realm = UnitName(unit)\n                if guid and name then\n                    nameToGuid[name] = guid\n                    if realm and realm ~= \"\" then\n                        nameToGuid[name .. \"-\" .. realm] = guid\n                    end\n                end\n            end\n            \n            namesStr = namesStr:gsub(\"%{rt%d%}\", \"\")\n            namesStr = namesStr:gsub(\"|T.-|t\", \"\")\n            \n            local team = {}\n            for _, raw in ipairs({ strsplit(\",\", namesStr) }) do\n                local name = strtrim(raw)\n                if name ~= \"\" then\n                    local guid = nameToGuid[name]\n                    if guid then\n                        tinsert(team, guid)\n                    end\n                end\n            end\n            \n            aura_env.saved.teams = aura_env.saved.teams or {}\n            aura_env.saved.teams[tNum] = team\n            return false\n        end\n    end\n    \n    if not msg:match(\"%{rt%d%}\") then\n        return false\n    end\n    \n    local marks = {}\n    for n in msg:gmatch(\"%{rt(%d)%}\") do\n        local mark = tonumber(n)\n        if mark and mark >= 1 and mark <= 8 then\n            tinsert(marks, mark)\n        end\n        if #marks >= 5 then\n            break\n        end\n    end\n    \n    if #marks == 0 then\n        return false\n    end\n    \n    aura_env.saved.marks = marks\n    return aura_env.updateState(allstates)\nend",
["check"] = "event",
["spellIds"] = {
},
["names"] = {
},
