["custom"] = "function(allstates, event, encounterID, encounterName, difficultyID, groupSize, success)\n    if event == \"ENCOUNTER_END\" and success == 0 then\n        if encounterID == 1573 then\n            aura_env.eRespawnTimer = GetTime() + 20\n        else\n            aura_env.eRespawnTimer = GetTime() + 30\n        end\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = aura_env.eRespawnTimer - GetTime(),\n            expirationTime = aura_env.eRespawnTimer,\n            autoHide = true,\n            bossName = encounterName,\n        }\n        return true\n    elseif event == \"STATUS\" and aura_env.eRespawnTimer and aura_env.eRespawnTimer - GetTime() > 0 then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = aura_env.eRespawnTimer - GetTime(),\n            expirationTime = aura_env.eRespawnTimer,\n            autoHide = true,\n            bossName = encounterName,\n        }\n        return true\n    end\nend",
