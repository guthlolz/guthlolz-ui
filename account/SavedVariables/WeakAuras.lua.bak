["[BT] Requirements Check"] = {
["outline"] = "OUTLINE",
["wagoID"] = "N57hx-mDf",
["authorOptions"] = {
},
["displayText"] = "%i WARNING: |cFFffffffFojjiCore Addon Missing|r %i",
["customText"] = "",
["shadowYOffset"] = -1,
["anchorPoint"] = "CENTER",
["semver"] = "1.2.2",
["displayText_format_c_abbreviate_max"] = 8,
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiBT-P2/10",
["actions"] = {
["start"] = {
["sound"] = "Interface\\AddOns\\WeakAuras\\Media\\Sounds\\BikeHorn.ogg",
["custom"] = "\n",
["do_custom"] = false,
["do_sound"] = false,
},
["init"] = {
["custom"] = "aura_env.instanceID = 564\naura_env.requiredVersion = \"1.7.3\"\naura_env.icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\F_icon_teal.png\"\n\naura_env.fojji_url = \"https://www.curseforge.com/wow/addons/fojjicore\"\naura_env.fojji_url_msg = \"|cFF00FFFF|Hurl:\" .. aura_env.fojji_url .. \"|h[\" .. aura_env.fojji_url .. \"]|h|r\"\n\naura_env.roleAuraID = \"Fojji - FojjiAPI Role [TBC]\"\naura_env.roleURL = \"https://wago.io/FojjiAPIRoleTBC\"\n\naura_env.anchorAuraID = \"Fojji - Raid Pack Anchors [Classic]\"\naura_env.anchorURL = \"https://wago.io/FojjiRaidAnchors-Classic\"\n\nfunction aura_env.versionAtLeast(current,required)\n    local function split(ver)\n        local major,minor,patch = string.match(ver or \"0.0.0\",\"^(%d+)%.(%d+)%.(%d+)\")\n        return tonumber(major) or 0,tonumber(minor) or 0,tonumber(patch) or 0\n    end\n    \n    local c1,c2,c3 = split(current)\n    local r1,r2,r3 = split(required)\n    \n    if c1 > r1 then return true end\n    if c1 < r1 then return false end\n    if c2 > r2 then return true end\n    if c2 < r2 then return false end\n    \n    return c3 >= r3\nend\n\nfunction aura_env.hideAll(allstates)\n    for _,state in pairs(allstates) do\n        state.show = false\n        state.changed = true\n    end\n    return true\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_hide"] = "timed",
["custom_type"] = "stateupdate",
["subeventPrefix"] = "SPELL",
["duration"] = "15",
["event"] = "Health",
["unit"] = "player",
["subeventSuffix"] = "_CAST_START",
["custom"] = "function(allstates,event,...)\n    if event ~= \"ZONE_CHANGED_NEW_AREA\" then\n        return false\n    end\n    \n    local instanceID = select(8,GetInstanceInfo())\n    \n    if instanceID ~= aura_env.instanceID then\n        return false\n    end\n    \n    local fojjiVersion = _G.FojjiCore_Version\n    local coreMissing = not fojjiVersion\n    local coreOutdated = not coreMissing and not aura_env.versionAtLeast(fojjiVersion,aura_env.requiredVersion)\n    local roleMissing = WeakAuras.GetData(aura_env.roleAuraID) == nil\n    local anchorsMissing = WeakAuras.GetData(aura_env.anchorAuraID) == nil\n    local now = GetTime()\n    \n    if coreMissing or coreOutdated then\n        allstates.fojjicore = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 15,\n            expirationTime = now + 15,\n            autoHide = true,\n            name = \"fojjicore\",\n            missing = coreMissing,\n            outdated = coreOutdated,\n            version = fojjiVersion,\n            requiredVersion = aura_env.requiredVersion,\n            url = aura_env.fojji_url,\n            icon = aura_env.icon,\n            index = 1\n        }\n        \n        if coreMissing then\n            print(\"|cFFFF0000WARNING!|r\")\n            print(\"|cFF40C7EBFojjiCore|r Missing.\")\n            print(\"You won't have Sounds & Textures and Auras will be broken.\")\n            print(\"Download from:\")\n            print(aura_env.fojji_url_msg)\n        else\n            print(\"|cFFFF0000WARNING!|r\")\n            print(\"|cFF40C7EBFojjiCore|r is outdated (Found v\" .. tostring(fojjiVersion or \"?\") .. \", Requires v\" .. aura_env.requiredVersion .. \" or higher).\")\n            print(\"You won't have Sounds & Textures and Auras will be broken.\")\n            print(\"Download from:\")\n            print(aura_env.fojji_url_msg)\n        end\n    end\n    \n    if roleMissing then\n        allstates.role = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 15,\n            expirationTime = now + 15,\n            autoHide = true,\n            name = \"role\",\n            url = aura_env.roleURL,\n            icon = aura_env.icon,\n            index = 2\n        }\n        \n        print(\"|cFFFF0000WARNING!|r\")\n        print(\"|cFF40C7EBFojji API Role WeakAura|r Missing.\")\n        print(\"Import from:\")\n        print(\"|cFF00FFFF|Hurl:\" .. aura_env.roleURL .. \"|h[\" .. aura_env.roleURL .. \"]|h|r\")\n    end\n    \n    if anchorsMissing then\n        allstates.anchors = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 15,\n            expirationTime = now + 15,\n            autoHide = true,\n            name = \"anchors\",\n            url = aura_env.anchorURL,\n            icon = aura_env.icon,\n            index = 3\n        }\n        \n        print(\"|cFFFF0000WARNING!|r\")\n        print(\"|cFF40C7EBFojji Raid Anchors|r Missing.\")\n        print(\"You need the Anchors WeakAura to position everything. Import from:\")\n        print(\"|cFF00FFFF|Hurl:\" .. aura_env.anchorURL .. \"|h[\" .. aura_env.anchorURL .. \"]|h|r\")\n    end\n    \n    return true\nend",
