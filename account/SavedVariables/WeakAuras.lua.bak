["CT:[T5][Leotheras] Phase Controller"] = {
["outline"] = "OUTLINE",
["wagoID"] = "gSs1_GQRl",
["color"] = {
1,
1,
1,
1,
},
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["shadowYOffset"] = -1,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiT5RaidPack/3",
["actions"] = {
["start"] = {
},
["finish"] = {
["custom"] = "",
["do_sound"] = false,
["do_message"] = false,
["do_custom"] = false,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.bindersKilled = 0\naura_env.demonCount = 0\n\nfunction aura_env.scheduleTimer(duration)\n    if aura_env.timer then\n        aura_env.timer:Cancel()\n        aura_env.timer = nil\n    end\n    \n    aura_env.timer = C_Timer.NewTimer(duration, function()\n            WeakAuras.ScanEvents(\"WA_LEOTHERAS_HUMAN_START\")\n    end)\nend\n\nfunction aura_env.cancelTimer()\n    if aura_env.timer then\n        aura_env.timer:Cancel()\n        aura_env.timer = nil\n    end\nend\n\nlocal locale = GetLocale()\n\naura_env.locales = {\n    [\"enUS\"] = {\n        demon = \"Be gone, trifling elf%.%s*I am in control now!\",\n        p1 = \"Finally, my banishment ends!\",\n        p2 = \"No... no! What have you done? I am the master! Do you hear me? I am... aaggh! Can't... contain him.\",\n    },\n    [\"frFR\"] = {\n        demon = \"Hors d'ici, elfe insignifiant. Je prends le contrôle !\",\n        p1 = \"Enfin, mon exil s'achève !\",\n        p2 = \"Non… Non ! Mais qu'avez-vous fait ? C'est moi le maître ! Vous entendez ? Moi ! Je suis… Aaargh ! Impossible… de… retenir…\",\n    },\n    [\"deDE\"] = {\n        demon = \"Hinfort, unbedeutender Elf%.%s*Ich habe jetzt die Kontrolle!\",\n        p1 = \"Endlich hat meine Verbannung ein Ende!\",\n        p2 = \"Nein... nein! Was habt Ihr getan? Ich bin der Meister! Hört Ihr? Ich! Ich... aaaaah! Ich kann ihn... nicht aufhalten...\",\n    },\n    [\"esES\"] = {\n        demon = \"Desaparece, elfo pusilánime. ¡Yo mando ahora!\",\n        p1 = \"¡Al fin acaba mi destierro!\",\n        p2 = \"¿Qué has hecho? ¡Yo soy el maestro!\",\n    },\n    [\"koKR\"] = {\n        demon = \"꺼져라, 엘프 꼬맹이. 지금부터는 내가 주인이다!\",\n        p1 = \"드디어, 내가 풀려났도다!\",\n        p2 = \"안 돼... 안 돼! 무슨 짓이냐? 내가 주인이야! 내 말 듣지 못해? 나란 말이야! 내가... 으아악! 놈을 억누를 수... 없...어.\",\n    },\n    [\"ruRU\"] = {\n        demon = \"Прочь, жалкий эльф. Настало мое время!\",\n        p1 = \"Наконец-то мое заточение окончено!\",\n        p2 = \"Нет... нет! Что вы наделали? Я – главный! Слышишь меня? Я... Ааааах! Мне его... не удержать.\",\n    },\n    [\"zhCN\"] = {\n        demon = \"滚开吧，脆弱的精灵。现在我说了算！\",\n        p1 = \"我的放逐终于结束了！\",\n        p2 = \"不……不！你在干什么？我才是主宰！你听到没有？我……啊啊啊啊！控制……不住了。\",\n    },\n    [\"zhTW\"] = {\n        demon = \"消失吧，微不足道的精靈。現在開始由我掌管!\",\n        p1 = \"終於結束了我的流放生涯!\",\n        p2 = \"不...不!你做了什麼?我是主人!你沒聽見我在說話嗎?我....啊!無法...控制它。\",\n    }\n}\n\naura_env.currentLocale = aura_env.locales[locale] or aura_env.locales[\"enUS\"]",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, ...)\n    if event == \"WA_FJI_ENCOUNTER_END\" or event == \"ENCOUNTER_END\" then\n        aura_env.bindersKilled = 0\n        aura_env.demonCount = 0\n        aura_env.cancelTimer()\n        return\n    end\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local _,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId = ...\n        \n        local npcID = select(6, strsplit(\"-\", destGUID))\n        if npcID == \"21806\" then\n            aura_env.bindersKilled = aura_env.bindersKilled + 1\n            if aura_env.bindersKilled == 3 then\n                WeakAuras.ScanEvents(\"WA_LEOTHERAS_P1_START\")\n                return true\n            end\n        end\n    end\n    \n    \n    if event == \"CHAT_MSG_MONSTER_YELL\" then\n        local msg = ...\n        \n        if msg == aura_env.currentLocale.p1 or msg:find(aura_env.currentLocale.p1, 1, true) then\n            WeakAuras.ScanEvents(\"WA_LEOTHERAS_P1_START\")\n            return true\n            \n        elseif msg == aura_env.currentLocale.p2 or msg:find(aura_env.currentLocale.p2, 1, true) then\n            WeakAuras.ScanEvents(\"WA_LEOTHERAS_P2_START\")\n            aura_env.cancelTimer()\n            return true\n            \n        elseif msg:find(aura_env.currentLocale.demon) then\n            aura_env.demonCount = aura_env.demonCount + 1\n            \n            WeakAuras.ScanEvents(\"WA_LEOTHERAS_DEMON_START\")\n            \n            local duration = aura_env.demonCount == 1 and 60 or 45\n            aura_env.scheduleTimer(duration)\n            \n            return true\n        end\n    end\nend",
["spellIds"] = {
},
["events"] = "WA_FJI_ENCOUNTER_END, ENCOUNTER_END, CHAT_MSG_MONSTER_YELL, CLEU:UNIT_DIED",
