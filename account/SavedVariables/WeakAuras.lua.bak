["hide_all_glows"] = false,
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.spellKeys = {\n    [\"TRASH_GHOUL_FRENZY\"] = {icon = 132117, npcID = \"17895\"}, -- Frenzy (Ghoul)\n    [\"TRASH_NECRO_UNHOLYFRENZY\"] = {icon = 136224, npcID = \"17899\"}, -- Unholy Frenzy (Necromancer)\n    [\"TRASH_ABOM_KNOCKDOWN\"] = {icon = 132154, npcID = \"17898\"}, -- Knockdown (Abomination)\n    [\"TRASH_BANSHEE_SHELL\"] = {icon = 136120, npcID = \"17905\"}, -- Anti-Magic Shell (Banshee)\n    [\"TRASH_BANSHEE_CURSE\"] = {icon = 136020, npcID = \"17905\"}, -- Curse (Banshee)\n    [\"TRASH_FELSTALKER_MANABURN\"] = {icon = 136170, npcID = \"17916\"}, -- Mana Burn (Fel Stalker)\n    [\"TRASH_DOOMGUARD_CRIPPLE\"] = {icon = 136135, npcID = \"17864\"}, -- Cripple (Doomguard)\n    [\"TRASH_DOOMGUARD_WARSTOMP\"] = {icon = 132368, npcID = \"17864\"}, -- War Stomp (Doomguard)\n}\n\naura_env.guids = {}\naura_env.pending = {}\naura_env.nameplateGUIDs = {}\n\nfunction aura_env.getNPCID(guid)\n    return guid and select(6,strsplit(\"-\",guid))\nend\n\nfunction aura_env.refreshNameplates()\n    wipe(aura_env.nameplateGUIDs)\n    \n    for _,plateData in pairs(C_NamePlate.GetNamePlates()) do\n        local unit = plateData.UnitFrame.displayedUnit\n        if unit then\n            local guid = UnitGUID(unit)\n            if guid then\n                aura_env.nameplateGUIDs[unit] = guid\n            end\n        end\n    end\nend\n\nfunction aura_env.getNameplateUnit(guid)\n    for unit,plateGUID in pairs(aura_env.nameplateGUIDs) do\n        if plateGUID == guid then\n            return unit\n        end\n    end\n    \n    aura_env.refreshNameplates()\n    \n    for unit,plateGUID in pairs(aura_env.nameplateGUIDs) do\n        if plateGUID == guid then\n            return unit\n        end\n    end\nend\n\nfunction aura_env.hideState(allstates,guid,key)\n    local state = allstates[guid..\"_\"..key]\n    \n    if state and state.show then\n        state.show = false\n        state.changed = true\n        return true\n    end\n    return false\nend\n\nfunction aura_env.cancelState(allstates,guid,key)\n    if aura_env.guids[guid] then\n        aura_env.guids[guid][key] = nil\n        \n        if not next(aura_env.guids[guid]) then\n            aura_env.guids[guid] = nil\n        end\n    end\n    \n    return aura_env.hideState(allstates,guid,key)\nend\n\nfunction aura_env.cancelNPCState(allstates,key)\n    local info = aura_env.spellKeys[key]\n    if not info then\n        return false\n    end\n    \n    if aura_env.pending[info.npcID] then\n        aura_env.pending[info.npcID][key] = nil\n        \n        if not next(aura_env.pending[info.npcID]) then\n            aura_env.pending[info.npcID] = nil\n        end\n    end\n    \n    for guid,data in pairs(aura_env.guids) do\n        if aura_env.getNPCID(guid) == info.npcID and data[key] then\n            data[key] = nil\n            \n            local state = allstates[guid..\"_\"..key]\n            if state then\n                state.show = false\n                state.changed = true\n            end\n            \n            if not next(data) then\n                aura_env.guids[guid] = nil\n            end\n        end\n    end\n    \n    return true\nend\n\nfunction aura_env.showState(allstates,guid,key,spellData,unit)\n    allstates[guid..\"_\"..key] = {\n        show = true,\n        changed = true,\n        progressType = \"timed\",\n        duration = spellData.duration,\n        expirationTime = spellData.expirationTime,\n        unit = unit,\n        autoHide = false,\n        icon = spellData.icon,\n        count = spellData.count,\n    }\n    \n    return true\nend\n\nfunction aura_env.updateState(allstates,key,time,count,guid)\n    local info = aura_env.spellKeys[key]\n    if not info then\n        return false\n    end\n    \n    local spellData = {\n        duration = time,\n        expirationTime = GetTime()+time,\n        icon = info.icon,\n        count = count,\n    }\n    \n    if guid then\n        if aura_env.getNPCID(guid) ~= info.npcID then\n            return false\n        end\n        \n        aura_env.guids[guid] = aura_env.guids[guid] or {}\n        aura_env.guids[guid][key] = spellData\n        \n        local unit = aura_env.getNameplateUnit(guid)\n        if unit then\n            return aura_env.showState(allstates,guid,key,spellData,unit)\n        end\n        return false\n    end\n    \n    aura_env.refreshNameplates()\n    \n    for unit,plateGUID in pairs(aura_env.nameplateGUIDs) do\n        if aura_env.getNPCID(plateGUID) == info.npcID then\n            aura_env.guids[plateGUID] = aura_env.guids[plateGUID] or {}\n            aura_env.guids[plateGUID][key] = spellData\n            return aura_env.showState(allstates,plateGUID,key,spellData,unit)\n        end\n    end\n    \n    aura_env.pending[info.npcID] = aura_env.pending[info.npcID] or {}\n    aura_env.pending[info.npcID][key] = spellData\n    return false\nend\n\nfunction aura_env.reset(allstates)\n    wipe(aura_env.guids)\n    wipe(aura_env.pending)\n    wipe(aura_env.nameplateGUIDs)\n    \n    for _,state in pairs(allstates) do\n        state.show = false\n        state.changed = true\n    end\n    \n    return true\nend",
["do_custom"] = true,
},
},
