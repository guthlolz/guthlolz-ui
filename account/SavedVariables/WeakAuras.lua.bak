{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["custom_type"] = "stateupdate",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(allstates, event, boss, mode)\n    if event == \"OPTIONS\" then\n        local data = aura_env.bossData.azgalor\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            autoHide = true,\n            duration = 2.5,\n            expirationTime = GetTime() + 2.5,\n            icon = data.icon,\n            boss = data.name:upper(),\n        }\n        return true\n    end\n    \n    if event == \"WA_FJI_HYJAL_WAVE\" and mode == \"spawn\" then\n        local data = aura_env.bossData[boss]\n        \n        if not data then\n            return false\n        end\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            autoHide = true,\n            duration = 2.5,\n            expirationTime = GetTime() + 2.5,\n            icon = data.icon,\n            boss = data.name:upper(),\n        }\n        return true\n    end\nend",
