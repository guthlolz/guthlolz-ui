["custom"] = "function(allstates, event)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 3,\n            expirationTime = GetTime() + 3,\n            name = \"Phase 2\",\n            autoHide = true,\n            icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\illidan.jpg\",\n        }\n        return true\n    end\n    \n    if event == \"WA_ILLIDAN_P2_START\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 3,\n            expirationTime = GetTime() + 3,\n            name = \"Phase 2\",\n            autoHide = true,\n            icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\illidan.jpg\",\n        }\n        return true\n    elseif event == \"WA_ILLIDAN_P3_START\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 3,\n            expirationTime = GetTime() + 3,\n            name = \"Phase 3\",\n            autoHide = true,\n            icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\illidan.jpg\",\n        }\n        return true\n    elseif event == \"WA_ILLIDAN_P4_START\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 3,\n            expirationTime = GetTime() + 3,\n            name = \"Phase 4\",\n            autoHide = true,\n            icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\illidan.jpg\",\n        }\n        return true\n    elseif event == \"WA_ILLIDAN_HUMAN_FORM\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 3,\n            expirationTime = GetTime() + 3,\n            name = \"Human Form\",\n            autoHide = true,\n            icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\illidan.jpg\",\n        }\n        return true\n    elseif event == \"WA_ILLIDAN_DEMON_FORM\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 3,\n            expirationTime = GetTime() + 3,\n            name = \"Demon Form\",\n            autoHide = true,\n            icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\illidandemon.jpg\",\n        }\n        return true\n    end\nend",
