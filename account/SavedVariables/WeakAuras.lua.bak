["actions"] = {
["start"] = {
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "local locale = GetLocale()\n\naura_env.locales = {\n    [\"enUS\"] = {\n        name = \"Mother Shahraz\",\n    },\n    [\"frFR\"] = {\n        name = \"Mère Shahraz\",\n    },\n    [\"deDE\"] = {\n        name = \"Mutter Shahraz\",\n    },\n    [\"esES\"] = {\n        name = \"Madre Shahraz\",\n    },\n    [\"koKR\"] = {\n        name = \"대모 샤라즈\",\n    },\n    [\"ruRU\"] = {\n        name = \"Матушка Шахраз\",\n    },\n    [\"zhCN\"] = {\n        name = \"莎赫拉丝主母\",\n    },\n    [\"zhTW\"] = {\n        name = \"薩拉茲女士\",\n    }\n}\n\naura_env.currentLocale = aura_env.locales[locale] or aura_env.locales[\"enUS\"]",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "aura_env.count = 1\naura_env.nuTimer(nil)\naura_env.preWarnCancel()",
["do_sound"] = false,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
["do_message"] = false,
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "",
["custom_type"] = "stateupdate",
["event"] = "Health",
