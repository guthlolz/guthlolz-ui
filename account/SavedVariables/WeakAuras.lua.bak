["events"] = "WA_ILLIDARI_JUDGEMENT_PREWARN WA_ILLIDARI_JUDGEMENT_PREWARN_CANCEL WA_ILLIDARI_JUDGEMENT_PREWARN_FALLBACK WA_NUMEN_TIMER WA_FJI_ENCOUNTER_END WA_FJI_ENCOUNTER_START",
["custom"] = "function(allstates,event,...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 3,\n            expirationTime = GetTime()+3,\n            icon = aura_env.icon,\n            name = aura_env.name,\n        }\n        return true\n    end\n    \n    if not _G.FJI_TANK and not _G.FJI_HEALER and not UnitIsGroupLeader(\"player\") then\n        return false\n    end\n    \n    if event == \"WA_\"..aura_env.e..\"_PREWARN\" then\n        local duration,count = ...\n        duration = duration or 0\n        \n        aura_env.scheduleFallback(duration+aura_env.fallbackTime)\n        \n        local displayDuration = duration > 0 and duration or 0.01\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = displayDuration,\n            expirationTime = GetTime()+displayDuration,\n            icon = aura_env.icon,\n            name = aura_env.name,\n        }\n        return true\n    elseif event == \"WA_NUMEN_TIMER\" then\n        local key,time = ...\n        \n        if key == aura_env.e and (time == 0 or time == nil) then\n            aura_env.cancelFallback()\n            \n            if allstates[\"\"] then\n                allstates[\"\"].show = false\n                allstates[\"\"].changed = true\n                return true\n            end\n        end\n        \n        return false\n    elseif event == \"WA_\"..aura_env.e..\"_PREWARN_CANCEL\" or event == \"WA_\"..aura_env.e..\"_PREWARN_FALLBACK\" or event == \"WA_FJI_ENCOUNTER_END\" or event == \"WA_FJI_ENCOUNTER_START\" then\n        aura_env.cancelFallback()\n        \n        if allstates[\"\"] then\n            allstates[\"\"].show = false\n            allstates[\"\"].changed = true\n            return true\n        end\n        \n        return false\n    end\n    \n    return false\nend",
["customIcon"] = "function()\n    return 135789\nend",
["check"] = "event",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["customVariables"] = "{\n    expirationTime = true\n}",
