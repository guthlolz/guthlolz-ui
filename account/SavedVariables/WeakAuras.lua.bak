["triggers"] = {
{
["trigger"] = {
["duration"] = "2",
["unit"] = "player",
["debuffType"] = "HELPFUL",
["type"] = "custom",
["custom_type"] = "stateupdate",
["names"] = {
},
["use_unit"] = true,
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["events"] = "UNIT_POWER_FREQUENT:player ENERGYTICK",
["custom"] = "function(allstates, event, isTriggered)\n    local currEnergy = UnitPower(\"player\", 3)\n    local maxEnergy = UnitPowerMax(\"player\", 3)\n    local dur = 2 -- Duração do tick (2s padrão do Classic)\n    \n    -- Verifica se a energia subiu (sincronização real) \n    -- OU se é um tick artificial (ENERGYTICK) e estamos com energia cheia\n    if (event == \"UNIT_POWER_FREQUENT\" and currEnergy > (aura_env.lastEnergy or 0))\n    or (event == \"ENERGYTICK\" and isTriggered and currEnergy == maxEnergy)\n    then\n        -- Atualiza ou Cria o estado da barra\n        if not allstates[\"\"] then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = dur,\n                expirationTime = GetTime() + dur,\n                progressType = \"timed\"\n            }\n        else\n            local s = allstates[\"\"]\n            s.changed = true\n            s.duration = dur\n            s.expirationTime = GetTime() + dur\n            s.show = true\n        end\n        \n        -- O PULO DO GATO:\n        -- Se a energia estiver cheia (ou acabou de encher), agendamos o próximo tick artificialmente.\n        -- Isso garante que a barra continue reiniciando mesmo no talo.\n        if currEnergy == maxEnergy then\n            C_Timer.After(dur, function() WeakAuras.ScanEvents(\"ENERGYTICK\", true) end)\n        end\n    end\n    \n    aura_env.lastEnergy = currEnergy\n    return true\nend",
["spellIds"] = {
},
