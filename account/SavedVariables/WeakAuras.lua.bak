["CT:[T5][Solarian] Arcane Missiles"] = {
["outline"] = "OUTLINE",
["wagoID"] = "gSs1_GQRl",
["color"] = {
1,
1,
1,
1,
},
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["shadowYOffset"] = -1,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiT5RaidPack/3",
["actions"] = {
["start"] = {
},
["finish"] = {
["custom"] = "aura_env.count = 1\naura_env.nuTimer(nil)\naura_env.preWarnCancel()",
["do_sound"] = false,
["do_message"] = false,
["do_custom"] = true,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.arcaneMissiles = 39414\n\nfunction aura_env.unitTargetScan(sourceGUID)\n    local unit = \"target\"\n    if UnitExists(unit) and UnitGUID(unit) == sourceGUID then \n        return unit \n    end\n    unit = \"focus\"\n    if UnitExists(unit) and UnitGUID(unit) == sourceGUID then \n        return unit \n    end\n    for i = 1,40 do\n        unit = \"nameplate\"..i\n        if UnitExists(unit) and UnitGUID(unit) == sourceGUID then \n            return unit \n        end\n    end\n    for grpUnit in WA_IterateGroupMembers() do\n        unit = grpUnit .. \"target\"\n        if UnitExists(unit) and UnitGUID(unit) == sourceGUID then\n            return unit\n        end\n    end\n    return nil\nend",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates,event,_,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId)\n    if spellId ~= aura_env.arcaneMissiles then\n        return false\n    end\n    \n    if subEvent == \"SPELL_CAST_SUCCESS\" then\n        C_Timer.After(0.05, function()\n                local unit = aura_env.unitTargetScan(sourceGUID)\n                \n                if unit and UnitExists(unit..\"target\") then\n                    local _,_,_,_,endTime = UnitChannelInfo(unit)\n                    WeakAuras.ScanEvents(\"WA_SOLARIAN_MISSILES_TARGET\", sourceGUID, UnitGUID(unit..\"target\"), unit..\"target\", endTime)\n                end\n        end)\n    end\nend",
["spellIds"] = {
},
["events"] = "CLEU:SPELL_CAST_SUCCESS",
["check"] = "event",
["unit"] = "player",
["custom_hide"] = "timed",
