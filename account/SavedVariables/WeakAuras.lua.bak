["events"] = "ENCOUNTER_START WA_SUPREMUS_TANK_PHASE WA_SUPREMUS_FIXATE_TARGET CLEU:UNIT_DIED",
["spellIds"] = {
},
["custom"] = "function(allstates,event,...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            autoHide = true,\n            duration = 1.6,\n            expirationTime = GetTime() + 1.6,\n            name = WeakAuras.myGUID\n        }\n        return true\n    end\n    \n    if event == \"ENCOUNTER_START\" then\n        aura_env.fixateTarget = nil\n        return false\n    end\n    \n    if event == \"WA_SUPREMUS_TANK_PHASE\" then\n        aura_env.fixateTarget = nil\n        return false\n    end\n    \n    if event == \"WA_SUPREMUS_FIXATE_TARGET\" then\n        local name = ...\n        aura_env.fixateTarget = name\n        return false\n    end\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local _,subEvent,_,_,_,_,_,destGUID,destName = ...\n        \n        if subEvent ~= \"UNIT_DIED\" then\n            return false\n        end\n        \n        if not aura_env.fixateTarget or destName ~= aura_env.fixateTarget then\n            return false\n        end\n        \n        if GetTime() - aura_env.throttle < 3 then\n            return false\n        end\n        aura_env.throttle = GetTime()\n        aura_env.fixateTarget = nil\n        \n        allstates[destGUID] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            autoHide = true,\n            duration = 2.1,\n            expirationTime = GetTime() + 2.1,\n            name = destGUID,\n        }\n        return true\n    end\nend",
