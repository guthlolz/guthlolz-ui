["CT:[T5][TK][Trash] Overcharge"] = {
["outline"] = "OUTLINE",
["wagoID"] = "gSs1_GQRl",
["color"] = {
1,
1,
1,
1,
},
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["shadowYOffset"] = -1,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiT5RaidPack/3",
["actions"] = {
["start"] = {
["do_glow"] = false,
["sound"] = "Interface\\Addons\\FojjiCore\\sound\\fojjiSnap.ogg",
["do_custom"] = false,
["do_sound"] = false,
},
["finish"] = {
["custom"] = "",
["do_sound"] = false,
["do_message"] = false,
["do_custom"] = false,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
},
["init"] = {
["custom"] = "aura_env.spellID = 37104\naura_env.npcId = \"20041\"\n\nfunction aura_env.unitTargetScan(sourceGUID)\n    local unit = \"target\"\n    if UnitExists(unit) and UnitGUID(unit) == sourceGUID then \n        return unit \n    end\n    unit = \"focus\"\n    if UnitExists(unit) and UnitGUID(unit) == sourceGUID then \n        return unit \n    end\n    for i = 1,40 do\n        unit = \"nameplate\"..i\n        if UnitExists(unit) and UnitGUID(unit) == sourceGUID then \n            return unit \n        end\n    end\n    for grpUnit in WA_IterateGroupMembers() do\n        unit = grpUnit .. \"target\"\n        if UnitExists(unit) and UnitGUID(unit) == sourceGUID then\n            return unit\n        end\n    end\n    return nil\nend",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, ...)\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local _,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId = ...\n        \n        if subEvent == \"UNIT_DIED\" then\n            local npcID = select(6, strsplit(\"-\", destGUID))\n            if npcID == aura_env.npcId then\n                WeakAuras.ScanEvents(\"WA_TRASH_SENTINEL_DIED\", destGUID)\n                return true\n            end\n        end\n        \n        if spellId ~= aura_env.spellID then\n            return false\n        end\n        \n        if subEvent == \"SPELL_CAST_START\" then\n            C_Timer.After(0.05, function()\n                    local unit = aura_env.unitTargetScan(sourceGUID)\n                    if unit and UnitExists(unit..\"target\") then\n                        WeakAuras.ScanEvents(\"WA_TRASH_OVERCHARGE_TARGET\", sourceGUID, UnitGUID(unit..\"target\"), unit..\"target\")\n                    else\n                        WeakAuras.ScanEvents(\"WA_TRASH_OVERCHARGE_TARGET\", sourceGUID, nil, nil)\n                    end\n            end)\n            return true\n        end\n    end\nend",
["spellIds"] = {
},
["events"] = "CLEU:SPELL_CAST_START:SPELL_CAST_SUCCESS:UNIT_DIED",
