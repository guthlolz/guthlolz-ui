["CT:[BT][Illidan] Human"] = {
["outline"] = "OUTLINE",
["wagoID"] = "pbbuhQ899",
["parent"] = "[BT][Illidan]",
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiBT-P1/12",
["actions"] = {
["start"] = {
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.debug = false\naura_env.key = \"ILLIDAN_HUMAN_FORM\"\naura_env.count = 1\naura_env.cdWindowYell = 65\naura_env.cdWindowAura = 60\naura_env.preWarnTime = 3\n\naura_env.encounterID = 609\n\naura_env.lastCast = nil\n\nfunction aura_env.debugPrint(message)\n    if aura_env.debug then\n        print(message)\n    end\nend\n\nfunction aura_env.nuTimer(countdown,count)\n    WeakAuras.ScanEvents(\"WA_NUMEN_TIMER\",aura_env.key,countdown,count)\nend\n\nfunction aura_env.updateState(allstates)\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n    }\nend\n\nfunction aura_env.preWarn(duration,preWarnTime,count)\n    preWarnTime = preWarnTime or 3\n    \n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\n    \n    aura_env.preWarnTimer = C_Timer.NewTimer(duration-preWarnTime,function()\n            WeakAuras.ScanEvents(\"WA_\"..aura_env.key..\"_PREWARN\",preWarnTime,count)\n            aura_env.preWarnTimer = nil\n    end)\nend\n\nfunction aura_env.preWarnCancel()\n    WeakAuras.ScanEvents(\"WA_\"..aura_env.key..\"_PREWARN_CANCEL\")\n    \n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "aura_env.count = 1\naura_env.nuTimer(nil)\naura_env.preWarnCancel()\naura_env.lastCast = nil",
["do_sound"] = false,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
["do_message"] = false,
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "ENCOUNTER_START, ENCOUNTER_END, WA_FJI_ENCOUNTER_END, WA_FJI_ENCOUNTER_START, WA_ILLIDAN_HUMAN_FORM, WA_ILLIDAN_DEMON_FORM_DETECT, WA_ILLIDAN_P2_START, WA_ILLIDAN_P3_START, WA_ILLIDAN_P3_END",
["spellIds"] = {
},
["custom"] = "function(allstates,event,...)\n    if event == \"WA_FJI_ENCOUNTER_START\" or event == \"ENCOUNTER_START\" then\n        local eID = ...\n        \n        if eID ~= aura_env.encounterID then\n            return false\n        end\n        \n        aura_env.lastCast = nil\n        aura_env.count = 1\n        \n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        aura_env.updateState(allstates)\n        return true\n    end\n    \n    if event == \"WA_ILLIDAN_DEMON_FORM_DETECT\" then\n        local source = ...\n        local cdWindow\n        \n        if source == \"YELL\" then\n            cdWindow = aura_env.cdWindowYell\n        elseif source == \"UNIT_AURA\" then\n            cdWindow = aura_env.cdWindowAura\n        else\n            return false\n        end\n        \n        aura_env.lastCast = GetTime()\n        \n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        \n        aura_env.preWarn(cdWindow,aura_env.preWarnTime,aura_env.count)\n        aura_env.nuTimer(cdWindow,aura_env.count)\n        return false\n    end\n    \n    if event == \"WA_ILLIDAN_HUMAN_FORM\" then\n        local now = GetTime()\n        \n        if aura_env.lastCast then\n            aura_env.debugPrint(string.format(\"Human Form (%d): %.1fs after Demon Form.\",aura_env.count,now-aura_env.lastCast))\n        end\n        \n        aura_env.preWarnCancel()\n        aura_env.nuTimer(0,aura_env.count)\n        aura_env.count = aura_env.count+1\n        return false\n    end\n    \n    if event == \"WA_ILLIDAN_P3_END\" then\n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        return false\n    end\n    \n    if event == \"WA_FJI_ENCOUNTER_END\" or event == \"ENCOUNTER_END\" then\n        aura_env.lastCast = nil\n        aura_env.count = 1\n        \n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        return false\n    end\n    \n    return false\nend",
["check"] = "event",
["subeventPrefix"] = "SPELL",
["custom_hide"] = "timed",
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
