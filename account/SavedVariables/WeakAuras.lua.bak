["CT:[BT][Shahraz] Fatal Attraction"] = {
["outline"] = "OUTLINE",
["wagoID"] = "pbbuhQ899",
["parent"] = "[BT][Shahraz]",
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiBT-P1/12",
["actions"] = {
["start"] = {
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.debug = false\naura_env.key = \"SHAHRAZ_ATTRACTION\"\naura_env.count = 1\naura_env.cdStart = 22.4\naura_env.cdWindow = 20.7\naura_env.preWarnTime = 3\n\naura_env.spellName = \"Fatal Attraction\"\naura_env.spellID = 41001\naura_env.spellIDAlt = 40869\naura_env.encounterID = 607\n\naura_env.pullStart = nil\naura_env.lastCast = nil\naura_env.throttle = 0\naura_env.fatalTargets = {}\naura_env.fatalTimer = nil\naura_env.fatalGUIDTimer = nil\n\nfunction aura_env.debugPrint(message)\n    if aura_env.debug then\n        print(message)\n    end\nend\n\nfunction aura_env.nuTimer(countdown,count)\n    WeakAuras.ScanEvents(\"WA_NUMEN_TIMER\",aura_env.key,countdown,count)\nend\n\nfunction aura_env.updateState(allstates)\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n    }\nend\n\nfunction aura_env.hideState(allstates)\n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\nend\n\nfunction aura_env.preWarn(duration,preWarnTime,count)\n    preWarnTime = preWarnTime or 3\n    \n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\n    \n    aura_env.preWarnTimer = C_Timer.NewTimer(duration - preWarnTime,function()\n            WeakAuras.ScanEvents(\"WA_\" .. aura_env.key .. \"_PREWARN\",preWarnTime,count)\n            aura_env.preWarnTimer = nil\n    end)\nend\n\nfunction aura_env.preWarnCancel()\n    WeakAuras.ScanEvents(\"WA_\" .. aura_env.key .. \"_PREWARN_CANCEL\")\n    \n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\nend\n\nfunction aura_env.cancelFatalTimer()\n    if aura_env.fatalTimer then\n        aura_env.fatalTimer:Cancel()\n        aura_env.fatalTimer = nil\n    end\n    \n    if aura_env.fatalGUIDTimer then\n        aura_env.fatalGUIDTimer:Cancel()\n        aura_env.fatalGUIDTimer = nil\n    end\n    \n    wipe(aura_env.fatalTargets)\nend\n\nfunction aura_env.collectFatalTarget(guid,name)\n    if not guid or not name then\n        return\n    end\n    \n    for _,target in ipairs(aura_env.fatalTargets) do\n        if target.guid == guid then\n            return\n        end\n    end\n    \n    aura_env.fatalTargets[#aura_env.fatalTargets + 1] = {\n        guid = guid,\n        name = name,\n    }\n    \n    if not aura_env.fatalGUIDTimer then\n        aura_env.fatalGUIDTimer = C_Timer.NewTimer(0.1,function()\n                aura_env.fatalGUIDTimer = nil\n                WeakAuras.ScanEvents(\"WA_MOTHER_SHAHRAZ_FATAL_GUIDS\",\n                    aura_env.fatalTargets[1] and aura_env.fatalTargets[1].guid,\n                    aura_env.fatalTargets[2] and aura_env.fatalTargets[2].guid,\n                    aura_env.fatalTargets[3] and aura_env.fatalTargets[3].guid)\n        end)\n    end\n    \n    if aura_env.fatalTimer then\n        return\n    end\n    \n    aura_env.fatalTimer = C_Timer.NewTimer(0.5,function()\n            aura_env.fatalTimer = nil\n            WeakAuras.ScanEvents(\"WA_MOTHER_SHAHRAZ_FATAL\",\n                aura_env.fatalTargets[1] and aura_env.fatalTargets[1].name,\n                aura_env.fatalTargets[2] and aura_env.fatalTargets[2].name,\n                aura_env.fatalTargets[3] and aura_env.fatalTargets[3].name)\n            wipe(aura_env.fatalTargets)\n    end)\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "aura_env.count = 1\naura_env.nuTimer(nil)\naura_env.preWarnCancel()\naura_env.pullStart = nil\naura_env.lastCast = nil",
["do_sound"] = false,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
["do_message"] = false,
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "ENCOUNTER_START, ENCOUNTER_END, WA_FJI_ENCOUNTER_END, WA_FJI_ENCOUNTER_START, CLEU:SPELL_AURA_APPLIED:SPELL_AURA_REMOVED, UNIT_SPELLCAST_SUCCEEDED",
["spellIds"] = {
},
["custom"] = "function(allstates,event,...)\n    if event == \"WA_FJI_ENCOUNTER_START\" or event == \"ENCOUNTER_START\" then\n        local eID = ...\n        if eID ~= aura_env.encounterID then\n            return false\n        end\n        \n        aura_env.pullStart = GetTime()\n        aura_env.lastCast = nil\n        aura_env.throttle = 0\n        aura_env.cancelFatalTimer()\n        \n        aura_env.updateState(allstates)\n        aura_env.count = 1\n        aura_env.preWarn(aura_env.cdStart,aura_env.preWarnTime,aura_env.count)\n        aura_env.nuTimer(aura_env.cdStart,aura_env.count)\n        return true\n    elseif event == \"WA_FJI_ENCOUNTER_END\" or event == \"ENCOUNTER_END\" then\n        aura_env.pullStart = nil\n        aura_env.lastCast = nil\n        \n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        aura_env.cancelFatalTimer()\n        return false\n    end\n    \n    if event == \"UNIT_SPELLCAST_SUCCEEDED\" then\n        local unit,_,spellId = ...\n        \n        if spellId ~= aura_env.spellIDAlt then\n            return false\n        end\n        \n        local now = GetTime()\n        if now - aura_env.throttle < 3 then\n            return false\n        end\n        aura_env.throttle = now\n        \n        aura_env.nuTimer(0,aura_env.count)\n        aura_env.count = aura_env.count + 1\n        aura_env.preWarn(aura_env.cdWindow,aura_env.preWarnTime,aura_env.count)\n        aura_env.nuTimer(aura_env.cdWindow,aura_env.count)\n        return true\n    end\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local _,subEvent,_,sourceGUID,_,_,_,destGUID,destName,_,_,spellId = ...\n        \n        if spellId ~= aura_env.spellID then\n            return false\n        end\n        \n        if subEvent == \"SPELL_AURA_REMOVED\" then\n            WeakAuras.ScanEvents(\"WA_MOTHER_SHAHRAZ_FATAL_REMOVED\",destGUID,destName)\n            return false\n        end\n        \n        if subEvent ~= \"SPELL_AURA_APPLIED\" then\n            return false\n        end\n        \n        WeakAuras.ScanEvents(\"WA_MOTHER_FATAL_APPLIED\",destGUID,destName)\n        aura_env.collectFatalTarget(destGUID,destName)\n        \n        local now = GetTime()\n        if aura_env.lastCast then\n            aura_env.debugPrint(string.format(\"Next %s (%d): %.1fs after previous.\",aura_env.spellName,aura_env.count,now - aura_env.lastCast))\n        elseif aura_env.pullStart then\n            aura_env.debugPrint(string.format(\"First %s (%d): %.1fs into pull.\",aura_env.spellName,aura_env.count,now - aura_env.pullStart))\n        end\n        aura_env.lastCast = now\n        \n        if now - aura_env.throttle < 3 then\n            return false\n        end\n        aura_env.throttle = now\n        \n        aura_env.nuTimer(0,aura_env.count)\n        aura_env.count = aura_env.count + 1\n        aura_env.preWarn(aura_env.cdWindow,aura_env.preWarnTime,aura_env.count)\n        aura_env.nuTimer(aura_env.cdWindow,aura_env.count)\n        return false\n    end\nend",
