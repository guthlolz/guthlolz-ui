["customDuration"] = "function()\n    if aura_env.swingStop ~= nil then\n        return aura_env.swingStop, aura_env.speed, true\n    else\n        return aura_env.speed, aura_env.elapsedTime\n    end\nend",
["subeventPrefix"] = "SPELL",
["spellIds"] = {
},
["custom"] = "function(event, speed, elapsedTime, hand)\n    if event == \"SWING_TIMER_PAUSED\" and speed == \"mainhand\" then\n        aura_env.swingStop = aura_env.elapsedTime\n        return true\n    elseif event ~= \"OPTIONS\" and hand == \"mainhand\" and speed ~= nil and elapsedTime ~= nil then\n        aura_env.speed = speed\n        aura_env.elapsedTime = elapsedTime\n        aura_env.swingStop = nil\n        return true\n    else\n        return false\n    end\nend",
