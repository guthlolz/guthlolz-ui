["init"] = {
["custom"] = "aura_env.throttle = 0",
["do_custom_unload"] = false,
["do_custom"] = true,
["do_custom_load"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["custom_type"] = "event",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(event,_,subEvent,_,sourceGUID,_,_,_,destGUID,destName,_,_,spellId)\n    if subEvent ~= \"SPELL_AURA_APPLIED\" then\n        return false\n    end\n    \n    local charge\n    \n    if spellId == 32054 then\n        charge = \"Vulnerable\"\n    elseif spellId == 32053 then\n        charge = \"Silence\"\n    elseif spellId == 32057 then\n        charge = \"Dot\"\n    else\n        return false\n    end\n    \n    local now = GetTime()\n    \n    if now - aura_env.throttle < 3 then\n        return false\n    end\n    \n    aura_env.throttle = now\n    WeakAuras.ScanEvents(\"WA_ARCHIMONDE_SOUL_CHARGE\", charge)\n    return false\nend",
["events"] = "CLEU:SPELL_AURA_APPLIED",
["spellIds"] = {
},
["names"] = {
},
["check"] = "event",
["subeventPrefix"] = "SPELL",
["debuffType"] = "HELPFUL",
