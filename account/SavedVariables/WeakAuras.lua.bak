0.70000001788139,
},
["customText"] = "\n\n",
["desaturateBackground"] = false,
["customTextUpdate"] = "event",
["desaturateForeground"] = false,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["custom_hide"] = "timed",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["unit"] = "player",
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            autoHide = true,\n            safe = false,\n            range = nil,\n        }\n        return true\n    end\n    \n    if event == \"NAME_PLATE_UNIT_ADDED\" then\n        local unit = ...\n        local guid = UnitGUID(unit)\n        local expiration = aura_env.expirationTime[guid]\n        local duration = aura_env.duration[guid]\n        \n        if expiration and duration and expiration > GetTime() then\n            allstates[unit] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = duration,\n                expirationTime = expiration,\n                autoHide = true,\n                unit = unit,\n                safe = false,\n                range = nil,\n            }\n            return true\n        end\n        \n        return false\n    end\n    \n    if event == \"NAME_PLATE_UNIT_REMOVED\" then\n        local unit = ...\n        if allstates[unit] then\n            allstates[unit].show = false\n            allstates[unit].changed = true\n            return true\n        end\n        return false\n    end\n    \n    if event == \"WA_MAULGAR_WW\" then\n        local guid = ...\n        local duration = 15\n        local expiration = GetTime() + duration\n        aura_env.duration[guid] = duration\n        aura_env.expirationTime[guid] = expiration\n        \n        for _, plate in pairs(C_NamePlate.GetNamePlates()) do\n            local unit = plate.UnitFrame and plate.UnitFrame.displayedUnit\n            if unit and UnitExists(unit) and UnitGUID(unit) == guid then\n                local range = WeakAuras.GetRange(unit)\n                local safe = (range ~= nil) and (range >= aura_env.safeRange) or false\n                \n                allstates[unit] = {\n                    show = true,\n                    changed = true,\n                    progressType = \"timed\",\n                    duration = duration,\n                    expirationTime = expiration,\n                    autoHide = true,\n                    unit = unit,\n                    safe = safe,\n                }\n                return true\n            end\n        end\n        return false\n    end\n    \n    if event == \"WA_MAULGAR_RANGE_CHECK\" then\n        local guid, safe, range = ...\n        for unit, state in pairs(allstates) do\n            if UnitExists(unit) and UnitGUID(unit) == guid then\n                if state.safe ~= safe then\n                    state.safe = safe\n                    state.changed = true\n                    return true\n                end\n                return false\n            end\n        end\n        return false\n    end\n    \n    if event == \"WA_FJI_MAULGAR_KILLED\" or event == \"WA_FJI_ENCOUNTER_END\" or event == \"ENCOUNTER_END\" then\n        wipe(aura_env.duration)\n        wipe(aura_env.expirationTime)\n        for _, state in pairs(allstates) do\n            state.show = false\n            state.changed = true\n        end\n        return true\n    end\nend",
["events"] = "NAME_PLATE_UNIT_ADDED NAME_PLATE_UNIT_REMOVED WA_MAULGAR_WW WA_FJI_MAULGAR_KILLED WA_FJI_ENCOUNTER_END ENCOUNTER_END WA_MAULGAR_RANGE_CHECK",
["customVariables"] = "{\n    safe = \"bool\",\n}",
