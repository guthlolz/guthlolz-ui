["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["custom_type"] = "stateupdate",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(allstates,event,value)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"static\",\n            icon = 135794,\n            explode = math.random(2) == 1,\n        }\n        return true\n    end\n    \n    if event == \"WA_KAZROGAL_MARK_EXPLODE\" then\n        if value == true and not aura_env.explode then\n            local willPlay,soundHandle = PlaySoundFile(\"Interface\\\\AddOns\\\\WeakAuras\\\\Media\\\\Sounds\\\\AirHorn.ogg\",\"Master\")\n            SendChatMessage(\"{rt8} IM GONNA BLOW\",\"SAY\")\n        elseif value == false and aura_env.explode then\n            SendChatMessage(\"SAFE\",\"SAY\")\n        end\n        \n        aura_env.explode = value == true\n    elseif event == \"WA_KAZROGAL_NEXT_MARK_DEADLY\" then\n        aura_env.nextMarkDeadly = value == true\n    else\n        return false\n    end\n    \n    if not aura_env.explode and not aura_env.nextMarkDeadly then\n        if allstates[\"\"] then\n            allstates[\"\"].show = false\n            allstates[\"\"].changed = true\n            return true\n        end\n        return false\n    end\n    \n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n        progressType = \"static\",\n        icon = 135794,\n        explode = aura_env.explode,\n    }\n    return true\nend",
["events"] = "WA_KAZROGAL_MARK_EXPLODE WA_KAZROGAL_NEXT_MARK_DEADLY",
["spellIds"] = {
},
["names"] = {
},
["check"] = "event",
