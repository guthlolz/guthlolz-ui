["Magtheridon: NE Location"] = {
["outline"] = "OUTLINE",
["displayText_format_mark_abbreviate"] = false,
["color"] = {
1,
1,
1,
0.75390619039536,
},
["displayText_format_p_time_dynamic_threshold"] = 60,
["yOffset"] = 30,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
["do_custom"] = false,
["do_message"] = false,
["custom"] = "",
},
["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.saved = aura_env.saved or {}\n\nfunction aura_env.updateState(allstates)\n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n    end\n    \n    local mark = aura_env.saved.mark\n    if not mark then\n        return false\n    end\n    \n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n        mark = mark,\n    }\n    return true\nend",
},
["finish"] = {
["custom"] = "",
["do_sound"] = false,
["do_message"] = false,
["do_custom"] = false,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["custom_hide"] = "timed",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["unit"] = "player",
["custom"] = "function(allstates, event, msg)\n    if event == \"OPTIONS\" then\n        local mark = 4\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            mark = mark\n        }\n        return true\n    end\n    \n    if event == \"WA_FJI_MAGTHERIDON_KILLED\" then\n        for _, state in pairs(allstates) do\n            state.show = false\n            state.changed = true\n        end\n        aura_env.saved.mark = nil\n        return true\n    end\n    \n    if event == \"STATUS\" then\n        return aura_env.updateState(allstates)\n    end\n    \n    if event ~= \"CHAT_MSG_RAID_LEADER\" or type(msg) ~= \"string\" then\n        return false\n    end\n    \n    if not msg:match(\"^%{rt%d%}\") then\n        return false\n    end\n    \n    local first, second, third, fourth, fifth = msg:match(\"^%{rt(%d)%}%{rt(%d)%}%{rt(%d)%}%{rt(%d)%}%{rt(%d)%}\")\n    local mark = tonumber(third)\n    if not mark or mark < 1 or mark > 8 then\n        return false\n    end\n    \n    aura_env.saved.mark = mark\n    return aura_env.updateState(allstates)\nend",
["events"] = "CHAT_MSG_RAID_LEADER STATUS WA_FJI_MAGTHERIDON_KILLED",
["customVariables"] = "{\n    mark = \"number\",\n}",
["check"] = "event",
["spellIds"] = {
},
