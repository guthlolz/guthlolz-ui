},
["regionType"] = "text",
["displayText_format_c19_format"] = "none",
["config"] = {
},
["displayText_format_c7_format"] = "none",
["anchorFrameType"] = "SCREEN",
["displayText_format_c1_decimal_precision"] = 1,
["displayText"] = "Crit: %c1\nDef: %c5 Res: %c19\n\nCrush: %c2\nShear: %c3 SWR: %c4\n\nAvoidance: %c6\nMiss: %c7\nDodge: %c8\nParry: %c9\n\nBlock: %c10\nBlock Value: %c11\nArmor: %c12\nDR: %c13\n\nHealth: %c14\nEHP: %c15\n\nSpell Power: %c16\nSH: %c17%% MH: %c18%%",
["displayText_format_p_time_precision"] = 1,
["displayText_format_p_format"] = "timed",
["displayText_format_c17_format"] = "none",
["semver"] = "1.0.2",
["justify"] = "LEFT",
["displayText_format_c10_format"] = "none",
["id"] = "Raw Stats",
["color"] = {
1,
0.90196078431373,
0.7921568627451,
1,
},
["frameStrata"] = 1,
["displayText_format_c3_format"] = "none",
["displayText_format_c1_format"] = "none",
["displayText_format_c15_format"] = "none",
["displayText_format_c11_format"] = "none",
["customText"] = "function()\n    local function round(n, d)\n        local m = 10^(d or 0)\n        return math.floor(n * m + 0.5) / m\n    end\n    \n    local isLib = GetInventoryItemID(\"player\", 18) == 29388\n    local hsBonus = isLib and 35.33 or 30\n    \n    local hsN = GetSpellInfo(20925) \n    local redN = GetSpellInfo(20127)\n    local rfN = GetSpellInfo(25780)\n    \n    local hasHS = AuraUtil.FindAuraByName(hsN, \"player\", \"HELPFUL\")\n    local hasRed = AuraUtil.FindAuraByName(redN, \"player\", \"HELPFUL\")\n    local hasRF = AuraUtil.FindAuraByName(rfN, \"player\", \"HELPFUL\")\n    \n    local dBonus = GetDodgeBlockParryChanceFromDefense() or 0\n    local miss = round(dBonus + 5, 2)\n    local dodge = round(GetDodgeChance() or 0, 2)\n    local parry = round(GetParryChance() or 0, 2)\n    local block = round(GetBlockChance() or 0, 2)\n    local liveCTC = round(miss + dodge + parry + block, 2)\n    \n    local gearCTC = liveCTC\n    if hasHS then gearCTC = gearCTC - hsBonus end\n    if hasRed then gearCTC = gearCTC - 30 end\n    \n    local refC = \"|cffff0000\"\n    if (gearCTC + 30) >= 102.4 then \n        refC = \"|cff00ff00\"\n    elseif isLib and (gearCTC + 35.33) >= 102.4 then \n        refC = \"|cff00ccff\"\n    end\n    \n    local valC = \"|cffff0000\"\n    if (gearCTC + hsBonus) >= 102.4 then\n        valC = hasHS and \"|cff00ff00\" or \"|cffffff00\"\n    end\n    \n    local crit = round(dBonus + (GetCombatRatingBonus(15) or 0), 2)\n    local cCol, cRef = \"|cffff0000\", \"|cffff00005.2|r/|cffff00005.4|r/|cffff00005.6|r\"\n    if crit >= 5.6 then cCol, cRef = \"|cff00ff00\", \"|cff00ccff5.2|r/|cff00ccff5.4|r/|cff00ff005.6|r\"\n    elseif crit >= 5.4 then cCol, cRef = \"|cffffff00\", \"|cff00ccff5.2|r/|cff00ff005.4|r/|cffff00005.6|r\"\n    elseif crit >= 5.2 then cCol, cRef = \"|cff00ccff\", \"|cff00ff005.2|r/|cffff00005.4|r/|cffff00005.6|r\" end\n    \n    local _, armor = UnitArmor(\"player\")\n    armor = armor or 0\n    local hp = UnitHealthMax(\"player\") or 0\n    local tLvl = UnitLevel(\"target\")\n    local pLvl = UnitLevel(\"player\")\n    \n    local _, _, _, _, rfR = GetTalentInfo(2, 11)\n    local rfMult = hasRF and (1 - (0.02 * (rfR or 0))) or 1\n    \n    local function getStats(lvl)\n        local c = 0\n        if lvl < 60 then\n            c = 400 + (85 * lvl)\n        else\n            c = (467.5 * lvl) - 22167.5\n        end\n        local dr = math.min(armor / (armor + c), 0.75)\n        local totalDR = 1 - ((1 - dr) * rfMult)\n        return totalDR * 100, hp / (1 - totalDR)\n    end\n    \n    local dr73, ehp73 = getStats(73)\n    local drD, ehpD = \"|cffFF4500\"..string.format(\"%.2f\", dr73)..\"|r\", \"|cffFF4500\"..string.format(\"%.0f\", ehp73)..\"|r\"\n    \n    if UnitExists(\"target\") and UnitCanAttack(\"player\", \"target\") and not UnitIsPlayer(\"target\") and tLvl and tLvl > 0 and tLvl < 73 then\n        local drT, ehpT = getStats(tLvl)\n        local dC = (tLvl > pLvl) and \"|cffff0000\" or \"|cff00ff00\"\n        if tLvl <= (pLvl - 9) then dC = \"|cff808080\" end\n        drD, ehpD = drD .. string.format(\" (%s%.2f|r)\", dC, drT), ehpD .. string.format(\" (%s%.0f|r)\", dC, ehpT)\n    end\n    \n    local baseDef, bonusDef = UnitDefense(\"player\")\n    local totalDef = (baseDef or 0) + (bonusDef or 0)\n\n    return \n        cCol..string.format(\"%.2f\", crit)..\"|r (\"..cRef..\")\",\n        valC..string.format(\"%.2f\", liveCTC)..\"|r (\"..refC..\"102.4%|r)\",\n        (dodge+parry+block >= 101.8 and \"|cff00ff00\" or \"|cffff0000\")..round(dodge+parry+block, 2)..\"|r\",\n        (miss-5+dodge-20+parry+block >= 102.4 and \"|cff00ff00\" or \"|cffff0000\")..round(miss-5+dodge-20+parry+block, 2)..\"|r\",\n        \"|cffffff00\"..totalDef..\"|r\",\n        \"|cffDA70D6\"..(round(miss+dodge+parry, 2))..\"%|r\",\n        \"|cff00ccff\"..miss..\"%|r\",\n        \"|cff00ccff\"..dodge..\"%|r\",\n        \"|cff00ccff\"..parry..\"%|r\",\n        \"|cff00E5EE\"..block..\"%|r\",\n        \"|cffffff00\"..(GetShieldBlock() or 0)..\"|r\",\n        (armor >= 35880 and \"|cff00ccff\" or \"|cffFF4500\")..armor..\"|r\",\n        drD,\n        \"|cffFF4500\"..hp..\"|r\",\n        ehpD,\n        \"|cffffff00\"..(GetSpellBonusDamage(2) or 0)..\"|r\",\n        \"|cffffff00\"..round((GetCombatRatingBonus(8) or 0)+(GetHitModifier() or 0), 2)..\"|r\",\n        \"|cffffff00\"..round((GetCombatRatingBonus(6) or 0)+(GetHitModifier() or 0), 2)..\"|r\",\n        \"|cffffff00\"..(GetCombatRating(15) or 0)..\"|r\"\nend",
["displayText_format_c6_format"] = "none",
