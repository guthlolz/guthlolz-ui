["CT:[T5][Vashj] Phase Controller"] = {
["outline"] = "OUTLINE",
["wagoID"] = "gSs1_GQRl",
["color"] = {
1,
1,
1,
1,
},
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["shadowYOffset"] = -1,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiT5RaidPack/3",
["actions"] = {
["start"] = {
},
["finish"] = {
["custom"] = "",
["do_sound"] = false,
["do_message"] = false,
["do_custom"] = false,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "local locale = GetLocale()\n\naura_env.locales = {\n    [\"enUS\"] = {\n        p2 = \"The time is now! Leave none standing!\",\n        p3 = \"You may want to take cover.\",\n    },\n    [\"frFR\"] = {\n        p2 = \"L'heure est venue ! N'épargnez personne !\",\n        p3 = \"Il faudrait peut-être vous mettre à l'abri.\",\n    },\n    [\"deDE\"] = {\n        p2 = \"Die Zeit ist gekommen! Lasst keinen am Leben!\",\n        p3 = \"Geht besser in Deckung!\",\n    },\n    [\"esES\"] = {\n        p2 = \"¡Ha llegado el momento! ¡Que no quede ni uno en pie!\",\n        p3 = \"Os vendrá bien cubriros.\",\n    },\n    [\"koKR\"] = {\n        p2 = \"때가 왔다! 한 놈도 살려두지 마라!\",\n        p3 = \"숨을 곳이나 마련해 둬라!\",\n    },\n    [\"ruRU\"] = {\n        p2 = \"Время пришло! Не щадите никого!\",\n        p3 = \"Вам не пора прятаться?\",\n    },\n    [\"zhCN\"] = {\n        p2 = \"机会来了！一个活口都不要留下！\",\n        p3 = \"你们最好找掩护。\",\n    },\n    [\"zhTW\"] = {\n        p2 = \"機會來了!一個活口都不要留下!\",\n        p3 = \"你們最好找掩護。\",\n    }\n}\n\naura_env.currentLocale = aura_env.locales[locale] or aura_env.locales[\"enUS\"]",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, ...)\n    if event == \"CHAT_MSG_MONSTER_YELL\" then\n        local msg = ...\n        \n        if msg == aura_env.currentLocale.p2 or msg:find(aura_env.currentLocale.p2, 1, true) then\n            WeakAuras.ScanEvents(\"WA_VASHJ_P2_START\")\n            return true\n            \n        elseif msg == aura_env.currentLocale.p3 or msg:find(aura_env.currentLocale.p3, 1, true) then\n            WeakAuras.ScanEvents(\"WA_VASHJ_P3_START\")\n            return true\n        end\n    end\nend",
["spellIds"] = {
},
["events"] = "CHAT_MSG_MONSTER_YELL",
["check"] = "event",
["unit"] = "player",
["custom_hide"] = "timed",
