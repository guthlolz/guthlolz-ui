},
["adjustedMin"] = "",
["displayText"] = "%guid,",
["displayText_format_c2_format"] = "none",
["wagoID"] = "N57hx-mDf",
["displayText_format_p_time_precision"] = 1,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_hide"] = "timed",
["custom_type"] = "stateupdate",
["subeventPrefix"] = "SPELL",
["duration"] = "20",
["event"] = "Health",
["unit"] = "player",
["subeventSuffix"] = "_CAST_START",
["custom"] = "function(allstates,event,_,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId)\n    if event == \"OPTIONS\" then\n        local expirationTime = GetTime() + 2.5\n        \n        allstates[\"HEADER\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 2.5,\n            expirationTime = expirationTime,\n            autoHide = true,\n            icon = 135769,\n            isHeader = true,\n            index = 1,\n        }\n        \n        for i = 1,3 do\n            allstates[i] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = 2.5,\n                expirationTime = expirationTime,\n                autoHide = true,\n                guid = WeakAuras.myGUID,\n                icon = 135769,\n                isPlayer = i == 1,\n                isHeader = false,\n                index = i + 1,\n                last = i == 3,\n            }\n        end\n        return true\n    end\n    \n    if spellId ~= 41404 then\n        return false\n    end\n    \n    if allstates[destGUID] then\n        return false\n    end\n    \n    local expirationTime = GetTime() + 2.5\n    local index = 2\n    \n    allstates[\"HEADER\"] = {\n        show = true,\n        changed = true,\n        progressType = \"timed\",\n        duration = 2.5,\n        expirationTime = expirationTime,\n        autoHide = true,\n        icon = 135769,\n        isHeader = true,\n        index = 1,\n    }\n    \n    for key,state in pairs(allstates) do\n        if key ~= \"HEADER\" then\n            state.changed = true\n            state.expirationTime = expirationTime\n            state.last = false\n            \n            if state.index and state.index >= index then\n                index = state.index + 1\n            end\n        end\n    end\n    \n    allstates[destGUID] = {\n        show = true,\n        changed = true,\n        progressType = \"timed\",\n        duration = 2.5,\n        expirationTime = expirationTime,\n        autoHide = true,\n        guid = destGUID,\n        icon = 135769,\n        isPlayer = destGUID == WeakAuras.myGUID,\n        isHeader = false,\n        index = index,\n        last = true,\n    }\n    \n    return true\nend",
