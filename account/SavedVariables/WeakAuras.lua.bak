["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates,event,eID,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId)\n    if event == \"WA_VASHJ_P2_START\" then\n        aura_env.shields = 4\n        return true\n    end\n    \n    if spellId ~= aura_env.magicBarrier then\n        return false\n    end\n    \n    if subEvent == \"SPELL_AURA_REMOVED\" then\n        aura_env.shields = aura_env.shields - 1\n        WeakAuras.ScanEvents(\"WA_VASHJ_SHIELDS_UPDATE\", aura_env.shields)\n        return true\n    end\nend",
