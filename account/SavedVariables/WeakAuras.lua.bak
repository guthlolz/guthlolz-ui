["actions"] = {
["start"] = {
["custom"] = "if not aura_env.button then\n    aura_env.button = CreateFrame(\"Button\", \"WA_\" .. aura_env.id .. \"_ButtonFrame\")\n    aura_env.button:SetAllPoints(aura_env.region)\n    aura_env.button:RegisterForClicks(\"LeftButtonUp\", \"RightButtonUp\")\n    aura_env.button:SetScript(\"OnClick\", function(self, button)\n            WeakAuras.ScanEvents(\"WA_TRINKET_TRACKER_CLICK_SLOT_2\", button)\n    end)\nend",
["do_custom"] = true,
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.slot = INVSLOT_TRINKET2\n\naura_env.trinketData = {\n    -- Proc Trinkets\n    --{itemId = 81266, procId = 126467, subEvent = \"SPELL_ENERGIZE\", ICD = 55, excludeICD = false, excludeSwapping = false}, -- Price of Progress\n    -- Buff-Based Trinkets\n    \n    -- Test\n    --{itemId = 185987, buffId = 20217, excludeICD = false, excludeSwapping = false, ICD = 45}, -- Aegis of Preservation\n    \n    -- Vanilla\n    {itemId = 19345, buffId = 23780, excludeICD = true, excludeSwapping = false, ICD = 0, CD = 300}, -- Aegis of Preservation\n    {itemId = 19336, buffId = 23721, excludeICD = true, excludeSwapping = false, ICD = 0, CD = 120}, -- Arcane Infused Gem\n    {itemId = 19024, buffId = 23506, excludeICD = true, excludeSwapping = false, ICD = 0, CD = 900}, -- Arena Grand Master\n    {itemId = 21670, buffId = 26480, stackId = 26481, excludeICD = true, excludeSwapping = false, ICD = 0, CD = 180}, -- Badge of the Swarmguard\n    {itemId = 2802, buffId = 13744, excludeICD = true, excludeSwapping = false, ICD = 0, CD = 600}, -- Blazing Emblem\n    {itemId = 19990, buffId = 24354, excludeICD = true, excludeSwapping = false, ICD = 0, CD = 120}, -- Blessed Prayer Beads\n    {itemId = 11832, buffId = 15646, excludeICD = true, excludeSwapping = false, ICD = 0, CD = 900}, -- Burst of Knowledge\n    {itemId = 10455, buffId = 12766, excludeICD = true, excludeSwapping = false, ICD = 0, CD = 900}, -- Chained Essence of Eranikus\n    {itemId = 5079, buffId = 1139, excludeICD = true, excludeSwapping = false, ICD = 0, CD = 300}, -- Cold Basilisk Eye\n    {itemId = 20072, buffId = 23991, excludeICD = true, excludeSwapping = false, ICD = 0, CD = 180}, -- Defiler's Talisman\n    {itemId = 21115, buffId = 25746, excludeICD = true, excludeSwapping = false, ICD = 0, CD = 180}, -- Defiler's Talisman\n    {itemId = 21116, buffId = 25747, excludeICD = true, excludeSwapping = false, ICD = 0, CD = 180}, -- Defiler's Talisman\n    {itemId = 19991, buffId = 24352, excludeIC