["init"] = {
["custom"] = "aura_env.bossData = {\n    winterchill = {\n        name = \"Rage Winterchill\",\n        icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\ragewinterchill.jpg\",\n    },\n    anetheron = {\n        name = \"Anetheron\",\n        icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\anetheron.jpg\",\n    },\n    kazrogal = {\n        name = \"Kaz'rogal\",\n        icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\kazrogal.jpg\",\n    },\n    azgalor = {\n        name = \"Azgalor\",\n        icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\azgalor.jpg\",\n    },\n}\n\nfunction aura_env.updateState(allstates, boss)\n    local data = aura_env.bossData[boss]\n    if not data then\n        return false\n    end\n    \n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n        icon = data.icon,\n        name = data.name,\n    }\n    \n    return true\nend\n\nfunction aura_env.hideState(allstates)\n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\nend",
["do_custom"] = true,
},
