["CT:[BT][Najentus] Tidal Shield"] = {
["outline"] = "OUTLINE",
["wagoID"] = "pbbuhQ899",
["parent"] = "[BT][Najentus]",
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["yOffset"] = 0,
