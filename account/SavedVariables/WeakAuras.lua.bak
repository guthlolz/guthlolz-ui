["wagoID"] = "pbbuhQ899",
["parent"] = "[BT]: Nameplates",
["displayText_format_target_abbreviate"] = false,
["adjustedMin"] = "",
["shadowYOffset"] = -1,
["automaticWidth"] = "Auto",
["desaturateBackground"] = false,
["cooldownSwipe"] = true,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "ENCOUNTER_START NAME_PLATE_UNIT_ADDED NAME_PLATE_UNIT_REMOVED WA_ILLIDAN_SHADOW_DEMON_APPLIED WA_ILLIDAN_SHADOW_DEMON_REMOVED",
["spellIds"] = {
},
["custom"] = "function(allstates,event,...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            unit = \"nameplate1\",\n            targetGUID = WeakAuras.myGUID,\n        }\n        return true\n    end\n    \n    if event == \"ENCOUNTER_START\" then\n        wipe(aura_env.targets)\n        wipe(aura_env.unitGUID)\n        return false\n    end\n    \n    if event == \"ENCOUNTER_END\" then\n        wipe(aura_env.targets)\n        wipe(aura_env.unitGUID)\n        \n        for _,state in pairs(allstates) do\n            state.show = false\n            state.changed = true\n            state.unit = nil\n        end\n        return true\n    end\n    \n    if event == \"WA_ILLIDAN_SHADOW_DEMON_APPLIED\" then\n        local sourceGUID,targetGUID = ...\n        \n        if not sourceGUID or not targetGUID then\n            return false\n        end\n        \n        aura_env.targets[sourceGUID] = targetGUID\n        local state = allstates[sourceGUID]\n        \n        if state and state.unit and UnitExists(state.unit) and UnitGUID(state.unit) == sourceGUID then\n            if state.targetGUID ~= targetGUID or not state.show then\n                state.show = true\n                state.changed = true\n                state.targetGUID = targetGUID\n                return true\n            end\n            \n            return false\n        end\n        \n        for _,plateData in pairs(C_NamePlate.GetNamePlates()) do\n            local unit = plateData.UnitFrame.displayedUnit\n            local guid = UnitGUID(unit)\n            \n            if guid == sourceGUID then\n                aura_env.unitGUID[unit] = guid\n                \n                allstates[sourceGUID] = {\n                    show = true,\n                    changed = true,\n                    unit = unit,\n                    targetGUID = targetGUID,\n                }\n                return true\n            end\n        end\n        \n        return false\n    end\n    \n    if event == \"WA_ILLIDAN_SHADOW_DEMON_REMOVED\" then\n        local sourceGUID,targetGUID = ...\n        \n        if not sourceGUID or not targetGUID then\n            return false\n        end\n        \n        if aura_env.targets[sourceGUID] ~= targetGUID then\n            return false\n        end\n        \n        aura_env.targets[sourceGUID] = nil\n        local state = allstates[sourceGUID]\n        if not state or state.targetGUID ~= targetGUID then\n            return false\n        end\n        \n        state.show = false\n        state.changed = true\n        state.targetGUID = nil\n        return true\n    end\n    \n    if event == \"NAME_PLATE_UNIT_ADDED\" then\n        local unit = ...\n        local guid = UnitGUID(unit)\n        local npcID = select(6,strsplit(\"-\",guid or \"\"))\n        \n        if npcID ~= \"23375\" then\n            return false\n        end\n        \n        aura_env.unitGUID[unit] = guid\n        local targetGUID = aura_env.targets[guid]\n        if not targetGUID then\n            return false\n        end\n        \n        allstates[guid] = {\n            show = true,\n            changed = true,\n            unit = unit,\n            targetGUID = targetGUID,\n        }\n        return true\n    end\n    \n    if event == \"NAME_PLATE_UNIT_REMOVED\" then\n        local unit = ...\n        local guid = aura_env.unitGUID[unit]\n        if not guid then\n            return false\n        end\n        \n        aura_env.unitGUID[unit] = nil\n        local state = allstates[guid]\n        if not state or state.unit ~= unit then\n            return false\n        end\n        \n        state.show = false\n        state.changed = true\n        state.unit = nil\n        return true\n    end\nend",
["check"] = "event",
["subeventPrefix"] = "SPELL",
["custom_hide"] = "timed",
["debuffType"] = "HELPFUL",
},
