["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.spellKeys = {\n    [\"WINTERCHILL_ICEBOLT\"] = {icon = 135846, npcID = \"17767\"},\n    [\"WINTERCHILL_FROSTNOVA\"] = {icon = 135848, npcID = \"17767\"},\n    [\"WINTERCHILL_DEATH\"] = {icon = 136144, npcID = \"17767\"},\n    [\"WINTERCHILL_FROSTARMOR\"] = {icon = 135843, npcID = \"17767\"},\n    \n    [\"ANETHERON_CARRIONSWARM\"] = {icon = 136128, npcID = \"17808\"},\n    [\"ANETHERON_SLEEP\"] = {icon = 136090, npcID = \"17808\"},\n    [\"ANETHERON_INFERNO\"] = {icon = 136219, npcID = \"17808\"},\n    \n    [\"KAZROGAL_CRIPPLE\"] = {icon = 136135, npcID = \"17888\"},\n    [\"KAZROGAL_CLEAVE\"] = {icon = 132338, npcID = \"17888\"},\n    [\"KAZROGAL_MARK\"] = {icon = 136214, npcID = \"17888\"},\n    [\"KAZROGAL_WARSTOMP\"] = {icon = 132368, npcID = \"17888\"},\n    \n    [\"AZGALOR_CLEAVE\"] = {icon = 132338, npcID = \"17842\"},\n    [\"AZGALOR_DOOM\"] = {icon = 132094, npcID = \"17842\"},\n    [\"AZGALOR_HOWL\"] = {icon = 136164, npcID = \"17842\"},\n    [\"AZGALOR_RAIN\"] = {icon = 136186, npcID = \"17842\"},\n    \n    [\"ARCHIMONDE_BURST\"] = {icon = 136116, npcID = \"17968\"},\n    [\"ARCHIMONDE_FEAR\"] = {icon = 136147, npcID = \"17968\"},\n    [\"ARCHIMONDE_GRIP\"] = {icon = 132937, npcID = \"17968\"},\n    [\"ARCHIMONDE_DOOMFIRE\"] = {icon = 135826, npcID = \"17968\"},\n    \n    [\"NAJENTUS_SPINE\"] = {icon = 135855, npcID = \"22887\"},\n    [\"NAJENTUS_SHIELD\"] = {icon = 136017, npcID = \"22887\"},\n    \n    [\"SUPREMUS_KITE\"] = {icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\supremus.jpg\", npcID = \"22898\"},\n    [\"SUPREMUS_TANK\"] = {icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\supremus.jpg\", npcID = \"22898\"},\n    [\"SUPREMUS_FIXATE\"] = {icon = 136129, npcID = \"22898\"},\n    [\"SUPREMUS_HATEFUL\"] = {icon = 132282, npcID = \"22898\"},\n    [\"SUPREMUS_VOLCANO\"] = {icon = 135793, npcID = \"22898\"},\n    [\"SUPREMUS_MOLTEN_PUNCH\"] = {icon = 135802, npcID = \"22898\"},\n    \n    [\"TERON_CRUSHING_SHADOWS\"] = {icon = 136224, npcID = \"22871\"},\n    [\"TERON_DEATH\"] = {icon = 135752, npcID = \"22871\"},\n    \n    [\"GURTOGG_STRIKE\"] = {icon = 132096, npcID = \"22948\"},\n    [\"GURTOGG_SMASH\"] = {icon = 132338, npcID = \"22948\"},\n    [\"GURTOGG_BLOODBOIL\"] = {icon = 136124, npcID = \"22948\"},\n    [\"GURTOGG_BREATH\"] = {icon = 136007, npcID = \"22948\"},\n    [\"GURTOGG_RAGE_PHASE\"] = {icon = 135791, npcID = \"22948\"},\n    [\"GURTOGG_BLOOD_PHASE\"] = {icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\gurtogg.jpg\", npcID = \"22948\"},\n    \n    [\"RELIQUARY_SOUL_DRAIN\"] = {icon = 136222, npcID = \"23418\"},\n    [\"RELIQUARY_ENRAGE\"] = {icon = 136224, npcID = \"23418\"},\n    [\"RELIQUARY_FIXATE\"] = {icon = 136215, npcID = \"23418\"},\n    [\"RELIQUARY_RUNE_SHIELD\"] = {icon = 135735, npcID = \"23419\"},\n    [\"RELIQUARY_DEADEN\"] = {icon = 136212, npcID = \"23419\"},\n    [\"RELIQUARY_SPIRIT_SHOCK\"] = {icon = 135739, npcID = \"23419\"},\n    [\"RELIQUARY_SOUL_SCREAM\"] = {icon = 136131, npcID = \"23420\"},\n    [\"RELIQUARY_SPITE\"] = {icon = 136150, npcID = \"23420\"},\n    \n    [\"SHAHRAZ_SHRIEK\"] = {icon = 136164, npcID = \"22947\"},\n    [\"SHAHRAZ_PRISMATIC_AURA\"] = {icon = 134131, npcID = \"22947\"},\n    [\"SHAHRAZ_SABER_LASH\"] = {icon = 132373, npcID = \"22947\"},\n    [\"SHAHRAZ_ATTRACTION\"] = {icon = 136202, npcID = \"22947\"},\n    \n    [\"ILLIDARI_CONSECRATION\"] = {icon = 135926, npcID = \"22949\"},\n    [\"ILLIDARI_JUDGEMENT\"] = {icon = 135959, npcID = \"22949\"},\n    [\"ILLIDARI_BOP\"] = {icon = 135964, npcID = \"22949\"},\n    [\"ILLIDARI_SPELL_WARDING\"] = {icon = 135965, npcID = \"22949\"},\n    [\"ILLIDARI_DAMPEN_MAGIC\"] = {icon = 136006, npcID = \"22950\"},\n    [\"ILLIDARI_FLAMESTRIKE\"] = {icon = 135826, npcID = \"22950\"},\n    [\"ILLIDARI_BLIZZARD\"] = {icon = 135857, npcID = \"22950\"},\n    [\"ILLIDARI_DIVINE_WRATH\"] = {icon = 135972, npcID = \"22951\"},\n    [\"ILLIDARI_REFLECTIVE_SHIELD\"] = {icon = 135940, npcID = \"22951\"},\n    [\"ILLIDARI_CIRCLE\"] = {icon = 135943, npcID = \"22951\"},\n    [\"ILLIDARI_VANISH\"] = {icon = 132320, npcID = \"22952\"},\n    \n    [\"ILLIDAN_DARK_BARRAGE\"] = {icon = 136181, npcID = \"22917\"},\n    [\"ILLIDAN_DRAW_SOUL\"] = {icon = 136131, npcID = \"22917\"},\n    [\"ILLIDAN_FLAME_CRASH\"] = {icon = 135784, npcID = \"22917\"},\n    [\"ILLIDAN_PARASITE\"] = {icon = 136214, npcID = \"22917\"},\n    [\"ILLIDAN_SHEAR\"] = {icon = 136158, npcID = \"22917\"},\n    [\"ILLIDAN_EYE_BEAM\"] = {icon = 133884, npcID = \"22917\"},\n    [\"ILLIDAN_SHADOW_DEMONS\"] = {icon = 136214, npcID = \"22917\"},\n    [\"ILLIDAN_FLAME_BURST\"] = {icon = 135787, npcID = \"22917\"},\n    [\"ILLIDAN_DEMON_FORM\"] = {icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\illidandemon.jpg\", npcID = \"22917\"},\n    [\"ILLIDAN_HUMAN_FORM\"] = {icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\illidan.jpg\", npcID = \"22917\"},\n    [\"ILLIDAN_P4_START\"] = {icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\illidan.jpg\", npcID = \"22917\"},\n    [\"ILLIDAN_BLAZE\"] = {icon = 135794, npcID = \"22997\"},\n    [\"ILLIDAN_FLAME_BLAST\"] = {icon = 135798, npcID = \"22997\"},\n    [\"ILLIDAN_AGONIZING_FLAMES\"] = {icon = 135785, npcID = \"22917\"},\n    [\"ILLIDAN_ENRAGE\"] = {icon = 136224, npcID = \"22917\"},\n}\n\naura_env.guids = {}\naura_env.pending = {}\naura_env.nameplateGUIDs = {}\n\nfunction aura_env.getNPCID(guid)\n    return guid and select(6,strsplit(\"-\",guid))\nend\n\nfunction aura_env.refreshNameplates()\n    wipe(aura_env.nameplateGUIDs)\n    \n    for _,plateData in pairs(C_NamePlate.GetNamePlates()) do\n        local unit = plateData.UnitFrame.displayedUnit\n        if unit then\n            local guid = UnitGUID(unit)\n            if guid then\n                aura_env.nameplateGUIDs[unit] = guid\n            end\n        end\n    end\nend\n\nfunction aura_env.getNameplateUnit(guid)\n    for unit,plateGUID in pairs(aura_env.nameplateGUIDs) do\n        if plateGUID == guid then\n            return unit\n        end\n    end\n    \n    aura_env.refreshNameplates()\n    \n    for unit,plateGUID in pairs(aura_env.nameplateGUIDs) do\n        if plateGUID == guid then\n            return unit\n        end\n    end\nend\n\nfunction aura_env.hideState(allstates,guid,key)\n    local state = allstates[guid..\"_\"..key]\n    \n    if state and state.show then\n        state.show = false\n        state.changed = true\n        return true\n    end\n    return false\nend\n\nfunction aura_env.cancelState(allstates,guid,key)\n    if aura_env.guids[guid] then\n        aura_env.guids[guid][key] = nil\n        \n        if not next(aura_env.guids[guid]) then\n            aura_env.guids[guid] = nil\n        end\n    end\n    \n    return aura_env.hideState(allstates,guid,key)\nend\n\nfunction aura_env.cancelNPCState(allstates,key)\n    local info = aura_env.spellKeys[key]\n    if not info then\n        return false\n    end\n    \n    if aura_env.pending[info.npcID] then\n        aura_env.pending[info.npcID][key] = nil\n        \n        if not next(aura_env.pending[info.npcID]) then\n            aura_env.pending[info.npcID] = nil\n        end\n    end\n    \n    for guid,data in pairs(aura_env.guids) do\n        if aura_env.getNPCID(guid) == info.npcID and data[key] then\n            data[key] = nil\n            \n            local state = allstates[guid..\"_\"..key]\n            if state then\n                state.show = false\n                state.changed = true\n            end\n            \n            if not next(data) then\n                aura_env.guids[guid] = nil\n            end\n        end\n    end\n    \n    return true\nend\n\nfunction aura_env.showState(allstates,guid,key,spellData,unit)\n    allstates[guid..\"_\"..key] = {\n        show = true,\n        changed = true,\n        progressType = \"timed\",\n        duration = spellData.duration,\n        expirationTime = spellData.expirationTime,\n        unit = unit,\n        autoHide = false,\n        icon = spellData.icon,\n        count = spellData.count,\n    }\n    \n    return true\nend\n\nfunction aura_env.updateState(allstates,key,time,count,guid)\n    local info = aura_env.spellKeys[key]\n    if not info then\n        return false\n    end\n    \n    local spellData = {\n        duration = time,\n        expirationTime = GetTime()+time,\n        icon = info.icon,\n        count = count,\n    }\n    \n    if guid then\n        local npcID = aura_env.getNPCID(guid)\n        \n        if npcID ~= info.npcID then\n            return false\n        end\n        \n        aura_env.guids[guid] = aura_env.guids[guid] or {}\n        aura_env.guids[guid][key] = spellData\n        \n        local unit = aura_env.getNameplateUnit(guid)\n        if unit then\n            return aura_env.showState(allstates,guid,key,spellData,unit)\n        end\n        return false\n    end\n    \n    aura_env.refreshNameplates()\n    \n    for unit,plateGUID in pairs(aura_env.nameplateGUIDs) do\n        local npcID = aura_env.getNPCID(plateGUID)\n        \n        if npcID == info.npcID then\n            aura_env.guids[plateGUID] = aura_env.guids[plateGUID] or {}\n            aura_env.guids[plateGUID][key] = spellData\n            return aura_env.showState(allstates,plateGUID,key,spellData,unit)\n        end\n    end\n    \n    aura_env.pending[info.npcID] = aura_env.pending[info.npcID] or {}\n    aura_env.pending[info.npcID][key] = spellData\n    return false\nend\n\nfunction aura_env.reset(allstates)\n    wipe(aura_env.guids)\n    wipe(aura_env.pending)\n    wipe(aura_env.nameplateGUIDs)\n    \n    for _,state in pairs(allstates) do\n        state.show = false\n        state.changed = true\n    end\n    \n    return true\nend",
["do_custom"] = true,
},
