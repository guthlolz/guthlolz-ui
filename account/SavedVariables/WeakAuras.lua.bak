["height"] = 20,
["textureSource"] = "LSM",
["backgroundTexture"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Auras\\Aura3",
["displayText_format_s_format"] = "none",
["useAdjustededMax"] = false,
["fontSize"] = 21,
["source"] = "import",
["displayText_format_n_format"] = "none",
["user_y"] = 0,
["xOffset"] = 0,
["mirror"] = false,
["customTextUpdate"] = "event",
["displayText_format_1.npcid_format"] = "none",
["config"] = {
},
["zoom"] = 0.32,
["icon_side"] = "LEFT",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
},
["finish"] = {
},
["init"] = {
["custom"] = "aura_env.mobData = {\n    [\"Ghouls\"] = {\n        singular = \"Ghoul\",\n        plural = \"Ghouls\",\n        icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\Ghoul.png\",\n        npcIDs = {[\"17895\"] = true},\n    },\n    [\"Crypt Fiends\"] = {\n        singular = \"Fiend\",\n        plural = \"Fiends\",\n        icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\CryptFiend.png\",\n        npcIDs = {[\"17897\"] = true},\n    },\n    [\"Necromancers\"] = {\n        singular = \"Necro\",\n        plural = \"Necros\",\n        icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\Necromancer.png\",\n        npcIDs = {[\"17899\"] = true},\n    },\n    [\"Abominations\"] = {\n        singular = \"Abom\",\n        plural = \"Aboms\",\n        icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\Abomination.png\",\n        npcIDs = {[\"17898\"] = true},\n    },\n    [\"Banshees\"] = {\n        singular = \"Banshee\",\n        plural = \"Banshees\",\n        icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\Banshee.png\",\n        npcIDs = {[\"17905\"] = true},\n    },\n    [\"Gargoyles\"] = {\n        singular = \"Garg\",\n        plural = \"Gargs\",\n        icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\Gargoyle.png\",\n        npcIDs = {[\"17906\"] = true},\n    },\n    [\"Frost Wyrm\"] = {\n        singular = \"Wyrm\",\n        plural = \"Wyrms\",\n        icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\FrostWyrm.png\",\n        npcIDs = {[\"17907\"] = true},\n    },\n    [\"Fel Stalkers\"] = {\n        singular = \"Stalker\",\n        plural = \"Stalkers\",\n        icon = 136217,\n        npcIDs = {[\"17916\"] = true},\n    },\n    [\"Infernals\"] = {\n        singular = \"Infernal\",\n        plural = \"Infernals\",\n        icon = 136219,\n        npcIDs = {[\"17908\"] = true},\n    },\n}\n\naura_env.npcLookup = {}\n\nfor stateKey, data in pairs(aura_env.mobData) do\n    for npcID in pairs(data.npcIDs) do\n        aura_env.npcLookup[npcID] = stateKey\n    end\nend\n\naura_env.saved = aura_env.saved or {}\n\naura_env.deadGUIDs = {}\naura_env.pendingDeaths = {}\naura_env.deathThrottle = 0\naura_env.deathThrottleTimer = nil\naura_env.bossWave = nil\naura_env.waveCount = nil\n\nfunction aura_env.updateState(allstates, composition, counts)\n    for _, state in pairs(allstates) do\n        state.show = false\n        state.changed = true\n    end\n    \n    local sorted = {}\n    \n    for index, mob in ipairs(composition) do\n        sorted[index] = {\n            name = mob.name,\n            count = counts and counts[mob.name] or mob.count,\n            total = mob.count,\n        }\n    end\n    \n    table.sort(sorted, function(a, b)\n            if a.total == b.total then\n                return a.name < b.name\n            end\n            \n            return a.total > b.total\n    end)\n    \n    for index, mob in ipairs(sorted) do\n        local data = aura_env.mobData[mob.name]\n        \n        if data then\n            allstates[mob.name] = {\n                show = true,\n                changed = true,\n                index = index,\n                icon = data.icon,\n                count = mob.count,\n                name = mob.count == 1 and data.singular or data.plural,\n                progressType = \"static\",\n                value = mob.count,\n                total = mob.total,\n            }\n        end\n    end\n    \n    return true\nend\n\nfunction aura_env.hideState(allstates)\n    for _, state in pairs(allstates) do\n        state.show = false\n        state.changed = true\n    end\n    \n    return true\nend\n\nfunction aura_env.startWave(bossWave, waveCount, composition)\n    wipe(aura_env.deadGUIDs)\n    \n    aura_env.bossWave = bossWave\n    aura_env.waveCount = waveCount\n    \n    local counts = {}\n    \n    for _, mob in ipairs(composition) do\n        counts[mob.name] = mob.count\n    end\n    \n    aura_env.saved.hyjalMobWave = {\n        bossWave = bossWave,\n        waveCount = waveCount,\n        counts = counts,\n        deadGUIDs = {},\n    }\nend\n\nfunction aura_env.restoreWave()\n    local saved = aura_env.saved.hyjalMobWave\n    \n    if not saved then\n        return\n    end\n    \n    aura_env.bossWave = saved.bossWave\n    aura_env.waveCount = saved.waveCount\n    \n    wipe(aura_env.deadGUIDs)\n    \n    for destGUID in pairs(saved.deadGUIDs or {}) do\n        aura_env.deadGUIDs[destGUID] = true\n    end\nend\n\nfunction aura_env.clearWave()\n    aura_env.bossWave = nil\n    aura_env.waveCount = nil\n    aura_env.saved.hyjalMobWave = nil\n    wipe(aura_env.deadGUIDs)\nend\n\nfunction aura_env.processDeath(allstates, destGUID, broadcast)\n    if not destGUID or aura_env.deadGUIDs[destGUID] then\n        return false\n    end\n    \n    local npcID = select(6, strsplit(\"-\", destGUID))\n    local stateKey = aura_env.npcLookup[npcID]\n    \n    if not stateKey then\n        return false\n    end\n    \n    local state = allstates[stateKey]\n    \n    if not state or state.count <= 0 then\n        return false\n    end\n    \n    aura_env.deadGUIDs[destGUID] = true\n    state.count = state.count - 1\n    state.value = state.count\n    state.name = state.count == 1 and aura_env.mobData[stateKey].singular or aura_env.mobData[stateKey].plural\n    state.changed = true\n    \n    local saved = aura_env.saved.hyjalMobWave\n    \n    if saved then\n        saved.deadGUIDs[destGUID] = true\n        saved.counts[stateKey] = state.count\n    end\n    \n    if broadcast then\n        _G.SyncEvents(\"RAID\", nil, \"WA_FJI_HYJAL_MOB_DIED_SYNC\", aura_env.bossWave, aura_env.waveCount, destGUID)\n    end\n    \n    return true\nend",
["do_custom"] = true,
},
},
