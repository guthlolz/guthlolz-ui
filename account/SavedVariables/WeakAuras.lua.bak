["CT:[T5][Karathress] Spitfire Totem"] = {
["outline"] = "OUTLINE",
["wagoID"] = "gSs1_GQRl",
["color"] = {
1,
1,
1,
1,
},
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["shadowYOffset"] = -1,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiT5RaidPack/3",
["actions"] = {
["start"] = {
},
["finish"] = {
["custom"] = "aura_env.count = 1\naura_env.nuTimer(nil)\naura_env.preWarnCancel()",
["do_sound"] = false,
["do_message"] = false,
["do_custom"] = true,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.key = \"KARATHRESS_SPITFIRE\"\naura_env.count = 1\naura_env.cdStart = 10\naura_env.cdWindow = 20\naura_env.cdReset = 10\naura_env.spitFireTotem = 38236\naura_env.guids = {}\n\nfunction aura_env.nuTimer(countdown, count)\n    WeakAuras.ScanEvents(\"WA_NUMEN_TIMER\", aura_env.key, countdown, count)\nend\n\nfunction aura_env.updateState(allstates)\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n    }\nend\n\nfunction aura_env.hideState(allstates)\n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\nend\n\nfunction aura_env.preWarn(duration, preWarnTime, count)\n    if not preWarnTime then\n        preWarnTime = 3\n    end\n    \n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\n    \n    aura_env.preWarnTimer = C_Timer.NewTimer(duration - preWarnTime, function()\n            WeakAuras.ScanEvents(\"WA_\" .. aura_env.key .. \"_PREWARN\", preWarnTime, count)\n            aura_env.preWarnTimer = nil\n    end)\nend\n\nfunction aura_env.preWarnCancel()\n    WeakAuras.ScanEvents(\"WA_\" .. aura_env.key .. \"_PREWARN_CANCEL\")\n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\nend",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, ...)\n    if event == \"WA_FJI_ENCOUNTER_START\" or event == \"ENCOUNTER_START\" then\n        local eID = ...\n        if eID ~= 626 then\n            return false\n        end\n        \n        aura_env.guids = {}\n        aura_env.updateState(allstates)\n        aura_env.count = 1\n        \n        aura_env.preWarn(aura_env.cdStart, 3, aura_env.count)\n        aura_env.nuTimer(aura_env.cdStart, aura_env.count)\n        return true\n        \n    elseif event == \"WA_FJI_ENCOUNTER_END\" or event == \"ENCOUNTER_END\" then\n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        return true\n        \n    elseif event == \"WA_KARATHRESS_TIDALVESS_DIED\" then\n        aura_env.preWarn(aura_env.cdReset, 3, aura_env.count)\n        aura_env.nuTimer(aura_env.cdReset, aura_env.count)\n        return true\n    end\n    \n    if event == \"WA_KARATHRESS_SPITFIRE_TOTEM\" then\n        local guid = ...\n        aura_env.guids[guid] = true\n        return true\n    end\n    \n    if event ~= \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        return false\n    end\n    \n    local _,subEvent,_,_,_,_,_,destGUID,_,_,_,a12,a13,_,_,a16 = ...\n    \n    if aura_env.guids[destGUID] then\n        local overkill\n        \n        if subEvent == \"SWING_DAMAGE\" then\n            overkill = a13\n        elseif subEvent == \"SPELL_DAMAGE\" or subEvent == \"RANGE_DAMAGE\" then\n            overkill = a16\n        end\n        \n        if overkill and overkill > 0 then\n            aura_env.guids[destGUID] = nil\n            WeakAuras.ScanEvents(\"WA_KARATHRESS_SPITFIRE_TOTEM_DIED\", destGUID)\n            return true\n        end\n    end\n    \n    if subEvent == \"SPELL_SUMMON\" then\n        local spellId = a12\n        \n        if spellId ~= aura_env.spitFireTotem then\n            return false\n        end\n        \n        if not aura_env.guids[destGUID] then\n            WeakAuras.ScanEvents(\"WA_KARATHRESS_SPITFIRE_TOTEM\", destGUID)\n        end\n        \n        aura_env.nuTimer(0, aura_env.count)\n        aura_env.count = aura_env.count + 1\n        aura_env.preWarn(aura_env.cdWindow, 3, aura_env.count)\n        aura_env.nuTimer(aura_env.cdWindow, aura_env.count)\n        return true\n    end\n    \n    return false\nend",
["spellIds"] = {
},
["events"] = "ENCOUNTER_START, ENCOUNTER_END, WA_FJI_ENCOUNTER_END, WA_FJI_ENCOUNTER_START, CLEU:RANGE_DAMAGE:SPELL_DAMAGE:SWING_DAMAGE:SPELL_SUMMON, WA_KARATHRESS_TIDALVESS_DIED, WA_KARATHRESS_SPITFIRE_TOTEM",
