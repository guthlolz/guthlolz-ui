["customText"] = "function()\n    if aura_env.unit_is_player and aura_env.pet_target and aura_env.pet_target_guid then\n        local eclass = select(2, GetPlayerInfoByGUID(aura_env.pet_target_guid))\n        local argbHex = select(4, GetClassColor(eclass))\n        local colored_name = \"|c\"..argbHex..aura_env.pet_target..\"|r\"\n        return colored_name\n    elseif aura_env.pet_target then\n        return aura_env.pet_target\n    end\n    return \"\"\nend",
