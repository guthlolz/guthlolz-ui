},
["displayText_format_p_time_format"] = 0,
["sameTexture"] = true,
["url"] = "https://wago.io/FojjiBT-P1/12",
["actions"] = {
["start"] = {
["do_custom"] = true,
["custom"] = "local state = aura_env.state\nif state and state.spellKey then\n    local color = aura_env.getColor(state.spellKey)\n    aura_env.region:Color(color[1], color[2], color[3], color[4] or 1)\nend",
},
["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.region.bar:SetVertexColor(1, 1, 1, 1)\n\naura_env.spellKeys = { -- Colour is RGBA (Red,Green,Blue,Alpha)\n    -- name, icon, autoHide (true/false), role (\"TANK\"/\"HEALER\") note that the first role is selected for the Icon, roleRestrict (true/false), useText (true/false)\n    \n    [\"TRASH_BONECHEWER_WW\"] = {name = \"Whirlwind\", icon = 132369, npcID = \"23235\"}, -- Whirlwind (Bonechewer Blade Fury)\n    [\"TRASH_ILLIDARI_HOJ\"] = {name = \"Hammer of Justice\", icon = 135963, npcID = \"23397\"}, -- HoJ (Illidari Blood Lord)\n    [\"TRASH_ILLIDARI_VANISH\"] = {name = \"Vanish\", icon = 132331, npcID = \"23403\"}, -- Vanish (Illdari Assassin)\n    [\"TRASH_SENTINEL_L5\"] = {name = \"L5 Charge\", icon = 135734, npcID = \"23394\"}, -- L5 Arcane Charge (Promenade Sentinel)\n    [\"TRASH_COILSKAR_HURRICANE\"] = {name = \"Hurricane\", icon = 136018, npcID = \"22875\"}, -- Hurricane (Coilskar Sea-Caller)\n    [\"TRASH_LEVIATHAN_TAILSWEEP\"] = {name = \"Tail Sweep\", icon = 134307, npcID = \"22884\"}, -- Tail Sweep (Leviathan)\n    [\"TRASH_COILSKAR_PROD\"] = {name = \"Lightning Prod\", icon = 135600, npcID = \"22877\"}, -- Lightning Prod (Coilskar Wrangler)\n    [\"TRASH_COILSKAR_GEYSER\"] = {name = \"Geyser\", icon = 135854, npcID = \"22875\"}, -- Summon Geyser (Coilskar Sea-Caller)\n    [\"TRASH_COILSKAR_BOOMING\"] = {name = \"Booming Voice\", icon = 132339, npcID = \"22873\"}, -- Booming Voice (Coilskar General)\n    [\"TRASH_COILSKAR_NET\"] = {name = \"Hooked Net\", icon = 132149, npcID = \"22874\"}, -- Hooked Net (Coilskar Harpooner)\n    [\"TRASH_AQUEOUS_WAVE\"] = {name = \"Crashing Wave\", icon = 135795, npcID = \"22878\"}, -- Crashing Wave (Aqueous Lord)\n    [\"TRASH_WYRMCALLER_CLEAVE\"] = {name = \"Cleave\", icon = 132338, npcID = \"22960\"}, -- Cleave (Dragonmaw Wyrmcaller)\n    [\"TRASH_FEARBRINGER_STOMP\"] = {name = \"War Stomp\", icon = 132091, npcID = \"22954\"}, -- War Stomp (Illidari Fearbringer)\n    [\"TRASH_FEARBRINGER_FLAMES\"] = {name = \"Illidari Flames\", icon = 135777, npcID = \"22954\"}, -- Illidari Flames (Illidari Fearbringer)\n    [\"TRASH_WINDREAVER_FREEZE\"] = {name = \"Freeze\", icon = 135848, npcID = \"23330\"}, -- Freeze (Dragonmaw Wind Reaver)\n    [\"TRASH_BONESLICER_GOUGE\"] = {name = \"Gouge\", icon = 132155, npcID = \"22869\"}, -- Gouge (Illidari Boneslicer)\n    [\"TRASH_BONESLICER_SHADOWSTEP\"] = {name = \"Shadowstep\", icon = 132303, npcID = \"22869\"}, -- Shadowstep (Illidari Boneslicer)\n    [\"TRASH_CENTURION_SONICSTRIKE\"] = {name = \"Sonic Strike\", icon = 135975, npcID = \"23337\"}, -- Sonic Strike (Illidari Centurion)\n    [\"TRASH_CENTURION_CLEAVE\"] = {name = \"Cleave\", icon = 132338, npcID = \"23337\"}, -- Cleave (Illidari Centurion)\n    [\"TRASH_NIGHTLORD_SHADOWINFERNO\"] = {name = \"Shadow Inferno\", icon = 135801, npcID = \"22855\"}, -- Shadow Inferno (Illidari Nightlord)\n    [\"TRASH_NIGHTLORD_FEAR\"] = {name = \"Fear\", icon = 136183, npcID = \"22855\"}, -- Fear (Illidari Nightlord)\n    [\"TRASH_ASHTONGUE_CONCUSSION\"] = {name = \"Concussion Blow\", icon = 132325, npcID = \"22844\"}, -- Concussion Blow (Ashtongue Battlelord)\n    [\"TRASH_ASHTONGUE_CLEAVE\"] = {name = \"Cleave\", icon = 132338, npcID = \"22844\"}, -- Cleave (Ashtongue Battlelord)\n    [\"TRASH_ASHTONGUE_CYCLONETOTEM\"] = {name = \"Cyclone Totem\", icon = 136018, npcID = \"22845\"}, -- Cyclone Totem (Ashtongue Mystic)\n    [\"TRASH_NIGHTLORD_SHADOWFIENDS\"] = {name = \"Shadowfiends\", icon = 136199, npcID = \"22855\"}, -- Shadowfiends (Illidari Nightlord)\n    [\"TRASH_FURY_STORMBLINK\"] = {name = \"Storm Blink\", icon = 132331, npcID = \"22848\"}, -- Storm Blink (Storm Fury)\n    [\"TRASH_ASHTONGUE_SWEEPINGWINGCLIP\"] = {name = \"Wing Clip\", icon = 132309, npcID = \"22847\"}, -- Wing Clip (Ashtongue Primalist)\n    [\"TRASH_ASHTONGUE_WYVERN\"] = {name = \"Wyvern Sting\", icon = 135125, npcID = \"22847\"}, -- Wyvern Sting (Ashtongue Primalist)\n    [\"TRASH_ASHTONGUE_BLIND\"] = {name = \"Blind\", icon = 136175, npcID = \"23374\"}, -- Blind (Ashtongue Stalker)\n    [\"TRASH_SHADOWMOON_SPELLABSORPTION\"] = {name = \"Spell Absorption\", icon = 135874, npcID = \"22879\"}, -- Spell Absorption (Shadowmoon Reaver)\n    [\"TRASH_SHADOWMOON_CHAOTICLIGHT\"] = {name = \"Chaotic Light\", icon = 132338, npcID = \"22880\"}, -- Chaotic Light (Shadowmoon Champion)\n    [\"TRASH_SHADOWMOON_WHIRLINGBLADE\"] = {name = \"Whirling Blade\", icon = 135568, npcID = \"22880\"}, -- Whirling Blade (Shadowmoon Champion)\n    [\"TRASH_SHADOWMOON_FREEZINGTRAP\"] = {name = \"Freezing Trap\", icon = 135834, npcID = \"23018\"}, -- Freezing Trap (Shadowmoon Houndmaster)\n    [\"TRASH_SHADOWMOON_BLOODSIPHON\"] = {name = \"Blood Siphon\", icon = 136168, npcID = \"22945\"}, -- Blood Siphon (Shadowmoon Blood-Mage)\n    [\"TRASH_SHADOWMOON_DEATHCOIL\"] = {name = \"Death Coil\", icon = 136145, npcID = \"22882\"}, -- Death Coil (Shadowmoon Deathshaper)\n    [\"TRASH_WRATHBONE_CLEAVE\"] = {name = \"Cleave\", icon = 132338, npcID = \"22953\"}, -- Cleave (Wrathbone Flayer)\n    [\"TRASH_WRATHBONE_IGNORED\"] = {name = \"Ignored\", icon = 132288, npcID = \"22953\"}, -- Ignored (Wrathbone Flayer)\n    [\"TRASH_WEAPONMASTER_KNOCK\"] = {name = \"Knock Away\", icon = 132939, npcID = \"23049\"}, -- Knock Away (Weapon Master)\n    [\"TRASH_WEAPONMASTER_WHIRLWIND\"] = {name = \"Whirlwind\", icon = 132369, npcID = \"23049\"}, -- Whirlwind (Weapon Master)\n    [\"TRASH_WEAPONMASTER_MUTILATE\"] = {name = \"Mutilate\", icon = 132147, npcID = \"23049\"}, -- Mutilate (Weapon Master)\n    [\"TRASH_BONECHEWER_THROWSHIELD\"] = {name = \"Throw Shield\", icon = 135681, npcID = \"23236\"}, -- Throw Shield (Bonechewer Shield Disciple)\n    [\"TRASH_BONECHEWER_PROPHECY\"] = {name = \"Prophecy of Blood\", icon = 136124, npcID = \"23237\"}, -- Prophecy of Blood (Bonechewer Blood Prophet)\n    [\"TRASH_BEHEMOTH_CHARGE\"] = {name = \"Charge\", icon = 132337, npcID = \"23196\"}, -- Charge (Bonechewer Behemoth)\n    [\"TRASH_BEHEMOTH_METEOR\"] = {name = \"Meteor\", icon = 135808, npcID = \"23196\"}, -- Meteor (Bonechewer Behemoth)\n    [\"TRASH_ARDENT_SLEEP\"] = {name = \"Sleep\", icon = 136090, npcID = \"22959\"}, -- Sleep (Ardent Host)\n    [\"TRASH_STEWARD_UPPERCUT\"] = {name = \"Uppercut\", icon = 132939, npcID = \"22965\"}, -- Uppercut (Devoted Steward)\n    [\"TRASH_STEWARD_KIDNEY\"] = {name = \"Kidney Shot\", icon = 132298, npcID = \"22965\"}, -- Kidney Shot (Devoted Steward)\n    [\"TRASH_DELIGHT_SHELL\"] = {name = \"Shell of Life\", icon = 135981, npcID = \"22956\"}, -- Shell of Life (Priestess of Delight)\n    [\"TRASH_TORMENT_SHELL\"] = {name = \"Shell of Pain\", icon = 136121, npcID = \"22964\"}, -- Shell of Pain (Priestess of Torment)\n    [\"TRASH_DEMENTIA_DEMENTIA\"] = {name = \"Dementia\", icon = 135769, npcID = \"22957\"}, -- Dementia (Mistress of Dementia)\n    [\"TRASH_DEMENTIA_CONFUSION\"] = {name = \"Confusion\", icon = 136175, npcID = \"22957\"}, -- Confusion (Mistress of Dementia)\n    [\"TRASH_WOE_CURSE\"] = {name = \"Curse of Vitality\", icon = 132102, npcID = \"22962\"}, -- Curse of Vitality (Mistress of Woe)\n    [\"TRASH_ILLIDARI_BLIZZARD\"] = {name = \"Blizzard\", icon = 135857, npcID = \"23402\"}, -- Blizzard (Illidari Battle-Mage)\n    [\"TRASH_ILLIDARI_FLAMESTRIKE\"] = {name = \"Flamestrike\", icon = 135826, npcID = \"23402\"}, -- Flamestrike (Illidari Battle-Mage)\n}\n\naura_env.timers = {}\n\nfunction aura_env.getColor(key)\n    local cfg = aura_env.config.option\n    \n    if cfg.colorOverride and cfg.color then\n        return { cfg.color[1], cfg.color[2], cfg.color[3], cfg.color[4] or 1 }\n    end\n    \n    local color = cfg.enabledGroup and cfg.enabledGroup[\"COL_\" .. key]\n    if color and color[1] then\n        return { color[1], color[2], color[3], color[4] or 1 }\n    end\nend\n\nlocal function createKey(key, guid)\n    if guid then\n        return key .. \"_\" .. guid\n    end\n    return key\nend\n\nfunction aura_env.updateState(allstates, key, duration, count, name, icon, color, autoHide, text, guid)\n    local r, g, b, a = color[1], color[2], color[3], color[4] or 1\n    local stateKey = (guid and (key .. \"_\" .. guid)) or key\n    local isTarget = false\n    \n    if guid and aura_env.targetGUID and guid == aura_env.targetGUID then\n        isTarget = true\n    end\n    \n    allstates[stateKey] = {\n        show = true,\n        changed = true,\n        duration = duration,\n        expirationTime = GetTime() + duration,\n        progressType = \"timed\",\n        count = count,\n        color = { r, g, b, a },\n        icon = icon,\n        name = name,\n        autoHide = autoHide,\n        text = text or \"\",\n        spellKey = key,\n        guid = guid,\n        isTarget = isTarget,\n        useText = text and text ~= \"\",\n    }\nend\n\nfunction aura_env.hideState(allstates, key, guid)\n    local stateKey = createKey(key, guid)\n    \n    if allstates[stateKey] then\n        allstates[stateKey].show = false\n        allstates[stateKey].changed = true\n        return true\n    end\nend\n\nfunction aura_env.scheduleTimer(key, delay, count, displayName, icon, color, autoHide, text, guid, tts)\n    local timerKey = (guid and (key .. \"_\" .. guid)) or key\n    \n    if aura_env.timers[timerKey] then\n        aura_env.timers[timerKey]:Cancel()\n        aura_env.timers[timerKey] = nil\n    end\n    \n    aura_env.timers[timerKey] = C_Timer.NewTimer(delay, function()\n            WeakAuras.ScanEvents(\"WA_NUMEN_EMPHASIZED_TIMER\",\n            key, 10, count, displayName, icon, color, autoHide, text, guid, tts)\n    end)\nend\n\nfunction aura_env.cancelTimer(key, guid)\n    local timerKey = createKey(key, guid)\n    \n    if aura_env.timers[timerKey] then\n        aura_env.timers[timerKey]:Cancel()\n        aura_env.timers[timerKey] = nil\n    end\nend",
},
