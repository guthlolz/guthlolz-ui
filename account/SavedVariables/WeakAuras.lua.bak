["spellIds"] = {
},
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            autoHide = true,\n        }\n        return true\n    end\n    \n    if event == \"NAME_PLATE_UNIT_ADDED\" then\n        local unit = ...\n        local guid = UnitGUID(unit)\n        if not guid then\n            return false\n        end\n        \n        local expiration = aura_env.expirationTime[guid]\n        local duration = aura_env.duration[guid]\n        local range = aura_env.range[guid]\n        \n        if expiration and duration and range and expiration > GetTime() then\n            allstates[unit] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = duration,\n                expirationTime = expiration,\n                autoHide = true,\n                unit = unit,\n            }\n            \n            aura_env.startTicker(unit, guid, expiration - GetTime(), range)\n            return true\n        end\n    end\n    \n    if event == \"NAME_PLATE_UNIT_REMOVED\" then\n        local unit = ...\n        \n        if aura_env.tickers[unit] then\n            aura_env.tickers[unit]:Cancel()\n            aura_env.tickers[unit] = nil\n        end\n        \n        if allstates[unit] then\n            allstates[unit].show = false\n            allstates[unit].changed = true\n            return true\n        end\n        \n        return false\n    end\n    \n    if event == \"WA_BONECHEWER_WW\" or event == \"WA_WEAPONMASTER_WW\" then\n        local srcGUID = ...\n        local duration = event == \"WA_BONECHEWER_WW\" and 8 or 15\n        local range = 5 -- event == \"WA_BONECHEWER_WW\" and 5 or 8\n        local expiration = GetTime() + duration\n        \n        aura_env.duration[srcGUID] = duration\n        aura_env.expirationTime[srcGUID] = expiration\n        aura_env.range[srcGUID] = range\n        \n        for _,plate in pairs(C_NamePlate.GetNamePlates()) do\n            local unit = plate.UnitFrame and plate.UnitFrame.displayedUnit\n            local guid = unit and UnitGUID(unit)\n            \n            if guid == srcGUID then\n                allstates[unit] = {\n                    show = true,\n                    changed = true,\n                    progressType = \"timed\",\n                    duration = duration,\n                    expirationTime = expiration,\n                    autoHide = true,\n                    unit = unit,\n                }\n                \n                aura_env.startTicker(unit, guid, duration, range)\n                return true\n            end\n        end\n        \n        return false\n    end\n    \n    if event == \"WA_WW_UPDATE\" then\n        local guid, safe = ...\n        \n        for unit,state in pairs(allstates) do\n            if UnitGUID(unit) == guid then\n                if state.safe ~= safe then\n                    state.safe = safe\n                    state.changed = true\n                    return true\n                end\n            end\n        end\n        \n        return false\n    end\n    \n    if event == \"WA_BONECHEWER_WW_DIED\" or event == \"WA_WEAPONMASTER_WW_DIED\" then\n        local destGUID = ...\n        \n        aura_env.duration[destGUID] = nil\n        aura_env.expirationTime[destGUID] = nil\n        aura_env.range[destGUID] = nil\n        \n        for unit,state in pairs(allstates) do\n            if UnitGUID(unit) == destGUID then\n                if aura_env.tickers[unit] then\n                    aura_env.tickers[unit]:Cancel()\n                    aura_env.tickers[unit] = nil\n                end\n                \n                state.show = false\n                state.changed = true\n            end\n        end\n        \n        return true\n    end\nend",
