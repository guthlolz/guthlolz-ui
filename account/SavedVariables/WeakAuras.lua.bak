["icon_side"] = "LEFT",
["displayText_format_t_time_precision"] = 1,
["actions"] = {
["start"] = {
},
["finish"] = {
},
["init"] = {
["custom"] = "aura_env.mobNames = {\n    [\"Ghouls\"] = \"Ghouls\",\n    [\"Crypt Fiends\"] = \"Fiends\",\n    [\"Necromancers\"] = \"Necros\",\n    [\"Abominations\"] = \"Aboms\",\n    [\"Banshees\"] = \"Banshees\",\n    [\"Gargoyles\"] = \"Gargs\",\n    [\"Frost Wyrm\"] = \"Wyrms\",\n    [\"Fel Stalkers\"] = \"Stalkers\",\n    [\"Infernals\"] = \"Infernals\",\n}\n\nfunction aura_env.formatComposition(composition)\n    local sorted = CopyTable(composition)\n    \n    table.sort(sorted, function(a, b)\n            if a.count == b.count then\n                return a.name < b.name\n            end\n            \n            return a.count > b.count\n    end)\n    \n    local parts = {}\n    \n    for i, mob in ipairs(sorted) do\n        local name = aura_env.mobNames[mob.name] or mob.name\n        parts[i] = string.format(\"|cffffffff%d|r %s\", mob.count, name)\n    end\n    \n    return table.concat(parts, \", \")\nend\n\nfunction aura_env.updateState(allstates, bossWave, waveCount, composition)\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n        bossWave = bossWave,\n        waveCount = waveCount,\n        composition = composition,\n        text = aura_env.formatComposition(composition),\n    }\n    \n    return true\nend\n\nfunction aura_env.hideState(allstates)\n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\n    \n    return false\nend",
["do_custom"] = true,
},
},
