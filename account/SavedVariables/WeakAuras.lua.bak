["init"] = {
["custom"] = "aura_env.unsafe = false\naura_env.whitelist = {}\naura_env.npcID = \"21251\"\n\naura_env.timers = aura_env.timers or {}\n\nfunction aura_env.scheduleEnd(guid)\n    if not guid then return end\n    if aura_env.timers[guid] then\n        aura_env.timers[guid]:Cancel()\n    end\n    \n    aura_env.timers[guid] = C_Timer.NewTimer(8, function()\n            WeakAuras.ScanEvents(\"WA_COLOSSUS_QUAKE_END\", guid)\n            aura_env.timers[guid] = nil\n    end)\nend\n\nfunction aura_env.findUnitByGUID(guid)\n    if not guid then\n        return nil\n    end\n    \n    if UnitExists(\"target\") and UnitGUID(\"target\") == guid then\n        local npcID = select(6, strsplit(\"-\", guid or \"\"))\n        if npcID == aura_env.npcID then\n            return \"target\"\n        end\n    end\n    \n    for i = 1, 40 do\n        local unit = \"nameplate\" .. i\n        if UnitExists(unit) and UnitGUID(unit) == guid then\n            local npcID = select(6, strsplit(\"-\", guid or \"\"))\n            if npcID == aura_env.npcID then\n                return unit\n            end\n        end\n    end\n    return nil\nend\n\nfunction aura_env.updateState(allstates, guid, unit)\n    if not guid or not aura_env.whitelist[guid] then\n        return\n    end\n    \n    unit = unit or aura_env.findUnitByGUID(guid)\n    \n    if not unit or not UnitExists(unit) then\n        if allstates[guid] then\n            allstates[guid].show = false\n            allstates[guid].changed = true\n            allstates[guid].unit = nil\n        end\n        return\n    end\n    \n    local range = WeakAuras.GetRange(unit)\n    \n    allstates[guid] = {\n        show = true,\n        changed = true,\n        guid = guid,\n        unit = unit,\n        range = range,\n        isSafe = range and (range >= 21) or false,\n        progressType = \"static\",\n        value = range,\n        total = 40,\n    }\n    return true\nend\n\nfunction aura_env.ensureTicker()\n    if not aura_env.ticker then\n        aura_env.ticker = C_Timer.NewTicker(0.2, function()\n                WeakAuras.ScanEvents(\"WA_COLOSSUS_RANGE_CHECK\")\n        end)\n    end\nend\n\nfunction aura_env.checkTicker(allstates)\n    local active = false\n    \n    for _, state in pairs(allstates) do\n        if state.show then\n            active = true\n            break\n        end\n    end\n    \n    if not active and aura_env.ticker then\n        aura_env.ticker:Cancel()\n        aura_env.ticker = nil\n    end\nend\n\nfunction aura_env.updateSafety(allstates)\n    local unsafe = false\n    \n    for _, state in pairs(allstates) do\n        if state.show and state.isSafe == false then\n            unsafe = true\n            break\n        end\n    end\n    \n    if unsafe ~= aura_env.unsafe then\n        aura_env.unsafe = unsafe\n        \n        if unsafe then\n            WeakAuras.ScanEvents(\"WA_QUAKE_NOT_SAFE\")\n        else\n            WeakAuras.ScanEvents(\"WA_QUAKE_SAFE\")\n        end\n    end\nend",
["do_custom"] = true,
},
