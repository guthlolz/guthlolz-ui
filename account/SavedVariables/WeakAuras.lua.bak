["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.saved = aura_env.saved or aura_env.config.option.font\n\nif aura_env.saved ~= aura_env.config.option.font then\n    if FojjiCore and FojjiCore.PatchFontForGroup then\n        FojjiCore:PatchFontForGroup(\"Fojji - [T6] Black Temple [Part 2]\", aura_env.config.option.font)\n        FojjiCore:PatchFontForGroup(\"Fojji - [T6] Black Temple [Part 1]\", aura_env.config.option.font)\n        aura_env.saved = aura_env.config.option.font\n    end\n    return true\nend",
},
