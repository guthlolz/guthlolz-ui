["[CL]:Paladin - MH Swing [RET]"] = {
["sparkWidth"] = 6,
["iconSource"] = -1,
["authorOptions"] = {
{
["text"] = "|TInterface/Icons/classicon_paladin:14:14|t Fojji - Paladin UI [Customization] |TInterface/Icons/classicon_paladin:14:14|t",
