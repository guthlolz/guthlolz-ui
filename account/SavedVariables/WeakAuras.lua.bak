["custom"] = "function(a, e, guid)\n    if e == \"OPTIONS\" then\n        a[\"\"] = {\n            show = true,\n            changed = true,\n            icon = 136018,\n        }\n        return true\n    end\n    \n    if e == \"WA_TRASH_CYCLONE_TOTEM\" then\n        a[guid] = {\n            show = true,\n            changed = true,\n            icon = 136018,\n            progressType = \"timed\",\n            duration = 20,\n            expirationTime = GetTime() + 20,\n            autoHide = true,\n        }\n        return true\n    end\n    \n    if e == \"WA_TRASH_CYCLONE_TOTEM_DIED\" then\n        if a[guid] then\n            a[guid].show = false\n            a[guid].changed = true\n            return true\n        end\n    end\nend",
