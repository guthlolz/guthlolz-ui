{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "WA_AKAMA_ACTIVATED, UNIT_SPELLCAST_SUCCEEDED, CLEU:SWING_DAMAGE",
["spellIds"] = {
},
["custom"] = "function(allstates, event, ...)\n    if event == \"WA_AKAMA_ACTIVATED\" then\n        aura_env.phase = 1\n        return\n    end\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local _,subEvent,_,sourceGUID,_,_,_,destGUID,destName,_,_,spellId = ...\n        \n        if aura_env.phase == 2 then\n            return false\n        end\n        \n        local npcID = select(6, strsplit(\"-\", sourceGUID))\n        \n        if npcID == \"22841\" then\n            WeakAuras.ScanEvents(\"WA_AKAMA_P2_START\")\n            aura_env.phase = 2\n            return\n        end\n    end\n    \n    if event == \"UNIT_SPELLCAST_SUCCEEDED\" then\n        local unit,_,spellId = ...\n        if spellId ~= 40607 and spellId ~= 40955 then\n            return false\n        end\n        \n        if aura_env.phase == 2 then\n            return false\n        end\n        \n        if GetTime() - aura_env.throttle < 3 then\n            return false\n        end\n        aura_env.throttle = GetTime()\n        \n        WeakAuras.ScanEvents(\"WA_AKAMA_P2_START\")\n        aura_env.phase = 2\n        return\n    end\nend",
["check"] = "event",
