{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, sourceGUID, destGUID, destUnit)\n    if event == \"OPTIONS\" then\n        for i = 1,2 do\n            allstates[i] = {\n                show = true,\n                changed = true,\n                duration = 1.995,\n                expirationTime = GetTime() + 1.995,\n                progressType = \"timed\",\n                icon = 135732,\n                autoHide = true,\n                guid = WeakAuras.myGUID and WeakAuras.myGUID or \"unknown\",\n            }\n        end\n        return true\n    end\n    \n    if (not _G.FJI_HEALER and not _G.FJI_TANK and not UnitIsGroupLeader(\"player\")) then\n        return false\n    end\n    \n    if event == \"WA_TRASH_OVERCHARGE_TARGET\" then\n        allstates[sourceGUID] = {\n            show = true,\n            changed = true,\n            duration = 1.995,\n            expirationTime = GetTime() + 1.995,\n            progressType = \"timed\",\n            icon = 135732,\n            autoHide = true,\n            guid = destGUID and destGUID or \"unknown\",\n        }\n        return true\n    end\n    if event == \"WA_TRASH_SENTINEL_DIED\" then\n        if allstates[sourceGUID] then\n            allstates[sourceGUID].show = false\n            allstates[sourcedGUID].changed = true\n            return true\n        end\n    end\nend",
["spellIds"] = {
},
["events"] = "WA_TRASH_OVERCHARGE_TARGET WA_TRASH_SENTINEL_DIED",
["check"] = "event",
["unit"] = "player",
["custom_hide"] = "timed",
["customVariables"] = "{\n    guid = \"string\",\n}    \n\n",
},
["untrigger"] = {
