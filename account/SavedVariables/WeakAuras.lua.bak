["custom"] = "function(allstates, event, key, time)\n    if event == \"WA_NUMEN_TIMER\" then\n        if aura_env.berserkKeys[key] and time ~= nil and time > 0 then\n            return aura_env.updateState(allstates, time, key)\n        end\n    elseif event == \"WA_FJI_ENCOUNTER_END\" then\n        aura_env.hideState(allstates)\n        return true\n    end\nend",
