["custom"] = "aura_env.saved = aura_env.saved or {}\naura_env.timer = 46\n\nlocal locale = GetLocale()\n\naura_env.locales = {\n    [\"enUS\"] = {\n        akamaDoor = \"This door is all that stands between us\",\n    },\n    [\"frFR\"] = {\n        akamaDoor = \"This door is all that stands between us\",\n    },\n    [\"deDE\"] = {\n        akamaDoor = \"This door is all that stands between us\",\n    },\n    [\"esES\"] = {\n        akamaDoor = \"This door is all that stands between us\",\n    },\n    [\"koKR\"] = {\n        akamaDoor = \"This door is all that stands between us\",\n    },\n    [\"ptBR\"] = {\n        akamaDoor = \"This door is all that stands between us\",\n    },\n    [\"ruRU\"] = {\n        akamaDoor = \"This door is all that stands between us\",\n    },\n    [\"zhCN\"] = {\n        akamaDoor = \"This door is all that stands between us\",\n    },\n    [\"zhTW\"] = {\n        akamaDoor = \"This door is all that stands between us\",\n    }\n}\n\naura_env.currentLocale = aura_env.locales[locale] or aura_env.locales[\"enUS\"]\n\nfunction aura_env.clearTimer()\n    aura_env.saved.expiration = nil\nend\n\nfunction aura_env.getRemaining()\n    local exp = aura_env.saved.expiration\n    if not exp then\n        return nil\n    end\n    \n    local remaining = exp - GetTime()\n    \n    if remaining > aura_env.timer then\n        aura_env.clearTimer()\n        return nil\n    end\n    \n    if remaining <= 0 then\n        aura_env.clearTimer()\n        return nil\n    end\n    \n    return remaining, exp\nend\n\nfunction aura_env.hasActiveTimer()\n    return aura_env.getRemaining() ~= nil\nend\n\nfunction aura_env.startTimer()\n    aura_env.saved.expiration = GetTime() + aura_env.timer\nend\n\nfunction aura_env.showState(allstates)\n    local remaining, exp = aura_env.getRemaining()\n    if not remaining then\n        return false\n    end\n    \n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n        progressType = \"timed\",\n        duration = remaining,\n        expirationTime = exp,\n        autoHide = true,\n    }\n    return true\nend",
},
