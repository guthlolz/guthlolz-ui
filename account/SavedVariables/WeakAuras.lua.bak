["CT:[BT][Illidan] Phase Controller"] = {
["outline"] = "OUTLINE",
["wagoID"] = "pbbuhQ899",
["parent"] = "[BT][Illidan]",
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiBT-P1/12",
["actions"] = {
["start"] = {
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.flamesDead = 0\naura_env.p4 = false\naura_env.prison = 40647\naura_env.throwGlaive = 39849\naura_env.npcID = \"22997\"\naura_env.key = \"ILLIDAN_P4_START\"\n\naura_env.demonForm = 40506\naura_env.illidanNPCID = \"22917\"\naura_env.inDemonPhase = false\n\nfunction aura_env.hasDemonForm(unit)\n    return WA_GetUnitAura(unit,aura_env.demonForm,\"HELPFUL\") ~= nil\nend\n\nfunction aura_env.nuTimer(countdown,count)\n    WeakAuras.ScanEvents(\"WA_NUMEN_TIMER\",aura_env.key,countdown,count)\nend\n\nlocal locale = GetLocale()\n\naura_env.locales = {\n    [\"enUS\"] = {\n        p4 = \"Is this it, mortals? Is this all the fury you can muster?\",\n    },\n    [\"frFR\"] = {\n        p4 = \"C'est tout, mortels ? Est-ce là toute la fureur que vous pouvez évoquer ?\",\n    },\n    [\"deDE\"] = {\n        p4 = \"War's das schon, Sterbliche? Ist das alles, was Ihr zu bieten habt?\",\n    },\n    [\"esES\"] = {\n        p4 = \"¿Esto es todo, mortales? ¿Es esta toda la furia que podéis reunir?\",\n    },\n    [\"koKR\"] = {\n        p4 = \"필멸의 종족들이여, 나에 대한 증오가 고작 이 정도냐?\",\n    },\n    [\"ruRU\"] = {\n        p4 = \"Это все, смертные? Это все, на что вы способны?\",\n    },\n    [\"zhCN\"] = {\n        p4 = \"你们就这点本事吗？这就是你们全部的能耐？\",\n    },\n    [\"zhTW\"] = {\n        p4 = \"你們就這點本事嗎?這就是你們全部的能耐?\",\n    }\n}\n\naura_env.currentLocale = aura_env.locales[locale] or aura_env.locales[\"enUS\"]",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "aura_env.inDemonPhase = false\naura_env.flamesDead = 0\naura_env.p4 = false",
["do_sound"] = false,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
["do_message"] = false,
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "CLEU:SPELL_CAST_SUCCESS:UNIT_DIED:SPELL_CAST_START:SPELL_AURA_REMOVED, CHAT_MSG_MONSTER_YELL, UNIT_AURA",
["spellIds"] = {
},
["custom"] = "function(allstates,event,...)\n    if event == \"WA_FJI_ENCOUNTER_START\" or event == \"ENCOUNTER_START\" then\n        local eID = ...\n        \n        if eID ~= 609 then\n            return false\n        end\n        \n        aura_env.flamesDead = 0\n        aura_env.p4 = false\n        aura_env.inDemonPhase = false\n        return false\n    end\n    \n    --[[if event == \"CHAT_MSG_MONSTER_YELL\" then\n        local msg = ...\n        \n        if msg:find(aura_env.currentLocale.p4) or msg == aura_env.currentLocale.p4 then\n            if not aura_env.p4 then\n                WeakAuras.ScanEvents(\"WA_ILLIDAN_P4_START\")\n                aura_env.nuTimer(30,1)\n                aura_env.p4 = true\n                return false\n            end\n        end\n        return false\n    end--]]\n    \n    if event == \"UNIT_AURA\" then\n        local unit = ...\n        local guid = UnitGUID(unit)\n        \n        if not guid or select(6,strsplit(\"-\",guid)) ~= aura_env.illidanNPCID then\n            return false\n        end\n        local demon = aura_env.hasDemonForm(unit)\n        \n        if demon and not aura_env.inDemonPhase then\n            aura_env.inDemonPhase = true\n            WeakAuras.ScanEvents(\"WA_ILLIDAN_DEMON_FORM_DETECT\",\"UNIT_AURA\")\n            return false\n        end\n        \n        if not demon and aura_env.inDemonPhase then\n            aura_env.inDemonPhase = false\n            WeakAuras.ScanEvents(\"WA_ILLIDAN_HUMAN_FORM\")\n            return false\n        end\n        return false\n    end\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local _,subEvent,_,sourceGUID,_,_,_,destGUID,destName,_,_,spellId = ...\n        \n        if subEvent == \"UNIT_DIED\" then\n            local npcID = select(6,strsplit(\"-\",destGUID))\n            \n            if npcID ~= aura_env.npcID then\n                return false\n            end\n            \n            aura_env.flamesDead = aura_env.flamesDead+1\n            \n            if aura_env.flamesDead >= 2 then\n                WeakAuras.ScanEvents(\"WA_ILLIDAN_P3_START\")\n            end\n            return false\n        end\n        \n        if spellId ~= aura_env.throwGlaive and spellId ~= aura_env.prison then\n            return false\n        end\n        \n        if subEvent == \"SPELL_CAST_SUCCESS\" then\n            if spellId == aura_env.prison then\n                if not aura_env.p4 then\n                    WeakAuras.ScanEvents(\"WA_ILLIDAN_P3_END\")\n                    aura_env.nuTimer(30,1)\n                    aura_env.p4 = true\n                end\n            end\n            return false\n        end\n        \n        if subEvent == \"SPELL_AURA_REMOVED\" then\n            local npcID = select(6, strsplit(\"-\", destGUID))\n            if npcID == \"23089\" then\n                WeakAuras.ScanEvents(\"WA_ILLIDAN_P4_START\")\n            end\n            return false\n        end\n        \n        if subEvent == \"SPELL_CAST_START\" then\n            if spellId == aura_env.throwGlaive then\n                aura_env.flamesDead = 0\n                WeakAuras.ScanEvents(\"WA_ILLIDAN_P2_START\")\n                aura_env.phaseEnd = false\n            end\n            \n            return false\n        end\n    end \n    return false\nend",
["check"] = "event",
["subeventPrefix"] = "SPELL",
["custom_hide"] = "timed",
["debuffType"] = "HELPFUL",
},
