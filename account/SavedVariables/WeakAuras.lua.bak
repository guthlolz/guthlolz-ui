["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n        }\n        return true\n    end\n    \n    if event == \"WA_CAPERNIAN_RANGE_UPDATE\" then\n        local range = ...\n        \n        if range == nil or range <= 12 then\n            if allstates[\"\"] then\n                allstates[\"\"].show = false\n                allstates[\"\"].changed = true\n            end\n        elseif range <= 27 then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n            }\n        else\n            if allstates[\"\"] then\n                allstates[\"\"].show = false\n                allstates[\"\"].changed = true\n            end\n        end\n        \n        return true\n    end\nend",
["spellIds"] = {
