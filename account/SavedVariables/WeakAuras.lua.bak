["height"] = 36,
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "aura_env.guids = {}\n\naura_env.igniteSpells = {\n    -- Fireball\n    [133] = true,\n    [143] = true,\n    [145] = true,\n    [3140] = true,\n    [8400] = true,\n    [8401] = true,\n    [8402] = true,\n    [10148] = true,\n    [10149] = true,\n    [10150] = true,\n    [10151] = true,\n    [25306] = true,\n    -- Scorch\n    [2948] = true,\n    [8444] = true,\n    [8445] = true,\n    [8446] = true,\n    [10205] = true,\n    [10206] = true,\n    [10207] = true,\n    [27073] = true,\n    [27074] = true,\n    -- Pyroblast\n    [11366] = true, \n    -- Fire Blast\n    [2136] = true,\n    [2137] = true,\n    [2138] = true,\n    [8412] = true,\n    [8413] = true,\n    [10197] = true,\n    [10199] = true,\n    [27078] = true,\n    [27079] = true,\n    -- Dragon's Breath\n    [31661] = true,\n    -- Flamestrike\n    [2120] = true,\n    [2121] = true,\n    [8422] = true,\n    [8423] = true,\n    [10215] = true,\n    [10216] = true,\n    [27086] = true,\n    -- Blast Wave\n    [11113] = true,\n}\n\naura_env.IGNITE_SPELL_ID = 12654\naura_env.IGNITE_TICKS = 2\n\nfunction aura_env.igniteGain(dmg)\n    return dmg * 0.4\nend\n\nfunction aura_env.hideState(allstates)\n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\nend\n\nfunction aura_env.updateTargetState(allstates, guid)\n    local data = guid and aura_env.guids[guid]\n    if not guid or not data or not data.pool or data.pool <= 0 then\n        return aura_env.hideState(allstates)\n    end\n    \n    local remainingTicks = math.max(data.remainingTicks or aura_env.IGNITE_TICKS, 1)\n    local predictedTick  = data.pool / remainingTicks\n    \n    allstates[\"\"] = {\n        show    = true,\n        changed = true,\n        pool    = data.pool,\n        tick    = predictedTick,\n    }\n    return true\nend",
["do_custom"] = true,
},
["finish"] = {
},
},
