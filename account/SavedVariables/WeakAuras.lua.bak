["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["custom_type"] = "stateupdate",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(allstates, event, key, time, count)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 1.5,\n            expirationTime = GetTime() + 1.5,\n            progressType = \"timed\",\n            icon = 136147,\n            autoHide = true,\n        }\n        return true\n    end\n    \n    if event == \"WA_NUMEN_TIMER\" and key == \"ARCHIMONDE_FEAR\" then\n        if time == 0 then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = 1.5,\n                expirationTime = GetTime() + 1.5,\n                progressType = \"timed\",\n                icon = 136147,\n                autoHide = true,\n            }\n        elseif time == nil then\n            if allstates[\"\"] then\n                allstates[\"\"].show = false\n                allstates[\"\"].changed = true\n            end\n        end\n        return true\n    end\nend",
["events"] = "WA_NUMEN_TIMER",
["spellIds"] = {
},
["names"] = {
},
