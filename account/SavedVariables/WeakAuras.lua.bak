["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["names"] = {
},
["spellIds"] = {
},
["custom"] = "function(a,e,_,subEvent,_,sourceGUID,sourceName,_,_,destGUID,destName,_,_,spellId,spellName,_,extraSpellId,extraSpellName)\n    if e == \"OPTIONS\" then\n        for i = 1, 2 do\n            local spellId = 4987\n            local spellName = \"Cleanse\"\n            local extraSpellId = 21562\n            local extraSpellName = \"Power Word: Fortitude\"\n            local destName = \"Vurtne\"\n            aura_env.iconRemoved = GetSpellTexture(extraSpellId)\n            \n            a[i] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = 2,\n                expirationTime = 2 + GetTime(),\n                destName = destName,\n                spell = spellName,\n                icon = GetSpellTexture(spellId),\n                spellRemoved = extraSpellName,\n                destName = destName,\n                autoHide = true,\n            }\n        end\n        return true\n    end\n    \n    if subEvent == \"SPELL_DISPEL\" then\n        if sourceGUID ~= WeakAuras.myGUID then\n            return false\n        end\n        \n        if not aura_env.spellIDs[spellId] then\n            return false\n        end\n        \n        local isPlayer = destGUID:sub(1, 6) == \"Player\"\n        local name = isPlayer and WA_ClassColorName(destName) or destName\n        \n        a[extraSpellId] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 2,\n            expirationTime = 2 + GetTime(),\n            spell = spellName,\n            icon = GetSpellTexture(spellId),\n            spellRemoved = extraSpellName,\n            destName = name,\n            autoHide = true,\n        }\n        aura_env.iconRemoved = GetSpellTexture(extraSpellId)\n        return true\n    end\nend",
["events"] = "CLEU:SPELL_DISPEL",
["check"] = "event",
["unit"] = "player",
["customVariables"] = "{\n    iconRemoved = \"number\",\n}",
["custom_hide"] = "timed",
},
