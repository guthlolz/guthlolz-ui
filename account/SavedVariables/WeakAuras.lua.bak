["N:[BT][Reliquary] Enslaved Soul"] = {
["user_y"] = 0,
["iconSource"] = 0,
["user_x"] = 0,
["xOffset"] = 0,
["adjustedMax"] = "",
["yOffset"] = 10,
["foregroundColor"] = {
0.18823529411765,
0.72156862745098,
1,
1,
},
["displayText_format_p_time_format"] = 0,
["sameTexture"] = true,
["url"] = "https://wago.io/FojjiBT-P1/12",
["actions"] = {
["start"] = {
},
["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.npcID = \"23469\"\naura_env.safeRange = 8\n\naura_env.events = {\n    rangeCheck = \"WA_SOUL_RANGE_CHECK\",\n}\n\nfunction aura_env.isTrackedUnit(unit)\n    if not unit or not UnitExists(unit) then\n        return false\n    end\n    \n    local guid = UnitGUID(unit)\n    local npcID = select(6,strsplit(\"-\",guid or \"\"))\n    return npcID == aura_env.npcID\nend\n\nfunction aura_env.isSafeRange(range)\n    return range and range <= aura_env.safeRange or false\nend\n\nfunction aura_env.hasActiveNameplateState(allstates)\n    for unit,state in pairs(allstates) do\n        if unit ~= \"\" and state.show then\n            return true\n        end\n    end\n    return false\nend\n\nfunction aura_env.checkTicker(allstates)\n    if aura_env.hasActiveNameplateState(allstates) then\n        if not aura_env.ticker then\n            aura_env.ticker = C_Timer.NewTicker(0.2,function()\n                    WeakAuras.ScanEvents(aura_env.events.rangeCheck)\n            end)\n        end\n    elseif aura_env.ticker then\n        aura_env.ticker:Cancel()\n        aura_env.ticker = nil\n    end\nend\n\nfunction aura_env.stopTicker()\n    if aura_env.ticker then\n        aura_env.ticker:Cancel()\n        aura_env.ticker = nil\n    end\nend",
},
["finish"] = {
},
},
