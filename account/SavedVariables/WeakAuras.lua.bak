["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["subeventSuffix"] = "_CAST_START",
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event)\n    if event == \"OPTIONS\" then\n        for i = 1,3 do\n            allstates[i] = {\n                show = true,\n                changed = true,\n                name = UnitName(\"player\"),\n                index = i,\n            }\n        end\n        return true\n    elseif event == \"WA_DELAYED_PLAYER_ENTERING_WORLD\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 0.1,\n            expirationTime = GetTime() + 0.1,\n            autoHide = true\n        }\n        \n        return true\n    end\nend",
