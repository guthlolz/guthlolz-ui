["desc"] = "",
["icon_side"] = "LEFT",
["zoom"] = 0.32,
["anchorFrameFrame"] = "WeakAuras:[HOF][Garalon] Pheromones List",
["anchorFrameParent"] = false,
["displayText_format_location_pad"] = false,
["actions"] = {
["start"] = {
["do_custom"] = false,
["do_message"] = false,
["custom"] = "",
},
["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.saved = aura_env.saved or {}\naura_env.saved.teams = aura_env.saved.teams or {}\naura_env.LOCATIONS = { \"S\", \"W\", \"NE\", \"NW\", \"E\" }\n\nfunction aura_env.updateState(allstates)\n    local teams = aura_env.saved and aura_env.saved.teams\n    if type(teams) == \"table\" then\n        for _, team in pairs(teams) do\n            if type(team) == \"table\" then\n                for _, savedGuid in ipairs(team) do\n                    local found = false\n                    for unit in WA_IterateGroupMembers() do\n                        if UnitGUID(unit) == savedGuid then\n                            found = true\n                            break\n                        end\n                    end\n                    if not found then\n                        aura_env.saved.marks = nil\n                        aura_env.saved.teams = nil\n                        \n                        for _, state in pairs(allstates) do\n                            state.show = false\n                            state.changed = true\n                        end\n                        return true\n                    end\n                end\n            end\n        end\n    end\n    \n    for i = 1, 5 do\n        if allstates[i] then\n            allstates[i].show = false\n            allstates[i].changed = true\n        end\n    end\n    \n    local marks = aura_env.saved.marks\n    if type(marks) ~= \"table\" or #marks == 0 then\n        return false\n    end\n    \n    for i = 1, 5 do\n        local m = marks[i]\n        if m then\n            allstates[i] = allstates[i] or {}\n            allstates[i].show = true\n            allstates[i].changed = true\n            allstates[i].markIndex = m\n            allstates[i].mark = \"{rt\" .. m .. \"}\"\n            allstates[i].location = aura_env.LOCATIONS[i]\n        end\n    end\n    \n    return true\nend",
},
["finish"] = {
