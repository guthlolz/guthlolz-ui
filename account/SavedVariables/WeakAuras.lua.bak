ld (Rank 10)\n    [27607] = 941, -- [Priest] Power Word: Shield (Rank 10)\n    [592] = 87, -- [Priest] Power Word: Shield (Rank 2)\n    [600] = 157, -- [Priest] Power Word: Shield (Rank 3)\n    [3747] = 233, -- [Priest] Power Word: Shield (Rank 4)\n    [6065] = 300, -- [Priest] Power Word: Shield (Rank 5)\n    [6066] = 380, -- [Priest] Power Word: Shield (Rank 6)\n    [10898] = 483, -- [Priest] Power Word: Shield (Rank 7)\n    [10899] = 604, -- [Priest] Power Word: Shield (Rank 8)\n    [10900] = 762, -- [Priest] Power Word: Shield (Rank 9)\n    [20706] = 499, -- [Priest] Power Word: Shield 500 (Rank 7)\n    [25217] = 1144, -- [Priest] Power Word: Shield (Rank 11)\n    [25218] = 1265, -- [Priest] Power Word: Shield (Rank 12)\n    [17740] = 119, -- [Mage] Mana Shield\n    [17741] = 119, -- [Mage] Mana Shield\n    [1463] = 119, -- [Mage] Mana Shield (Rank 1)\n    [8494] = 209, -- [Mage] Mana Shield (Rank 2)\n    [8495] = 299, -- [Mage] Mana Shield (Rank 3)\n    [10191] = 389, -- [Mage] Mana Shield (Rank 4)\n    [10192] = 479, -- [Mage] Mana Shield (Rank 5)\n    [10193] = 569, -- [Mage] Mana Shield (Rank 6)\n    [27131] = 715, -- [Mage] Mana Shield (Rank 7)\n    [15041] = 119, -- [Mage] Fire Ward\n    [543] = 165, -- [Mage] Fire Ward (Rank 1)\n    [8457] = 289, -- [Mage] Fire Ward (Rank 2)\n    [8458] = 469, -- [Mage] Fire Ward (Rank 3)\n    [10223] = 674, -- [Mage] Fire Ward (Rank 4)\n    [10225] = 919, -- [Mage] Fire Ward (Rank 5)\n    [27128] = 1125, -- [Mage] Fire Ward (Rank 6)\n    [15044] = 119, -- [Mage] Frost Ward\n    [6143] = 164, -- [Mage] Frost Ward (Rank 1)\n    [8461] = 289, -- [Mage] Frost Ward (Rank 2)\n    [8462] = 469, -- [Mage] Frost Ward (Rank 3)\n    [10177] = 674, -- [Mage] Frost Ward (Rank 4)\n    [28609] = 919, -- [Mage] Frost Ward (Rank 5)\n    [32796] = 1125, -- [Mage] Frost Ward (Rank 6)\n    [11426] = 437, -- [Mage] Ice Barrier (Rank 1)\n    [13031] = 548, -- [Mage] Ice Barrier (Rank 2)\n    [13032] = 677, -- [Mage] Ice Barrier (Rank 3)\n    [13033] = 817, -- [Mage] Ice Barrier (Rank 4)\n    [27134] = 952, -- [Mage] Ice Barrier (Rank 5)\n    [33405] = 1075, -- [Mage] Ice Barrier (Rank 6)\n    [26470] = 0, -- [Mage] Persistent Shield\n    [17729] = 649, -- [Warlock] Greater Spellstone\n    [17730] = 899, -- [Warlock] Major Spellstone\n    [128] = 399, -- [Warlock] Spellstone\n    [7812] = 304, -- [Warlock] Sacrifice (Rank 1)\n    [19438] = 509, -- [Warlock] Sacrifice (Rank 2)\n    [19440] = 769, -- [Warlock] Sacrifice (Rank 3)\n    [19441] = 1094, -- [Warlock] Sacrifice (Rank 4)\n    [19442] = 1469, -- [Warlock] Sacrifice (Rank 5)\n    [19443] = 1904, -- [Warlock] Sacrifice (Rank 6)\n    [27273] = 2900, -- [Warlock] Sacrifice (Rank 7)\n}\n\nfunction aura_env.COMBAT_LOG_EVENT_UNFILTERED(allStates, ...)\n    local _, subEvent, _, _, _, _, _, destGUID = ...\n    \n    if destGUID ~= WeakAuras.myGUID then\n        return false\n    end\n    \n    if subEvent == \"SPELL_AURA_REMOVED\" then\n        local spellId = select(12, ...)\n        if aura_env.absorbSpells[spellId] then\n            WeakAuras.ScanEvents(\"WA_FJI_ABSORB_REMOVED\", spellId)\n        end\n        return\n    end\n    \n    if subEvent == \"SPELL_AURA_APPLIED\" or subEvent == \"SPELL_AURA_REFRESH\" then\n        local spellId = select(12, ...)\n        if aura_env.absorbSpells[spellId] then\n            WeakAuras.ScanEvents(\"WA_FJI_ABSORB_APPLIED\", aura_env.absorbSpells[spellId], spellId)\n        end\n        return\n    end\n    \n    if subEvent == \"SPELL_ABSORBED\" then\n        local spellId, amount\n        \n        if select(20, ...) then -- SPELL_DAMAGE\n            spellId = select(19, ...)\n            amount = select(22, ...) or 0\n        else\n            spellId = select(16, ...) -- SWING_DAMAGE\n            amount = select(19, ...) or 0\n        end\n        \n        if aura_env.absorbSpells[spellId] then\n            WeakAuras.ScanEvents(\"WA_FJI_ABSORB_UPDATE\", amount, spellId)\n        end\n    end\nend\n\n\nfunction aura_env.OPTIONS(allStates)\n    return\nend\n\nfunction aura_env.STATUS(allStates)\n    for i = 1, 255 do\n        local _,_,_,_,_,_,_,_,_,spellId = UnitBuff(\"player\", i)\n        if aura_env.absorbSpells[spellId] then\n            WeakAuras.ScanEvents(\"WA_FJI_ABSORB_APPLIED\", aura_env.absorbSpells[spellId], spellId)\n        end\n    end\nend\n\n\n\n",
["do_custom"] = true,
},
},
