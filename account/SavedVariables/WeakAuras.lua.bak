["FT: Unequipped Trinket ICD/CDs"] = {
["iconSource"] = -1,
["wagoID"] = "Z4Pm4SgBU",
["parent"] = "Fojji - ICDs / CDs",
["adjustedMax"] = "",
["adjustedMin"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["cooldownSwipe"] = true,
["cooldownEdge"] = false,
["icon"] = true,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["customVariables"] = "{\nexpirationTime = true,\n}",
["event"] = "Health",
["unit"] = "player",
["subeventSuffix"] = "_CAST_START",
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        for i = 1, 4 do\n            allstates[i] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = 45,\n                expirationTime = GetTime() + 45,\n                autoHide = true,\n                icon = 133720,\n            }\n        end\n        return true\n    end\n    \n    if event == \"STATUS\" then\n        for itemId, data in pairs(aura_env.saved.trinketTimers) do\n            if aura_env.isEquipped(itemId) then\n                aura_env.hideState(allstates, itemId)\n            else\n                aura_env.showState(allstates, itemId, data)\n            end\n        end\n        return true\n    end\n    \n    if event == \"PLAYER_EQUIPMENT_CHANGED\" then\n        local slot = ...\n        if slot ~= INVSLOT_TRINKET1 and slot ~= INVSLOT_TRINKET2 then\n            return\n        end\n        \n        for itemId, data in pairs(aura_env.saved.trinketTimers) do\n            if aura_env.isEquipped(itemId) then\n                aura_env.hideState(allstates, itemId)\n            else\n                aura_env.showState(allstates, itemId, data)\n            end\n        end\n        \n        return true\n    end\n    \n    if event ~= \"WA_FJI_TRINKET_TRACKER\" then\n        return\n    end\n    \n    local itemId, procId, duration = ...\n    \n    if not itemId or not duration or duration <= 0 then\n        return\n    end\n    \n    local now = GetTime()\n    local endTime = now + duration\n    \n    aura_env.saved.trinketTimers[itemId] = {\n        endTime = endTime,\n        procId = procId,\n    }\n    \n    if aura_env.isEquipped(itemId) then\n        aura_env.hideState(allstates, itemId)\n        return true\n    end\n    \n    aura_env.showState(allstates, itemId, aura_env.saved.trinketTimers[itemId])\n    return true\nend",
["names"] = {
},
["check"] = "event",
["events"] = "WA_DELAYED_PLAYER_ENTERING_WORLD STATUS PLAYER_EQUIPMENT_CHANGED WA_FJI_TRINKET_TRACKER",
