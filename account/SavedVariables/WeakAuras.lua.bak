["events"] = "WA_COILSKAR_PROD_TARGET, WA_COILSKAR_WRANGLER_DIED",
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 2.995,\n            expirationTime = GetTime() + 2.995,\n            autoHide = true,\n            icon = 135600\n        }\n        return true\n    end\n    \n    if event == \"WA_COILSKAR_WRANGLER_DIED\" then\n        local guid = ...\n        if allstates[guid] then\n            allstates[guid].show = false\n            allstates[guid].changed = true\n            return true\n        end\n    end\n    \n    if event == \"WA_COILSKAR_PROD_TARGET\" then\n        local guid,_,srcGUID = ...\n        if guid ~= WeakAuras.myGUID then\n            return false\n        end\n        \n        allstates[srcGUID] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 2.995,\n            expirationTime = GetTime() + 2.995,\n            autoHide = true,\n            icon = 135600,\n        }\n        return true\n    end\nend",
