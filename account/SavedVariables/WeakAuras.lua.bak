["subeventPrefix"] = "SPELL",
["unit"] = "player",
["custom"] = "function(allstates, event, msg)\n    if event == \"OPTIONS\" then\n        local mark = 5\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            mark = mark\n        }\n        return true\n    end\n    \n    if event == \"WA_FJI_MAGTHERIDON_KILLED\" then\n        for _, state in pairs(allstates) do\n            state.show = false\n            state.changed = true\n        end\n        aura_env.saved.mark = nil\n        return true\n    end\n    \n    if event == \"STATUS\" then\n        return aura_env.updateState(allstates)\n    end\n    \n    if event ~= \"CHAT_MSG_RAID_LEADER\" or type(msg) ~= \"string\" then\n        return false\n    end\n    \n    if not msg:match(\"^%{rt%d%}\") then\n        return false\n    end\n    \n    local first, second, third, fourth, fifth = msg:match(\"^%{rt(%d)%}%{rt(%d)%}%{rt(%d)%}%{rt(%d)%}%{rt(%d)%}\")\n    local mark = tonumber(fourth)\n    if not mark or mark < 1 or mark > 8 then\n        return false\n    end\n    \n    aura_env.saved.mark = mark\n    return aura_env.updateState(allstates)\nend",
["events"] = "CHAT_MSG_RAID_LEADER STATUS WA_FJI_MAGTHERIDON_KILLED",
["customVariables"] = "{\n    mark = \"number\",\n}",
