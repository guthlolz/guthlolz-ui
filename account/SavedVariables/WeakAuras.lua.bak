["spellIds"] = {
},
["custom"] = "function(allstates, event)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 5,\n            expirationTime = GetTime() + 5,\n            progressType = \"timed\",\n            icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\illidan.jpg\",\n            autoHide = true,\n        }\n        return true\n    end\n    \n    if event == \"WA_ILLIDAN_P2_START\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 5,\n            expirationTime = GetTime() + 5,\n            progressType = \"timed\",\n            icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\illidan.jpg\",\n            autoHide = true,\n        }\n        return true\n    end\nend",
