},
["sparkWidth"] = 10,
["displayText_format_p_time_dynamic_threshold"] = 0,
["displayText_format_name_pad_mode"] = "left",
["actions"] = {
["start"] = {
},
["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.encounterActive = false\naura_env.encounterID = 606\naura_env.teamIndex = 2\n\naura_env.teamPlayers = {}\naura_env.petOwners = {}\n\naura_env.interruptCDs = {\n    -- Rogue: Kick\n    [1766] = 10,\n    [1767] = 10,\n    [1768] = 10,\n    [1769] = 10,\n    [38768] = 10,\n    \n    -- Warrior: Pummel\n    [6552] = 10,\n    [6554] = 10,\n    \n    -- Warrior: Shield Bash\n    [72] = 12,\n    [1671] = 12,\n    [1672] = 12,\n    [29704] = 12,\n    \n    -- Mage: Counterspell\n    [2139] = 24,\n    \n    -- Shaman: Earth Shock\n    [8042] = 6,\n    [8044] = 6,\n    [8045] = 6,\n    [8046] = 6,\n    [10412] = 6,\n    [10413] = 6,\n    [10414] = 6,\n    [25454] = 6,\n    \n    -- Druid: Feral Charge\n    [16979] = 15,\n    \n    -- Warlock Felhunter: Spell Lock\n    [19244] = 24,\n    [19647] = 24,\n}\n\nfunction aura_env.UpdatePetOwners()\n    wipe(aura_env.petOwners)\n    \n    for i = 1, 40 do\n        local ownerUnit = \"raid\" .. i\n        local petUnit = \"raidpet\" .. i\n        \n        local ownerName = UnitName(ownerUnit)\n        local petGUID = UnitGUID(petUnit)\n        \n        if ownerName and petGUID then\n            aura_env.petOwners[petGUID] = ownerName\n        end\n    end\nend\n\nfunction aura_env.HideStates(states)\n    for _, state in pairs(states) do\n        state.show = false\n        state.changed = true\n    end\n    \n    return true\nend\n\nfunction aura_env.Reset(states)\n    aura_env.encounterActive = false\n    \n    wipe(aura_env.teamPlayers)\n    wipe(aura_env.petOwners)\n    \n    return aura_env.HideStates(states)\nend",
},
["finish"] = {
},
},
