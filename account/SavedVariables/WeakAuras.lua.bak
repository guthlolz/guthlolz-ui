["event"] = "Chat Message",
["unit"] = "player",
["custom"] = "function(allstates, event, ...)\n    if event == \"CHAT_MSG_MONSTER_YELL\" then\n        local msg = ...\n        \n        if msg and (msg:find(aura_env.currentLocale.jainaDeath) or msg == aura_env.currentLocale.jainaDeath) then\n            aura_env.startTimer()\n            aura_env.showState(allstates)\n            _G.SyncEvents(\"RAID\", nil, \"WA_FJI_HYJAL_JAINA_DEATH\")\n            return true\n        end\n    end\n    \n    if event == \"WA_FJI_HYJAL_JAINA_DEATH\" then\n        if aura_env.hasActiveTimer() or allstates[\"\"] then\n            return false\n        end\n        \n        aura_env.startTimer()\n        return aura_env.showState(allstates)\n    end\n    \n    if event == \"STATUS\" then\n        return aura_env.showState(allstates)\n    end\nend",
