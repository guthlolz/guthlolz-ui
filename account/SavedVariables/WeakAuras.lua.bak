["events"] = "CLEU:SPELL_CAST_START:SPELL_INTERRUPT:SPELL_CAST_SUCCESS, NAME_PLATE_UNIT_ADDED, NAME_PLATE_UNIT_REMOVED, RAID_TARGET_UPDATE, WA_PRIESTESS_MARKS_UPDATED",
