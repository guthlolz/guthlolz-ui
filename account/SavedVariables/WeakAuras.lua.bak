},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates,event,eID,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId)\n    if event == \"WA_FJI_ENCOUNTER_START\" or event == \"ENCOUNTER_START\" then\n        if eID ~= 626 then\n            return false\n        end\n        \n        aura_env.updateState(allstates)\n        aura_env.count = 1\n        return true\n    elseif event == \"WA_FJI_ENCOUNTER_END\" or event == \"ENCOUNTER_END\" then\n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        return true\n        \n    elseif event == \"WA_KARATHRESS_SHARKKIS_DIED\" then\n        aura_env.preWarn(aura_env.cdStart, 4, aura_env.count)\n        aura_env.nuTimer(aura_env.cdStart, aura_env.count)\n        return true\n    end\n    \n    if spellId ~= aura_env.beastWithin then\n        return false\n    end\n    \n    if subEvent == \"SPELL_AURA_APPLIED\" then\n        local npcID = select(6, strsplit(\"-\", destGUID))\n        \n        if npcID == \"21965\" then\n            WeakAuras.ScanEvents(\"WA_KARATHRESS_BEAST_WITHIN_ADD\")\n            return true\n        end\n        \n        if npcID == \"21214\" then\n            aura_env.nuTimer(0, aura_env.count)\n            aura_env.count = aura_env.count + 1\n            aura_env.preWarn(aura_env.cdWindow, 4, aura_env.count)\n            aura_env.nuTimer(aura_env.cdWindow, aura_env.count)\n            return true\n        end\n    end\nend",
["spellIds"] = {
},
["events"] = "ENCOUNTER_START, ENCOUNTER_END, WA_FJI_ENCOUNTER_END, WA_FJI_ENCOUNTER_START, CLEU:SPELL_AURA_APPLIED, WA_KARATHRESS_SHARKKIS_DIED",
