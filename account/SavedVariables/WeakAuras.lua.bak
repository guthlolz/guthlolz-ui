["parent"] = "Pretty Tankadin 2",
["customText"] = "function()\n    local dodge = GetDodgeChance()\n    local parry = GetParryChance()\n    local block = GetBlockChance()\n    \n    -- Illidan ignores Miss entirely — only dodge+parry+block counts\n    local illy    = dodge + parry + block\n    local crushCap = 102.4\n    \n    if illy >= crushCap then\n        return string.format(\"|cff00ff00%.2f / 102.4|r\", illy)\n    elseif illy >= 101.8 then\n        -- some versions of the check use 101.8\n        return string.format(\"|cff00ff00%.2f / 102.4|r\", illy)\n    else\n        return string.format(\"|cffff0000%.2f / 102.4|r\", illy)\n    end\nend",
