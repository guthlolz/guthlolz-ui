},
["sameTexture"] = true,
["url"] = "https://wago.io/FojjiT5RaidPack/3",
["actions"] = {
["start"] = {
},
["finish"] = {
},
["init"] = {
["custom"] = "aura_env.tickers = {}\naura_env.expirationTime = {}\naura_env.duration = {}\n\nfunction aura_env.startTicker(unit, guid, duration, iterations)\n    if not unit or aura_env.tickers[unit] then return end\n    \n    local iterations = iterations\n    local updatesPerSecond = 10\n    local interval = 1 / updatesPerSecond\n    local endTime = GetTime() + duration\n    \n    aura_env.tickers[unit] = C_Timer.NewTicker(interval, function()\n            local now = GetTime()\n            if now > endTime then\n                if aura_env.tickers[unit] then\n                    aura_env.tickers[unit]:Cancel()\n                    aura_env.tickers[unit] = nil\n                end\n                return\n            end\n            \n            if UnitExists(unit) then\n                local range = WeakAuras.GetRange(unit)\n                local safe = range and range >= 5\n                WeakAuras.ScanEvents(\"WA_DEVASTATION_WW_UPDATE\", guid, safe)\n            end\n    end, iterations)\nend",
["do_custom"] = true,
},
},
["selfPoint"] = "CENTER",
["desaturate"] = false,
["rotation"] = 0,
["font"] = "Friz Quadrata TT",
["crop_y"] = 0.41,
["textureWrapMode"] = "CLAMPTOBLACKADDITIVE",
["startAngle"] = 0,
["useAdjustededMin"] = false,
["regionType"] = "progresstexture",
["blendMode"] = "BLEND",
["slantMode"] = "INSIDE",
["texture"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Auras\\Aura72",
["compress"] = false,
["alpha"] = 1,
["uid"] = "tPpht2LXH1R",
["backgroundOffset"] = 2,
["wagoID"] = "gSs1_GQRl",
["parent"] = "[T5]: Nameplates",
["customText"] = "\n\n",
["desaturateBackground"] = false,
["customTextUpdate"] = "event",
["desaturateForeground"] = false,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            autoHide = true,\n        }\n        return true\n    end\n    \n    if event == \"NAME_PLATE_UNIT_ADDED\" then\n        local unit = ...\n        local guid = UnitGUID(unit)\n        if not guid then\n            return\n        end\n        \n        local expiration = aura_env.expirationTime and aura_env.expirationTime[guid]\n        local duration = aura_env.duration and aura_env.duration[guid]\n        if expiration and duration and expiration > GetTime() then\n            allstates[unit] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = duration,\n                expirationTime = expiration,\n                autoHide = true,\n                unit = unit,\n            }\n            return true\n        end\n    end\n    \n    if event == \"NAME_PLATE_UNIT_REMOVED\" then\n        local unit = ...\n        if allstates[unit] then\n            allstates[unit].show = false\n            allstates[unit].changed = true\n        end\n        return true\n    end\n    \n    if event == \"WA_DEVASTATION_WW\" then\n        local srcGUID = ...\n        local duration = 6\n        local expiration = GetTime() + duration\n        \n        aura_env.duration[srcGUID] = duration\n        aura_env.expirationTime[srcGUID] = expiration\n        \n        for _, plate in pairs(C_NamePlate.GetNamePlates()) do\n            local unit = plate.UnitFrame and plate.UnitFrame.displayedUnit\n            local guid = unit and UnitGUID(unit)\n            if guid == srcGUID then\n                allstates[unit] = {\n                    show = true,\n                    changed = true,\n                    progressType = \"timed\",\n                    duration = duration,\n                    expirationTime = expiration,\n                    autoHide = true,\n                    unit = unit,\n                }\n                aura_env.startTicker(unit, guid, duration, 60)\n                return true\n            end\n        end\n    end\n    \n    if event == \"WA_DEVASTATION_WW_UPDATE\" then\n        local guid, safe = ...\n        for unit, state in pairs(allstates) do\n            if UnitGUID(unit) == guid then\n                if state.safe ~= safe then\n                    state.safe = safe\n                    state.changed = true\n                    return true\n                end\n            end\n        end\n    end\n    \n    if event == \"WA_DEVASTATION_WW_DIED\" then\n        local destGUID = ...\n        aura_env.duration[destGUID] = nil\n        aura_env.expirationTime[destGUID] = nil\n        \n        for unit, state in pairs(allstates) do\n            if UnitGUID(unit) == destGUID then\n                if aura_env.tickers[unit] then\n                    aura_env.tickers[unit]:Cancel()\n                    aura_env.tickers[unit] = nil\n                end\n                state.show = false\n                state.changed = true\n            end\n        end\n        return true\n    end\nend",
["spellIds"] = {
},
["events"] = "NAME_PLATE_UNIT_ADDED NAME_PLATE_UNIT_REMOVED WA_DEVASTATION_WW WA_DEVASTATION_WW_DIED WA_DEVASTATION_WW_UPDATE",
