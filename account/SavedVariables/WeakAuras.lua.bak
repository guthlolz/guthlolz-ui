},
{
["trigger"] = {
["auranames"] = {
"34775",
},
["subeventPrefix"] = "SPELL",
["customIcon"] = "function()\n    return aura_env.icon\nend",
["debuffType"] = "HELPFUL",
["names"] = {
},
["type"] = "custom",
["custom_type"] = "status",
["subeventSuffix"] = "_CAST_START",
["auraspellids"] = {
"34775",
},
["useName"] = false,
["event"] = "Health",
["customStacks"] = "function()\n    return aura_env.stacks\nend",
["customDuration"] = "function()\n    return aura_env.duration, aura_env.expirationTime\nend",
["custom"] = "function(event, ...)\n    local timestamp, subEvent, _, sourceGUID, sourceName, sourceFlags, sourceRaidFlags, \n    destGUID, destName, destFlags, destRaidFlags, spellId, spellName = CombatLogGetCurrentEventInfo()\n    \n    if destGUID ~= UnitGUID(\"player\") then\n        return false\n    end\n    \n    if subEvent ~= \"SPELL_AURA_APPLIED\" then\n        return false\n    end\n    \n    if spellId ~= aura_env.trinketBuffId then\n        return false\n    end\n    local icd = aura_env.icd[aura_env.trinketItemId]\n    if icd then\n        aura_env.duration = icd\n        aura_env.expirationTime = GetTime() + icd\n        aura_env.icon = GetItemIcon(aura_env.trinketItemId)\n        \n        return true\n    end\n    \n    return false\nend",
["spellIds"] = {
},
["events"] = "CLEU:SPELL_AURA_APPLIED",
["check"] = "event",
["unit"] = "player",
["useExactSpellId"] = true,
["useIgnoreName"] = false,
},
["untrigger"] = {
["custom"] = "function()\n    -- Untrigger when ICD expires\n    if aura_env.expirationTime and GetTime() >= aura_env.expirationTime then\n        return true\n    end\n    \n    return false\nend",
},
