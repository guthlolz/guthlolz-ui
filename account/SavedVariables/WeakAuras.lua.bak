["CT:[T5][Kaelthas] Capernian Range"] = {
["outline"] = "OUTLINE",
["wagoID"] = "gSs1_GQRl",
["color"] = {
1,
1,
1,
1,
},
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["shadowYOffset"] = -1,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiT5RaidPack/3",
["actions"] = {
["start"] = {
},
["finish"] = {
},
["init"] = {
["custom"] = "aura_env.npcID = \"20062\"\naura_env.active = false\n\nfunction aura_env.getNpcID(unit)\n    local guid = UnitGUID(unit)\n    return guid and select(6, strsplit(\"-\", guid))\nend\n\nfunction aura_env.findUnit()\n    if UnitExists(\"target\") and aura_env.getNpcID(\"target\") == aura_env.npcID then\n        return \"target\"\n    end\n    \n    for _, plate in pairs(C_NamePlate.GetNamePlates()) do\n        local unit = plate.UnitFrame and plate.UnitFrame.displayedUnit\n        if unit and UnitExists(unit) and aura_env.getNpcID(unit) == aura_env.npcID then\n            return unit\n        end\n    end\nend\n\nfunction aura_env.stopTicker()\n    if aura_env.rangeTicker then\n        aura_env.rangeTicker:Cancel()\n        aura_env.rangeTicker = nil\n    end\n    WeakAuras.ScanEvents(\"WA_CAPERNIAN_RANGE_UPDATE\", nil)\nend\n\nfunction aura_env.startTicker()\n    if aura_env.rangeTicker then\n        return\n    end\n    \n    aura_env.rangeTicker = C_Timer.NewTicker(0.2, function()\n            local unit = aura_env.findUnit()\n            if not unit then\n                aura_env.stopTicker()\n                return\n            end\n            \n            local range = WeakAuras.GetRange(unit)\n            WeakAuras.ScanEvents(\"WA_CAPERNIAN_RANGE_UPDATE\", range)\n    end)\nend\n\nfunction aura_env.updateTicker()\n    if not aura_env.active then\n        aura_env.stopTicker()\n        return\n    end\n    \n    local unit = aura_env.findUnit()\n    if unit then\n        aura_env.startTicker()\n    else\n        aura_env.stopTicker()\n    end\nend",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        aura_env.active = false\n        aura_env.stopTicker()\n        return false\n    end\n    \n    if event == \"WA_NUMEN_TIMER\" then\n        local key, time = ...\n        if key == \"KAELTHAS_CAPERNIAN_ENGAGE\" and time == 0 then\n            aura_env.active = true\n            aura_env.updateTicker()\n        end\n        return false\n    end\n    \n    if event == \"WA_KAELTHAS_P3_START\" then\n        aura_env.active = true\n        aura_env.updateTicker()\n        return false\n    end\n    \n    if event == \"PLAYER_TARGET_CHANGED\" or event == \"NAME_PLATE_UNIT_ADDED\" or event == \"NAME_PLATE_UNIT_REMOVED\" then\n        aura_env.updateTicker()\n        return false\n    end\n    \n    if event == \"WA_FJI_ENCOUNTER_END\" or event == \"ENCOUNTER_END\" or event == \"WA_KAELTHAS_CAPERNIAN_DIED\" or event == \"WA_KAELTHAS_P5_START\" then\n        aura_env.active = false\n        aura_env.stopTicker()\n        return false\n    end\n    \n    return false\nend",
["spellIds"] = {
},
["events"] = "NAME_PLATE_UNIT_ADDED NAME_PLATE_UNIT_REMOVED WA_NUMEN_TIMER WA_KAELTHAS_P3_START WA_KAELTHAS_P5_START WA_KAELTHAS_CAPERNIAN_DIED PLAYER_TARGET_CHANGED",
["check"] = "event",
["unit"] = "player",
["custom_hide"] = "timed",
["customVariables"] = "{\n    safe = \"bool\",\n}",
},
