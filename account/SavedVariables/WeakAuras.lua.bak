["CT:[BT][Reliquary] Deaden"] = {
["outline"] = "OUTLINE",
["wagoID"] = "pbbuhQ899",
["parent"] = "[BT][Reliquary]",
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiBT-P1/12",
["actions"] = {
["start"] = {
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.debug = false\naura_env.key = \"RELIQUARY_DEADEN\"\naura_env.count = 1\naura_env.cdStart = 26.7\naura_env.cdWindow = 31\naura_env.preWarnTime = 4\naura_env.throttle = 0\n\naura_env.spellName = \"Deaden\"\naura_env.spellID = 41410\naura_env.encounterID = 606\naura_env.npcID = \"23419\"\n\naura_env.defaultCastTime = 1\naura_env.castTime = aura_env.defaultCastTime\n\naura_env.castSpeedSpell = 41431\naura_env.castSpeedMultiplier = 2\naura_env.castSpeedActive = false\n\naura_env.castSlows = {\n    [1714] = 1.5,\n    [11719] = 1.6,\n    [5760] = 1.4,\n    [8692] = 1.5,\n    [11398] = 1.6,\n}\n\naura_env.activeCastSlows = {}\n\naura_env.pullStart = nil\naura_env.lastCast = nil\n\nfunction aura_env.debugPrint(message)\n    if aura_env.debug then\n        print(message)\n    end\nend\n\nfunction aura_env.nuTimer(countdown,count)\n    WeakAuras.ScanEvents(\"WA_NUMEN_TIMER\",aura_env.key,countdown,count)\nend\n\nfunction aura_env.updateState(allstates)\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n    }\nend\n\nfunction aura_env.hideState(allstates)\n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\nend\n\nfunction aura_env.preWarn(duration,preWarnTime,count)\n    preWarnTime = preWarnTime or 3\n    \n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\n    \n    aura_env.preWarnTimer = C_Timer.NewTimer(duration-preWarnTime,function()\n            WeakAuras.ScanEvents(\"WA_\"..aura_env.key..\"_PREWARN\",preWarnTime,count)\n            aura_env.preWarnTimer = nil\n    end)\nend\n\nfunction aura_env.preWarnCancel()\n    WeakAuras.ScanEvents(\"WA_\"..aura_env.key..\"_PREWARN_CANCEL\")\n    \n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\nend\n\nfunction aura_env.UpdateCastTime()\n    local slowMultiplier = 1\n    \n    for spellId in pairs(aura_env.activeCastSlows) do\n        local slow = aura_env.castSlows[spellId]\n        if slow and slow > slowMultiplier then\n            slowMultiplier = slow\n        end\n    end\n    \n    local speedMultiplier = aura_env.castSpeedActive and aura_env.castSpeedMultiplier or 1\n    aura_env.castTime = aura_env.defaultCastTime*slowMultiplier/speedMultiplier\nend\n\nfunction aura_env.ResetCastTime()\n    aura_env.castTime = aura_env.defaultCastTime\n    aura_env.castSpeedActive = false\n    wipe(aura_env.activeCastSlows)\nend\n\nfunction aura_env.GetNPCID(guid)\n    if not guid then\n        return\n    end\n    return select(6,strsplit(\"-\",guid))\nend\n\nfunction aura_env.unitTargetScan(sourceGUID)\n    local unit = \"target\"\n    if UnitExists(unit) and UnitGUID(unit) == sourceGUID then\n        return unit\n    end\n    \n    unit = \"focus\"\n    if UnitExists(unit) and UnitGUID(unit) == sourceGUID then\n        return unit\n    end\n    \n    for i = 1,40 do\n        unit = \"nameplate\"..i\n        if UnitExists(unit) and UnitGUID(unit) == sourceGUID then\n            return unit\n        end\n    end\n    \n    for grpUnit in WA_IterateGroupMembers() do\n        unit = grpUnit..\"target\"\n        if UnitExists(unit) and UnitGUID(unit) == sourceGUID then\n            return unit\n        end\n    end\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "aura_env.count = 1\naura_env.nuTimer(nil)\naura_env.preWarnCancel()\naura_env.pullStart = nil\naura_env.lastCast = nil",
["do_sound"] = false,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
["do_message"] = false,
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "ENCOUNTER_START, ENCOUNTER_END, WA_FJI_ENCOUNTER_END, WA_FJI_ENCOUNTER_START, CLEU:SPELL_CAST_START:SPELL_INTERRUPT:SPELL_CAST_SUCCESS:SPELL_AURA_APPLIED:SPELL_AURA_REFRESH:SPELL_AURA_REMOVED, WA_RELIQUARY_PHASE_END, WA_RELIQUARY_P2_START",
["spellIds"] = {
},
["custom"] = "function(allstates,event,eID,subEvent,_,sourceGUID,sourceName,_,_,destGUID,destName,destFlags,_,spellId,_,_,extraSpellId)\n    if event == \"WA_FJI_ENCOUNTER_START\" or event == \"ENCOUNTER_START\" then\n        if eID ~= aura_env.encounterID then\n            return false\n        end\n        \n        aura_env.pullStart = GetTime()\n        aura_env.lastCast = nil\n        aura_env.ResetCastTime()\n        \n        aura_env.updateState(allstates)\n        aura_env.count = 1\n        return true\n    elseif event == \"WA_RELIQUARY_P2_START\" then\n        aura_env.preWarn(aura_env.cdStart,aura_env.preWarnTime,aura_env.count)\n        aura_env.nuTimer(aura_env.cdStart,aura_env.count)\n        return true\n    elseif event == \"WA_FJI_ENCOUNTER_END\" or event == \"ENCOUNTER_END\" or event == \"WA_RELIQUARY_PHASE_END\" then\n        aura_env.pullStart = nil\n        aura_env.lastCast = nil\n        aura_env.ResetCastTime()\n        \n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        return false\n    end\n    \n    if subEvent == \"SPELL_AURA_APPLIED\" or subEvent == \"SPELL_AURA_REFRESH\" or subEvent == \"SPELL_AURA_REMOVED\" then\n        if aura_env.GetNPCID(destGUID) == aura_env.npcID then\n            if spellId == aura_env.castSpeedSpell then\n                if subEvent == \"SPELL_AURA_APPLIED\" or subEvent == \"SPELL_AURA_REFRESH\" then\n                    aura_env.castSpeedActive = true\n                else\n                    aura_env.castSpeedActive = false\n                end\n                \n                aura_env.UpdateCastTime()\n                return false\n            end\n            \n            if aura_env.castSlows[spellId] then\n                if subEvent == \"SPELL_AURA_APPLIED\" or subEvent == \"SPELL_AURA_REFRESH\" then\n                    aura_env.activeCastSlows[spellId] = true\n                else\n                    aura_env.activeCastSlows[spellId] = nil\n                end\n                \n                aura_env.UpdateCastTime()\n                return false\n            end\n        end\n    end\n    \n    if subEvent == \"SPELL_INTERRUPT\" then\n        if extraSpellId == aura_env.spellID then\n            WeakAuras.ScanEvents(\"WA_RELIQUARY_DEADEN_INTERRUPT\",sourceName)\n        end\n        return false\n    end\n    \n    if spellId ~= aura_env.spellID then\n        return false\n    end\n    \n    if subEvent == \"SPELL_CAST_START\" then\n        WeakAuras.ScanEvents(\"WA_RELIQUARY_DEADEN_CAST\",aura_env.castTime)\n        \n        local now = GetTime()\n        \n        if aura_env.lastCast then\n            aura_env.debugPrint(string.format(\"Next %s (%d): %.1fs after previous.\",aura_env.spellName,aura_env.count,now-aura_env.lastCast))\n        elseif aura_env.pullStart then\n            aura_env.debugPrint(string.format(\"First %s (%d): %.1fs into pull.\",aura_env.spellName,aura_env.count,now-aura_env.pullStart))\n        end\n        \n        aura_env.lastCast = now\n        \n        C_Timer.After(0.05,function()\n                local unit = aura_env.unitTargetScan(sourceGUID)\n                if not unit then\n                    return\n                end\n                \n                local target = unit..\"target\"\n                if not UnitExists(target) then\n                    return\n                end\n                \n                WeakAuras.ScanEvents(\"WA_RELIQUARY_DEADEN_TARGET\",UnitGUID(target),UnitName(target))\n        end)\n        \n        aura_env.nuTimer(0,aura_env.count)\n        aura_env.count = aura_env.count+1\n        aura_env.preWarn(aura_env.cdWindow,aura_env.preWarnTime,aura_env.count)\n        aura_env.nuTimer(aura_env.cdWindow,aura_env.count)\n        return false\n    elseif subEvent == \"SPELL_CAST_SUCCESS\" then\n        WeakAuras.ScanEvents(\"WA_RELIQUARY_DEADEN_SUCCESS\")\n        return false\n    end\n    \n    return false\nend",
["check"] = "event",
["subeventPrefix"] = "SPELL",
["custom_hide"] = "timed",
["debuffType"] = "HELPFUL",
},
