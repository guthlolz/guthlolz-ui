["SW:[MH][Anetheron] Inferno PreWarn"] = {
["authorOptions"] = {
},
["displayText_format_p_time_dynamic_threshold"] = 10,
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_c_abbreviate_max"] = 8,
["displayText_format_p_time_format"] = 0,
["url"] = "https://wago.io/FojjiHyjal/3",
["actions"] = {
["start"] = {
["message_custom"] = "",
["message_tts_voice"] = 1,
["do_message"] = false,
["message"] = "",
["message_type"] = "TTS",
["custom"] = "C_VoiceChat.SpeakText(_G.FJITTS_SFX_VOICEID, \"Inferno Soon\", _G.FJITTS_SFX_RATE, _G.FJITTS_SFX_VOLUME, true)",
["do_sound"] = false,
["message_format_c_format"] = "none",
["message_format_C_format"] = "none",
["sound"] = "Interface\\Addons\\FojjiCore\\sound\\fojjiPop1.ogg",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "",
["do_custom"] = false,
},
["init"] = {
["custom"] = "aura_env.e = \"ANETHERON_INFERNO\"\naura_env.icon = 136219\naura_env.fallbackTime = 10\naura_env.name = \"INFERNO\"\n\nfunction aura_env.scheduleFallback(time)\n    if aura_env.timer then\n        aura_env.timer:Cancel()\n        aura_env.timer = nil\n    end\n    \n    aura_env.timer = C_Timer.NewTimer(time, function()\n            WeakAuras.ScanEvents(\"WA_\" .. aura_env.e .. \"_PREWARN_FALLBACK\")\n    end)\nend\n\nfunction aura_env.cancelFallback()\n    if aura_env.timer then\n        aura_env.timer:Cancel()\n        aura_env.timer = nil\n    end\nend",
["do_custom"] = true,
},
},
