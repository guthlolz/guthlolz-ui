["spellIds"] = {
},
["custom"] = "function(allstates,event,eID,subEvent,_,sourceGUID,_,_,_,destGUID,destName,_,_,spellId)\n    if spellId ~= aura_env.ragePlayer and spellId ~= aura_env.rageBoss then\n        return false\n    end\n    \n    if subEvent == \"SPELL_AURA_APPLIED\" then\n        if spellId == aura_env.ragePlayer then\n            WeakAuras.ScanEvents(\"WA_GURTOGG_RAGE_PHASE\")\n            WeakAuras.ScanEvents(\"WA_GURTOGG_FEL_RAGE_APPLIED\", destGUID, destName)\n            return\n        end\n    elseif subEvent == \"SPELL_AURA_REMOVED\" then\n        if spellId == aura_env.rageBoss then\n            WeakAuras.ScanEvents(\"WA_GURTOGG_BLOOD_PHASE\")\n            return\n        end\n    end\nend",
["check"] = "event",
