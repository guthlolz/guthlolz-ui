["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 8,\n            expirationTime = GetTime() + 8,\n            autoHide = true,\n            name = WeakAuras.me,\n            icon = 135846,\n        }\n        return true\n    end\n    \n    if event == \"WA_WINTERCHILL_ICEBOLT_TARGET\" then\n        local name = ...\n        \n        if name == WeakAuras.me then\n            return false\n        end\n        \n        allstates[name] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 2.5,\n            expirationTime = GetTime() + 2.5,\n            autoHide = true,\n            name = name,\n            icon = 135846,\n        }\n        return true\n    end\nend",
