["Trinket slot 1"] = {
["iconSource"] = -1,
["wagoID"] = "sGScXfEv2",
["parent"] = "Trinket Tracker (with ICD)",
["adjustedMax"] = "",
["adjustedMin"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["cooldownSwipe"] = true,
["url"] = "https://wago.io/sGScXfEv2/48",
["icon"] = true,
["triggers"] = {
{
["trigger"] = {
["auranames"] = {
"34775",
},
["subeventPrefix"] = "SPELL",
["customIcon"] = "function()\n    return aura_env.icon\nend",
["debuffType"] = "HELPFUL",
["names"] = {
},
["type"] = "custom",
["custom_type"] = "status",
["subeventSuffix"] = "_CAST_START",
["auraspellids"] = {
"34775",
},
["useName"] = false,
["event"] = "Health",
["customStacks"] = "function()\n    return aura_env.stacks\nend",
["customDuration"] = "function()\n    return aura_env.duration, aura_env.expirationTime\nend",
["custom"] = "function(event, unit)\n    if event == \"PLAYER_EQUIPMENT_CHANGED\" then\n        local trinketItemId = GetInventoryItemID(\"player\", aura_env.slot)\n        aura_env.trinketItemId = trinketItemId\n        aura_env.expirationTime = nil\n        aura_env.duration = nil\n        aura_env.icon = nil\n        aura_env.trinketBuffId = nil\n        if trinketItemId and aura_env.trinketBuffs[trinketItemId] then\n            aura_env.trinketBuffId = aura_env.trinketBuffs[trinketItemId]\n        end\n    end\n    \n    if unit ~= \"player\" then\n        return false\n    end\n    \n    if not aura_env.trinketBuffId then\n        return false\n    end\n    \n    local name, icon, count, _, duration, expirationTime, _, _, _, spellId =\n    WA_GetUnitBuff(\"player\", aura_env.trinketBuffId)\n    \n    aura_env.name = name\n    aura_env.icon = icon\n    aura_env.stacks = count\n    aura_env.duration = duration\n    aura_env.expirationTime = expirationTime\n    \n    return spellId ~= nil\nend",
["spellIds"] = {
},
["events"] = "UNIT_AURA:player  PLAYER_EQUIPMENT_CHANGED",
["check"] = "event",
["unit"] = "player",
["useExactSpellId"] = true,
["useIgnoreName"] = false,
},
["untrigger"] = {
},
},
{
["trigger"] = {
["type"] = "item",
["use_itemTypeName"] = false,
["use_genericShowOn"] = true,
["use_itemName"] = true,
["unit"] = "player",
["use_itemSlot"] = true,
["itemSlot"] = 13,
["event"] = "Cooldown Progress (Equipment Slot)",
["genericShowOn"] = "showOnCooldown",
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
},
},
{
["trigger"] = {
["auranames"] = {
"34775",
},
["subeventPrefix"] = "SPELL",
["customIcon"] = "function()\n    return aura_env.icon\nend",
["debuffType"] = "HELPFUL",
["names"] = {
},
["type"] = "custom",
["custom_type"] = "status",
["subeventSuffix"] = "_CAST_START",
["auraspellids"] = {
"34775",
},
["useName"] = false,
["event"] = "Health",
["customStacks"] = "function()\n    return aura_env.stacks\nend",
["customDuration"] = "function()\n    return aura_env.duration, aura_env.expirationTime\nend",
["custom"] = "function(event, ...)\n    local timestamp, subEvent, _, sourceGUID, sourceName, sourceFlags, sourceRaidFlags, \n    destGUID, destName, destFlags, destRaidFlags, spellId, spellName = CombatLogGetCurrentEventInfo()\n    if destGUID ~= UnitGUID(\"player\") then\n        return false\n    end\n    \n    if subEvent ~= \"SPELL_AURA_APPLIED\" then\n        return false\n    end\n    \n    if spellId ~= aura_env.trinketBuffId then\n        return false\n    end\n    \n    local icd = aura_env.icd[aura_env.trinketItemId]\n    if icd then\n        aura_env.duration = icd\n        aura_env.expirationTime = GetTime() + icd\n        aura_env.icon = GetItemIcon(aura_env.trinketItemId)\n        \n        return true\n    end\n    \n    return false\nend",
["spellIds"] = {
},
["events"] = "CLEU:SPELL_AURA_APPLIED",
["check"] = "event",
["unit"] = "player",
["useExactSpellId"] = true,
["useIgnoreName"] = false,
},
["untrigger"] = {
["custom"] = "function()\n    -- Untrigger when ICD expires\n    if aura_env.expirationTime and GetTime() >= aura_env.expirationTime then\n        return true\n    end\n    \n    return false\nend",
},
},
