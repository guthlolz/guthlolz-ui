["customText"] = "function()\n    local state = aura_env.state\n    local mark = (state.mark ~= nil and ICON_LIST[state.mark] .. \"0|t \") or \"|TInterface\\\\RaidFrame\\\\ReadyCheck-Waiting:0|t \"\n    return mark\nend",
