["CT:[T5][Lurker] Phase Controller"] = {
["outline"] = "OUTLINE",
["wagoID"] = "gSs1_GQRl",
["color"] = {
1,
1,
1,
1,
},
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["shadowYOffset"] = -1,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiT5RaidPack/3",
["actions"] = {
["start"] = {
},
["finish"] = {
["custom"] = "aura_env.count = 1\naura_env.nuTimer(aura_env.keySubmerge, nil)\naura_env.nuTimer(aura_env.keyEmerge, nil)\naura_env.preWarnCancel(aura_env.keySubmerge)\naura_env.preWarnCancel(aura_env.keyEmerge)\naura_env.cancelScheduledTimer()",
["do_sound"] = false,
["do_message"] = false,
["do_custom"] = true,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.keyEmerge = \"LURKER_EMERGE\"\naura_env.keySubmerge = \"LURKER_SUBMERGE\"\naura_env.cdStart = 90\naura_env.cdEmerge = 60\naura_env.cdSubmerge = 105\naura_env.subMerge = 28819\naura_env.throttle = 0\naura_env.preWarnTimer = {}\n\nfunction aura_env.nuTimer(key, countdown, count)\n    WeakAuras.ScanEvents(\"WA_NUMEN_TIMER\", key, countdown, count)\nend\n\nfunction aura_env.updateState(allstates)\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n    }\nend\n\nfunction aura_env.hideState(allstates)\n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\nend\n\nfunction aura_env.preWarn(key, duration, preWarnTime, count)\n    if not preWarnTime then\n        preWarnTime = 3\n    end\n    \n    if aura_env.preWarnTimer[key] then\n        aura_env.preWarnTimer[key]:Cancel()\n        aura_env.preWarnTimer[key] = nil\n    end\n    aura_env.preWarnTimer[key] = C_Timer.NewTimer(duration - preWarnTime, function()\n            WeakAuras.ScanEvents(\"WA_\" .. key ..\"_PREWARN\", preWarnTime, count)\n            aura_env.preWarnTimer[key] = nil\n    end)\nend\n\nfunction aura_env.preWarnCancel(key)\n    WeakAuras.ScanEvents(\"WA_\" .. key .. \"_PREWARN_CANCEL\")\n    if aura_env.preWarnTimer[key] then\n        aura_env.preWarnTimer[key]:Cancel()\n        aura_env.preWarnTimer[key] = nil\n    end\nend\n\nfunction aura_env.scheduleTimer(time)\n    if aura_env.scheduledTimer then\n        aura_env.scheduledTimer:Cancel()\n        aura_env.scheduledTimer = nil\n    end\n    \n    aura_env.scheduledTimer = C_Timer.NewTimer(time, function()\n            WeakAuras.ScanEvents(\"WA_LURKER_BELOW_EMERGE\")\n            aura_env.scheduledTimer = nil\n    end)\nend\n\nfunction aura_env.cancelScheduledTimer()\n    if aura_env.scheduledTimer then\n        aura_env.scheduledTimer:Cancel()\n        aura_env.scheduledTimer = nil\n    end\nend",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates,event,...)\n    if event == \"WA_FJI_ENCOUNTER_START\" or event == \"ENCOUNTER_START\" then\n        local eID = ...\n        \n        if eID ~= 624 then\n            return false\n        end\n        \n        aura_env.updateState(allstates)\n        aura_env.submergeCount = 1\n        aura_env.emergeCount = 1\n        aura_env.ambusherKill = 0\n        aura_env.guardianKill = 0\n        aura_env.submerged = false\n        \n        aura_env.preWarn(aura_env.keySubmerge, aura_env.cdStart, 5, aura_env.submergeCount)\n        aura_env.nuTimer(aura_env.keySubmerge, aura_env.cdStart, aura_env.submergeCount)\n        return true\n        \n    elseif event == \"WA_FJI_ENCOUNTER_END\" or event == \"ENCOUNTER_END\" then\n        aura_env.nuTimer(aura_env.keySubmerge, nil)\n        aura_env.nuTimer(aura_env.keyEmerge, nil)\n        aura_env.preWarnCancel(aura_env.keySubmerge)\n        aura_env.preWarnCancel(aura_env.keyEmerge)\n        aura_env.cancelScheduledTimer()\n        return true\n        \n    elseif event == \"WA_LURKER_BELOW_SUBMERGE\" then\n        if GetTime() - aura_env.throttle < 10 then\n            return false\n        end\n        aura_env.throttle = GetTime()\n        \n        aura_env.ambusherKill = 0\n        aura_env.guardianKill = 0\n        aura_env.submerged = true\n        aura_env.preWarnCancel(aura_env.keySubmerge)\n        aura_env.nuTimer(aura_env.keySubmerge, 0, aura_env.submergeCount)\n        aura_env.submergeCount = aura_env.submergeCount + 1\n        \n        aura_env.scheduleTimer(aura_env.cdEmerge)\n        aura_env.preWarn(aura_env.keyEmerge, aura_env.cdStart, 5, aura_env.emergeCount)\n        aura_env.nuTimer(aura_env.keyEmerge, aura_env.cdEmerge, aura_env.emergeCount)\n        return true\n        \n    elseif event == \"WA_LURKER_BELOW_EMERGE\" then\n        aura_env.submerged = false\n        aura_env.preWarnCancel(aura_env.keyEmerge)\n        aura_env.nuTimer(aura_env.keyEmerge, 0, aura_env.emergeCount)\n        aura_env.emergeCount = aura_env.emergeCount + 1\n        \n        aura_env.preWarn(aura_env.keySubmerge, aura_env.cdSubmerge, 5, aura_env.submergeCount)\n        aura_env.nuTimer(aura_env.keySubmerge, aura_env.cdSubmerge, aura_env.submergeCount)\n        return true\n    end\n    \n    if event == \"UNIT_SPELLCAST_SUCCEEDED\" then\n        local unit, _, spellId = ...\n        \n        if spellId ~= aura_env.subMerge then\n            return false\n        end\n        \n        if GetTime() - aura_env.throttle < 10 then\n            return false\n        end\n        aura_env.throttle = GetTime()\n        \n        _G.SyncEvents(\"RAID\", nil, \"WA_LURKER_BELOW_SUBMERGE\")\n        \n        aura_env.ambusherKill = 0\n        aura_env.guardianKill = 0\n        aura_env.submerged = true\n        aura_env.preWarnCancel(aura_env.keySubmerge)\n        aura_env.nuTimer(aura_env.keySubmerge, 0, aura_env.submergeCount)\n        aura_env.submergeCount = aura_env.submergeCount + 1\n        \n        aura_env.scheduleTimer(aura_env.cdEmerge)\n        aura_env.preWarn(aura_env.keyEmerge, aura_env.cdEmerge, 5, aura_env.emergeCount)\n        aura_env.nuTimer(aura_env.keyEmerge, aura_env.cdEmerge, aura_env.emergeCount)\n        return true\n    end\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local _,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId = ...\n        \n        if subEvent == \"UNIT_DIED\" then\n            local npcID = select(6, strsplit(\"-\", destGUID))\n            \n            if npcID == \"21865\" then\n                aura_env.ambusherKill = aura_env.ambusherKill + 1\n                if aura_env.ambusherKill == 6 and aura_env.guardianKill == 3 and aura_env.submerged then\n                    aura_env.preWarnCancel(aura_env.keyEmerge)\n                    aura_env.scheduleTimer(3)\n                    aura_env.preWarn(aura_env.keyEmerge, 3, 2, aura_env.emergeCount)\n                    aura_env.nuTimer(aura_env.keyEmerge, 3, aura_env.emergeCount)\n                    return true\n                end\n            elseif npcID == \"21873\" then\n                aura_env.guardianKill = aura_env.guardianKill + 1\n                if aura_env.ambusherKill == 6 and aura_env.guardianKill == 3 and aura_env.submerged then\n                    aura_env.preWarnCancel(aura_env.keyEmerge)\n                    aura_env.scheduleTimer(3)\n                    aura_env.preWarn(aura_env.keyEmerge, 3, 2, aura_env.emergeCount)\n                    aura_env.nuTimer(aura_env.keyEmerge, 3, aura_env.emergeCount)\n                    return true\n                end\n            end\n        end\n    end\nend",
["spellIds"] = {
},
["events"] = "ENCOUNTER_START, ENCOUNTER_END, WA_FJI_ENCOUNTER_END, WA_FJI_ENCOUNTER_START, UNIT_SPELLCAST_SUCCEEDED, CLEU:UNIT_DIED, WA_LURKER_BELOW_SUBMERGE, WA_LURKER_BELOW_EMERGE",
