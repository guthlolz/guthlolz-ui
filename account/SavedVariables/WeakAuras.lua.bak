["message"] = "",
["message_type"] = "TTS",
["custom"] = "for _,plateData in pairs(C_NamePlate.GetNamePlates()) do\n    local unit = plateData.UnitFrame.displayedUnit\n    local guid = unit and UnitGUID(unit)\n    \n    if guid and select(6,strsplit(\"-\",guid)) == \"22949\" and WeakAuras.CheckRange(unit,10,\"<=\") then\n        C_VoiceChat.SpeakText(_G.FJITTS_SFX_VOICEID,\"Consecration\",_G.FJITTS_SFX_RATE,_G.FJITTS_SFX_VOLUME,true)\n        break\n    end\nend",
