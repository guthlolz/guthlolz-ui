["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, key, time, count)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 1.5,\n            expirationTime = GetTime() + 1.5,\n            progressType = \"timed\",\n            icon = 136129,\n            autoHide = true,\n            inRange = true,\n        }\n        return true\n    end\n    \n    if event == \"WA_NUMEN_TIMER\" and key == \"KAELTHAS_BELLOWING_ROAR\" then\n        if time == 0 then\n            if aura_env.rangeTicker then\n                aura_env.rangeTicker:Cancel()\n                aura_env.rangeTicker = nil\n            end\n            \n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = 1.5,\n                expirationTime = GetTime() + 1.5,\n                progressType = \"timed\",\n                icon = 136129,\n                autoHide = true,\n                inRange = false,\n            }\n            \n            aura_env.updateRange(allstates)\n            \n            aura_env.rangeTicker = C_Timer.NewTicker(0.1, function()\n                    WeakAuras.ScanEvents(\"WA_SANGUINAR_RANGE_CHECK\")\n            end, 15)\n            \n            return true\n            \n        elseif time == nil then\n            if aura_env.rangeTicker then\n                aura_env.rangeTicker:Cancel()\n                aura_env.rangeTicker = nil\n            end\n            \n            if allstates[\"\"] then\n                allstates[\"\"].show = false\n                allstates[\"\"].changed = true\n                return true\n            end\n        end\n    end\n    \n    if event == \"WA_SANGUINAR_RANGE_CHECK\" then\n        if allstates[\"\"] then\n            aura_env.updateRange(allstates)\n            return true\n        end\n    end\nend",
