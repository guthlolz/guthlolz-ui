["CT:[T5][Alar] Platform"] = {
["outline"] = "OUTLINE",
["wagoID"] = "gSs1_GQRl",
["color"] = {
1,
1,
1,
1,
},
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["shadowYOffset"] = -1,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiT5RaidPack/3",
["actions"] = {
["start"] = {
},
["finish"] = {
["custom"] = "aura_env.count = 1\naura_env.nuTimer(nil)\naura_env.preWarnCancel()",
["do_sound"] = false,
["do_message"] = false,
["do_custom"] = true,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.key = \"ALAR_PLATFORM\"\naura_env.count = 1\naura_env.cdStart = 28\naura_env.cdWindow = 28\naura_env.npcID = \"19514\"\n\naura_env.inEncounter = false\naura_env.inPhase2 = false\naura_env.phase2Start = 0\naura_env.flying = false\naura_env.throttle = 0\naura_env.scanTicker = nil\n\nfunction aura_env.nuTimer(countdown, count)\n    WeakAuras.ScanEvents(\"WA_NUMEN_TIMER\", aura_env.key, countdown, count)\nend\n\nfunction aura_env.updateState(allstates)\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n    }\nend\n\nfunction aura_env.hideState(allstates)\n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\nend\n\nfunction aura_env.preWarn(duration, preWarnTime, count)\n    preWarnTime = preWarnTime or 3\n    \n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\n    \n    if duration and duration > preWarnTime then\n        aura_env.preWarnTimer = C_Timer.NewTimer(duration - preWarnTime, function()\n                WeakAuras.ScanEvents(\"WA_\" .. aura_env.key .. \"_PREWARN\", preWarnTime, count)\n                aura_env.preWarnTimer = nil\n        end)\n    end\nend\n\nfunction aura_env.preWarnCancel()\n    WeakAuras.ScanEvents(\"WA_\" .. aura_env.key .. \"_PREWARN_CANCEL\")\n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\nend\n\nfunction aura_env.canFire()\n    return GetTime() >= aura_env.throttle\nend\n\nfunction aura_env.setThrottle(seconds)\n    aura_env.throttle = GetTime() + seconds\nend\n\nfunction aura_env.getNpcID(guid)\n    return select(6, strsplit(\"-\", guid))\nend\n\nfunction aura_env.getAlarUnit()\n    for unit in WA_IterateGroupMembers() do\n        local unitTarget = unit .. \"target\"\n        if UnitExists(unitTarget) and aura_env.getNpcID(UnitGUID(unitTarget)) == aura_env.npcID then\n            return unitTarget\n        end\n    end\n    \n    if UnitExists(\"target\") and aura_env.getNpcID(UnitGUID(\"target\")) == aura_env.npcID then\n        return \"target\"\n    end\nend\n\nfunction aura_env.startScanTicker()\n    if aura_env.scanTicker then\n        return\n    end\n    \n    aura_env.scanTicker = C_Timer.NewTicker(0.25, function()\n            if not aura_env.inEncounter then\n                aura_env.stopScanTicker()\n                return\n            end\n            \n            local alarUnit = aura_env.getAlarUnit()\n            if not alarUnit then\n                return\n            end\n            \n            local hasTarget = UnitExists(alarUnit .. \"target\")\n            \n            if aura_env.inPhase2 then\n                if not hasTarget\n                and aura_env.canFire()\n                and (GetTime() - aura_env.phase2Start) > 25 then\n                    aura_env.setThrottle(25)\n                    WeakAuras.ScanEvents(\"WA_ALAR_METEOR\")\n                end\n            else\n                if not hasTarget and not aura_env.flying and aura_env.canFire() then\n                    aura_env.flying = true\n                    aura_env.setThrottle(25)\n                    WeakAuras.ScanEvents(\"WA_ALAR_FLIGHT\")\n                elseif hasTarget and aura_env.flying then\n                    aura_env.flying = false\n                end\n            end\n    end)\nend\n\nfunction aura_env.stopScanTicker()\n    if aura_env.scanTicker then\n        aura_env.scanTicker:Cancel()\n        aura_env.scanTicker = nil\n    end\nend",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, eID)\n    if event == \"WA_FJI_ENCOUNTER_START\" or event == \"ENCOUNTER_START\" then\n        if eID ~= 730 then\n            return false\n        end\n        \n        aura_env.inEncounter = true\n        aura_env.inPhase2 = false\n        aura_env.phase2Start = 0\n        aura_env.flying = false\n        aura_env.count = 1\n        aura_env.setThrottle(25)\n        \n        aura_env.updateState(allstates)\n        aura_env.preWarn(aura_env.cdStart, 3, aura_env.count)\n        aura_env.nuTimer(aura_env.cdStart, aura_env.count)\n        aura_env.startScanTicker()\n        return true\n        \n    elseif event == \"WA_ALAR_P1_END\" then\n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        return true\n        \n    elseif event == \"WA_ALAR_P2_START\" then\n        aura_env.inPhase2 = true\n        aura_env.phase2Start = GetTime()\n        aura_env.flying = false\n        aura_env.setThrottle(25)\n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        return true\n        \n    elseif event == \"WA_FJI_ENCOUNTER_END\" or event == \"ENCOUNTER_END\" then\n        aura_env.inEncounter = false\n        aura_env.inPhase2 = false\n        aura_env.phase2Start = 0\n        aura_env.flying = false\n        aura_env.throttle = 0\n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        aura_env.stopScanTicker()\n        return true\n    end\n    \n    if event == \"WA_ALAR_FLIGHT\" then\n        aura_env.nuTimer(0, aura_env.count)\n        aura_env.count = aura_env.count + 1\n        aura_env.preWarn(aura_env.cdWindow, 3, aura_env.count)\n        aura_env.nuTimer(aura_env.cdWindow, aura_env.count)\n        return true\n    end\nend",
["spellIds"] = {
},
["events"] = "WA_FJI_ENCOUNTER_START, ENCOUNTER_START, WA_FJI_ENCOUNTER_END, ENCOUNTER_END, WA_ALAR_FLIGHT, WA_ALAR_P2_START, WA_ALAR_P1_END",
