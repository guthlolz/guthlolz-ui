["custom"] = "function(allstates, event, key, time)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            icon = 132166,\n            count = math.random(1,5),\n        }\n    end\n    if event == \"WA_NUMEN_TIMER\" and key == \"KARATHRESS_BEAST_WITHIN\" and time == 0 then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            progressType = \"timed\",\n            icon = 132166,\n            autoHide = true,\n        }\n        return true\n    end\nend",
