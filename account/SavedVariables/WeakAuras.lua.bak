["icon"] = true,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["debuffType"] = "HELPFUL",
["custom_type"] = "event",
["dynamicDuration"] = true,
["duration"] = "45",
["event"] = "Health",
["unit"] = "player",
["customDuration"] = "function()\n    if aura_env.start and aura_env.expiration then\n        return aura_env.expiration - aura_env.start, aura_env.expiration\n    end\nend",
["custom"] = "function(event, unit)\n    if event == \"PLAYER_ENTERING_WORLD\" then\n        aura_env.lastPet = UnitExists(\"pet\")\n        return false\n    end\n    \n    if unit ~= \"player\" then\n        return false\n    end\n    \n    local hasPet = UnitExists(\"pet\")\n    local last = aura_env.lastPet or false\n    aura_env.lastPet = hasPet\n    \n    -- Le pet vient d'apparaitre -> on démarre un timer\n    if hasPet and not last then\n        aura_env.start = GetTime()\n        aura_env.expiration = aura_env.start + 45\n        return true\n    end\n    \n    return false\nend",
["spellIds"] = {
