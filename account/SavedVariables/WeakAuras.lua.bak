["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            icon = 136129,\n            count = math.random(1,5),\n        }\n    end\n    if event == \"WA_LEOTHERAS_HUMAN_START\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            progressType = \"timed\",\n            icon = 136129,\n            autoHide = true,\n        }\n        return true\n    end\nend",
["spellIds"] = {
},
["events"] = "WA_LEOTHERAS_HUMAN_START",
["check"] = "event",
["unit"] = "player",
["custom_hide"] = "timed",
