["[RAIDLEAD][T5][Solarian] AutoMark Solarium Priest"] = {
["outline"] = "OUTLINE",
["wagoID"] = "gSs1_GQRl",
["parent"] = "[T5]: AutoMarking",
["displayText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiT5RaidPack/3",
["actions"] = {
["start"] = {
["custom"] = "\n\n",
["do_custom"] = false,
},
["finish"] = {
["custom"] = "\n\n",
["do_custom"] = false,
},
["init"] = {
["custom"] = "aura_env.colorFojji = \"|cff3399ffFojji|r\"\naura_env.colorRAID = \"|cff9955ffT5|r\"\n\naura_env.npcIds = { \n    [\"18806\"] = true,\n}\n\naura_env.priorityMarks = {}\naura_env.marksAvailable = {}\naura_env.unitMark = {}\n\nfunction aura_env.freeMarks() -- Uncomment if a reset is needed mid-fight\n    aura_env.priorityMarks = {}\n    aura_env.marksAvailable = {}\n    aura_env.unitMark = {}\n    \n    if aura_env.config.group.option.enable then\n        local order = { \"firstMark\", \"secondMark\", \"thirdMark\" }\n        for _, key in ipairs(order) do\n            local mark = aura_env.config.group.option[key]\n            if mark and mark ~= 9 then\n                table.insert(aura_env.priorityMarks, mark)\n                aura_env.marksAvailable[mark] = true\n            end\n        end\n    end\nend\naura_env.freeMarks()",
["do_custom_unload"] = true,
["customOnUnload"] = "aura_env.freeMarks()",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "event",
["custom_hide"] = "timed",
["event"] = "Health",
["names"] = {
},
["subeventSuffix"] = "_CAST_START",
["spellIds"] = {
},
["events"] = "NAME_PLATE_UNIT_ADDED, ENCOUNTER_START, ENCOUNTER_END",
["subeventPrefix"] = "SPELL",
["check"] = "event",
["custom"] = "function(event, unit)\n    if event == \"ENCOUNTER_START\" or event == \"WA_FJI_ENCOUNTER_START\" then\n        aura_env.freeMarks()\n        return true\n    end\n    if not unit then return false end\n    \n    local guid = UnitGUID(unit)\n    local npcId = guid and select(6, strsplit(\"-\", guid))\n    if not npcId or not aura_env.npcIds[npcId] then return false end\n    \n    local currentMark = GetRaidTargetIndex(unit)\n    if currentMark and currentMark > 0 then\n        return false\n    end\n    \n    for _, mark in ipairs(aura_env.priorityMarks) do\n        if mark ~= 9 and aura_env.marksAvailable[mark] then\n            aura_env.marksAvailable[mark] = false\n            aura_env.unitMark[unit] = mark\n            SetRaidTarget(unit, mark)\n            \n            local icon = \"|TInterface/TargetingFrame/UI-RaidTargetingIcon_\" .. mark .. \":14:14|t\"\n            print(aura_env.colorFojji .. aura_env.colorRAID .. \" - Marked \" .. (UnitName(unit) or unit) .. \" with \" .. icon)\n            return true\n        end\n    end\n    \n    return false\nend",
["unit"] = "player",
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
},
},
["activeTriggerMode"] = -10,
},
