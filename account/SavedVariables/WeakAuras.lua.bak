["Warrior & Druid Tracker nameplate 2 2"] = {
["iconSource"] = -1,
["wagoID"] = "7HSw97mgp",
["parent"] = "OmniBuds Nameplate 2",
["adjustedMax"] = "",
["adjustedMin"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["cooldownSwipe"] = true,
["url"] = "https://wago.io/7HSw97mgp/1",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "local stances = {\n    7164, -- warrior def\n    7165, -- warrior battle\n    7366, -- warrior zerk\n    --[[\n    1066, -- druid aquatic form\n    768, -- druid cat form\n    783, -- druid travel form\n    9634, -- druid dire bear form\n    5487, -- druid bear form\n    ]]\n}\naura_env.stances = {}\naura_env.stancesToId = {}\naura_env.stancesIdToIcon = {}\n\nfor _, spellId in ipairs(stances) do\n    local name, _, icon = GetSpellInfo(spellId)\n    aura_env.stances[name] = icon\n    aura_env.stancesToId[name] = spellId\n    aura_env.stancesIdToIcon[spellId] = icon\nend\n\n\naura_env.nameplates = {}\naura_env.guids = {}\naura_env.temp = {}\n\naura_env.prefix = \"omnibuds2\"\nC_ChatInfo.RegisterAddonMessagePrefix(aura_env.prefix)",
["do_custom"] = true,
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["duration"] = "2",
["subeventPrefix"] = "SPELL",
["destUnit"] = "target",
["debuffType"] = "HELPFUL",
["names"] = {
},
["type"] = "custom",
["use_destNpcId"] = false,
["subeventSuffix"] = "_CAST_SUCCESS",
["unit"] = "player",
["use_unit"] = true,
["event"] = "Combat Log",
["custom_type"] = "stateupdate",
["events"] = "CLEU:SPELL_CAST_SUCCESS NAME_PLATE_UNIT_ADDED NAME_PLATE_UNIT_REMOVED",
["use_spellName"] = true,
["spellIds"] = {
},
["custom"] = "function(states, e, ...)\n    if e == \"NAME_PLATE_UNIT_ADDED\" then\n        local unit = ...\n        if unit then\n            local guid = UnitGUID(unit)\n            aura_env.nameplates[unit] = guid\n            aura_env.guids[guid] = unit\n            local now = GetTime()\n            for k, state in pairs(aura_env.temp) do\n                if state.guid == guid\n                and state.expirationTime > now\n                then\n                    state.unit = unit\n                    states[k] = CopyTable(state)\n                end\n                if state.expirationTime < now then\n                    aura_env.temp[k] = nil\n                end\n            end\n            return true\n        end\n    elseif e == \"NAME_PLATE_UNIT_REMOVED\" then\n        local unit = ...\n        if unit then\n            local guid = UnitGUID(unit)\n            if guid then\n                aura_env.nameplates[unit] = nil\n                aura_env.guids[guid] = nil\n                for k, state in pairs(states) do\n                    if state.guid == guid then\n                        aura_env.temp[k] = CopyTable(state)\n                        state.show = false\n                        state.changed = true\n                    end\n                end\n                return true\n            end\n        end\n    else\n        local spellName, guid, flags, icon, name, _, spellId, spell\n        if e == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n            _, _, _, guid, name, flags, _, _, _, _, _, _, spellName = ...\n            icon = aura_env.stances[spellName]\n            if icon\n            and flags\n            and bit.band(flags, COMBATLOG_OBJECT_CONTROL_PLAYER) > 0\n            and bit.band(flags, COMBATLOG_OBJECT_REACTION_HOSTILE) > 0\n            then\n                spell = icon\n                if aura_env.config.share and IsInGroup() then\n                    local msg = (\"%s#%s#%s\"):format(aura_env.stancesToId[spellName], name, guid)\n                    local channel = IsInGroup(LE_PARTY_CATEGORY_INSTANCE) and IsInInstance() and \"INSTANCE_CHAT\" or \"RAID\"\n                    C_ChatInfo.SendAddonMessage(aura_env.prefix, msg, channel)\n                end\n            end\n        elseif e == \"CHAT_MSG_ADDON\" then\n            local prefix, msg, _, sender = ...\n            if prefix == aura_env.prefix and msg then\n                spellId, name, guid = msg:match(\"([^#]*)#([^#]*)#(.*)\")\n                spell = spellId and aura_env.stancesIdToIcon[spellId]\n            end\n        end\n        \n        if spell\n        and guid\n        and not (states[guid] and states[guid].icon == icon)\n        then\n            local _, class = GetPlayerInfoByGUID(guid)\n            local data = {\n                show = true,\n                changed = true,\n                name = name,\n                duration = 60,\n                expirationTime = GetTime() + 60,\n                icon = spell,\n                progressType = \"timed\",\n                class = class,\n                autoHide = true,\n                guid = guid,\n                unit = aura_env.guids[guid]\n            }\n            if aura_env.guids[guid] then\n                states[guid] = data\n            else\n                aura_env.temp[guid] = data\n            end\n            return true\n        end\n    end\nend",
["check"] = "event",
["use_destUnit"] = true,
["unevent"] = "timed",
