["custom"] = "aura_env.keyFrost = \"HYDROSS_MARK_FROST\"\naura_env.keyNature = \"HYDROSS_MARK_NATURE\"\naura_env.count = 1\naura_env.cdStart = 16\naura_env.cdWindow = 14.8\naura_env.preWarnTimer = {}\n\naura_env.keyBySpell = {\n    [38215] = aura_env.keyFrost,\n    [38216] = aura_env.keyFrost,\n    [38217] = aura_env.keyFrost,\n    [38218] = aura_env.keyFrost,\n    [38231] = aura_env.keyFrost,\n    [40584] = aura_env.keyFrost,\n    \n    [38219] = aura_env.keyNature,\n    [38220] = aura_env.keyNature,\n    [38221] = aura_env.keyNature,\n    [38222] = aura_env.keyNature,\n    [38230] = aura_env.keyNature,\n    [40583] = aura_env.keyNature,\n}\n\naura_env.damage = {\n    [38215] = \"10%\",\n    [38216] = \"25%\",\n    [38217] = \"50%\",\n    [38218] = \"100%\",\n    [38231] = \"250%\",\n    [40584] = \"500%\",\n    [38219] = \"10%\",\n    [38220] = \"25%\",\n    [38221] = \"50%\",\n    [38222] = \"100%\",\n    [38230] = \"250%\",\n    [40583] = \"500%\",\n}\n\naura_env.damageNext = {\n    [38215] = \"25%\",\n    [38216] = \"50%\",\n    [38217] = \"100%\",\n    [38218] = \"250%\",\n    [38231] = \"500%\",\n    [40584] = \"500%\",\n    [38219] = \"25%\",\n    [38220] = \"50%\",\n    [38221] = \"100%\",\n    [38222] = \"250%\",\n    [38230] = \"500%\",\n    [40583] = \"500%\",\n}\n\nfunction aura_env.nuTimer(key, countdown, count, _, text)\n    WeakAuras.ScanEvents(\"WA_NUMEN_TIMER\", key, countdown, count, nil, text)\nend\n\nfunction aura_env.updateState(allstates)\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n    }\nend\n\nfunction aura_env.hideState(allstates)\n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\nend\n\nfunction aura_env.preWarn(key, duration, preWarnTime, count, text)\n    if not preWarnTime then\n        preWarnTime = 3\n    end\n    \n    if aura_env.preWarnTimer[key] then\n        aura_env.preWarnTimer[key]:Cancel()\n        aura_env.preWarnTimer[key] = nil\n    end\n    \n    aura_env.preWarnTimer[key] = C_Timer.NewTimer(duration - preWarnTime, function()\n            WeakAuras.ScanEvents(\"WA_\" .. key .. \"_PREWARN\", preWarnTime, count, text)\n            aura_env.preWarnTimer[key] = nil\n    end)\nend\n\nfunction aura_env.preWarnCancel(key)\n    WeakAuras.ScanEvents(\"WA_\" .. key .. \"_PREWARN_CANCEL\")\n    if aura_env.preWarnTimer[key] then\n        aura_env.preWarnTimer[key]:Cancel()\n        aura_env.preWarnTimer[key] = nil\n    end\nend",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, eID, subEvent, _, sourceGUID, _, _, _, destGUID, _, _, _, spellId)\n    if event == \"WA_FJI_ENCOUNTER_START\" or event == \"ENCOUNTER_START\" then\n        if eID ~= 623 then\n            return false\n        end\n        \n        aura_env.updateState(allstates)\n        aura_env.count = 1\n        \n        aura_env.preWarn(aura_env.keyFrost, aura_env.cdStart, 5, aura_env.count, \"10%\")\n        aura_env.nuTimer(aura_env.keyFrost, aura_env.cdStart, aura_env.count, nil, \"10%\")\n        return true\n        \n    elseif event == \"WA_FJI_ENCOUNTER_END\" or event == \"ENCOUNTER_END\" then\n        aura_env.preWarnCancel(aura_env.keyNature)\n        aura_env.preWarnCancel(aura_env.keyFrost)\n        aura_env.nuTimer(aura_env.keyFrost, nil)\n        aura_env.nuTimer(aura_env.keyNature, nil)\n        return true\n        \n    elseif event == \"WA_HYDROSS_NATURE_PHASE\" then\n        aura_env.preWarnCancel(aura_env.keyFrost)\n        aura_env.nuTimer(aura_env.keyFrost, nil)\n        aura_env.count = 1\n        \n        aura_env.preWarn(aura_env.keyNature, aura_env.cdStart, 5, aura_env.count, \"10%\")\n        aura_env.nuTimer(aura_env.keyNature, aura_env.cdStart, aura_env.count, nil, \"10%\")\n        return true\n        \n    elseif event == \"WA_HYDROSS_FROST_PHASE\" then\n        aura_env.preWarnCancel(aura_env.keyNature)\n        aura_env.nuTimer(aura_env.keyNature, nil)\n        aura_env.count = 1\n        \n        aura_env.preWarn(aura_env.keyFrost, aura_env.cdStart, 5, aura_env.count, \"10%\")\n        aura_env.nuTimer(aura_env.keyFrost, aura_env.cdStart, aura_env.count, nil, \"10%\")\n        return true\n    end\n    \n    local key = aura_env.keyBySpell[spellId]\n    if not key then\n        return false\n    end\n    \n    if subEvent == \"SPELL_CAST_SUCCESS\" then\n        local currentDamage = aura_env.damage[spellId] or \"10%\"\n        local nextDamage = aura_env.damageNext[spellId] or \"10%\"\n        \n        aura_env.nuTimer(key, 0, aura_env.count, nil, currentDamage)\n        aura_env.count = aura_env.count + 1\n        \n        aura_env.preWarn(key, aura_env.cdWindow, 5, aura_env.count, nextDamage)\n        aura_env.nuTimer(key, aura_env.cdWindow, aura_env.count, nil, nextDamage)\n        return true\n    end\nend",
["spellIds"] = {
},
["events"] = "ENCOUNTER_START, ENCOUNTER_END, WA_FJI_ENCOUNTER_END, WA_FJI_ENCOUNTER_START, CLEU:SPELL_CAST_SUCCESS, WA_HYDROSS_FROST_PHASE, WA_HYDROSS_NATURE_PHASE",
