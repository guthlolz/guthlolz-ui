["trigger"] = {
["type"] = "custom",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["names"] = {
},
["duration"] = "20",
["event"] = "Health",
["unit"] = "player",
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, key, time, count)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            progressType = \"timed\",\n            icon = 135824,\n            autoHide = true,\n            safe = true,\n        }\n        return true\n    end\n    \n    if event == \"WA_KARATHRESS_RANGE_CHECK\" then\n        local range = aura_env.getKarathressRange()\n        \n        if allstates[\"\"] then\n            allstates[\"\"].safe = range and range >= 8 or false\n            allstates[\"\"].changed = true\n            return true\n        end\n    end\n    \n    if event == \"WA_NUMEN_TIMER\" and key == \"KARATHRESS_SEAR_NOVA\" then\n        if time == 0 then\n            if not aura_env.ticker then\n                aura_env.ticker = C_Timer.NewTicker(0.1, function()\n                        WeakAuras.ScanEvents(\"WA_KARATHRESS_RANGE_CHECK\")\n                end, 20)\n            end\n            \n            local range = aura_env.getKarathressRange()\n            \n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = 2,\n                expirationTime = GetTime() + 2,\n                progressType = \"timed\",\n                icon = 135824,\n                autoHide = true,\n                safe = range and range >= 8 or false,\n            }\n        elseif time == nil then\n            if aura_env.ticker then\n                aura_env.ticker:Cancel()\n                aura_env.ticker = nil\n            end\n            \n            if allstates[\"\"] then\n                allstates[\"\"].show = false\n                allstates[\"\"].changed = true\n            end\n        end\n        return true\n    end\nend",
["events"] = "WA_NUMEN_TIMER WA_KARATHRESS_RANGE_CHECK",
["spellIds"] = {
},
["check"] = "event",
["custom_type"] = "stateupdate",
["customVariables"] = "{\n    safe = \"bool\",\n}",
["custom_hide"] = "timed",
