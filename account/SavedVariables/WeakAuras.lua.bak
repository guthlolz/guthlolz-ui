["do_sound"] = false,
},
["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.saved = aura_env.saved or {}\naura_env.timer = 36\n\nlocal locale = GetLocale()\n\naura_env.locales = {\n    [\"enUS\"] = {\n        illidanActive = \"Akama. Your duplicity is hardly surprising. I should have slaughtered you and your malformed brethren long ago.\",\n    },\n    [\"frFR\"] = {\n        illidanActive = \"Akama. Ta duplicité n'est pas très étonnante. J'aurais dû vous massacrer depuis longtemps, toi et ton frère déformé.\",\n    },\n    [\"deDE\"] = {\n        illidanActive = \"Akama. Euer falsches Spiel überrascht mich nicht. Ich hätte Euch und Eure missgestalteten Brüder schon vor langer Zeit abschlachten sollen.\",\n    },\n    [\"esES\"] = {\n        illidanActive = \"Akama. Tu hipocresía no me sorprende. Debí acabar contigo y con tus malogrados hermanos hace tiempo.\",\n    },\n    [\"koKR\"] = {\n        illidanActive = \"아카마, 너의 불충은 그리 놀랍지도 않구나. 너희 흉측한 형제들을 벌써 오래전에 없애버렸어야 했는데...\",\n    },\n    [\"ptBR\"] = { -- no translation available\n        illidanActive = \"Akama. Your duplicity is hardly surprising. I should have slaughtered you and your malformed brethren long ago.\",\n    },\n    [\"ruRU\"] = {\n        illidanActive = \"Акама. Я не удивлен твоей двуличностью. Давно нужно было убить тебя и твоих мерзких прихвостней.\",\n    },\n    [\"zhCN\"] = {\n        illidanActive = \"阿卡玛。你的两面三刀并没有让我感到意外。我早就应该把你和你那些畸形的同胞全部杀掉。\",\n    },\n    [\"zhTW\"] = {\n        illidanActive = \"阿卡瑪。你的謊言真是老套。我很久前就應該殺了你和你那些畸形的同胞。\",\n    }\n}\n\naura_env.currentLocale = aura_env.locales[locale] or aura_env.locales[\"enUS\"]\n\nfunction aura_env.clearTimer()\n    aura_env.saved.expiration = nil\nend\n\nfunction aura_env.getRemaining()\n    local exp = aura_env.saved.expiration\n    if not exp then\n        return nil\n    end\n    \n    local remaining = exp - GetTime()\n    \n    if remaining > aura_env.timer then\n        aura_env.clearTimer()\n        return nil\n    end\n    \n    if remaining <= 0 then\n        aura_env.clearTimer()\n        return nil\n    end\n    \n    return remaining, exp\nend\n\nfunction aura_env.hasActiveTimer()\n    return aura_env.getRemaining() ~= nil\nend\n\nfunction aura_env.startTimer()\n    aura_env.saved.expiration = GetTime() + aura_env.timer\nend\n\nfunction aura_env.showState(allstates)\n    local remaining, exp = aura_env.getRemaining()\n    if not remaining then\n        return false\n    end\n    \n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n        progressType = \"timed\",\n        duration = remaining,\n        expirationTime = exp,\n        autoHide = true,\n    }\n    return true\nend",
},
