["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates,event,_,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId)\n    if subEvent == \"UNIT_DIED\" then\n        local npcID = select(6, strsplit(\"-\", destGUID))\n        if npcID == \"19514\" then\n            WeakAuras.ScanEvents(\"WA_FJI_ENCOUNTER_END\")\n            WeakAuras.ScanEvents(\"WA_FJI_ALAR_KILLED\")\n            return true\n        elseif npcID == \"19516\" then\n            WeakAuras.ScanEvents(\"WA_FJI_ENCOUNTER_END\")\n            WeakAuras.ScanEvents(\"WA_FJI_REAVER_KILLED\")\n            return true\n        elseif npcID == \"18805\" then\n            WeakAuras.ScanEvents(\"WA_FJI_ENCOUNTER_END\")\n            WeakAuras.ScanEvents(\"WA_FJI_SOLARIAN_KILLED\")\n            return true\n        elseif npcID == \"19622\" then\n            WeakAuras.ScanEvents(\"WA_FJI_ENCOUNTER_END\")\n            WeakAuras.ScanEvents(\"WA_FJI_KAELTHAS_KILLED\")\n            return true\n        end\n    end\nend",
