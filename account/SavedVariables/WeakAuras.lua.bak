["custom"] = "function(allstates, event)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            progressType = \"timed\",\n            icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\karathress.jpg\",\n            autoHide = true,\n            type = \"Sharkkis\",\n        }\n        return true\n    end\n    if event == \"WA_KARATHRESS_POWER_SHARKKIS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            progressType = \"timed\",\n            icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\karathress.jpg\",\n            autoHide = true,\n            type = \"Sharkkis\",\n        }\n        return true\n    elseif event == \"WA_KARATHRESS_POWER_TIDALVESS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            progressType = \"timed\",\n            icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\karathress.jpg\",\n            autoHide = true,\n            type = \"Tidalvess\",\n        }\n        return true\n    elseif event == \"WA_KARATHRESS_POWER_CARIBDIS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            progressType = \"timed\",\n            icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\karathress.jpg\",\n            autoHide = true,\n            type = \"Caribdis\",\n        }\n        return true\n    end\nend",
