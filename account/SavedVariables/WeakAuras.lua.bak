["useAdjustededMin"] = false,
["regionType"] = "icon",
["selfPoint"] = "CENTER",
["xOffset"] = 0,
["uid"] = "XxlXMWzacam",
["actions"] = {
["start"] = {
},
["finish"] = {
},
["init"] = {
["custom"] = "aura_env.absorbSpells = {\n    [17549] = { amount = 1949, icon = 134863, school = \"Arcane\"}, -- Greater Arcane Protection Potion\n    [17543] = { amount = 1949, icon = 134804, school = \"Fire\"},   -- Greater Fire Protection\n    [17544] = { amount = 1949, icon = 134800, school = \"Frost\"},  -- Greater Frost Protection\n    [17546] = { amount = 1949, icon = 134802, school = \"Nature\"}, -- Greater Nature Protection\n    [7254]  = { amount = 1349, icon = 134717, school = \"Nature\"}, -- Nature Protection\n    [17548] = { amount = 1949, icon = 134803, school = \"Shadow\"}, -- Greater Shadow Protection Potion\n    \n    [28536] = { amount = 2799, icon = 134752, school = \"Arcane\"}, -- Major Arcane Protection Potion\n    [28511] = { amount = 2799, icon = 134748, school = \"Fire\"},   -- Major Fire Protection Potion\n    [28512] = { amount = 2799, icon = 134750, school = \"Frost\"},  -- Major Frost Protection Potion\n    [28538] = { amount = 2799, icon = 134749, school = \"Holy\"},   -- Major Holy Protection Potion\n    [28513] = { amount = 2799, icon = 134751, school = \"Nature\"}, -- Major Nature Protection Potion\n    [28537] = { amount = 2799, icon = 134747, school = \"Shadow\"}, -- Major Shadow Protection Potion\n}\n\nlocal DURATION = 120\n\nlocal function update(state, amount)\n    state.absorb = (state.absorb or 0) - amount\n    if state.absorb < 0 then\n        state.absorb = 0\n    end\n    state.show = state.absorb > 0\n    state.changed = true\n    return true\nend\n\nfunction aura_env.WA_FJI_ABSORB_APPLIED(allStates, total, spellId, expirationTime)\n    local info = aura_env.absorbSpells[spellId]\n    if not info then\n        return\n    end\n    \n    local now = GetTime()\n    local duration\n    local exp\n    \n    if expirationTime and expirationTime > now then\n        duration = expirationTime - now\n        if duration > DURATION then\n            duration = DURATION\n            exp = now + DURATION\n        else\n            exp = expirationTime\n        end\n    else\n        duration = DURATION\n        exp = now + DURATION\n    end\n    \n    local absorb = total or info.amount\n    \n    allStates[spellId] = {\n        show = true,\n        changed = true,\n        progressType = \"timed\",\n        duration = duration,\n        expirationTime = exp,\n        autoHide = true,\n        absorb = absorb,\n        total = absorb,\n        school = info.school,\n        icon = info.icon,\n        spellId = spellId,\n    }\n    \n    return true\nend\n\nfunction aura_env.WA_FJI_ABSORB_REMOVED(allStates, spellId)\n    if not aura_env.absorbSpells[spellId] then\n        return\n    end\n    \n    local state = allStates[spellId]\n    if not state then\n        return\n    end\n    \n    state.show = false\n    state.changed = true\n    return true\nend\n\nfunction aura_env.WA_FJI_ABSORB_UPDATE(allStates, amount, spellId)\n    if not aura_env.absorbSpells[spellId] then\n        return\n    end\n    \n    local state = allStates[spellId]\n    if state then\n        return update(state, amount)\n    end\nend\n\nfunction aura_env.OPTIONS(allStates)\n    local now = GetTime()\n    for spellId, v in pairs(aura_env.absorbSpells) do\n        local amount = v.amount\n        local value  = math.random(1, amount)\n        \n        allStates[spellId] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = DURATION,\n            expirationTime = now + DURATION,\n            autoHide = true,\n            absorb = value,\n            total = amount,\n            school = v.school,\n            spellId = spellId,\n            icon = v.icon,\n        }\n    end\n    return true\nend\n\nfunction aura_env.STATUS(allStates)\n    return\nend",
["do_custom"] = true,
},
},
