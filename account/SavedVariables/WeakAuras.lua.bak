["sparkOffsetX"] = 0,
["wagoID"] = "t8iP53O3J",
["parent"] = "[CL]:Paladin - Target Cast Bar",
["adjustedMin"] = "",
["sparkRotationMode"] = "AUTO",
["triggers"] = {
{
["trigger"] = {
["use_castType"] = true,
["duration"] = "2",
["unit"] = "nameplate",
["customIcon"] = "",
["dynamicDuration"] = false,
["custom_hide"] = "custom",
["debuffType"] = "HELPFUL",
["names"] = {
},
["type"] = "custom",
["use_clone"] = true,
["custom_type"] = "stateupdate",
["subeventSuffix"] = "_CAST_START",
["spellIds"] = {
},
["event"] = "Cast",
["custom"] = "function(a, e, unit, _, spellId)\n    if e == \"UNIT_SPELLCAST_CHANNEL_START\" then\n        local name, _, icon = GetSpellInfo(spellId)\n        \n        if name then\n            local channelMS = aura_env.channelDurations[name]\n            if channelMS then\n                local duration = channelMS / 1000\n                a[\"\"] = {\n                    show = true,\n                    changed = true,\n                    progressType = \"timed\",\n                    duration = duration,\n                    expirationTime = GetTime() + duration,\n                    autoHide = true,\n                    icon = icon,\n                    name = name,\n                }\n                return true\n            end\n        end\n    elseif e == \"UNIT_SPELLCAST_CHANNEL_STOP\" or e == \"PLAYER_TARGET_CHANGED\" then\n        if a[\"\"] then\n            a[\"\"].show = false\n            a[\"\"].changed = true\n            return true\n        end\n    end\nend",
["customDuration"] = "",
["customName"] = "",
["events"] = "PLAYER_TARGET_CHANGED UNIT_SPELLCAST_CHANNEL_START:target UNIT_SPELLCAST_CHANNEL_STOP:target",
["castType"] = "channel",
["check"] = "event",
["unevent"] = "auto",
["subeventPrefix"] = "SPELL",
["use_unit"] = true,
