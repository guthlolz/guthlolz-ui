},
["custom"] = "function(allstates, event)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 15,\n            expirationTime = GetTime() + 15,\n            progressType = \"timed\",\n            icon = 135735,\n            autoHide = true,\n        }\n        return true\n    end\n    if event == \"WA_RELIQUARY_RUNE_SHIELD_APPLIED\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 15,\n            expirationTime = GetTime() + 15,\n            progressType = \"timed\",\n            icon = 135735,\n            autoHide = true,\n        }\n        return true\n    end\n    \n    if event == \"WA_RELIQUARY_RUNE_SHIELD_REMOVED\" then\n        if allstates[\"\"] then\n            allstates[\"\"].show = false\n            allstates[\"\"].changed = true\n            return true\n        end\n    end\nend",
