["borderInset"] = 11,
["customTextUpdate"] = "event",
["icon"] = true,
["displayText_format_c_abbreviate_max"] = 8,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["names"] = {
},
["duration"] = "1",
["event"] = "Health",
["unit"] = "player",
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, timestamp, subEvent, _, _, _, _, _, destGUID, destName, _, _, environmentalType)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 5,\n            expirationTime = GetTime() + 5,\n            autoHide = true,\n            name = WeakAuras.myGUID,\n            guild = \"<Numen>\",\n            icon = aura_env.getRandomIcon()\n        }\n        return true\n    end\n    \n    if subEvent == \"ENVIRONMENTAL_DAMAGE\" then\n        if environmentalType == \"Falling\" then\n            aura_env.fallDamage[destGUID] = timestamp\n        end\n    elseif subEvent == \"UNIT_DIED\" then\n        local deathTime = timestamp\n        local fallTime = aura_env.fallDamage[destGUID]\n        \n        if fallTime and (deathTime - fallTime) <= 1 then\n            local guild = GetGuildInfo(destName)\n            \n            local guildName = guild and (\"<\" .. guild .. \">\") or \"<No Guild>\"\n            \n            allstates[destGUID] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = 5,\n                expirationTime = GetTime() + 5,\n                autoHide = true,\n                name = destGUID,\n                guild = guildName,\n                icon = aura_env.getRandomIcon()\n            }\n            aura_env.fallDamage[destGUID] = nil\n            \n            local soundFile = aura_env.getRandomSound()\n            if soundFile then\n                PlaySoundFile(soundFile, \"Master\")\n            end\n            return true\n        end\n    end\nend",
["events"] = "CLEU:UNIT_DIED:ENVIRONMENTAL_DAMAGE:ENVIRONMENTAL_INSTAKILL",
["spellIds"] = {
},
["check"] = "event",
["custom_type"] = "stateupdate",
["customVariables"] = "{\n    name = \"string\",\n    guild = \"string\",\n}",
["custom_hide"] = "timed",
},
["untrigger"] = {
},
},
["disjunctive"] = "custom",
["customTriggerLogic"] = "function(t)\n    return t[1]\nend",
