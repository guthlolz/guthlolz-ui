["custom"] = "function(allstates, event, guid, name)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 3,\n            expirationTime = GetTime() + 3,\n            autoHide = true,\n            unit = \"player\",\n        }\n        return true\n    end\n    \n    if event == \"WA_COLOSSUS_GEYSER_TARGET\" then\n        allstates[name] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 3,\n            expirationTime = GetTime() + 3,\n            autoHide = true,\n            unit = name,\n        }\n        return true\n    end\nend",
