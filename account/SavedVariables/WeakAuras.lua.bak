["displayText_format_t_format"] = "timed",
["yOffset"] = 0,
["foregroundColor"] = {
0.72156862745098,
0.51372549019608,
1,
1,
},
["sparkRotation"] = 0,
["sameTexture"] = true,
["url"] = "https://wago.io/FojjiT4RaidPack/3",
["actions"] = {
["start"] = {
["custom"] = "local state = aura_env.state\nif state and state.spellKey then\n    local color = aura_env.getColor(state.spellKey)\n    aura_env.region:Color(color[1], color[2], color[3], color[4] or 1)\nend",
["do_custom"] = true,
["do_sound"] = false,
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.region.bar:SetVertexColor(1, 1, 1, 1)\n\naura_env.spellKeys = { -- Colour is RGBA (Red,Green,Blue,Alpha)\n    -- name, icon, autoHide (true/false), role (\"TANK\"/\"HEALER\"), roleRestrict (true/false), useText (true/false)\n    -- note that the first role is selected for the Icon\n    --[\"JINROKH_STATIC_BURST\"] = {name = \"Static Burst\", icon = 136050, role = {\"TANK\", \"HEALER\"}, roleRestrict = true, autoHide = true},\n    \n    [\"MAGTHERIDON_BLAST_NOVA\"] = { name = \"Blast Nova\", icon = 135824},\n    [\"MAGTHERIDON_CLEAVE\"] = { name = \"Cleave\", icon = 132338, role = {\"TANK\", \"HEALER\"}},\n    [\"MAGTHERIDON_P2_START\"] = { name = \"Magtheridon Activates\", icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\magtheridon.jpg\"},\n    [\"MAGTHERIDON_DEBRIS\"] = { name = \"Debris\", icon = 136025, autoHide = true},\n    \n    [\"MAULGAR_WHIRLWIND\"] = { name = \"Whirlwind\", icon = 132369},\n    [\"MAULGAR_FEL_STALKER\"] = { name = \"Summon Fel Stalker\", icon = 136217},\n    [\"MAULGAR_PRAYER\"] = { name = \"Prayer of Healing\", icon = 135943},\n    [\"MAULGAR_SPELL_SHIELD\"] = { name = \"Spell Shield\", icon = 135733},\n    [\"MAULGAR_INTIMIDATING_ROAR\"] = { name = \"Intimidating Roar\", icon = 132154},\n    [\"MAULGAR_CHARGE\"] = { name = \"Charge\", icon = 132337},\n    \n    [\"GRUUL_GROWTH\"] = { name = \"Growth\", icon = 136129},\n    [\"GRUUL_GROUND_SLAM\"] = { name = \"Ground Slam\", icon = 135237},\n    [\"GRUUL_HURTFUL_STRIKE\"] = { name = \"Hurtful Strike\", icon = 132215},\n    [\"GRUUL_REVERBERATION\"] = { name = \"Reverberation (Silence)\", icon = 135925},\n}\n\naura_env.timers = {}\n\nfunction aura_env.getColor(key)\n    local cfg = aura_env.config.option\n    \n    if cfg.colorOverride and cfg.color then\n        return { cfg.color[1], cfg.color[2], cfg.color[3], cfg.color[4] or 1 }\n    end\n    \n    local color = cfg.enabledGroup and cfg.enabledGroup[\"COL_\" .. key]\n    if color and color[1] then\n        return { color[1], color[2], color[3], color[4] or 1 }\n    end\nend\n\nlocal function createKey(key, guid)\n    if guid then\n        return key .. \"_\" .. guid\n    end\n    return key\nend\n\nfunction aura_env.updateState(allstates, key, duration, count, name, icon, color, autoHide, text, guid)\n    local r, g, b, a = color[1], color[2], color[3], color[4] or 1\n    local stateKey = (guid and (key .. \"_\" .. guid)) or key\n    \n    allstates[stateKey] = {\n        show = true,\n        changed = true,\n        duration = duration,\n        expirationTime = GetTime() + duration,\n        progressType = \"timed\",\n        count = count,\n        color = { r, g, b, a },\n        icon = icon,\n        name = name,\n        autoHide = autoHide,\n        text = text or \"\",\n        spellKey = key,\n        useText = text and text ~= \"\",\n    }\nend\n\nfunction aura_env.hideState(allstates, key, guid)\n    local stateKey = createKey(key, guid)\n    \n    if allstates[stateKey] then\n        allstates[stateKey].show = false\n        allstates[stateKey].changed = true\n        return true\n    end\nend\n\nfunction aura_env.scheduleTimer(key, delay, count, displayName, icon, color, autoHide, text, guid, tts)\n    local timerKey = (guid and (key .. \"_\" .. guid)) or key\n    \n    if aura_env.timers[timerKey] then\n        aura_env.timers[timerKey]:Cancel()\n        aura_env.timers[timerKey] = nil\n    end\n    \n    aura_env.timers[timerKey] = C_Timer.NewTimer(delay, function()\n            WeakAuras.ScanEvents(\"WA_NUMEN_EMPHASIZED_TIMER\",\n            key, 10, count, displayName, icon, color, autoHide, text, guid, tts)\n    end)\nend\n\nfunction aura_env.cancelTimer(key, guid)\n    local timerKey = createKey(key, guid)\n    \n    if aura_env.timers[timerKey] then\n        aura_env.timers[timerKey]:Cancel()\n        aura_env.timers[timerKey] = nil\n    end\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "",
["do_sound"] = false,
["do_message"] = false,
["do_custom"] = false,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
},
