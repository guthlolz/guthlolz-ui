["custom"] = "aura_env.spellKeys = {\n    [\"TRASH_LEVIATHAN_TAILSWEEP\"] = {icon = 134307, npcID = \"22884\"}, -- Tail Sweep\n    [\"TRASH_COILSKAR_GEYSER\"] = {icon = 135854, npcID = \"22875\"}, -- Summon Geyser (Coilskar Sea-Caller)\n    [\"TRASH_COILSKAR_HURRICANE\"] = {icon = 136018, npcID = \"22875\"}, -- Hurricane\n    [\"TRASH_COILSKAR_PROD\"] = {icon = 135600, npcID = \"22877\"}, -- Lightning Prod (Coilskar Wrangler)\n    [\"TRASH_COILSKAR_BOOMING\"] = {icon = 132339, npcID = \"22873\"}, -- Booming Voice (Coilskar General)\n    [\"TRASH_COILSKAR_NET\"] = {icon = 132149, npcID = \"22874\"}, -- Hooked Net (Coilskar Harpooner)\n    [\"TRASH_AQUEOUS_WAVE\"] = {icon = 135795, npcID = \"22878\"}, -- Crashing Wave (Aqueous Lord)\n    [\"TRASH_WYRMCALLER_CLEAVE\"] = {icon = 132338, npcID = \"22960\"}, -- Cleave (Dragonmaw Wyrmcaller)\n    [\"TRASH_FEARBRINGER_STOMP\"] = {icon = 132091, npcID = \"22954\"}, -- War Stomp (Illidari Fearbringer)\n    [\"TRASH_FEARBRINGER_FLAMES\"] = {icon = 135777, npcID = \"22954\"}, -- Illidari Flames (Illidari Fearbringer)\n    [\"TRASH_WINDREAVER_FREEZE\"] = {icon = 135848, npcID = \"23330\"}, -- Freeze (Dragonmaw Wind Reaver)\n    [\"TRASH_BONESLICER_GOUGE\"] = {icon = 132155, npcID = \"22869\"}, -- Gouge (Illidari Boneslicer)\n    [\"TRASH_BONESLICER_SHADOWSTEP\"] = {icon = 132303, npcID = \"22869\"}, -- Shadowstep (Illidari Boneslicer)\n    [\"TRASH_CENTURION_SONICSTRIKE\"] = {icon = 135975, npcID = \"23337\"}, -- Sonic Strike (Illidari Centurion)\n    [\"TRASH_CENTURION_CLEAVE\"] = {icon = 132338, npcID = \"23337\"}, -- Cleave (Illidari Centurion)\n    [\"TRASH_NIGHTLORD_SHADOWINFERNO\"] = {icon = 135801, npcID = \"22855\"}, -- Shadow Inferno (Illidari Nightlord)\n    [\"TRASH_NIGHTLORD_FEAR\"] = {icon = 136183, npcID = \"22855\"}, -- Fear (Illidari Nightlord)\n    [\"TRASH_ASHTONGUE_CONCUSSION\"] = {icon = 132325, npcID = \"22844\"}, -- Concussion Blow (Ashtongue Battlelord)\n    [\"TRASH_ASHTONGUE_CLEAVE\"] = {icon = 132338, npcID = \"22844\"}, -- Cleave (Ashtongue Battlelord)\n    [\"TRASH_ASHTONGUE_CYCLONETOTEM\"] = {icon = 136018, npcID = \"22845\"}, -- Cyclone Totem (Ashtongue Mystic)\n    [\"TRASH_NIGHTLORD_SHADOWFIENDS\"] = {icon = 136199, npcID = \"22855\"}, -- Shadowfiends (Illidari Nightlord)\n    [\"TRASH_FURY_STORMBLINK\"] = {icon = 132331, npcID = \"22848\"}, -- Storm Blink (Storm Fury)\n    [\"TRASH_ASHTONGUE_SWEEPINGWINGCLIP\"] = {icon = 132309, npcID = \"22847\"}, -- Wing Clip (Ashtongue Primalist)\n    [\"TRASH_ASHTONGUE_WYVERN\"] = {icon = 135125, npcID = \"22847\"}, -- Wyvern Sting (Ashtongue Primalist)\n    [\"TRASH_ASHTONGUE_BLIND\"] = {icon = 136175, npcID = \"23374\"}, -- Blind (Ashtongue Stalker)\n    [\"TRASH_SHADOWMOON_SPELLABSORPTION\"] = {icon = 135874, npcID = \"22879\"}, -- Spell Absorption (Shadowmoon Reaver)\n    [\"TRASH_SHADOWMOON_CHAOTICLIGHT\"] = {icon = 132338, npcID = \"22880\"}, -- Chaotic Light (Shadowmoon Champion)\n    [\"TRASH_SHADOWMOON_WHIRLINGBLADE\"] = {icon = 135568, npcID = \"22880\"}, -- Whirling Blade (Shadowmoon Champion)\n    [\"TRASH_SHADOWMOON_FREEZINGTRAP\"] = {icon = 135834, npcID = \"23018\"}, -- Freezing Trap (Shadowmoon Houndmaster)\n    [\"TRASH_SHADOWMOON_BLOODSIPHON\"] = {icon = 136168, npcID = \"22945\"}, -- Blood Siphon (Shadowmoon Blood-Mage)\n    [\"TRASH_SHADOWMOON_DEATHCOIL\"] = {icon = 136145, npcID = \"22882\"}, -- Death Coil (Shadowmoon Deathshaper)\n    [\"TRASH_WRATHBONE_IGNORED\"] = {icon = 132288, npcID = \"22953\"}, -- Ignored (Wrathbone Flayer)\n    [\"TRASH_WRATHBONE_CLEAVE\"] = {icon = 132338, npcID = \"22953\"}, -- Cleave (Wrathbone Flayer)\n    [\"TRASH_WEAPONMASTER_KNOCK\"] = {icon = 132939, npcID = \"23049\"}, -- Knock Away (Weapon Master)\n    [\"TRASH_WEAPONMASTER_WHIRLWIND\"] = {icon = 132369, npcID = \"23049\"}, -- Whirlwind (Weapon Master)\n    [\"TRASH_WEAPONMASTER_MUTILATE\"] = {icon = 132147, npcID = \"23049\"}, -- Mutilate (Weapon Master)\n    [\"TRASH_BONECHEWER_THROWSHIELD\"] = {icon = 135681, npcID = \"23236\"}, -- Throw Shield (Bonechewer Shield Disciple)\n    [\"TRASH_BONECHEWER_PROPHECY\"] = {icon = 136124, npcID = \"23237\"}, -- Prophecy of Blood (Bonechewer Blood Prophet)\n    [\"TRASH_BONECHEWER_WW\"] = {icon = 132369, npcID = \"23235\"}, -- Whirlwind\n    [\"TRASH_BEHEMOTH_CHARGE\"] = {icon = 132337, npcID = \"23196\"}, -- Charge (Bonechewer Behemoth)\n    [\"TRASH_BEHEMOTH_METEOR\"] = {icon = 135808, npcID = \"23196\"}, -- Meteor (Bonechewer Behemoth)\n    [\"TRASH_ARDENT_SLEEP\"] = {icon = 136090, npcID = \"22959\"}, -- Sleep (Ardent Host)\n    [\"TRASH_STEWARD_UPPERCUT\"] = {icon = 132939, npcID = \"22965\"}, -- Uppercut (Devoted Steward)\n    [\"TRASH_STEWARD_KIDNEY\"] = {icon = 132298, npcID = \"22965\"}, -- Kidney Shot (Devoted Steward)\n    [\"TRASH_DELIGHT_SHELL\"] = {icon = 135981, npcID = \"22964\"}, -- Shell of Life (Priestess of Delight)\n    [\"TRASH_TORMENT_SHELL\"] = {icon = 136121, npcID = \"22956\"}, -- Shell of Pain (Priestess of Torment)\n    [\"TRASH_DEMENTIA_DEMENTIA\"] = {icon = 135769, npcID = \"22957\"}, -- Dementia (Mistress of Dementia)\n    [\"TRASH_DEMENTIA_CONFUSION\"] = {icon = 136175, npcID = \"22957\"}, -- Confusion (Mistress of Dementia)\n    [\"TRASH_WOE_CURSE\"] = {icon = 132102, npcID = \"22962\"}, -- Curse of Vitality (Mistress of Woe)\n    [\"TRASH_ILLIDARI_BLIZZARD\"] = {icon = 135857, npcID = \"23402\"}, -- Blizzard (Illidari Battle-Mage)\n    [\"TRASH_ILLIDARI_FLAMESTRIKE\"] = {icon = 135826, npcID = \"23402\"}, -- Flamestrike (Illidari Battle-Mage)\n    [\"TRASH_ILLIDARI_HOJ\"] = {icon = 135963, npcID = \"23397\"}, -- Hammer of Justice\n    [\"TRASH_ILLIDARI_VANISH\"] = {icon = 132331, npcID = \"23403\"}, -- Vanish\n    [\"TRASH_SENTINEL_L5\"] = {icon = 135734, npcID = \"23394\"}, -- L5 Arcane Charge\n}\n\naura_env.guids = {}\naura_env.pending = {}\naura_env.nameplateGUIDs = {}\n\nfunction aura_env.getNPCID(guid)\n    return guid and select(6,strsplit(\"-\",guid))\nend\n\nfunction aura_env.refreshNameplates()\n    wipe(aura_env.nameplateGUIDs)\n    \n    for _,plateData in pairs(C_NamePlate.GetNamePlates()) do\n        local unit = plateData.UnitFrame.displayedUnit\n        if unit then\n            local guid = UnitGUID(unit)\n            if guid then\n                aura_env.nameplateGUIDs[unit] = guid\n            end\n        end\n    end\nend\n\nfunction aura_env.getNameplateUnit(guid)\n    for unit,plateGUID in pairs(aura_env.nameplateGUIDs) do\n        if plateGUID == guid then\n            return unit\n        end\n    end\n    \n    aura_env.refreshNameplates()\n    \n    for unit,plateGUID in pairs(aura_env.nameplateGUIDs) do\n        if plateGUID == guid then\n            return unit\n        end\n    end\nend\n\nfunction aura_env.hideState(allstates,guid,key)\n    local state = allstates[guid..\"_\"..key]\n    \n    if state and state.show then\n        state.show = false\n        state.changed = true\n        return true\n    end\n    return false\nend\n\nfunction aura_env.cancelState(allstates,guid,key)\n    if aura_env.guids[guid] then\n        aura_env.guids[guid][key] = nil\n        \n        if not next(aura_env.guids[guid]) then\n            aura_env.guids[guid] = nil\n        end\n    end\n    \n    return aura_env.hideState(allstates,guid,key)\nend\n\nfunction aura_env.cancelNPCState(allstates,key)\n    local info = aura_env.spellKeys[key]\n    if not info then\n        return false\n    end\n    \n    if aura_env.pending[info.npcID] then\n        aura_env.pending[info.npcID][key] = nil\n        \n        if not next(aura_env.pending[info.npcID]) then\n            aura_env.pending[info.npcID] = nil\n        end\n    end\n    \n    for guid,data in pairs(aura_env.guids) do\n        if aura_env.getNPCID(guid) == info.npcID and data[key] then\n            data[key] = nil\n            \n            local state = allstates[guid..\"_\"..key]\n            if state then\n                state.show = false\n                state.changed = true\n            end\n            \n            if not next(data) then\n                aura_env.guids[guid] = nil\n            end\n        end\n    end\n    \n    return true\nend\n\nfunction aura_env.showState(allstates,guid,key,spellData,unit)\n    allstates[guid..\"_\"..key] = {\n        show = true,\n        changed = true,\n        progressType = \"timed\",\n        duration = spellData.duration,\n        expirationTime = spellData.expirationTime,\n        unit = unit,\n        autoHide = false,\n        icon = spellData.icon,\n        count = spellData.count,\n    }\n    \n    return true\nend\n\nfunction aura_env.updateState(allstates,key,time,count,guid)\n    local info = aura_env.spellKeys[key]\n    if not info then\n        return false\n    end\n    \n    local spellData = {\n        duration = time,\n        expirationTime = GetTime()+time,\n        icon = info.icon,\n        count = count,\n    }\n    \n    if guid then\n        if aura_env.getNPCID(guid) ~= info.npcID then\n            return false\n        end\n        \n        aura_env.guids[guid] = aura_env.guids[guid] or {}\n        aura_env.guids[guid][key] = spellData\n        \n        local unit = aura_env.getNameplateUnit(guid)\n        if unit then\n            return aura_env.showState(allstates,guid,key,spellData,unit)\n        end\n        return false\n    end\n    \n    aura_env.refreshNameplates()\n    \n    for unit,plateGUID in pairs(aura_env.nameplateGUIDs) do\n        if aura_env.getNPCID(plateGUID) == info.npcID then\n            aura_env.guids[plateGUID] = aura_env.guids[plateGUID] or {}\n            aura_env.guids[plateGUID][key] = spellData\n            return aura_env.showState(allstates,plateGUID,key,spellData,unit)\n        end\n    end\n    \n    aura_env.pending[info.npcID] = aura_env.pending[info.npcID] or {}\n    aura_env.pending[info.npcID][key] = spellData\n    return false\nend\n\nfunction aura_env.reset(allstates)\n    wipe(aura_env.guids)\n    wipe(aura_env.pending)\n    wipe(aura_env.nameplateGUIDs)\n    \n    for _,state in pairs(allstates) do\n        state.show = false\n        state.changed = true\n    end\n    \n    return true\nend",
["do_custom"] = true,
},
