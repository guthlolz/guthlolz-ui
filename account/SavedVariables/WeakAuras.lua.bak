["endAngle"] = 360,
["sparkRotationMode"] = "AUTO",
["cooldownEdge"] = false,
["desaturateForeground"] = false,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["custom_type"] = "stateupdate",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(allstates,event,key,cooldown,count,guid,text,_,_,_,emphasizeGUID)\n    if event == \"OPTIONS\" then\n        for i = 1,6 do\n            local rnd = i + 5\n            allstates[i] = {\n                show = true,\n                name = \"Deep Breath \" .. i,\n                duration = rnd,\n                expirationTime = GetTime() + rnd,\n                progressType = \"timed\",\n            }\n        end\n        return true\n    end\n    \n    if event == \"STATUS\" then\n        for key,timer in pairs(aura_env.timers) do\n            if timer then\n                timer:Cancel()\n            end\n        end\n    end\n    \n    if event == \"WA_NUMEN_TIMER\" and aura_env.spellKeys[key] then\n        local cfg = aura_env.config.option.enabledGroup\n        \n        if not cfg[key] then\n            return false\n        end\n        \n        if cooldown == nil or cooldown == 0 then\n            aura_env.cancelTimer(key,guid)\n            aura_env.hideState(allstates,key,guid)\n            return true\n        end\n        \n        local bar = aura_env.spellKeys[key]\n        local roleRestrict = bar.roleRestrict\n        \n        if roleRestrict and bar.role then\n            local playerRole = UnitGroupRolesAssigned(\"player\")\n            local isRL = UnitIsGroupLeader(\"player\")\n            local allowed = false\n            \n            if bar.includeRL and isRL then\n                allowed = true\n            elseif type(bar.role) == \"table\" then\n                for _,r in ipairs(bar.role) do\n                    if r == playerRole then\n                        allowed = true\n                        break\n                    end\n                end\n            else\n                allowed = bar.role == playerRole\n            end\n            \n            if not allowed then\n                return false\n            end\n        end\n        \n        local name,icon = bar.name,bar.icon\n        local color = aura_env.getColor(key)\n        local autoHide = bar.autoHide or false\n        local roleIcon = \"\"\n        \n        if bar.role then\n            local roles = type(bar.role) == \"table\" and bar.role or {bar.role}\n            local firstRole = roles[1]\n            \n            if firstRole == \"TANK\" then\n                roleIcon = \"|A:groupfinder-icon-role-large-tank:16:16|a \"\n            elseif firstRole == \"HEALER\" then\n                roleIcon = \"|A:groupfinder-icon-role-large-heal:16:16|a \"\n            end\n        end\n        \n        local displayName = roleIcon .. name\n        local useText = bar.useText or false\n        local extraText = useText and (text or \"\") or nil\n        local emphasized = cfg[\"EMP_\" .. key] or false\n        local tts = cfg[\"TTS_\" .. key] or false\n        \n        if emphasized then\n            if cooldown <= 10 then\n                WeakAuras.ScanEvents(\"WA_NUMEN_EMPHASIZED_TIMER\",key,cooldown,count,displayName,icon,color,autoHide,extraText,guid,tts)\n            else\n                aura_env.updateState(allstates,key,cooldown,count,displayName,icon,color,autoHide,extraText,guid)\n                aura_env.scheduleTimer(key,cooldown - 10,count,displayName,icon,color,autoHide,extraText,guid,tts)\n                return true\n            end\n        else\n            aura_env.updateState(allstates,key,cooldown,count,displayName,icon,color,autoHide,extraText,guid)\n            return true\n        end\n    elseif event == \"WA_NUMEN_EMPHASIZED_TIMER\" and aura_env.spellKeys[key] then\n        aura_env.hideState(allstates,key,emphasizeGUID)\n        return true\n    end\nend",
["events"] = "WA_NUMEN_TIMER, WA_NUMEN_EMPHASIZED_TIMER, STATUS, OPTIONS",
["spellIds"] = {
},
