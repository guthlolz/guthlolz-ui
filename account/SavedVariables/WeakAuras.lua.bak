["value"] = "function(states)\n    local enabled = aura_env.config.highlightExpensive;\n    if not enabled then return false; end\n    \n    local thresh = tonumber(aura_env.config.highlightThreshold);\n    local unit = aura_env.config.highlightUnit;\n    \n    thresh = thresh * (100 ^ (unit - 1));\n    \n    return (tonumber(states[1].price) >= thresh) or (tonumber(states[1].AH) and tonumber(states[1].rarity) > 0 and tonumber(states[1].AH) >= thresh);\nend",
