[13033] = 817, -- [Mage] Ice Barrier (Rank 4)\n    [27134] = 952, -- [Mage] Ice Barrier (Rank 5)\n    [33405] = 1075, -- [Mage] Ice Barrier (Rank 6)\n    [26470] = 0, -- [Mage] Persistent Shield\n    [17729] = 649, -- [Warlock] Greater Spellstone\n    [17730] = 899, -- [Warlock] Major Spellstone\n    [128] = 399, -- [Warlock] Spellstone\n    [7812] = 304, -- [Warlock] Sacrifice (Rank 1)\n    [19438] = 509, -- [Warlock] Sacrifice (Rank 2)\n    [19440] = 769, -- [Warlock] Sacrifice (Rank 3)\n    [19441] = 1094, -- [Warlock] Sacrifice (Rank 4)\n    [19442] = 1469, -- [Warlock] Sacrifice (Rank 5)\n    [19443] = 1904, -- [Warlock] Sacrifice (Rank 6)\n    [27273] = 2900, -- [Warlock] Sacrifice (Rank 7)\n}\n\nfunction aura_env.COMBAT_LOG_EVENT_UNFILTERED(allStates, ...)\n    local _, subEvent, _, _, _, _, _, destGUID = ...\n    \n    if destGUID ~= WeakAuras.myGUID then\n        return false\n    end\n    \n    if subEvent == \"SPELL_AURA_REMOVED\" then\n        local spellId = select(12, ...)\n        if aura_env.absorbSpells[spellId] then\n            WeakAuras.ScanEvents(\"WA_FJI_ABSORB_REMOVED\", spellId)\n        end\n        return\n    end\n    \n    if subEvent == \"SPELL_AURA_APPLIED\" or subEvent == \"SPELL_AURA_REFRESH\" then\n        local spellId = select(12, ...)\n        if aura_env.absorbSpells[spellId] then\n            WeakAuras.ScanEvents(\"WA_FJI_ABSORB_APPLIED\", aura_env.absorbSpells[spellId], spellId)\n        end\n        return\n    end\n    \n    if subEvent == \"SPELL_ABSORBED\" then\n        local spellId, amount\n        \n        if select(20, ...) then -- SPELL_DAMAGE\n            spellId = select(19, ...)\n            amount = select(22, ...) or 0\n        else\n            spellId = select(16, ...) -- SWING_DAMAGE\n            amount = select(19, ...) or 0\n        end\n        \n        if aura_env.absorbSpells[spellId] then\n            WeakAuras.ScanEvents(\"WA_FJI_ABSORB_UPDATE\", amount, spellId)\n        end\n    end\nend\n\n\nfunction aura_env.OPTIONS(allStates)\n    return\nend\n\nfunction aura_env.STATUS(allStates)\n    for i = 1, 255 do\n        local _,_,_,_,_,_,_,_,_,spellId = UnitBuff(\"player\", i)\n        if aura_env.absorbSpells[spellId] then\n            WeakAuras.ScanEvents(\"WA_FJI_ABSORB_APPLIED\", aura_env.absorbSpells[spellId], spellId)\n        end\n    end\nend\n\n\n\n",
["do_custom"] = true,
},
