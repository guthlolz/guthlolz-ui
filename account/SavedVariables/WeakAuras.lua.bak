["CT:[BT][Akama] Combat End"] = {
["outline"] = "OUTLINE",
["wagoID"] = "pbbuhQ899",
["parent"] = "[BT][Akama]",
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiBT-P1/12",
["actions"] = {
["start"] = {
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "local locale = GetLocale()\n\naura_env.locales = {\n    [\"enUS\"] = {\n        deadge = \"No! Not yet!\",\n    },\n    [\"frFR\"] = {\n        deadge = \"No! Not yet!\",\n    },\n    [\"deDE\"] = {\n        deadge = \"No! Not yet!\",\n    },\n    [\"esES\"] = {\n        deadge = \"No! Not yet!\",\n    },\n    [\"koKR\"] = {\n        deadge = \"No! Not yet!\",\n    },\n    [\"ruRU\"] = {\n        deadge = \"No! Not yet!\",\n    },\n    [\"zhCN\"] = {\n        deadge = \"No! Not yet!\",\n    },\n    [\"zhTW\"] = {\n        deadge = \"No! Not yet!\",\n    }\n}\n\naura_env.currentLocale = aura_env.locales[locale] or aura_env.locales[\"enUS\"]",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "aura_env.count = 1\naura_env.nuTimer(nil)\naura_env.preWarnCancel()",
["do_sound"] = false,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
["do_message"] = false,
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "CHAT_MSG_MONSTER_YELL, ZONE_CHANGED_INDOORS, ZONE_CHANGED",
["spellIds"] = {
},
["custom"] = "function(allstates,event,msg)\n    if event == \"CHAT_MSG_MONSTER_YELL\" then\n        if msg:find(aura_env.currentLocale.deadge) or msg == aura_env.currentLocale.deadge then\n            WeakAuras.ScanEvents(\"WA_FJI_AKAMA_KILLED\")\n            WeakAuras.ScanEvents(\"WA_FJI_AKAMA_RESPAWN\")\n            WeakAuras.ScanEvents(\"WA_FJI_ENCOUNTER_END\")\n            return true\n        end\n    end\n    \n    if event == \"ZONE_CHANGED_INDOORS\" or event == \"ZONE_CHANGED\" or event == \"STATUS\" then\n        WeakAuras.ScanEvents(\"WA_FJI_AKAMA_KILLED\")\n        return true\n    end\nend",
