{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["event"] = "Combat Log",
["unit"] = "player",
["customVariables"] = "{\n    expirationTime = true,\n}",
["events"] = "CLEU:SPELL_CAST_SUCCESS UNIT_POWER_UPDATE:player",
["subeventPrefix"] = "",
["check"] = "event",
["custom"] = "function(a,e,unit,powerType,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId)\n    if e == \"UNIT_POWER_UPDATE\" then\n        if powerType ~= \"MANA\" then\n            return false\n        end\n        \n        if not a[\"\"] then\n            return false\n        end\n        \n        local mana = UnitPower(\"player\", Enum.PowerType.Mana)\n        local gained = mana - aura_env.lastMana\n        \n        if gained < aura_env.minManaGain then\n            return false\n        end\n        \n        aura_env.lastMana = mana\n        local tickRate = aura_env.getTickRate()\n        \n        a[\"\"].changed = true\n        a[\"\"].duration = tickRate\n        a[\"\"].expirationTime = GetTime() + tickRate\n        return true\n    end\n    \n    if sourceGUID ~= WeakAuras.myGUID then\n        return false\n    end\n    \n    if spellId ~= aura_env.spellID then\n        return false\n    end\n    \n    aura_env.lastMana = UnitPower(\"player\", Enum.PowerType.Mana)\n    local tickRate = aura_env.getTickRate()\n    \n    a[\"\"] = {\n        show = true,\n        changed = true,\n        progressType = \"timed\",\n        duration = tickRate,\n        expirationTime = GetTime() + tickRate,\n    }\n    return true\nend",
