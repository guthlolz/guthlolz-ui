["custom"] = "C_VoiceChat.SpeakText(_G.FJITTS_SFX_VOICEID, \"Fear\", Enum.VoiceTtsDestination.LocalPlayback, _G.FJITTS_SFX_RATE, _G.FJITTS_SFX_VOLUME)",
["do_sound"] = false,
