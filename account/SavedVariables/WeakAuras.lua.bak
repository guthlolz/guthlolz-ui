["custom_type"] = "stateupdate",
["subeventPrefix"] = "SPELL",
["spellIds"] = {
},
["events"] = "UNIT_SPELLCAST_SUCCEEDED, CLEU:SPELL_CAST_SUCCESS",
["check"] = "event",
["custom"] = "function(allstates,event,...)\n    if event == \"OPTIONS\" then\n        for i = 1,3 do\n            allstates[i] = {\n                show = true,\n                changed = true,\n                progressType = \"static\",\n                name = WeakAuras.me,\n            }\n        end\n        return true\n    end\n    \n    if event == \"UNIT_SPELLCAST_SUCCEEDED\" then\n        local unit,_,spellId = ...\n        \n        if spellId ~= 6247 then\n            return false\n        end\n        if GetTime() - aura_env.throttle < 1 then\n            return false\n        end\n        aura_env.throttle = GetTime()\n        \n        local name = UnitName(unit)\n        allstates[name] = {\n            show = true,\n            changed = true,\n            progressType = \"static\",\n            name = name,\n        }\n        return true\n    end\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local _,subEvent,_,sourceGUID,sourceName,_,_,_,_,_,_,spellId = ...\n        if spellId ~= 39948 then\n            return false\n        end\n        \n        if allstates[sourceName] then\n            allstates[sourceName].show = false\n            allstates[sourceName].changed = true\n            return true\n        end\n    end\n    return false\nend",
["unit"] = "player",
["debuffType"] = "HELPFUL",
},
