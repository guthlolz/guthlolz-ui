["names"] = {
},
["duration"] = "20",
["event"] = "Health",
["unit"] = "player",
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, key, time, count)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 12.5,\n            expirationTime = GetTime() + 12.5,\n            progressType = \"timed\",\n            icon = 135808,\n            autoHide = true,\n        }\n        return true\n    end\n    \n    if event == \"WA_FJI_ENCOUNTER_END\" or event == \"ENCOUNTER_END\" then\n        if allstates[\"\"] then\n            allstates[\"\"].show = false\n            allstates[\"\"].changed = true\n            return true\n        end\n    end\n    \n    if event == \"WA_NUMEN_TIMER\" and key == \"ALAR_DIVE_BOMB\" then\n        if time == 0 then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = 12.5,\n                expirationTime = GetTime() + 12.5,\n                progressType = \"timed\",\n                icon = 135808,\n                autoHide = true,\n            }\n        elseif time == nil then\n            if allstates[\"\"] then\n                allstates[\"\"].show = false\n                allstates[\"\"].changed = true\n            end\n        end\n        return true\n    end\nend",
["events"] = "WA_NUMEN_TIMER, WA_FJI_ENCOUNTER_END, ENCOUNTER_END",
["spellIds"] = {
},
["check"] = "event",
["custom_type"] = "stateupdate",
