["glow_color"] = {
1,
0.96078437566757,
0.41176474094391,
1,
},
["glow_action"] = "show",
},
["finish"] = {
["hide_all_glows"] = true,
["custom"] = "aura_env.nameplates = {}",
["do_custom"] = true,
},
["init"] = {
["custom"] = "aura_env.nameplates = {}\naura_env.whitelistSpells = {\n    [22482] = true,\n}",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["names"] = {
},
["spellIds"] = {
},
["custom"] = "function(allstates,event,unit,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId)\n    \n    if event == \"NAME_PLATE_UNIT_REMOVED\" then\n        if allstates[unit] then\n            allstates[unit].show = false\n            allstates[unit].changed = true\n            return true\n        end\n    end\n    \n    if not aura_env.whitelistSpells[spellId] then\n        return false\n    end\n    \n    if sourceGUID ~= WeakAuras.myGUID then\n        return false\n    end\n    \n    if subEvent == \"SPELL_DAMAGE\" then\n        for _, plateData in pairs(C_NamePlate.GetNamePlates()) do\n            local unit = plateData.UnitFrame.displayedUnit\n            local unitGUID = UnitGUID(unit)\n            if destGUID == unitGUID then\n                allstates[unit] = {\n                    show = true,\n                    changed = true,\n                    progressType = \"timed\",\n                    duration = 1.5,\n                    expirationTime = GetTime() + 1.5,\n                    unit = unit,\n                    autoHide = true,\n                }\n                return true\n            end\n        end\n        return false\n    end\nend",
["events"] = "CLEU:SPELL_DAMAGE NAME_PLATE_UNIT_ADDED NAME_PLATE_UNIT_REMOVED",
["check"] = "event",
["unit"] = "player",
["customVariables"] = "{\n    expirationTime = \"number\",\n}",
["custom_hide"] = "timed",
},
["untrigger"] = {
},
},
["disjunctive"] = "custom",
["customTriggerLogic"] = "function(t)\n    return t[1] and aura_env.config.glow\nend",
["activeTriggerMode"] = -10,
},
["displayText_format_p_time_mod_rate"] = true,
