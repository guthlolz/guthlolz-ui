["unit"] = "player",
["subeventSuffix"] = "_CAST_START",
["spellIds"] = {
},
["custom"] = "function(allstates, event)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\shahraz.jpg\",\n            count = math.random(1,5),\n        }\n    end\n    if event == \"WA_MOTHER_SHAHRAZ_ENRAGED\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            progressType = \"timed\",\n            icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\shahraz.jpg\",\n            autoHide = true,\n        }\n        return true\n    end\nend",
["events"] = "WA_MOTHER_SHAHRAZ_ENRAGED",
["check"] = "event",
