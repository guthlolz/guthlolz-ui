["icon_side"] = "LEFT",
["customText"] = "function()\n    local defBonus  = GetDodgeBlockParryChanceFromDefense()\n    local fullMiss  = defBonus + 5\n    local fullDodge = GetDodgeChance()\n    local parry     = GetParryChance()\n    local block     = GetBlockChance()\n    \n    -- SWP bosses ignore base 5% miss and first 20% dodge\n    local swpMiss  = fullMiss - 5              -- strip base miss, keep only defense-skill miss\n    local swpDodge = math.max(fullDodge - 20, 0)  -- only dodge ABOVE 20% counts\n    \n    local swpTotal  = swpMiss + swpDodge + parry + block\n    local crushCap  = 102.4\n    \n    if swpTotal >= crushCap then\n        return string.format(\"|cff00ff00%.2f / 102.4|r\", swpTotal)\n    else\n        return string.format(\"|cffff0000%.2f / 102.4|r\", swpTotal)\n    end\nend",
