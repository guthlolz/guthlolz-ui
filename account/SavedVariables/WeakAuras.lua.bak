["unit"] = "player",
["custom"] = "function(allstates, event, ...)\n    if event == \"CHAT_MSG_MONSTER_YELL\" then\n        local msg = ...\n        \n        if msg and (msg:find(aura_env.currentLocale.thrallDeath) or msg == aura_env.currentLocale.thrallDeath) then\n            aura_env.startTimer()\n            aura_env.showState(allstates)\n            _G.SyncEvents(\"RAID\", nil, \"WA_FJI_HYJAL_THRALL_DEATH\")\n            return true\n        end\n    end\n    \n    if event == \"WA_FJI_HYJAL_THRALL_DEATH\" then\n        if aura_env.hasActiveTimer() or allstates[\"\"] then\n            return false\n        end\n        \n        aura_env.startTimer()\n        return aura_env.showState(allstates)\n    end\n    \n    if event == \"STATUS\" then\n        return aura_env.showState(allstates)\n    end\nend",
