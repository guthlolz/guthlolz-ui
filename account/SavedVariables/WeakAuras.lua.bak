["cooldownSwipe"] = true,
["url"] = "https://wago.io/FojjiT5RaidPack/3",
["actions"] = {
["start"] = {
},
["finish"] = {
},
["init"] = {
["custom"] = "aura_env.guids = {}\n\naura_env.icons = {\n    FROST  = 135846,\n    FIRE   = 135812,\n    ARCANE = 135735,\n}",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["subeventSuffix"] = "_CAST_START",
["events"] = "PLAYER_REGEN_ENABLED, NAME_PLATE_UNIT_ADDED, NAME_PLATE_UNIT_REMOVED, WA_NETHER_MAGE_ABILITIES_DETECT",
["custom"] = "function(a, event, ...)\n    if event == \"OPTIONS\" then\n        local type = \"FROST\"\n        \n        a[\"\"] = {\n            show = true,\n            changed = true,\n            name = type,\n            icon = aura_env.icons[type],\n        }\n        return true\n    end\n    \n    if event == \"WA_NETHER_MAGE_ABILITIES_DETECT\" then\n        local type, guid = ...\n        if not guid then\n            return false\n        end\n        \n        aura_env.guids[guid] = type\n        \n        for _, plateData in pairs(C_NamePlate.GetNamePlates()) do\n            local unit = plateData.UnitFrame and plateData.UnitFrame.displayedUnit\n            if unit and UnitGUID(unit) == guid then\n                a[guid] = {\n                    show = true,\n                    changed = true,\n                    name = type,\n                    icon = aura_env.icons[type],\n                    unit = unit,\n                    guid = guid,\n                }\n                return true\n            end\n        end\n        \n        return false\n    end\n    \n    if event == \"NAME_PLATE_UNIT_ADDED\" then\n        local unit = ...\n        local guid = unit and UnitGUID(unit)\n        \n        if guid and aura_env.guids[guid] then\n            local type = aura_env.guids[guid]\n            \n            a[guid] = {\n                show = true,\n                changed = true,\n                name = type,\n                icon = aura_env.icons[type],\n                unit = unit,\n                guid = guid,\n            }\n            return true\n        end\n        \n        return false\n    end\n    \n    if event == \"NAME_PLATE_UNIT_REMOVED\" then\n        local unit = ...\n        local guid = unit and UnitGUID(unit)\n        \n        if guid and a[guid] then\n            a[guid].show = false\n            a[guid].changed = true\n            a[guid].unit = nil\n            return true\n        end\n        \n        return false\n    end\n    \n    if event == \"PLAYER_REGEN_ENABLED\" then\n        for _, state in pairs(a) do\n            state.show = false\n            state.changed = true\n            state.unit = nil\n        end\n        \n        wipe(aura_env.guids)\n        return true\n    end\nend",
["subeventPrefix"] = "SPELL",
