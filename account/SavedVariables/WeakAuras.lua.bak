["parent"] = "[BT]: Special Alerts",
["customText"] = "",
["shadowYOffset"] = -1,
["displayText_format_value_format"] = "none",
["cooldownSwipe"] = true,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["triggers"] = {
{
["trigger"] = {
["debuffType"] = "HELPFUL",
["type"] = "custom",
["unit"] = "player",
["custom_type"] = "stateupdate",
["names"] = {
},
["duration"] = "",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["spellIds"] = {
},
["events"] = "WA_NAJENTUS_SHIELD_PREWARN, WA_NAJENTUS_SHIELD_REMOVED, ENCOUNTER_END, WA_FJI_ENCOUNTER_END, WA_NAJENTUS_SHIELD_CHECK",
["custom"] = "function(allstates,event,...)\n    if event == \"OPTIONS\" then\n        if aura_env.ticker then\n            aura_env.ticker:Cancel()\n            aura_env.ticker = nil\n        end\n        \n        local safe = math.random(1,2) == 1\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            total = 25,\n            value = safe and 25 or math.random(1,25),\n            safe = safe,\n        }\n        return true\n    end\n    \n    if event == \"STATUS\" then\n        if aura_env.ticker then\n            aura_env.ticker:Cancel()\n            aura_env.ticker = nil\n        end\n        return false\n    end\n    \n    if event == \"WA_NAJENTUS_SHIELD_PREWARN\" then\n        if aura_env.ticker then\n            aura_env.ticker:Cancel()\n        end\n        \n        aura_env.ticker = C_Timer.NewTicker(0.2,function()\n                WeakAuras.ScanEvents(\"WA_NAJENTUS_SHIELD_CHECK\")\n        end)\n        \n        WeakAuras.ScanEvents(\"WA_NAJENTUS_SHIELD_CHECK\")\n        return false\n    end\n    \n    if event == \"WA_NAJENTUS_SHIELD_CHECK\" then\n        local total = 0\n        local value = 0\n        \n        for i = 1,GetNumGroupMembers() do\n            local name,_,subgroup = GetRaidRosterInfo(i)\n            \n            if name and subgroup and subgroup <= 5 then\n                total = total+1\n                \n                if UnitHealth(\"raid\"..i) > 8500 then\n                    value = value+1\n                end\n            end\n        end\n        \n        local safe = value == total\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            total = total,\n            value = value,\n            safe = safe,\n        }\n        \n        if safe then\n            WeakAuras.ScanEvents(\"WA_SHIELD_NAJENTUS_SAFE\")\n        else\n            WeakAuras.ScanEvents(\"WA_NAJENTUS_SHIELD_UNSAFE\")\n        end\n        \n        return true\n    end\n    \n    if event == \"WA_NAJENTUS_SHIELD_REMOVED\" or event == \"ENCOUNTER_END\" or event == \"WA_FJI_ENCOUNTER_END\" then\n        if aura_env.ticker then\n            aura_env.ticker:Cancel()\n            aura_env.ticker = nil\n        end\n        \n        if allstates[\"\"] then\n            allstates[\"\"].show = false\n            allstates[\"\"].changed = true\n            return true\n        end\n        \n        return false\n    end\nend",
["customIcon"] = "function()\n    return 135789\nend",
["check"] = "event",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["customVariables"] = "{\n    safe = \"bool\",\n}",
},
