["subeventSuffix"] = "_CAST_START",
["check"] = "event",
["custom"] = "-- Create a macro with the following line of code:\n-- /run WeakAuras.ScanEvents(\"AUTO_FIND_TOGGLE\")\n--\n-- This will toggle a variable that will essentially \n-- allow the remaining toggle function to operate.\n\nfunction()\n    local toggleStatus\n    if WeakAuras.IsOptionsOpen() then return end\n    aura_env.toggled = not aura_env.toggled\n    if aura_env.toggled == true then\n        toggleStatus = \"On\"\n    else\n        toggleStatus = \"Off\"\n    end\n    print(\"Auto Find Toggled \" .. toggleStatus)\n    return aura_env.toggled\nend\n\n\n\n",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
