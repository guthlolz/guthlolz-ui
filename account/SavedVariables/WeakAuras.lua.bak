["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["custom_hide"] = "timed",
["duration"] = "5",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["subeventSuffix"] = "_CAST_START",
["custom"] = "function(a,e,eID,_,_,_,success)\n    if e == \"OPTIONS\" then\n        for _, v in pairs(aura_env.encounters) do\n            local data = v and v[1]\n            if data and data.itemIDs and data.itemIDs[1] then\n                return aura_env.updateState(a, data, data.itemIDs[1], true)\n            end\n        end\n        return false\n    end\n    \n    if e == \"ENCOUNTER_END\" then\n        if success ~= 1 then\n            return false\n        end\n        \n        local list = aura_env.encounters[eID]\n        if not list then\n            return false\n        end\n        \n        for idx = 1, #list do\n            local data = list[idx]\n            \n            if aura_env.isOnQuest(data.questIDs) and not aura_env.isQuestCompleted(data.questIDs) then\n                for i = 1, #data.itemIDs do\n                    local itemID = data.itemIDs[i]\n                    if aura_env.missingItem(itemID) then\n                        aura_env.updateState(a, data, itemID)\n                    end\n                end\n            end\n        end\n        \n        return true\n    end\n    \n    if e == \"BAG_UPDATE_DELAYED\" then\n        for key, state in pairs(a) do\n            if state and state.show and state.itemID then\n                if not aura_env.missingItem(state.itemID) then\n                    state.show = false\n                    state.changed = true\n                end\n            end\n        end\n        return true\n    end\n    \n    return false\nend",
