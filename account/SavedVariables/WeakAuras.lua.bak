["actions"] = {
["start"] = {
["custom"] = "",
["do_custom"] = false,
["sound"] = "Interface\\Addons\\FojjiCore\\sound\\Mario Coin.ogg",
["do_sound"] = true,
},
["finish"] = {
},
["init"] = {
["custom"] = "aura_env.encounters = {\n    [618] = {\n        { questName = \"Attunement\", itemIDs = {32459}, questIDs = {10947} },\n    },\n}\n\nfunction aura_env.getFirst()\n    for _, list in pairs(aura_env.encounters) do\n        local data = list and list[1]\n        if data and data.itemIDs and data.itemIDs[1] then\n            return data.itemIDs[1]\n        end\n    end\nend\n\nfunction aura_env.isOnQuest(questIDs)\n    for i = 1, #questIDs do\n        if C_QuestLog.IsOnQuest(questIDs[i]) then\n            return true\n        end\n    end\n    return false\nend\n\nfunction aura_env.isQuestCompleted(questIDs)\n    for i = 1, #questIDs do\n        if C_QuestLog.IsQuestFlaggedCompleted(questIDs[i]) then\n            return true\n        end\n    end\n    return false\nend\n\nfunction aura_env.missingItem(itemID)\n    return C_Item.GetItemCount(itemID, false) == 0\nend\n\nfunction aura_env.updateState(a, data, itemID, force)\n    local icon = C_Item.GetItemIconByID(itemID)\n    \n    a[data.questName] = {\n        show = force or aura_env.missingItem(itemID),\n        changed = true,\n        progressType = \"timed\",\n        duration = 10,\n        expirationTime = GetTime() + 10,\n        autoHide = true,\n        icon = icon,\n        itemID = itemID,\n        questName = data.questName,\n    }\n    return true\nend",
["do_custom"] = true,
},
},
