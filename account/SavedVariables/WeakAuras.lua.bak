["init"] = {
["custom"] = "aura_env.command = \"!fojjiT5\"\naura_env.respond = \"WA_FJI_T5_VERSION_CHECK_RESPOND\"\naura_env.request = \"WA_FJI_T5_VERSION_CHECK_REQUEST\"",
["do_custom"] = true,
