},
["subeventPrefix"] = "SPELL",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["custom"] = "function(a, e, guid)\n    if e == \"OPTIONS\" then\n        a[\"\"] = {\n            show = true,\n            changed = true,\n            icon = 135825,\n        }\n        return true\n    end\n    \n    if e == \"WA_FJI_ENCOUNTER_END\" or e == \"ENCOUNTER_END\" then\n        for _, state in pairs(a) do\n            state.show = false\n            state.changed = true\n        end\n        return true\n    end\n    \n    if e == \"WA_KARATHRESS_SPITFIRE_TOTEM\" then\n        a[guid] = {\n            show = true,\n            changed = true,\n            icon = 135825,\n        }\n        return true\n    end\n    \n    if e == \"WA_KARATHRESS_SPITFIRE_TOTEM_DIED\" then\n        if a[guid] then\n            a[guid].show = false\n            a[guid].changed = true\n            return true\n        end\n    end\nend",
["events"] = "WA_KARATHRESS_SPITFIRE_TOTEM, WA_KARATHRESS_SPITFIRE_TOTEM_DIED, ENCOUNTER_END, WA_FJI_ENCOUNTER_END",
