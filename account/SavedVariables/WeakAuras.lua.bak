["events"] = "ENCOUNTER_START, WA_FJI_ENCOUNTER_START, ENCOUNTER_END, WA_FJI_ENCOUNTER_END, RAID_BOSS_EMOTE",
["spellIds"] = {
},
["custom"] = "function(allstates,event,...)\n    if event == \"WA_FJI_ENCOUNTER_START\" or event == \"ENCOUNTER_START\" then\n        local eID = ...\n        if eID ~= 607 then\n            return false\n        end\n        \n        aura_env.isEnrage = false\n        return false\n    elseif event == \"WA_FJI_ENCOUNTER_END\" or event == \"ENCOUNTER_END\" then\n        aura_env.isEnrage = false\n        return false\n    end\n    \n    if event == \"RAID_BOSS_EMOTE\" then\n        local msg,source = ...\n        \n        if aura_env.isEnrage then\n            return false\n        end\n        \n        if (source or \"\") == aura_env.currentLocale.name then\n            aura_env.isEnrage = true\n            WeakAuras.ScanEvents(\"WA_MOTHER_SHAHRAZ_ENRAGED\")\n            return false\n        end\n    end\nend",
