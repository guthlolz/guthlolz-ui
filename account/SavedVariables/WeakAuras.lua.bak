["custom"] = "function(allstates, event)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            icon = 136231,\n            count = math.random(1,5),\n        }\n    end\n    if event == \"WA_MOROGRIM_PIERCE_ARMOR_APPLIED\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            progressType = \"timed\",\n            icon = 136231,\n            autoHide = true,\n        }\n        return true\n    end\nend",
