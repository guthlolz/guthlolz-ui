["use_hand"] = true,
["names"] = {
},
["subeventPrefix"] = "SPELL",
["use_unit"] = true,
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
},
},
{
["trigger"] = {
["type"] = "custom",
["use_incombat"] = true,
["custom_type"] = "stateupdate",
["event"] = "Conditions",
["use_unit"] = true,
["customDuration"] = "function()\n      local start, duration = GetSpellCooldown(29515)\n      if not start or duration == 0 then return 0, 0 end\n      return duration, start + duration\n  end",
["custom_hide"] = "timed",
["custom"] = "function(allstates, event, ...)\n    if event == \"SWING_TIMER_START\" or event == \"SWING_TIMER_UPDATE\" then\n        local speed, expirationTime, hand = ...\n        if hand == \"mainhand\" and speed and expirationTime then\n            aura_env.swingSpeed = speed\n            aura_env.swingExpiration = expirationTime\n        end\n    end\n    \n    local start, duration = GetSpellCooldown(29515)\n    if start and duration > 0 and (start + duration) - GetTime() > 0 then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = duration,\n            expirationTime = start + duration,\n            autoHide = true,\n        }\n        return true\n    end\n    \n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\n    return false\nend",
["dynamicDuration"] = true,
["check"] = "event",
["unit"] = "player",
["events"] = "SPELL_UPDATE_COOLDOWN SWING_TIMER_START SWING_TIMER_UPDATE",
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
["custom"] = "function()\n    return true\nend",
},
},
{
["trigger"] = {
["type"] = "spell",
["use_genericShowOn"] = true,
["genericShowOn"] = "showOnCooldown",
["unit"] = "player",
["realSpellName"] = 0,
["use_spellName"] = true,
["spellName"] = 0,
["event"] = "Global Cooldown",
["use_unit"] = true,
["use_track"] = true,
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
