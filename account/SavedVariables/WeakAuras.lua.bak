["unit"] = "player",
["events"] = "ENCOUNTER_END, WA_FJI_ENCOUNTER_END, WA_NUMEN_TIMER, WA_NUMEN_EMPHASIZED_TIMER",
["spellIds"] = {
},
["custom"] = "function(allstates, event, key, cooldown, count, name, icon, color, autoHide, text, guid, tts)\n    if event == \"OPTIONS\" then\n        for i = 1, 3 do\n            local stateKey = \"LaserAttack_\" .. i\n            allstates[stateKey] = {\n                show = true,\n                name = \"Laser Attack \" .. i,\n                progressType = \"timed\",\n                duration = 6,\n                expirationTime = GetTime() + 6,\n                index = i,\n            }\n        end\n        return true\n    end\n    \n    if event == \"WA_NUMEN_EMPHASIZED_TIMER\" and cooldown ~= nil and cooldown ~= 0 then\n        aura_env.updateState(allstates, key, cooldown, count, name, icon, color, autoHide, text or \"\", guid, tts)\n        return true\n    elseif event == \"WA_NUMEN_TIMER\" and (cooldown == nil or cooldown == 0) then\n        aura_env.hideState(allstates, key, guid)\n        return true\n    elseif event == \"ENCOUNTER_END\" or event == \"WA_FJI_ENCOUNTER_END\" then\n        for _, state in pairs(allstates) do\n            state.show = false\n            state.changed = true\n        end\n        return true\n    end\nend",
["check"] = "event",
