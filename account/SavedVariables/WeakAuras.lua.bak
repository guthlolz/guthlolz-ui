["icon_side"] = "LEFT",
["customText"] = "function()\n    local defBonus = GetDodgeBlockParryChanceFromDefense()\n    local resil    = GetCombatRatingBonus(15)\n    local crit     = defBonus + resil  \n    local cap      = 5.6                \n    \n    if crit >= cap then\n        return string.format(\"|cff00ff00%.2f%% / 5.60%%|r\", crit)\n    else\n        return string.format(\"|cffff0000%.2f%% / 5.60%%|r\", crit)\n    end\nend",
