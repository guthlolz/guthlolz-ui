["displayText_format_p_time_precision"] = 1,
["actions"] = {
["start"] = {
["glow_frame_type"] = "UNITFRAME",
["message_custom"] = "",
["glow_action"] = "show",
["do_message"] = false,
["do_glow"] = false,
["do_sound"] = false,
["glow_type"] = "Pixel",
["do_custom"] = false,
["glow_color"] = {
1,
0.54117647058824,
0.03921568627451,
1,
},
["glow_thickness"] = 4,
["message_type"] = "SAY",
["message"] = "",
["custom"] = "",
["glow_lines"] = 10,
["message_format_n_format"] = "none",
["use_glow_color"] = true,
["message_format_c_format"] = "none",
["sound"] = " custom",
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.interruptCounts = {}\naura_env.npcId = \"18829\"\naura_env.rotation = 1\naura_env.castTime = 2\naura_env.marks = {}\n\naura_env.trackedSpells = {\n    [39175] = 2, -- Shadow Bolt Volley\n}\n\nfunction aura_env.shouldShowState(guid)\n    if not guid then\n        return false\n    end\n    local npcId = select(6, strsplit(\"-\", guid or \"\"))\n    if npcId ~= aura_env.npcId then\n        return false\n    end\n    return true\nend\n\nfunction aura_env.updateVisibleNameplateUnits(allstates, changedGUID, status, dur)\n    for _, plateData in ipairs(C_NamePlate.GetNamePlates()) do\n        local unit = plateData.UnitFrame.displayedUnit\n        local guid = UnitGUID(unit)\n        if guid and guid == changedGUID then\n            aura_env.updateState(allstates, guid, status, unit, dur)\n        end\n    end\nend\n\nfunction aura_env.updateState(allstates, guid, status, unit, dur)\n    if not guid then return end\n    \n    local count = aura_env.interruptCounts[guid] or 1\n    local duration, expirationTime = 0, GetTime()\n    \n    if status == \"Casting\" then\n        duration = dur or aura_env.castTime\n        expirationTime = GetTime() + duration\n    end\n    \n    local raidMark = aura_env.marks and aura_env.marks[guid]\n    local raidMarkStr = raidMark and raidMark > 0 and (\"{rt\" .. raidMark .. \"}\") or \"\"\n    \n    if aura_env.shouldShowState(guid) then\n        allstates[guid] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            rotation = count,\n            status = status or \"Idle\",\n            duration = duration,\n            expirationTime = expirationTime,\n            unit = unit,\n            raidMark = raidMarkStr,\n        }\n    else\n        if allstates[guid] then\n            allstates[guid].show = false\n            allstates[guid].changed = true\n        end\n    end\nend\n\nfunction aura_env.iterateNameplatesAndUpdate()\n    for _, plateData in ipairs(C_NamePlate.GetNamePlates()) do\n        local unit = plateData.UnitFrame.displayedUnit\n        local guid = UnitGUID(unit)\n        local raidMark = GetRaidTargetIndex(unit)\n        if guid then\n            WeakAuras.ScanEvents(\"WA_WARDER_MARKS_UPDATED\", guid, unit, raidMark)\n        end\n    end\nend\n\nfunction aura_env.onRaidTargetUpdate()\n    C_Timer.After(0.1, aura_env.iterateNameplatesAndUpdate)\nend",
["do_custom"] = true,
},
["finish"] = {
["hide_all_glows"] = false,
["custom"] = "",
["do_custom"] = false,
},
},
