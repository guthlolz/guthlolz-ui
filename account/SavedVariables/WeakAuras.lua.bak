["event"] = "Health",
["names"] = {
},
["custom"] = "function(allstates, event, guid, name)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 3,\n            expirationTime = GetTime() + 3,\n            autoHide = true,\n            unit = \"player\",\n        }\n        return true\n    end\n    \n    if event == \"WA_KAELTHAS_THALADRED_DIED\" then\n        for _, state in pairs(allstates) do\n            state.show = false\n            state.changed = true\n        end\n        return true\n    end\n    \n    if event == \"WA_THALADRED_GAZE_TARGET\" then\n        for _, state in pairs(allstates) do\n            state.show = false\n            state.changed = true\n        end\n        \n        if not name then\n            return false\n        end\n        \n        allstates[name] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 8,\n            expirationTime = GetTime() + 8,\n            unit = name,\n        }\n        return true\n    end\nend",
