["custom"] = "C_VoiceChat.SpeakText(_G.FJITTS_SFX_VOICEID, \"Deaden Soon\", _G.FJITTS_SFX_RATE, _G.FJITTS_SFX_VOLUME, true)",
["do_sound"] = false,
