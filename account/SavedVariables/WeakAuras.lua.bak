["triggers"] = {
{
["trigger"] = {
["onUpdateThrottle"] = 0.2,
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["type"] = "custom",
["unit"] = "player",
["spellIds"] = {
},
["names"] = {
},
["check"] = "update",
["custom"] = "function(allstates)\n    local guid = UnitGUID(\"mouseover\")\n    local npcID = guid and select(6,strsplit(\"-\",guid))\n    local show = (aura_env.killedTwo and npcID == \"23411\") or (aura_env.killedEight and npcID == \"23410\")\n    \n    if show then\n        if not allstates[\"\"] then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n            }\n            return true\n        end\n        \n        if not allstates[\"\"].show then\n            allstates[\"\"].show = true\n            allstates[\"\"].changed = true\n            return true\n        end\n    elseif allstates[\"\"] and allstates[\"\"].show then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\n    \n    return false\nend",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
},
},
{
["trigger"] = {
["type"] = "custom",
["custom"] = "function(e)\n    aura_env.killedTwo = false\n    aura_env.killedEight = false\n    \n    for i = 1,GetNumSavedInstances() do\n        local _,_,_,_,locked,_,_,_,_,_,_,encounterProgress,_,instanceId = GetSavedInstanceInfo(i)\n        \n        if instanceId == 564 and locked then\n            if encounterProgress == 2 then\n                aura_env.killedTwo = true\n            elseif encounterProgress == 8 then\n                aura_env.killedEight = true\n            end\n            \n            break\n        end\n    end\n    \n    return false\nend",
["custom_type"] = "status",
["check"] = "event",
["unit"] = "player",
["events"] = "ENCOUNTER_END, STATUS",
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
},
},
["disjunctive"] = "custom",
["customTriggerLogic"] = "function(t)\n    return t[1]\nend",
["activeTriggerMode"] = -10,
},
["authorOptions"] = {
},
["displayText_format_1.name_format"] = "Unit",
["progressSource"] = {
-1,
"",
},
["animation"] = {
["start"] = {
["colorR"] = 0.97254908084869,
["duration"] = "0.35",
["scalex"] = 1.1,
["colorA"] = 1,
["alphaType"] = "straight",
["colorB"] = 1,
["colorG"] = 0,
["alphaFunc"] = "function(progress, start, delta)\n    return start + (progress * delta)\nend\n",
["easeStrength"] = 5,
["translateType"] = "bounce",
["use_translate"] = true,
["use_alpha"] = false,
["type"] = "custom",
["scaleType"] = "pulse",
["scaley"] = 1.1,
["easeType"] = "none",
["translateFunc"] = "function(progress, startX, startY, deltaX, deltaY)\n    local bounceDistance = math.sin(progress * math.pi)\n    return startX + (bounceDistance * deltaX), startY + (bounceDistance * deltaY)\nend\n",
["use_color"] = false,
["alpha"] = 0.65,
["colorType"] = "pulseColor",
["y"] = -1,
["x"] = 0,
["preset"] = "bounceDecay",
["scaleFunc"] = "function(progress, startX, startY, scaleX, scaleY)\n    local angle = (progress * 2 * math.pi) - (math.pi / 2)\n    return startX + (((math.sin(angle) + 1)/2) * (scaleX - 1)), startY + (((math.sin(angle) + 1)/2) * (scaleY - 1))\nend\n",
["colorFunc"] = "function(progress, r1, g1, b1, a1, r2, g2, b2, a2)\n    local angle = (progress * 2 * math.pi) - (math.pi / 2)\n    local newProgress = ((math.sin(angle) + 1)/2);\n    return r1 + (newProgress * (r2 - r1)),\n         g1 + (newProgress * (g2 - g1)),\n         b1 + (newProgress * (b2 - b1)),\n         a1 + (newProgress * (a2 - a1))\nend\n",
["rotate"] = 0,
["use_scale"] = true,
["duration_type"] = "seconds",
},
["main"] = {
["scaleFunc"] = "function(progress, startX, startY, scaleX, scaleY)\n    local angle = (progress * 2 * math.pi) - (math.pi / 2)\n    return startX + (((math.sin(angle) + 1)/2) * (scaleX - 1)), startY + (((math.sin(angle) + 1)/2) * (scaleY - 1))\nend\n",
["duration_type"] = "seconds",
