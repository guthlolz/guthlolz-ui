["triggers"] = {
{
["trigger"] = {
["debuffType"] = "HELPFUL",
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_type"] = "stateupdate",
["names"] = {
},
["unit"] = "player",
["event"] = "Health",
["customStacks"] = "",
["customDuration"] = "",
["events"] = "CLEU:SPELL_AURA_APPLIED:SPELL_AURA_REFRESH:SPELL_ABSORBED:SPELL_AURA_REMOVED",
["custom"] = "function(allStates, event, _, subEvent, _, _, _, _, _, destGUID, _, _, _, spellId, ...)\n    if event == \"OPTIONS\" then\n        allStates[1] = {\n            changed = true,\n            show = true,\n            progressType = \"static\",\n            value = math.random(1,80000),\n            total = 80000,\n        }\n        return true\n    end\n    \n    if subEvent == \"SPELL_AURA_REMOVED\" then\n        if not aura_env.shields[spellId] then\n            return false\n        end\n        WeakAuras.ScanEvents(\"WA_KAELTHAS_SHIELD_REMOVED\")\n        if allStates[1] then\n            allStates[1].show = false\n            allStates[1].changed = true\n            return true\n        end\n    end\n    \n    if subEvent == \"SPELL_AURA_APPLIED\" or subEvent == \"SPELL_AURA_REFRESH\" then\n        if not aura_env.shields[spellId] then\n            return false\n        end\n        \n        local max = (spellId == 46165) and 10000 or 80000\n        \n        allStates[1] = {\n            changed = true,\n            show = true,\n            progressType = \"static\",\n            value = max,\n            total = max,\n        }\n        return true\n    end\n    \n    if subEvent ~= \"SPELL_ABSORBED\" then\n        return false\n    end\n    \n    local state = allStates[1]\n    if not state then\n        return false\n    end\n    local params = {...}\n    local numParams = #params\n    local absorbSpellId = params[numParams - 3]\n    if not aura_env.shields[absorbSpellId] then\n        return false\n    end\n    \n    local absorbAmount = params[numParams]\n    state.changed = true\n    state.value = state.value - absorbAmount\n    state.show = state.value > 0\n    return true\nend",
["spellIds"] = {
},
