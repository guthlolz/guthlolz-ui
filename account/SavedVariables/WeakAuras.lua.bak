["custom"] = "aura_env.encounterActive = false\naura_env.myTeam = nil\naura_env.currentTeam = 1\naura_env.teamCount = 0\naura_env.nextAlertSent = false\n\nfunction aura_env.Reset(states)\n    aura_env.encounterActive = false\n    aura_env.myTeam = nil\n    aura_env.currentTeam = 1\n    aura_env.teamCount = 0\n    aura_env.nextAlertSent = false\n    \n    for _,state in pairs(states) do\n        state.show = false\n        state.changed = true\n    end\nend",
