["events"] = "WA_NUMEN_TIMER, NAME_PLATE_UNIT_REMOVED, NAME_PLATE_UNIT_ADDED, PLAYER_REGEN_ENABLED",
["spellIds"] = {
},
["custom"] = "function(allstates,event,...)\n    if event == \"OPTIONS\" then\n        for i = 1,2 do\n            allstates[i] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = 6,\n                expirationTime = GetTime()+6,\n                autoHide = false,\n                icon = i == 1 and 132369 or 135963,\n            }\n        end\n        return true\n    end\n    \n    if event == \"PLAYER_REGEN_ENABLED\" then\n        return aura_env.reset(allstates)\n    end\n    \n    if event == \"WA_NUMEN_TIMER\" then\n        local key,time,count,guid = ...\n        \n        if not aura_env.spellKeys[key] or not aura_env.config.option.trashSpells[key] then\n            return false\n        end\n        \n        if time == nil or time == 0 then\n            if guid then\n                return aura_env.cancelState(allstates,guid,key)\n            end\n            return aura_env.cancelNPCState(allstates,key)\n        end\n        \n        return aura_env.updateState(allstates,key,time,count,guid)\n    end\n    \n    if event == \"NAME_PLATE_UNIT_REMOVED\" then\n        local unit = ...\n        local guid = aura_env.nameplateGUIDs[unit] or UnitGUID(unit)\n        \n        aura_env.nameplateGUIDs[unit] = nil\n        \n        if guid and aura_env.guids[guid] then\n            for key in pairs(aura_env.guids[guid]) do\n                aura_env.hideState(allstates,guid,key)\n            end\n            return true\n        end\n    end\n    \n    if event == \"NAME_PLATE_UNIT_ADDED\" then\n        local unit = ...\n        local guid = UnitGUID(unit)\n        \n        if not guid then\n            return false\n        end\n        \n        aura_env.nameplateGUIDs[unit] = guid\n        \n        local npcID = aura_env.getNPCID(guid)\n        local pending = npcID and aura_env.pending[npcID]\n        \n        if pending then\n            aura_env.guids[guid] = aura_env.guids[guid] or {}\n            \n            for key,spellData in pairs(pending) do\n                if not aura_env.guids[guid][key] then\n                    aura_env.guids[guid][key] = spellData\n                end\n            end\n            \n            aura_env.pending[npcID] = nil\n        end\n        \n        local spellInfo = aura_env.guids[guid]\n        if not spellInfo then\n            return false\n        end\n        \n        for key,spellData in pairs(spellInfo) do\n            local info = aura_env.spellKeys[key]\n            \n            if info and npcID == info.npcID then\n                aura_env.showState(allstates,guid,key,spellData,unit)\n            end\n        end\n        \n        return true\n    end\n    \n    return false\nend",
