["[CL]:Mage - Ignite"] = {
["iconSource"] = -1,
["wagoID"] = "0qNh3IMOM",
["parent"] = "[CL]:Mage - Debuffs",
["adjustedMax"] = "",
["adjustedMin"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["cooldownSwipe"] = true,
["customTextUpdate"] = "event",
["cooldownEdge"] = false,
["icon"] = true,
["triggers"] = {
{
["trigger"] = {
["auranames"] = {
},
["ownOnly"] = true,
["unit"] = "target",
["unitExists"] = false,
["debuffType"] = "HARMFUL",
["showClones"] = false,
["useName"] = false,
["subeventSuffix"] = "_CAST_START",
["useTotal"] = false,
["event"] = "Health",
["auraspellids"] = {
"12654",
},
["matchesShowOn"] = "showAlways",
["spellIds"] = {
},
["type"] = "aura2",
["useExactSpellId"] = true,
["names"] = {
},
["subeventPrefix"] = "SPELL",
["useRem"] = false,
},
["untrigger"] = {
},
},
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["customVariables"] = "{\n    tick = \"number\",\n}",
["event"] = "Health",
["unit"] = "player",
["subeventSuffix"] = "_CAST_START",
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates,event,_,subEvent,_,sourceGUID,_,_,_,destGUID,destName,_,_,spellId,_,_,amount,_,_,_,_,_,critical)\n    \n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            pool = math.random(50, 300),\n            tick = math.random(1000, 10000),\n        }\n        return true\n    end\n    \n    if event == \"PLAYER_TARGET_CHANGED\" then\n        if UnitExists(\"target\") then\n            local guid = UnitGUID(\"target\")\n            return aura_env.updateTargetState(allstates, guid)\n        else\n            return aura_env.hideState(allstates)\n        end\n    end\n    \n    if sourceGUID ~= WeakAuras.myGUID then\n        return false\n    end\n    \n    if (subEvent == \"SPELL_AURA_APPLIED\" or subEvent == \"SPELL_AURA_REFRESH\") and spellId == aura_env.IGNITE_SPELL_ID then\n        local data = aura_env.guids[destGUID] or { pool = 0 }\n        data.remainingTicks = aura_env.IGNITE_TICKS\n        aura_env.guids[destGUID] = data\n        \n        local targetGUID = UnitExists(\"target\") and UnitGUID(\"target\")\n        if targetGUID == destGUID then\n            return aura_env.updateTargetState(allstates, destGUID)\n        end\n        return false\n    end\n    \n    if subEvent == \"SPELL_AURA_REMOVED\" and spellId == aura_env.IGNITE_SPELL_ID then\n        if aura_env.guids[destGUID] then\n            aura_env.guids[destGUID] = nil\n        end\n        \n        local targetGUID = UnitExists(\"target\") and UnitGUID(\"target\")\n        if targetGUID == destGUID then\n            return aura_env.hideState(allstates)\n        end\n        return false\n    end\n    \n    if \"SPELL_PERIODIC_DAMAGE\" and spellId == aura_env.IGNITE_SPELL_ID then\n        local data = aura_env.guids[destGUID]\n        if data then\n            data.pool = math.max(0, (data.pool or 0) - (amount or 0))\n            data.remainingTicks = math.max((data.remainingTicks or 1) - 1, 0)\n            \n            local remainingTicks = math.max(data.remainingTicks, 1)\n            local predictedNext  = data.pool / remainingTicks\n            \n            if data.pool <= 0 or data.remainingTicks <= 0 then\n                aura_env.guids[destGUID] = nil\n            end\n        end\n        \n        local targetGUID = UnitExists(\"target\") and UnitGUID(\"target\")\n        if targetGUID == destGUID then\n            return aura_env.updateTargetState(allstates, destGUID)\n        end\n        return false\n    end\n    \n    if subEvent == \"SPELL_DAMAGE\" and aura_env.igniteSpells[spellId] and critical then\n        local gain = aura_env.igniteGain(amount or 0)\n        \n        local data = aura_env.guids[destGUID] or { pool = 0, remainingTicks = aura_env.IGNITE_TICKS }\n        data.pool = (data.pool or 0) + gain\n        aura_env.guids[destGUID] = data\n        \n        local targetGUID = UnitExists(\"target\") and UnitGUID(\"target\")\n        if targetGUID == destGUID then\n            return aura_env.updateTargetState(allstates, destGUID)\n        end\n    end\n    \n    return false\nend",
["names"] = {
},
["check"] = "event",
["events"] = "PLAYER_TARGET_CHANGED, CLEU:SPELL_DAMAGE:SPELL_PERIODIC_DAMAGE:SPELL_AURA_REMOVED:SPELL_AURA_APPLIED:SPELL_AURA_REFRESH",
