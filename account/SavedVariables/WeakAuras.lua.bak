["custom"] = "function(e)\n    if e == \"WA_FJI_ENCOUNTER_START\" or e == \"ENCOUNTER_START\" then\n        aura_env.addsAlive = 3\n    end\n    \n    if e == \"WA_KARATHRESS_CARIBDIS_DIED\" or e == \"WA_KARATHRESS_SHARKKIS_DIED\" or e == \"WA_KARATHRESS_TIDALVESS_DIED\" then\n        aura_env.addsAlive = aura_env.addsAlive - 1\n        return aura_env.addsAlive == 0\n    end\nend",
