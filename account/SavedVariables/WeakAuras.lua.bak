["init"] = {
["custom"] = "aura_env.lockedBosses = 0\n\nfunction aura_env.updateLockout()\n    aura_env.lockedBosses = 0\n    \n    for i = 1, GetNumSavedInstances() do\n        local _,_,_,_,locked,_,_,_,_,_,_,encounterProgress,_,instanceId = GetSavedInstanceInfo(i)\n        \n        if instanceId == 564 and locked then\n            aura_env.lockedBosses = encounterProgress or 0\n            break\n        end\n    end\nend",
["do_custom"] = true,
