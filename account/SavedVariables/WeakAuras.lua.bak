["init"] = {
["custom"] = "aura_env.allow = false\naura_env.addsAlive = 4\naura_env.auraID = \"Fojji - TBC Boss Frames [Jeyp's Edit]\"\naura_env.create = true\n\nif WeakAuras.GetData(aura_env.auraID) ~= nil then\n    aura_env.create = false\nend\n\naura_env.deathEvents = {\n    WA_KAELTHAS_THALADRED_DIED = { id = 1, name = \"Thaladred\", icon = 133160 },\n    WA_KAELTHAS_TELONICUS_DIED = { id = 2, name = \"Telonicus\", icon = 134520 },\n    WA_KAELTHAS_CAPERNIAN_DIED = { id = 3, name = \"Capernian\", icon = 626001 },\n    WA_KAELTHAS_SANGUINAR_DIED = { id = 4, name = \"Sanguinar\", icon = 626003 },\n}\n\naura_env.advisors = {\n    [1] = { id = 1, npcId = \"20064\", name = \"Thaladred\", icon = 133160 },\n    [2] = { id = 2, npcId = \"20063\", name = \"Telonicus\", icon = 134520 },\n    [3] = { id = 3, npcId = \"20062\", name = \"Capernian\", icon = 626001 },\n    [4] = { id = 4, npcId = \"20060\", name = \"Sanguinar\", icon = 626003 },\n}\n\naura_env.npcToAdvisor = {\n    [\"20064\"] = aura_env.advisors[1],\n    [\"20063\"] = aura_env.advisors[2],\n    [\"20062\"] = aura_env.advisors[3],\n    [\"20060\"] = aura_env.advisors[4],\n}\n\nfunction aura_env.createStates(allstates)\n    for id, advisor in pairs(aura_env.advisors) do\n        aura_env.updateState(allstates, id, advisor.name, advisor.icon, 1, false)\n    end\nend\n\nfunction aura_env.updateState(allstates, id, name, icon, hpPercent, isDead)\n    allstates[id] = allstates[id] or {\n        show = true,\n        changed = true,\n        progressType = \"static\",\n        value = 1,\n        total = 1,\n        percent = \"100%\",\n        name = name,\n        icon = icon,\n    }\n    \n    allstates[id].show = true\n    allstates[id].name = name\n    allstates[id].icon = icon\n    allstates[id].isDead = isDead or false\n    \n    if hpPercent then\n        allstates[id].value = hpPercent\n        allstates[id].percent = math.floor(hpPercent * 100) .. \"%\"\n    end\n    \n    if isDead then\n        allstates[id].value = 0\n        allstates[id].percent = \"0%\"\n    end\n    \n    allstates[id].changed = true\n    return true\nend\n\nfunction aura_env.scanTargets(allstates)\n    local seen = {}\n    \n    for unit in WA_IterateGroupMembers() do\n        local target = unit .. \"target\"\n        local guid = UnitGUID(target)\n        \n        if guid then\n            local npcId = select(6, strsplit(\"-\", guid))\n            local advisor = aura_env.npcToAdvisor[npcId]\n            \n            if advisor and not seen[advisor.id] then\n                local hpMax = UnitHealthMax(target)\n                if hpMax and hpMax > 0 then\n                    local hpPercent = UnitHealth(target) / hpMax\n                    aura_env.updateState(allstates, advisor.id, advisor.name, advisor.icon, hpPercent, false)\n                    seen[advisor.id] = true\n                end\n            end\n        end\n    end\n    return true\nend\n\nfunction aura_env.hideState(allstates)\n    for _, state in pairs(allstates) do\n        state.show = false\n        state.changed = true\n    end\n    aura_env.cancelTicker()\n    return true\nend\n\nfunction aura_env.startTicker()\n    if aura_env.ticker then\n        aura_env.ticker:Cancel()\n        aura_env.ticker = nil\n    end\n    \n    aura_env.ticker = C_Timer.NewTicker(1, function()\n            WeakAuras.ScanEvents(\"WA_FJI_ADVISOR_TICKER\")\n    end)\nend\n\nfunction aura_env.cancelTicker()\n    if aura_env.ticker then\n        aura_env.ticker:Cancel()\n        aura_env.ticker = nil\n    end\nend",
["do_custom"] = true,
},
},
