["event"] = "Health",
["unit"] = "player",
["names"] = {
},
["subeventSuffix"] = "_CAST_START",
["spellIds"] = {
},
["events"] = "STATUS ENCOUNTER_END WA_FJI_MOTHER_KILLED WA_FJI_BT_LOCKOUT_UPDATED",
["check"] = "event",
["custom"] = "function(e)\n    if e == \"WA_FJI_MOTHER_KILLED\" then\n        return false\n    end\n    \n    if e == \"STATUS\" then\n        aura_env.updateLockout()\n    elseif e == \"ENCOUNTER_END\" then\n        C_Timer.After(1, function()\n                aura_env.updateLockout()\n                WeakAuras.ScanEvents(\"WA_FJI_BT_LOCKOUT_UPDATED\")\n        end)\n    end\n    \n    return aura_env.lockedBosses == 6\nend",
["subeventPrefix"] = "SPELL",
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
["custom"] = "function(e)\n    return aura_env.lockedBosses ~= 6\nend",
},
},
["disjunctive"] = "custom",
["customTriggerLogic"] = "function(t)\n    return (t[1] or t[2]) and not t[3]\nend",
