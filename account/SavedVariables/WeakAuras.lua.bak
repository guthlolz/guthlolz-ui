["init"] = {
["do_custom"] = true,
["custom"] = "local interruptSpells = {\n    ROGUE = 1766,    -- Kick\n    WARRIOR = 6552,  -- Pummel\n    MAGE = 2139,     -- Counterspell\n    SHAMAN = 8042,   -- Earth Shock\n    DRUID = 16979,   -- Feral Charge\n    WARLOCK = 19647, -- Spell Lock\n    HUNTER = 147362,\n}\n\nlocal spellId = interruptSpells[UnitClassBase(\"player\")] or 1766\naura_env.icon = GetSpellTexture(spellId)\n\nfunction aura_env.IsAssigned(players)\n    if not players then\n        return false\n    end\n    \n    for _,name in ipairs(players) do\n        if name == WeakAuras.me then\n            return true\n        end\n    end\n    return false\nend",
},
