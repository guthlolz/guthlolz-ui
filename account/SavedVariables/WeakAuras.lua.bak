},
["finish"] = {
["message_type"] = "SAY",
["do_message"] = false,
["message"] = "-",
},
["init"] = {
["custom"] = "aura_env.weaponSelect = {\n    [\"TANK\"] = {\n        [\"DRUID\"] = {itemIDs = {30317, 30313}},\n        [\"PALADIN\"] = {itemIDs = {30317, 30314}},\n        [\"WARRIOR\"] = {itemIDs = {30312, 30311, 30314}},\n    },\n    [\"HEALER\"] = {\n        [\"DRUID\"] = {itemIDs = {30317, 30313}},\n        [\"PALADIN\"] = {itemIDs = {30317}},\n        [\"PRIEST\"] = {itemIDs = {30317, 30313}},\n        [\"SHAMAN\"] = {itemIDs = {30317, 30313}},\n    },\n    [\"MELEE\"] = {\n        [\"DRUID\"] = {itemIDs = {30317, 30313}},\n        [\"PALADIN\"] = {itemIDs = {30316}},\n        [\"ROGUE\"] = {itemIDs = {30312, 30311}},\n        [\"SHAMAN\"] = {itemIDs = {30312}},\n        [\"WARRIOR\"] = {itemIDs = {30312, 30311}},\n    },\n    [\"RANGED\"] = {\n        [\"DRUID\"] = {itemIDs = {30317, 30313}},\n        [\"HUNTER\"] = {itemIDs = {30318}},\n        [\"MAGE\"] = {itemIDs = {30313}},\n        [\"PRIEST\"] = {itemIDs = {30313}},\n        [\"SHAMAN\"] = {itemIDs = {30313}},\n        [\"WARLOCK\"] = {itemIDs = {30313}},\n    }\n}\n\naura_env.deathEvents = {\n    WA_KAELTHAS_STAFF_DIED  = { id = 30313, name = \"Staff\",  icon = 135188 },\n    WA_KAELTHAS_MACE_DIED   = { id = 30317, name = \"Mace\",   icon = 133528 },\n    WA_KAELTHAS_DAGGER_DIED = { id = 30312, name = \"Dagger\", icon = 134976 },\n    WA_KAELTHAS_SWORD_DIED  = { id = 30311, name = \"Sword\",  icon = 135379 },\n    WA_KAELTHAS_BOW_DIED    = { id = 30318, name = \"Bow\",    icon = 135507 },\n    WA_KAELTHAS_AXE_DIED    = { id = 30316, name = \"Axe\",    icon = 132455 },\n    WA_KAELTHAS_SHIELD_DIED = { id = 30314, name = \"Shield\", icon = 134976 },\n}\n\nfunction aura_env.updateState(allstates, id, name, icon, looted)\n    allstates[id] = {\n        show = true,\n        changed = true,\n        progressType = \"timed\",\n        duration = 10,\n        expirationTime = GetTime() + 10,\n        autoHide = true,\n        name = name,\n        icon = icon,\n        looted = looted or false,\n        itemID = id,\n    }\n    return true\nend\n\nfunction aura_env.hideState(allstates, id)\n    if allstates[id] then\n        allstates[id].show = false\n        allstates[id].changed = true\n        return true\n    end\nend\n\nfunction aura_env.getRoleKey()\n    if _G.FJI_TANK then\n        return \"TANK\"\n    elseif _G.FJI_HEALER then\n        return \"HEALER\"\n    elseif _G.FJI_MELEE then\n        return \"MELEE\"\n    elseif _G.FJI_RANGED then\n        return \"RANGED\"\n    end\nend\n\nfunction aura_env.getAllowedItems()\n    local role = aura_env.getRoleKey()\n    if not role then\n        return\n    end\n    \n    local class = UnitClassBase(\"player\")\n    if not class then\n        return\n    end\n    \n    local roleTable = aura_env.weaponSelect[role]\n    local classTable = roleTable and roleTable[class]\n    if not classTable or not classTable.itemIDs then\n        return\n    end\n    \n    return classTable.itemIDs\nend\n\nfunction aura_env.shouldShowForPlayer(itemID)\n    local itemIDs = aura_env.getAllowedItems()\n    if not itemIDs then\n        return false\n    end\n    \n    for i = 1, #itemIDs do\n        if itemIDs[i] == itemID then\n            return true\n        end\n    end\n    \n    return false\nend\n\nfunction aura_env.isEquipped(itemID)\n    local mainHand = GetInventoryItemID(\"player\", INVSLOT_MAINHAND)\n    local offHand = GetInventoryItemID(\"player\", INVSLOT_OFFHAND)\n    return mainHand == itemID or offHand == itemID\nend\n\nfunction aura_env.isInBags(itemID)\n    for bag = 0, NUM_BAG_SLOTS do\n        for slot = 1, C_Container.GetContainerNumSlots(bag) do\n            local id = C_Container.GetContainerItemID(bag, slot)\n            if id == itemID then\n                return true\n            end\n        end\n    end\n    return false\nend\n\nfunction aura_env.checkLooted(allstates)\n    local itemIDs = aura_env.getAllowedItems()\n    if not itemIDs then\n        return false\n    end\n    \n    for i = 1, #itemIDs do\n        local itemID = itemIDs[i]\n        local state = allstates[itemID]\n        \n        if aura_env.isInBags(itemID) then\n            local _, _, _, _, icon = GetItemInfoInstant(itemID)\n            local name = GetItemInfo(itemID) or (\"Item \" .. itemID)\n            \n            if not state or not state.show or not state.looted then\n                aura_env.updateState(allstates, itemID, name, icon, true)\n                return true\n            end\n        elseif state and state.show and state.looted then\n            state.show = false\n            state.changed = true\n            return true\n        end\n    end\n    \n    return false\nend\n\nfunction aura_env.checkEquipped(allstates)\n    for itemID, state in pairs(allstates) do\n        if state.show and state.looted and aura_env.isEquipped(itemID) then\n            state.show = false\n            state.changed = true\n            return true\n        end\n    end\nend",
["do_custom"] = true,
},
},
