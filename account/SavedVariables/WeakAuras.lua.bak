["custom"] = "function(allstates, event)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            icon = 136172,\n        }\n    end\n    if event == \"WA_LEOTHERAS_DEMON_START\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            progressType = \"timed\",\n            icon = 136172,\n            autoHide = true,\n        }\n        return true\n    end\nend",
