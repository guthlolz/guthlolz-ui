["PT:[BT] Raid Role on Zone-In"] = {
["outline"] = "OUTLINE",
["semver"] = "1.2.2",
["wagoID"] = "N57hx-mDf",
["xOffset"] = 0,
["displayText_format_p_time_dynamic_threshold"] = 5,
["customText"] = "function()\n    if not WeakAuras.GetData(\"Fojji - FojjiAPI Role [TBC]\") then\n        return \"\", \"\"\n    end\n    \n    local roleText = aura_env.role or \"\"\n    local fojjiRole = aura_env.fojjiRole or \"\"\n    local colorCode = \"|cFFFFFFFF\"\n    local colorCodeFji = \"|cFFFFFFFF\"\n    \n    if aura_env.role == \"DAMAGER\" then\n        roleText = \"DAMAGE\"\n        colorCode = \"|cFFFF0000\"\n    elseif aura_env.role == \"HEALER\" then\n        colorCode = \"|cFF00FF00\"\n    elseif aura_env.role == \"TANKER\" or aura_env.role == \"TANK\" then\n        roleText = \"TANK\"\n        colorCode = \"|cFFADD8E6\"\n    end\n    \n    if aura_env.fojjiRole == \"MELEE\" or aura_env.fojjiRole == \"RANGED\" then\n        colorCodeFji = \"|cFFFF0000\"\n    elseif aura_env.fojjiRole == \"HEALER\" then\n        colorCodeFji = \"|cFF00FF00\"\n    elseif aura_env.fojjiRole == \"TANK\" then\n        colorCodeFji = \"|cFFADD8E6\"\n    end\n    \n    return colorCode .. roleText .. \"|r\", colorCodeFji .. fojjiRole .. \"|r\"\nend",
["shadowYOffset"] = -1,
["anchorPoint"] = "CENTER",
["displayText_format_c_abbreviate_max"] = 8,
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiBT-P2/10",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "if _G.FJI_HEALER then\n    aura_env.fojjiRole = \"HEALER\"\nelseif _G.FJI_RANGED then\n    aura_env.fojjiRole = \"RANGED\"\nelseif _G.FJI_MELEE then\n    aura_env.fojjiRole = \"MELEE\"\nelseif _G.FJI_TANK then\n    aura_env.fojjiRole = \"TANK\"\nelse\n    aura_env.fojjiRole = \"NONE\"\nend\n\naura_env.role = UnitGroupRolesAssigned(\"player\")",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "aura_env.difficulty = nil",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_hide"] = "timed",
["custom_type"] = "event",
["subeventPrefix"] = "SPELL",
["duration"] = "7.5",
["event"] = "Health",
["names"] = {
},
["subeventSuffix"] = "_CAST_START",
["events"] = "ZONE_CHANGED_NEW_AREA",
["spellIds"] = {
},
["customIcon"] = "function()\nreturn \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\F_icon_teal.png\"\nend",
["check"] = "event",
["custom"] = "function(event,...)\n    local _, _, _, difficulty, _, _, _, Id = GetInstanceInfo()\n    \n    if event == \"OPTIONS\" then\n        aura_env.role = UnitGroupRolesAssigned(\"player\")\n        if _G.FJI_HEALER then\n            aura_env.fojjiRole = \"HEALER\"\n        elseif _G.FJI_RANGED then\n            aura_env.fojjiRole = \"RANGED\"\n        elseif _G.FJI_MELEE then\n            aura_env.fojjiRole = \"MELEE\"\n        elseif _G.FJI_TANK then\n            aura_env.fojjiRole = \"TANK\"\n        else\n            aura_env.fojjiRole = \"NONE\"\n        end\n    end\n    \n    if Id == 544 then\n        aura_env.role = UnitGroupRolesAssigned(\"player\")\n        if _G.FJI_HEALER then\n            aura_env.fojjiRole = \"HEALER\"\n        elseif _G.FJI_RANGED then\n            aura_env.fojjiRole = \"RANGED\"\n        elseif _G.FJI_MELEE then\n            aura_env.fojjiRole = \"MELEE\"\n        elseif _G.FJI_TANK then\n            aura_env.fojjiRole = \"TANK\"\n        else\n            aura_env.fojjiRole = \"NONE\"\n        end\n        return aura_env.role, aura_env.fojjiRole\n    end\nend",
["unit"] = "player",
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
["custom"] = "",
},
},
