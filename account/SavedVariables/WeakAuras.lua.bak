["event"] = "Health",
["unit"] = "player",
["subeventSuffix"] = "_CAST_START",
["spellIds"] = {
},
["custom"] = "function(allstates, event, target)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            progressType = \"timed\",\n            icon = 136129,\n            autoHide = true,\n        }\n        return true\n    end\n    \n    if event == \"WA_SUPREMUS_FIXATE_TARGET\" then\n        if target == WeakAuras.me then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                icon = 136129,\n            }\n        else\n            if allstates[\"\"] then\n                allstates[\"\"].show = false\n                allstates[\"\"].changed = true\n            end\n        end\n        return true\n    end\n    \n    if event == \"WA_FJI_ENCOUNTER_END\" or event == \"ENCOUNTER_END\" or event == \"WA_SUPREMUS_TANK_PHASE\" then\n        if allstates[\"\"] then\n            allstates[\"\"].show = false\n            allstates[\"\"].changed = true\n            return true\n        end\n    end\nend",
["events"] = "WA_SUPREMUS_FIXATE_TARGET, WA_SUPREMUS_TANK_PHASE, WA_FJI_ENCOUNTER_END, ENCOUNTER_END",
["check"] = "event",
["subeventPrefix"] = "SPELL",
