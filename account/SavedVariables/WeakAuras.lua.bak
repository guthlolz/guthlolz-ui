["parent"] = "Pretty Tankadin 2",
["customText"] = "function()\n    local function round(num, idp)\n        local mult = 10 ^ (idp or 0)\n        return math.floor(num * mult + 0.5) / mult\n    end\n    \n    local maxHealth = UnitHealthMax(\"player\")\n    local baseArmor, effectiveArmor, armor, posBuff, negBuff = UnitArmor(\"player\")\n    \n    local dr = (effectiveArmor / ((73 * 467.5) + effectiveArmor - 22167.5))\n    \n    local name, rank, icon, castTime, minRange, maxRange = GetSpellInfo(25780)\n    if AuraUtil.FindAuraByName(name, \"player\", \"HELPFUL\") ~= nil then\n        local nameTalent, icon, tier, column, currRank, maxRank = GetTalentInfo(2, 7)\n        dr = 1 - (1 - dr) * (1 - (.02 * currRank))\n    end\n    \n    local eh = maxHealth / (1 - dr)\n    \n    return string.format(\"%d\", eh)\nend",
["sparkRotationMode"] = "AUTO",
