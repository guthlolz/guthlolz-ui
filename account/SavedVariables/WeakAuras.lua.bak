["actions"] = {
["start"] = {
["glow_frame_type"] = "UNITFRAME",
["message_custom"] = "",
["glow_action"] = "show",
["do_message"] = false,
["do_glow"] = false,
["do_sound"] = false,
["glow_type"] = "Pixel",
