["do_custom"] = false,
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.slot = INVSLOT_TRINKET1\n\naura_env.saved = aura_env.saved or {}\naura_env.saved.trinketTimers = aura_env.saved.trinketTimers or {}\n\nfunction aura_env.isEquipped(itemId)\n    if not itemId then return false end\n    local equipped = GetInventoryItemID(\"player\", aura_env.slot)\n    return equipped == itemId\nend\n\nfunction aura_env.hideState(allstates, itemId)\n    local state = allstates[itemId]\n    if state then\n        state.show = false\n        state.changed = true\n        state.duration = 0\n        state.expirationTime = 0\n    end\nend\n\nfunction aura_env.showState(allstates, itemId, data)\n    local now = GetTime()\n    local remaining = (data.endTime or 0) - now\n    if remaining <= 0 then\n        aura_env.saved.trinketTimers[itemId] = nil\n        aura_env.hideState(allstates, itemId)\n        return true\n    end\n    \n    allstates[itemId] = {\n        show = true,\n        changed = true,\n        progressType = \"timed\",\n        duration = remaining,\n        expirationTime = now + remaining,\n        autoHide = true,\n        icon = select(10, GetItemInfo(itemId)),\n        itemId = itemId,\n        procId = data.procId,\n    }\n    return true\nend",
["do_custom"] = true,
},
