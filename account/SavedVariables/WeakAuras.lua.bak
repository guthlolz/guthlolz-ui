{
["trigger"] = {
["type"] = "custom",
["custom_hide"] = "timed",
["custom_type"] = "stateupdate",
["subeventPrefix"] = "SPELL",
["duration"] = "20",
["event"] = "Health",
["unit"] = "player",
["subeventSuffix"] = "_CAST_START",
["custom"] = "function(allstates,event,...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            progressType = \"timed\",\n            icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\FojjiIcons\\\\fojjiLuL.png\",\n            autoHide = true,\n            guid = WeakAuras.myGUID,\n        }\n        return true\n    end\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local _,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId = ...\n        \n        if spellId ~= 25823 then\n            return false\n        end\n        \n        local now = GetTime()\n        if now - aura_env.throttle < 30 then\n            return false\n        end\n        \n        aura_env.throttle = now\n        \n        allstates[sourceGUID] = {\n            show = true,\n            changed = true,\n            duration = 2,\n            expirationTime = now + 2,\n            progressType = \"timed\",\n            icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\FojjiIcons\\\\fojjiLuL.png\",\n            autoHide = true,\n            guid = sourceGUID,\n        }\n        return true\n    end\nend",
["spellIds"] = {
},
["events"] = "CLEU:SPELL_CAST_SUCCESS",
["check"] = "event",
["names"] = {
},
["debuffType"] = "HELPFUL",
["customVariables"] = "{\n    expirationTime = true,\n    safe = \"string\",\n}",
},
