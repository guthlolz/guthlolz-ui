["CT:[T4][Magtheridon] Blast Nova"] = {
["outline"] = "OUTLINE",
["wagoID"] = "ASKpBvm6n",
["color"] = {
1,
1,
1,
1,
},
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["shadowYOffset"] = -1,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiT4RaidPack/3",
["actions"] = {
["start"] = {
},
["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.key = \"MAGTHERIDON_BLAST_NOVA\"\naura_env.count = 1\naura_env.cdStart = 54\naura_env.cdWindow = 54\naura_env.blastNova = 30616\n\nfunction aura_env.nuTimer(countdown, count)\n    WeakAuras.ScanEvents(\"WA_NUMEN_TIMER\", aura_env.key, countdown, count)\nend\n\nfunction aura_env.updateState(allstates)\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n    }\nend\n\nfunction aura_env.hideState(allstates)\n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\nend\n\nfunction aura_env.preWarn(duration, preWarnTime, count)\n    if not preWarnTime then\n        preWarnTime = 3\n    end\n    \n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\n    aura_env.preWarnTimer = C_Timer.NewTimer(duration - preWarnTime, function()\n            WeakAuras.ScanEvents(\"WA_\" .. aura_env.key ..\"_PREWARN\", preWarnTime, count)\n            aura_env.preWarnTimer = nil\n    end)\nend\n\nfunction aura_env.preWarnCancel()\n    WeakAuras.ScanEvents(\"WA_\" .. aura_env.key .. \"_PREWARN_CANCEL\")\n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\nend",
},
["finish"] = {
["custom"] = "aura_env.count = 1\naura_env.nuTimer(nil)\naura_env.preWarnCancel()",
["do_sound"] = false,
["do_message"] = false,
["do_custom"] = true,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["custom_hide"] = "timed",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["unit"] = "player",
["custom"] = "function(allstates,event,_,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId)\n    \n    if event == \"WA_MAGTHERIDON_P2_START\" then\n        aura_env.updateState(allstates)\n        aura_env.count = 1\n        aura_env.preWarn(aura_env.cdStart, 5, aura_env.count)\n        aura_env.nuTimer(aura_env.cdStart, aura_env.count)\n        aura_env.lastCast = GetTime()\n        return true\n    elseif event == \"WA_MAGTHERIDON_P3_START\" then\n        local now = GetTime()\n        local remaining = 0\n        if aura_env.lastCast then\n            local expectedNext = aura_env.lastCast + aura_env.cdWindow\n            remaining = expectedNext - now\n        end\n        \n        if remaining < 20 then\n            aura_env.preWarnCancel()\n            aura_env.nuTimer(nil)\n            \n            aura_env.preWarn(20, 5, aura_env.count)\n            aura_env.nuTimer(20, aura_env.count)\n            return true\n        end\n        return false\n    elseif event == \"WA_FJI_ENCOUNTER_END\" then\n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        return true\n    end\n    \n    if spellId ~= aura_env.blastNova then\n        return false\n    end\n    \n    if subEvent == \"SPELL_CAST_START\" then\n        WeakAuras.ScanEvents(\"WA_MAGTHERIDON_BLAST_NOVA_CAST\")\n        aura_env.lastCast = GetTime()\n        aura_env.nuTimer(0, aura_env.count)\n        aura_env.count = aura_env.count + 1\n        aura_env.preWarn(aura_env.cdWindow, 5, aura_env.count)\n        aura_env.nuTimer(aura_env.cdWindow, aura_env.count)\n        return true\n    elseif subEvent == \"SPELL_CAST_SUCCESS\" then\n        WeakAuras.ScanEvents(\"WA_MAGTHERIDON_BLAST_NOVA_CHANNEL\", aura_env.count - 1)\n        return true \n    end\nend",
["events"] = "WA_FJI_ENCOUNTER_END, WA_MAGTHERIDON_P2_START, WA_MAGTHERIDON_P3_START, CLEU:SPELL_CAST_START:SPELL_CAST_SUCCESS",
["customVariables"] = "",
