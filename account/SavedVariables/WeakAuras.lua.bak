["CT:[BT][Supremus] Fixate"] = {
["outline"] = "OUTLINE",
["wagoID"] = "pbbuhQ899",
["parent"] = "[BT][Supremus]",
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiBT-P1/12",
["actions"] = {
["start"] = {
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.debug = false\n\naura_env.supremusID = 22898\naura_env.key = \"SUPREMUS_FIXATE\"\naura_env.count = 1\n\naura_env.cdStart = 2\naura_env.cdFirst = 8\naura_env.cdWindow = 8\naura_env.preWarnTime = 3\n\naura_env.kiteStart = nil\naura_env.lastEmote = nil\naura_env.lastTarget = nil\naura_env.nextEmoteTime = nil\naura_env.waitingForFirstFixate = false\naura_env.scanTimer = nil\naura_env.targetTicker = nil\naura_env.preWarnTimer = nil\n\nfunction aura_env.debugPrint(message)\n    if aura_env.debug then\n        print(message)\n    end\nend\n\nfunction aura_env.updateState(allstates)\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n    }\nend\n\nfunction aura_env.hideState(allstates)\n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\nend\n\nfunction aura_env.getNPCID(unit)\n    local guid = UnitGUID(unit)\n    if not guid then\n        return\n    end\n    \n    local _, _, _, _, _, npcID = strsplit(\"-\", guid)\n    return tonumber(npcID)\nend\n\nfunction aura_env.scanTarget(force)\n    local target\n    \n    for unit in WA_IterateGroupMembers() do\n        local bossUnit = unit .. \"target\"\n        \n        if UnitExists(bossUnit) and aura_env.getNPCID(bossUnit) == aura_env.supremusID then\n            local targetUnit = bossUnit .. \"target\"\n            \n            if UnitExists(targetUnit) and UnitIsPlayer(targetUnit) then\n                target = UnitName(targetUnit)\n                break\n            end\n        end\n    end\n    \n    if not target then\n        return\n    end\n    \n    local fixateCount = aura_env.count\n    \n    if aura_env.waitingForFirstFixate then\n        aura_env.waitingForFirstFixate = false\n        \n        aura_env.nuTimer(0, aura_env.count)\n        aura_env.count = aura_env.count + 1\n        aura_env.nextEmoteTime = GetTime() + aura_env.cdFirst\n        \n        aura_env.preWarn(aura_env.cdFirst, aura_env.preWarnTime, aura_env.count)\n        aura_env.nuTimer(aura_env.cdFirst, aura_env.count)\n    end\n    \n    if force or target ~= aura_env.lastTarget then\n        aura_env.lastTarget = target\n        \n        local remaining = aura_env.nextEmoteTime and math.max(0, aura_env.nextEmoteTime - GetTime()) or nil\n        \n        if remaining then\n            aura_env.debugPrint(string.format(\"Fixate (%d): %s - Next emote in %.1fs\", fixateCount, target, remaining))\n        else\n            aura_env.debugPrint(string.format(\"Fixate (%d): %s\", fixateCount, target))\n        end\n        \n        WeakAuras.ScanEvents(\"WA_SUPREMUS_FIXATE_TARGET\", target, remaining)\n    end\nend\n\nfunction aura_env.scheduleScan(delay,startTicker)\n    if aura_env.scanTimer then\n        aura_env.scanTimer:Cancel()\n        aura_env.scanTimer = nil\n    end\n    \n    aura_env.scanTimer = C_Timer.NewTimer(delay, function()\n            aura_env.scanTimer = nil\n            aura_env.scanTarget(true)\n            \n            if startTicker then\n                aura_env.startTargetTicker()\n            end\n    end)\nend\n\nfunction aura_env.cancelScan()\n    if aura_env.scanTimer then\n        aura_env.scanTimer:Cancel()\n        aura_env.scanTimer = nil\n    end\nend\n\nfunction aura_env.startTargetTicker()\n    if aura_env.targetTicker then\n        aura_env.targetTicker:Cancel()\n    end\n    \n    aura_env.targetTicker = C_Timer.NewTicker(1, function()\n            aura_env.scanTarget(false)\n    end)\nend\n\nfunction aura_env.cancelTargetTicker()\n    if aura_env.targetTicker then\n        aura_env.targetTicker:Cancel()\n        aura_env.targetTicker = nil\n    end\nend\n\nfunction aura_env.nuTimer(countdown,count)\n    WeakAuras.ScanEvents(\"WA_NUMEN_TIMER\", aura_env.key, countdown, count)\nend\n\nfunction aura_env.preWarn(duration,preWarnTime,count)\n    preWarnTime = preWarnTime or 3\n    \n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\n    \n    if duration <= preWarnTime then\n        WeakAuras.ScanEvents(\"WA_\" .. aura_env.key .. \"_PREWARN\", duration, count)\n        return\n    end\n    \n    aura_env.preWarnTimer = C_Timer.NewTimer(duration - preWarnTime, function()\n            WeakAuras.ScanEvents(\"WA_\" .. aura_env.key .. \"_PREWARN\", preWarnTime, count)\n            aura_env.preWarnTimer = nil\n    end)\nend\n\nfunction aura_env.preWarnCancel()\n    WeakAuras.ScanEvents(\"WA_\" .. aura_env.key .. \"_PREWARN_CANCEL\")\n    \n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\nend\n\nlocal locale = GetLocale()\n\naura_env.locales = {\n    [\"enUS\"] = {\n        changeTarget = \"acquires a new target\",\n    },\n    [\"frFR\"] = {\n        changeTarget = \"Nouvelle cible \",\n    },\n    [\"deDE\"] = {\n        changeTarget = \"wählt ein neues Ziel!\",\n    },\n    [\"esES\"] = {\n        changeTarget = \"adquiere un nuevo objetivo!\",\n    },\n    [\"koKR\"] = {\n        changeTarget = \"새로운 대상이 필요합니다!\",\n    },\n    [\"ruRU\"] = {\n        changeTarget = \"атакует новую цель!\",\n    },\n    [\"zhCN\"] = {\n        changeTarget = \"瑟普莫斯需要一個新目標!\",\n    },\n    [\"zhTW\"] = {\n        changeTarget = \"锁定了一个新目标！\",\n    }\n}\n\naura_env.currentLocale = aura_env.locales[locale] or aura_env.locales[\"enUS\"]",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "aura_env.count = 1\naura_env.nuTimer(nil)\naura_env.preWarnCancel()",
["do_sound"] = false,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
["do_message"] = false,
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "ENCOUNTER_START, WA_FJI_ENCOUNTER_START, ENCOUNTER_END, WA_FJI_ENCOUNTER_END, WA_SUPREMUS_KITE_PHASE, WA_SUPREMUS_TANK_PHASE, RAID_BOSS_EMOTE",
["spellIds"] = {
},
["custom"] = "function(allstates,event,eID,...)\n    if event == \"WA_FJI_ENCOUNTER_START\" or event == \"ENCOUNTER_START\" then\n        if eID ~= 602 then\n            return false\n        end\n        \n        aura_env.kiteStart = nil\n        aura_env.lastEmote = nil\n        aura_env.lastTarget = nil\n        aura_env.nextEmoteTime = nil\n        aura_env.waitingForFirstFixate = false\n        aura_env.count = 1\n        \n        aura_env.cancelScan()\n        aura_env.cancelTargetTicker()\n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        \n        aura_env.updateState(allstates)\n        return true\n        \n    elseif event == \"WA_FJI_ENCOUNTER_END\" or event == \"ENCOUNTER_END\" then\n        aura_env.kiteStart = nil\n        aura_env.lastEmote = nil\n        aura_env.lastTarget = nil\n        aura_env.nextEmoteTime = nil\n        aura_env.waitingForFirstFixate = false\n        \n        aura_env.cancelScan()\n        aura_env.cancelTargetTicker()\n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        \n        return aura_env.hideState(allstates)\n    end\n    \n    if event == \"WA_SUPREMUS_KITE_PHASE\" then\n        aura_env.kiteStart = GetTime()\n        aura_env.lastEmote = nil\n        aura_env.lastTarget = nil\n        aura_env.nextEmoteTime = aura_env.kiteStart + aura_env.cdStart\n        aura_env.waitingForFirstFixate = true\n        aura_env.count = 1\n        \n        aura_env.cancelScan()\n        aura_env.cancelTargetTicker()\n        \n        aura_env.preWarn(aura_env.cdStart, aura_env.preWarnTime, aura_env.count)\n        aura_env.nuTimer(aura_env.cdStart, aura_env.count)\n        aura_env.scheduleScan(aura_env.cdStart,true)\n        return false\n    end\n    \n    if event == \"WA_SUPREMUS_TANK_PHASE\" then\n        aura_env.kiteStart = nil\n        aura_env.lastEmote = nil\n        aura_env.lastTarget = nil\n        aura_env.nextEmoteTime = nil\n        aura_env.waitingForFirstFixate = false\n        \n        aura_env.cancelScan()\n        aura_env.cancelTargetTicker()\n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        return false\n    end\n    \n    if event == \"RAID_BOSS_EMOTE\" then\n        local msg = eID\n        local now = GetTime()\n        \n        if aura_env.kiteStart then\n            if aura_env.lastEmote then\n                aura_env.debugPrint(string.format(\"RAID_BOSS_EMOTE: %.1fs since previous / %.1fs into kite: %s\", now - aura_env.lastEmote, now - aura_env.kiteStart, msg))\n            else\n                aura_env.debugPrint(string.format(\"RAID_BOSS_EMOTE: %.1fs into kite: %s\", now - aura_env.kiteStart, msg))\n            end\n            \n            aura_env.lastEmote = now\n        else\n            aura_env.debugPrint(string.format(\"RAID_BOSS_EMOTE: %s\", msg))\n        end\n        \n        if aura_env.currentLocale.changeTarget ~= \"\" and (msg == aura_env.currentLocale.changeTarget or msg:find(aura_env.currentLocale.changeTarget)) then\n            aura_env.debugPrint(string.format(\"Matched ChangeTarget (%d)\", aura_env.count))\n            \n            aura_env.nuTimer(0, aura_env.count)\n            aura_env.count = aura_env.count + 1\n            aura_env.nextEmoteTime = now + aura_env.cdWindow\n            \n            aura_env.preWarn(aura_env.cdWindow, aura_env.preWarnTime, aura_env.count)\n            aura_env.nuTimer(aura_env.cdWindow, aura_env.count)\n            \n            aura_env.cancelScan()\n            aura_env.scheduleScan(0.5)\n        end\n        \n        return false\n    end\n    \n    return false\nend",
