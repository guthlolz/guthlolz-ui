["subeventSuffix"] = "_CAST_START",
["events"] = "CLEU:SPELL_INTERRUPT",
["custom"] = "function(a, event, _, subEvent, _, sourceGUID, _, _, _, destGUID, _, _, _, spellId, _, _, extraSpellId)\n    if event == \"OPTIONS\" then\n        a[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            autoHide = true,\n            icon = 136018,\n            name = WeakAuras.myGUID,\n        }\n        return true\n    end\n    \n    if subEvent == \"SPELL_INTERRUPT\" then\n        for _, plateData in pairs(C_NamePlate.GetNamePlates()) do\n            local unit = plateData.UnitFrame.displayedUnit\n            if UnitGUID(unit) == destGUID then\n                a[unit] = {\n                    show = true,\n                    changed = true,\n                    progressType = \"timed\",\n                    duration = 2,\n                    expirationTime = GetTime() + 2,\n                    autoHide = true,\n                    icon = GetSpellTexture(spellId),\n                    name = sourceGUID,\n                    unit = unit,\n                }\n                return true\n            end\n        end\n    end\nend",
