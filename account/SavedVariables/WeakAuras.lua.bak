["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["event"] = "Health",
["unit"] = "player",
["events"] = "UNIT_SPELLCAST_SUCCEEDED:player UNIT_POWER_FREQUENT:player",
["custom"] = "function(allstates, event)\n    local currMana = UnitPower(\"player\" , 0)\n    local fsDuration = 5\n    if currMana >= UnitPowerMax(\"player\", 0) then\n        return false\n    end\n    \n    if event == \"UNIT_POWER_FREQUENT\" and currMana > aura_env.mana then\n        if GetTime() >= aura_env.casted + fsDuration then \n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = 2,\n                expirationTime = GetTime() + 2,\n                progressType = \"timed\",\n                autoHide = true\n            }\n        end\n        aura_env.mana = currMana\n    elseif event == \"UNIT_SPELLCAST_SUCCEEDED\" and currMana < aura_env.mana then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 5,\n            expirationTime = GetTime() + 5,\n            progressType = \"timed\",\n            autoHide = true\n        }\n        aura_env.mana = currMana\n        aura_env.casted = GetTime()\n    end\n    return true\nend",
