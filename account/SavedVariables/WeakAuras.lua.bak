},
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["shadowYOffset"] = -1,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiT5RaidPack/3",
["actions"] = {
["start"] = {
["do_glow"] = false,
["sound"] = "Interface\\Addons\\FojjiCore\\sound\\fojjiSnap.ogg",
["do_custom"] = false,
["do_sound"] = false,
},
["finish"] = {
["custom"] = "",
["do_sound"] = false,
["do_message"] = false,
["do_custom"] = false,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
},
["init"] = {
["custom"] = "aura_env.guids = {}",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, ...)\n    if event == \"WA_TRASH_WATER_ELEMENTAL_TOTEM\" then\n        local guid = ...\n        aura_env.guids[guid] = true\n        return true\n    end\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local _,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,a12,a13,_,_,a16 = ...\n        \n        if subEvent == \"SPELL_SUMMON\" then\n            local spellId = a12\n            \n            if spellId ~= 38624 then\n                return false\n            end\n            \n            if not aura_env.guids[destGUID] then\n                WeakAuras.ScanEvents(\"WA_TRASH_WATER_ELEMENTAL_TOTEM\", destGUID)\n            end\n            \n            return true\n        end\n        \n        if aura_env.guids[destGUID] then\n            local overkill\n            \n            if subEvent == \"SWING_DAMAGE\" then\n                overkill = a13\n            elseif subEvent == \"SPELL_DAMAGE\" or subEvent == \"RANGE_DAMAGE\" then\n                overkill = a16\n            end\n            \n            if overkill and overkill > 0 then\n                aura_env.guids[destGUID] = nil\n                WeakAuras.ScanEvents(\"WA_TRASH_WATER_ELEMENTAL_TOTEM_DIED\", destGUID)\n                return true\n            end\n        end\n    end\n    \n    if event == \"PLAYER_REGEN_ENABLED\" then\n        wipe(aura_env.guids)\n        return true\n    end\nend",
["spellIds"] = {
},
["events"] = "CLEU:SPELL_SUMMON:SPELL_DAMAGE:RANGE_DAMAGE:SWING_DAMAGE WA_TRASH_WATER_ELEMENTAL_TOTEM PLAYER_REGEN_ENABLED",
