},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["customVariables"] = "{\n    expirationTime = true,\n    count = \"number\",\n}",
["event"] = "Health",
["unit"] = "player",
["subeventSuffix"] = "_CAST_START",
["subeventPrefix"] = "SPELL",
["custom"] = "function(a,e,_,subEvent,_,sourceGUID,_,_,_,_,_,_,_,spellId,_,_,amount)\n    if e == \"OPTIONS\" then\n        local spellId, cfg\n        for id, data in pairs(aura_env.whitelistSpells) do\n            spellId = id\n            cfg     = data\n            break\n        end\n        \n        if spellId then\n            local now = GetTime()\n            local _, _, icon = GetSpellInfo(spellId)\n            local dur = (cfg and cfg.duration) or 1\n            \n            a[\"\"] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = dur,\n                expirationTime = now + dur,\n                autoHide = true,\n                icon = icon,\n                spellId = spellId,\n                amount = math.random(100,5000),\n                count = math.random(1,10),\n            }\n        end\n        return true\n    end\n    \n    if sourceGUID ~= WeakAuras.myGUID then\n        return false\n    end\n    local cfg = aura_env.whitelistSpells[spellId]\n    if not cfg then\n        return false\n    end\n    \n    local now = GetTime()\n    local window = 0.2\n    \n    if not aura_env.windowStart or (now - aura_env.windowStart) > window then\n        aura_env.windowStart = now\n    end\n    \n    local dur = cfg.duration or 1\n    local key = aura_env.windowStart\n    local dmg = amount or 0\n    \n    if not a[key] then\n        local _, _, icon = GetSpellInfo(spellId)\n        a[key] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = dur,\n            expirationTime = now + dur,\n            autoHide = true,\n            icon = icon,\n            spellId = spellId,\n            amount = dmg,\n            count= 1,\n        }\n    else\n        local state = a[key]\n        state.amount        = (state.amount or 0) + dmg\n        state.count         = (state.count or 0) + 1\n        state.changed       = true\n        state.expirationTime = now + dur\n    end\n    \n    return true\nend",
["names"] = {
},
