["custom"] = "aura_env.berserkKeys = {\n    [\"HYDROSS_BERSERK\"] = true,\n    [\"LEOTHERAS_BERSERK\"] = true,\n    [\"KARATHRESS_BERSERK\"] = true,\n    [\"ALAR_BERSERK\"] = true,\n    [\"REAVER_BERSERK\"] = true,\n    [\"SOLARIAN_BERSERK\"] = true,\n}\n\nfunction aura_env.updateState(allstates, duration, key)\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n        progressType = \"timed\",\n        duration = duration,\n        expirationTime = GetTime() + duration,\n        autoHide = true,\n        key = key,\n    }\nend\n\nfunction aura_env.hideState(allstates)\n    for _, state in pairs(allstates) do\n        state.show = false\n        state.changed = true\n    end\n    return true\nend",
["do_custom"] = true,
},
},
