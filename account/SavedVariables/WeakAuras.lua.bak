["custom"] = "function aura_env.printTable(t, indent)\n    \n    indent = indent or \"\"\n    for key, value in pairs(t) do\n        if type(value) == \"table\" then\n            print(indent .. key .. \": \")\n            printTable(value, indent .. \"  \")\n        else\n            print(indent .. key .. \": \" .. tostring(value))\n        end\n    end\nend",
