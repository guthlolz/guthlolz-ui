},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, shieldsLeft)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            icon = 135835,\n            shields = math.random(1,4)\n        }\n    end\n    \n    if event == \"WA_VASHJ_SHIELDS_UPDATE\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 2.5,\n            expirationTime = GetTime() + 2.5,\n            progressType = \"timed\",\n            icon = 135835,\n            autoHide = true,\n            shields = 4 - shieldsLeft,\n        }\n        return true\n    end\nend",
