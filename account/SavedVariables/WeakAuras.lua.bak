["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 8,\n            expirationTime = GetTime() + 8,\n            autoHide = true,\n            name = WeakAuras.myGUID,\n            icon = 132094,\n        }\n        return true\n    end\n    \n    if event == \"WA_AZGALOR_DOOM_APPLIED\" then\n        local guid = ...\n        \n        if guid == WeakAuras.myGUID then\n            return false\n        end\n        \n        allstates[guid] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 2.5,\n            expirationTime = GetTime() + 2.5,\n            autoHide = true,\n            name = guid,\n            icon = 132094,\n        }\n        return true\n    end\nend",
