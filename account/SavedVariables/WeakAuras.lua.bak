},
["displayText_format_t_time_format"] = 0,
["icon_side"] = "LEFT",
["displayText_format_t_time_precision"] = 1,
["displayText_format_p_time_precision"] = 1,
["sparkHeight"] = 30,
["anchorFrameParent"] = false,
["sparkTexture"] = "Interface\\CastingBar\\UI-CastingBar-Spark",
["crop_y"] = 0.41,
["justify"] = "CENTER",
["desc"] = "",
["id"] = "L:[T4][GL] High King Maulgar HP",
["actions"] = {
["start"] = {
["do_custom"] = false,
["custom"] = "",
},
["init"] = {
["do_custom"] = true,
["custom"] = "local auraID = \"Fojji - TBC Boss Frames [Jeyp's Edit]\"\nlocal amountIndexes = {\n    [\"SWING_DAMAGE\"] = 12,\n    [\"RANGE_DAMAGE\"] = 15,\n    [\"SPELL_DAMAGE\"] = 15,\n    [\"SPELL_PERIODIC_DAMAGE\"] = 15,\n    [\"ENVIRONMENTAL_DAMAGE\"] = 13,\n    [\"SPELL_HEAL\"] = 15,\n    [\"SPELL_PERIODIC_HEAL\"] = 15,\n}\n\nlocal NPCS = {\n    [\"18832\"] = { name = \"Krosh\",    icon = 626001, total = 303500 },\n    [\"18835\"] = { name = \"Kiggler\",  icon = 626006, total = 303500 },\n    [\"18834\"] = { name = \"Olm\",      icon = 626007, total = 303500 },\n    [\"18836\"] = { name = \"Blindeye\", icon = 626004, total = 303500 },\n}\n\nlocal ORDER = { \"18832\", \"18835\", \"18834\", \"18836\" }\nlocal INDEX_BY_ID = {}\nfor i, npcID in ipairs(ORDER) do\n    INDEX_BY_ID[npcID] = i\nend\n\nlocal function raidIndexFromRaidFlags(flags)\n    if not flags then return nil end\n    if flags < 0 then flags = flags + 4294967296 end\n    local low = flags % 256\n    if low == 0 then return nil end\n    \n    for i = 1, 8 do\n        local mask = 2 ^ (i - 1)\n        if (low % (mask * 2)) >= mask then\n            return i\n        end\n    end\nend\n\nlocal function setPercent(state)\n    if state.total and state.total > 0 then\n        state.percent = (state.value / state.total) * 100\n    else\n        state.percent = 0\n    end\nend\n\nlocal function update(state, amount, isHeal)\n    amount = amount or 0\n    \n    if isHeal then\n        state.value = (state.value or 0) + amount\n    else\n        state.value = (state.value or 0) - amount\n    end\n    \n    if state.value < 0 then state.value = 0 end\n    if state.total and state.value > state.total then\n        state.value = state.total\n    end\n    \n    setPercent(state)\n    state.changed = true\n    return true\nend\n\nlocal function createState(allStates, npcID)\n    local info = NPCS[npcID]\n    if not info then\n        return false\n    end\n    \n    local idx = INDEX_BY_ID[npcID]\n    if not idx then\n        return false\n    end\n    \n    if not allStates[idx] then\n        allStates[idx] = {\n            show = true,\n            changed = true,\n            progressType = \"static\",\n            index = idx,\n            npcID = npcID,\n            name = info.name,\n            icon = info.icon,\n            total = info.total,\n            value = info.total,\n            isDead = false,\n            mark = \"\",\n        }\n        setPercent(allStates[idx])\n    end\n    \n    return true\nend\n\nfunction aura_env.COMBAT_LOG_EVENT_UNFILTERED(allStates, _, subEvent, _, _, _, _, _, destGUID, _, _, destRaidFlags, ...)\n    if aura_env.config.option.disable then\n        return false\n    end\n    \n    if WeakAuras.GetData(auraID) ~= nil then\n        return false\n    end\n    \n    if not destGUID then\n        return false\n    end\n    \n    local npcID = select(6, strsplit(\"-\", destGUID))\n    local idx = INDEX_BY_ID[npcID]\n    if not idx then\n        return false\n    end\n    \n    if subEvent == \"UNIT_DIED\" then\n        local state = allStates[idx]\n        if state then\n            state.isDead = true\n            state.mark = \"\"\n            state.changed = true\n            return true\n        end\n        return false\n    end\n    \n    local amountIndex = amountIndexes[subEvent]\n    if not amountIndex then\n        return false\n    end\n    \n    if not createState(allStates, npcID) then\n        return false\n    end\n    \n    local state = allStates[idx]\n    if state.isDead then\n        return false\n    end\n    \n    local raidIndex = raidIndexFromRaidFlags(destRaidFlags)\n    state.mark = raidIndex and (\"{rt\" .. raidIndex .. \"}\") or \"\"\n    \n    local amount = select(amountIndex - 11, ...)\n    local isHeal = subEvent == \"SPELL_HEAL\" or subEvent == \"SPELL_PERIODIC_HEAL\"\n    \n    update(state, amount, isHeal)\n    return true\nend\n\nfunction aura_env.OPTIONS(allStates)\n    local dead1 = fastrandom(1, 4)\n    local dead2 = fastrandom(1, 4)\n    \n    while dead2 == dead1 do\n        dead2 = fastrandom(1, 4)\n    end\n    \n    for i = 1, 4 do\n        local npcID = ORDER[i]\n        local info = NPCS[npcID]\n        \n        local isDead = (i == dead1 or i == dead2)\n        local percent = isDead and 0 or fastrandom(1, 100)\n        local value = math.floor(info.total * (percent / 100))\n        \n        allStates[i] = {\n            show = true,\n            changed = true,\n            progressType = \"static\",\n            index = i,\n            npcID = npcID,\n            name = info.name,\n            icon = info.icon,\n            total = info.total,\n            value = value,\n            percent = percent,\n            isDead = isDead,\n            mark = \"{rt\" .. i .. \"}\",\n        }\n    end\n    \n    return true\nend\n\nlocal function reset(allStates)\n    for _, state in pairs(allStates) do\n        state.show = false\n        state.changed = true\n        state.isDead = false\n    end\n    return true\nend\n\nfunction aura_env.WA_FJI_MAULGAR_KILLED(allStates)\n    for _, state in pairs(allStates) do\n        state.show = false\n        state.changed = true\n    end\n    return true\nend\n\nfunction aura_env.WA_FJI_ENCOUNTER_END(allStates)\n    reset(allStates)\n    return true\nend\n\nfunction aura_env.STATUS(allStates)\n    return reset(allStates)\nend",
},
["finish"] = {
