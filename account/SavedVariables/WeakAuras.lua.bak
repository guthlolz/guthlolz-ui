{
["trigger"] = {
["type"] = "custom",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["names"] = {
},
["duration"] = "20",
["event"] = "Health",
["unit"] = "player",
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 8,\n            expirationTime = GetTime() + 8,\n            autoHide = true,\n            guid = WeakAuras.myGUID,\n        }\n        return true\n    end\n    \n    if not _G.FJI_HEALER and not UnitIsGroupLeader(\"player\") then\n        return false\n    end\n    \n    if event == \"WA_COLOSSUS_GEYSER_TARGET\" then\n        local guid, name = ...\n        \n        if guid == WeakAuras.myGUID then\n            return false\n        end\n        \n        allstates[guid] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 8,\n            expirationTime = GetTime() + 8,\n            autoHide = true,\n            guid = guid,\n            name = name,\n        }\n        return true\n    end\nend",
["events"] = "WA_COLOSSUS_GEYSER_TARGET",
["spellIds"] = {
},
