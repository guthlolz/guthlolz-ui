["actions"] = {
["start"] = {
["custom"] = "\n\n",
["do_custom"] = false,
},
["finish"] = {
["custom"] = "aura_env.cancelTicker()",
["do_custom"] = true,
},
["init"] = {
["custom"] = "aura_env.addsAlive = 7\n\naura_env.deathEvents = {\n    WA_KAELTHAS_STAFF_DIED = { id = 1, name = \"Staff\", icon = 135188 },\n    WA_KAELTHAS_MACE_DIED = { id = 2, name = \"Mace\", icon = 133528 },\n    WA_KAELTHAS_DAGGER_DIED = { id = 3, name = \"Dagger\", icon = 134976 },\n    WA_KAELTHAS_SWORD_DIED = { id = 4, name = \"Sword\", icon = 135379 },\n    WA_KAELTHAS_BOW_DIED = { id = 5, name = \"Bow\", icon = 135507 },\n    WA_KAELTHAS_AXE_DIED = { id = 6, name = \"Axe\", icon = 132455 },\n    WA_KAELTHAS_SHIELD_DIED = { id = 7, name = \"Shield\", icon = 134976 },\n}\n\naura_env.mobs = {\n    [1] = { id = 1, npcId = \"21274\", name = \"Staff\", icon = 135188 },\n    [2] = { id = 2, npcId = \"21270\", name = \"Mace\", icon = 133528 },\n    [3] = { id = 3, npcId = \"21271\", name = \"Dagger\", icon = 134976 },\n    [4] = { id = 4, npcId = \"21272\", name = \"Sword\", icon = 135379 },\n    [5] = { id = 5, npcId = \"21268\", name = \"Bow\", icon = 135507 },\n    [6] = { id = 6, npcId = \"21269\", name = \"Axe\", icon = 132455 },\n    [7] = { id = 7, npcId = \"21273\", name = \"Shield\", icon = 134976 },\n}\n\naura_env.npcToMob = {\n    [\"21274\"] = aura_env.mobs[1],\n    [\"21270\"] = aura_env.mobs[2],\n    [\"21271\"] = aura_env.mobs[3],\n    [\"21272\"] = aura_env.mobs[4],\n    [\"21268\"] = aura_env.mobs[5],\n    [\"21269\"] = aura_env.mobs[6],\n    [\"21273\"] = aura_env.mobs[7],\n}\n\nfunction aura_env.createStates(allstates)\n    for id, mob in pairs(aura_env.mobs) do\n        aura_env.updateState(allstates, id, mob.name, mob.icon, 1, false)\n    end\nend\n\nfunction aura_env.updateState(allstates, id, name, icon, hpPercent, isDead)\n    allstates[id] = allstates[id] or {\n        show = true,\n        changed = true,\n        progressType = \"static\",\n        value = 1,\n        total = 1,\n        percent = \"100%\",\n        name = name,\n        icon = icon,\n    }\n    \n    allstates[id].show = true\n    allstates[id].name = name\n    allstates[id].icon = icon\n    allstates[id].isDead = isDead or false\n    \n    if hpPercent then\n        allstates[id].value = hpPercent\n        allstates[id].percent = math.floor(hpPercent * 100) .. \"%\"\n    end\n    \n    if isDead then\n        allstates[id].value = 0\n        allstates[id].percent = \"0%\"\n    end\n    \n    allstates[id].changed = true\n    return true\nend\n\nfunction aura_env.scanUnit(allstates, unit, seen)\n    if not UnitExists(unit) then\n        return\n    end\n    \n    local guid = UnitGUID(unit)\n    if not guid then\n        return\n    end\n    \n    local npcId = select(6, strsplit(\"-\", guid))\n    local mob = aura_env.npcToMob[npcId]\n    if not mob then\n        return\n    end\n    \n    if seen[mob.id] then\n        return\n    end\n    \n    local hpMax = UnitHealthMax(unit)\n    if not hpMax or hpMax <= 0 then\n        return\n    end\n    \n    seen[mob.id] = true\n    \n    local hpPercent = UnitHealth(unit) / hpMax\n    aura_env.updateState(allstates, mob.id, mob.name, mob.icon, hpPercent, false)\nend\n\nfunction aura_env.scanUnits(allstates)\n    local seen = {}\n    \n    aura_env.scanUnit(allstates, \"target\", seen)\n    aura_env.scanUnit(allstates, \"focus\", seen)\n    \n    for i = 1, 40 do\n        aura_env.scanUnit(allstates, \"nameplate\" .. i, seen)\n    end\n    \n    return true\nend\n\nfunction aura_env.hideState(allstates)\n    for _, state in pairs(allstates) do\n        state.show = false\n        state.changed = true\n    end\n    aura_env.cancelTicker()\n    return true\nend\n\nfunction aura_env.startTicker()\n    if aura_env.ticker then\n        aura_env.ticker:Cancel()\n        aura_env.ticker = nil\n    end\n    \n    aura_env.ticker = C_Timer.NewTicker(1, function()\n            WeakAuras.ScanEvents(\"WA_FJI_WEAPON_TICKER\")\n    end)\nend\n\nfunction aura_env.cancelTicker()\n    if aura_env.ticker then\n        aura_env.ticker:Cancel()\n        aura_env.ticker = nil\n    end\nend",
["do_custom"] = true,
},
},
