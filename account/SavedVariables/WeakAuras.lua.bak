["custom"] = "if type(aura_env.soundHandle) == \"number\" then\n    StopSound(aura_env.soundHandle, 1000)\nend\naura_env.soundHandle = nil",
},
["init"] = {
["custom"] = "aura_env.throttle = 0\naura_env.soundHandle = nil\naura_env.lastSoundFile = nil\n\nfunction aura_env.stopSound(fadeMS)\n    if aura_env.soundHandle then\n        StopSound(aura_env.soundHandle, fadeMS or 0)\n        aura_env.soundHandle = nil\n    end\nend\n\nfunction aura_env.getRandomSound()\n    local sounds = {\n        --\"Interface\\\\AddOns\\\\FojjiCore\\\\sound\\\\OhShitOhShit.ogg\",\n        --\"Interface\\\\AddOns\\\\FojjiCore\\\\sound\\\\MetalGearAlert.ogg\",\n        --\"Interface\\\\AddOns\\\\FojjiCore\\\\sound\\\\ManScreaming.ogg\",\n        \"Interface\\\\AddOns\\\\FojjiCore\\\\sound\\\\RetroShot.ogg\",\n    }\n    return sounds[math.random(#sounds)]\nend",
["do_custom"] = true,
},
},
