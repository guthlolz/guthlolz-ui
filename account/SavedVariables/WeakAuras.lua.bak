["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["custom_hide"] = "timed",
["names"] = {
},
["event"] = "Health",
["unit"] = "player",
["subeventSuffix"] = "_CAST_START",
["spellIds"] = {
},
["custom"] = "function(allstates, event, key, time, count)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 3,\n            expirationTime = GetTime() + 3,\n            progressType = \"timed\",\n            icon = 135794,\n            autoHide = true,\n        }\n        return true\n    end\n    \n    if not _G.FJI_TANK and not _G.FJI_MELEE then\n        return false\n    end\n    \n    if event == \"WA_NUMEN_TIMER\" and key == \"SUPREMUS_MOLTEN_PUNCH\" then\n        if time == 0 then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = 2.5,\n                expirationTime = GetTime() + 2.5,\n                progressType = \"timed\",\n                icon = 135794,\n                autoHide = true,\n            }\n        elseif time == nil then\n            if allstates[\"\"] then\n                allstates[\"\"].show = false\n                allstates[\"\"].changed = true\n            end\n        end\n        return true\n    end\nend",
["events"] = "WA_NUMEN_TIMER",
["check"] = "event",
["subeventPrefix"] = "SPELL",
["debuffType"] = "HELPFUL",
["customVariables"] = "{\nstatus = \"string\",\n}",
},
["untrigger"] = {
},
},
{
["trigger"] = {
["type"] = "custom",
["events"] = "ENCOUNTER_START, WA_SUPREMUS_TANK_PHASE, WA_SUPREMUS_KITE_PHASE",
["custom_type"] = "status",
["check"] = "event",
["unit"] = "player",
["custom"] = "function(e)\n    return e == \"ENCOUNTER_START\" or e == \"WA_SUPREMUS_TANK_PHASE\"\nend",
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
["custom"] = "function(e)\n    return e == \"WA_SUPREMUS_KITE_PHASE\"\nend",
},
},
["disjunctive"] = "all",
