["CT:[BT][Illidan] Agonizing Flames"] = {
["outline"] = "OUTLINE",
["wagoID"] = "pbbuhQ899",
["parent"] = "[BT][Illidan]",
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiBT-P1/12",
["actions"] = {
["start"] = {
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.debug = false\naura_env.key = \"ILLIDAN_AGONIZING_FLAMES\"\naura_env.count = 1\naura_env.cdStart = 20\naura_env.cdStartP3 = 35\naura_env.cdStartP4 = 25\naura_env.cdWindow = 20\naura_env.preWarnTime = 3\naura_env.throttle = 0\n\naura_env.nextDemonForm = nil\naura_env.demonFormCutoff = 3\n\naura_env.spellName = \"Agonizing Flames\"\naura_env.spellID = 40932\naura_env.encounterID = 609\n\naura_env.pullStart = nil\naura_env.lastCast = nil\n\nfunction aura_env.debugPrint(message)\n    if aura_env.debug then\n        print(message)\n    end\nend\n\nfunction aura_env.nuTimer(countdown,count)\n    WeakAuras.ScanEvents(\"WA_NUMEN_TIMER\", aura_env.key, countdown, count)\nend\n\nfunction aura_env.updateState(allstates)\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n    }\nend\n\nfunction aura_env.hideState(allstates)\n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\nend\n\nfunction aura_env.preWarn(duration,preWarnTime,count)\n    preWarnTime = preWarnTime or 3\n    \n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\n    \n    aura_env.preWarnTimer = C_Timer.NewTimer(duration - preWarnTime, function()\n            WeakAuras.ScanEvents(\"WA_\" .. aura_env.key .. \"_PREWARN\", preWarnTime, count)\n            aura_env.preWarnTimer = nil\n    end)\nend\n\nfunction aura_env.preWarnCancel()\n    WeakAuras.ScanEvents(\"WA_\" .. aura_env.key .. \"_PREWARN_CANCEL\")\n    \n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "aura_env.count = 1\naura_env.nuTimer(nil)\naura_env.preWarnCancel()\naura_env.pullStart = nil\naura_env.lastCast = nil",
["do_sound"] = false,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
["do_message"] = false,
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "ENCOUNTER_START, ENCOUNTER_END, WA_FJI_ENCOUNTER_END, WA_FJI_ENCOUNTER_START, CLEU:SPELL_AURA_APPLIED, WA_ILLIDAN_P2_START, WA_ILLIDAN_P3_START, WA_ILLIDAN_P4_START, WA_ILLIDAN_P3_END, WA_ILLIDAN_DEMON_FORM, WA_ILLIDAN_HUMAN_FORM, WA_NUMEN_TIMER",
["spellIds"] = {
},
["custom"] = "function(allstates,event,...)\n    if event == \"WA_NUMEN_TIMER\" then\n        local key,countdown = ...\n        \n        if key ~= \"ILLIDAN_DEMON_FORM\" then\n            return false\n        end\n        \n        if countdown and countdown > 0 then\n            aura_env.nextDemonForm = GetTime()+countdown\n        else\n            aura_env.nextDemonForm = nil\n        end\n        return false\n    end\n    \n    local eID,subEvent,_,sourceGUID,_,_,_,destGUID,destName,destFlags,_,spellId = ...\n    \n    if event == \"WA_FJI_ENCOUNTER_START\" or event == \"ENCOUNTER_START\" then\n        if eID ~= aura_env.encounterID then\n            return false\n        end\n        \n        aura_env.pullStart = GetTime()\n        aura_env.lastCast = nil\n        aura_env.nextDemonForm = nil\n        aura_env.count = 1\n        \n        aura_env.updateState(allstates)\n        return true\n    elseif event == \"WA_ILLIDAN_HUMAN_FORM\" then\n        aura_env.pullStart = GetTime()\n        aura_env.lastCast = nil\n        aura_env.count = 1\n        \n        aura_env.preWarn(aura_env.cdStart,aura_env.preWarnTime,aura_env.count)\n        aura_env.nuTimer(aura_env.cdStart,aura_env.count)\n        return true\n    elseif event == \"WA_ILLIDAN_P3_START\" then\n        aura_env.pullStart = GetTime()\n        aura_env.lastCast = nil\n        aura_env.count = 1\n        \n        aura_env.preWarn(aura_env.cdStartP3,aura_env.preWarnTime,aura_env.count)\n        aura_env.nuTimer(aura_env.cdStartP3,aura_env.count)\n        return true\n    elseif event == \"WA_ILLIDAN_P4_START\" then\n        aura_env.pullStart = GetTime()\n        aura_env.lastCast = nil\n        aura_env.count = 1\n        \n        aura_env.preWarn(aura_env.cdStartP4,aura_env.preWarnTime,aura_env.count)\n        aura_env.nuTimer(aura_env.cdStartP4,aura_env.count)\n        return true\n    elseif event == \"WA_ILLIDAN_P2_START\" or event == \"WA_ILLIDAN_DEMON_FORM\" or event == \"WA_ILLIDAN_P3_END\" then\n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        return false\n    elseif event == \"WA_FJI_ENCOUNTER_END\" or event == \"ENCOUNTER_END\" then\n        aura_env.pullStart = nil\n        aura_env.lastCast = nil\n        aura_env.nextDemonForm = nil\n        aura_env.count = 1\n        \n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        return false\n    end\n    \n    if spellId ~= aura_env.spellID then\n        return false\n    end\n    \n    if subEvent == \"SPELL_AURA_APPLIED\" then\n        WeakAuras.ScanEvents(\"WA_ILLIDAN_AGONIZING_APPLIED\",destGUID)\n        local now = GetTime()\n        \n        if now-aura_env.throttle < 5 then\n            return false\n        end\n        aura_env.throttle = now\n        \n        if aura_env.lastCast then\n            aura_env.debugPrint(string.format(\"Next %s (%d): %.1fs after previous.\",aura_env.spellName,aura_env.count,now-aura_env.lastCast))\n        elseif aura_env.pullStart then\n            aura_env.debugPrint(string.format(\"First %s (%d): %.1fs into phase.\",aura_env.spellName,aura_env.count,now-aura_env.pullStart))\n        end\n        \n        aura_env.lastCast = now\n        \n        aura_env.nuTimer(0,aura_env.count)\n        aura_env.count = aura_env.count+1\n        \n        local demonRemaining = aura_env.nextDemonForm and aura_env.nextDemonForm-now\n        \n        if demonRemaining and demonRemaining < aura_env.cdWindow-aura_env.demonFormCutoff then\n            aura_env.debugPrint(string.format(\"Skipping next %s timer: Demon Form expected in %.1fs.\",aura_env.spellName,demonRemaining))\n            return false\n        end\n        \n        aura_env.preWarn(aura_env.cdWindow,aura_env.preWarnTime,aura_env.count)\n        aura_env.nuTimer(aura_env.cdWindow,aura_env.count)\n        return false\n    end\n    \n    return false\nend",
["check"] = "event",
