["custom"] = "function(allstates, event, key, time, count)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 1.3,\n            expirationTime = GetTime() + 1.3,\n            autoHide = true,\n            icon = 136214,\n        }\n        return true\n    end\n    \n    if event == \"WA_NUMEN_TIMER\" then\n        if key == \"ILLIDAN_SHADOW_DEMONS\" and time == 0 then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = 1.3,\n                expirationTime = GetTime() + 1.3,\n                autoHide = true,\n                icon = 136214,\n            }\n            return true\n        end\n    end\nend",
