["event"] = "Health",
["unit"] = "player",
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = aura_env.castTime,\n            expirationTime = GetTime() + aura_env.castTime,\n            autoHide = true,\n            icon = aura_env.icon,\n            name = UnitClassBase(\"player\") == \"HUNTER\" and \"FEIGN\" or \"VANISH\",\n        }\n        return true\n    end\n    \n    if event == \"WA_ARCHIMONDE_BURST_TARGET\" then\n        local guid, name = ...\n        if guid ~= WeakAuras.myGUID then\n            return false\n        end\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = aura_env.castTime,\n            expirationTime = GetTime() + aura_env.castTime,\n            autoHide = true,\n            icon = aura_env.icon,\n            name = UnitClassBase(\"player\") == \"HUNTER\" and \"FEIGN\" or \"VANISH\",\n        }\n        return true\n    end\nend",
