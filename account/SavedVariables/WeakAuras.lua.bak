["message"] = "",
["custom"] = "local SparkColor = aura_env.config[\"Color_Spark\"]\naura_env.region.bar[\"spark\"]:SetVertexColor(SparkColor[1],SparkColor[2],SparkColor[3],SparkColor[4])\n\n\n\n\n",
