["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        if aura_env.ticker then\n            aura_env.ticker:Cancel()\n            aura_env.ticker = nil\n        end\n        \n        allstates[\"player\"] = {\n            show = true,\n            changed = true,\n            unit = \"player\",\n            target = \"player\",\n            targetGUID = WeakAuras.myGUID,\n        }\n        return true\n    end\n    \n    if event == \"NAME_PLATE_UNIT_REMOVED\" then\n        local unit = ...\n        \n        if allstates[unit] then\n            allstates[unit].show = false\n            allstates[unit].changed = true\n            aura_env.cancelTicker()\n            return true\n        end\n    end\n    \n    if event == \"WA_FJI_ENCOUNTER_START\" or event == \"ENCOUNTER_START\" then\n        aura_env.allow = true\n        return\n    end\n    \n    if event == \"WA_KAELTHAS_THALADRED_DIED\" then\n        aura_env.allow = false\n        return\n    end\n    \n    if event == \"WA_KAELTHAS_P3_START\" then\n        aura_env.allow = true\n        return\n    end\n    \n    if not aura_env.allow then\n        return false\n    end\n    \n    if event == \"PLAYER_TARGET_CHANGED\" then\n        local unit = \"target\"\n        if UnitExists(unit) then\n            local guid = UnitGUID(unit)\n            local npcID = select(6, strsplit(\"-\", guid or \"\"))\n            \n            if npcID == \"20064\" then\n                local unitTarget = unit .. \"target\"\n                local targetGUID = UnitExists(unitTarget) and UnitGUID(unitTarget) or nil\n                if targetGUID then\n                    WeakAuras.ScanEvents(\"WA_THALADRED_GAZE_TARGET_NAMEPLATE\", targetGUID)\n                end\n            end\n        end\n    end\n    \n    if event == \"UNIT_TARGET\" then\n        local unit = ...\n        if unit and UnitExists(unit) then\n            local guid = UnitGUID(unit)\n            local npcID = select(6, strsplit(\"-\", guid or \"\"))\n            \n            if npcID == \"20064\" then\n                local unitTarget = unit .. \"target\"\n                local targetGUID = UnitExists(unitTarget) and UnitGUID(unitTarget) or nil\n                if targetGUID then\n                    WeakAuras.ScanEvents(\"WA_THALADRED_GAZE_TARGET_NAMEPLATE\", targetGUID)\n                end\n            end\n        end\n    end\n    \n    if event == \"NAME_PLATE_UNIT_ADDED\" then\n        local unit = ...\n        local guid = UnitGUID(unit)\n        local npcID = select(6, strsplit(\"-\", guid or \"\"))\n        \n        if npcID == \"20064\" then\n            if not aura_env.ticker then\n                aura_env.ticker = C_Timer.NewTicker(0.1, function()\n                        WeakAuras.ScanEvents(\"WA_THALADRED_TARGET_CHECK\")\n                end)\n            end\n            \n            local unitTarget = unit .. \"target\"\n            local targetUnit = UnitExists(unitTarget) and unitTarget or nil\n            local targetGUID = targetUnit and UnitGUID(targetUnit) or nil\n            \n            allstates[unit] = {\n                show = true,\n                changed = true,\n                unit = unit,\n                target = targetUnit,\n                targetGUID = targetGUID,\n            }\n            \n            if targetGUID then\n                WeakAuras.ScanEvents(\"WA_THALADRED_GAZE_TARGET_NAMEPLATE\", targetGUID)\n            end\n            return true\n        end\n    end\n    \n    if event == \"WA_THALADRED_TARGET_CHECK\" then\n        for unit, state in pairs(allstates) do\n            if state.show and UnitExists(unit) then\n                local unitTarget = unit .. \"target\"\n                local targetUnit = UnitExists(unitTarget) and unitTarget or nil\n                local targetGUID = targetUnit and UnitGUID(targetUnit) or nil\n                \n                state.target = targetUnit\n                state.targetGUID = targetGUID\n                state.changed = true\n                \n                if targetGUID then\n                    WeakAuras.ScanEvents(\"WA_THALADRED_GAZE_TARGET_NAMEPLATE\", targetGUID)\n                end\n            end\n        end\n        return true\n    end\nend",
["spellIds"] = {
},
["events"] = "NAME_PLATE_UNIT_ADDED NAME_PLATE_UNIT_REMOVED WA_THALADRED_TARGET_CHECK WA_FJI_ENCOUNTER_START ENCOUNTER_START UNIT_TARGET PLAYER_TARGET_CHANGED WA_FJI_ENCOUNTER_START ENCOUNTER_START WA_KAELTHAS_THALADRED_DIED WA_KAELTHAS_P3_START",
