["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(a, e)\n    for _, state in pairs(a) do\n        state.show = false\n        state.changed = true\n    end\n    \n    wipe(aura_env.guids)\n    \n    for unit in WA_IterateGroupMembers() do\n        local guid = UnitGUID(unit)\n        if guid then\n            table.insert(aura_env.guids, guid)\n        end\n    end\n    \n    table.sort(aura_env.guids, function(g1, g2)\n            return aura_env.extractGUID(g1) < aura_env.extractGUID(g2)\n    end)\n    \n    local guid = aura_env.guids[1]\n    if guid then\n        a[guid] = {\n            GUID = aura_env.extractGUID(guid),\n            name = guid,\n            show = true,\n            changed = true,\n        }\n    end\n    \n    return true\nend",
["spellIds"] = {
},
["events"] = "STATUS GROUP_ROSTER_UPDATE",
["check"] = "event",
["unit"] = "player",
["custom_hide"] = "timed",
["customVariables"] = "{\n    isHeader = \"bool\",\n}",
},
