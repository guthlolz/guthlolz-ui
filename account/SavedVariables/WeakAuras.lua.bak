},
["displayText_format_p_time_format"] = 0,
["sameTexture"] = true,
["url"] = "https://wago.io/FojjiBT-P1/12",
["actions"] = {
["start"] = {
["custom"] = "local state = aura_env.state\nif state and state.spellKey then\n    local color = aura_env.getColor(state.spellKey)\n    aura_env.region:Color(color[1], color[2], color[3], color[4] or 1)\nend",
["do_custom"] = true,
["do_sound"] = false,
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.region.bar:SetVertexColor(1, 1, 1, 1)\n\naura_env.spellKeys = {\n    -- name, icon, autoHide (true/false), role (\"TANK\"/\"HEALER\"), roleRestrict (true/false), useText (true/false), includeRL (true/false)\n    -- note that the first role is selected for the Icon\n    \n    --[\"JIKUN_TALON_RAKE\"] = {name = \"Talon Rake\", icon = 236272, role = {\"TANK\", \"HEALER\"}, roleRestrict = true},\n    \n    [\"NAJENTUS_SPINE\"] = { name = \"Impaling Spine\", icon = 135855},\n    [\"NAJENTUS_SHIELD\"] = { name = \"Tidal Shield\", icon = 136017},\n    \n    [\"SUPREMUS_KITE\"] = { name = \"Kite Phase\", icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\supremus.jpg\"},\n    [\"SUPREMUS_TANK\"] = { name = \"Tank Phase\", icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\supremus.jpg\"},\n    [\"SUPREMUS_FIXATE\"] = { name = \"Fixate\", icon = 136129},\n    [\"SUPREMUS_HATEFUL\"] = { name = \"Hateful Strike\", icon = 132282},\n    [\"SUPREMUS_VOLCANO\"] = { name = \"Volcano\", icon = 135793},\n    [\"SUPREMUS_MOLTEN_PUNCH\"] = { name = \"Molten Punch\", icon = 135802},\n    \n    [\"TERON_CRUSHING_SHADOWS\"] = { name = \"Crushing Shadows\", icon = 136224},\n    [\"TERON_DEATH\"] = { name = \"Shadow of Death\", icon = 135752},\n    \n    [\"GURTOGG_STRIKE\"] = { name = \"Disorient\", icon = 132096},\n    [\"GURTOGG_SMASH\"] = { name = \"Arcing Smash\", icon = 132338},\n    [\"GURTOGG_BLOODBOIL\"] = { name = \"Bloodboil\", icon = 136124},\n    [\"GURTOGG_BREATH\"] = { name = \"Fel-Acid Breath\", icon = 136007},\n    [\"GURTOGG_RAGE_PHASE\"] = { name = \"Rage Phase\", icon = 135791},\n    [\"GURTOGG_BLOOD_PHASE\"] = { name = \"Blood Phase\", icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\gurtogg.jpg\"},\n    \n    [\"RELIQUARY_SOUL_DRAIN\"] = { name = \"Soul Drain\", icon = 136222},\n    [\"RELIQUARY_ENRAGE\"] = { name = \"Enrage\", icon = 136224},\n    [\"RELIQUARY_FIXATE\"] = { name = \"Fixate\", icon = 136215},\n    [\"RELIQUARY_RUNE_SHIELD\"] = { name = \"Rune Shield\", icon = 135735},\n    [\"RELIQUARY_DEADEN\"] = { name = \"Deaden\", icon = 136212},\n    [\"RELIQUARY_SPIRIT_SHOCK\"] = { name = \"Spirit Shock\", icon = 135739},\n    [\"RELIQUARY_SOUL_SCREAM\"] = { name = \"Soul Scream\", icon = 136131, role == \"TANK\", roleRestrict = false},\n    [\"RELIQUARY_SPITE\"] = { name = \"Spite\", icon = 136150},\n    \n    [\"SHAHRAZ_SHRIEK\"] = { name = \"Silencing Shriek\", icon = 136164},\n    [\"SHAHRAZ_PRISMATIC_AURA\"] = { name = \"Prismatic Aura\", icon = 134131},\n    [\"SHAHRAZ_SABER_LASH\"] = { name = \"Saber Lash\", icon = 132373},\n    [\"SHAHRAZ_ATTRACTION\"] = { name = \"Fatal Attraction\", icon = 136202},\n    \n    [\"ILLIDARI_BOP\"] = { name = \"Blessing of Protection\", icon = 135964},\n    [\"ILLIDARI_SPELL_WARDING\"] = { name = \"Spell Warding\", icon = 135965},\n    [\"ILLIDARI_CIRCLE\"] = { name = \"Circle of Healing\", icon = 135943},\n    [\"ILLIDARI_VANISH\"] = { name = \"Vanish\", icon = 132331},\n    [\"ILLIDARI_CONSECRATION\"] = { name = \"Consecration\", icon = 135926},\n    [\"ILLIDARI_JUDGEMENT\"] = { name = \"Judgement\", icon = 135959},\n    [\"ILLIDARI_BLIZZARD\"] = { name = \"Blizzard\", icon = 135857},\n    [\"ILLIDARI_DAMPEN_MAGIC\"] = { name = \"Dampen Magic\", icon = 136006},\n    [\"ILLIDARI_FLAMESTRIKE\"] = { name = \"Flamestrike\", icon = 135826},\n    [\"ILLIDARI_DIVINE_WRATH\"] = { name = \"Divine Wrath\", icon = 135972},\n    [\"ILLIDARI_REFLECTIVE_SHIELD\"] = { name = \"Reflective Shield\", icon = 135940},\n    \n    [\"ILLIDAN_DARK_BARRAGE\"] = { name = \"Dark Barrage\", icon = 136181},\n    [\"ILLIDAN_DRAW_SOUL\"] = { name = \"Draw Soul\", icon = 136131},\n    [\"ILLIDAN_FLAME_CRASH\"] = { name = \"Flame Crash\", icon = 135784},\n    [\"ILLIDAN_PARASITE\"] = { name = \"Parasite\", icon = 136214},\n    [\"ILLIDAN_SHEAR\"] = { name = \"Shear\", icon = 136158},\n    [\"ILLIDAN_EYE_BEAM\"] = { name = \"Eye Beam\", icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\illidan.jpg\"},\n    [\"ILLIDAN_SHADOW_DEMONS\"] = { name = \"Shadow Demons\", icon = 136214},\n    [\"ILLIDAN_FLAME_BURST\"] = { name = \"Flame Burst\", icon = 135787},\n    [\"ILLIDAN_P4_START\"] = { name = \"Phase 4\", icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\illidan.jpg\", autoHide = true},\n    [\"ILLIDAN_AGONIZING_FLAMES\"] = {name = \"Agonizing Flames\", icon = 135785},\n    [\"ILLIDAN_ENRAGE\"] = {name = \"Enrage\", icon = 136224},\n}\n\naura_env.timers = {}\n\nfunction aura_env.getColor(key)\n    local cfg = aura_env.config.option\n    \n    if cfg.colorOverride and cfg.color then\n        return { cfg.color[1], cfg.color[2], cfg.color[3], cfg.color[4] or 1 }\n    end\n    \n    local color = cfg.enabledGroup and cfg.enabledGroup[\"COL_\" .. key]\n    if color and color[1] then\n        return { color[1], color[2], color[3], color[4] or 1 }\n    end\nend\n\nlocal function createKey(key, guid)\n    if guid then\n        return key .. \"_\" .. guid\n    end\n    return key\nend\n\nfunction aura_env.updateState(allstates, key, duration, count, name, icon, color, autoHide, text, guid)\n    local r, g, b, a = color[1], color[2], color[3], color[4] or 1\n    local stateKey = (guid and (key .. \"_\" .. guid)) or key\n    \n    allstates[stateKey] = {\n        show = true,\n        changed = true,\n        duration = duration,\n        expirationTime = GetTime() + duration,\n        progressType = \"timed\",\n        count = count,\n        color = { r, g, b, a },\n        icon = icon,\n        name = name,\n        autoHide = autoHide,\n        text = text or \"\",\n        spellKey = key,\n        useText = text and text ~= \"\",\n    }\nend\n\nfunction aura_env.hideState(allstates, key, guid)\n    local stateKey = createKey(key, guid)\n    \n    if allstates[stateKey] then\n        allstates[stateKey].show = false\n        allstates[stateKey].changed = true\n        return true\n    end\nend\n\nfunction aura_env.scheduleTimer(key, delay, count, displayName, icon, color, autoHide, text, guid, tts)\n    local timerKey = (guid and (key .. \"_\" .. guid)) or key\n    \n    if aura_env.timers[timerKey] then\n        aura_env.timers[timerKey]:Cancel()\n        aura_env.timers[timerKey] = nil\n    end\n    \n    aura_env.timers[timerKey] = C_Timer.NewTimer(delay, function()\n            WeakAuras.ScanEvents(\"WA_NUMEN_EMPHASIZED_TIMER\",\n            key, 10, count, displayName, icon, color, autoHide, text, guid, tts)\n    end)\nend\n\nfunction aura_env.cancelTimer(key, guid)\n    local timerKey = createKey(key, guid)\n    \n    if aura_env.timers[timerKey] then\n        aura_env.timers[timerKey]:Cancel()\n        aura_env.timers[timerKey] = nil\n    end\nend",
["do_custom"] = true,
},
