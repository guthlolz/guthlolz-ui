["finish"] = {
["do_glow"] = false,
["custom"] = "aura_env.state.RemainingTime = aura_env.state.expirationTime-GetTime()\n\nif (aura_env.state.RemainingTime < aura_env.config.Threshold_Success) then \n    \n    aura_env.state.BarColor = aura_env.config[\"Color_Success\"]\n    \nelse\n    \n    aura_env.state.BarColor = aura_env.config[\"Color_Interrupted\"]\n    aura_env.region.subRegions[3].text:SetText(\"Interrupted\")\n    \n    \nend\n\n\n\n",
