["id"] = "I:[T5][SSC][Trash] Holy Fire",
["useCooldownModRate"] = true,
["alpha"] = 1,
["anchorFrameType"] = "SCREEN",
["preferToUpdate"] = false,
["uid"] = "LNnC3g(HvW1",
["inverse"] = false,
