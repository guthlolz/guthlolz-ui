["[CL]:Rogue - Poison Town Reminder"] = {
["iconSource"] = -1,
["wagoID"] = "4BhGIADMz",
["parent"] = "[CL]:Rogue - Reminders",
["adjustedMax"] = "",
["adjustedMin"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["cooldownSwipe"] = true,
["cooldownEdge"] = false,
["icon"] = true,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["event"] = "Health",
["unit"] = "player",
["spellIds"] = {
},
["events"] = "BAG_UPDATE_DELAYED STATUS",
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"mindnumbing\"] = {\n            show = true,\n            changed = true,\n            progressType = \"static\",\n            name = \"Numb\",\n            value = 3,\n            total = aura_env.config.option.threshold or 20,\n            icon = 132274,\n        }\n        return true\n    end\n    \n    local playerLevel = UnitLevel(\"player\")\n    local threshold = aura_env.config.option.threshold or 0\n    \n    local poisonGroups = {\n        mindnumbing = aura_env.mindnumbing,\n        instant     = aura_env.instant,\n        deadly      = aura_env.deadly,\n        wound       = aura_env.wound,\n        crippling   = aura_env.crippling,\n    }\n    \n    for poisonType, items in pairs(poisonGroups) do\n        if aura_env.config.option[poisonType] then\n            local bestItemID\n            local bestLevel = 0\n            \n            for itemID, requiredLevel in pairs(items) do\n                if playerLevel >= requiredLevel and requiredLevel > bestLevel then\n                    bestItemID = itemID\n                    bestLevel = requiredLevel\n                end\n            end\n            if bestItemID then\n                local count = GetItemCount(bestItemID)\n                local itemName, _, _, _, _, _, _, _, _, icon = GetItemInfo(bestItemID)\n                allstates[poisonType] = {\n                    show = count <= threshold,\n                    changed = true,\n                    progressType = \"static\",\n                    name = aura_env.poisonNames[poisonType],\n                    icon = icon,\n                    value = count,\n                    total = threshold,\n                }\n            elseif allstates[poisonType] then\n                allstates[poisonType].show = false\n                allstates[poisonType].changed = true\n            end\n        elseif allstates[poisonType] then\n            allstates[poisonType].show = false\n            allstates[poisonType].changed = true\n        end\n    end\n    return true\nend",
["names"] = {
},
["check"] = "event",
["subeventPrefix"] = "SPELL",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "{\n    name = \"string\",\n}",
