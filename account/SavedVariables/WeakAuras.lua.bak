["[T5][Vashj] Tainted Core [CLICKABLE]"] = {
["iconSource"] = -1,
["wagoID"] = "gSs1_GQRl",
["xOffset"] = 0,
["adjustedMax"] = "",
["adjustedMin"] = "",
["yOffset"] = 0,
["anchorPoint"] = "RIGHT",
["cooldownSwipe"] = true,
["url"] = "https://wago.io/FojjiT5RaidPack/3",
["icon"] = true,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["subeventSuffix"] = "_CAST_START",
["events"] = "PLAYER_TARGET_CHANGED PLAYER_REGEN_ENABLED CHAT_MSG_MONSTER_YELL WA_VASHJ_CREATE_CLICKABLE",
["custom"] = "function(allstates, event, ...)\n    if event == \"STATUS\" then\n        aura_env.shown = false\n        return\n    end\n    \n    if event == \"WA_VASHJ_CREATE_CLICKABLE\" then\n        if UnitAffectingCombat(\"player\") then\n            aura_env.scheduleCreate()\n            return\n        end\n        \n        aura_env.isPending = false\n        aura_env.shown = true\n        aura_env.createClickable(allstates)\n        return true\n    end\n    \n    if event == \"PLAYER_REGEN_ENABLED\" then\n        if aura_env.shown then\n            return\n        end\n        \n        if aura_env.isPending then\n            aura_env.scheduleCreate()\n        end\n    end\n    \n    if event == \"PLAYER_TARGET_CHANGED\" then\n        if aura_env.shown then\n            return\n        end\n        \n        if UnitExists(\"target\") then\n            local guid = UnitGUID(\"target\")\n            local npcID = select(6, strsplit(\"-\", guid))\n            \n            if npcID == \"21212\" then\n                aura_env.scheduleCreate()\n            end\n        end\n    end\n    \n    if event == \"CHAT_MSG_MONSTER_YELL\" then\n        local msg = ...\n        \n        if msg == aura_env.currentLocale.bridge or msg:find(aura_env.currentLocale.bridge, 1, true) then\n            if UnitAffectingCombat(\"player\") then\n                aura_env.isPending = true\n                return\n            end\n            WeakAuras.ScanEvents(\"WA_VASHJ_CREATE_CLICKABLE\")\n        end\n    end\nend",
["subeventPrefix"] = "SPELL",
["check"] = "event",
["unit"] = "player",
["spellIds"] = {
},
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
},
},
["disjunctive"] = "custom",
["customTriggerLogic"] = "function(t)\n    return t[1]\nend",
["activeTriggerMode"] = -10,
},
["internalVersion"] = 90,
["keepAspectRatio"] = false,
["animation"] = {
["start"] = {
["easeStrength"] = 3,
["duration_type"] = "seconds",
["type"] = "none",
["easeType"] = "none",
},
["main"] = {
["colorR"] = 1,
["duration_type"] = "seconds",
["alphaType"] = "alphaPulse",
["colorA"] = 1,
["colorG"] = 1,
["alphaFunc"] = "function(progress, start, delta)\n    local angle = (progress * 2 * math.pi) - (math.pi / 2)\n    return start + (((math.sin(angle) + 1)/2) * delta)\nend\n",
["use_alpha"] = true,
["type"] = "none",
["easeType"] = "none",
["scaley"] = 1,
["alpha"] = 0.75,
["y"] = 0,
["x"] = 0,
["scalex"] = 1,
["colorB"] = 1,
["rotate"] = 0,
["easeStrength"] = 3,
["preset"] = "alphaPulse",
["duration"] = "0.5",
},
["finish"] = {
["easeStrength"] = 3,
["duration_type"] = "seconds",
["type"] = "none",
["easeType"] = "none",
},
},
["desc"] = "",
["actions"] = {
["start"] = {
["message"] = "",
["custom"] = "",
["message_custom"] = "",
["message_format_c_format"] = "none",
["do_custom"] = false,
["do_message"] = false,
["message_type"] = "SAY",
},
["finish"] = {
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.itemID = 31088\n--74648\n\nfunction aura_env.createClickable(allstates)\n    if not aura_env.button then\n        local r = WeakAuras.GetRegion(aura_env.id)\n        aura_env.button = CreateFrame(\"Button\", \"Reminder\", r, \"SecureActionButtonTemplate\")\n    end\n    \n    aura_env.button:SetAllPoints()\n    aura_env.button:RegisterForClicks(\"LeftButtonDown\", \"LeftButtonUp\")\n    aura_env.button:SetAttribute(\"type1\", \"macro\")\n    aura_env.button:SetAttribute(\"macrotext1\", \"/use item:\" .. aura_env.itemID)\n    \n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n    }\n    WeakAuras.ScanEvents(\"WA_VASHJ_TAINTED_CLICKABLE_ACTIVE\")\n    print(\"|cff00ccffFojji|r|cff00ff00T5|r - Tainted Clickable Frame Created\")\nend\n\naura_env.isPending = false\naura_env.shown = false\n\nfunction aura_env.scheduleCreate()\n    if aura_env.shown then\n        return\n    end\n    if aura_env.timer then\n        aura_env.timer:Cancel()\n        aura_env.timer = nil\n    end\n    \n    aura_env.timer = C_Timer.NewTimer(1, function()\n            WeakAuras.ScanEvents(\"WA_VASHJ_CREATE_CLICKABLE\")\n    end)\nend\n\nlocal locale = GetLocale()\n\naura_env.locales = {\n    [\"enUS\"] = {\n        bridge = \"Water... is life.\",\n    },\n    [\"frFR\"] = {\n        bridge = \"Water... is life.\",\n    },\n    [\"deDE\"] = {\n        bridge = \"Wasser ist Leben.\",\n    },\n    [\"esES\"] = {\n        bridge = \"El agua... es vida.\",\n    },\n    [\"koKR\"] = {\n        bridge = \"물은 곧... 생명\",\n    },\n    [\"ruRU\"] = {\n        bridge = \"Вода... это жизнь.\",\n    },\n    [\"zhCN\"] = {\n        bridge = \"水……就是生命。\",\n    },\n    [\"zhTW\"] = {\n        bridge = \"水，就是生命。\",\n    }\n}\n\naura_env.currentLocale = aura_env.locales[locale] or aura_env.locales[\"enUS\"]",
["do_custom"] = true,
},
},
