["custom"] = "function(allstates, event, key, time)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 15,\n            expirationTime = GetTime() + 15,\n            progressType = \"timed\",\n            autoHide = true,\n        }\n        return true\n    end\n    if event == \"WA_NUMEN_TIMER\" and key == \"ILLIDAN_EYE_BEAM\" then\n        if time == 0 then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = 15,\n                expirationTime = GetTime() + 15,\n                progressType = \"timed\",\n                autoHide = true,\n            }\n            return true\n        elseif time == nil then\n            if allstates[\"\"] then\n                allstates[\"\"].show = false\n                allstates[\"\"].changed = true\n                return true\n            end\n        end\n    end\nend",
