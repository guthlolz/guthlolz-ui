["backgroundOffset"] = 2,
["parent"] = "[BT] Reliquary Team#2",
["adjustedMin"] = "",
["desaturateBackground"] = false,
["cooldownSwipe"] = true,
["customTextUpdate"] = "event",
["displayText_format_t_time_dynamic_threshold"] = 60,
["desaturateForeground"] = false,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "{\n    expirationTime = true,\n}",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "OPTIONS ENCOUNTER_START ENCOUNTER_END CHAT_MSG_RAID_LEADER CLEU:SPELL_CAST_SUCCESS WA_FJI_ENCOUNTER_START WA_FJI_ENCOUNTER_END WA_RELIQUARY_P2_END",
["spellIds"] = {
},
["custom"] = "function(a, e, ...)\n    if e == \"OPTIONS\" then\n        a[1] = {\n            show = true,\n            changed = true,\n            name = WeakAuras.me,\n            index = 1,\n            progressType = \"timed\",\n            duration = 24,\n            expirationTime = GetTime() + 16,\n            autoHide = false,\n        }\n        \n        a[2] = {\n            show = true,\n            changed = true,\n            name = WeakAuras.me,\n            index = 2,\n            progressType = \"timed\",\n            duration = 6,\n            expirationTime = GetTime() + 4,\n            autoHide = false,\n        }\n        \n        a[3] = {\n            show = true,\n            changed = true,\n            name = WeakAuras.me,\n            index = 3,\n            progressType = \"static\",\n            value = 1,\n            total = 1,\n        }\n        return true\n    end\n    \n    if e == \"ENCOUNTER_START\" or e == \"WA_FJI_ENCOUNTER_START\" then\n        local eID = ...\n        \n        if eID ~= aura_env.encounterID then\n            return false\n        end\n        \n        aura_env.encounterActive = true\n        \n        wipe(aura_env.teamPlayers)\n        aura_env.UpdatePetOwners()\n        \n        return aura_env.HideStates(a)\n    end\n    \n    if e == \"ENCOUNTER_END\" or e == \"WA_FJI_ENCOUNTER_END\" or e == \"WA_RELIQUARY_P2_END\" then\n        return aura_env.Reset(a)\n    end\n    \n    if e == \"CHAT_MSG_RAID_LEADER\" then\n        if not aura_env.encounterActive then\n            return false\n        end\n        \n        local msg = ...\n        if not msg then\n            return false\n        end\n        \n        if msg == \"Reliquary Interrupt Rotation\" then\n            wipe(aura_env.teamPlayers)\n            return aura_env.HideStates(a)\n        end\n        \n        local teamNum, playerText = msg:match(\"^TEAM([1-5])%-(.+)$\")\n        if not teamNum or not playerText then\n            return false\n        end\n        \n        if tonumber(teamNum) ~= aura_env.teamIndex then\n            return false\n        end\n        \n        wipe(aura_env.teamPlayers)\n        aura_env.HideStates(a)\n        aura_env.UpdatePetOwners()\n        \n        local index = 1\n        \n        for _, name in ipairs({ strsplit(\",\", playerText) }) do\n            name = strtrim(name)\n            \n            if name ~= \"\" then\n                aura_env.teamPlayers[name] = true\n                \n                a[name] = {\n                    show = true,\n                    changed = true,\n                    name = name,\n                    index = index,\n                    progressType = \"static\",\n                    value = 1,\n                    total = 1,\n                }\n                \n                index = index + 1\n            end\n        end\n        \n        return true\n    end\n    \n    if e == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local _,subEvent,_,sourceGUID,sourceName,_,_,destGUID,destName,_,_,spellId = ...\n        \n        if subEvent ~= \"SPELL_CAST_SUCCESS\" then\n            return false\n        end\n        \n        local duration = aura_env.interruptCDs[spellId]\n        if not duration then\n            return false\n        end\n        \n        local playerName = sourceName\n        \n        if not playerName or not aura_env.teamPlayers[playerName] then\n            playerName = aura_env.petOwners[sourceGUID]\n            \n            if not playerName or not aura_env.teamPlayers[playerName] then\n                return false\n            end\n        end\n        \n        local state = a[playerName]\n        if not state then\n            return false\n        end\n        \n        state.progressType = \"timed\"\n        state.duration = duration\n        state.expirationTime = GetTime() + duration\n        state.autoHide = false\n        state.changed = true\n        \n        return true\n    end\n    \n    return false\nend",
["check"] = "event",
["subeventPrefix"] = "SPELL",
["custom_hide"] = "timed",
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
},
},
