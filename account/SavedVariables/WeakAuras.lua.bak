["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["custom_type"] = "stateupdate",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        local composition = {\n            {count = 10, name = \"Ghouls\"},\n            {count = 5, name = \"Abominations\"},\n            {count = 2, name = \"Crypt Fiends\"},\n            {count = 4, name = \"Necromancers\"},\n        }\n        \n        return aura_env.updateState(allstates, \"winterchill\", 2, composition)\n    end\n    \n    if event == \"WA_FJI_HYJAL_WAVE\" then\n        local bossWave, status, waveCount, composition = ...\n        \n        if status == \"spawn\" or status == \"boss\" then\n            return aura_env.hideState(allstates)\n        end\n        \n        if status ~= \"next\" or not composition then\n            return false\n        end\n        \n        return aura_env.updateState(allstates, bossWave, waveCount, composition)\n    end\n    \n    if event == \"WA_FJI_HYJAL_WIPE\" then\n        return aura_env.hideState(allstates)\n    end\n    \n    return false\nend",
["events"] = "ENCOUNTER_START, WA_FJI_HYJAL_WAVE, WA_FJI_HYJAL_WIPE",
["spellIds"] = {
},
["names"] = {
},
["check"] = "event",
["subeventPrefix"] = "SPELL",
["debuffType"] = "HELPFUL",
["customVariables"] = "{\n    usable = \"bool\",\n    name = \"string\",\n}",
