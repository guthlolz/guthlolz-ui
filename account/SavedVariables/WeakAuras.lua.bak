["cooldownEdge"] = false,
["icon"] = true,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["customVariables"] = "{\n    value = true,\n}",
["event"] = "Health",
["unit"] = "player",
["subeventSuffix"] = "_CAST_START",
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates,event,_,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId)\n    \n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            value = math.random(1,24),\n            progressType = \"static\",\n        }\n        return true\n    end\n    \n    if event == \"PLAYER_REGEN_DISABLED\" then\n        if aura_env.timer then\n            aura_env.timer:Cancel()\n            aura_env.timer = nil\n        end\n        if UnitAffectingCombat(\"player\") then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                value = 0,\n                progressType = \"static\",\n            }\n            return true\n        end\n    elseif event == \"PLAYER_REGEN_ENABLED\" then\n        aura_env.timer = C_Timer.NewTimer(30, function()\n                WeakAuras.ScanEvents(\"WA_FOJJI_BOTED_HIDE\")\n        end)\n    elseif event == \"WA_FOJJI_BOTED_HIDE\" then\n        if allstates[\"\"] then\n            allstates[\"\"].show = false\n            allstates[\"\"].changed = true\n            return true\n        end\n    end\n    \n    if destGUID ~= WeakAuras.myGUID then\n        return false\n    end\n    \n    if spellId ~= aura_env.engulfingShadows then\n        return false\n    end\n    \n    if allstates[\"\"] then\n        allstates[\"\"].value = allstates[\"\"].value + 1\n        allstates[\"\"].changed = true\n        return true\n    end\nend\n\n\n",
["names"] = {
},
