["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["desaturateForeground"] = false,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, unit)\n    if event == \"OPTIONS\" then\n        if aura_env.ticker then\n            aura_env.ticker:Cancel()\n            aura_env.ticker = nil\n        end\n        \n        local rnd = math.random(8,25)\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            range = rnd,\n            isSafe = range and (range <= 7 or range >= 26) or false,\n        }\n        \n        aura_env.updateSafety(allstates)\n        return true\n    end\n    \n    if event == \"NAME_PLATE_UNIT_ADDED\" then\n        local guid = UnitGUID(unit)\n        local npcID = select(6, strsplit(\"-\", guid or \"\"))\n        \n        if npcID == \"21231\" then\n            if not aura_env.ticker then\n                aura_env.ticker = C_Timer.NewTicker(0.2, function()\n                        WeakAuras.ScanEvents(\"WA_SHIELDBEARER_RANGE_CHECK\")\n                end)\n            end\n            \n            local range = WeakAuras.GetRange(unit)\n            \n            allstates[unit] = {\n                show = true,\n                changed = true,\n                unit = unit,\n                range = range,\n                isSafe = range and (range <= 7 or range >= 26) or false,\n            }\n            \n            aura_env.updateSafety(allstates)\n            return true\n        end\n    end\n    \n    if event == \"NAME_PLATE_UNIT_REMOVED\" then\n        if allstates[unit] then\n            allstates[unit].show = false\n            allstates[unit].changed = true\n        end\n        \n        aura_env.checkTicker(allstates)\n        aura_env.updateSafety(allstates)\n        return true\n    end\n    \n    if event == \"WA_SHIELDBEARER_RANGE_CHECK\" then\n        for unit, state in pairs(allstates) do\n            if state.show and UnitExists(unit) then\n                local range = WeakAuras.GetRange(unit)\n                state.range = range\n                state.isSafe = range and (range <= 7 or range >= 26) or false\n                state.changed = true\n            end\n        end\n        \n        aura_env.updateSafety(allstates)\n        return true\n    end\nend",
["spellIds"] = {
},
["events"] = "NAME_PLATE_UNIT_ADDED NAME_PLATE_UNIT_REMOVED WA_SHIELDBEARER_RANGE_CHECK",
["check"] = "event",
["unit"] = "player",
["custom_hide"] = "timed",
["customVariables"] = "{\n    isSafe = \"bool\", \n    range = \"number\",\n}",
},
