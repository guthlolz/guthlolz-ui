["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["unit"] = "player",
["custom"] = "function(allstates, event)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\magtheridon.jpg\",\n            status = \"Free\",\n        }\n        return true\n    end\n    if event == \"WA_MAGTHERIDON_SHADOW_CAGE_APPLIED\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 2.5,\n            expirationTime = GetTime() + 2.5,\n            progressType = \"timed\",\n            icon = 136121,\n            autoHide = true,\n            status = \"Stunned\",\n        }\n        return true\n    elseif event == \"WA_MAGTHERIDON_SHADOW_CAGE_REMOVED\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 2.5,\n            expirationTime = GetTime() + 2.5,\n            progressType = \"timed\",\n            icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\magtheridon.jpg\",\n            autoHide = true,\n            status = \"Free\",\n        }\n        return true\n    end\nend",
["events"] = "WA_MAGTHERIDON_SHADOW_CAGE_APPLIED WA_MAGTHERIDON_SHADOW_CAGE_REMOVED",
["customVariables"] = "{\n    status = \"string\",\n}",
