["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
["custom"] = "DisableEvent(RaidBossEmoteFrame, \"RAID_BOSS_EMOTE\")\nDisableEvent(RaidBossEmoteFrame, \"RAID_BOSS_WHISPER\")\nDisableEvent(RaidBossEmoteFrame, \"CLEAR_BOSS_EMOTES\")\nprint(\"unregister\")",
["do_custom"] = false,
},
["finish"] = {
},
["init"] = {
["custom"] = "function aura_env.DisableEvent(frameName, eventName)\n    if frameName:IsEventRegistered(eventName) then\n        frameName:UnregisterEvent(eventName)\n    end\nend",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_hide"] = "timed",
["custom_type"] = "status",
["subeventSuffix"] = "_CAST_START",
["duration"] = "0.1",
["event"] = "Chat Message",
["subeventPrefix"] = "SPELL",
["custom"] = "function(e)\n    if e == \"ZONE_CHANGED_NEW_AREA\" then\n        if aura_env.config.option.disableEmoteEnable then\n            aura_env.DisableEvent(RaidBossEmoteFrame, \"RAID_BOSS_EMOTE\")\n            aura_env.DisableEvent(RaidBossEmoteFrame, \"RAID_BOSS_WHISPER\")\n            aura_env.DisableEvent(RaidBossEmoteFrame, \"CLEAR_BOSS_EMOTES\")\n            return true\n        end\n    end\nend",
