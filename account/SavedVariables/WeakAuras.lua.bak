["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates,event,eID,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId)\n    if spellId ~= aura_env.piercingArmor then\n        return false\n    end\n    \n    if subEvent == \"SPELL_AURA_APPLIED\" or subEvent == \"SPELL_AURA_REFRESH\" then\n        local npcID = select(6, strsplit(\"-\", destGUID))\n        \n        if npcID == \"21213\" then\n            WeakAuras.ScanEvents(\"WA_MOROGRIM_PIERCE_ARMOR_APPLIED\")\n        end\n        return true\n    end\nend",
