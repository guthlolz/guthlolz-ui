["init"] = {
["custom"] = "aura_env.whitelistSpells = {\n    -- AE\n    [1449] =    { duration = 0.9 },\n    [8437] =  { duration = 0.9 },\n    [8438] =  { duration = 0.9 },\n    [8439] = { duration = 0.9 },\n    [10201] = { duration = 0.9 },\n    [10202] = { duration = 0.9 },\n    [27080] = { duration = 0.9 },\n    [27082] = { duration = 0.9 },\n    -- Flamestrike\n    [2120] = { duration = 0.9 },\n    [2121] = { duration = 0.9 },\n    [8422] = { duration = 0.9 },\n    [8423] = { duration = 0.9 },\n    [10215] = { duration = 0.9 },\n    [10216] = { duration = 0.9 },\n    [27086] = { duration = 0.9 },\n    -- Blizzard\n    [42209] = { duration = 0.9 },\n    [42208] = { duration = 0.9 },\n    [42210] = { duration = 0.9 },\n    [42211] = { duration = 0.9 },\n    [42212] = { duration = 0.9 },\n    [42213] = { duration = 0.9 },\n    [42198] = { duration = 0.9 },\n}\n\naura_env.windowStart = nil",
["do_custom"] = true,
