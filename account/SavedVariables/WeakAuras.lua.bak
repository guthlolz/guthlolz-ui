["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "{\n    count = \"number\",\n    expirationTime = true,\n    tts = \"bool\",\n}",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
