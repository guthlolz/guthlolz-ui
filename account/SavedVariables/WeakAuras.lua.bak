["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["custom_type"] = "stateupdate",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(allstates,event,...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            autoHide = true,\n            icon = 132863,\n            name = \"+50% Dmg taken\",\n            count = math.random(1,5),\n        }\n        return true\n    end\n    \n    if event == \"WA_ARCHIMONDE_SOUL_CHARGE\" then\n        local charge = ...\n        local icon\n        local name\n        \n        if charge == \"Dot\" then\n            icon = 132871\n            name = \"Heavy DoT\"\n        elseif charge == \"Vulnerable\" then\n            icon = 132863\n            name = \"+50% Dmg taken\"\n        elseif charge == \"Silence\" then\n            icon = 132869\n            name = \"Silenced\"\n        end\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            autoHide = true,\n            icon = icon,\n            name = charge,\n        }\n        return true\n    end\nend",
