58, icon = 134830 }, -- Lesser Healing Potion\n    [4] = { id = 929, icon = 134831 }, -- Healing Potion\n    [5] = { id = 1710, icon = 134832 }, -- Greater Healing Potion\n    [6] = { id = 3928, icon = 134833 }, -- Superior Healing Potion\n    [7] = { id = 13446, icon = 134834 }, -- Major Healing Potion\n    [8] = { id = 2455, icon = 134850 }, -- Minor Mana Potion\n    [9] = { id = 3385, icon = 134851 }, -- Lesser Mana Potion\n    [10] = { id = 3827, icon = 134852 }, -- Mana Potion\n    [11] = { id = 6149, icon = 134853 }, -- Greater Mana Potion\n    [12] = { id = 13443, icon = 134854 }, -- Superior Mana Potion\n    [13] = { id = 13444, icon = 134856 }, -- Major Mana Potion\n    [14] = { id = 5631, icon = 134804 }, -- Rage Potion\n    [15] = { id = 5633, icon = 134801 }, -- Great Rage Potion\n    [16] = { id = 13442, icon = 134821 }, -- Mighty Rage Potion\n    [17] = { id = 5634, icon = 134715 }, -- Free Action Potion\n    [18] = { id = 3387, icon = 134842 }, -- Limited Invulnerability Potion\n    [19] = { id = 13455, icon = 134849 }, -- Greater Stoneshield Potion\n    [20] = { id = 4623, icon = 134847 }, -- Lesser Stoneshield Potion\n    [21] = { id = 22849, icon = 134758 },  -- Ironshield Potion\n    [22] = { id = 31677, icon = 134763 },  -- Fel Mana Potion\n    [23] = { id = 22838, icon = 134730 }, -- Haste Potion\n    [24] = { id = 22839, icon = 134729 },  -- Destruction Potion\n    [25] = { id = 22836, icon = 134764 }, -- Major Dreamless Sleep Potion\n    [26] = { id = 22837, icon = 134728 },  -- Heroic Potion\n    [27] = { id = 22832, icon = 134762 }, -- Super Mana Potion\n    [28] = { id = 32948, icon = 134762 }, -- Auchenai Mana Potion\n    [29] = { id = 32902, icon = 134783 },  -- Bottled Nethergon Energy\n    [30] = { id = 32905, icon = 134780 }, -- Bottled Nethergon Vapor\n    [31] = { id = 22829, icon = 134756 }, -- Super Healing Potion\n    [32] = { id = 22828, icon = 134731 }, -- Insane Strength Potion\n}\n\nfunction aura_env.getPotion(option)\n    if option == 1 then\n        return nil\n    else\n        return aura_env.dropdownMap[option]\n    end\nend",
