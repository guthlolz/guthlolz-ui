["triggers"] = {
{
["trigger"] = {
["customVariables"] = "{\n    expirationTime = true\n}",
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_type"] = "stateupdate",
["unit"] = "player",
["duration"] = "",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            icon = 135824,\n            count = math.random(1,3)\n        }\n        return true \n    end\n    \n    if event == \"WA_MAGTHERIDON_BLAST_NOVA_PREWARN\" then\n        local duration, count = ...\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = duration,\n            expirationTime = GetTime() + duration,\n            progressType = \"timed\",\n            icon = 135824,\n            count = count,\n        }\n        return true\n    elseif event == \"WA_NUMEN_TIMER\" then\n        local key, time = ...\n        if key == \"MAGTHERIDON_BLAST_NOVA\" and (time == 0 or time == nil) then\n            if allstates[\"\"] then\n                allstates[\"\"].show = false\n                allstates[\"\"].changed = true\n                return true\n            end\n        end\n    elseif event == \"WA_FJI_ENCOUNTER_END\" or event == \"WA_FJI_ENCOUNTER_START\" or event == \"WA_MAGTHERIDON_BLAST_NOVA_PREWARN_CANCEL\" then\n        if allstates[\"\"] then\n            allstates[\"\"].show = false\n            allstates[\"\"].changed = true\n            return true\n        end\n    end\nend",
["events"] = "WA_MAGTHERIDON_BLAST_NOVA_PREWARN, WA_MAGTHERIDON_BLAST_NOVA_PREWARN_CANCEL, WA_NUMEN_TIMER, WA_FJI_ENCOUNTER_END, WA_FJI_ENCOUNTER_START",
