["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.region.bar:SetVertexColor(1,1,1,1)\n\naura_env.spellKeys = {\n    [\"HYJAL_WAVE_WINTERCHILL\"] = {name = \"Next Wave\", icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\ragewinterchill.jpg\", useText = true},\n    [\"HYJAL_WAVE_ANETHERON\"] = {name = \"Next Wave\", icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\anetheron.jpg\", useText = true},\n    [\"HYJAL_WAVE_KAZROGAL\"] = {name = \"Next Wave\", icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\kazrogal.jpg\", useText = true},\n    [\"HYJAL_WAVE_AZGALOR\"] = {name = \"Next Wave\", icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\azgalor.jpg\", useText = true},\n}\n\nlocal function createKey(key,guid)\n    if guid then\n        return key .. \"_\" .. guid\n    end\n    return key\nend\n\nfunction aura_env.updateState(allstates,key,duration,count,name,icon,autoHide,text,guid)\n    local stateKey = createKey(key,guid)\n    \n    allstates[stateKey] = {\n        show = true,\n        changed = true,\n        duration = duration,\n        expirationTime = GetTime() + duration,\n        progressType = \"timed\",\n        count = count,\n        color = {1,1,1,1},\n        icon = icon,\n        name = name,\n        autoHide = autoHide,\n        text = text or \"\",\n        spellKey = key,\n        useText = text and text ~= \"\",\n    }\nend\n\nfunction aura_env.hideState(allstates,key,guid)\n    local stateKey = createKey(key,guid)\n    \n    if allstates[stateKey] then\n        allstates[stateKey].show = false\n        allstates[stateKey].changed = true\n        return true\n    end\nend",
["do_custom"] = true,
},
},
