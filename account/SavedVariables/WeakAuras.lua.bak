["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates,event,_,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId)\n    if subEvent == \"UNIT_DIED\" then\n        local npcID = select(6, strsplit(\"-\", destGUID))\n        if npcID == \"21216\" then\n            WeakAuras.ScanEvents(\"WA_FJI_ENCOUNTER_END\")\n            WeakAuras.ScanEvents(\"WA_HYDROSS_DIED\")\n            return true\n        elseif npcID == \"21217\" then\n            WeakAuras.ScanEvents(\"WA_FJI_ENCOUNTER_END\")\n            WeakAuras.ScanEvents(\"WA_LURKER_DIED\")\n            return true\n        elseif npcID == \"21213\" then\n            WeakAuras.ScanEvents(\"WA_FJI_ENCOUNTER_END\")\n            WeakAuras.ScanEvents(\"WA_MOROGRIM_DIED\")\n            return true\n        elseif npcID == \"21214\" then\n            WeakAuras.ScanEvents(\"WA_FJI_ENCOUNTER_END\")\n            WeakAuras.ScanEvents(\"WA_FATHOM_LORD_DIED\")\n            return true\n        elseif npcID == \"21215\" then\n            WeakAuras.ScanEvents(\"WA_FJI_ENCOUNTER_END\")\n            WeakAuras.ScanEvents(\"WA_LEOTHERAS_DIED\")\n            return true\n        elseif npcID == \"21212\" then\n            WeakAuras.ScanEvents(\"WA_FJI_ENCOUNTER_END\")\n            WeakAuras.ScanEvents(\"WA_VASHJ_DIED\")\n            return true\n        end\n    end\nend",
