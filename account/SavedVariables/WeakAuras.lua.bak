["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "CLEU:UNIT_DIED",
["spellIds"] = {
},
["custom"] = "function(allstates,event,_,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId)\n    if subEvent == \"UNIT_DIED\" then\n        local npcID = select(6, strsplit(\"-\", destGUID))\n        if npcID == \"22887\" then\n            WeakAuras.ScanEvents(\"WA_FJI_ENCOUNTER_END\")\n            WeakAuras.ScanEvents(\"WA_FJI_NAJENTUS_KILLED\")\n            return true\n        elseif npcID == \"22898\" then\n            WeakAuras.ScanEvents(\"WA_FJI_ENCOUNTER_END\")\n            WeakAuras.ScanEvents(\"WA_FJI_SUPREMUS_KILLED\")\n            return true\n        elseif npcID == \"22841\" or npcID == \"23191\" then\n            WeakAuras.ScanEvents(\"WA_FJI_ENCOUNTER_END\")\n            WeakAuras.ScanEvents(\"WA_FJI_AKAMA_KILLED\")\n            return true\n        elseif npcID == \"22871\" then\n            WeakAuras.ScanEvents(\"WA_FJI_ENCOUNTER_END\")\n            WeakAuras.ScanEvents(\"WA_FJI_TERON_KILLED\")\n            return true\n        elseif npcID == \"22948\" then\n            WeakAuras.ScanEvents(\"WA_FJI_ENCOUNTER_END\")\n            WeakAuras.ScanEvents(\"WA_FJI_BLOODBOIL_KILLED\")\n            return true\n        elseif npcID == \"23420\" then\n            WeakAuras.ScanEvents(\"WA_FJI_ENCOUNTER_END\")\n            WeakAuras.ScanEvents(\"WA_FJI_RELIQUARY_KILLED\")\n            return true\n        elseif npcID == \"22947\" then\n            WeakAuras.ScanEvents(\"WA_FJI_ENCOUNTER_END\")\n            WeakAuras.ScanEvents(\"WA_FJI_MOTHER_KILLED\")\n            return true\n        elseif npcID == \"22949\" then\n            WeakAuras.ScanEvents(\"WA_FJI_ENCOUNTER_END\")\n            WeakAuras.ScanEvents(\"WA_FJI_COUNCIL_KILLED\")\n            return true\n        elseif npcID == \"22917\" then\n            WeakAuras.ScanEvents(\"WA_FJI_ENCOUNTER_END\")\n            WeakAuras.ScanEvents(\"WA_FJI_ILLIDAN_KILLED\")\n            return true\n        end\n    end\nend",
["check"] = "event",
