["actions"] = {
["start"] = {
["glow_lines"] = 16,
["glow_thickness"] = 2,
["glow_XOffset"] = -1,
["glow_scale"] = 1.25,
["do_glow"] = true,
["glow_frequency"] = 0.05,
["glow_YOffset"] = -1,
