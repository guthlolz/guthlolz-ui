1,
},
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["shadowYOffset"] = -1,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiT4RaidPack/3",
["actions"] = {
["start"] = {
},
["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.key = \"MAULGAR_WHIRLWIND\"\naura_env.count = 1\naura_env.cdStart = 58\naura_env.cdWindow = 55\naura_env.whirlwind = 33238\naura_env.safeRange = 4\naura_env.NPC_ID = \"18832\"\n\nlocal function getNpcID(unit)\n    local guid = UnitGUID(unit)\n    return select(6, strsplit(\"-\", guid))\nend\n\nfunction aura_env.getRange(guid)\n    if UnitExists(\"target\") and UnitGUID(\"target\") == guid then\n        local range = WeakAuras.GetRange(\"target\")\n        return \"target\", range\n    end\n    for i = 1, 40 do\n        local unit = \"nameplate\" .. i\n        if UnitExists(unit) and UnitGUID(unit) == guid then\n            local range = WeakAuras.GetRange(unit)\n            return unit, range\n        end\n    end\n    return nil, nil\nend\n\nfunction aura_env.startTicker(guid)\n    if aura_env.ticker then\n        aura_env.ticker:Cancel()\n        aura_env.ticker = nil\n    end\n    local interval = 0.1\n    local iterations = 150\n    \n    aura_env.ticker = C_Timer.NewTicker(interval, function()\n            local unit, range = aura_env.getRange(guid)\n            local safe = (range ~= nil) and (range >= aura_env.safeRange) or false\n            \n            WeakAuras.ScanEvents(\"WA_MAULGAR_RANGE_CHECK\", guid, safe, range)\n    end, iterations)\nend\n\nfunction aura_env.nuTimer(countdown, count)\n    WeakAuras.ScanEvents(\"WA_NUMEN_TIMER\", aura_env.key, countdown, count)\nend\n\nfunction aura_env.updateState(allstates)\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n    }\nend\n\nfunction aura_env.hideState(allstates)\n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\nend\n\nfunction aura_env.preWarn(duration, preWarnTime, count)\n    if not preWarnTime then\n        preWarnTime = 3\n    end\n    \n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\n    aura_env.preWarnTimer = C_Timer.NewTimer(duration - preWarnTime, function()\n            WeakAuras.ScanEvents(\"WA_\" .. aura_env.key ..\"_PREWARN\", preWarnTime, count)\n            aura_env.preWarnTimer = nil\n    end)\nend\n\nfunction aura_env.preWarnCancel()\n    WeakAuras.ScanEvents(\"WA_\" .. aura_env.key .. \"_PREWARN_CANCEL\")\n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\nend",
},
["finish"] = {
["custom"] = "aura_env.count = 1\naura_env.nuTimer(nil)\naura_env.preWarnCancel()",
["do_sound"] = false,
["do_message"] = false,
["do_custom"] = true,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
