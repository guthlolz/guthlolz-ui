["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, key, time, count)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 2.5,\n            expirationTime = GetTime() + 2.5,\n            progressType = \"timed\",\n            icon = 136171,\n            autoHide = true,\n        }\n        return true\n    end\n    if event == \"WA_NUMEN_TIMER\" and key == \"LEOTHERAS_INNER_DEMON\" then\n        if time == 0 then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = 2.5,\n                expirationTime = GetTime() + 2.5,\n                progressType = \"timed\",\n                icon = 136171,\n                autoHide = true,\n            }\n        elseif time == nil then\n            if allstates[\"\"] then\n                allstates[\"\"].show = false\n                allstates[\"\"].changed = true\n            end\n        end\n        return true\n    end\nend",
["spellIds"] = {
},
["events"] = "WA_NUMEN_TIMER",
["check"] = "event",
["unit"] = "player",
["custom_hide"] = "timed",
["customVariables"] = "",
},
["untrigger"] = {
