["desaturateForeground"] = false,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "{\n    isSafe = \"bool\", \n    range = \"number\",\n}",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "NAME_PLATE_UNIT_ADDED NAME_PLATE_UNIT_REMOVED WA_SOUL_RANGE_CHECK WA_RELIQUARY_P2_START WA_RELIQUARY_P3_START",
["spellIds"] = {
},
["custom"] = "function(allstates,event,unit)\n    if event == \"OPTIONS\" then\n        aura_env.stopTicker()\n        \n        local rnd = math.random(1,35)\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            range = rnd,\n            isSafe = aura_env.isSafeRange(rnd),\n            icon = 132337\n        }\n        return true\n    end\n    \n    if event == \"WA_RELIQUARY_P2_START\" or event == \"WA_RELIQUARY_P3_START\" then\n        aura_env.stopTicker()\n        return false\n    end\n    \n    if event == \"NAME_PLATE_UNIT_ADDED\" then\n        if not aura_env.isTrackedUnit(unit) then\n            return false\n        end\n        \n        local range = WeakAuras.GetRange(unit)\n        \n        allstates[unit] = {\n            show = true,\n            changed = true,\n            unit = unit,\n            range = range,\n            isSafe = aura_env.isSafeRange(range),\n            icon = 132337\n        }\n        \n        aura_env.checkTicker(allstates)\n        return true\n    end\n    \n    if event == \"NAME_PLATE_UNIT_REMOVED\" then\n        if allstates[unit] then\n            allstates[unit].show = false\n            allstates[unit].changed = true\n        end\n        \n        aura_env.checkTicker(allstates)\n        return true\n    end\n    \n    if event == aura_env.events.rangeCheck then\n        for unit,state in pairs(allstates) do\n            if unit ~= \"\" and state.show then\n                if UnitExists(unit) and aura_env.isTrackedUnit(unit) then\n                    local range = WeakAuras.GetRange(unit)\n                    state.range = range\n                    state.isSafe = aura_env.isSafeRange(range)\n                    state.changed = true\n                else\n                    state.show = false\n                    state.changed = true\n                end\n            end\n        end\n        \n        aura_env.checkTicker(allstates)\n        return true\n    end\nend",
