["H:[BT][Reliquary] Personal Kick Dispatcher"] = {
["displayText_format_guid_format"] = "guid",
["displayText_format_guid_pad_max"] = 8,
["authorOptions"] = {
{
["type"] = "space",
["variableWidth"] = false,
["height"] = 1,
["width"] = 1,
["useHeight"] = false,
},
{
["fontSize"] = "large",
["text"] = "|TInterface\\AddOns\\FojjiCore\\textures\\TBC Icon\\illidan.jpg:14:14|t Fojji - Black Temple Raiding Pack [Customization] |TInterface\\AddOns\\FojjiCore\\textures\\TBC Icon\\illidan.jpg:14:14|t",
["type"] = "description",
["width"] = 2,
},
{
["type"] = "space",
["variableWidth"] = false,
["height"] = 1,
["width"] = 1,
["useHeight"] = false,
},
{
["fontSize"] = "medium",
["text"] = "When making changes, make sure you have the master group \"Fojji - [T6] Black Temple [Part 1]\" selected.",
["type"] = "description",
["width"] = 2,
},
{
["type"] = "space",
["variableWidth"] = false,
["height"] = 1,
["width"] = 1,
["useHeight"] = false,
},
{
["type"] = "header",
["text"] = "",
["useName"] = false,
["width"] = 1,
},
{
["subOptions"] = {
{
["type"] = "space",
["variableWidth"] = true,
["height"] = 1,
["width"] = 2,
["useHeight"] = false,
},
{
["fontSize"] = "large",
["text"] = "THIS AURA DOES NOTHING IF YOU RECEIVE RAID LEADER ASSIGNMENTS.",
["type"] = "description",
["width"] = 2,
},
{
["type"] = "header",
["text"] = "",
["useName"] = false,
["width"] = 1,
},
{
["fontSize"] = "medium",
["text"] = "Fallback Reliquary interrupt assignment for PUGs or raids without assignments.\n\nSelect your Kick Position and Rotation Length below. The aura will automatically tell you when your interrupt is coming next and when it is your turn to interrupt.\n\nIf the Raid Leader sends Reliquary interrupt assignments in Raid Chat at the start of the pull, these settings are automatically ignored.",
["type"] = "description",
["width"] = 2,
},
{
["type"] = "header",
["text"] = "",
["useName"] = false,
["width"] = 1,
},
{
["type"] = "toggle",
["key"] = "enable",
["useDesc"] = false,
["default"] = false,
["name"] = "Enable Personal Kick Warnings",
["width"] = 1,
},
{
["type"] = "space",
["variableWidth"] = true,
["height"] = 1,
["width"] = 1,
["useHeight"] = false,
},
{
["desc"] = "Which kick you are assigned in the rotation.",
["type"] = "select",
["values"] = {
"Kick 1",
"Kick 2",
"Kick 3",
},
["name"] = "Kick Cast #1",
["useDesc"] = true,
["default"] = 1,
["key"] = "kick",
["width"] = 0.6,
},
{
["desc"] = "Set to the amount of kicks in your rotation",
["type"] = "select",
["values"] = {
"1",
"2",
"3",
"4",
"5",
},
["name"] = "Rotation Length",
["useDesc"] = true,
["default"] = 3,
["key"] = "rotation",
["width"] = 0.6,
},
{
["type"] = "space",
["variableWidth"] = false,
["height"] = 1,
["width"] = 1,
["useHeight"] = false,
},
},
["hideReorder"] = true,
["useDesc"] = false,
["nameSource"] = 0,
["key"] = "option",
["width"] = 1,
["useCollapse"] = true,
["noMerge"] = false,
["collapse"] = true,
["name"] = "|TInterface\\AddOns\\FojjiCore\\textures\\TBC Icon\\reliquary.jpg:14:14|t Reliquary Personal Kick",
["limitType"] = "none",
["groupType"] = "simple",
["type"] = "group",
