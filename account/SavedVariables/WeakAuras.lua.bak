["uid"] = "X7x3zyuShxB",
["sparkHidden"] = "NEVER",
["displayText_format_t_time_dynamic_threshold"] = 60,
["justify"] = "CENTER",
["displayIcon"] = "134153",
["displayText_format_p_time_dynamic_threshold"] = 60,
["backgroundOffset"] = 2,
