["sparkWidth"] = 10,
["customTextUpdate"] = "event",
["cooldownEdge"] = false,
["desaturateForeground"] = false,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["custom_hide"] = "timed",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["unit"] = "group",
["custom"] = "function(allstates,event,eID,subEvent,_,sourceGUID,sourceName,_,_,destGUID,destName,_,_,spellId,_,_,amount)\n    if event == \"OPTIONS\" then\n        for i = 1, 8 do\n            allstates[i] = {\n                show = true,\n                changed = true,\n                name = WeakAuras.me,\n                value = math.random(1, 10000),\n                total = 10000,\n                progressType = \"static\",\n                player = true,\n                index = i + 1,\n            }\n        end\n        \n        allstates[\"total\"] = {\n            show = true,\n            changed = true,\n            name = \"Total\",\n            value = math.random(10, 10000),\n            total = 10000,\n            progressType = \"static\",\n            player = false,\n            index = 1,\n        }\n        aura_env.sortStates(allstates)\n        return true\n    end\n    \n    if event == \"ENCOUNTER_END\" or event == \"WA_FJI_ENCOUNTER_END\" then\n        local isLeader = (UnitIsGroupLeader(\"player\") and IsInRaid())\n        if isLeader then\n            local now = GetTime()\n            if now - (aura_env.throttle or 0) > 2 then\n                aura_env.throttle = now\n                aura_env.ffSummary()\n            end\n        end\n        \n        aura_env.friendlyFireScore = {}\n        for _, state in pairs(allstates) do\n            state.show = false\n            state.changed = true\n        end\n        \n        return true\n    end\n    \n    if event == \"ENCOUNTER_START\" or event == \"WA_FJI_ENCOUNTER_START\" then\n        if eID ~= 650 then\n            return false\n        end\n        \n        aura_env.friendlyFireScore = {}\n        \n        allstates[\"total\"] = {\n            show = true,\n            changed = true,\n            name = \"Total\",\n            value = 0,\n            total = 10000,\n            progressType = \"static\",\n            player = false,\n            index = 1,\n        }\n        \n        return true\n    end\n    \n    if subEvent ~= \"SPELL_DAMAGE\" then\n        return false\n    end\n    \n    if not aura_env.spellIDs[spellId] then\n        return false\n    end\n    \n    aura_env.friendlyFireScore[sourceName] =\n    (aura_env.friendlyFireScore[sourceName] or 0) + amount\n    \n    aura_env.updateState(allstates, sourceName)\n    \n    return true\nend",
["events"] = "ENCOUNTER_END, WA_FJI_ENCOUNTER_END, CLEU:SPELL_DAMAGE, WA_FJI_ENCOUNTER_START ENCOUNTER_START",
["customVariables"] = "{\n    player = \"bool\",\n    index = \"number\",\n}",
