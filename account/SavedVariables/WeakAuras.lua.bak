["id"] = "T:[T5][SSC][Trash] Colossus Lurker",
["displayText_format_guid_abbreviate"] = false,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["semver"] = "2.0.0",
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, unit)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            icon = 136129,\n            count = math.random(1,5),\n        }\n    end\n    if event == \"NAME_PLATE_UNIT_ADDED\" then\n        local guid = UnitGUID(unit)\n        local npcID = select(6, strsplit(\"-\", guid))\n        \n        if npcID ~= \"22347\" then\n            return false\n        end\n        \n        if GetTime() - aura_env.throttle < 60 then\n            return false\n        end\n        aura_env.throttle = GetTime()\n        \n        if not aura_env.seen[guid] then\n            aura_env.seen[guid] = true\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = 2,\n                expirationTime = GetTime() + 2,\n                progressType = \"timed\",\n                icon = 136129,\n                autoHide = true,\n            }\n            return true\n        end\n    end\nend",
["spellIds"] = {
},
["events"] = "NAME_PLATE_UNIT_ADDED",
["check"] = "event",
["unit"] = "player",
["custom_hide"] = "timed",
["customVariables"] = "",
},
["untrigger"] = {
},
},
["disjunctive"] = "any",
["activeTriggerMode"] = -10,
},
["displayText_format_p_format"] = "timed",
["displayText_format_p_time_legacy_floor"] = false,
["selfPoint"] = "BOTTOM",
["animation"] = {
["start"] = {
["colorR"] = 0.97254908084869,
["duration"] = "0.3",
["duration_type"] = "seconds",
["colorA"] = 1,
["alphaType"] = "straight",
["colorB"] = 1,
["colorG"] = 0,
["alphaFunc"] = "function(progress, start, delta)\n    return start + (progress * delta)\nend\n",
["easeStrength"] = 5,
["translateType"] = "bounce",
["use_translate"] = true,
["use_alpha"] = false,
["scaleType"] = "pulse",
["type"] = "custom",
["preset"] = "bounceDecay",
["easeType"] = "none",
["translateFunc"] = "function(progress, startX, startY, deltaX, deltaY)\n    local bounceDistance = math.sin(progress * math.pi)\n    return startX + (bounceDistance * deltaX), startY + (bounceDistance * deltaY)\nend\n",
["scaley"] = 1.3,
["alpha"] = 1,
["x"] = 0,
["y"] = -1,
["colorType"] = "pulseColor",
["use_color"] = false,
["scaleFunc"] = "function(progress, startX, startY, scaleX, scaleY)\n    local angle = (progress * 2 * math.pi) - (math.pi / 2)\n    return startX + (((math.sin(angle) + 1)/2) * (scaleX - 1)), startY + (((math.sin(angle) + 1)/2) * (scaleY - 1))\nend\n",
["colorFunc"] = "function(progress, r1, g1, b1, a1, r2, g2, b2, a2)\n    local angle = (progress * 2 * math.pi) - (math.pi / 2)\n    local newProgress = ((math.sin(angle) + 1)/2);\n    return r1 + (newProgress * (r2 - r1)),\n         g1 + (newProgress * (g2 - g1)),\n         b1 + (newProgress * (b2 - b1)),\n         a1 + (newProgress * (a2 - a1))\nend\n",
["rotate"] = 0,
["use_scale"] = true,
["scalex"] = 1.3,
},
["main"] = {
["colorR"] = 1,
["scalex"] = 1,
["colorB"] = 0.52941179275513,
["colorG"] = 0.55686277151108,
["type"] = "none",
["easeType"] = "none",
["colorA"] = 1,
["use_color"] = false,
["alpha"] = 0,
["scaley"] = 1,
["y"] = 0,
["x"] = 0,
["rotate"] = 0,
["duration"] = "1",
["colorFunc"] = "function(progress, r1, g1, b1, a1, r2, g2, b2, a2)\n    local angle = (progress * 2 * math.pi) - (math.pi / 2)\n    local newProgress = ((math.sin(angle) + 1)/2);\n    return r1 + (newProgress * (r2 - r1)),\n         g1 + (newProgress * (g2 - g1)),\n         b1 + (newProgress * (b2 - b1)),\n         a1 + (newProgress * (a2 - a1))\nend\n",
["easeStrength"] = 3,
