["init"] = {
["custom"] = "aura_env.castTime = 1.7\n\nlocal class = UnitClassBase(\"player\")\n\nif class == \"HUNTER\" then\n    aura_env.icon = GetSpellTexture(5384)\nelseif class == \"ROGUE\" then\n    aura_env.icon = GetSpellTexture(1856)\nelse\n    aura_env.icon = 135752\nend",
