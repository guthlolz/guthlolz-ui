["spellIds"] = {
},
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            icon = aura_env.icon,\n            name = aura_env.name,\n        }\n        return true \n    end\n    \n    if event == \"WA_\" .. aura_env.e .. \"_PREWARN\" then\n        local duration, count = ...\n        aura_env.scheduleFallback(duration + aura_env.fallbackTime)\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = duration,\n            expirationTime = GetTime() + duration,\n            progressType = \"timed\",\n            icon = aura_env.icon,\n            name = aura_env.name,\n        }\n        return true\n    elseif event == \"WA_NUMEN_TIMER\" then\n        local key, time = ...\n        if key == aura_env.e and (time == 0 or time == nil) then\n            aura_env.cancelFallback()\n            if allstates[\"\"] then\n                allstates[\"\"].show = false\n                allstates[\"\"].changed = true\n                return true\n            end\n        end\n    elseif event == \"WA_\" .. aura_env.e .. \"_PREWARN_CANCEL\" or event == \"WA_\" .. aura_env.e .. \"_PREWARN_FALLBACK\" or event == \"WA_FJI_ENCOUNTER_END\" or event == \"WA_FJI_ENCOUNTER_START\" then\n        aura_env.cancelFallback()\n        if allstates[\"\"] then\n            allstates[\"\"].show = false\n            allstates[\"\"].changed = true\n            return true\n        end\n    end\nend",
["events"] = "WA_ARCHIMONDE_FEAR_PREWARN, WA_ARCHIMONDE_FEAR_PREWARN_CANCEL, WA_ARCHIMONDE_FEAR_PREWARN_FALLBACK, WA_NUMEN_TIMER, WA_FJI_ENCOUNTER_END, WA_FJI_ENCOUNTER_START",
["customIcon"] = "function()\n    return 135789\nend",
["check"] = "event",
["custom_type"] = "stateupdate",
