["events"] = "WA_SOLARIAN_MISSILES_TARGET",
["custom"] = "function(allstates, event, _, guid, name, endTime)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 3,\n            expirationTime = GetTime() + 3,\n            autoHide = true,\n            unit = \"player\",\n        }\n        return true\n    end\n    \n    if event == \"WA_SOLARIAN_MISSILES_TARGET\" then\n        if not name or not endTime then\n            return false\n        end\n        \n        local expiration = endTime / 1000\n        local duration = expiration - GetTime()\n        \n        if duration <= 0 then\n            return false\n        end\n        \n        allstates[name] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = duration,\n            expirationTime = expiration,\n            autoHide = true,\n            unit = name,\n        }\n        return true\n    end\nend",
