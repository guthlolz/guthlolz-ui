["auraspellids"] = {
},
["match_countOperator"] = ">",
["custom_type"] = "stateupdate",
["custom"] = "function(a, e, guid)\n    if e == \"OPTIONS\" then\n        a[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 3,\n            expirationTime = GetTime() + 3,\n            autoHide = true,\n            icon = 132215,\n            guid = WeakAuras.myGUID,\n            isPlayer = true,\n        }\n        return true\n    end\n    \n    if not _G.FJI_TANK and not _G.FJI_HEALER and not UnitIsGroupLeader(\"player\") then\n        return false\n    end\n    \n    if e == \"WA_GRUUL_HURTFUL_TARGET\" then\n        a[guid] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            autoHide = true,\n            icon = 132215,\n            guid = guid,\n            isPlayer = guid == WeakAuras.myGUID,\n            type = \"Hit\",\n        }\n        return true\n    elseif e == \"WA_GRUUL_HURTFUL_TARGET_MISS\" then\n        a[guid] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            autoHide = true,\n            icon = 132215,\n            guid = guid,\n            isPlayer = guid == WeakAuras.myGUID,\n            type = \"Miss\",\n        }\n        return true\n    end\nend",
["subeventPrefix"] = "SPELL",
["group_count"] = "0",
