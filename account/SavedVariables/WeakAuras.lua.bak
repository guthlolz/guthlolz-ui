["colorFunc"] = "function(progress, r, g, b, a)\n    local r, g, b, a\n    if aura_env.config.colorOverride and aura_env.config.color then\n        r = aura_env.config.color[1]\n        g = aura_env.config.color[2]\n        b = aura_env.config.color[3]\n        a = aura_env.config.color[4] or 1\n    else\n        local color = aura_env.state and aura_env.state.color\n        r = color[1]\n        g = color[2]\n        b = color[3]\n        a = color[4] or 1\n    end\n    return r, g, b, a\nend",
