["custom"] = "function aura_env.checkTicker(allstates)\n    local active = false\n    for unit, state in pairs(allstates) do\n        if state.show then\n            active = true\n            break\n        end\n    end\n    \n    if not active and aura_env.ticker then\n        aura_env.ticker:Cancel()\n        aura_env.ticker = nil\n    end\nend",
