["url"] = "https://wago.io/FojjiBT-P1/12",
["actions"] = {
["start"] = {
["do_custom"] = false,
["sound"] = "Interface\\Addons\\FojjiCore\\sound\\MarioLevelComplete.ogg",
["custom"] = "ShakeFrameRandom(aura_env.region.bar.spark, 3, aura_env.state.duration, 0.1)",
["do_sound"] = true,
},
["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.throttle = 0\n\nlocal r = aura_env.region\nlocal b = r.bar\nb:SetTexture([[Interface\\AddOns\\WeakAuras\\Media\\Textures\\rainbowbar]])\n\nif not b.modelFrame then\n    local modelFrame = CreateFrame(\"FRAME\", nil, b)\n    b.modelFrame = modelFrame\n    local sparkle = CreateFrame(\"PlayerModel\", nil, b.modelFrame)\n    b.modelFrame.sparkle = sparkle\n    b.modelFrame.sparkle:SetKeepModelOnHide(true)\n    b.nyanframe = CreateFrame(\"FRAME\", nil, b)\n    local nyanspark = b.nyanframe:CreateTexture(nil, \"OVERLAY\")\n    b.nyanframe.nyanspark = nyanspark\nend\n\nb.modelFrame.sparkle:SetModel(646785)\nb.modelFrame.sparkle:ClearTransform()\nb.modelFrame.sparkle:SetPosition(-1,1.5,0,0)\nlocal h = b:GetHeight()\nb.modelFrame.sparkle:SetPoint(\"RIGHT\", b.modelFrame)\nb.modelFrame.sparkle:SetSize(150,h)\nb.modelFrame.sparkle:SetAlpha(1)\nhooksecurefunc(b.spark, \"Show\", function()\n        b.modelFrame.sparkle:Show()\n    end\n)\nhooksecurefunc(b.spark, \"Hide\", function()\n        b.modelFrame.sparkle:Hide()\n    end\n)\nb.modelFrame:ClearAllPoints()\nb.modelFrame:SetAllPoints(b.fgMask)\nb.modelFrame:SetClipsChildren(true)\nb.modelFrame:Show()\n\nb.nyanframe:SetFrameLevel(b.modelFrame.sparkle:GetFrameLevel()+1)\nb.nyanframe.nyanspark:SetTexture([[Interface\\Icons\\INV_Weapon_Glave_01]])\nb.nyanframe.nyanspark:SetTexCoord(0.07, 0.95, 0.07, 0.95)\nb.nyanframe.nyanspark:SetPoint(\"CENTER\", b.spark)\nb.nyanframe.nyanspark:SetSize(55,55)\nb.nyanframe.nyanspark:Show()",
},
