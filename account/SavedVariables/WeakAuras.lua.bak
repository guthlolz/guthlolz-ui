["custom"] = "function()\n    if UnitIsGroupLeader(\"player\") then\n        return true\n    end\n    \n    if _G.FJI_TANK and UnitClassBase(\"player\") ~= \"PALADIN\" then\n        return true\n    end\n    \n    if _G.FJI_MELEE or _G.FJI_RANGED then\n        return true\n    end\nend",
