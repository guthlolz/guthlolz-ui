["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.encounterActive = false\naura_env.encounterID = 608\naura_env.priestNPCID = \"22951\"\n\naura_env.physicalPlayers = {}\naura_env.magicalPlayers = {}\naura_env.assignedPlayers = {}\naura_env.petOwners = {}\naura_env.cooldowns = {}\n\naura_env.preferredType = nil\naura_env.currentType = nil\naura_env.bopActive = false\naura_env.wardingActive = false\n\naura_env.bopSpellID = 41540\naura_env.wardingSpellID = 41451\n\naura_env.interruptCDs = {\n    -- Rogue: Kick\n    [1766] = 10,\n    [1767] = 10,\n    [1768] = 10,\n    [1769] = 10,\n    [38768] = 10,\n    \n    -- Warrior: Pummel\n    [6552] = 10,\n    [6554] = 10,\n    \n    -- Warrior: Shield Bash\n    [72] = 12,\n    [1671] = 12,\n    [1672] = 12,\n    [29704] = 12,\n    \n    -- Mage: Counterspell\n    [2139] = 24,\n    \n    -- Shaman: Earth Shock\n    [8042] = 6,\n    [8044] = 6,\n    [8045] = 6,\n    [8046] = 6,\n    [10412] = 6,\n    [10413] = 6,\n    [10414] = 6,\n    [25454] = 6,\n    \n    -- Druid: Feral Charge\n    [16979] = 15,\n    \n    -- Warlock Felhunter: Spell Lock\n    [19244] = 24,\n    [19647] = 24,\n}\n\nfunction aura_env.GetNPCID(guid)\n    if not guid then\n        return\n    end\n    return select(6,strsplit(\"-\",guid))\nend\n\nfunction aura_env.UpdatePetOwners()\n    wipe(aura_env.petOwners)\n    \n    for i = 1,40 do\n        local ownerUnit = \"raid\" .. i\n        local petUnit = \"raidpet\" .. i\n        local ownerName = UnitName(ownerUnit)\n        local petGUID = UnitGUID(petUnit)\n        \n        if ownerName and petGUID then\n            aura_env.petOwners[petGUID] = ownerName\n        end\n    end\nend\n\nfunction aura_env.RebuildAssignedPlayers()\n    wipe(aura_env.assignedPlayers)\n    \n    for _,name in ipairs(aura_env.physicalPlayers) do\n        aura_env.assignedPlayers[name] = true\n    end\n    \n    for _,name in ipairs(aura_env.magicalPlayers) do\n        aura_env.assignedPlayers[name] = true\n    end\nend\n\nfunction aura_env.HideStates(states)\n    for _,state in pairs(states) do\n        state.show = false\n        state.changed = true\n    end\nend\n\nfunction aura_env.ShowType(states,assignmentType)\n    aura_env.HideStates(states)\n    aura_env.currentType = assignmentType\n    \n    local players = assignmentType == \"PHYSICAL\" and aura_env.physicalPlayers or aura_env.magicalPlayers\n    local now = GetTime()\n    \n    for index,name in ipairs(players) do\n        local cooldown = aura_env.cooldowns[name]\n        \n        if cooldown and cooldown.expirationTime > now then\n            states[name] = {\n                show = true,\n                changed = true,\n                name = name,\n                index = index,\n                progressType = \"timed\",\n                duration = cooldown.duration,\n                expirationTime = cooldown.expirationTime,\n                autoHide = false,\n            }\n        else\n            states[name] = {\n                show = true,\n                changed = true,\n                name = name,\n                index = index,\n                progressType = \"static\",\n                value = 1,\n                total = 1,\n            }\n        end\n    end\nend\n\nfunction aura_env.UpdateDisplay(states)\n    local assignmentType\n    \n    if aura_env.bopActive then\n        assignmentType = \"MAGICAL\"\n    elseif aura_env.wardingActive then\n        assignmentType = \"PHYSICAL\"\n    else\n        assignmentType = aura_env.preferredType\n    end\n    \n    if assignmentType then\n        aura_env.ShowType(states,assignmentType)\n    else\n        aura_env.HideStates(states)\n        aura_env.currentType = nil\n    end\nend\n\nfunction aura_env.ParsePlayers(playerText,list)\n    wipe(list)\n    \n    if not playerText or playerText == \"\" then\n        return\n    end\n    \n    for _,name in ipairs({ strsplit(\",\",playerText) }) do\n        name = strtrim(name)\n        \n        if name ~= \"\" then\n            tinsert(list,name)\n        end\n    end\n    \n    aura_env.RebuildAssignedPlayers()\nend\n\nfunction aura_env.Reset(states)\n    aura_env.encounterActive = false\n    aura_env.bopActive = false\n    aura_env.wardingActive = false\n    wipe(aura_env.cooldowns)\n    wipe(aura_env.petOwners)\n    aura_env.HideStates(states)\nend",
},
