},
["height"] = 15,
["textureSource"] = "LSM",
["displayText_format_1.destGuid_color"] = "class",
["sparkBlendMode"] = "BLEND",
["useAdjustededMax"] = false,
["fontSize"] = 14,
["source"] = "import",
["displayText_format_p_time_mod_rate"] = true,
["displayText_format_p_time_precision"] = 1,
["selfPoint"] = "BOTTOM",
["displayText_format_1.destGuid_abbreviate"] = false,
["displayText_format_1.guid_format"] = "guid",
["displayText_format_3.myTargetIndex_format"] = "none",
["displayText_format_1.myTargetIndex_format"] = "none",
["displayText_format_1.guid_abbreviate"] = false,
["icon_side"] = "LEFT",
["backgroundColor"] = {
0,
0,
0,
0,
},
["displayText_format_1.sourceGuid_realm_name"] = "never",
["sparkHeight"] = 15,
["actions"] = {
["start"] = {
["do_custom"] = false,
["custom"] = "",
},
["init"] = {
["customOnLoad"] = "print(\"|cff00ff00Fojji|r|cff00ccffCUBE|r: type !cube in Raid Chat to send the Teams to the Raid before the pull.\")",
["do_custom_load"] = true,
["custom"] = "aura_env.team1 = {}\naura_env.team2 = {}\naura_env.team3 = {}\naura_env.team4 = {}\naura_env.marks = {}\n\nlocal function Capitalize(name)\n    if not name or name == \"\" then\n        return name\n    end\n    local first = name:match(\"^[%z\\1-\\127\\194-\\244][\\128-\\191]*\")\n    if not first then\n        return name\n    end\n    local rest = name:sub(#first + 1)\n    return first:upper() .. rest:lower()\nend\n\nlocal function SendRaidChat(msg)\n    if type(msg) ~= \"string\" then\n        return\n    end\n    SendChatMessage(msg, \"RAID\")\nend\n\nlocal function ParseCubeTeams(rawText, nameToGuid)\n    wipe(aura_env.team1)\n    wipe(aura_env.team2)\n    wipe(aura_env.team3)\n    wipe(aura_env.team4)\n    \n    if not rawText or rawText == \"\" then\n        return\n    end\n    \n    local text = rawText:gsub(\"[%s\\r\\n\\t]+\", \"\")\n    local currentList = nil\n    local missing = {}\n    local seen = {}\n    local duplicateNames = {}\n    local taken = {}\n    \n    for _, entry in ipairs({ strsplit(\",\", text) }) do\n        entry = strtrim(entry)\n        if entry ~= \"\" then\n            local teamNum, rawName = entry:match(\"^([1-4])%-(.+)$\")\n            if teamNum and rawName then\n                local name = Capitalize(strtrim(rawName))\n                currentList = aura_env[\"team\" .. teamNum]\n                local guid = nameToGuid[name]\n                if guid then\n                    seen[guid] = (seen[guid] or 0) + 1\n                    if seen[guid] == 2 then\n                        duplicateNames[guid] = name\n                    end\n                    \n                    if not taken[guid] then\n                        taken[guid] = true\n                        tinsert(currentList, guid)\n                    end\n                else\n                    tinsert(missing, name)\n                end\n            else\n                if currentList then\n                    local name = Capitalize(entry)\n                    local guid = nameToGuid[name]\n                    if guid then\n                        seen[guid] = (seen[guid] or 0) + 1\n                        if seen[guid] == 2 then\n                            duplicateNames[guid] = name\n                        end\n                        \n                        if not taken[guid] then\n                            taken[guid] = true\n                            tinsert(currentList, guid)\n                        end\n                    else\n                        tinsert(missing, name)\n                    end\n                end\n            end\n        end\n    end\n    \n    if next(duplicateNames) then\n        print(\"|cffff0000WARNING|r |cff00ff00Fojji|r|cff00ccffCUBE|r: DUPLICATE(s) Detected:\")\n        local printed = {}\n        for _, name in pairs(duplicateNames) do\n            if not printed[name] then\n                printed[name] = true\n                print(\"   |cffffaa00- \" .. name .. \"|r\")\n            end\n        end\n    end\n    \n    if #missing > 0 then\n        print(\"|cffff0000WARNING|r |cff00ff00Fojji|r|cff00ccffCUBE|r: Missing players from your group:\")\n        for _, name in ipairs(missing) do\n            print(\"   |cffff5555- \" .. name .. \"|r\")\n        end\n    end\nend\n\nlocal function BuildTeams()\n    local nameToGuid = {}\n    for unit in WA_IterateGroupMembers() do\n        local guid = UnitGUID(unit)\n        local name, realm = UnitName(unit)\n        if guid and name then\n            local capName = Capitalize(name)\n            nameToGuid[capName] = guid\n            if realm and realm ~= \"\" then\n                local full = name .. \"-\" .. realm\n                nameToGuid[Capitalize(full)] = guid\n            end\n        end\n    end\n    ParseCubeTeams(aura_env.config.option.cube.teams, nameToGuid)\nend\n\nlocal function FormatNames(guidList)\n    local names = {}\n    \n    for i, guid in ipairs(guidList) do\n        for unit in WA_IterateGroupMembers() do\n            if UnitGUID(unit) == guid then\n                local name = UnitName(unit)\n                if name then\n                    local mark = aura_env.marks and aura_env.marks[i]\n                    if mark then\n                        tinsert(names, \"{rt\" .. mark .. \"}\" .. name)\n                    else\n                        tinsert(names, name)\n                    end\n                end\n                break\n            end\n        end\n    end\n    \n    return table.concat(names, \",\")\nend\n\nlocal function SendTeam(teamIndex, guidList)\n    if #guidList <= 0 then\n        return\n    end\n    SendRaidChat(\"TEAM\" .. teamIndex .. \"-\" .. FormatNames(guidList))\nend\n\nlocal function BuildMarks()\n    wipe(aura_env.marks)\n    \n    local opt = aura_env.config.option.cube\n    local list = { opt.firstMark, opt.secondMark, opt.thirdMark, opt.fourthMark, opt.fifthMark }\n    \n    for i = 1, #list do\n        local mark = tonumber(list[i])\n        if mark and mark >= 1 and mark <= 8 then\n            tinsert(aura_env.marks, mark)\n        end\n    end\nend\n\nlocal function SendMarkIconsLine()\n    if not aura_env.marks or #aura_env.marks == 0 then\n        return\n    end\n    \n    local rt = {}\n    for i = 1, #aura_env.marks do\n        tinsert(rt, \"{rt\" .. aura_env.marks[i] .. \"}\")\n    end\n    \n    SendRaidChat(table.concat(rt, \"\"))\nend\n\nlocal function SendMarks()\n    if not aura_env.marks or #aura_env.marks == 0 then\n        return\n    end\n    \n    local labels = { \"DOOR\", \"WEST\", \"NW\", \"NE\", \"EAST\" }\n    local marks = {}\n    local max = math.min(#labels, #aura_env.marks)\n    \n    for i = 1, max do\n        tinsert(marks,\" {rt\" .. aura_env.marks[i] .. \"}\" .. labels[i])\n    end\n    \n    SendRaidChat(table.concat(marks, \"\"))\nend\n\nlocal function SendPlayerAssignments()\n    if not UnitIsGroupLeader(\"player\") then\n        return false\n    end\n    \n    BuildTeams()\n    BuildMarks()\n    \n    SendRaidChat(\"Magtheridon Cube Teams\")\n    SendMarkIconsLine()\n    SendMarks()\n    SendTeam(1, aura_env.team1)\n    SendTeam(2, aura_env.team2)\n    SendTeam(3, aura_env.team3)\n    SendTeam(4, aura_env.team4)\n    \n    return true\nend\n\nfunction aura_env.WA_MAGCUBE_POPULATE_LIST()\n    SendPlayerAssignments()\nend\n\nfunction aura_env.CHAT_MSG_RAID_LEADER(states, msg)\n    if msg and msg:find(\"!cube\") then\n        WeakAuras.ScanEvents(\"WA_MAGCUBE_POPULATE_LIST\")\n    end\nend\n\nfunction aura_env.WA_FJI_ENCOUNTER_START()\n    C_Timer.After(0.01, function()\n            WeakAuras.ScanEvents(\"WA_MAGCUBE_POPULATE_LIST\")\n    end)\nend\n\nfunction aura_env.WA_FJI_ENCOUNTER_END()\n    wipe(aura_env.team1)\n    wipe(aura_env.team2)\n    wipe(aura_env.team3)\n    wipe(aura_env.team4)\n    wipe(aura_env.marks)\nend\n\nfunction aura_env.ZONE_CHANGED_INDOORS()\n    local uiMapID = C_Map.GetBestMapForUnit(\"player\")\n    if uiMapID == 544 then\n        BuildTeams()\n        BuildMarks()\n    end\nend\n\nfunction aura_env.OPTIONS()\n    return\nend\n\nfunction aura_env.STATUS()\n    BuildTeams()\n    BuildMarks()\nend",
["do_custom"] = true,
},
