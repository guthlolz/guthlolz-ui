["CT:[BT][Trash] Weapon Master"] = {
["outline"] = "OUTLINE",
["wagoID"] = "pbbuhQ899",
["parent"] = "[BT][Trash]",
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiBT-P1/12",
["actions"] = {
["start"] = {
["do_glow"] = false,
["sound"] = "Interface\\Addons\\FojjiCore\\sound\\fojjiSnap.ogg",
["do_custom"] = false,
["do_sound"] = false,
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.npcId = \"23049\"\naura_env.debug = false\n\naura_env.battleStance = 41099\naura_env.berserkerStance = 41100\naura_env.defensiveStance = 41101\n\naura_env.knockID = 18813\naura_env.knockKey = \"TRASH_WEAPONMASTER_KNOCK\"\naura_env.knockStart = 4.9\naura_env.knockWindow = 11.4\n\naura_env.whirlwindID = 41097\naura_env.whirlwindKey = \"TRASH_WEAPONMASTER_WHIRLWIND\"\naura_env.whirlwindStart = 6.5\naura_env.whirlwindWindow = 19.5\n\naura_env.mutilateID = 41103\naura_env.mutilateKey = \"TRASH_WEAPONMASTER_MUTILATE\"\naura_env.mutilateStart = 6.5\naura_env.mutilateWindow = 11.4\n\naura_env.count = {}\naura_env.firstSeen = {}\naura_env.lastCast = {}\n\nfunction aura_env.debugPrint(msg)\n    if aura_env.debug then\n        print(\"|cff3399ffFojji|r \"..msg)\n    end\nend\n\nfunction aura_env.nuTimer(key,countdown,count,guid)\n    WeakAuras.ScanEvents(\"WA_NUMEN_TIMER\",key,countdown,count,guid)\nend\n\nfunction aura_env.cancelAll(guid)\n    aura_env.nuTimer(aura_env.knockKey,nil,nil,guid)\n    aura_env.nuTimer(aura_env.whirlwindKey,nil,nil,guid)\n    aura_env.nuTimer(aura_env.mutilateKey,nil,nil,guid)\nend\n\nfunction aura_env.startTimer(key,start,guid)\n    aura_env.count[guid] = aura_env.count[guid] or {}\n    aura_env.firstSeen[guid] = aura_env.firstSeen[guid] or {}\n    aura_env.lastCast[guid] = aura_env.lastCast[guid] or {}\n    \n    aura_env.count[guid][key] = 1\n    aura_env.firstSeen[guid][key] = GetTime()\n    aura_env.lastCast[guid][key] = nil\n    \n    aura_env.nuTimer(key,start,1,guid)\nend\n\nfunction aura_env.handleCast(key,window,spellName,guid)\n    aura_env.count[guid] = aura_env.count[guid] or {}\n    aura_env.firstSeen[guid] = aura_env.firstSeen[guid] or {}\n    aura_env.lastCast[guid] = aura_env.lastCast[guid] or {}\n    \n    local now = GetTime()\n    local count = aura_env.count[guid][key] or 1\n    \n    if aura_env.lastCast[guid][key] then\n        aura_env.debugPrint(string.format(\"NPC %s - %s (%d): %.1fs after previous.\",aura_env.npcId,spellName,count,now-aura_env.lastCast[guid][key]))\n    elseif aura_env.firstSeen[guid][key] then\n        aura_env.debugPrint(string.format(\"NPC %s - First %s (%d): %.1fs after stance.\",aura_env.npcId,spellName,count,now-aura_env.firstSeen[guid][key]))\n    end\n    \n    aura_env.lastCast[guid][key] = now\n    \n    aura_env.nuTimer(key,0,count,guid)\n    aura_env.count[guid][key] = count+1\n    aura_env.nuTimer(key,window,aura_env.count[guid][key],guid)\nend\n\nfunction aura_env.updateState(allstates)\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n    }\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "for guid in pairs(aura_env.count) do\n    aura_env.cancelAll(guid)\nend\n\naura_env.count = {}\naura_env.firstSeen = {}\naura_env.lastCast = {}",
["do_sound"] = false,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
["do_message"] = false,
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "CLEU:SPELL_CAST_SUCCESS:UNIT_DIED, WA_WEAPONMASTER_DEFENSIVE, WA_WEAPONMASTER_BERSERKER, WA_WEAPONMASTER_BATTLE",
["spellIds"] = {
},
["custom"] = "function(allstates,event,...)\n    if event == \"WA_WEAPONMASTER_DEFENSIVE\" then\n        local guid = ...\n        aura_env.startTimer(aura_env.knockKey,aura_env.knockStart,guid)\n        aura_env.updateState(allstates)\n        return true\n    end\n    \n    if event == \"WA_WEAPONMASTER_BERSERKER\" then\n        local guid = ...\n        aura_env.startTimer(aura_env.whirlwindKey,aura_env.whirlwindStart,guid)\n        aura_env.updateState(allstates)\n        return true\n    end\n    \n    if event == \"WA_WEAPONMASTER_BATTLE\" then\n        local guid = ...\n        aura_env.startTimer(aura_env.mutilateKey,aura_env.mutilateStart,guid)\n        aura_env.updateState(allstates)\n        return true\n    end\n    \n    if event ~= \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        return false\n    end\n    \n    local _,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId = ...\n    \n    if subEvent == \"UNIT_DIED\" then\n        local npcID = select(6,strsplit(\"-\",destGUID))\n        \n        if npcID == aura_env.npcId then\n            WeakAuras.ScanEvents(\"WA_WEAPONMASTER_WW_DIED\", destGUID)\n            aura_env.cancelAll(destGUID)\n            aura_env.count[destGUID] = nil\n            aura_env.firstSeen[destGUID] = nil\n            aura_env.lastCast[destGUID] = nil\n            return true\n        end\n        \n        return false\n    end\n    \n    if subEvent ~= \"SPELL_CAST_SUCCESS\" then\n        return false\n    end\n    \n    local npcID = select(6,strsplit(\"-\",sourceGUID))\n    if npcID ~= aura_env.npcId then\n        return false\n    end\n    \n    if spellId == aura_env.defensiveStance then\n        aura_env.cancelAll(sourceGUID)\n        WeakAuras.ScanEvents(\"WA_WEAPONMASTER_DEFENSIVE\",sourceGUID)\n        return false\n    elseif spellId == aura_env.berserkerStance then\n        aura_env.cancelAll(sourceGUID)\n        WeakAuras.ScanEvents(\"WA_WEAPONMASTER_BERSERKER\",sourceGUID)\n        return false\n    elseif spellId == aura_env.battleStance then\n        aura_env.cancelAll(sourceGUID)\n        WeakAuras.ScanEvents(\"WA_WEAPONMASTER_BATTLE\",sourceGUID)\n        return false\n    end\n    \n    if spellId == aura_env.knockID then\n        aura_env.handleCast(aura_env.knockKey,aura_env.knockWindow,GetSpellInfo(aura_env.knockID),sourceGUID)\n        aura_env.updateState(allstates)\n        return true\n    elseif spellId == aura_env.whirlwindID then\n        WeakAuras.ScanEvents(\"WA_WEAPONMASTER_WW\", sourceGUID)\n        aura_env.handleCast(aura_env.whirlwindKey,aura_env.whirlwindWindow,GetSpellInfo(aura_env.whirlwindID),sourceGUID)\n        aura_env.updateState(allstates)\n        return true\n    elseif spellId == aura_env.mutilateID then\n        aura_env.handleCast(aura_env.mutilateKey,aura_env.mutilateWindow,GetSpellInfo(aura_env.mutilateID),sourceGUID)\n        aura_env.updateState(allstates)\n        return true\n    end\n    \n    return false\nend",
["check"] = "event",
["subeventPrefix"] = "SPELL",
["custom_hide"] = "timed",
["debuffType"] = "HELPFUL",
