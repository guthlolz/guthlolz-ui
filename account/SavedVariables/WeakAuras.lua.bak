["triggers"] = {
{
["trigger"] = {
["customVariables"] = "{\n    value = \"number\",\n    percent = \"string\",\n    isDead = \"bool\",\n    name = \"string\",\n}",
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_type"] = "stateupdate",
["unevent"] = "auto",
["duration"] = "1",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "PLAYER_REGEN_ENABLED, WA_FJI_ENCOUNTER_END, ENCOUNTER_END, WA_KAELTHAS_P2_START, WA_KAELTHAS_P3_START, WA_FJI_WEAPON_TICKER, PLAYER_TARGET_CHANGED, WA_KAELTHAS_STAFF_DIED, WA_KAELTHAS_DAGGER_DIED, WA_KAELTHAS_SHIELD_DIED, WA_KAELTHAS_BOW_DIED, WA_KAELTHAS_MACE_DIED, WA_KAELTHAS_SWORD_DIED, WA_KAELTHAS_AXE_DIED",
["custom"] = "function(a, e)\n    if e == \"OPTIONS\" then\n        aura_env.createStates(a)\n        return true\n    end\n    \n    if e == \"PLAYER_REGEN_ENABLED\" or e == \"WA_FJI_ENCOUNTER_END\" or e == \"ENCOUNTER_END\" then\n        aura_env.hideState(a)\n        return true\n    end\n    \n    if e == \"WA_KAELTHAS_P2_START\" then\n        aura_env.addsAlive = 7\n        aura_env.createStates(a)\n        aura_env.startTicker()\n        return true\n    end\n    \n    if e == \"WA_FJI_WEAPON_TICKER\" then\n        return aura_env.scanUnits(a)\n    end\n    \n    local mob = aura_env.deathEvents[e]\n    if mob then\n        aura_env.updateState(a, mob.id, mob.name, mob.icon, 0, true)\n        aura_env.addsAlive = aura_env.addsAlive - 1\n        \n        if aura_env.addsAlive <= 0 then\n            aura_env.hideState(a)\n        end\n        \n        return true\n    end\nend",
