["custom"] = "function(allstates, event, key, time, count, guid)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 8,\n            expirationTime = GetTime() + 8,\n            progressType = \"timed\",\n            icon = 135801,\n            autoHide = true,\n        }\n        return true\n    end\n    if event == \"WA_NUMEN_TIMER\" and key == \"TRASH_NIGHTLORD_SHADOWINFERNO\" then\n        if time == 0 then\n            allstates[guid] = {\n                show = true,\n                changed = true,\n                duration = 8,\n                expirationTime = GetTime() + 8,\n                progressType = \"timed\",\n                icon = 135801,\n                autoHide = true,\n            }\n            return true\n        elseif time == nil then\n            if allstates[guid] then\n                allstates[guid].show = false\n                allstates[guid].changed = true\n                return true\n            end\n        end\n    end\nend",
