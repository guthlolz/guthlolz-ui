["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["custom_hide"] = "timed",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["unit"] = "player",
["custom"] = "function(allstates, event, key, time, count)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            icon = 132154,\n            count = math.random(1,5),\n        }\n    end\n    if event == \"WA_NUMEN_TIMER\" and key == \"MAULGAR_INTIMIDATING_ROAR\" and time == 0 then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            progressType = \"timed\",\n            icon = 132154,\n            autoHide = true,\n            count = count\n        }\n        return true\n    end\nend",
