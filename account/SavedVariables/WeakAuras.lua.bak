["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["custom_type"] = "stateupdate",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(allstates,event)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            icon = 136224,\n        }\n    end\n    if event == \"WA_FOJJI_BERSERK\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 3,\n            expirationTime = GetTime() + 3,\n            progressType = \"timed\",\n            icon = 136224,\n            autoHide = true,\n        }\n        return true\n    end\nend",
["events"] = "WA_FOJJI_BERSERK",
["spellIds"] = {
},
["names"] = {
},
