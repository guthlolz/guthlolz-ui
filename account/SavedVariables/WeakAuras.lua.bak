["displayText"] = "",
["customText"] = "",
["shadowYOffset"] = -1,
["sparkHidden"] = "NEVER",
["desaturateBackground"] = false,
["cooldownSwipe"] = true,
["sparkTexture"] = "Interface\\CastingBar\\UI-CastingBar-Spark",
["customTextUpdate"] = "event",
["cooldownEdge"] = false,
["desaturateForeground"] = false,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["custom_type"] = "stateupdate",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(allstates,event,...)\n    if UnitPowerType(\"player\") ~= 0 then\n        return false\n    end\n    \n    if event == \"WA_FJI_ENCOUNTER_START\" or event == \"ENCOUNTER_START\" then\n        local eID = ...\n        \n        if eID ~= 620 then\n            return false\n        end\n        \n        aura_env.pullStart = GetTime()\n        aura_env.nextMarkAt = aura_env.pullStart + 45\n        aura_env.preWarnActive = false\n        aura_env.hasMark = false\n        aura_env.markAppliedAt = nil\n        aura_env.nextMarkDeadly = false\n        aura_env.markExplode = false\n        \n        aura_env.updateWarnings()\n        return false\n    end\n    \n    if event == \"WA_NUMEN_TIMER\" then\n        local key,time,count = ...\n        \n        if key ~= aura_env.key or not aura_env.pullStart then\n            return false\n        end\n        \n        if time and time > 0 then\n            aura_env.nextMarkAt = GetTime() + time\n            aura_env.updateWarnings()\n        end\n        \n        return false\n    end\n    \n    if event == \"WA_KAZROGAL_MARK_PREWARN\" then\n        if not aura_env.pullStart then\n            return false\n        end\n        \n        aura_env.preWarnActive = true\n        aura_env.updateWarnings()\n        return false\n    end\n    \n    if event == \"WA_KAZROGAL_MARK_PREWARN_CANCEL\" then\n        aura_env.preWarnActive = false\n        aura_env.updateWarnings()\n        return false\n    end\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local _,subEvent,_,_,_,_,_,destGUID,_,_,_,spellId = ...\n        \n        if spellId ~= aura_env.spellID or destGUID ~= WeakAuras.myGUID then\n            return false\n        end\n        \n        if subEvent == \"SPELL_AURA_APPLIED\" then\n            aura_env.hasMark = true\n            aura_env.markAppliedAt = GetTime()\n            aura_env.preWarnActive = false\n            aura_env.updateWarnings()\n        elseif subEvent == \"SPELL_AURA_REMOVED\" then\n            aura_env.hasMark = false\n            aura_env.markAppliedAt = nil\n            aura_env.updateWarnings()\n        end\n        \n        return false\n    end\n    \n    if event == \"UNIT_POWER_UPDATE\" then\n        local unit,powerType = ...\n        \n        if unit ~= \"player\" or powerType ~= \"MANA\" or not aura_env.pullStart then\n            return false\n        end\n        \n        aura_env.updateWarnings()\n        return false\n    end\n    \n    if event == \"WA_FJI_ENCOUNTER_END\" or event == \"ENCOUNTER_END\" then\n        aura_env.pullStart = nil\n        aura_env.nextMarkAt = nil\n        aura_env.preWarnActive = false\n        aura_env.hasMark = false\n        aura_env.markAppliedAt = nil\n        \n        aura_env.resetWarnings()\n        return false\n    end\n    \n    return false\nend",
["events"] = "WA_NUMEN_TIMER UNIT_POWER_UPDATE:player ENCOUNTER_START ENCOUNTER_END WA_FJI_ENCOUNTER_START WA_FJI_ENCOUNTER_END, WA_KAZROGAL_MARK_PREWARN, WA_KAZROGAL_MARK_PREWARN_CANCEL, CLEU:SPELL_AURA_APPLIED:SPELL_AURA_REMOVED",
