},
["custom"] = "function(a, e, ...)\n    if e == \"OPTIONS\" then\n        a[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 13,\n            expirationTime = GetTime() + 13,\n            name = WeakAuras.me,\n        }\n        return true\n    end\n    \n    if e == \"WA_SUPREMUS_FIXATE_TARGET\" then\n        local name, remaining = ...\n        \n        if not remaining or remaining <= 0 then\n            return false\n        end\n        \n        a[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = remaining,\n            expirationTime = GetTime() + remaining,\n            name = name,\n        }\n        return true\n    end\n    \n    if e == \"WA_SUPREMUS_TANK_PHASE\" or e == \"ENCOUNTER_END\" or e == \"WA_FJI_ENCOUNTER_END\" then\n        if a[\"\"] then\n            a[\"\"].show = false\n            a[\"\"].changed = true\n            return true\n        end\n    end\nend",
["events"] = "ENCOUNTER_END, WA_FJI_ENCOUNTER_END, WA_SUPREMUS_FIXATE_TARGET, WA_SUPREMUS_TANK_PHASE",
