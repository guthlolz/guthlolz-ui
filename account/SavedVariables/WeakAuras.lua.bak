["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["unit"] = "player",
["names"] = {
},
["spellIds"] = {
},
["custom"] = "function(a, e, _, _, spellId)\n    if e == \"OPTIONS\" or e == \"START_AUTOREPEAT_SPELL\" then\n        local wandSpeed = 0.6\n        if aura_env.lastcast then\n            wandSpeed = 1.5\n        end\n        \n        a[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = wandSpeed,\n            expirationTime = wandSpeed + GetTime(),\n            autoHide = true,\n            icon = GetInventoryItemTexture(\"player\", 18),\n        }\n        return true\n    elseif e == \"UNIT_SPELLCAST_SUCCEEDED\" then\n        if spellId == aura_env.wand then\n            aura_env.lastcast = false\n            local speed = UnitRangedDamage(\"player\")\n            \n            a[\"\"] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = speed,\n                expirationTime = speed + GetTime(),\n                autoHide = true,\n                icon = GetInventoryItemTexture(\"player\", 18),\n            }\n            return true\n        else\n            aura_env.lastcast = true\n            C_Timer.After(1.5, function()\n                    aura_env.lastcast = false\n            end)\n        end\n    elseif e == \"STOP_AUTOREPEAT_SPELL\" then\n        if a[\"\"] then\n            a[\"\"].show = false\n            a[\"\"].changed = true\n            return true\n        end\n    end\nend",
["subeventPrefix"] = "SPELL",
["check"] = "event",
["custom_type"] = "stateupdate",
["events"] = "START_AUTOREPEAT_SPELL STOP_AUTOREPEAT_SPELL UNIT_SPELLCAST_SUCCEEDED:player",
["debuffType"] = "HELPFUL",
},
