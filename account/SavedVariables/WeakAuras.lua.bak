["customVariables"] = "{\n    expirationTime = true,\n}",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "OPTIONS ENCOUNTER_START WA_FJI_ENCOUNTER_START ENCOUNTER_END WA_FJI_ENCOUNTER_END CHAT_MSG_RAID_LEADER WA_ILLIDARI_BOP_TARGET WA_ILLIDARI_BOP_REMOVED WA_ILLIDARI_SPELL_WARDING_TARGET WA_ILLIDARI_SPELL_WARDING_REMOVED CLEU:SPELL_CAST_SUCCESS",
["spellIds"] = {
},
["custom"] = "function(a,e,...)\n    if e == \"OPTIONS\" then\n        a[1] = {\n            show = true,\n            changed = true,\n            name = WeakAuras.me,\n            index = 1,\n            progressType = \"timed\",\n            duration = 24,\n            expirationTime = GetTime() + 16,\n            autoHide = false,\n        }\n        \n        a[2] = {\n            show = true,\n            changed = true,\n            name = WeakAuras.me,\n            index = 2,\n            progressType = \"timed\",\n            duration = 6,\n            expirationTime = GetTime() + 4,\n            autoHide = false,\n        }\n        \n        a[3] = {\n            show = true,\n            changed = true,\n            name = WeakAuras.me,\n            index = 3,\n            progressType = \"static\",\n            value = 1,\n            total = 1,\n        }\n        return true\n    end\n    \n    if e == \"ENCOUNTER_START\" or e == \"WA_FJI_ENCOUNTER_START\" then\n        local eID = ...\n        \n        if eID ~= aura_env.encounterID then\n            return false\n        end\n        \n        aura_env.encounterActive = true\n        aura_env.bopActive = false\n        aura_env.wardingActive = false\n        wipe(aura_env.cooldowns)\n        aura_env.UpdatePetOwners()\n        aura_env.UpdateDisplay(a)\n        return true\n    end\n    \n    if e == \"ENCOUNTER_END\" or e == \"WA_FJI_ENCOUNTER_END\" then\n        aura_env.Reset(a)\n        return true\n    end\n    \n    if e == \"CHAT_MSG_RAID_LEADER\" then\n        local msg = ...\n        \n        if not msg then\n            return false\n        end\n        \n        if msg == \"Council Interrupt Assignments\" then\n            wipe(aura_env.physicalPlayers)\n            wipe(aura_env.magicalPlayers)\n            wipe(aura_env.assignedPlayers)\n            aura_env.preferredType = nil\n            aura_env.currentType = nil\n            aura_env.HideStates(a)\n            return true\n        end\n        \n        local playerText = msg:match(\"^PHYSICAL%-(.+)$\")\n        \n        if playerText then\n            aura_env.ParsePlayers(playerText,aura_env.physicalPlayers)\n            \n            if aura_env.encounterActive and aura_env.currentType == \"PHYSICAL\" then\n                aura_env.ShowType(a,\"PHYSICAL\")\n                return true\n            end\n            return false\n        end\n        \n        playerText = msg:match(\"^MAGICAL%-(.+)$\")\n        \n        if playerText then\n            aura_env.ParsePlayers(playerText,aura_env.magicalPlayers)\n            \n            if aura_env.encounterActive and aura_env.currentType == \"MAGICAL\" then\n                aura_env.ShowType(a,\"MAGICAL\")\n                return true\n            end\n            return false\n        end\n        \n        if msg == \"PREFERRED-MAGICAL\" then\n            aura_env.preferredType = \"MAGICAL\"\n            \n            if aura_env.encounterActive and not aura_env.bopActive and not aura_env.wardingActive then\n                aura_env.UpdateDisplay(a)\n                return true\n            end\n            return false\n        elseif msg == \"PREFERRED-PHYSICAL\" then\n            aura_env.preferredType = \"PHYSICAL\"\n            \n            if aura_env.encounterActive and not aura_env.bopActive and not aura_env.wardingActive then\n                aura_env.UpdateDisplay(a)\n                return true\n            end\n            return false\n        end\n        \n        return false\n    end\n    \n    if e == \"WA_ILLIDARI_BOP_TARGET\" then\n        local class = ...\n        \n        if class ~= \"PRIEST\" or not aura_env.encounterActive then\n            return false\n        end\n        \n        aura_env.bopActive = true\n        aura_env.wardingActive = false\n        aura_env.UpdateDisplay(a)\n        return true\n    end\n    \n    if e == \"WA_ILLIDARI_BOP_REMOVED\" then\n        local class = ...\n        \n        if class ~= \"PRIEST\" or not aura_env.encounterActive then\n            return false\n        end\n        \n        aura_env.bopActive = false\n        aura_env.UpdateDisplay(a)\n        return true\n    end\n    \n    if e == \"WA_ILLIDARI_SPELL_WARDING_TARGET\" then\n        local class = ...\n        \n        if class ~= \"PRIEST\" or not aura_env.encounterActive then\n            return false\n        end\n        \n        aura_env.wardingActive = true\n        aura_env.bopActive = false\n        aura_env.UpdateDisplay(a)\n        return true\n    end\n    \n    if e == \"WA_ILLIDARI_SPELL_WARDING_REMOVED\" then\n        local class = ...\n        \n        if class ~= \"PRIEST\" or not aura_env.encounterActive then\n            return false\n        end\n        \n        aura_env.wardingActive = false\n        aura_env.UpdateDisplay(a)\n        return true\n    end\n    \n    if e == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local _,subEvent,_,sourceGUID,sourceName,_,_,_,_,_,_,spellId = ...\n        \n        if subEvent ~= \"SPELL_CAST_SUCCESS\" then\n            return false\n        end\n        \n        local duration = aura_env.interruptCDs[spellId]\n        \n        if not duration then\n            return false\n        end\n        \n        local playerName = sourceName\n        \n        if not playerName or not aura_env.assignedPlayers[playerName] then\n            playerName = aura_env.petOwners[sourceGUID]\n            \n            if not playerName or not aura_env.assignedPlayers[playerName] then\n                return false\n            end\n        end\n        \n        aura_env.cooldowns[playerName] = {\n            duration = duration,\n            expirationTime = GetTime() + duration,\n        }\n        \n        local state = a[playerName]\n        \n        if not state or not state.show then\n            return false\n        end\n        \n        state.progressType = \"timed\"\n        state.duration = duration\n        state.expirationTime = aura_env.cooldowns[playerName].expirationTime\n        state.autoHide = false\n        state.changed = true\n        return true\n    end\n    \n    return false\nend",
