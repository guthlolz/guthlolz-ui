["displayText"] = "%i NEXT KICK: (%type)",
["customTextUpdate"] = "event",
["adjustedMax"] = "",
["desaturateForeground"] = false,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "{\n    expirationTime = true,\n}",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "OPTIONS ENCOUNTER_START WA_FJI_ENCOUNTER_START ENCOUNTER_END WA_FJI_ENCOUNTER_END CHAT_MSG_RAID_LEADER WA_ILLIDARI_BOP_TARGET WA_ILLIDARI_BOP_REMOVED WA_ILLIDARI_SPELL_WARDING_TARGET WA_ILLIDARI_SPELL_WARDING_REMOVED WA_ILLIDARI_CIRCLE_OF_HEALING_PREWARN WA_ILLIDARI_COH_CAST WA_ILLIDARI_COH_INTERRUPT",
["spellIds"] = {
},
["custom"] = "function(a,e,...)\n    if e == \"OPTIONS\" then\n        a[\"\"] = {\n            show = true,\n            changed = true,\n            type = \"PHYSICAL\",\n            progressType = \"static\",\n            value = 1,\n            total = 1,\n            icon = 135943\n        }\n        return true\n    end\n    \n    if e == \"ENCOUNTER_START\" or e == \"WA_FJI_ENCOUNTER_START\" then\n        local eID = ...\n        \n        if eID ~= aura_env.encounterID then\n            return false\n        end\n        \n        aura_env.encounterActive = true\n        aura_env.bopActive = false\n        aura_env.wardingActive = false\n        aura_env.notifiedType = nil\n        aura_env.UpdateDisplay(a,false)\n        return true\n    end\n    \n    if e == \"ENCOUNTER_END\" or e == \"WA_FJI_ENCOUNTER_END\" then\n        aura_env.Reset(a)\n        return true\n    end\n    \n    if e == \"CHAT_MSG_RAID_LEADER\" then\n        local msg = ...\n        \n        if not msg then\n            return false\n        end\n        \n        if msg == \"Council Interrupt Assignments\" then\n            wipe(aura_env.physicalPlayers)\n            wipe(aura_env.magicalPlayers)\n            aura_env.preferredType = nil\n            aura_env.currentType = nil\n            aura_env.notifiedType = nil\n            \n            if a[\"\"] then\n                a[\"\"].show = false\n                a[\"\"].changed = true\n            end\n            return true\n        end\n        \n        local playerText = msg:match(\"^PHYSICAL%-(.+)$\")\n        \n        if playerText then\n            aura_env.ParsePlayers(playerText,aura_env.physicalPlayers)\n            return false\n        end\n        \n        playerText = msg:match(\"^MAGICAL%-(.+)$\")\n        \n        if playerText then\n            aura_env.ParsePlayers(playerText,aura_env.magicalPlayers)\n            return false\n        end\n        \n        if msg == \"PREFERRED-MAGICAL\" then\n            aura_env.preferredType = \"MAGICAL\"\n            \n            if not aura_env.bopActive and not aura_env.wardingActive then\n                aura_env.UpdateDisplay(a,true)\n                return true\n            end\n            return false\n        elseif msg == \"PREFERRED-PHYSICAL\" then\n            aura_env.preferredType = \"PHYSICAL\"\n            \n            if not aura_env.bopActive and not aura_env.wardingActive then\n                aura_env.UpdateDisplay(a,true)\n                return true\n            end\n            return false\n        end\n        \n        return false\n    end\n    \n    if e == \"WA_ILLIDARI_BOP_TARGET\" then\n        local class = ...\n        \n        if class ~= \"PRIEST\" or not aura_env.encounterActive then\n            return false\n        end\n        \n        aura_env.bopActive = true\n        aura_env.wardingActive = false\n        aura_env.UpdateDisplay(a,true)\n        return true\n    end\n    \n    if e == \"WA_ILLIDARI_BOP_REMOVED\" then\n        local class = ...\n        \n        if class ~= \"PRIEST\" or not aura_env.encounterActive then\n            return false\n        end\n        \n        aura_env.bopActive = false\n        aura_env.UpdateDisplay(a,true)\n        return true\n    end\n    \n    if e == \"WA_ILLIDARI_SPELL_WARDING_TARGET\" then\n        local class = ...\n        \n        if class ~= \"PRIEST\" or not aura_env.encounterActive then\n            return false\n        end\n        \n        aura_env.wardingActive = true\n        aura_env.bopActive = false\n        aura_env.UpdateDisplay(a,true)\n        return true\n    end\n    \n    if e == \"WA_ILLIDARI_SPELL_WARDING_REMOVED\" then\n        local class = ...\n        \n        if class ~= \"PRIEST\" or not aura_env.encounterActive then\n            return false\n        end\n        \n        aura_env.wardingActive = false\n        aura_env.UpdateDisplay(a,true)\n        return true\n    end\n    \n    if e == \"WA_ILLIDARI_CIRCLE_OF_HEALING_PREWARN\" then\n        if not aura_env.encounterActive or not aura_env.currentType then\n            return false\n        end\n        \n        aura_env.SendNext(aura_env.currentType)\n        return false\n    end\n    \n    if e == \"WA_ILLIDARI_COH_CAST\" then\n        local castTime = ...\n        \n        if not aura_env.encounterActive or not aura_env.currentType or not castTime then\n            return false\n        end\n        \n        aura_env.SendNow(aura_env.currentType,castTime)\n        return false\n    end\n    \n    if e == \"WA_ILLIDARI_COH_INTERRUPT\" then\n        if not aura_env.encounterActive or not aura_env.currentType then\n            return false\n        end\n        \n        aura_env.SendCancel(aura_env.currentType)\n        return false\n    end\n    \n    return false\nend",
["check"] = "event",
["subeventPrefix"] = "SPELL",
["custom_hide"] = "timed",
["debuffType"] = "HELPFUL",
