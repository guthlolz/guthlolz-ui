["actions"] = {
["start"] = {
["do_custom"] = false,
["custom"] = "\n\n",
["sound"] = "Interface\\AddOns\\WeakAuras\\Media\\Sounds\\AirHorn.ogg",
["do_sound"] = false,
},
["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.NPC_ID = \"18831\" -- Maulgar\naura_env.safeRange = 4\n\nlocal function getNpcID(unit)\n    local guid = UnitGUID(unit)\n    if not guid then return end\n    return select(6, strsplit(\"-\", guid))\nend\n\nfunction aura_env.getRange()\n    if UnitExists(\"target\") and getNpcID(\"target\") == aura_env.NPC_ID then\n        local range = WeakAuras.GetRange(\"target\")\n        return range\n    end\n    \n    for i = 1, 40 do\n        local unit = \"nameplate\" .. i\n        if UnitExists(unit) and getNpcID(unit) == aura_env.NPC_ID then\n            local range = WeakAuras.GetRange(unit)\n            return range\n        end\n    end\nend\n\nfunction aura_env.isRangeSafe()\n    local range = aura_env.getRange()\n    return range and range >= aura_env.safeRange or false\nend",
},
["finish"] = {
},
},
["displayText_format_unitName_realm_name"] = "never",
["displayText_format_c_realm_name"] = "never",
["displayText_format_c1_format"] = "none",
["config"] = {
},
["inverse"] = false,
["cooldown"] = true,
["backgroundTexture"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Auras\\Aura3",
