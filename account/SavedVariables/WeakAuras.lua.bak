["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates,event,eID,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId)\n    if event == \"WA_FJI_ENCOUNTER_START\" or event == \"ENCOUNTER_START\" then\n        if eID ~= 628 then\n            return false\n        end\n        wipe(aura_env.tainteds)\n        return\n    end\n    \n    if event == \"WA_VASHJ_P2_START\" then\n        aura_env.updateState(allstates)\n        aura_env.count = 1\n        wipe(aura_env.tainteds)\n        \n        aura_env.preWarn(aura_env.cdStart, 3, aura_env.count)\n        aura_env.nuTimer(aura_env.cdStart, aura_env.count)\n        return true\n        \n    elseif event == \"WA_FJI_ENCOUNTER_END\" or event == \"ENCOUNTER_END\" or event == \"WA_VASHJ_P3_START\" then\n        wipe(aura_env.tainteds)\n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        return true\n    end\n    \n    if subEvent == \"UNIT_DIED\" then\n        local npcID = select(6, strsplit(\"-\", destGUID))\n        if npcID == \"22009\" then\n            aura_env.count = aura_env.count + 1\n            aura_env.preWarn(aura_env.cdWindow, 3, aura_env.count)\n            aura_env.nuTimer(aura_env.cdWindow, aura_env.count)\n            return true\n        end\n    end\n    \n    if spellId ~= aura_env.poisonBolt then\n        return false\n    end\n    \n    if subEvent == \"SPELL_CAST_START\" then\n        if not aura_env.tainteds[sourceGUID] then\n            aura_env.tainteds[sourceGUID] = true\n            aura_env.nuTimer(0, aura_env.count)\n            return true\n        end\n    end\nend",
["spellIds"] = {
},
["events"] = "ENCOUNTER_END, WA_FJI_ENCOUNTER_END, WA_VASHJ_P2_START, WA_VASHJ_P3_START, CLEU:UNIT_DIED:SPELL_CAST_START",
