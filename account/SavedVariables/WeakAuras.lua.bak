["id"] = "[T4][MGL] Cube Assigner",
["wagoID"] = "ASKpBvm6n",
["semver"] = "1.0.2",
["displayText_format_3.myTargetGuid_format"] = "none",
["displayText_format_1.destGuid_format"] = "guid",
