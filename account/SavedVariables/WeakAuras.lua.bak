["event"] = "Health",
["unit"] = "player",
["subeventSuffix"] = "_CAST_START",
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = aura_env.castTime,\n            expirationTime = GetTime() + aura_env.castTime,\n            autoHide = true,\n            icon = aura_env.icon,\n            hasTarget = true,\n            target = WeakAuras.myGUID\n        }\n        return true\n    end\n    \n    if event == \"WA_ILLIDAN_SHADOW_BLAST_CAST\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = aura_env.castTime,\n            expirationTime = GetTime() + aura_env.castTime,\n            autoHide = true,\n            icon = aura_env.icon,\n            hasTarget = false,\n            target = \"\",\n        }\n        return true\n    elseif event == \"WA_ILLIDAN_SHADOW_BLAST_TARGET\" then\n        local guid = ...\n        \n        if allstates[\"\"] then\n            allstates[\"\"].hasTarget = true\n            allstates[\"\"].target = guid\n            allstates[\"\"].changed = true\n            return true\n        end\n    end\nend",
