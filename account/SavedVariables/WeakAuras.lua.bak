},
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 1.7,\n            expirationTime = GetTime() + 1.7,\n            autoHide = true,\n        }\n        return true\n    end\n    \n    if event == \"WA_ARCHIMONDE_BURST_TARGET\" then\n        local guid = ...\n        if guid ~= WeakAuras.myGUID then\n            return false\n        end\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 1.7,\n            expirationTime = GetTime() + 1.7,\n            autoHide = true,\n        }\n        return true\n    end\nend",
