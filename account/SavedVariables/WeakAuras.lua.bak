["event"] = "Health",
["unit"] = "player",
["subeventSuffix"] = "_CAST_START",
["custom"] = "function(allstates,event,...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 2.5,\n            expirationTime = GetTime()+2.5,\n            autoHide = true,\n            icon = aura_env.icon,\n        }\n        return true\n    end\n    \n    if event == \"WA_ILLIDARI_COH_CAST\" then\n        local castTime = ...\n        \n        if not castTime then\n            return false\n        end\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = castTime,\n            expirationTime = GetTime()+castTime,\n            autoHide = true,\n            icon = aura_env.icon,\n        }\n        return true\n    elseif event == \"WA_ILLIDARI_COH_INTERRUPT\" then\n        if allstates[\"\"] then\n            allstates[\"\"].show = false\n            allstates[\"\"].changed = true\n            return true\n        end\n    end\n    \n    return false\nend",
["spellIds"] = {
},
