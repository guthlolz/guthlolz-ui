["Shield durability warning [<10%]"] = {
["iconSource"] = -1,
["wagoID"] = "sGScXfEv2",
["xOffset"] = 0,
["adjustedMax"] = "",
["customText"] = "function()\n    local s = WeakAuras.GetTriggerStateForTrigger(aura_env.id, 1)\n    s = s and (s[0] or s[\"\"])\n    return s and s.total and s.total > 0 and (\"%.0f%%\"):format((s.value or 0) / s.total * 100) or \"0%\"\nend",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["cooldownSwipe"] = true,
["cooldownEdge"] = false,
["icon"] = true,
["triggers"] = {
{
["trigger"] = {
["itemName"] = 0,
["duration"] = "1",
["genericShowOn"] = "showOnCooldown",
["subeventPrefix"] = "SPELL",
["weapon"] = "main",
["use_weapon"] = true,
["names"] = {
},
["use_genericShowOn"] = true,
["check"] = "event",
["itemSetName"] = "",
["debuffType"] = "HELPFUL",
["custom"] = "function(states, event, ...)\n    local slot = 17\n    \n    local function hide()\n        states[\"\"] = { show = false, changed = true }\n    end\n    \n    if event == \"OPTIONS\" then\n        states[\"\"] = {\n            name = \"Shield\",\n            icon = GetInventoryItemTexture(\"player\", 17) or 134977,\n            value = 3,\n            total = 30,\n            percent = (\"%d%%\"):format(10),\n            changed = true,\n            show = true,\n        }\n        return true\n    end\n    \n    if not GetInventoryItemID(\"player\", slot) then\n        hide()\n        return true\n    end\n    \n    local value, total = GetInventoryItemDurability(slot)\n    if not value or not total then\n        hide()\n        return true\n    end\n    \n    local percent = value / total * 100\n    if percent > 10 then\n        hide()\n        aura_env.lowDurabilityWarned = nil\n        return true\n    end\n    \n    aura_env.lowDurabilityWarned = (value < 10) and (aura_env.lowDurabilityWarned or true) or nil\n    \n    local link = GetInventoryItemLink(\"player\", slot)\n    states[\"\"] = {\n        name = (link and GetItemInfo(link)) or \"Shield\",\n        icon = GetInventoryItemTexture(\"player\", slot) or 134977,\n        value = value,\n        total = total,\n        percent = (\"%d%%\"):format(percent),\n        changed = true,\n        show = true,\n    }\n    return true\nend",
["type"] = "custom",
["events"] = "PLAYER_DEAD UPDATE_INVENTORY_DURABILITY UNIT_AURA",
["unevent"] = "timed",
["use_showOn"] = true,
["custom_hide"] = "timed",
["use_itemName"] = true,
["use_unit"] = true,
