["custom"] = "function(allstates, event)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 10,\n            expirationTime = GetTime() + 10,\n            progressType = \"timed\",\n            icon = 135815,\n            autoHide = true,\n        }\n        return true\n    end\n    if event == \"WA_ALAR_QUILLS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 10,\n            expirationTime = GetTime() + 10,\n            progressType = \"timed\",\n            icon = 135815,\n            autoHide = true,\n        }\n        return true\n    end\nend",
