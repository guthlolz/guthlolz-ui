["customText"] = "function()\n    if (aura_env.hasOffHandEnchant and aura_env.offHandExpiration >= 0) then\n        local seconds = aura_env.offHandExpiration / 1000\n        local minutes = math.ceil(seconds / 60)\n        if (seconds > 60) then\n            return minutes .. \"m\"\n        else\n            return math.floor(seconds) .. \"s\"\n        end\n    end\nend",
