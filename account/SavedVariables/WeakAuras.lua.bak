["CT:[BT][Supremus] Phase Controller"] = {
["outline"] = "OUTLINE",
["wagoID"] = "pbbuhQ899",
["parent"] = "[BT][Supremus]",
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiBT-P1/12",
["actions"] = {
["start"] = {
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.kite = \"SUPREMUS_KITE\"\naura_env.tank = \"SUPREMUS_TANK\"\naura_env.kiteCount = 1\naura_env.tankCount = 2\naura_env.cdStart = 60\naura_env.cdWindow = 60\naura_env.preWarnTimer = {}\n\nfunction aura_env.nuTimer(key, countdown, count)\n    WeakAuras.ScanEvents(\"WA_NUMEN_TIMER\", key, countdown, count)\nend\n\nfunction aura_env.updateState(allstates)\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n    }\nend\n\nfunction aura_env.hideState(allstates)\n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\nend\n\nfunction aura_env.preWarn(key, duration, preWarnTime, count)\n    if not preWarnTime then\n        preWarnTime = 3\n    end\n    \n    if aura_env.preWarnTimer[key] then\n        aura_env.preWarnTimer[key]:Cancel()\n        aura_env.preWarnTimer[key] = nil\n    end\n    aura_env.preWarnTimer[key] = C_Timer.NewTimer(duration - preWarnTime, function()\n            WeakAuras.ScanEvents(\"WA_\" .. key ..\"_PREWARN\", preWarnTime, count)\n            aura_env.preWarnTimer[key] = nil\n    end)\nend\n\nfunction aura_env.preWarnCancel(key)\n    WeakAuras.ScanEvents(\"WA_\" .. key .. \"_PREWARN_CANCEL\")\n    if aura_env.preWarnTimer[key] then\n        aura_env.preWarnTimer[key]:Cancel()\n        aura_env.preWarnTimer[key] = nil\n    end\nend\n\n\nlocal locale = GetLocale()\n\naura_env.locales = {\n    [\"enUS\"] = {\n        kite = \"The ground begins to crack open!\",\n        tank = \"punches the ground in anger!\",\n    },\n    [\"frFR\"] = {\n        kite = \"Le sol commence à se fissurer !\",\n        tank = \"De rage, Supremus frappe le sol !\"\n    },\n    [\"deDE\"] = {\n        kite = \"Der Boden beginnt aufzubrechen!\",\n        tank = \"schlägt wütend auf den Boden!\",\n    },\n    [\"esES\"] = {\n        kite = \"El suelo comienza a abrirse.\",\n        tank = \"golpea el suelo enfadado!\",\n    },\n    [\"koKR\"] = {\n        kite = \"분노하여 땅을 내리찍습니다!\",\n        tank = \"땅이 갈라져서 열리기 시작합니다!\",\n    },\n    [\"ruRU\"] = {\n        kite = \"Земля начинает раскалываться!\",\n        tank = \"в гневе ударяет по земле!\",\n    },\n    [\"zhCN\"] = {\n        kite = \"地面崩裂了！\",\n        tank = \"木桩战！\",\n    },\n    [\"zhTW\"] = {\n        kite = \"地上開始裂開!\",\n        tank = \"瑟普莫斯憤怒的捶擊地面!\",\n    }\n}\n\naura_env.currentLocale = aura_env.locales[locale] or aura_env.locales[\"enUS\"]",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "aura_env.count = 1\naura_env.nuTimer(aura_env.tank, nil)\naura_env.nuTimer(aura_env.kite, nil)\naura_env.preWarnCancel(aura_env.tank)\naura_env.preWarnCancel(aura_env.kite)",
["do_sound"] = false,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
["do_message"] = false,
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "ENCOUNTER_START, ENCOUNTER_END, WA_FJI_ENCOUNTER_END, WA_FJI_ENCOUNTER_START, RAID_BOSS_EMOTE",
["spellIds"] = {
},
["custom"] = "function(allstates,event,...)\n    if event == \"WA_FJI_ENCOUNTER_START\" or event == \"ENCOUNTER_START\" then\n        local eID = ...\n        if eID ~= 602 then\n            return false\n        end\n        \n        aura_env.updateState(allstates)\n        aura_env.tankCount = 2\n        aura_env.kiteCount = 1\n        \n        aura_env.preWarn(aura_env.kite, aura_env.cdWindow, 5, aura_env.kiteCount)\n        aura_env.nuTimer(aura_env.kite, aura_env.cdWindow, aura_env.kiteCount)\n        return true\n    elseif event == \"WA_FJI_ENCOUNTER_END\" or event == \"ENCOUNTER_END\" then\n        aura_env.nuTimer(aura_env.tank, nil)\n        aura_env.nuTimer(aura_env.kite, nil)\n        aura_env.preWarnCancel(aura_env.tank)\n        aura_env.preWarnCancel(aura_env.kite)\n        return true\n    end\n    \n    if event == \"RAID_BOSS_EMOTE\" then\n        local msg = ...\n        \n        if msg:find(aura_env.currentLocale.kite) or msg == aura_env.currentLocale.kite then\n            aura_env.nuTimer(aura_env.kite, 0, aura_env.kiteCount)\n            aura_env.kiteCount = aura_env.kiteCount + 1\n            WeakAuras.ScanEvents(\"WA_SUPREMUS_KITE_PHASE\")\n            \n            aura_env.preWarn(aura_env.tank, aura_env.cdWindow, 5, aura_env.tankCount)\n            aura_env.nuTimer(aura_env.tank, aura_env.cdWindow, aura_env.tankCount)\n            return true\n        elseif msg:find(aura_env.currentLocale.tank) or msg == aura_env.currentLocale.tank then\n            aura_env.nuTimer(aura_env.tank, 0, aura_env.tankCount)\n            aura_env.tankCount = aura_env.tankCount + 1\n            WeakAuras.ScanEvents(\"WA_SUPREMUS_TANK_PHASE\")\n            \n            aura_env.preWarn(aura_env.kite, aura_env.cdWindow, 5, aura_env.kiteCount)\n            aura_env.nuTimer(aura_env.kite, aura_env.cdWindow, aura_env.kiteCount)\n            return true\n        end\n    end\nend",
