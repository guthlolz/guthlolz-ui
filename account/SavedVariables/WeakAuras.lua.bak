["custom"] = "aura_env.key = \"VASHJ_STRIDER\"\naura_env.count = 1\naura_env.cdStart = 63\naura_env.cdWindow = 63\n\nfunction aura_env.nuTimer(countdown, count)\n    WeakAuras.ScanEvents(\"WA_NUMEN_TIMER\", aura_env.key, countdown, count)\nend\n\nfunction aura_env.updateState(allstates)\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n    }\nend\n\nfunction aura_env.hideState(allstates)\n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\nend\n\nfunction aura_env.preWarn(duration, preWarnTime, count)\n    if not preWarnTime then\n        preWarnTime = 3\n    end\n    \n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\n    \n    aura_env.preWarnTimer = C_Timer.NewTimer(duration - preWarnTime, function()\n            WeakAuras.ScanEvents(\"WA_\" .. aura_env.key .. \"_PREWARN\", preWarnTime, count)\n            aura_env.preWarnTimer = nil\n    end)\nend\n\nfunction aura_env.preWarnCancel()\n    WeakAuras.ScanEvents(\"WA_\" .. aura_env.key .. \"_PREWARN_CANCEL\")\n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\nend\n\nfunction aura_env.scheduleTimer(duration)\n    if aura_env.timer then\n        aura_env.timer:Cancel()\n        aura_env.timer = nil\n    end\n    \n    aura_env.timer = C_Timer.NewTimer(duration, function()\n            WeakAuras.ScanEvents(\"WA_VASHJ_STRIDER_SPAWN\")\n    end)\nend\n\nfunction aura_env.cancelTimer()\n    if aura_env.timer then\n        aura_env.timer:Cancel()\n        aura_env.timer = nil\n    end\nend",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates,event)\n    if event == \"WA_VASHJ_P2_START\" then\n        aura_env.updateState(allstates)\n        aura_env.count = 1\n        \n        aura_env.scheduleTimer(aura_env.cdStart)\n        aura_env.preWarn(aura_env.cdStart, 5, aura_env.count)\n        aura_env.nuTimer(aura_env.cdStart, aura_env.count)\n        return true\n        \n    elseif event == \"WA_FJI_ENCOUNTER_END\" or event == \"ENCOUNTER_END\" or event == \"WA_VASHJ_P3_START\" then\n        aura_env.cancelTimer()\n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        return true\n    end\n    \n    if event == \"WA_VASHJ_STRIDER_SPAWN\" then\n        aura_env.nuTimer(0, aura_env.count)\n        aura_env.count = aura_env.count + 1\n        \n        aura_env.scheduleTimer(aura_env.cdWindow)\n        aura_env.preWarn(aura_env.cdWindow, 5, aura_env.count)\n        aura_env.nuTimer(aura_env.cdWindow, aura_env.count)\n        return true\n    end\nend",
["spellIds"] = {
},
