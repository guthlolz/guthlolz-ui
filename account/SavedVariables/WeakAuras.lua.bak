["custom"] = "",
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.duration = 30\naura_env.batchWindow = 0.1\n\naura_env.guids = {}\naura_env.pendingGuids = {}\naura_env.names = {}\naura_env.numbers = {}\naura_env.nextNumber = 1\naura_env.resetLocked = false\n\nfunction aura_env.scheduleReset(time)\n    if aura_env.resetLocked then\n        return\n    end\n    \n    aura_env.resetLocked = true\n    \n    aura_env.timer = C_Timer.NewTimer(time, function()\n            aura_env.timer = nil\n            WeakAuras.ScanEvents(\"WA_FJI_NP_NUMBER_RESET\")\n    end)\nend\n\nfunction aura_env.scheduleBatch()\n    if aura_env.batchTimer then\n        aura_env.batchTimer:Cancel()\n        aura_env.batchTimer = nil\n    end\n    \n    aura_env.batchTimer = C_Timer.NewTimer(aura_env.batchWindow, function()\n            aura_env.batchTimer = nil\n            WeakAuras.ScanEvents(\"WA_FJI_NP_NUMBER_BATCH\")\n    end)\nend\n\nfunction aura_env.getNameFromGUID(guid)\n    for unit in WA_IterateGroupMembers() do\n        if UnitGUID(unit) == guid then\n            return UnitName(unit)\n        end\n    end\nend\n\nfunction aura_env.assignPendingNumbers()\n    local sorted = {}\n    \n    for guid in pairs(aura_env.pendingGuids) do\n        if not aura_env.numbers[guid] then\n            local name = aura_env.names[guid] or aura_env.getNameFromGUID(guid)\n            \n            if name then\n                aura_env.names[guid] = name\n                sorted[#sorted + 1] = {\n                    guid = guid,\n                    name = name,\n                }\n            end\n        end\n    end\n    \n    table.sort(sorted, function(a, b)\n            return a.name < b.name\n    end)\n    \n    for _, data in ipairs(sorted) do\n        aura_env.numbers[data.guid] = aura_env.nextNumber\n        aura_env.nextNumber = aura_env.nextNumber + 1\n    end\n    \n    wipe(aura_env.pendingGuids)\nend\n\nfunction aura_env.showState(allstates, guid, unit)\n    local number = aura_env.numbers[guid]\n    if not number then return end\n    \n    allstates[guid] = {\n        show = true,\n        changed = true,\n        progressType = \"timed\",\n        duration = aura_env.duration,\n        expirationTime = GetTime() + aura_env.duration,\n        autoHide = true,\n        unit = unit,\n        number = number,\n    }\nend\n\nfunction aura_env.showVisibleNameplates(allstates)\n    for _, plate in ipairs(C_NamePlate.GetNamePlates()) do\n        local unit = plate.namePlateUnitToken\n        local guid = UnitGUID(unit)\n        \n        if guid and aura_env.guids[guid] then\n            aura_env.showState(allstates, guid, unit)\n        end\n    end\nend",
["do_custom"] = true,
},
},
