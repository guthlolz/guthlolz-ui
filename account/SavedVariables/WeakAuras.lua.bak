["actions"] = {
["start"] = {
},
["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.encounterActive = false\naura_env.encounterID = 608\n\naura_env.preferredType = nil\naura_env.currentType = nil\naura_env.bopActive = false\naura_env.wardingActive = false\n\naura_env.physicalPlayers = {}\naura_env.magicalPlayers = {}\naura_env.notifiedType = nil\n\nfunction aura_env.GetPlayers(assignmentType)\n    if assignmentType == \"PHYSICAL\" then\n        return aura_env.physicalPlayers\n    elseif assignmentType == \"MAGICAL\" then\n        return aura_env.magicalPlayers\n    end\nend\n\nfunction aura_env.ParsePlayers(playerText,list)\n    wipe(list)\n    \n    if not playerText or playerText == \"\" then\n        return\n    end\n    \n    for _,name in ipairs({ strsplit(\",\",playerText) }) do\n        name = strtrim(name)\n        \n        if name ~= \"\" then\n            tinsert(list,name)\n        end\n    end\nend\n\nfunction aura_env.IsPlayerAssigned(assignmentType)\n    local players = aura_env.GetPlayers(assignmentType)\n    \n    if not players then\n        return false\n    end\n    \n    for _,name in ipairs(players) do\n        if name == WeakAuras.me then\n            return true\n        end\n    end\n    return false\nend\n\nfunction aura_env.SendNext(assignmentType)\n    if aura_env.IsPlayerAssigned(assignmentType) then\n        WeakAuras.ScanEvents(\"WA_COUNCIL_COH_KICK_NEXT\")\n        aura_env.notifiedType = assignmentType\n    end\nend\n\nfunction aura_env.SendNow(assignmentType,castTime)\n    if aura_env.IsPlayerAssigned(assignmentType) then\n        WeakAuras.ScanEvents(\"WA_COUNCIL_COH_KICK_NOW\",castTime)\n        aura_env.notifiedType = assignmentType\n    end\nend\n\nfunction aura_env.SendCancel(assignmentType)\n    if aura_env.IsPlayerAssigned(assignmentType) then\n        WeakAuras.ScanEvents(\"WA_COUNCIL_COH_KICK_CANCEL\")\n    end\n    \n    if aura_env.notifiedType == assignmentType then\n        aura_env.notifiedType = nil\n    end\nend\n\nfunction aura_env.UpdateDisplay(states,dispatchFlip)\n    local assignmentType\n    \n    if aura_env.bopActive then\n        assignmentType = \"MAGICAL\"\n    elseif aura_env.wardingActive then\n        assignmentType = \"PHYSICAL\"\n    else\n        assignmentType = aura_env.preferredType\n    end\n    \n    local previousType = aura_env.currentType\n    aura_env.currentType = assignmentType\n    \n    if dispatchFlip and aura_env.encounterActive and previousType and assignmentType and previousType ~= assignmentType then\n        aura_env.SendCancel(previousType)\n        aura_env.SendNext(assignmentType)\n    end\n    \n    if not assignmentType or not aura_env.encounterActive then\n        if states[\"\"] then\n            states[\"\"].show = false\n            states[\"\"].changed = true\n        end\n        return\n    end\n    \n    states[\"\"] = {\n        show = true,\n        changed = true,\n        type = assignmentType,\n        progressType = \"static\",\n        value = 1,\n        total = 1,\n        icon = 135943\n    }\nend\n\nfunction aura_env.Reset(states)\n    if aura_env.notifiedType then\n        aura_env.SendCancel(aura_env.notifiedType)\n    end\n    \n    aura_env.encounterActive = false\n    aura_env.currentType = nil\n    aura_env.notifiedType = nil\n    aura_env.bopActive = false\n    aura_env.wardingActive = false\n    \n    if states[\"\"] then\n        states[\"\"].show = false\n        states[\"\"].changed = true\n    end\nend",
},
["finish"] = {
},
},
