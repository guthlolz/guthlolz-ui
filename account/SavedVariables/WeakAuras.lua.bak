["event"] = "Health",
["unit"] = "player",
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 15,\n            expirationTime = GetTime() + 15,\n            autoHide = true,\n            icon = 136144,\n            status = \"Channel\",\n        }\n        return true\n    end\n    \n    if event == \"WA_NUMEN_TIMER\" then\n        local key, time, count = ...\n        \n        if key == \"WINTERCHILL_DEATH\" then\n            if time == 0 then\n                C_VoiceChat.SpeakText(_G.FJITTS_SFX_VOICEID, \"Death and Decay\", _G.FJITTS_SFX_RATE, _G.FJITTS_SFX_VOLUME, true)\n                allstates[\"\"] = {\n                    show = true,\n                    changed = true,\n                    progressType = \"timed\",\n                    duration = 1,\n                    expirationTime = GetTime() + 1,\n                    autoHide = true,\n                    icon = 136144,\n                    status = \"Cast\",\n                }\n                return true\n            elseif time == nil then\n                if allstates[\"\"] then\n                    allstates[\"\"].show = false\n                    allstates[\"\"].changed = true\n                    return true\n                end\n            end\n        end\n    elseif event == \"WA_WINTERCHILL_DEATH_DECAY_CHANNEL\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 15,\n            expirationTime = GetTime() + 15,\n            autoHide = true,\n            icon = 136144,\n            status = \"Channel\",\n        }\n        return true\n    end\nend",
