["custom"] = "aura_env.colorFojji = \"|TInterface\\\\AddOns\\\\FojjiCore\\\\textures\\\\F_icon_teal.png:16:16:0:0|t\"\naura_env.colorRAID = \"|cff9955ffT6|r\"",
},
["finish"] = {
