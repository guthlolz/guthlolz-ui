["wagoID"] = "sGScXfEv2",
["parent"] = "Pretty Tankadin 2",
["customText"] = "function()\n    local function round(num, idp)\n        local mult = 10 ^ (idp or 0)\n        return math.floor(num * mult + 0.5) / mult\n    end\n    \n    local _, effectiveArmor = UnitArmor(\"player\")\n    local armor = tonumber(effectiveArmor) or 0\n    \n    local dr = armor / (armor + (467.5 * 73 - 22167.5))\n    if dr < 0 then dr = 0 end\n    if dr > 0.75 then dr = 0.75 end\n    \n    local irfName = GetSpellInfo(25780)\n    if AuraUtil.FindAuraByName(irfName, \"player\", \"HELPFUL\") then\n        local _, _, _, _, currRank, _ = GetTalentInfo(2, 7)\n        dr = 1 - (1 - dr) * (1 - 0.02 * currRank)\n        if dr > 0.75 then dr = 0.75 end\n    end\n    \n    local drPercent = round(dr * 100, 2)\n    \n    -- Color: green at 75% cap, yellow approaching, red low\n    if drPercent >= 75 then\n        return string.format(\"|cff00ff00%.2f%%|r\", drPercent)\n    elseif drPercent >= 70 then\n        return string.format(\"|cffffff00%.2f%%|r\", drPercent)\n    else\n        return string.format(\"|cffff0000%.2f%%|r\", drPercent)\n    end\nend",
