["wagoID"] = "pbbuhQ899",
["parent"] = "[BT]: Lists",
["displayText_format_p_time_precision"] = 1,
["adjustedMin"] = "",
["shadowYOffset"] = -1,
["sparkHeight"] = 30,
["desaturateBackground"] = false,
["cooldownSwipe"] = true,
["cooldownEdge"] = false,
["sparkRotationMode"] = "AUTO",
["automaticWidth"] = "Auto",
["desaturateForeground"] = false,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "{\n    isTarget = \"bool\",\n    spell = \"string\",\n}",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "CLEU:SPELL_CAST_SUCCESS:SPELL_CAST_START:UNIT_DIED, PLAYER_TARGET_CHANGED, PLAYER_REGEN_ENABLED",
["spellIds"] = {
},
["custom"] = "function(allstates,event,_,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId)\n    if event == \"OPTIONS\" then\n        local randomSpell = aura_env.optionSpells[math.random(#aura_env.optionSpells)]\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = aura_env.duration,\n            expirationTime = GetTime() + aura_env.duration,\n            autoHide = true,\n            isTarget = false,\n            spell = randomSpell.spell,\n            icon = randomSpell.icon,\n        }\n        return true\n    end\n    \n    if event == \"PLAYER_REGEN_ENABLED\" then\n        for _,state in pairs(allstates) do\n            state.show = false\n            state.changed = true\n            state.isTarget = false\n        end\n        \n        wipe(aura_env.detectedMobs)\n        wipe(aura_env.seen)\n        return true\n    end\n    \n    if event == \"PLAYER_TARGET_CHANGED\" or event == \"STATUS\" then\n        local targetGUID = UnitExists(\"target\") and UnitGUID(\"target\")\n        \n        for guid,state in pairs(allstates) do\n            local isTarget = targetGUID and guid == targetGUID or false\n            if state.isTarget ~= isTarget then\n                state.isTarget = isTarget\n                state.changed = true\n            end\n        end\n        \n        if targetGUID and aura_env.detectedMobs[targetGUID] and not allstates[targetGUID] then\n            local detectedData = aura_env.detectedMobs[targetGUID]\n            \n            allstates[targetGUID] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = aura_env.duration,\n                expirationTime = GetTime() + aura_env.duration,\n                autoHide = true,\n                isTarget = true,\n                spell = detectedData.spell,\n                icon = detectedData.icon,\n            }\n            \n            return true\n        end\n        \n        return true\n    end\n    \n    if subEvent == \"UNIT_DIED\" then\n        if allstates[destGUID] then\n            allstates[destGUID].show = false\n            allstates[destGUID].changed = true\n            allstates[destGUID].isTarget = false\n        end\n        \n        if destGUID then\n            aura_env.detectedMobs[destGUID] = nil\n            aura_env.seen[destGUID] = nil\n        end\n        \n        return true\n    end\n    \n    local spellType = aura_env.spells[subEvent]\n    if not spellType then\n        return false\n    end\n    \n    local spellData = spellType[spellId]\n    if not spellData then\n        return false\n    end\n    \n    local npcID = select(6,strsplit(\"-\",sourceGUID or \"\"))\n    if npcID ~= aura_env.npcID then\n        return false\n    end\n    \n    aura_env.detectedMobs[sourceGUID] = {\n        spell = spellData.spell,\n        icon = spellData.icon,\n    }\n    \n    allstates[sourceGUID] = {\n        show = true,\n        changed = true,\n        progressType = \"timed\",\n        duration = aura_env.duration,\n        expirationTime = GetTime() + aura_env.duration,\n        autoHide = true,\n        isTarget = UnitExists(\"target\") and UnitGUID(\"target\") == sourceGUID,\n        spell = spellData.spell,\n        icon = spellData.icon,\n    }\n    \n    if not aura_env.seen[sourceGUID] then\n        aura_env.seen[sourceGUID] = true\n        WeakAuras.ScanEvents(\"WA_BEHEMOTH_ABILITIES_DETECT\",spellData.spell,sourceGUID,spellId)\n    end\n    \n    return true\nend",
