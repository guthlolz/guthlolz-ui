["triggers"] = {
{
["trigger"] = {
["customVariables"] = "{\n    next = \"bool\",\n}",
["type"] = "custom",
["custom_type"] = "stateupdate",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["unit"] = "player",
["event"] = "Health",
["names"] = {
},
["useName"] = true,
["custom"] = "function(a,e,...)\n    if e == \"OPTIONS\" then\n        local next = math.random(2) == 1\n        \n        a[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = next and \"static\" or \"timed\",\n            value = next and 1 or nil,\n            total = next and 1 or nil,\n            duration = not next and 2 or nil,\n            expirationTime = not next and GetTime() + 2 or nil,\n            autoHide = false,\n            next = next,\n            icon = aura_env.icon,\n        }\n        return true\n    end\n    \n    if e == \"WA_RELIQUARY_PLAYER_KICK_NEXT\" then\n        a[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"static\",\n            value = 1,\n            total = 1,\n            next = true,\n            icon = aura_env.icon,\n        }\n        return true\n    end\n    \n    if e == \"WA_RELIQUARY_PLAYER_KICK_NOW\" then\n        local castTime = ...\n        if not castTime then return false end\n        \n        C_VoiceChat.SpeakText(_G.FJITTS_SFX_VOICEID, \"Kick\", _G.FJITTS_SFX_RATE, _G.FJITTS_SFX_VOLUME, true)\n        \n        a[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = castTime,\n            expirationTime = GetTime() + castTime,\n            autoHide = true,\n            next = false,\n            icon = aura_env.icon,\n        }\n        return true\n    end\n    \n    if e == \"WA_RELIQUARY_SS_SUCCESS\" or e == \"WA_RELIQUARY_SS_INTERRUPT\" or e == \"WA_RELIQUARY_P2_END\" then\n        if a[\"\"] then\n            a[\"\"].show = false\n            a[\"\"].changed = true\n            return true\n        end\n    end\n    \n    return false\nend",
["spellIds"] = {
},
["events"] = "WA_RELIQUARY_PLAYER_KICK_NEXT WA_RELIQUARY_PLAYER_KICK_NOW WA_RELIQUARY_SS_SUCCESS WA_RELIQUARY_SS_INTERRUPT WA_RELIQUARY_P2_END",
