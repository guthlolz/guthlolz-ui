["names"] = {
},
["event"] = "Health",
["unit"] = "player",
["subeventSuffix"] = "_CAST_START",
["spellIds"] = {
},
["custom"] = "function(allstates, event)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 35,\n            expirationTime = GetTime() + 35,\n            progressType = \"timed\",\n            icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\illidan.jpg\",\n            autoHide = true,\n        }\n        return true\n    end\n    \n    if event == \"WA_ILLIDAN_P3_END\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 35,\n            expirationTime = GetTime() + 35,\n            progressType = \"timed\",\n            icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\illidan.jpg\",\n            autoHide = true,\n        }\n        return true\n    end\nend",
["events"] = "WA_ILLIDAN_P3_END",
["check"] = "event",
["subeventPrefix"] = "SPELL",
["debuffType"] = "HELPFUL",
["customVariables"] = "{\n    expirationTime = true,\n}",
},
["untrigger"] = {
