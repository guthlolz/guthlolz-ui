["CT:[BT][Trash] Tail Sweep (Leviathan)"] = {
["outline"] = "OUTLINE",
["wagoID"] = "pbbuhQ899",
["parent"] = "[BT][Trash]",
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiBT-P1/12",
["actions"] = {
["start"] = {
["do_glow"] = false,
["sound"] = "Interface\\Addons\\FojjiCore\\sound\\fojjiSnap.ogg",
["do_custom"] = false,
["do_sound"] = false,
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.key = \"TRASH_LEVIATHAN_TAILSWEEP\"\naura_env.cdStart = 10\naura_env.cdWindow = 11\naura_env.spellID = 40077\naura_env.npcId = \"22884\"\naura_env.allow = true\naura_env.debug = false\n\naura_env.spellName = GetSpellInfo(aura_env.spellID)\n\naura_env.count = {}\naura_env.guids = {}\naura_env.firstSeen = {}\naura_env.lastCast = {}\n\nfunction aura_env.debugPrint(msg)\n    if aura_env.debug then\n        print(\"|cff3399ffFojji|r \"..msg)\n    end\nend\n\nfunction aura_env.nuTimer(countdown,count,guid)\n    WeakAuras.ScanEvents(\"WA_NUMEN_TIMER\",aura_env.key,countdown,count,guid)\nend\n\nfunction aura_env.updateState(allstates)\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n    }\nend\n\nfunction aura_env.hideState(allstates)\n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "for guid in pairs(aura_env.count) do\n    aura_env.nuTimer(nil, nil, guid)\nend\naura_env.count = {}\naura_env.guids = {}\naura_env.firstSeen = {}\naura_env.lastCast = {}",
["do_sound"] = false,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
["do_message"] = false,
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "CLEU:SPELL_CAST_SUCCESS:SPELL_DAMAGE:RANGE_DAMAGE:UNIT_DIED",
["spellIds"] = {
},
["custom"] = "function(allstates,event,...)\n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local _,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId = ...\n        \n        if subEvent == \"SPELL_DAMAGE\" or subEvent == \"RANGE_DAMAGE\" then\n            local npcID = select(6,strsplit(\"-\",destGUID))\n            \n            if npcID == aura_env.npcId then\n                if not aura_env.count[destGUID] then\n                    aura_env.firstSeen[destGUID] = GetTime()\n                    aura_env.updateState(allstates)\n                    aura_env.count[destGUID] = 1\n                    aura_env.nuTimer(aura_env.cdStart,aura_env.count[destGUID],destGUID)\n                    return true\n                end\n            end\n        end\n        \n        if subEvent == \"UNIT_DIED\" then\n            local npcID = select(6,strsplit(\"-\",destGUID))\n            if npcID == aura_env.npcId then\n                aura_env.guids[destGUID] = nil\n                aura_env.count[destGUID] = nil\n                aura_env.firstSeen[destGUID] = nil\n                aura_env.lastCast[destGUID] = nil\n                aura_env.nuTimer(nil,nil,destGUID)\n                return true\n            end\n        end\n        \n        if spellId ~= aura_env.spellID then\n            return false\n        end\n        \n        if subEvent == \"SPELL_CAST_SUCCESS\" then\n            if not aura_env.count[sourceGUID] then\n                return false\n            end\n            \n            local now = GetTime()\n            local count = aura_env.count[sourceGUID] or 1\n            \n            if aura_env.lastCast[sourceGUID] then\n                aura_env.debugPrint(string.format(\"NPC %s - %s (%d): %.1fs after previous.\",aura_env.npcId,aura_env.spellName,count,now-aura_env.lastCast[sourceGUID]))\n            elseif aura_env.firstSeen[sourceGUID] then\n                aura_env.debugPrint(string.format(\"NPC %s - First %s (%d): %.1fs after detection.\",aura_env.npcId,aura_env.spellName,count,now-aura_env.firstSeen[sourceGUID]))\n            end\n            \n            aura_env.lastCast[sourceGUID] = now\n            \n            aura_env.updateState(allstates)\n            aura_env.nuTimer(0,count,sourceGUID)\n            aura_env.count[sourceGUID] = count+1\n            aura_env.nuTimer(aura_env.cdWindow,aura_env.count[sourceGUID],sourceGUID)\n            return true\n        end\n    end\nend",
["check"] = "event",
["subeventPrefix"] = "SPELL",
["custom_hide"] = "timed",
["debuffType"] = "HELPFUL",
},
