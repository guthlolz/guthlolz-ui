},
["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.key = \"ILLIDARI_AURA\"\n\naura_env.auras = {\n    [41453] = {\n        name = \"Chromatic\",\n        icon = GetSpellTexture(41453),\n    },\n    [41452] = {\n        name = \"Devotion\",\n        icon = GetSpellTexture(41452),\n    },\n}",
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["useStacks"] = false,
["useGroup_count"] = true,
["subeventPrefix"] = "SPELL",
["stacks"] = "",
["group_count"] = "0",
["unit"] = "player",
["group_countOperator"] = ">",
["debuffType"] = "HARMFUL",
["names"] = {
},
["useName"] = true,
["stacksOperator"] = "<",
["custom_type"] = "stateupdate",
["custom_hide"] = "timed",
["type"] = "custom",
["event"] = "Health",
["spellIds"] = {
},
["useExactSpellId"] = false,
["auraspellids"] = {
},
["events"] = "OPTIONS WA_NUMEN_TIMER",
["custom"] = "function(allstates,event,key,time,count,spellId)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 30,\n            expirationTime = GetTime() + 30,\n            autoHide = true,\n            name = \"Devotion\",\n            icon = GetSpellTexture(41452),\n        }\n        return true\n    end\n    \n    if event ~= \"WA_NUMEN_TIMER\" or key ~= aura_env.key then\n        return false\n    end\n    \n    if time == nil then\n        if allstates[\"\"] then\n            allstates[\"\"].show = false\n            allstates[\"\"].changed = true\n            return true\n        end\n        return false\n    end\n    \n    local aura = spellId and aura_env.auras[spellId]\n    if not aura then\n        return false\n    end\n    \n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n        progressType = \"timed\",\n        duration = time,\n        expirationTime = GetTime() + time,\n        autoHide = true,\n        name = aura.name,\n        icon = aura.icon,\n    }\n    return true\nend",
