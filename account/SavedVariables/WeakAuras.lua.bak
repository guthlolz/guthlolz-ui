["[RAIDLEAD][T5][Kaelthas] AutoMark Gaze"] = {
["outline"] = "OUTLINE",
["wagoID"] = "gSs1_GQRl",
["parent"] = "[T5]: AutoMarking",
["displayText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiT5RaidPack/3",
["actions"] = {
["start"] = {
["custom"] = "if not aura_env.config.group.option.enable then\n    return false\nend\n\nif aura_env.state and aura_env.state.unit then\n    local unit = aura_env.state.unit\n    local currentMark = GetRaidTargetIndex(unit)\n    \n    if currentMark and currentMark > 0 then\n        aura_env.originalMarks[unit] = currentMark\n    end\n    \n    local first = aura_env.config.group.option.firstMark\n    local chosenMark\n    if first and aura_env.marks[first] then\n        chosenMark = first\n    end\n    \n    if chosenMark then\n        SetRaidTarget(unit, chosenMark)\n        local icon = \"|TInterface/TargetingFrame/UI-RaidTargetingIcon_\" .. chosenMark .. \":14:14|t\"\n        print(aura_env.colorFojji .. aura_env.colorRAID .. \" - Marked \" .. (UnitName(unit) or unit) .. \" with \" .. icon)\n        aura_env.marks[chosenMark] = false\n    end\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "if not aura_env.config.group.option.enable then\n    return false\nend\n\nif aura_env.state and aura_env.state.unit then\n    local unit = aura_env.state.unit\n    local currentMark = GetRaidTargetIndex(unit)\n    \n    if currentMark and aura_env.marks[currentMark] == false then\n        aura_env.marks[currentMark] = true\n    end\n    \n    if aura_env.originalMarks[unit] then\n        SetRaidTarget(unit, aura_env.originalMarks[unit])\n        aura_env.originalMarks[unit] = nil\n    else\n        SetRaidTarget(unit, 0)\n    end\nend",
["do_custom"] = true,
},
["init"] = {
["custom"] = "aura_env.colorFojji = \"|cff3399ffFojji|r\"\naura_env.colorRAID = \"|cff9955ffT5|r\"\n\naura_env.marks = {}\naura_env.originalMarks = {}\n\nif aura_env.config.group.option.enable then\n    for key, mark in pairs(aura_env.config.group.option) do\n        if key:find(\"Mark\") and mark then\n            aura_env.marks[mark] = true\n        end\n    end\nend",
["do_custom_unload"] = false,
["customOnUnload"] = "",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["custom_hide"] = "timed",
["event"] = "Health",
["names"] = {
},
["subeventSuffix"] = "_CAST_START",
["spellIds"] = {
},
["events"] = "WA_THALADRED_GAZE_TARGET WA_KAELTHAS_THALADRED_DIED",
["subeventPrefix"] = "SPELL",
["check"] = "event",
["custom"] = "function(allstates, event, ...)\n    if event == \"WA_THALADRED_GAZE_TARGET\" then\n        local name = ...\n        allstates[name] = {\n            show = true,\n            changed = true,\n            unit = name,\n        }\n        return true\n    end\n    \n    if event == \"WA_KAELTHAS_THALADRED_DIED\" then\n        for _, state in pairs(allstates) do\n            state.show = false\n            state.changed = true\n        end\n        return true\n    end\nend",
["unit"] = "player",
["debuffType"] = "HELPFUL",
