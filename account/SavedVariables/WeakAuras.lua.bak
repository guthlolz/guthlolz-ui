},
["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.detectedMobs = {}\naura_env.seen = {}\n\naura_env.npcID = \"23196\"\naura_env.duration = 30\n\naura_env.spells = {\n    SPELL_CAST_SUCCESS = {\n        [41272] = {\n            spell = \"Charge / Stomp\",\n            icon = 132337,\n        },\n        [41274] = {\n            spell = \"Charge / Stomp\",\n            icon = 132337,\n        },\n    },\n    SPELL_CAST_START = {\n        [41276] = {\n            spell = \"Meteor / Comet\",\n            icon = 135808,\n        },\n        [41277] = {\n            spell = \"Meteor / Comet\",\n            icon = 135808,\n        },\n    },\n}\n\naura_env.optionSpells = {\n    {\n        spell = \"Charge / Stomp\",\n        icon = 132337,\n    },\n    {\n        spell = \"Meteor / Comet\",\n        icon = 135808,\n    },\n}",
},
