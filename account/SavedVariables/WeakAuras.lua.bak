true, -- R10\n        \n        -- Lifebloom\n        [33763] = true, -- R1\n        \n        -- Starfire\n        [2912] = true, -- R1\n        [8949] = true, -- R2\n        [8950] = true, -- R3\n        [8951] = true, -- R4\n        [9875] = true, -- R5\n        [9876] = true, -- R6\n        [25298] = true, -- R7\n        [26986] = true, -- R8\n        \n        -- Wrath\n        [5176] = true, -- R1\n        [5177] = true, -- R2\n        [5178] = true, -- R3\n        [5179] = true, -- R4\n        [5180] = true, -- R5\n        [6780] = true, -- R6\n        [8905] = true, -- R7\n        [9912] = true, -- R8\n        [26984] = true, -- R9\n        [26985] = true, -- R10\n    }\nelseif class == \"PRIEST\" then\n    aura_env.spells = {\n        -- Renew\n        [139] = true, -- R1\n        [6074] = true, -- R2\n        [6075] = true, -- R3\n        [6076] = true, -- R4\n        [6077] = true, -- R5\n        [6078] = true, -- R6\n        [10927] = true, -- R7\n        [10928] = true, -- R8\n        [10929] = true, -- R9\n        [25315] = true, -- R10\n        [25221] = true, -- R11\n        [25222] = true, -- R12\n        \n        -- Flash Heal\n        [2061] = true, -- R1\n        [9472] = true, -- R2\n        [9473] = true, -- R3\n        [9474] = true, -- R4\n        [10915] = true, -- R5\n        [10916] = true, -- R6\n        [10917] = true, -- R7\n        [25233] = true, -- R8\n        [25235] = true, -- R9\n        [48070] = true, -- R10\n        \n        -- Greater Heal\n        [2060] = true, -- R1\n        [10963] = true, -- R2\n        [10964] = true, -- R3\n        [10965] = true, -- R4\n        [25314] = true, -- R5\n        [25210] = true, -- R6\n        [48071] = true, -- R7\n        \n        -- Prayer of Healing\n        [596] = true, -- R1\n        [996] = true, -- R2\n        [10960] = true, -- R3\n        [10961] = true, -- R4\n        [25316] = true, -- R5\n        [25308] = true, -- R6\n        [48072] = true, -- R7\n        \n        -- Cir