["events"] = "WA_GURTOGG_BLOODBOIL_SOAK_NEXT WA_GURTOGG_BLOODBOIL_SOAK WA_GURTOGG_BLOODBOIL_STOP WA_GURTOGG_RAGE_PHASE OPTIONS",
["spellIds"] = {
},
["custom"] = "function(allstates,event,...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"static\",\n            value = 1,\n            total = 1,\n            soak = true,\n            stop = false,\n            raidMark = \"{rt4}\",\n        }\n        return true\n    end\n    \n    if event == \"WA_GURTOGG_BLOODBOIL_SOAK\" then\n        local time,_,raidMark = ...\n        \n        C_VoiceChat.SpeakText(_G.FJITTS_SFX_VOICEID,\"Soak\",_G.FJITTS_SFX_RATE,_G.FJITTS_SFX_VOLUME,true)\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"static\",\n            value = 1,\n            total = 1,\n            soak = true,\n            stop = false,\n            time = time,\n        }\n        \n        if raidMark and raidMark ~= \"\" then\n            allstates[\"\"].raidMark = raidMark\n        end\n        \n        return true\n    end\n    \n    if event == \"WA_GURTOGG_BLOODBOIL_STOP\" then\n        C_VoiceChat.SpeakText(_G.FJITTS_SFX_VOICEID,\"Stop Soaking\",_G.FJITTS_SFX_RATE,_G.FJITTS_SFX_VOLUME,true)\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 3,\n            expirationTime = GetTime() + 3,\n            autoHide = true,\n            soak = false,\n            stop = true,\n        }\n        return true\n    end\n    \n    if event == \"WA_GURTOGG_RAGE_PHASE\" then\n        local state = allstates[\"\"]\n        \n        if state then\n            state.show = false\n            state.changed = true\n            state.soak = false\n            state.stop = false\n            return true\n        end\n    end\n    \n    return false\nend",
