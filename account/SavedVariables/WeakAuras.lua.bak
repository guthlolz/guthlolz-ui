["customIcon"] = "function()\n    local poisonIcons = {\n        [323]  = 132273,  -- Instant Poison\n        [324]  = 132273,  -- Instant Poison II\n        [325]  = 132273,  -- Instant Poison III\n        [623]  = 132273,  -- Instant Poison IV\n        [624]  = 132273,  -- Instant Poison V\n        [625]  = 132273,  -- Instant Poison VI\n        [2641] = 132273,  -- Instant Poison VII\n        [3768] = 132273,  -- Instant Poison VIII\n        [3769] = 132273,  -- Instant Poison IX\n        [22]   = 132274,  -- Crippling Poison\n        [603]  = 132274,  -- Criplling Poison II\n        [35]   = 136066,  -- Mind-numbing Poison\n        [23]   = 136066,  -- Mind-numbing Poison II\n        [643]  = 136066,  -- Mind-numbing Poison III\n        [7]    = 132290,  -- Deadly Poison \n        [8]    = 132290,  -- Deadly Poison II\n        [626]  = 132290,  -- Deadly Poison III\n        [627]  = 132290,  -- Deadly Poison IV\n        [2630] = 132290,  -- Deadly Poison V\n        [2642] = 132290,  -- Deadly Poison VI\n        [2643] = 132290,  -- Deadly Poison VII\n        [3770 ] = 132290,  -- Deadly Poison VIII\n        [3771 ] = 132290,  -- Deadly Poison IX\n        [703]  = 134197,  -- Wound Poison \n        [704]  = 134197,  -- Wound Poison II\n        [705]  = 134197,  -- Wound Poison III\n        [706]  = 134197,  -- Wound Poison IV  \n        [2644] = 134197,  -- Wound Poison V\n        [3772 ] = 134197,  -- Wound Poison VI\n        [3773 ] = 134197,  -- Wound Poison VII\n        [2640] = 136093,  -- Anesthetic Poison\n        [3774] = 136093,  -- Anesthetic Poison II\n        [1783] = 136114,  -- Windfury Totem 1        \n        [563]  = 136114,  -- Windfury Totem 2       \n        [564]  = 136114,  -- Windfury Totem 3 \n        [2638] = 136114,  -- Windfury Totem 4\n        [2639] = 136114,  -- Windfury Totem 5\n        [40]   = 135248,  -- Rough Sharpening Stone\n        [13]   = 135249,  -- Coarse Sharpening Stone\n        [14]   = 135250,  -- Heavy Sharpening Stone\n        [483]  = 135251,  -- Solid Sharpening Stone\n        [1643] = 135252,  -- Dense Sharpening Stone      \n        [2506] = 135228,  -- Elemental Sharpening Stone\n        [2712] = 135253,  -- Fel Sharpening Stone\n        [2713] = 135254,  -- Adamantite Sharpening Stone\n        [26]   = 134800,  -- Frost Oil\n        [2684] = 135249   -- Consecrated Sharpening Stone\n    }\n\n    if (aura_env.offHandEnchantID) then\n        return poisonIcons[aura_env.offHandEnchantID]\n    else    \n        return 136242     -- Missing Poison Icon\n    end\nend",
["debuffType"] = "HELPFUL",
