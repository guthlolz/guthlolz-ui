["CT:[BT][Illidan] Demon"] = {
["outline"] = "OUTLINE",
["wagoID"] = "pbbuhQ899",
["parent"] = "[BT][Illidan]",
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiBT-P1/12",
["actions"] = {
["start"] = {
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.inDemonForm = false\naura_env.debug = false\naura_env.key = \"ILLIDAN_DEMON_FORM\"\naura_env.count = 1\naura_env.cdStartP3 = 78\naura_env.cdStartP4 = 65\naura_env.cdWindow = 60\naura_env.preWarnTime = 3\naura_env.throttle = 0\n\naura_env.encounterID = 609\n\naura_env.pullStart = nil\naura_env.lastCast = nil\naura_env.nextDemonForm = nil\n\nfunction aura_env.debugPrint(message)\n    if aura_env.debug then\n        print(message)\n    end\nend\n\nfunction aura_env.nuTimer(countdown,count)\n    WeakAuras.ScanEvents(\"WA_NUMEN_TIMER\",aura_env.key,countdown,count)\nend\n\nfunction aura_env.updateState(allstates)\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n    }\nend\n\nfunction aura_env.hideState(allstates)\n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\nend\n\nfunction aura_env.preWarn(duration,preWarnTime,count)\n    preWarnTime = preWarnTime or 3\n    \n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\n    \n    aura_env.preWarnTimer = C_Timer.NewTimer(duration-preWarnTime,function()\n            WeakAuras.ScanEvents(\"WA_\"..aura_env.key..\"_PREWARN\",preWarnTime,count)\n            aura_env.preWarnTimer = nil\n    end)\nend\n\nfunction aura_env.preWarnCancel()\n    WeakAuras.ScanEvents(\"WA_\"..aura_env.key..\"_PREWARN_CANCEL\")\n    \n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\nend\n\nfunction aura_env.startTimer(duration)\n    aura_env.nextDemonForm = GetTime()+duration\n    \n    aura_env.preWarnCancel()\n    aura_env.nuTimer(nil)\n    \n    aura_env.preWarn(duration,aura_env.preWarnTime,aura_env.count)\n    aura_env.nuTimer(duration,aura_env.count)\nend\n\nlocal locale = GetLocale()\n\naura_env.locales = {\n    [\"enUS\"] = {\n        demon = \"Behold the power... of the demon within!\",\n    },\n    [\"frFR\"] = {\n        demon = \"Contemplez la puissance... du démon intérieur !\",\n    },\n    [\"deDE\"] = {\n        demon = \"Erzittert vor der Macht des Dämonen!\",\n    },\n    [\"esES\"] = {\n        demon = \"¡Observad el poder...del demonio interior!\",\n    },\n    [\"koKR\"] = {\n        demon = \"내 안에 깃든... 악마의 힘을 보여주마!\",\n    },\n    [\"ruRU\"] = {\n        demon = \"Узрите силу... истинного демона!\",\n    },\n    [\"zhCN\"] = {\n        demon = \"感受我体内的恶魔之力吧！\",\n    },\n    [\"zhTW\"] = {\n        demon = \"感受我體內的惡魔之力吧!\",\n    }\n}\n\naura_env.currentLocale = aura_env.locales[locale] or aura_env.locales[\"enUS\"]",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "aura_env.count = 1\naura_env.pullStart = nil\naura_env.lastCast = nil\naura_env.nextDemonForm = nil\naura_env.inDemonForm = false\n\naura_env.preWarnCancel()\naura_env.nuTimer(nil)",
["do_sound"] = false,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
["do_message"] = false,
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "ENCOUNTER_START, ENCOUNTER_END, WA_FJI_ENCOUNTER_END, WA_FJI_ENCOUNTER_START, CHAT_MSG_MONSTER_YELL, WA_ILLIDAN_HUMAN_FORM, WA_ILLIDAN_P2_START, WA_ILLIDAN_P3_START, WA_ILLIDAN_P4_START, WA_ILLIDAN_DEMON_FORM_DETECT, WA_ILLIDAN_P3_END, WA_ILLIDAN_CAGED",
["spellIds"] = {
},
["custom"] = "function(allstates,event,...)\n    if event == \"WA_FJI_ENCOUNTER_START\" or event == \"ENCOUNTER_START\" then\n        local eID = ...\n        \n        if eID ~= aura_env.encounterID then\n            return false\n        end\n        \n        aura_env.pullStart = GetTime()\n        aura_env.lastCast = nil\n        aura_env.nextDemonForm = nil\n        aura_env.inDemonForm = false\n        aura_env.count = 1\n        \n        aura_env.updateState(allstates)\n        return true\n    elseif event == \"WA_ILLIDAN_P3_START\" then\n        aura_env.lastCast = GetTime()\n        aura_env.inDemonForm = false\n        \n        aura_env.startTimer(aura_env.cdStartP3)\n        return true\n    elseif event == \"WA_ILLIDAN_P3_END\" then\n        aura_env.nextDemonForm = nil\n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        return true\n    elseif event == \"WA_ILLIDAN_P4_START\" then\n        aura_env.lastCast = GetTime()\n        aura_env.inDemonForm = false\n        \n        aura_env.startTimer(aura_env.cdStartP4)\n        return true\n    elseif event == \"WA_ILLIDAN_HUMAN_FORM\" then\n        aura_env.inDemonForm = false\n        \n        aura_env.startTimer(aura_env.cdWindow)\n        return false\n    elseif event == \"WA_ILLIDAN_CAGED\" then\n        if aura_env.inDemonForm or not aura_env.nextDemonForm then\n            return false\n        end\n        \n        local remaining = aura_env.nextDemonForm-GetTime()\n        \n        if remaining > 0 and remaining < 17 then\n            aura_env.startTimer(17)\n        end\n        \n        return false\n    elseif event == \"WA_ILLIDAN_DEMON_FORM_DETECT\" then\n        local source = ...\n        \n        if aura_env.inDemonForm then\n            aura_env.debugPrint(\"Ignored duplicate Demon Form from \"..tostring(source))\n            return false\n        end\n        \n        aura_env.inDemonForm = true\n        aura_env.nextDemonForm = nil\n        \n        local now = GetTime()\n        \n        if aura_env.lastCast then\n            aura_env.debugPrint(string.format(\"Next Demon Form (%d): %.1fs after previous. Source: %s\",aura_env.count,now-aura_env.lastCast,tostring(source)))\n        elseif aura_env.pullStart then\n            aura_env.debugPrint(string.format(\"First Demon Form (%d): %.1fs into pull. Source: %s\",aura_env.count,now-aura_env.pullStart,tostring(source)))\n        end\n        \n        aura_env.lastCast = now\n        \n        WeakAuras.ScanEvents(\"WA_ILLIDAN_DEMON_FORM\")\n        aura_env.preWarnCancel()\n        aura_env.nuTimer(0,aura_env.count)\n        aura_env.count = aura_env.count+1\n        return false\n    elseif event == \"WA_FJI_ENCOUNTER_END\" or event == \"ENCOUNTER_END\" then\n        aura_env.pullStart = nil\n        aura_env.lastCast = nil\n        aura_env.nextDemonForm = nil\n        aura_env.inDemonForm = false\n        \n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        return false\n    elseif event == \"CHAT_MSG_MONSTER_YELL\" then\n        local msg = ...\n        \n        if msg:find(aura_env.currentLocale.demon,1,true) then\n            WeakAuras.ScanEvents(\"WA_ILLIDAN_DEMON_FORM_DETECT\",\"YELL\")\n        end\n        \n        return false\n    end\n    \n    return false\nend",
