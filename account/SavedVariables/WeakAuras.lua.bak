["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n        }\n        return true \n    end\n    \n    if event == \"WA_\" .. aura_env.e .. \"_PREWARN\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n        }\n        return true\n    elseif event == \"WA_NAJENTUS_SHIELD_REMOVED\" then\n        if allstates[\"\"] then\n            allstates[\"\"].show = false\n            allstates[\"\"].changed = true\n            return true\n        end\n    end\nend",
