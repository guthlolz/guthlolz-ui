},
["subeventPrefix"] = "SPELL",
["group_count"] = "0",
["custom_hide"] = "timed",
["debuffType"] = "HARMFUL",
["names"] = {
},
["useName"] = true,
["unit"] = "group",
["useExactSpellId"] = false,
["auraspellids"] = {
},
["useGroup_count"] = true,
["event"] = "Health",
["spellIds"] = {
},
["subeventSuffix"] = "_CAST_START",
["type"] = "custom",
["custom"] = "function(a,e,_,subEvent,_,sourceGUID,_,_,_,destGUID,destName,_,_,spellId,_,_,_,amount)\n    if e == \"OPTIONS\" then\n        for i = 1,2 do\n            a[i] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = 15,\n                expirationTime = GetTime() + 15,\n                autoHide = true,\n                stacks = math.random(0,5)\n            }\n        end\n        return true\n    end\n    \n    if subEvent == \"SPELL_AURA_APPLIED\" then\n        if spellId == 41034 then\n            a[sourceGUID] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = 15,\n                expirationTime = GetTime() + 15,\n                autoHide = true,\n            }\n            return true\n        elseif spellId == 41033 then\n            if a[destGUID] then\n                a[destGUID].stacks = amount or 1\n                a[destGUID].changed = true\n                return true\n            end\n        end\n    end\n    \n    if subEvent == \"UNIT_DIED\" then\n        if a[destGUID] then\n            a[destGUID].show = false\n            a[destGUID].changed = true\n            return true\n        end\n    end\nend",
["events"] = "CLEU:SPELL_AURA_APPLIED:UNIT_DIED",
["check"] = "event",
["custom_type"] = "stateupdate",
["group_countOperator"] = ">",
["customVariables"] = "{\n    stacks = \"number\",\n}",
