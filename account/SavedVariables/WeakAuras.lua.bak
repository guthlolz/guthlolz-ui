["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, key, time, count)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 3,\n            expirationTime = GetTime() + 3,\n            progressType = \"timed\",\n            icon = 135836,\n            autoHide = true,\n            status = \"Channel\",\n        }\n        return true\n    end\n    \n    if event == \"WA_LURKER_SPOUT_CHANNEL\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 17,\n            expirationTime = GetTime() + 17,\n            progressType = \"timed\",\n            icon = 135836,\n            autoHide = true,\n            status = \"Channel\",\n        }\n        return true\n    end\n    \n    if event == \"WA_NUMEN_TIMER\" and key == \"LURKER_SPOUT\" then\n        if time == 0 then\n            C_VoiceChat.SpeakText(_G.FJITTS_SFX_VOICEID, \"Spout\", Enum.VoiceTtsDestination.LocalPlayback, _G.FJITTS_SFX_RATE, _G.FJITTS_SFX_VOLUME)\n            C_Timer.After(3, function()\n                    WeakAuras.ScanEvents(\"WA_LURKER_SPOUT_CHANNEL\")\n            end)\n            \n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = 3,\n                expirationTime = GetTime() + 3,\n                progressType = \"timed\",\n                icon = 135836,\n                autoHide = true,\n                status = \"Cast\",\n            }\n        elseif time == nil then\n            if allstates[\"\"] then\n                allstates[\"\"].show = false\n                allstates[\"\"].changed = true\n            end\n        end\n        return true\n    end\nend",
["spellIds"] = {
},
["events"] = "WA_NUMEN_TIMER, WA_LURKER_SPOUT_CHANNEL",
["check"] = "event",
["unit"] = "player",
["custom_hide"] = "timed",
["customVariables"] = "{\nstatus = \"string\",\n}",
},
["untrigger"] = {
},
},
["disjunctive"] = "any",
["activeTriggerMode"] = -10,
},
["sparkRotation"] = 0,
["displayText_format_1.name_format"] = "Unit",
["progressSource"] = {
