["actions"] = {
["start"] = {
["do_custom"] = true,
["custom"] = "local state = aura_env.state\nif state and state.spellKey then\n    local color = aura_env.getColor(state.spellKey)\n    aura_env.region:Color(color[1], color[2], color[3], color[4] or 1)\nend",
["do_sound"] = false,
},
["finish"] = {
["custom"] = "",
["do_sound"] = false,
["do_message"] = false,
["do_custom"] = false,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.region.bar:SetVertexColor(1, 1, 1, 1)\n\naura_env.spellKeys = { -- Colour is RGBA (Red,Green,Blue,Alpha)\n    -- name, icon, autoHide (true/false), role (\"TANK\"/\"HEALER\"), roleRestrict (true/false), useText (true/false)\n    -- note that the first role is selected for the Icon\n    --[\"JINROKH_STATIC_BURST\"] = {name = \"Static Burst\", icon = 136050, role = {\"TANK\", \"HEALER\"}, roleRestrict = true, autoHide = true},\n    \n    --[\"HYDROSS_MARK\"] = { name = \"Next Mark\", icon = 135851, useText = true},\n    \n    [\"HYDROSS_MARK_FROST\"] = { name = \"Next Mark\", icon = 135851, useText = true},\n    [\"HYDROSS_MARK_NATURE\"] = { name = \"Next Mark\", icon = 136030, useText = true},\n    [\"HYDROSS_WATER_TOMB\"] = { name = \"Water Tomb\", icon = 135859},\n    [\"HYDROSS_VILE_SLUDGE\"] = { name = \"Vile Sludge\", icon = 136006},\n    [\"LURKER_SUBMERGE\"] = { name = \"Submerge\", icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\Throne of Thunder\\\\ArrowDownWhite.tga\"},\n    [\"LURKER_EMERGE\"] = { name = \"Emerge\", icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\Throne of Thunder\\\\ArrowUpWhite.tga\"},\n    [\"LURKER_WHIRL\"] = { name = \"Whirl\", icon = 132369},\n    [\"LURKER_SPOUT\"] = { name = \"Spout\", icon = 135836},\n    [\"LURKER_GEYSER\"] = { name = \"Geyser\", icon = 135844},\n    [\"TIDEWALKER_WATERY_GRAVE\"] = { name = \"Watery Graves\", icon = 136148},\n    [\"TIDEWALKER_MURLOCS\"] = { name = \"Murlocs\", icon = 134169},\n    [\"TIDEWALKER_TIDAL_WAVE\"] = { name = \"Tidal Wave\", icon = 135844, role = {\"TANK\", \"HEALER\"}},\n    [\"KARATHRESS_SPITFIRE\"] = { name = \"Spitfire Totem\", icon = 135825},\n    [\"KARATHRESS_TIDAL_SURGE\"] = { name = \"Tidal Surge\", icon = 135852},\n    [\"KARATHRESS_BEAST_WITHIN\"] = { name = \"The Beast Within\", icon = 132166},\n    [\"KARATHRESS_SEAR_NOVA\"] = { name = \"Sear Nova\", icon = 135824},\n    [\"KARATHRESS_SUMMON_PET\"] = { name = \"Summon Pet\", icon = 132197},\n    [\"LEOTHERAS_WHIRLWIND\"] = { name = \"Whirlwind\", icon = 132369},\n    [\"LEOTHERAS_INNER_DEMON\"] = { name = \"Inner Demons\", icon = 136171},\n    [\"LEOTHERAS_HUMAN_FORM\"] = { name = \"Human Form\", icon = 136129},\n    [\"LEOTHERAS_DEMON_FORM\"] = { name = \"Demon Form\", icon = 136172},\n    [\"VASHJ_ENTANGLE\"] = { name = \"Entangle\", icon = 136100, autoHide = true},\n    [\"VASHJ_SHOCK_BLAST\"] = { name = \"Shock Blast\", icon = 136115},\n    [\"VASHJ_TAINTED\"] = { name = \"Tainted Elemental\", icon = 136016},\n    [\"VASHJ_NAGA\"] = { name = \"Naga Elite\", icon = 132338},\n    [\"VASHJ_STRIDER\"] = { name = \"Strider\", icon = 136224},\n    [\"ALAR_PLATFORM\"] = { name = \"Takes Flight\", icon = 135506},\n    [\"ALAR_MELT_ARMOR\"] = { name = \"Melt Armor\", icon = 135817, role = {\"TANK\"}},\n    [\"ALAR_DIVE_BOMB\"] = { name = \"Dive Bomb\", icon = 135808},\n    [\"ALAR_CHARGE\"] = { name = \"Charge\", icon = 132337},\n    [\"REAVER_ARCANE_ORB\"] = { name = \"Arcane Orb\", icon = 136116},\n    [\"REAVER_KNOCKAWAY\"] = { name = \"Knock Away\", icon = 132939},\n    [\"REAVER_POUNDING\"] = { name = \"Pounding\", icon = 132326},\n    [\"SOLARIAN_SPLIT\"] = { name = \"Next Add Phase\", icon = 135736},\n    [\"SOLARIAN_WRATH\"] = { name = \"Wrath Debuff\", icon = 135734},\n    [\"SOLARIAN_PRIESTS\"] = { name = \"Boss & Priests\", icon = 135915},\n    [\"SOLARIAN_AGENTS\"] = { name = \"Adds Spawn\", icon = 132349},\n    [\"SOLARIAN_PSYCHIC_SCREAM\"] = { name = \"Psychic Scream\", icon = 136184},\n    [\"KAELTHAS_THALADRED_ENGAGE\"] = { name = \"Thaladred the Darkener\", icon = 133160},\n    [\"KAELTHAS_SANGUINAR_ENGAGE\"] = { name = \"Lord Sanguinar\", icon = 626003},\n    [\"KAELTHAS_CAPERNIAN_ENGAGE\"] = { name = \"Astromancer Capernian\", icon = 626001},\n    [\"KAELTHAS_TELONICUS_ENGAGE\"] = { name = \"Engineer Telonicus\", icon = 134520},\n    [\"KAELTHAS_SHOCK_BARRIER\"] = { name = \"Shock Barrier\", icon = 136051},\n    [\"KAELTHAS_MIND_CONTROL\"] = { name = \"Mind Control\", icon = 136129},\n    [\"KAELTHAS_FLAME_STRIKE\"] = { name = \"Flame Strike\", icon = 135826},\n    [\"KAELTHAS_PHOENIX\"] = { name = \"Phoenix\", icon = 135790},\n    [\"KAELTHAS_GRAVITY\"] = { name = \"Gravity Lapse\", icon = 136111},\n    [\"KAELTHAS_GAZE\"] = { name = \"New Gaze Target\", icon = 136129},\n    [\"KAELTHAS_CONFLAGRATION\"] = { name = \"Conflagration\", icon = 135818},\n    [\"KAELTHAS_BELLOWING_ROAR\"] = { name = \"Bellowing Roar\", icon = 136129},\n    [\"KAELTHAS_P3\"] = { name = \"Advisors Resurrect\", icon = 136129},\n    [\"KAELTHAS_P4\"] = { name = \"Kael'thas Active\", icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\kaelthas.jpg\"},\n    [\"KAELTHAS_RP\"] = { name = \"Kael'thas RP\", icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\kaelthas.jpg\"},\n}\n\naura_env.timers = {}\n\nfunction aura_env.getColor(key)\n    local cfg = aura_env.config.option\n    \n    if cfg.colorOverride and cfg.color then\n        return { cfg.color[1], cfg.color[2], cfg.color[3], cfg.color[4] or 1 }\n    end\n    \n    local color = cfg.enabledGroup and cfg.enabledGroup[\"COL_\" .. key]\n    if color and color[1] then\n        return { color[1], color[2], color[3], color[4] or 1 }\n    end\nend\n\nlocal function createKey(key, guid)\n    if guid then\n        return key .. \"_\" .. guid\n    end\n    return key\nend\n\nfunction aura_env.updateState(allstates, key, duration, count, name, icon, color, autoHide, text, guid)\n    local r, g, b, a = color[1], color[2], color[3], color[4] or 1\n    local stateKey = (guid and (key .. \"_\" .. guid)) or key\n    \n    allstates[stateKey] = {\n        show = true,\n        changed = true,\n        duration = duration,\n        expirationTime = GetTime() + duration,\n        progressType = \"timed\",\n        count = count,\n        color = { r, g, b, a },\n        icon = icon,\n        name = name,\n        autoHide = autoHide,\n        text = text or \"\",\n        spellKey = key,\n        useText = text and text ~= \"\",\n    }\nend\n\nfunction aura_env.hideState(allstates, key, guid)\n    local stateKey = createKey(key, guid)\n    \n    if allstates[stateKey] then\n        allstates[stateKey].show = false\n        allstates[stateKey].changed = true\n        return true\n    end\nend\n\nfunction aura_env.scheduleTimer(key, delay, count, displayName, icon, color, autoHide, text, guid, tts)\n    local timerKey = (guid and (key .. \"_\" .. guid)) or key\n    \n    if aura_env.timers[timerKey] then\n        aura_env.timers[timerKey]:Cancel()\n        aura_env.timers[timerKey] = nil\n    end\n    \n    aura_env.timers[timerKey] = C_Timer.NewTimer(delay, function()\n            WeakAuras.ScanEvents(\"WA_NUMEN_EMPHASIZED_TIMER\",\n            key, 10, count, displayName, icon, color, autoHide, text, guid, tts)\n    end)\nend\n\nfunction aura_env.cancelTimer(key, guid)\n    local timerKey = createKey(key, guid)\n    \n    if aura_env.timers[timerKey] then\n        aura_env.timers[timerKey]:Cancel()\n        aura_env.timers[timerKey] = nil\n    end\nend",
["do_custom"] = true,
},
