},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, key, time, count)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 3,\n            expirationTime = GetTime() + 3,\n            progressType = \"timed\",\n            icon = 135836,\n            autoHide = true,\n        }\n        return true\n    end\n    \n    if event == \"WA_NUMEN_TIMER\" and key == \"TIDEWALKER_TIDAL_WAVE\" then\n        if time == 0 then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = 2,\n                expirationTime = GetTime() + 2,\n                progressType = \"timed\",\n                icon = 135836,\n                autoHide = true,\n            }\n        elseif time == nil then\n            if allstates[\"\"] then\n                allstates[\"\"].show = false\n                allstates[\"\"].changed = true\n            end\n        end\n        return true\n    end\nend",
["spellIds"] = {
