["custom"] = "function(event,_,subEvent,_,sourceGUID,_,_,_,destGUID,destName,_,_,spellId)\n    if spellId ~= 31944 then\n        return false\n    end\n    \n    if subEent == \"SPELL_AURA_APPLIED\" then\n        WeakAuras.ScanEvents(\"WA_ARCHIMONDE_DOOMFIRE_APPLIED\", destName, destGUID)\n    elseif subEvent == \"SPELL_AURA_REMOVED\" then\n        WeakAuras.ScanEvents(\"WA_ARCHIMONDE_DOOMFIRE_REMOVED\", destName, destGUID)\n    end\nend",
