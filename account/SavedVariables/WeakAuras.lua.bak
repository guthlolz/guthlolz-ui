["cooldownSwipe"] = true,
["customTextUpdate"] = "update",
["cooldownEdge"] = false,
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "aura_env.spells = {\n    [116]   = true,\n    [205]  = true,\n    [837] = true,\n    [7322] = true,\n    [8406]  = true,\n    [8407] = true,\n    [8408] = true,\n    [10179] = true,\n    [10180] = true,\n    [10181] = true,\n    [25304] = true,\n    [27072] = true,\n    [1449]  = true,\n    [8437] = true,\n    [8438] = true,\n    [8439] = true,\n    [10201] = true,\n    [10202] = true,\n    [27082] = true,\n    [30451] = true,\n    [10]    = true,\n    [6141] = true,\n    [8427] = true,\n    [10185] = true,\n    [10186] = true,\n    [10187] = true,\n    [27085] = true,\n    \n    [133]   = true,\n    [143]  = true,\n    [145]  = true,\n    [3140] = true,\n    [8400]  = true,\n    [8401] = true,\n    [8402] = true,\n    [10148] = true,\n    [10149] = true,\n    [10150] = true,\n    [10151] = true,\n    [25306] = true,\n    [27070] = true,\n    [2948]  = true,\n    [8444] = true,\n    [8445] = true,\n    [8446] = true,\n    [10205] = true,\n    [10206] = true,\n    [10207] = true,\n    [27074] = true,\n}",
["do_custom"] = true,
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["duration"] = "20",
["subeventPrefix"] = "SPELL",
["customIcon"] = "function()\n    return aura_env.icon\nend",
["debuffType"] = "HELPFUL",
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["customStacks"] = "function()\n    return aura_env.casts\nend",
["custom"] = "function(a,e,_,subEvent,_,sourceGUID,_,_,_,_,_,_,_,spellId)\n    \n    if subEvent == \"SPELL_CAST_SUCCESS\" and sourceGUID == WeakAuras.myGUID then\n        if aura_env.spells[spellId] then \n            local costInfo = GetSpellPowerCost(spellId)\n            if costInfo and costInfo[1] then\n                local casts = floor(UnitPower(\"player\") / costInfo[1].cost)\n                if casts < 200 then\n                    aura_env.lastcast = spellId\n                    \n                    a[\"\"] = {\n                        show = true,\n                        changed = true,\n                        icon = select(3, GetSpellInfo(spellId)),\n                        casts = casts,\n                        progressType = \"timed\",\n                        duration = 20,\n                        expirationTime = GetTime() + 20,\n                        autoHide = true,\n                    }\n                    return true\n                end\n            end\n        else\n            if a[\"\"] then\n                a[\"\"].show = false\n                a[\"\"].changed = true\n                return true\n            end\n        end\n    elseif e == \"UNIT_POWER_UPDATE\" and aura_env.lastcast then\n        local costInfo = GetSpellPowerCost(aura_env.lastcast)\n        if costInfo and costInfo[1] then\n            local casts = floor(UnitPower(\"player\") / costInfo[1].cost)\n            if casts < 200 and a[\"\"] then\n                a[\"\"].changed = true\n                a[\"\"].casts = casts\n                return true\n            end\n        end\n    end\nend",
["spellIds"] = {
},
["events"] = "CLEU:SPELL_CAST_SUCCESS UNIT_POWER_UPDATE:player",
["custom_type"] = "stateupdate",
["check"] = "event",
["unit"] = "player",
["names"] = {
},
["customVariables"] = "{\n    casts = \"number\",\n}",
},
["untrigger"] = {
["custom"] = "",
},
},
