["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["custom_hide"] = "timed",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["unit"] = "player",
["custom"] = "function(allstates, event, ...)\n    if event == \"WA_FJI_ENCOUNTER_END\" or event == \"WA_FJI_ENCOUNTER_START\" then\n        aura_env.guids = {}\n        return\n    end\n    \n    if event == \"WA_MAULGAR_SUMMON_FEL_STALKER\" then\n        local guid = ...\n        aura_env.guids[guid] = GetTime() + 60\n        return true\n    end\n    \n    if event == \"NAME_PLATE_UNIT_ADDED\" then\n        local unit = ...\n        local guid = UnitGUID(unit)\n        local expire = aura_env.guids[guid]\n        if not expire then\n            return false\n        end\n        \n        local remaining = expire - GetTime()\n        if remaining <= 0 then\n            aura_env.elementalsExpire = nil\n            return false\n        end\n        \n        allstates[unit] = {\n            show = true,\n            changed = true,\n            unit = unit,\n            progressType = \"timed\",\n            duration = remaining,\n            expirationTime = expire,\n            autoHide = true,\n        }\n        return true\n    end\n    \n    if event == \"NAME_PLATE_UNIT_REMOVED\" then\n        local unit = ...\n        if allstates[unit] then\n            allstates[unit].show = false\n            allstates[unit].changed = true\n            return true\n        end\n        return false\n    end\nend",
["events"] = "WA_FJI_ENCOUNTER_START WA_FJI_ENCOUNTER_END NAME_PLATE_UNIT_ADDED NAME_PLATE_UNIT_REMOVED WA_MAULGAR_SUMMON_FEL_STALKER",
["customVariables"] = "{\n    expirationTime = true,\n}",
