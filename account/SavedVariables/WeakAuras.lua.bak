["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["custom_type"] = "stateupdate",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(allstates,event,_,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId)\n    if subEvent == \"UNIT_DIED\" then\n        local npcID = select(6, strsplit(\"-\", destGUID))\n        if npcID == \"17767\" then\n            WeakAuras.ScanEvents(\"WA_FJI_ENCOUNTER_END\")\n            WeakAuras.ScanEvents(\"WA_WINTERCHILL_DIED\")\n            return true\n        elseif npcID == \"17808\" then\n            WeakAuras.ScanEvents(\"WA_FJI_ENCOUNTER_END\")\n            WeakAuras.ScanEvents(\"WA_ANETHERON_DIED\")\n            return true\n        elseif npcID == \"17888\" then\n            WeakAuras.ScanEvents(\"WA_FJI_ENCOUNTER_END\")\n            WeakAuras.ScanEvents(\"WA_KAZROGAL_DIED\")\n            return true\n        elseif npcID == \"17842\" then\n            WeakAuras.ScanEvents(\"WA_FJI_ENCOUNTER_END\")\n            WeakAuras.ScanEvents(\"WA_AZGALOR_DIED\")\n            return true\n        elseif npcID == \"17968\" then\n            WeakAuras.ScanEvents(\"WA_FJI_ENCOUNTER_END\")\n            WeakAuras.ScanEvents(\"WA_ARCHIMONDE_DIED\")\n            return true\n        end\n    end\nend",
["events"] = "CLEU:UNIT_DIED",
