["CT:[T5][Kaelthas] Arcane Disruption"] = {
["outline"] = "OUTLINE",
["wagoID"] = "gSs1_GQRl",
["color"] = {
1,
1,
1,
1,
},
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["shadowYOffset"] = -1,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiT5RaidPack/3",
["actions"] = {
["start"] = {
},
["finish"] = {
["custom"] = "aura_env.count = 1\naura_env.nuTimer(nil)\naura_env.preWarnCancel()",
["do_sound"] = false,
["do_message"] = false,
["do_custom"] = true,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.key = \"KAELTHAS_DISRUPTION\"\naura_env.count = 1\naura_env.cdP4Start = 20\naura_env.cdP4Window = 20\naura_env.cdP5Start = 55\naura_env.cdP5Window = 15\naura_env.disruption = 36834\n\nfunction aura_env.nuTimer(countdown, count)\n    WeakAuras.ScanEvents(\"WA_NUMEN_TIMER\", aura_env.key, countdown, count)\nend\n\nfunction aura_env.updateState(allstates)\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n    }\nend\n\nfunction aura_env.hideState(allstates)\n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\nend\n\nfunction aura_env.preWarn(duration, preWarnTime, count)\n    if not preWarnTime then\n        preWarnTime = 3\n    end\n    \n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\n    \n    aura_env.preWarnTimer = C_Timer.NewTimer(duration - preWarnTime, function()\n            WeakAuras.ScanEvents(\"WA_\" .. aura_env.key .. \"_PREWARN\", preWarnTime, count)\n            aura_env.preWarnTimer = nil\n    end)\nend\n\nfunction aura_env.preWarnCancel()\n    WeakAuras.ScanEvents(\"WA_\" .. aura_env.key .. \"_PREWARN_CANCEL\")\n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\nend",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates,event,...)\n    if event == \"WA_FJI_ENCOUNTER_START\" or event == \"ENCOUNTER_START\" then\n        local eID = ...\n        if eID ~= 733 then\n            return false\n        end\n        \n        aura_env.updateState(allstates)\n        aura_env.count = 1\n        return true\n        \n    elseif event == \"WA_FJI_ENCOUNTER_END\" or event == \"ENCOUNTER_END\" then\n        aura_env.p5 = false\n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        return true\n        \n    elseif event == \"WA_KAELTHAS_P4_START\" then\n        aura_env.p5 = false\n        aura_env.preWarn(aura_env.cdP4Start, 3, aura_env.count)\n        aura_env.nuTimer(aura_env.cdP4Start, aura_env.count)\n        return true\n        \n    elseif event == \"WA_KAELTHAS_P5_START\" then\n        aura_env.p5 = true\n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        aura_env.preWarn(aura_env.cdP5Start, 3, aura_env.count)\n        aura_env.nuTimer(aura_env.cdP5Start, aura_env.count)\n        return true\n    end\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local _,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId = ...\n        \n        if spellId ~= aura_env.disruption then\n            return false\n        end\n        \n        if subEvent == \"SPELL_CAST_SUCCESS\" then\n            aura_env.nuTimer(0, aura_env.count)\n            aura_env.count = aura_env.count + 1\n            \n            if aura_env.p5 then\n                aura_env.preWarn(aura_env.cdP5Window, 3, aura_env.count)\n                aura_env.nuTimer(aura_env.cdP5Window, aura_env.count)\n            else\n                aura_env.preWarn(aura_env.cdP4Window, 3, aura_env.count)\n                aura_env.nuTimer(aura_env.cdP4Window, aura_env.count)\n            end\n            return true\n        end\n    end\nend",
["spellIds"] = {
},
["events"] = "ENCOUNTER_START, WA_FJI_ENCOUNTER_START, ENCOUNTER_END, WA_FJI_ENCOUNTER_END, CLEU:SPELL_CAST_SUCCESS, WA_KAELTHAS_P4_START, WA_KAELTHAS_P5_START",
