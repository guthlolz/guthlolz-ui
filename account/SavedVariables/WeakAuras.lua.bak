["useAdjustededMin"] = false,
["regionType"] = "icon",
["color"] = {
1,
1,
1,
1,
},
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "aura_env.absorbSpells = {\n    [11426] = 437, -- [Mage] Ice Barrier (Rank 1)\n    [13031] = 548, -- [Mage] Ice Barrier (Rank 2)\n    [13032] = 677, -- [Mage] Ice Barrier (Rank 3)\n    [13033] = 817, -- [Mage] Ice Barrier (Rank 4)\n    [27134] = 952, -- [Mage] Ice Barrier (Rank 5)\n    [33405] = 1075, -- [Mage] Ice Barrier (Rank 6)\n}\n\nlocal function update(state, amount)\n    state.value = state.value - amount\n    state.show = state.value > 0\n    state.changed = true\n    return true\nend\n\nfunction aura_env.WA_FJI_ABSORB_APPLIED(allStates, total, spellId)\n    if not aura_env.absorbSpells[spellId] then\n        return\n    end\n    \n    allStates[\"\"] = {\n        show = true,\n        changed = true,\n        progressType = \"static\",\n        value = total,\n        total = total,\n    }\n    return true\nend\n\nfunction aura_env.WA_FJI_ABSORB_REMOVED(allStates, spellId)\n    if not aura_env.absorbSpells[spellId] then\n        return\n    end\n    \n    allStates[\"\"] = {\n        show = true,\n        changed = true,\n        progressType = \"static\",\n        value = total,\n        total = total,\n    }\n    return true\nend\n\nfunction aura_env.WA_FJI_ABSORB_UPDATE(allStates, amount, spellId)\n    if not aura_env.absorbSpells[spellId] then\n        return\n    end\n    local state = allStates[\"\"]\n    if state then\n        return update(state, amount)\n    end\nend\n\nfunction aura_env.OPTIONS(allStates)\n    allStates[\"\"] = {\n        show = true,\n        changed = true,\n        progressType = \"static\",\n        value = math.random(1, 826),\n        total = 826,\n    }\n    return true\nend\n\nfunction aura_env.STATUS(allStates)\n    return\nend",
["do_custom"] = true,
},
["finish"] = {
},
},
