["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["custom_hide"] = "timed",
["names"] = {
},
["event"] = "Health",
["unit"] = "player",
["subeventSuffix"] = "_CAST_START",
["spellIds"] = {
},
["custom"] = "function(allstates,event,guid1,guid2,guid3)\n    if event == \"OPTIONS\" then\n        wipe(allstates)\n        \n        local expirationTime = GetTime() + aura_env.duration\n        \n        allstates[\"HEADER\"] = {\n            show = true,\n            changed = true,\n            duration = aura_env.duration,\n            expirationTime = expirationTime,\n            progressType = \"timed\",\n            autoHide = true,\n            name = aura_env.name,\n            icon = aura_env.icon,\n            isHeader = true,\n            index = 1,\n        }\n        \n        for i = 1,3 do\n            allstates[i] = {\n                show = true,\n                changed = true,\n                duration = aura_env.duration,\n                expirationTime = expirationTime,\n                progressType = \"timed\",\n                autoHide = true,\n                name = aura_env.name,\n                icon = aura_env.icon,\n                guid = WeakAuras.myGUID,\n                isHeader = false,\n                index = i + 1,\n                last = i == 3,\n            }\n        end\n        return true\n    end\n    \n    if event ~= aura_env.event then\n        return false\n    end\n    \n    if guid1 == WeakAuras.myGUID or guid2 == WeakAuras.myGUID or guid3 == WeakAuras.myGUID then\n        return false\n    end\n    \n    local expirationTime = GetTime() + aura_env.duration\n    \n    allstates[\"HEADER\"] = {\n        show = true,\n        changed = true,\n        duration = aura_env.duration,\n        expirationTime = expirationTime,\n        progressType = \"timed\",\n        autoHide = true,\n        name = aura_env.name,\n        icon = aura_env.icon,\n        isHeader = true,\n        index = 1,\n    }\n    \n    local guids = {guid1,guid2,guid3}\n    \n    for i,guid in ipairs(guids) do\n        allstates[guid] = {\n            show = true,\n            changed = true,\n            duration = aura_env.duration,\n            expirationTime = expirationTime,\n            progressType = \"timed\",\n            autoHide = true,\n            name = aura_env.name,\n            icon = aura_env.icon,\n            guid = guid,\n            isHeader = false,\n            index = i + 1,\n            last = i == #guids,\n        }\n    end\n    \n    return true\nend",
["events"] = "WA_MOTHER_SHAHRAZ_FATAL_GUIDS",
["check"] = "event",
["subeventPrefix"] = "SPELL",
["debuffType"] = "HELPFUL",
["customVariables"] = "{\n    isHeader = \"bool\",\n    last = \"bool\",\n}",
