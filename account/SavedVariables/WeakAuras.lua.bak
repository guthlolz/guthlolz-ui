["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["unit"] = "player",
["custom"] = "function(allstates, event, _, subEvent, _, sourceGUID, _, _, _, destGUID, _, _, _, spellId)\n    if subEvent ~= \"UNIT_DIED\" or not destGUID then\n        return\n    end\n    \n    local npcID = select(6, strsplit(\"-\", destGUID))\n    if not npcID then\n        return\n    end\n    \n    local mob = aura_env.npcIDs[npcID]\n    if not mob then\n        return\n    end\n    \n    WeakAuras.ScanEvents(\"WA_MAULGAR_\" .. mob .. \"_DIED\")\nend",
