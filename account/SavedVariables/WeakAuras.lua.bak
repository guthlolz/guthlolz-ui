["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, unit)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            icon = 136212,\n            count = math.random(1,5),\n        }\n    end\n    if event == \"NAME_PLATE_UNIT_ADDED\" then\n        local guid = UnitGUID(unit)\n        local npcID = select(6, strsplit(\"-\", guid))\n        \n        if npcID ~= \"22352\" then\n            return false\n        end\n        \n        if GetTime() - aura_env.throttle < 60 then\n            return false\n        end\n        aura_env.throttle = GetTime()\n        \n        if not aura_env.seen[guid] then\n            aura_env.seen[guid] = true\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = 2,\n                expirationTime = GetTime() + 2,\n                progressType = \"timed\",\n                icon = 136212,\n                autoHide = true,\n            }\n            return true\n        end\n    end\nend",
["spellIds"] = {
},
["events"] = "NAME_PLATE_UNIT_ADDED",
["check"] = "event",
["unit"] = "player",
["custom_hide"] = "timed",
["customVariables"] = "",
},
["untrigger"] = {
