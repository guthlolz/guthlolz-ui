["custom"] = "function(allstates,event,_,subEvent,_,sourceGUID,_,_,_,destGUID,destName,_,_,spellId)\n    if spellId ~= aura_env.stealth then\n        return false\n    end\n    \n    if subEvent == \"SPELL_AURA_REMOVED\" then\n        local npcID = select(6, strsplit(\"-\", destGUID))\n        if npcID == aura_env.npcID then\n            WeakAuras.ScanEvents(\"WA_AKAMA_ACTIVATED\")\n            return true\n        end\n    end\nend",
