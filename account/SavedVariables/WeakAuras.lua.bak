["CT:[MH] Mob Waves"] = {
["outline"] = "OUTLINE",
["wagoID"] = "2XzLgw2qF",
["authorOptions"] = {
},
["displayText"] = "",
["customText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
["do_glow"] = false,
["do_custom"] = false,
["sound"] = "Interface\\Addons\\FojjiCore\\sound\\fojjiSnap.ogg",
["do_sound"] = false,
},
["finish"] = {
["custom"] = "",
["do_sound"] = false,
["do_message"] = false,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
["do_custom"] = false,
},
["init"] = {
["custom"] = "aura_env.saved = aura_env.saved or {}\naura_env.debug = false\naura_env.boss = 0\naura_env.lastWave = 0\n\nfunction aura_env.debugPrint(...)\n    if aura_env.debug then\n        print(\"|cff00ccffHyjal Waves:|r\", ...)\n    end\nend\n\naura_env.bossData = {\n    [1] = {\n        boss = \"winterchill\",\n        key = \"HYJAL_WAVE_WINTERCHILL\",\n        times = {127.5, 127.5, 127.5, 127.5, 127.5, 127.5, 127.5, 185},\n    },\n    [2] = {\n        boss = \"anetheron\",\n        key = \"HYJAL_WAVE_ANETHERON\",\n        times = {127.5, 127.5, 127.5, 127.5, 127.5, 127.5, 127.5, 185},\n    },\n    [3] = {\n        boss = \"kazrogal\",\n        key = \"HYJAL_WAVE_KAZROGAL\",\n        times = {135, 160, 190, 165, 140, 130, 195, 222},\n    },\n    [4] = {\n        boss = \"azgalor\",\n        key = \"HYJAL_WAVE_AZGALOR\",\n        times = {135, 190, 190, 195, 140, 165, 195, 225},\n    },\n}\n\naura_env.waveData = {\n    [1] = {\n        [1] = {{count = 10, name = \"Ghouls\"}},\n        [2] = {{count = 10, name = \"Ghouls\"}, {count = 2, name = \"Crypt Fiends\"}},\n        [3] = {{count = 6, name = \"Ghouls\"}, {count = 6, name = \"Crypt Fiends\"}},\n        [4] = {{count = 6, name = \"Ghouls\"}, {count = 4, name = \"Crypt Fiends\"}, {count = 2, name = \"Necromancers\"}},\n        [5] = {{count = 2, name = \"Ghouls\"}, {count = 6, name = \"Crypt Fiends\"}, {count = 4, name = \"Necromancers\"}},\n        [6] = {{count = 6, name = \"Ghouls\"}, {count = 6, name = \"Abominations\"}},\n        [7] = {{count = 4, name = \"Ghouls\"}, {count = 4, name = \"Necromancers\"}, {count = 4, name = \"Abominations\"}},\n        [8] = {{count = 6, name = \"Ghouls\"}, {count = 4, name = \"Crypt Fiends\"}, {count = 2, name = \"Abominations\"}, {count = 2, name = \"Necromancers\"}},\n    },\n    [2] = {\n        [1] = {{count = 10, name = \"Ghouls\"}},\n        [2] = {{count = 4, name = \"Abominations\"}, {count = 8, name = \"Ghouls\"}},\n        [3] = {{count = 4, name = \"Necromancers\"}, {count = 4, name = \"Crypt Fiends\"}, {count = 4, name = \"Ghouls\"}},\n        [4] = {{count = 2, name = \"Banshees\"}, {count = 6, name = \"Crypt Fiends\"}, {count = 4, name = \"Necromancers\"}},\n        [5] = {{count = 6, name = \"Ghouls\"}, {count = 2, name = \"Necromancers\"}, {count = 4, name = \"Banshees\"}},\n        [6] = {{count = 2, name = \"Abominations\"}, {count = 4, name = \"Necromancers\"}, {count = 6, name = \"Ghouls\"}},\n        [7] = {{count = 4, name = \"Abominations\"}, {count = 4, name = \"Crypt Fiends\"}, {count = 2, name = \"Banshees\"}, {count = 2, name = \"Ghouls\"}},\n        [8] = {{count = 4, name = \"Abominations\"}, {count = 3, name = \"Crypt Fiends\"}, {count = 2, name = \"Banshees\"}, {count = 2, name = \"Necromancers\"}, {count = 3, name = \"Ghouls\"}},\n    },\n    [3] = {\n        [1] = {{count = 4, name = \"Abominations\"}, {count = 2, name = \"Banshees\"}, {count = 6, name = \"Ghouls\"}, {count = 2, name = \"Necromancers\"}},\n        [2] = {{count = 4, name = \"Ghouls\"}, {count = 10, name = \"Gargoyles\"}},\n        [3] = {{count = 6, name = \"Crypt Fiends\"}, {count = 2, name = \"Necromancers\"}, {count = 6, name = \"Ghouls\"}},\n        [4] = {{count = 6, name = \"Gargoyles\"}, {count = 6, name = \"Crypt Fiends\"}, {count = 2, name = \"Necromancers\"}},\n        [5] = {{count = 4, name = \"Ghouls\"}, {count = 4, name = \"Necromancers\"}, {count = 6, name = \"Abominations\"}},\n        [6] = {{count = 8, name = \"Gargoyles\"}, {count = 1, name = \"Frost Wyrm\"}},\n        [7] = {{count = 6, name = \"Ghouls\"}, {count = 4, name = \"Abominations\"}, {count = 1, name = \"Frost Wyrm\"}},\n        [8] = {{count = 6, name = \"Ghouls\"}, {count = 2, name = \"Crypt Fiends\"}, {count = 2, name = \"Necromancers\"}, {count = 4, name = \"Abominations\"}, {count = 2, name = \"Banshees\"}},\n    },\n    [4] = {\n        [1] = {{count = 6, name = \"Abominations\"}, {count = 6, name = \"Necromancers\"}},\n        [2] = {{count = 5, name = \"Ghouls\"}, {count = 8, name = \"Gargoyles\"}, {count = 1, name = \"Frost Wyrm\"}},\n        [3] = {{count = 6, name = \"Ghouls\"}, {count = 8, name = \"Infernals\"}},\n        [4] = {{count = 6, name = \"Fel Stalkers\"}, {count = 8, name = \"Infernals\"}},\n        [5] = {{count = 4, name = \"Abominations\"}, {count = 6, name = \"Fel Stalkers\"}, {count = 4, name = \"Necromancers\"}},\n        [6] = {{count = 6, name = \"Necromancers\"}, {count = 6, name = \"Banshees\"}},\n        [7] = {{count = 2, name = \"Ghouls\"}, {count = 2, name = \"Crypt Fiends\"}, {count = 2, name = \"Fel Stalkers\"}, {count = 8, name = \"Infernals\"}},\n        [8] = {{count = 4, name = \"Crypt Fiends\"}, {count = 2, name = \"Necromancers\"}, {count = 4, name = \"Abominations\"}, {count = 2, name = \"Banshees\"}, {count = 4, name = \"Fel Stalkers\"}},\n    },\n}\n\nfunction aura_env.updateBossFromLockout()\n    local lockoutBoss = 0\n    local foundLockout = false\n    \n    for i = 1, GetNumSavedInstances() do\n        local _, _, _, _, locked, _, _, isRaid, _, _, _, encounterProgress, _, instanceID = GetSavedInstanceInfo(i)\n        \n        if locked and isRaid and instanceID == 534 then\n            foundLockout = true\n            encounterProgress = encounterProgress or 0\n            \n            if encounterProgress < 4 then\n                lockoutBoss = encounterProgress + 1\n            end\n            \n            break\n        end\n    end\n    \n    if not foundLockout and select(8, GetInstanceInfo()) == 534 then\n        lockoutBoss = 1\n    end\n    \n    if lockoutBoss > aura_env.boss or aura_env.boss == 0 then\n        aura_env.boss = lockoutBoss\n    end\n    \n    aura_env.debugPrint(\"Lockout boss:\", aura_env.boss)\nend\n\nfunction aura_env.nuTimer(countdown, count, boss, text)\n    local data = aura_env.bossData[boss or aura_env.boss]\n    \n    if not data then\n        return\n    end\n    \n    aura_env.debugPrint(\"Timer:\", data.key, countdown == nil and \"cancel\" or countdown, count or \"\", text or \"\")\n    WeakAuras.ScanEvents(\"WA_NUMEN_TIMER\", data.key, countdown, count, nil, text)\nend\n\nfunction aura_env.preWarn(duration, preWarnTime, count)\n    preWarnTime = preWarnTime or 3\n    \n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\n    \n    if duration <= preWarnTime then\n        return\n    end\n    \n    local data = aura_env.bossData[aura_env.boss]\n    \n    if not data then\n        return\n    end\n    \n    aura_env.preWarnTimer = C_Timer.NewTimer(duration - preWarnTime, function()\n            WeakAuras.ScanEvents(\"WA_\" .. data.key .. \"_PREWARN\", preWarnTime, count)\n            aura_env.preWarnTimer = nil\n    end)\nend\n\nfunction aura_env.preWarnCancel(boss)\n    local data = aura_env.bossData[boss or aura_env.boss]\n    \n    if data then\n        WeakAuras.ScanEvents(\"WA_\" .. data.key .. \"_PREWARN_CANCEL\")\n    end\n    \n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\nend\n\nfunction aura_env.sendWaveData(currentWave)\n    local bossData = aura_env.bossData[aura_env.boss]\n    local waveData = aura_env.waveData[aura_env.boss]\n    \n    if not bossData or not waveData then\n        return\n    end\n    \n    local currentComposition = waveData[currentWave]\n    \n    if currentComposition then\n        local parts = {}\n        \n        for i, mob in ipairs(currentComposition) do\n            parts[i] = mob.count .. \" \" .. mob.name\n        end\n        \n        aura_env.debugPrint(\"Event:\", bossData.boss, \"current\", currentWave, table.concat(parts, \", \"))\n        WeakAuras.ScanEvents(\"WA_FJI_HYJAL_WAVE\", bossData.boss, \"current\", currentWave, currentComposition)\n    end\n    \n    local nextWave = currentWave + 1\n    local nextComposition = waveData[nextWave]\n    \n    if nextComposition then\n        local parts = {}\n        \n        for i, mob in ipairs(nextComposition) do\n            parts[i] = mob.count .. \" \" .. mob.name\n        end\n        \n        aura_env.debugPrint(\"Event:\", bossData.boss, \"next\", nextWave, table.concat(parts, \", \"))\n        WeakAuras.ScanEvents(\"WA_FJI_HYJAL_WAVE\", bossData.boss, \"next\", nextWave, nextComposition)\n    elseif currentWave == 8 then\n        aura_env.debugPrint(\"Event:\", bossData.boss, \"boss\")\n        WeakAuras.ScanEvents(\"WA_FJI_HYJAL_WAVE\", bossData.boss, \"boss\")\n    end\nend\n\nfunction aura_env.recoverWave(currentWave)\n    local saved = aura_env.saved.hyjalWaveTimer\n    local expectedCount = currentWave + 1\n    local expectedText = currentWave == 8 and \"Boss\" or nil\n    \n    aura_env.lastWave = currentWave\n    aura_env.debugPrint(\"Recovering wave state:\", currentWave)\n    aura_env.sendWaveData(currentWave)\n    \n    if saved and saved.count == expectedCount and saved.text == expectedText and saved.boss and aura_env.bossData[saved.boss] then\n        aura_env.restoreTimer(currentWave)\n    else\n        aura_env.debugPrint(\"No valid timer for upcoming:\", expectedCount, expectedText or \"\")\n        aura_env.saved.hyjalWaveTimer = nil\n        aura_env.preWarnCancel()\n    end\nend\n\nfunction aura_env.resetWaves()\n    aura_env.debugPrint(\"Resetting waves\")\n    \n    local savedBoss = aura_env.saved.hyjalWaveTimer and aura_env.saved.hyjalWaveTimer.boss\n    local boss = aura_env.boss > 0 and aura_env.boss or savedBoss\n    \n    aura_env.lastWave = 0\n    \n    if boss then\n        aura_env.nuTimer(nil, nil, boss)\n    end\n    \n    aura_env.preWarnCancel(boss)\n    aura_env.saved.hyjalWaveTimer = nil\n    WeakAuras.ScanEvents(\"WA_FJI_HYJAL_WIPE\")\nend\n\nfunction aura_env.waveFunction(currentWave)\n    currentWave = tonumber(currentWave) or 0\n    \n    if currentWave > aura_env.lastWave then\n        local bossData = aura_env.bossData[aura_env.boss]\n        \n        if not bossData then\n            return\n        end\n        \n        local duration = bossData.times[currentWave]\n        \n        if not duration then\n            return\n        end\n        \n        aura_env.lastWave = currentWave\n        \n        local nextCount = currentWave + 1\n        local nextText = currentWave == 8 and \"Boss\" or nil\n        \n        aura_env.debugPrint(\"Wave:\", currentWave, \"Boss:\", aura_env.boss, \"Next:\", nextCount, \"Timer:\", duration, \"Text:\", nextText or \"\")\n        \n        aura_env.nuTimer(0, currentWave)\n        aura_env.sendWaveData(currentWave)\n        aura_env.saveTimer(duration, nextCount, nextText)\n        aura_env.nuTimer(duration, nextCount, nil, nextText)\n        aura_env.preWarn(duration, nil, nextCount)\n    elseif currentWave == 0 and aura_env.lastWave > 0 then\n        local enemies = aura_env.getInvadingEnemies()\n        \n        if enemies > 0 and aura_env.lastWave == 8 then\n            local bossData = aura_env.bossData[aura_env.boss]\n            \n            aura_env.debugPrint(\"Boss spawned. Invading enemies:\", enemies)\n            \n            if bossData then\n                aura_env.debugPrint(\"Event:\", bossData.boss, \"spawn\")\n                WeakAuras.ScanEvents(\"WA_FJI_HYJAL_WAVE\", bossData.boss, \"spawn\")\n            end\n            \n            aura_env.lastWave = 0\n            aura_env.nuTimer(nil)\n            aura_env.preWarnCancel()\n            aura_env.saved.hyjalWaveTimer = nil\n        elseif enemies == 0 then\n            aura_env.resetWaves()\n        end\n    end\nend\n\nfunction aura_env.getCurrentWave()\n    for _, widgetID in ipairs({528, 3121}) do\n        local widgetInfo = C_UIWidgetManager.GetIconAndTextWidgetVisualizationInfo(widgetID)\n        \n        if widgetInfo and widgetInfo.text and widgetInfo.state ~= 0 then\n            local currentWave = tonumber(widgetInfo.text:match(\"(%d+)\"))\n            \n            if currentWave then\n                return currentWave, widgetID, widgetInfo.text\n            end\n        end\n    end\nend\n\nfunction aura_env.getInvadingEnemies()\n    local function getCount(widgetID)\n        local widgetInfo = C_UIWidgetManager.GetIconAndTextWidgetVisualizationInfo(widgetID)\n        if widgetInfo and widgetInfo.text and widgetInfo.state ~= 0 then\n            return tonumber(widgetInfo.text:match(\"(%d+)\")) or 0\n        end\n        return 0\n    end\n    return math.max(getCount(3092), getCount(3093), getCount(500))\nend\n\nfunction aura_env.saveTimer(duration, count, text)\n    aura_env.saved.hyjalWaveTimer = {\n        expirationTime = GetTime() + duration,\n        count = count,\n        text = text,\n        boss = aura_env.boss,\n    }\nend\n\nfunction aura_env.restoreTimer(currentWave)\n    local saved = aura_env.saved.hyjalWaveTimer\n    \n    if not saved then\n        aura_env.debugPrint(\"Active wave:\", currentWave, \"- no saved next-wave timer\")\n        return\n    end\n    \n    if not saved.expirationTime or not saved.count or not saved.boss then\n        aura_env.saved.hyjalWaveTimer = nil\n        return\n    end\n    \n    local remaining = saved.expirationTime - GetTime()\n    \n    if remaining <= 0 or remaining > 300 then\n        aura_env.debugPrint(\"Discarding invalid saved timer:\", remaining)\n        aura_env.saved.hyjalWaveTimer = nil\n        return\n    end\n    \n    local expectedCount = currentWave + 1\n    local expectedText = currentWave == 8 and \"Boss\" or nil\n    \n    if saved.count ~= expectedCount or saved.text ~= expectedText then\n        aura_env.debugPrint(\"Saved timer does not match widget:\", saved.count, saved.text or \"\", expectedCount, expectedText or \"\")\n        aura_env.saved.hyjalWaveTimer = nil\n        return\n    end\n    \n    if not aura_env.bossData[saved.boss] then\n        aura_env.saved.hyjalWaveTimer = nil\n        return\n    end\n    \n    aura_env.boss = saved.boss\n    aura_env.lastWave = currentWave\n    \n    aura_env.debugPrint(\"Restoring next:\", saved.count, \"Text:\", saved.text or \"\", \"Remaining:\", remaining)\n    aura_env.nuTimer(remaining, saved.count, nil, saved.text)\n    aura_env.preWarn(remaining, nil, saved.count)\nend",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["custom_type"] = "stateupdate",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(allstates, event, ...)\n    if event == \"STATUS\" then\n        local instanceID = select(8, GetInstanceInfo())\n        if instanceID ~= 534 then\n            return false\n        end\n        \n        local currentWave, widgetID, text = aura_env.getCurrentWave()\n        local enemies = aura_env.getInvadingEnemies()\n        \n        if currentWave and currentWave > 0 then\n            aura_env.debugPrint(\"STATUS: Active widget\", widgetID, text)\n            if aura_env.boss == 0 then\n                local saved = aura_env.saved.hyjalWaveTimer\n                if saved and aura_env.bossData[saved.boss] then\n                    aura_env.boss = saved.boss\n                else\n                    aura_env.updateBossFromLockout()\n                end\n            end\n            aura_env.recoverWave(currentWave)\n        elseif enemies > 0 then\n            aura_env.debugPrint(\"STATUS: Wave widget unavailable, invading enemies:\", enemies)\n            local saved = aura_env.saved.hyjalWaveTimer\n            if saved and saved.count and saved.boss and aura_env.bossData[saved.boss] then\n                local savedWave = saved.count == \"boss\" and 8 or saved.count - 1\n                \n                aura_env.boss = saved.boss\n                aura_env.recoverWave(savedWave)\n            else\n                aura_env.debugPrint(\"STATUS: Active enemies, but no recoverable wave state\")\n                aura_env.updateBossFromLockout()\n            end\n        else\n            aura_env.debugPrint(\"STATUS: No wave and no invading enemies - resetting\")\n            aura_env.resetWaves()\n            aura_env.boss = 0\n        end\n        RequestRaidInfo()\n        return false\n    end\n    \n    if event == \"PLAYER_ENTERING_WORLD\" then\n        local instanceID = select(8, GetInstanceInfo())\n        if instanceID == 534 then\n            aura_env.boss = 0\n            aura_env.lastWave = 0\n            RequestRaidInfo()\n        else\n            aura_env.resetWaves()\n            aura_env.boss = 0\n        end\n        return false\n    end\n    \n    if event == \"UPDATE_INSTANCE_INFO\" then\n        if select(8, GetInstanceInfo()) == 534 then\n            aura_env.updateBossFromLockout()\n            aura_env.debugPrint(\"Test boss override:\", aura_env.boss)\n        end\n        return false\n    end\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local _, subEvent, _, _, _, _, _, destGUID = ...\n        if subEvent ~= \"UNIT_DIED\" then\n            return false\n        end\n        \n        local npcID = select(6, strsplit(\"-\", destGUID))\n        \n        if npcID == \"17852\" or npcID == \"17772\" then\n            aura_env.debugPrint(\"Leader died:\", npcID)\n            aura_env.resetWaves()\n        elseif npcID == \"17767\" then\n            aura_env.boss = 2\n            aura_env.debugPrint(\"Next boss: Anetheron\")\n        elseif npcID == \"17808\" then\n            aura_env.boss = 3\n            aura_env.debugPrint(\"Next boss: Kaz'rogal\")\n        elseif npcID == \"17888\" then\n            aura_env.boss = 4\n            aura_env.debugPrint(\"Next boss: Azgalor\")\n        end\n        return false\n    end\n    \n    if event == \"UPDATE_UI_WIDGET\" then\n        local widgetData = ...\n        if not widgetData then\n            return false\n        end\n        \n        local widgetID = widgetData.widgetID\n        if widgetID ~= 528 and widgetID ~= 3121 then\n            return false\n        end\n        \n        if select(8, GetInstanceInfo()) ~= 534 then\n            return false\n        end\n        \n        aura_env.updateBossFromLockout()\n        if aura_env.boss == 0 then\n            RequestRaidInfo()\n            return false\n        end\n        \n        local widgetInfo = C_UIWidgetManager.GetIconAndTextWidgetVisualizationInfo(widgetID)\n        local text = widgetInfo and widgetInfo.text\n        if not text then\n            return false\n        end\n        \n        local currentWave = tonumber(text:match(\"(%d+)\"))\n        if currentWave == nil then\n            return false\n        end\n        \n        aura_env.debugPrint(\"Widget:\", text)\n        aura_env.waveFunction(currentWave)\n    end\n    return false\nend",
