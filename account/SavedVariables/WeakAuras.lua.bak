["url"] = "https://wago.io/FojjiBT-P2/10",
["actions"] = {
["start"] = {
["message"] = "{rt8} Impale on %c!",
["custom"] = "if aura_env.ticker then\n    aura_env.ticker:Cancel()\nend\n\naura_env.ticker = C_Timer.NewTicker(2,function()\n        SendChatMessage(\"{rt8} Free ME\",\"SAY\")\nend)\n\nif aura_env.anyoneTimer then\n    aura_env.anyoneTimer:Cancel()\nend\n\naura_env.anyoneTimer = C_Timer.NewTimer(10,function()\n        SendChatMessage(\"Anyone?\",\"SAY\")\n        aura_env.anyoneTimer = nil\nend)\n\nC_VoiceChat.SpeakText(_G.FJITTS_SFX_VOICEID,\"Impaled\",_G.FJITTS_SFX_RATE,_G.FJITTS_SFX_VOLUME,true)",
["message_custom"] = "function()\n    return WeakAuras.me\nend",
