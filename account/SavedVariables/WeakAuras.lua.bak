["displayText_format_p_time_precision"] = 1,
["customText"] = "function()\n    if aura_env.states[1] and aura_env.states[1].stacks then\n        return aura_env.states[1].stacks * 50\n    end\nend",
["shadowYOffset"] = -1,
["displayText_format_t_format"] = "timed",
["desaturateBackground"] = false,
["cooldownSwipe"] = true,
["endAngle"] = 360,
["sparkRotationMode"] = "AUTO",
["cooldownEdge"] = false,
["desaturateForeground"] = false,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["custom_type"] = "stateupdate",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(allstates,event,...)\n    if event == \"OPTIONS\" then\n        local composition = {\n            {count = 10, name = \"Ghouls\"},\n            {count = 5, name = \"Banshees\"},\n            {count = 4, name = \"Necromancers\"},\n            {count = 2, name = \"Crypt Fiends\"},\n            {count = 2, name = \"Abominations\"},\n        }\n        \n        local counts = {}\n        \n        for _, mob in ipairs(composition) do\n            counts[mob.name] = math.random(0, mob.count)\n        end\n        \n        return aura_env.updateState(allstates, composition, counts)\n    end\n    \n    if event == \"STATUS\" then\n        aura_env.restoreWave()\n        return false\n    end\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local _,subEvent,_,_,_,_,_,destGUID = ...\n        \n        if subEvent ~= \"UNIT_DIED\" then\n            return false\n        end\n        \n        local npcID = select(6, strsplit(\"-\", destGUID))\n        \n        if not aura_env.npcLookup[npcID] then\n            return false\n        end\n        \n        return aura_env.processDeath(allstates, destGUID, true)\n    end\n    \n    if event == \"WA_FJI_HYJAL_MOB_DIED_SYNC\" then\n        local bossWave, waveCount, destGUID = ...\n        \n        if bossWave ~= aura_env.bossWave or waveCount ~= aura_env.waveCount then\n            return false\n        end\n        \n        return aura_env.processDeath(allstates, destGUID, false)\n    end\n    \n    if event == \"WA_FJI_HYJAL_WAVE\" then\n        local bossWave, status, waveCount, composition = ...\n        \n        if status == \"spawn\" then\n            aura_env.clearWave()\n            return aura_env.hideState(allstates)\n        end\n        \n        if status ~= \"current\" or not composition then\n            return false\n        end\n        \n        local saved = aura_env.saved.hyjalMobWave\n        \n        if saved and saved.bossWave == bossWave and saved.waveCount == waveCount then\n            aura_env.restoreWave()\n            return aura_env.updateState(allstates, composition, saved.counts)\n        end\n        \n        aura_env.startWave(bossWave, waveCount, composition)\n        return aura_env.updateState(allstates, composition)\n    end\n    \n    if event == \"WA_FJI_HYJAL_WIPE\" then\n        aura_env.clearWave()\n        return aura_env.hideState(allstates)\n    end\n    \n    return false\nend",
["events"] = "ENCOUNTER_START, WA_FJI_HYJAL_WAVE, WA_FJI_HYJAL_WIPE, CLEU:UNIT_DIED, WA_FJI_HYJAL_MOB_DIED_SYNC, WA_FJI_HYJAL_PROCESS_DEATHS",
["spellIds"] = {
},
["names"] = {
},
["check"] = "event",
["subeventPrefix"] = "SPELL",
["debuffType"] = "HELPFUL",
["customVariables"] = "{\n    count = \"number\",\n}",
},
