},
["init"] = {
["custom"] = "aura_env.absorbSpells = {\n    [17] = 43, -- [Priest] Power Word: Shield (Rank 1)\n    [10901] = 941, -- [Priest] Power Word: Shield (Rank 10)\n    [27607] = 941, -- [Priest] Power Word: Shield (Rank 10)\n    [592] = 87, -- [Priest] Power Word: Shield (Rank 2)\n    [600] = 157, -- [Priest] Power Word: Shield (Rank 3)\n    [3747] = 233, -- [Priest] Power Word: Shield (Rank 4)\n    [6065] = 300, -- [Priest] Power Word: Shield (Rank 5)\n    [6066] = 380, -- [Priest] Power Word: Shield (Rank 6)\n    [10898] = 483, -- [Priest] Power Word: Shield (Rank 7)\n    [10899] = 604, -- [Priest] Power Word: Shield (Rank 8)\n    [10900] = 762, -- [Priest] Power Word: Shield (Rank 9)\n    [20706] = 499, -- [Priest] Power Word: Shield 500 (Rank 7)\n    [25217] = 1144, -- [Priest] Power Word: Shield (Rank 11)\n    [25218] = 1265, -- [Priest] Power Word: Shield (Rank 12)\n}\n\nlocal function update(state, amount)\n    state.value = state.value - amount\n    state.show = state.value > 0\n    state.changed = true\n    return true\nend\n\nfunction aura_env.WA_FJI_ABSORB_APPLIED(allStates, total, spellId)\n    if not aura_env.absorbSpells[spellId] then\n        return\n    end\n    \n    allStates[\"\"] = {\n        show = true,\n        changed = true,\n        progressType = \"static\",\n        value = total,\n        total = total,\n    }\n    return true\nend\n\nfunction aura_env.WA_FJI_ABSORB_REMOVED(allStates, spellId)\n    if not aura_env.absorbSpells[spellId] then\n        return\n    end\n    \n    allStates[\"\"] = {\n        show = true,\n        changed = true,\n        progressType = \"static\",\n        value = total,\n        total = total,\n    }\n    return true\nend\n\nfunction aura_env.WA_FJI_ABSORB_UPDATE(allStates, amount, spellId)\n    if not aura_env.absorbSpells[spellId] then\n        return\n    end\n    local state = allStates[\"\"]\n    if state then\n        return update(state, amount)\n    end\nend\n\nfunction aura_env.OPTIONS(allStates)\n    allStates[\"\"] = {\n        show = true,\n        changed = true,\n        progressType = \"static\",\n        value = math.random(1, 826),\n        total = 826,\n    }\n    return true\nend\n\nfunction aura_env.STATUS(allStates)\n    return\nend",
["do_custom"] = true,
},
