["[T4] Respond - Version Check"] = {
["outline"] = "OUTLINE",
["wagoID"] = "ASKpBvm6n",
["parent"] = "[T4] Version Check",
["displayText"] = "",
["shadowYOffset"] = -1,
["anchorPoint"] = "CENTER",
["displayText_format_name_pad"] = false,
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
["message_type"] = "RAID",
["message"] = "",
["do_message"] = false,
["do_custom"] = false,
},
["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.respond = \"WA_FJI_T4_VERSION_CHECK_RESPOND\"\naura_env.request = \"WA_FJI_T4_VERSION_CHECK_REQUEST\"\naura_env.version = \"1.0.0\"",
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["custom_hide"] = "timed",
["duration"] = "1",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["unit"] = "player",
["custom"] = "function(a, e, msg, _, _, _, _, _, _, _, _, _, _, guid)\n    if e == aura_env.request then\n        local raidLeader = nil\n        local index = nil\n        \n        for i = 1, GetNumGroupMembers() do\n            local unit = \"raid\" .. i\n            if UnitExists(unit) then\n                if UnitIsGroupLeader(unit) then\n                    raidLeader = UnitName(unit)\n                end\n                if UnitIsUnit(unit, \"player\") then\n                    index = i\n                end\n            end\n        end\n        \n        local delay = (index / 10)\n        C_Timer.After(delay / 10, function()\n                _G.SyncEvents(\"RAID\", raidLeader, aura_env.respond, WeakAuras.me, aura_env.version)\n        end)\n    end\nend",
["events"] = "WA_FJI_T4_VERSION_CHECK_REQUEST",
["spellIds"] = {
},
["check"] = "event",
["subeventSuffix"] = "_CAST_START",
