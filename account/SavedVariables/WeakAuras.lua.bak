["custom"] = "function(allstates, event)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 19,\n            expirationTime = GetTime() + 19,\n            progressType = \"timed\",\n            icon = 135506,\n            autoHide = true,\n        }\n        return true\n    end\n    \n    if event == \"WA_ALAR_P1_END\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 19,\n            expirationTime = GetTime() + 19,\n            progressType = \"timed\",\n            icon = 135506,\n            autoHide = true,\n        }\n        return true\n    end\nend",
