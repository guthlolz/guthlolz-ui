["subeventPrefix"] = "SPELL",
["events"] = "CLEU:SPELL_CAST_SUCCESS",
["custom"] = "function(a,event,_,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId,_,_,extraSpellId)\n    if event == \"OPTIONS\" then\n        a[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            autoHide = true,\n            icon = 136121,\n            name = WeakAuras.myGUID,\n        }\n        return true\n    end\n    \n    if spellId ~= 34436 then\n        return false\n    end\n    \n    if subEvent == \"SPELL_CAST_SUCCESS\" then\n        for _, plateData in pairs(C_NamePlate.GetNamePlates()) do\n            local unit = plateData.UnitFrame.displayedUnit\n            if UnitGUID(unit) == sourceGUID then\n                a[unit] = {\n                    show = true,\n                    changed = true,\n                    progressType = \"timed\",\n                    duration = 2,\n                    expirationTime = GetTime() + 2,\n                    autoHide = true,\n                    icon = GetSpellTexture(spellId),\n                    name = sourceGUID,\n                    unit = unit,\n                }\n                return true\n            end\n        end\n    end\nend",
["unit"] = "player",
