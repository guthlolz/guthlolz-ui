["spellIds"] = {
},
["custom"] = "function(allstates,event,guid)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 2,\n            expirationTime = GetTime()+2,\n            progressType = \"timed\",\n            icon = 132369,\n            autoHide = true,\n        }\n        return true\n    end\n    \n    if event ~= \"WA_WEAPONMASTER_WW\" then\n        return false\n    end\n    \n    allstates[guid] = {\n        show = true,\n        changed = true,\n        duration = 2,\n        expirationTime = GetTime()+2,\n        progressType = \"timed\",\n        icon = 132369,\n        autoHide = true,\n    }\n    \n    return true\nend",
["events"] = "WA_WEAPONMASTER_WW",
["check"] = "event",
