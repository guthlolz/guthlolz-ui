["check"] = "event",
["custom"] = "function(allstates,event,...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"static\",\n            direction = \"RIGHT\",\n        }\n        return true\n    end\n    \n    if event == \"WA_MOTHER_SHAHRAZ_FATAL\" then\n        local _,name2 = ...\n        if WeakAuras.me ~= name2 then\n            return false\n        end\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"static\",\n            direction = \"RIGHT\",\n        }\n        return true\n    end\nend",
