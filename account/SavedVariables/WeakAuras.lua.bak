["automaticWidth"] = "Auto",
["desaturateForeground"] = false,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, ...)\n    if event == \"WA_KAELTHAS_P4_START\" then\n        aura_env.pendingCasts = {}\n        aura_env.assigned = {}\n        \n        for guid, state in pairs(allstates) do\n            state.show = false\n            state.changed = true\n        end\n        return true\n    end\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local _,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId = ...\n        \n        if subEvent == \"UNIT_DIED\" then\n            local npcID = select(6, strsplit(\"-\", destGUID))\n            \n            if npcID == \"21364\" then\n                WeakAuras.ScanEvents(\"WA_KAELTHAS_REBIRTH_CANCEL\")\n                tremove(aura_env.pendingCasts, 1)\n            end\n        end\n        \n        if subEvent ~= \"SPELL_CAST_SUCCESS\" then\n            return false\n        end\n        \n        if spellId ~= 34341 then\n            return false\n        end\n        WeakAuras.ScanEvents(\"WA_KAELTHAS_REBIRTH\")\n        tinsert(aura_env.pendingCasts, GetTime() + 15)\n        return false\n    end\n    \n    if event == \"NAME_PLATE_UNIT_ADDED\" then\n        local unit = ...\n        local guid = UnitGUID(unit)\n        if not guid then\n            return false\n        end\n        \n        local npcID = aura_env.getNpcID(guid)\n        if npcID ~= aura_env.npcID then\n            return false\n        end\n        \n        local now = GetTime()\n        local expire = aura_env.assigned[guid]\n        \n        if expire and expire > now then\n            allstates[guid] = {\n                show = true,\n                changed = true,\n                unit = unit,\n                guid = guid,\n                progressType = \"timed\",\n                duration = expire - now,\n                expirationTime = expire,\n                autoHide = true,\n            }\n            return true\n        end\n        \n        if expire and expire <= now then\n            aura_env.assigned[guid] = nil\n        end\n        \n        expire = aura_env.getNextPendingCast()\n        if not expire then\n            return false\n        end\n        \n        if expire <= now then\n            return false\n        end\n        \n        aura_env.assigned[guid] = expire\n        \n        allstates[guid] = {\n            show = true,\n            changed = true,\n            unit = unit,\n            guid = guid,\n            progressType = \"timed\",\n            duration = expire - now,\n            expirationTime = expire,\n            autoHide = true,\n        }\n        return true\n    end\n    \n    if event == \"NAME_PLATE_UNIT_REMOVED\" then\n        local unit = ...\n        \n        for guid, state in pairs(allstates) do\n            if state.unit == unit and state.show then\n                state.show = false\n                state.changed = true\n                state.unit = nil\n                return true\n            end\n        end\n        \n        return false\n    end\nend",
["spellIds"] = {
},
["events"] = "WA_KAELTHAS_P4_START NAME_PLATE_UNIT_ADDED NAME_PLATE_UNIT_REMOVED CLEU:SPELL_CAST_SUCCESS:UNIT_DIED",
["check"] = "event",
["unit"] = "player",
["custom_hide"] = "timed",
["customVariables"] = "{\n    expirationTime = true,\n}",
