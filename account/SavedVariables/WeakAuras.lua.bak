0.80000001192093,
},
["fontFlags"] = "OUTLINE",
["displayText_format_p_time_mod_rate"] = true,
["enableGradient"] = false,
["keepAspectRatio"] = false,
["wordWrap"] = "WordWrap",
["adjustedMax"] = "",
["anchorPoint"] = "CENTER",
["barColor"] = {
0.098039224743843,
0.80784320831299,
1,
1,
},
["desaturate"] = false,
["rotation"] = 0,
["font"] = "Homespun",
["sparkOffsetY"] = 0,
["actions"] = {
["start"] = {
["custom"] = "",
["do_custom"] = false,
["sound"] = "Interface\\AddOns\\WeakAuras\\Media\\Sounds\\BikeHorn.ogg",
["do_sound"] = false,
},
["finish"] = {
},
["init"] = {
["custom"] = "aura_env.key = \"KAZROGAL_MARK\"\naura_env.spellID = 31447\n\naura_env.markDrain = 3000\naura_env.markDrainPerTick = 600\naura_env.markTicks = 5\naura_env.markDuration = 5\n\naura_env.pullStart = nil\naura_env.nextMarkAt = nil\n\naura_env.preWarnActive = false\naura_env.hasMark = false\naura_env.markAppliedAt = nil\n\naura_env.nextMarkDeadly = false\naura_env.markExplode = false\n\nfunction aura_env.getTicksRemaining(now)\n    if not aura_env.hasMark or not aura_env.markAppliedAt then\n        return 0\n    end\n    \n    local elapsed = now - aura_env.markAppliedAt\n    return math.max(aura_env.markTicks - math.floor(elapsed),0)\nend\n\nfunction aura_env.setNextMarkDeadly(value)\n    if aura_env.nextMarkDeadly == value then\n        return\n    end\n    \n    aura_env.nextMarkDeadly = value\n    WeakAuras.ScanEvents(\"WA_KAZROGAL_NEXT_MARK_DEADLY\",value)\nend\n\nfunction aura_env.setMarkExplode(value)\n    if aura_env.markExplode == value then\n        return\n    end\n    \n    aura_env.markExplode = value\n    WeakAuras.ScanEvents(\"WA_KAZROGAL_MARK_EXPLODE\",value)\nend\n\nfunction aura_env.updateWarnings()\n    if not aura_env.pullStart then\n        return\n    end\n    \n    local now = GetTime()\n    local mana = UnitPower(\"player\",0)\n    \n    if mana > aura_env.markDrain then\n        aura_env.setNextMarkDeadly(false)\n        aura_env.setMarkExplode(false)\n        return\n    end\n    \n    if aura_env.hasMark then\n        local ticksRemaining = aura_env.getTicksRemaining(now)\n        local deadly = mana <= ticksRemaining * aura_env.markDrainPerTick\n        \n        aura_env.setNextMarkDeadly(false)\n        aura_env.setMarkExplode(deadly)\n        return\n    end\n    \n    if aura_env.preWarnActive then\n        aura_env.setNextMarkDeadly(false)\n        aura_env.setMarkExplode(true)\n        return\n    end\n    \n    aura_env.setMarkExplode(false)\n    \n    local timeToMark = aura_env.nextMarkAt and aura_env.nextMarkAt - now\n    \n    if timeToMark and timeToMark >= 5 then\n        aura_env.setNextMarkDeadly(true)\n    else\n        aura_env.setNextMarkDeadly(false)\n    end\nend\n\nfunction aura_env.resetWarnings()\n    aura_env.setNextMarkDeadly(false)\n    aura_env.setMarkExplode(false)\nend",
["do_custom"] = true,
},
},
