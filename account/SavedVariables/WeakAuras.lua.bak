},
["events"] = "STATUS UNIT_INVENTORY_CHANGED:player",
["custom"] = "function(allstates, event)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            count = math.random(1, 20),\n            icon = 134830,\n        }\n        return true\n    end\n    \n    local count, icon = 0, nil\n    local selectedPotion = aura_env.getPotion(aura_env.config.option.potion)\n    \n    if selectedPotion then\n        count = GetItemCount(selectedPotion.id)\n        if count > 0 then\n            icon = selectedPotion.icon\n        end\n    end\n    \n    if not icon then\n        for _, item in ipairs(aura_env.itemIds) do\n            count = GetItemCount(item.id)\n            if count > 0 then\n                icon = item.icon\n                break\n            end\n        end\n    end\n    \n    allstates[\"\"] = {\n        show = count > 0,\n        changed = true,\n        count = count,\n        icon = icon,\n    }\n    return true\nend",
