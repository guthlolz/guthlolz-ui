["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            progressType = \"timed\",\n            icon = 135777,\n            autoHide = true,\n            channel = true,\n        }\n        return true\n    end\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local _,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId = ...\n        \n        if subEvent == \"UNIT_DIED\" then\n            if allstates[destGUID] then\n                allstates[destGUID].show = false\n                allstates[destGUID].changed = true\n                return true\n            end\n        end\n        \n        if spellId ~= 40938 then\n            return false\n        end\n        \n        if subEvent == \"SPELL_CAST_START\" then\n            allstates[sourceGUID] = {\n                show = true,\n                changed = true,\n                duration = 2,\n                expirationTime = GetTime() + 2,\n                progressType = \"timed\",\n                icon = 135777,\n                autoHide = true,\n                channel = false,\n            }\n            return true\n        elseif subEvent == \"SPELL_CAST_SUCCESS\" then\n            allstates[sourceGUID] = {\n                show = true,\n                changed = true,\n                duration = 3,\n                expirationTime = GetTime() + 3,\n                progressType = \"timed\",\n                icon = 135777,\n                autoHide = true,\n                channel = true,\n            }\n            return true\n        end\n    end\nend",
