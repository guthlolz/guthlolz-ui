["custom"] = "local locale = GetLocale()\n\naura_env.locales = {\n    [\"enUS\"] = {\n        subZone = \"Night Elf Village\",\n    },\n    [\"frFR\"] = {\n        subZone = \"Village elfe de la nuit\",\n    },\n    [\"deDE\"] = {\n        subZone = \"Nachtelfendorf\",\n    },\n    [\"esES\"] = {\n        subZone = \"Villa Elfo de la Noche\",\n    },\n    [\"koKR\"] = {\n        subZone = \"나이트 엘프 마을\",\n    },\n    [\"ptBR\"] = {\n        subZone = \"Vila dos Elfos Noturnos\",\n    },\n    [\"ruRU\"] = {\n        subZone = \"Деревня ночных эльфов\",\n    },\n    [\"zhCN\"] = {\n        subZone = \"暗夜精灵村庄\",\n    },\n    [\"zhTW\"] = {\n        subZone = \"夜精靈村\",\n    }\n}\n\naura_env.currentLocale = aura_env.locales[locale] or aura_env.locales[\"enUS\"]\n\n",
["do_custom"] = true,
},
},
