["custom"] = "function(allstates, event, key, time, count)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 1.5,\n            expirationTime = GetTime() + 1.5,\n            autoHide = true,\n            icon = 135826,\n        }\n        return true\n    end\n    \n    if event == \"WA_NUMEN_TIMER\" then\n        if key == \"ILLIDARI_FLAMESTRIKE\" and time == 0 then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = 1.5,\n                expirationTime = GetTime() + 1.5,\n                autoHide = true,\n                icon = 135826,\n            }\n            return true\n        end\n    end\nend",
