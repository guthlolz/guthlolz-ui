["custom"] = "function(allstates,event,_,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 3,\n            expirationTime = GetTime() + 3,\n            autoHide = false,\n            damage = 5,\n        }\n        return true\n    end\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        if subEvent ~= \"SPELL_AURA_APPLIED\" or spellId ~= 41337 or destGUID ~= WeakAuras.myGUID then\n            return false\n        end\n        \n        if aura_env.ticker then\n            aura_env.ticker:Cancel()\n        end\n        \n        aura_env.damage = 5\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 3,\n            expirationTime = GetTime() + 3,\n            autoHide = false,\n            damage = aura_env.damage,\n        }\n        \n        aura_env.ticker = C_Timer.NewTicker(3, function()\n            WeakAuras.ScanEvents(\"WA_RELIQUARY_ANGER_UPDATE\")\n        end)\n        \n        return true\n    end\n    \n    if event == \"WA_RELIQUARY_ANGER_UPDATE\" then\n        aura_env.damage = (aura_env.damage or 5) + 5\n        \n        allstates[\"\"].damage = aura_env.damage\n        allstates[\"\"].duration = 3\n        allstates[\"\"].expirationTime = GetTime() + 3\n        allstates[\"\"].changed = true\n        return true\n    end\nend",
["subeventPrefix"] = "SPELL",
["debuffType"] = "HELPFUL",
},
