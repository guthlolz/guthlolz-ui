["triggers"] = {
{
["trigger"] = {
["customVariables"] = "{\n    expirationTime = true\n}",
["type"] = "custom",
["custom_type"] = "stateupdate",
["subeventSuffix"] = "_CAST_START",
["names"] = {
},
["duration"] = "",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(allstates,event,...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 5,\n            expirationTime = GetTime()+5,\n            icon = aura_env.icon,\n            name = aura_env.name,\n        }\n        return true\n    end\n    \n    if event == \"WA_\" .. aura_env.e .. \"_PREWARN\" then\n        local guid,count = ...\n        local duration = aura_env.preWarnDuration\n        \n        aura_env.activePrewarns[guid] = {\n            duration = duration,\n            expirationTime = GetTime()+duration,\n            count = count,\n        }\n        \n        aura_env.scheduleFallback(guid,duration+aura_env.fallbackTime)\n        \n        if UnitGUID(\"target\") ~= guid then\n            return false\n        end\n        \n        allstates[guid] = {\n            show = true,\n            changed = true,\n            duration = duration,\n            expirationTime = aura_env.activePrewarns[guid].expirationTime,\n            progressType = \"timed\",\n            icon = aura_env.icon,\n            name = aura_env.name,\n            guid = guid,\n            count = count,\n        }\n        return true\n    end\n    \n    if event == \"PLAYER_TARGET_CHANGED\" then\n        local targetGUID = UnitGUID(\"target\")\n        \n        for guid,state in pairs(allstates) do\n            if guid ~= \"\" and state.show and guid ~= targetGUID then\n                state.show = false\n                state.changed = true\n            end\n        end\n        \n        if targetGUID then\n            local prewarn = aura_env.activePrewarns[targetGUID]\n            \n            if prewarn and prewarn.expirationTime > GetTime() then\n                allstates[targetGUID] = {\n                    show = true,\n                    changed = true,\n                    duration = prewarn.duration,\n                    expirationTime = prewarn.expirationTime,\n                    progressType = \"timed\",\n                    icon = aura_env.icon,\n                    name = aura_env.name,\n                    guid = targetGUID,\n                    count = prewarn.count,\n                }\n            end\n        end\n        return true\n    end\n    \n    if event == \"WA_NUMEN_TIMER\" then\n        local key,time,_,guid = ...\n        \n        if key ~= aura_env.timerKey or (time ~= 0 and time ~= nil) or not guid then\n            return false\n        end\n        \n        aura_env.cancelFallback(guid)\n        aura_env.activePrewarns[guid] = nil\n        \n        if allstates[guid] then\n            allstates[guid].show = false\n            allstates[guid].changed = true\n            return true\n        end\n    end\n    \n    if event == \"WA_\" .. aura_env.e .. \"_PREWARN_CANCEL\" or event == \"WA_\" .. aura_env.e .. \"_PREWARN_FALLBACK\" then\n        local guid = ...\n        \n        if not guid then\n            return false\n        end\n        \n        aura_env.cancelFallback(guid)\n        aura_env.activePrewarns[guid] = nil\n        \n        if allstates[guid] then\n            allstates[guid].show = false\n            allstates[guid].changed = true\n            return true\n        end\n    end\nend",
["events"] = "WA_TORMENT_SHELL_PREWARN WA_TORMENT_SHELL_PREWARN_CANCEL WA_TORMENT_SHELL_PREWARN_FALLBACK WA_NUMEN_TIMER PLAYER_TARGET_CHANGED",
