["custom_hide"] = "timed",
["names"] = {
},
["event"] = "Health",
["unit"] = "player",
["subeventSuffix"] = "_CAST_START",
["spellIds"] = {
},
["custom"] = "function(allstates, event, key, time, count)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            icon = 136017,\n            count = math.random(1,5),\n        }\n    end\n    \n    if event == \"WA_NAJENTUS_SHIELD_REMOVED\" then\n        if allstates[\"\"] then\n            allstates[\"\"].show = false\n            allstates[\"\"].changed = true\n            return true\n        end\n    end\n    \n    if event == \"WA_NUMEN_TIMER\" and key == \"NAJENTUS_SHIELD\" and time == 0 then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            icon = 136017,\n            count = count\n        }\n        return true\n    end\nend",
["events"] = "WA_NUMEN_TIMER, WA_NAJENTUS_SHIELD_REMOVED",
["check"] = "event",
["subeventPrefix"] = "SPELL",
["debuffType"] = "HELPFUL",
["customVariables"] = "",
},
["untrigger"] = {
},
},
["disjunctive"] = "any",
["customTriggerLogic"] = "",
["activeTriggerMode"] = -10,
},
["displayText_format_p_format"] = "timed",
["displayText_format_p_time_legacy_floor"] = false,
["wordWrap"] = "WordWrap",
["animation"] = {
["start"] = {
["translateType"] = "bounce",
["use_scale"] = true,
["duration"] = "0.3",
["colorB"] = 1,
["alphaType"] = "straight",
["colorA"] = 1,
["colorG"] = 0,
["alphaFunc"] = "function(progress, start, delta)\n    return start + (progress * delta)\nend\n",
["rotate"] = 0,
["duration_type"] = "seconds",
["use_translate"] = true,
["use_alpha"] = false,
["scaleFunc"] = "function(progress, startX, startY, scaleX, scaleY)\n    local angle = (progress * 2 * math.pi) - (math.pi / 2)\n    return startX + (((math.sin(angle) + 1)/2) * (scaleX - 1)), startY + (((math.sin(angle) + 1)/2) * (scaleY - 1))\nend\n",
["type"] = "custom",
["scaley"] = 1.3,
["easeType"] = "none",
["translateFunc"] = "function(progress, startX, startY, deltaX, deltaY)\n    local bounceDistance = math.sin(progress * math.pi)\n    return startX + (bounceDistance * deltaX), startY + (bounceDistance * deltaY)\nend\n",
["use_color"] = false,
["alpha"] = 1,
["x"] = 0,
["y"] = -1,
["colorType"] = "pulseColor",
["preset"] = "bounceDecay",
["scaleType"] = "pulse",
["colorFunc"] = "function(progress, r1, g1, b1, a1, r2, g2, b2, a2)\n    local angle = (progress * 2 * math.pi) - (math.pi / 2)\n    local newProgress = ((math.sin(angle) + 1)/2);\n    return r1 + (newProgress * (r2 - r1)),\n         g1 + (newProgress * (g2 - g1)),\n         b1 + (newProgress * (b2 - b1)),\n         a1 + (newProgress * (a2 - a1))\nend\n",
["easeStrength"] = 5,
["colorR"] = 0.97254908084869,
["scalex"] = 1.3,
},
["main"] = {
["colorR"] = 1,
["duration_type"] = "seconds",
["colorA"] = 1,
["colorG"] = 0.55686277151108,
["type"] = "none",
["easeType"] = "none",
