["custom"] = "function(allstates,event,_,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            autoHide = true,\n            guid = WeakAuras.myGUID,\n            icon = 136206\n        }\n        return true\n    end\n    \n    if spellId ~= 37122 then\n        return false\n    end\n    \n    allstates[destGUID] = {\n        show = true,\n        changed = true,\n        progressType = \"timed\",\n        duration = 2.5,\n        expirationTime = GetTime() + 2.5,\n        autoHide = true,\n        guid = destGUID,\n        icon = 136206,\n        isPlayer = destGUID == WeakAuras.myGUID\n    }\n    return true\nend",
