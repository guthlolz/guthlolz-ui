["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["custom_hide"] = "timed",
["names"] = {
},
["event"] = "Health",
["unit"] = "player",
["subeventSuffix"] = "_CAST_START",
["spellIds"] = {
},
["custom"] = "function(allstates,event,key,time,count,spellId)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            icon = GetSpellTexture(41469),\n            name = \"Seal of Command\",\n            count = math.random(1,5),\n        }\n        return true\n    end\n    \n    if not _G.FJI_TANK and not _G.FJI_HEALER and not UnitIsGroupLeader(\"player\") then\n        return false\n    end\n    \n    if event == \"WA_NUMEN_TIMER\" and key == \"ILLIDARI_SEAL\" and time == 0 then\n        local name\n        \n        if spellId ~= 41469 then\n            return false\n        end\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 2,\n            expirationTime = GetTime()+2,\n            progressType = \"timed\",\n            icon = GetSpellTexture(spellId),\n            name = \"Seal of Command\",\n            autoHide = true,\n            count = count\n        }\n        return true\n    end\nend",
["events"] = "WA_NUMEN_TIMER",
["check"] = "event",
["subeventPrefix"] = "SPELL",
["debuffType"] = "HELPFUL",
["customVariables"] = "{\n    name = \"string\",\n}",
},
