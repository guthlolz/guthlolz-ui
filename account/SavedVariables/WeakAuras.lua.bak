},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, guid)\n    if event == \"OPTIONS\" then\n        for i = 1,2 do\n            allstates[i] = {\n                show = true,\n                changed = true,\n                name = WeakAuras.myGUID,\n                index = i,\n            }\n        end\n        return true\n    end\n    \n    if event ~= \"WA_LEOTHERAS_INNER_DEMON_APPLIED\" then\n        return false\n    end\n    \n    if allstates[guid] then\n        return false\n    end\n    \n    allstates[guid] = {\n        show = true,\n        changed = true,\n        duration = 2.5,\n        progressType = \"timed\",\n        name = guid,\n        autoHide = true,\n    }\n    \n    for _, state in pairs(allstates) do\n        state.changed = true\n        state.expirationTime = GetTime() + 2.5\n    end\n    \n    return true\nend",
