["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_hide"] = "timed",
["custom_type"] = "stateupdate",
["subeventSuffix"] = "_CAST_START",
["duration"] = "20",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(allstates,event,_,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId)\n    if event == \"OPTIONS\" then\n        local spellIDs = {}\n        \n        for id in pairs(aura_env.spellIDs) do\n            spellIDs[#spellIDs + 1] = id\n        end\n        \n        for i = 1,2 do\n            local randomSpellID = spellIDs[math.random(#spellIDs)]\n            \n            allstates[i] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = 2,\n                expirationTime = GetTime() + 2,\n                autoHide = true,\n                guid = WeakAuras.myGUID,\n                icon = GetSpellTexture(randomSpellID),\n                isPlayer = i == 1,\n            }\n        end\n        return true\n    end\n    \n    if not aura_env.spellIDs[spellId] then\n        return false\n    end\n    \n    allstates[destGUID] = {\n        show = true,\n        changed = true,\n        progressType = \"timed\",\n        duration = 2.5,\n        expirationTime = GetTime() + 2.5,\n        autoHide = true,\n        guid = destGUID,\n        icon = GetSpellTexture(spellId),\n        isPlayer = destGUID == WeakAuras.myGUID,\n    }\n    return true\nend",
