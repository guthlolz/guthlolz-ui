["start"] = {
},
["finish"] = {
},
["init"] = {
["custom"] = "aura_env.unsafe = false\naura_env.edge = false\n\nfunction aura_env.checkTicker(allstates)\n    local active = false\n    for unit, state in pairs(allstates) do\n        if state.show then\n            active = true\n            break\n        end\n    end\n    \n    if not active and aura_env.ticker then\n        aura_env.ticker:Cancel()\n        aura_env.ticker = nil\n    end\nend\n\nfunction aura_env.updateSafety(allstates)\n    local unsafe = false\n    local edge = false\n    \n    for _, state in pairs(allstates) do\n        if state.show then\n            if state.range == 25 or state.range == 8 then\n                edge = true\n            end\n            \n            if state.isSafe == false then\n                unsafe = true\n                break\n            end\n        end\n    end\n    \n    if edge ~= aura_env.edge then\n        aura_env.edge = edge\n        \n        if edge then\n            WeakAuras.ScanEvents(\"WA_SHIELDBEARER_EDGE\")\n        else\n            WeakAuras.ScanEvents(\"WA_SHIELDBEARER_NOT_EDGE\")\n        end\n    end\n    \n    if unsafe ~= aura_env.unsafe then\n        aura_env.unsafe = unsafe\n        \n        if unsafe then\n            WeakAuras.ScanEvents(\"WA_SHIELDBEARER_NOT_SAFE\")\n        else\n            WeakAuras.ScanEvents(\"WA_SHIELDBEARER_SAFE\")\n        end\n    end\nend",
["do_custom"] = true,
},
},
