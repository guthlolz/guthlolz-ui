["event"] = "Health",
["unit"] = "player",
["subeventSuffix"] = "_CAST_START",
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = aura_env.castTime,\n            expirationTime = GetTime() + aura_env.castTime,\n            autoHide = true,\n            icon = aura_env.icon,\n        }\n        return true\n    end\n    \n    if event == \"WA_NUMEN_TIMER\" then\n        local key, time, count = ...\n        \n        if key == \"ILLIDAN_FLAME_CRASH\" then\n            if time == 0 then\n                allstates[\"\"] = {\n                    show = true,\n                    changed = true,\n                    progressType = \"timed\",\n                    duration = aura_env.castTime,\n                    expirationTime = GetTime() + aura_env.castTime,\n                    autoHide = true,\n                    icon = aura_env.icon,\n                }\n                return true\n            elseif time == nil then\n                if allstates[\"\"] then\n                    allstates[\"\"].show = false\n                    allstates[\"\"].changed = true\n                    return true\n                end\n            end\n        end\n    end\nend",
