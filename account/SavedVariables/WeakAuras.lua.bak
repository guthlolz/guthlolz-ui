["CT:[T5][Lurker] Whirl"] = {
["outline"] = "OUTLINE",
["wagoID"] = "gSs1_GQRl",
["color"] = {
1,
1,
1,
1,
},
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["shadowYOffset"] = -1,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiT5RaidPack/3",
["actions"] = {
["start"] = {
},
["finish"] = {
["custom"] = "aura_env.count = 1\naura_env.nuTimer(nil)\naura_env.preWarnCancel()",
["do_sound"] = false,
["do_message"] = false,
["do_custom"] = true,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.key = \"LURKER_WHIRL\"\naura_env.count = 1\naura_env.cdStart = 12\naura_env.cdWindow = 16\naura_env.cdAfterEmerge = 12\naura_env.cdSpout = 23\naura_env.whirl = 37660\naura_env.throttle = 0\n\nfunction aura_env.nuTimer(countdown, count)\n    WeakAuras.ScanEvents(\"WA_NUMEN_TIMER\", aura_env.key, countdown, count)\nend\n\nfunction aura_env.updateState(allstates)\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n    }\nend\n\nfunction aura_env.hideState(allstates)\n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\nend\n\nfunction aura_env.preWarn(duration, preWarnTime, count)\n    if not preWarnTime then\n        preWarnTime = 3\n    end\n    \n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\n    \n    aura_env.preWarnTimer = C_Timer.NewTimer(duration - preWarnTime, function()\n            WeakAuras.ScanEvents(\"WA_\" .. aura_env.key .. \"_PREWARN\", preWarnTime, count)\n            aura_env.preWarnTimer = nil\n    end)\nend\n\nfunction aura_env.preWarnCancel()\n    WeakAuras.ScanEvents(\"WA_\" .. aura_env.key .. \"_PREWARN_CANCEL\")\n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\nend",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates,event,...)\n    if event == \"WA_FJI_ENCOUNTER_START\" or event == \"ENCOUNTER_START\" then\n        local eID = ...\n        if eID ~= 624 then\n            return false\n        end\n        \n        aura_env.updateState(allstates)\n        aura_env.count = 1\n        \n        aura_env.preWarn(aura_env.cdStart, 2, aura_env.count)\n        aura_env.nuTimer(aura_env.cdStart, aura_env.count)\n        return true\n        \n    elseif event == \"WA_FJI_ENCOUNTER_END\" or event == \"ENCOUNTER_END\" then\n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        return true\n        \n    elseif event == \"WA_LURKER_BELOW_EMERGE\" then\n        aura_env.preWarn(aura_env.cdAfterEmerge, 2, aura_env.count)\n        aura_env.nuTimer(aura_env.cdAfterEmerge, aura_env.count)\n        return true\n        \n    elseif event == \"WA_LURKER_BELOW_SUBMERGE\" then\n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        return true\n    end\n    \n    if event == \"WA_LURKER_BELOW_SPOUT\" then\n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        aura_env.preWarn(aura_env.cdSpout, 2, aura_env.count)\n        aura_env.nuTimer(aura_env.cdSpout, aura_env.count)\n        return true\n    end\n    \n    if event == \"WA_LURKER_BELOW_WHIRL\" then\n        if GetTime() - aura_env.throttle < 5 then\n            return false\n        end\n        aura_env.throttle = GetTime()\n        \n        aura_env.nuTimer(0, aura_env.count)\n        aura_env.count = aura_env.count + 1\n        aura_env.preWarn(aura_env.cdWindow, 2, aura_env.count)\n        aura_env.nuTimer(aura_env.cdWindow, aura_env.count)\n        return true\n    end\n    \n    if event == \"UNIT_SPELLCAST_SUCCEEDED\" then\n        local unit, _, spellId = ...\n        \n        if spellId ~= aura_env.whirl then\n            return false\n        end\n        \n        if GetTime() - aura_env.throttle < 5 then\n            return false\n        end\n        aura_env.throttle = GetTime()\n        \n        _G.SyncEvents(\"RAID\", nil, \"WA_LURKER_BELOW_WHIRL\")\n        \n        aura_env.nuTimer(0, aura_env.count)\n        aura_env.count = aura_env.count + 1\n        aura_env.preWarn(aura_env.cdWindow, 2, aura_env.count)\n        aura_env.nuTimer(aura_env.cdWindow, aura_env.count)\n        return true\n    end\nend",
["spellIds"] = {
},
["events"] = "ENCOUNTER_START, ENCOUNTER_END, WA_FJI_ENCOUNTER_END, WA_FJI_ENCOUNTER_START, UNIT_SPELLCAST_SUCCEEDED, WA_LURKER_BELOW_EMERGE, WA_LURKER_BELOW_SUBMERGE, WA_LURKER_BELOW_WHIRL, WA_LURKER_BELOW_SPOUT",
["check"] = "event",
["unit"] = "player",
