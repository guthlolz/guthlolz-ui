["id"] = "SW:[T5][Tidewalker] Tidal Wave PreWarn",
["triggers"] = {
{
["trigger"] = {
["debuffType"] = "HELPFUL",
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_type"] = "stateupdate",
["subeventPrefix"] = "SPELL",
["duration"] = "",
["event"] = "Health",
["unit"] = "player",
["events"] = "WA_TIDEWALKER_TIDAL_WAVE_PREWARN, WA_TIDEWALKER_TIDAL_WAVE_CANCEL, WA_NUMEN_TIMER, WA_FJI_ENCOUNTER_END, WA_FJI_ENCOUNTER_START",
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            icon = 135836,\n        }\n        return true \n    end\n    \n    if event == \"WA_TIDEWALKER_TIDAL_WAVE_PREWARN\" then\n        local duration, count = ...\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = duration,\n            expirationTime = GetTime() + duration,\n            progressType = \"timed\",\n            icon = 135836,\n        }\n        return true\n    elseif event == \"WA_NUMEN_TIMER\" then\n        local key, time = ...\n        if key == \"TIDEWALKER_TIDAL_WAVE\" and (time == 0 or time == nil) then\n            if allstates[\"\"] then\n                allstates[\"\"].show = false\n                allstates[\"\"].changed = true\n                return true\n            end\n        end\n    elseif event == \"WA_FJI_ENCOUNTER_END\" or event == \"WA_FJI_ENCOUNTER_START\" or event == \"WA_TIDEWALKER_TIDAL_WAVE_PREWARN_CANCEL\" then\n        if allstates[\"\"] then\n            allstates[\"\"].show = false\n            allstates[\"\"].changed = true\n            return true\n        end\n    end\nend",
["spellIds"] = {
},
["customIcon"] = "function()\n    return 135789\nend",
["check"] = "event",
["names"] = {
},
["custom_hide"] = "timed",
["customVariables"] = "{\n    expirationTime = true\n}",
},
