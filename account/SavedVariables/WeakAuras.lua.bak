["custom_type"] = "event",
["check"] = "event",
["custom"] = "function(event,...)\n    local _, _, _, _, _, _, _, Id = GetInstanceInfo()\n    local auraID = \"Fojji - FojjiAPI Role [TBC]\"\n    \n    if (Id == 548 or Id == 550) then\n        if WeakAuras.GetData(auraID) == nil then\n            print(\"|cFFFF0000WARNING!|r\")\n            print(\"|cFF40C7EBFojji API Role WeakAura|r Missing. \")\n            print(\"Import from:\")\n            print(\"|cFF00FFFF|Hurl:https://wago.io/FojjiAPIRoleTBC|h[https://wago.io/FojjiAPIRoleTBC]|h|r\")\n            return true\n        end\n    end\nend",
