},
["custom"] = "function(allstates, event)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            autoHide = true,\n            icon = 135834,\n        }\n        return true\n    end\n    \n    if event == \"WA_BT_TRASH_FREEZINGTRAP\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            autoHide = true,\n            icon = 135834,\n        }\n        return true\n    end\nend",
