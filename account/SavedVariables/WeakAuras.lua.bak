["customTextUpdate"] = "event",
["displayText"] = "Use Elixir of Demonslaying?",
["desaturateForeground"] = false,
["triggers"] = {
{
["trigger"] = {
["duration"] = "2",
["unit"] = "player",
["custom_hide"] = "timed",
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["debuffType"] = "HELPFUL",
["subeventPrefix"] = "SPELL",
["event"] = "Health",
["custom_type"] = "stateupdate",
["customDuration"] = "",
["spellIds"] = {
},
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = aura_env.duration,\n            expirationTime = GetTime() + aura_env.duration,\n            autoHide = true,\n            unit = \"player\",\n            number = 1,\n        }\n        return true\n    end\n    \n    if event == \"WA_FJI_NP_NUMBER_RESET\" or event == \"WA_KAELTHAS_P4_START\" then\n        wipe(aura_env.guids)\n        wipe(aura_env.pendingGuids)\n        wipe(aura_env.names)\n        wipe(aura_env.numbers)\n        \n        aura_env.nextNumber = 1\n        aura_env.resetLocked = false\n        \n        if aura_env.batchTimer then\n            aura_env.batchTimer:Cancel()\n            aura_env.batchTimer = nil\n        end\n        \n        return true\n    end\n    \n    if event == \"WA_KAELTHAS_MIND_CONTROL_APPLIED\" then\n        local guid = ...\n        \n        if not guid then return true end\n        \n        aura_env.scheduleReset(12)\n        \n        aura_env.guids[guid] = true\n        \n        if not aura_env.numbers[guid] then\n            aura_env.pendingGuids[guid] = true\n            aura_env.names[guid] = aura_env.names[guid] or aura_env.getNameFromGUID(guid)\n            aura_env.scheduleBatch()\n        end\n        \n        return true\n    end\n    \n    if event == \"WA_FJI_NP_NUMBER_BATCH\" then\n        aura_env.assignPendingNumbers()\n        aura_env.showVisibleNameplates(allstates)\n        return true\n    end\n    \n    if event == \"WA_KAELTHAS_MIND_CONTROL_REMOVED\" then\n        local guid = ...\n        \n        if not guid then return true end\n        \n        aura_env.guids[guid] = nil\n        aura_env.pendingGuids[guid] = nil\n        \n        if allstates[guid] then\n            allstates[guid].show = false\n            allstates[guid].changed = true\n        end\n        \n        return true\n    end\n    \n    if event == \"NAME_PLATE_UNIT_ADDED\" then\n        local unit = ...\n        local guid = UnitGUID(unit)\n        \n        if guid and aura_env.guids[guid] then\n            aura_env.showState(allstates, guid, unit)\n        end\n        \n        return true\n    end\n    \n    if event == \"NAME_PLATE_UNIT_REMOVED\" then\n        local unit = ...\n        local guid = UnitGUID(unit)\n        \n        if guid and allstates[guid] then\n            allstates[guid].show = false\n            allstates[guid].changed = true\n        end\n        \n        return true\n    end\nend",
["names"] = {
},
["check"] = "event",
["events"] = "WA_KAELTHAS_P4_START, WA_KAELTHAS_MIND_CONTROL_APPLIED, WA_KAELTHAS_MIND_CONTROL_REMOVED, WA_FJI_NP_NUMBER_BATCH, WA_FJI_NP_NUMBER_RESET, NAME_PLATE_UNIT_ADDED, NAME_PLATE_UNIT_REMOVED",
["dynamicDuration"] = false,
["customVariables"] = "{\n    number = \"number\",\n}",
},
