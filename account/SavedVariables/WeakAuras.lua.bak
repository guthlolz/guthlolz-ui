["id"] = "BT:[T4][All] Boss Timers",
["icon"] = true,
["justify"] = "CENTER",
["displayIcon"] = "134153",
["anchorPoint"] = "CENTER",
["backgroundOffset"] = 2,
["outline"] = "OUTLINE",
["parent"] = "[T4]: Boss Timers #1",
["sparkOffsetX"] = 0,
["wagoID"] = "ASKpBvm6n",
["color"] = {
