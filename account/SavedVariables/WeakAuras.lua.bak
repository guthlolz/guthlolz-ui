["N:[T5][Leotheras] Whirlwind"] = {
["user_y"] = 0,
["user_x"] = 0,
["xOffset"] = 0,
["adjustedMax"] = "",
["yOffset"] = -46,
["foregroundColor"] = {
1,
0.050980396568775,
0,
1,
},
["sameTexture"] = true,
["url"] = "https://wago.io/FojjiT5RaidPack/3",
["actions"] = {
["start"] = {
},
["finish"] = {
},
["init"] = {
["custom"] = "aura_env.npcID = \"21215\"\naura_env.expirationTime = {}\naura_env.duration = {}\naura_env.safeRange = 5\n\nfunction aura_env.getNpcID(unit)\n    local guid = UnitGUID(unit)\n    if not guid then\n        return nil\n    end\n    return select(6, strsplit(\"-\", guid))\nend\n\nfunction aura_env.findUnit()\n    for _, plate in pairs(C_NamePlate.GetNamePlates()) do\n        local unit = plate.UnitFrame and plate.UnitFrame.displayedUnit\n        if unit and UnitExists(unit) and aura_env.getNpcID(unit) == aura_env.npcID then\n            return unit\n        end\n    end\nend\n\nfunction aura_env.stopTicker()\n    if aura_env.rangeTicker then\n        aura_env.rangeTicker:Cancel()\n        aura_env.rangeTicker = nil\n    end\nend\n\nfunction aura_env.startTicker()\n    aura_env.stopTicker()\n    \n    aura_env.rangeTicker = C_Timer.NewTicker(0.2, function()\n            local unit = aura_env.findUnit()\n            if not unit then\n                return\n            end\n            \n            local guid = UnitGUID(unit)\n            local range = WeakAuras.GetRange(unit)\n            local safe = (range ~= nil) and (range >= aura_env.safeRange) or false\n            \n            WeakAuras.ScanEvents(\"WA_LEOTHERAS_RANGE_CHECK\", guid, safe, range)\n    end, 60)\nend",
["do_custom"] = true,
},
},
["selfPoint"] = "CENTER",
["desaturate"] = false,
["rotation"] = 0,
["font"] = "Friz Quadrata TT",
["crop_y"] = 0.41,
["textureWrapMode"] = "CLAMPTOBLACKADDITIVE",
["startAngle"] = 0,
["useAdjustededMin"] = false,
["regionType"] = "progresstexture",
["blendMode"] = "BLEND",
["slantMode"] = "INSIDE",
["texture"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Auras\\Aura72",
["compress"] = false,
["alpha"] = 1,
["uid"] = "hm6fDg0mYmc",
["backgroundOffset"] = 2,
["wagoID"] = "gSs1_GQRl",
["parent"] = "[T5]: Nameplates",
["customText"] = "\n\n",
["desaturateBackground"] = false,
["customTextUpdate"] = "event",
["desaturateForeground"] = false,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            autoHide = true,\n            safe = false,\n            range = nil,\n            unit = \"nameplate1\",\n        }\n        return true\n    end\n    \n    if event == \"NAME_PLATE_UNIT_ADDED\" then\n        local unit = ...\n        local guid = UnitGUID(unit)\n        local expiration = aura_env.expirationTime[guid]\n        local duration = aura_env.duration[guid]\n        \n        if expiration and duration and expiration > GetTime() then\n            local range = WeakAuras.GetRange(unit)\n            local safe = (range ~= nil) and (range >= aura_env.safeRange) or false\n            \n            allstates[unit] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = duration,\n                expirationTime = expiration,\n                autoHide = true,\n                unit = unit,\n                safe = safe,\n                range = range,\n            }\n            return true\n        end\n        \n        return false\n    end\n    \n    if event == \"NAME_PLATE_UNIT_REMOVED\" then\n        local unit = ...\n        if allstates[unit] then\n            allstates[unit].show = false\n            allstates[unit].changed = true\n            return true\n        end\n        return false\n    end\n    \n    if event == \"WA_NUMEN_TIMER\" then\n        local key, time = ...\n        \n        if key ~= \"LEOTHERAS_WHIRLWIND\" then\n            return false\n        end\n        \n        if time == 0 then\n            local duration = 12\n            local expiration = GetTime() + duration\n            \n            local unit = aura_env.findUnit()\n            if not unit then\n                aura_env.startTicker()\n                return false\n            end\n            \n            local guid = UnitGUID(unit)\n            aura_env.duration[guid] = duration\n            aura_env.expirationTime[guid] = expiration\n            \n            local range = WeakAuras.GetRange(unit)\n            local safe = (range ~= nil) and (range >= aura_env.safeRange) or false\n            \n            allstates[unit] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = duration,\n                expirationTime = expiration,\n                autoHide = true,\n                unit = unit,\n                safe = safe,\n                range = range,\n            }\n            \n            aura_env.startTicker()\n            return true\n        end\n    end\n    \n    if event == \"WA_LEOTHERAS_RANGE_CHECK\" then\n        local guid, safe, range = ...\n        \n        for unit, state in pairs(allstates) do\n            if UnitExists(unit) and UnitGUID(unit) == guid then\n                if state.safe ~= safe or state.range ~= range then\n                    state.safe = safe\n                    state.range = range\n                    state.changed = true\n                    return true\n                end\n                return false\n            end\n        end\n        \n        return false\n    end\n    \n    if event == \"WA_FJI_ENCOUNTER_END\" or event == \"ENCOUNTER_END\" or event == \"WA_LEOTHERAS_DEMON_START\" or event == \"WA_LEOTHERAS_P2_START\" then\n        aura_env.stopTicker()\n        wipe(aura_env.duration)\n        wipe(aura_env.expirationTime)\n        \n        for _, state in pairs(allstates) do\n            state.show = false\n            state.changed = true\n        end\n        return true\n    end\nend",
["spellIds"] = {
},
["events"] = "NAME_PLATE_UNIT_ADDED NAME_PLATE_UNIT_REMOVED WA_NUMEN_TIMER WA_FJI_ENCOUNTER_END ENCOUNTER_END WA_LEOTHERAS_RANGE_CHECK WA_LEOTHERAS_DEMON_START WA_LEOTHERAS_P2_START",
["check"] = "event",
