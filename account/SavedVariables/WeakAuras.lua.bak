["customTextUpdate"] = "event",
["desaturateForeground"] = false,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "{\n    additionalProgress = 1,\n    lethal = \"bool\",\n    predictedHealth = \"number\",\n    damage = \"number\",\n}",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "CLEU:SPELL_DAMAGE:SPELL_CAST_START, UNIT_HEALTH:player, UNIT_SPELLCAST_STOP:player, UNIT_SPELLCAST_INTERRUPTED:player, UNIT_SPELLCAST_FAILED:player, WA_RELIQUARY_P1_END, WA_RELIQUARY_P2_END",
["spellIds"] = {
},
["custom"] = "function(allstates,event,...)\n    if event == \"OPTIONS\" then\n        local maxHealth = 10000\n        local health = math.random(4000,7000)\n        local damage = math.random(1500,5000)\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"static\",\n            value = health,\n            total = maxHealth,\n            health = health,\n            maxHealth = maxHealth,\n            damage = damage,\n            lethal = damage >= health,\n            additionalProgress = {\n                {\n                    min = math.max(0,health-damage),\n                    max = health,\n                },\n            },\n        }\n        return true\n    end\n    \n    if not _G.FJI_RANGED then\n        return false\n    end\n    \n    if event == \"WA_RELIQUARY_P1_END\" then\n        wipe(aura_env.spellMaxDamage)\n        aura_env.predictedDamage = 0\n        aura_env.active = true\n        aura_env.updateCritModifier()\n        aura_env.updateState(allstates)\n        return true\n    end\n    \n    if event == \"WA_RELIQUARY_P2_END\" then\n        aura_env.active = false\n        aura_env.predictedDamage = 0\n        \n        if allstates[\"\"] then\n            allstates[\"\"].show = false\n            allstates[\"\"].changed = true\n            return true\n        end\n        \n        return false\n    end\n    \n    if event == \"UNIT_HEALTH\" then\n        local unit = ...\n        \n        if unit ~= \"player\" or not aura_env.active then\n            return false\n        end\n        \n        aura_env.updateState(allstates)\n        return true\n    end\n    \n    if event == \"UNIT_SPELLCAST_STOP\" or event == \"UNIT_SPELLCAST_INTERRUPTED\" or event == \"UNIT_SPELLCAST_FAILED\" then\n        local unit = ...\n        \n        if unit ~= \"player\" or not aura_env.active then\n            return false\n        end\n        \n        if aura_env.predictedDamage == 0 then\n            return false\n        end\n        \n        aura_env.predictedDamage = 0\n        aura_env.updateState(allstates)\n        return true\n    end\n    \n    local _,subEvent,_,sourceGUID,_,_,_,_,_,_,_,spellId,_,_,amount,_,_,_,_,_,isCrit = ...\n    \n    if sourceGUID ~= WeakAuras.myGUID then\n        return false\n    end\n    \n    if subEvent == \"SPELL_DAMAGE\" then\n        if not spellId or not amount then\n            return false\n        end\n        \n        local damage = amount\n        \n        if aura_env.deaden then\n            damage = damage * 2\n        end\n        \n        if not isCrit then\n            damage = damage * aura_env.critModifier\n        end\n        \n        if not aura_env.spellMaxDamage[spellId] or damage > aura_env.spellMaxDamage[spellId] then\n            aura_env.spellMaxDamage[spellId] = damage\n        end\n        \n        return false\n    end\n    \n    if subEvent == \"SPELL_CAST_START\" then\n        if not aura_env.active or not spellId or not aura_env.spellMaxDamage[spellId] then\n            return false\n        end\n        \n        local damage = aura_env.spellMaxDamage[spellId] / 2\n        \n        if aura_env.deaden then\n            damage = damage / 2\n        end\n        \n        aura_env.predictedDamage = damage\n        aura_env.updateState(allstates)\n        return true\n    end\nend",
["check"] = "event",
["subeventPrefix"] = "SPELL",
["custom_hide"] = "timed",
["debuffType"] = "HELPFUL",
},
