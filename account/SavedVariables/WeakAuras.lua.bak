["CT:[BT][Trash] Bonechewer Behemoth"] = {
["outline"] = "OUTLINE",
["wagoID"] = "pbbuhQ899",
["parent"] = "[BT][Trash]",
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiBT-P1/12",
["actions"] = {
["start"] = {
["do_glow"] = false,
["sound"] = "Interface\\Addons\\FojjiCore\\sound\\fojjiSnap.ogg",
["do_custom"] = false,
["do_sound"] = false,
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.npcId = \"23196\"\naura_env.debug = false\n\naura_env.chargeID = 41272\naura_env.stompID = 41274\naura_env.chargeKey = \"TRASH_BEHEMOTH_CHARGE\"\naura_env.chargeStart = 1\naura_env.chargeWindow = 14\n\naura_env.meteorID = 41276\naura_env.cometID = 41277\naura_env.meteorKey = \"TRASH_BEHEMOTH_METEOR\"\naura_env.meteorStart = 1\naura_env.meteorWindow = 13\n\naura_env.count = {}\naura_env.firstSeen = {}\naura_env.lastCast = {}\n\nfunction aura_env.debugPrint(msg)\n    if aura_env.debug then\n        print(\"|cff3399ffFojji|r \"..msg)\n    end\nend\n\nfunction aura_env.nuTimer(key,countdown,count,guid)\n    WeakAuras.ScanEvents(\"WA_NUMEN_TIMER\",key,countdown,count,guid)\nend\n\nfunction aura_env.cancelAll(guid)\n    aura_env.nuTimer(aura_env.chargeKey,nil,nil,guid)\n    aura_env.nuTimer(aura_env.meteorKey,nil,nil,guid)\nend\n\nfunction aura_env.startTimer(key,start,guid)\n    aura_env.count[guid] = aura_env.count[guid] or {}\n    aura_env.firstSeen[guid] = aura_env.firstSeen[guid] or {}\n    aura_env.lastCast[guid] = aura_env.lastCast[guid] or {}\n    \n    aura_env.count[guid][key] = 1\n    aura_env.firstSeen[guid][key] = GetTime()\n    aura_env.lastCast[guid][key] = nil\n    \n    aura_env.nuTimer(key,start,1,guid)\nend\n\nfunction aura_env.handleCast(key,window,spellName,guid)\n    aura_env.count[guid] = aura_env.count[guid] or {}\n    aura_env.firstSeen[guid] = aura_env.firstSeen[guid] or {}\n    aura_env.lastCast[guid] = aura_env.lastCast[guid] or {}\n    \n    local now = GetTime()\n    local count = aura_env.count[guid][key] or 1\n    \n    if aura_env.lastCast[guid][key] then\n        aura_env.debugPrint(string.format(\"NPC %s - %s (%d): %.1fs after previous.\",aura_env.npcId,spellName,count,now-aura_env.lastCast[guid][key]))\n    elseif aura_env.firstSeen[guid][key] then\n        aura_env.debugPrint(string.format(\"NPC %s - First %s (%d): %.1fs after detection.\",aura_env.npcId,spellName,count,now-aura_env.firstSeen[guid][key]))\n    end\n    \n    aura_env.lastCast[guid][key] = now\n    \n    aura_env.nuTimer(key,0,count,guid)\n    aura_env.count[guid][key] = count+1\n    aura_env.nuTimer(key,window,aura_env.count[guid][key],guid)\nend\n\nfunction aura_env.updateState(allstates)\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n    }\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "for guid in pairs(aura_env.count) do\n    aura_env.cancelAll(guid)\nend\n\naura_env.count = {}\naura_env.firstSeen = {}\naura_env.lastCast = {}",
["do_sound"] = false,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
["do_message"] = false,
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "CLEU:SPELL_CAST_SUCCESS:SPELL_CAST_START:UNIT_DIED, WA_BEHEMOTH_ABILITIES_DETECT",
["spellIds"] = {
},
["custom"] = "function(allstates,event,...)\n    if event == \"WA_BEHEMOTH_ABILITIES_DETECT\" then\n        local _,guid,spellId = ...\n        \n        if spellId == aura_env.chargeID then\n            aura_env.startTimer(aura_env.chargeKey,aura_env.chargeWindow,guid)\n        elseif spellId == aura_env.stompID then\n            aura_env.startTimer(aura_env.chargeKey,aura_env.chargeStart,guid)\n        elseif spellId == aura_env.meteorID then\n            aura_env.startTimer(aura_env.meteorKey,aura_env.meteorWindow,guid)\n        elseif spellId == aura_env.cometID then\n            aura_env.startTimer(aura_env.meteorKey,aura_env.meteorStart,guid)\n        else\n            return false\n        end\n        \n        aura_env.updateState(allstates)\n        return true\n    end\n    \n    if event ~= \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        return false\n    end\n    \n    local _,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId = ...\n    \n    if subEvent == \"UNIT_DIED\" then\n        local npcID = select(6,strsplit(\"-\",destGUID))\n        \n        if npcID == aura_env.npcId then\n            aura_env.cancelAll(destGUID)\n            aura_env.count[destGUID] = nil\n            aura_env.firstSeen[destGUID] = nil\n            aura_env.lastCast[destGUID] = nil\n            return true\n        end\n        \n        return false\n    end\n    \n    local npcID = select(6,strsplit(\"-\",sourceGUID or \"\"))\n    if npcID ~= aura_env.npcId then\n        return false\n    end\n    \n    if subEvent == \"SPELL_CAST_SUCCESS\" then\n        if spellId == aura_env.chargeID then\n            if aura_env.count[sourceGUID] and aura_env.count[sourceGUID][aura_env.chargeKey] then\n                aura_env.handleCast(aura_env.chargeKey,aura_env.chargeWindow,GetSpellInfo(aura_env.chargeID),sourceGUID)\n                aura_env.updateState(allstates)\n                return true\n            end\n        end\n    elseif subEvent == \"SPELL_CAST_START\" then\n        if spellId == aura_env.meteorID then\n            if aura_env.count[sourceGUID] and aura_env.count[sourceGUID][aura_env.meteorKey] then\n                aura_env.handleCast(aura_env.meteorKey,aura_env.meteorWindow,GetSpellInfo(aura_env.meteorID),sourceGUID)\n                aura_env.updateState(allstates)\n                return true\n            end\n        end\n    end\n    \n    return false\nend",
