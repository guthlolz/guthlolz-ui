antine Figurine\n    {itemId = 27900, buffId = 33486, excludeICD = true, excludeSwapping = false, ICD = 0, CD = 300}, -- Jewel of Charismatic Mystique\n    {itemId = 30293, buffId = 36347, excludeICD = true, excludeSwapping = false, ICD = 0, CD = 90}, -- Heavenly Inspiration\n    {itemId = 29383, buffId = 35166, excludeICD = true, excludeSwapping = false, ICD = 0, CD = 120}, -- Bloodlust Brooch\n    {itemId = 29370, buffId = 35163, excludeICD = true, excludeSwapping = false, ICD = 0, CD = 120}, -- Icon of the Silver Crescent\n    {itemId = 29376, buffId = 35165, excludeICD = true, excludeSwapping = false, ICD = 0, CD = 120}, -- Essence of the Martyr\n    {itemId = 38288, buffId = 51954, excludeICD = true, excludeSwapping = false, ICD = 0, CD = 120}, -- Direbrew Hops\n    {itemId = 29387, buffId = 35169, excludeICD = true, excludeSwapping = false, ICD = 0, CD = 120}, -- Gnomeregan Auto-Blocker 600\n    {itemId = 38287, buffId = 51955, excludeICD = true, excludeSwapping = false, ICD = 0, CD = 120}, -- Empty Mug of Direbrew\n    {itemId = 38290, buffId = 51953, excludeICD = true, excludeSwapping = false, ICD = 0, CD = 120}, -- Dark Iron Smoking Pipe\n    {itemId = 38289, buffId = 51952, excludeICD = true, excludeSwapping = false, ICD = 0, CD = 120}, -- Coren's Lucky Coin\n    {itemId = 30300, buffId = 36372, excludeICD = true, excludeSwapping = false, ICD = 0, CD = 90}, -- Dabiri's Enigma\n    {itemId = 29776, buffId = 35733, excludeICD = true, excludeSwapping = false, ICD = 0, CD = 120}, -- Core of Ar'kelos\n    {itemId = 25634, buffId = 32367, excludeICD = true, excludeSwapping = false, ICD = 0, CD = 120}, -- Oshu'gun Relic\n    {itemId = 29181, buffId = 35352, excludeICD = true, excludeSwapping = false, ICD = 0, CD = 120}, -- Timelapse Shard\n    {itemId = 32770, buffId = 41261, excludeICD = false, excludeSwapping = false, ICD = 10}, -- Skyguard Silver Cross\n    {itemId = 32771, buffId = 41263, excludeICD = false, excludeSwapping = false, ICD = 10}, -- Airman's Ribbon of Gallantry\n    {itemId = 25628, buffId = 32362, excludeICD = true, excludeSwapping = false, ICD = 0, CD = 120}, -- Ogre Mauler's Badge\n    {itemId = 31615, buffId = 33662, excludeICD = true, excludeSwapping = false, ICD = 0, CD = 90}, -- Ancient Draenei Arcane Relic\n    {itemId = 31617, buffId = 33667, excludeICD = true, excludeSwapping = false, ICD = 0, CD = 90}, -- Ancient Draenei War Talisman\n    {itemId = 25633, buffId = 9333, excludeICD = true, excludeSwapping = false, ICD = 0, CD = 120}, -- Uniting Charm\n    {itemId = 31856, stackId = 39439, excludeICD = true, excludeSwapping = false, ICD = 0}, -- Darkmoon Card: Crusade\n    {itemId = 31858, buffId = 39445, excludeICD = true, excludeSwapping = false, ICD = 0}, -- Darkmoon Card: Vengeance\n    {itemId = 31859, buffIds = {39511, 40997, 40998, 40999, 41002, 41005, 41009, 41011, 41404}, excludeICD = true, excludeSwapping = false, ICD = 0}, -- Darkmoon Card: Madness\n    {itemId = 31857, buffId = 39443, excludeICD = true, excludeSwapping = false, ICD = 0}, -- Darkmoon Card: Wrath\n}\n\naura_env.saved = aura_env.saved or {}\naura_env.saved.trinketICD = aura_env.saved.trinketICD or {}\naura_env.icdTimers = {}\naura_env.icdEnds = {}\naura_env.buffActive = {}\n\nfunction aura_env.scheduleTrinketCD(itemId, duration)\n    if not itemId or not duration or duration <= 0 then\n        return false\n    end\n    \n    local now = GetTime()\n    local endTime = now + duration\n    \n    if aura_env.icdTimers[itemId] then\n        aura_env.icdTimers[itemId]:Cancel()\n        aura_env.icdTimers[itemId] = nil\n    end\n    \n    aura_env.icdEnds[itemId] = endTime\n    aura_env.saved.trinketICD[itemId] = endTime\n    \n    aura_env.icdTimers[itemId] = C_Timer.NewTimer(duration, function()\n            aura_env.icdTimers[itemId] = nil\n            aura_env.icdEnds[itemId] = nil\n            aura_env.saved.trinketICD[itemId] = nil\n            WeakAuras.ScanEvents(\"WA_FJI_TRINKET_READY\", itemId)\n    end)\n    \n    return true\nend\n\nfunction aura_env.sendTrinketCD(trinket, buffId)\n    if not trinket or not buffId then\n        return\n    end\n    \n    local duration = 0\n    \n    if trinket.ICD and trinket.ICD > 0 then\n        duration = trinket.ICD\n    elseif trinket.CD and trinket.CD > 0 then\n        duration = trinket.CD\n    else\n        return\n    end\n    \n    local itemId = trinket.itemId\n    \n    if aura_env.buffActive[itemId] then\n        return\n    end\n    \n    aura_env.buffActive[itemId] = true\n    WeakAuras.ScanEvents(\"WA_FJI_TRINKET_TRACKER\", itemId, buffId, duration)\nend\n\nfunction aura_env.restoreSavedICD(allstates)\n    aura_env.setTrinket()\n    local t = aura_env.currentTrinket\n    if not t then\n        return false\n    end\n    \n    local itemId = t.itemId\n    local endTime = aura_env.saved.trinketICD[itemId]\n    if not endTime then\n        return false\n    end\n    \n    local now = GetTime()\n    local remaining = endTime - now\n    \n    if remaining <= 0 then\n        aura_env.saved.trinketICD[itemId] = nil\n        aura_env.icdEnds[itemId] = nil\n        return false\n    end\n    \n    local max = 0\n    if t.ICD and t.ICD > 0 then max = t.ICD end\n    if t.CD and t.CD > 0 then max = math.max(max, t.CD) end\n    if max == 0 then\n        aura_env.saved.trinketICD[itemId] = nil\n        aura_env.icdEnds[itemId] = nil\n        return false\n    end\n    \n    if remaining > max + 5 then\n        aura_env.saved.trinketICD[itemId] = nil\n        aura_env.icdEnds[itemId] = nil\n        return false\n    end\n    \n    aura_env.icdEnds[itemId] = endTime\n    \n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n        duration = remaining,\n        expirationTime = now + remaining,\n        progressType = \"timed\",\n        icon = GetInventoryItemTexture(\"player\", aura_env.slot),\n        autoHide = true,\n    }\n    \n    if aura_env.icdTimers[itemId] then\n        aura_env.icdTimers[itemId]:Cancel()\n        aura_env.icdTimers[itemId] = nil\n    end\n    \n    aura_env.icdTimers[itemId] = C_Timer.NewTimer(remaining, function()\n            aura_env.icdTimers[itemId] = nil\n            aura_env.icdEnds[itemId] = nil\n            aura_env.saved.trinketICD[itemId] = nil\n            WeakAuras.ScanEvents(\"WA_FJI_TRINKET_READY\", itemId)\n    end)\n    \n    return true\nend\n\nfunction aura_env.startTrinketTimer(allstates, itemId, procId, duration)\n    if not itemId or not duration or duration <= 0 then\n        return false\n    end\n    \n    local now = GetTime()\n    local endTime = now + duration\n    \n    if aura_env.icdTimers[itemId] then\n        aura_env.icdTimers[itemId]:Cancel()\n        aura_env.icdTimers[itemId] = nil\n    end\n    \n    aura_env.icdEnds[itemId] = endTime\n    aura_env.saved.trinketICD[itemId] = endTime\n    \n    WeakAuras.ScanEvents(\"WA_FJI_TRINKET_TRACKER\", itemId, procId, duration)\n    \n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n        expirationTime = endTime,\n        duration = duration,\n        progressType = \"timed\",\n        icon = GetInventoryItemTexture(\"player\", aura_env.slot),\n        autoHide = true,\n    }\n    \n    aura_env.icdTimers[itemId] = C_Timer.NewTimer(duration, function()\n            aura_env.icdTimers[itemId] = nil\n            aura_env.icdEnds[itemId] = nil\n            aura_env.saved.trinketICD[itemId] = nil\n            WeakAuras.ScanEvents(\"WA_FJI_TRINKET_READY\", itemId)\n    end)\n    \n    return true\nend\n\nfunction aura_env.resumeTrinketTimer(allstates, itemId)\n    if not itemId then\n        return false\n    end\n    \n    local endTime = aura_env.icdEnds[itemId]\n    if not endTime then\n        return false\n    end\n    \n    local now = GetTime()\n    local remaining = endTime - now\n    if remaining <= 0 then\n        aura_env.icdEnds[itemId] = nil\n        return false\n    end\n    \n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n        expirationTime = now + remaining,\n        duration = remaining,\n        progressType = \"timed\",\n        icon = GetInventoryItemTexture(\"player\", aura_env.slot),\n        autoHide = true,\n    }\n    \n    return true\nend\n\nfunction aura_env.getBuffInfo(buffId)\n    if not buffId then\n        return\n    end\n    return WA_GetUnitBuff(\"player\", buffId)\nend\n\naura_env.currentTrinket = nil\nfunction aura_env.setTrinket()\n    local equipped = GetInventoryItemID(\"player\", aura_env.slot)\n    aura_env.currentTrinket = nil\n    for _, t in ipairs(aura_env.trinketData) do\n        if t.itemId == equipped then\n            aura_env.currentTrinket = t\n            t.equipped = true\n            break\n        end\n    end\nend\naura_env.setTrinket()\n\naura_env.FindEmptyBagSlot = function()\n    for bag = 0, 4 do\n        local numSlots = C_Container.GetContainerNumSlots(bag)\n        for slot = 1, numSlots do\n            local itemID = C_Container.GetContainerItemID(bag, slot)\n            if not itemID then\n                return bag, slot\n            end\n        end\n    end\n    return nil, nil\nend\n\naura_env.UnequipItemBySlot = function(slotID)\n    PickupInventoryItem(slotID)\n    local emptyBag, emptySlot = aura_env.FindEmptyBagSlot()\n    if not emptyBag then\n        ClearCursor()\n        return\n    end\n    local bagSlotID = emptyBag + 30 -- WoW Wiki Strikes Again\n    PutItemInBag(bagSlotID)\n    PutItemInBackpack()\nend\n\nfunction aura_env.checkTrinket(allstates, hasCurrent)\n    aura_env.setTrinket()\n    local t = aura_env.currentTrinket\n    \n    if not t then\n        allstates[\"\"] = {\n            show = false,\n            changed = true,\n            duration = 0,\n            expirationTime = 0,\n        }\n        return true\n    end\n    \n    if hasCurrent == nil then\n        hasCurrent = false\n    end\n    \n    if not hasCurrent and not t.excludeSwapping then\n        local now = GetTime()\n        local duration = t.ICD\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            expirationTime = now + duration,\n            duration = duration,\n            progressType = \"timed\",\n            icon = GetInventoryItemTexture(\"player\", aura_env.slot),\n            autoHide = true,\n        }\n        return true\n    end\nend",
["do_custom"] = true,
},
