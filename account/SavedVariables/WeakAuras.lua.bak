["do_custom"] = true,
["custom"] = "aura_env.key = \"ILLIDARI_SEAL\"\n\naura_env.auras = {\n    [41459] = {\n        name = \"Seal of Blood\",\n        icon = GetSpellTexture(41459),\n    },\n    [41469] = {\n        name = \"Seal of Command\",\n        icon = GetSpellTexture(41469),\n    },\n}",
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["useStacks"] = false,
["useGroup_count"] = true,
["subeventPrefix"] = "SPELL",
