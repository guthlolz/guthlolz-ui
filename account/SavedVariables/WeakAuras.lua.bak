},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, key, time)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 12,\n            expirationTime = GetTime() + 12,\n            progressType = \"timed\",\n            icon = 132369,\n            autoHide = true,\n        }\n        return true\n    end\n    if event == \"WA_NUMEN_TIMER\" then\n        if key ~= \"LEOTHERAS_WHIRLWIND\" then\n            return false\n        end\n        \n        if time == 0 then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = 12,\n                expirationTime = GetTime() + 12,\n                progressType = \"timed\",\n                icon = 132369,\n                autoHide = true,\n            }\n            return true\n        elseif time == nil then\n            if allstates[\"\"] then\n                allstates[\"\"].show = false\n                allstates[\"\"].changed = true\n                return true\n            end\n        end\n    end\nend",
["spellIds"] = {
},
["events"] = "WA_NUMEN_TIMER",
["check"] = "event",
["unit"] = "player",
["custom_hide"] = "timed",
["customVariables"] = "{\n    expirationTime = true\n}",
