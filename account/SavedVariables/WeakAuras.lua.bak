["check"] = "event",
["custom"] = "function(event,...)\n    local _, _, _, _, _, _, _, Id = GetInstanceInfo()\n    local auraID = \"Fojji - Raid Pack Anchors [Classic]\"\n    \n    if (Id == 548 or Id == 550) then\n        if WeakAuras.GetData(auraID) == nil then\n            print(\"|cFFFF0000WARNING!|r\")\n            print(\"|cFF40C7EBFojji Raid Anchors|r Missing. \")\n            print(\"You need the Anchors WeakAura to position everything. Import from:\")\n            print(\"|cFF00FFFF|Hurl:https://wago.io/FojjiRaidAnchors-Classic|h[https://wago.io/FojjiRaidAnchors-Classic]|h|r\")\n            return true\n        end\n    end\nend",
