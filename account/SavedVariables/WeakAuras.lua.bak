["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["custom_hide"] = "timed",
["names"] = {
},
["event"] = "Health",
["unit"] = "player",
["subeventSuffix"] = "_CAST_START",
["spellIds"] = {
},
["custom"] = "function(allstates,event,guid)\n    if event == \"OPTIONS\" then\n        allstates[\"HEADER\"] = {\n            show = true,\n            changed = true,\n            duration = aura_env.duration,\n            expirationTime = GetTime() + aura_env.duration,\n            progressType = \"timed\",\n            autoHide = true,\n            name = aura_env.name,\n            icon = aura_env.icon,\n            isHeader = true,\n            index = 0,\n        }\n        \n        for i = 1,3 do\n            allstates[i] = {\n                show = true,\n                changed = true,\n                duration = aura_env.duration,\n                expirationTime = GetTime() + aura_env.duration,\n                progressType = \"timed\",\n                autoHide = true,\n                name = aura_env.name,\n                icon = aura_env.icon,\n                guid = WeakAuras.myGUID,\n                isHeader = false,\n                index = i,\n                last = i == 3,\n            }\n        end\n        return true\n    end\n    \n    if event ~= aura_env.event then\n        return false\n    end\n    \n    local expirationTime = GetTime() + aura_env.duration\n    \n    allstates[\"HEADER\"] = {\n        show = true,\n        changed = true,\n        duration = aura_env.duration,\n        expirationTime = expirationTime,\n        progressType = \"timed\",\n        autoHide = true,\n        name = aura_env.name,\n        icon = aura_env.icon,\n        isHeader = true,\n        index = 0,\n    }\n    \n    if allstates[guid] then\n        return false\n    end\n    \n    for key,state in pairs(allstates) do\n        if key ~= \"HEADER\" then\n            state.changed = true\n            state.expirationTime = expirationTime\n            state.last = false\n        end\n    end\n    \n    allstates[guid] = {\n        show = true,\n        changed = true,\n        duration = aura_env.duration,\n        expirationTime = expirationTime,\n        progressType = \"timed\",\n        autoHide = true,\n        name = aura_env.name,\n        icon = aura_env.icon,\n        guid = guid,\n        isHeader = false,\n        last = true,\n    }\n    \n    return true\nend",
["events"] = "WA_RELIQUARY_SPITE_APPLIED",
["check"] = "event",
["subeventPrefix"] = "SPELL",
["debuffType"] = "HELPFUL",
["customVariables"] = "{\n    isHeader = \"bool\",\n    last = \"bool\",\n}",
},
