["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "aura_env.absorbSpells = {\n    [6143] = 164,\n    [8461] = 289,\n    [8462] = 469,\n    [10177] = 674,\n    [28609] = 919,\n    [32796] = 1125\n}\n\nlocal function update(state, amount)\n    state.value = state.value - amount\n    state.show = state.value > 0\n    state.changed = true\n    return true\nend\n\nfunction aura_env.WA_FJI_ABSORB_APPLIED(allStates, total, spellId)\n    if not aura_env.absorbSpells[spellId] then\n        return\n    end\n    \n    allStates[\"\"] = {\n        show = true,\n        changed = true,\n        progressType = \"static\",\n        value = total,\n        total = total,\n    }\n    return true\nend\n\nfunction aura_env.WA_FJI_ABSORB_REMOVED(allStates, spellId)\n    if not aura_env.absorbSpells[spellId] then\n        return\n    end\n    \n    allStates[\"\"] = {\n        show = true,\n        changed = true,\n        progressType = \"static\",\n        value = total,\n        total = total,\n    }\n    return true\nend\n\nfunction aura_env.WA_FJI_ABSORB_UPDATE(allStates, amount, spellId)\n    if not aura_env.absorbSpells[spellId] then\n        return\n    end\n    local state = allStates[\"\"]\n    if state then\n        return update(state, amount)\n    end\nend\n\nfunction aura_env.OPTIONS(allStates)\n    allStates[\"\"] = {\n        show = true,\n        changed = true,\n        progressType = \"static\",\n        value = math.random(1, 826),\n        total = 826,\n    }\n    return true\nend\n\nfunction aura_env.STATUS(allStates)\n    return\nend",
["do_custom"] = true,
},
["finish"] = {
},
},
["config"] = {
},
