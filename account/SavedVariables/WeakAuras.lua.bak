["triggers"] = {
{
["trigger"] = {
["customVariables"] = "{\n    value = \"number\",\n    percent = \"string\",\n    isDead = \"bool\",\n    name = \"string\",\n}",
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_type"] = "stateupdate",
["unevent"] = "auto",
["duration"] = "1",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "PLAYER_REGEN_ENABLED, WA_FJI_ENCOUNTER_END, ENCOUNTER_END, WA_KAELTHAS_P3_START, WA_FJI_ADVISOR_TICKER, PLAYER_TARGET_CHANGED, WA_KAELTHAS_THALADRED_DIED, WA_KAELTHAS_SANGUINAR_DIED, WA_KAELTHAS_CAPERNIAN_DIED, WA_KAELTHAS_TELONICUS_DIED",
["custom"] = "function(a, e)\n    if e == \"OPTIONS\" then\n        aura_env.createStates(a)\n        return true\n    end\n    \n    if not aura_env.create then\n        return false\n    end\n    \n    if e == \"PLAYER_REGEN_ENABLED\" or e == \"WA_FJI_ENCOUNTER_END\" or e == \"ENCOUNTER_END\" then\n        aura_env.allow = false\n        aura_env.hideState(a)\n        return true\n    end\n    \n    if e == \"WA_KAELTHAS_P3_START\" then\n        aura_env.allow = true\n        aura_env.addsAlive = 4\n        aura_env.createStates(a)\n        aura_env.startTicker()\n        return true\n    end\n    \n    if e == \"WA_FJI_ADVISOR_TICKER\" then\n        return aura_env.scanTargets(a)\n    end\n    \n    if not aura_env.allow then\n        return false\n    end\n    \n    local advisor = aura_env.deathEvents[e]\n    if advisor then\n        aura_env.updateState(a, advisor.id, advisor.name, advisor.icon, 0, true)\n        aura_env.addsAlive = aura_env.addsAlive - 1\n        \n        if aura_env.addsAlive <= 0 then\n            aura_env.hideState(a)\n        end\n        \n        return true\n    end\nend",
["spellIds"] = {
},
