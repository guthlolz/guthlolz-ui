["custom"] = "aura_env.saved = aura_env.saved or {}\n\nfunction aura_env.updateState(allstates)\n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n    end\n    \n    local mark = aura_env.saved.mark\n    if not mark then\n        return false\n    end\n    \n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n        mark = mark,\n    }\n    return true\nend",
},
