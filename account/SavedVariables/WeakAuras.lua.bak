["subeventPrefix"] = "SPELL",
["subeventSuffix"] = "_CAST_START",
["use_spellId"] = true,
["custom"] = "function(a, e, unit, _, spellId)\n    if e == \"OPTIONS\" then\n        a[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 3,\n            expirationTime = GetTime() + 3,\n            autoHide = true,\n            icon = 135926,\n        }\n        return true\n    end\n    \n    if e == \"UNIT_SPELLCAST_SUCCEEDED\" then\n        if spellId ~= 41348 then\n            return false\n        end\n        \n        if GetTime() - aura_env.throttle < 3 then\n            return false\n        end\n        aura_env.throttle = GetTime()\n        \n        a[unit] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 3,\n            expirationTime = GetTime() + 3,\n            autoHide = true,\n            icon = 135926,\n        }\n        return true\n    end\nend",
