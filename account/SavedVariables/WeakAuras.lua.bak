["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiBT-P1/12",
["actions"] = {
["start"] = {
["do_glow"] = false,
["sound"] = "Interface\\Addons\\FojjiCore\\sound\\fojjiSnap.ogg",
["do_custom"] = false,
["do_sound"] = false,
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.spells = {\n    TRASH_COILSKAR_HURRICANE = {\n        cdStart = 9,\n        cdWindow = 25,\n        spellID = 40090,\n        npcID = \"22875\",\n    },\n    \n    TRASH_COILSKAR_BOOMING = {\n        cdStart = 6,\n        cdWindow = 22,\n        spellID = 40080,\n        npcID = \"22873\",\n    },\n    TRASH_AQUEOUS_WAVE = {\n        cdStart = 4,\n        cdWindow = 15,\n        spellID = 40100,\n        npcID = \"22878\",\n    },\n    \n    TRASH_FEARBRINGER_STOMP = {\n        cdStart = 10,\n        cdWindow = 13,\n        spellID = 40936,\n        npcID = \"22954\",\n    },\n    \n    TRASH_WINDREAVER_FREEZE = {\n        cdStart = 9.4,\n        cdWindow = 9.4,\n        spellID = 40875,\n        npcID = \"23330\",\n    },\n    \n    TRASH_BONESLICER_GOUGE = {\n        cdStart = 12,\n        cdWindow = 20,\n        spellID = 24698,\n        npcID = \"22869\",\n    },\n    \n    TRASH_BONESLICER_SHADOWSTEP = {\n        cdStart = 14,\n        cdWindow = 25,\n        spellID = 41176,\n        npcID = \"22869\",\n    },\n    \n    TRASH_CENTURION_SONICSTRIKE = {\n        cdStart = 3,\n        cdWindow = 11,\n        spellID = 41168,\n        npcID = \"23337\",\n    },\n    \n    TRASH_NIGHTLORD_SHADOWINFERNO = {\n        cdStart = 10,\n        cdWindow = 34,\n        spellID = 39645,\n        npcID = \"22855\",\n    },\n    \n    TRASH_NIGHTLORD_SHADOWFIENDS = {\n        cdStart = 16,\n        cdWindow = 20,\n        spellID = 39649,\n        npcID = \"22855\",\n    },\n    \n    TRASH_ASHTONGUE_CONCUSSION = {\n        cdStart = 12,\n        cdWindow = 21,\n        spellID = 32588,\n        npcID = \"22844\",\n    },\n    \n    TRASH_FURY_STORMBLINK = {\n        cdStart = 10,\n        cdWindow = 22,\n        spellID = 39581,\n        npcID = \"22848\",\n    },\n    \n    TRASH_ASHTONGUE_SWEEPINGWINGCLIP = {\n        cdStart = 10,\n        cdWindow = 30,\n        spellID = 39584,\n        npcID = \"22847\",\n    },\n    TRASH_ASHTONGUE_WYVERN = {\n        cdStart = 1,\n        cdWindow = 24,\n        spellID = 41186,\n        npcID = \"22847\",\n    },\n    \n    TRASH_ASHTONGUE_BLIND = {\n        cdStart = 10,\n        cdWindow = 12,\n        spellID = 34654,\n        npcID = \"23374\",\n    },\n    \n    TRASH_SHADOWMOON_SPELLABSORPTION = {\n        cdStart = 6,\n        cdWindow = 30,\n        spellID = 41034,\n        npcID = \"22879\",\n    },\n    \n    TRASH_SHADOWMOON_CHAOTICLIGHT = {\n        cdStart = 2,\n        cdWindow = 8,\n        spellID = 41063,\n        npcID = \"22880\",\n    },\n    \n    TRASH_SHADOWMOON_WHIRLINGBLADE = {\n        cdStart = 20,\n        cdWindow = 30,\n        spellID = 41053,\n        npcID = \"22880\",\n    },\n    \n    TRASH_SHADOWMOON_FREEZINGTRAP = {\n        cdStart = 6,\n        cdWindow = 11,\n        spellID = 41085,\n        npcID = \"23018\",\n    },\n    \n    TRASH_SHADOWMOON_BLOODSIPHON = {\n        cdStart = 1,\n        cdWindow = 9,\n        spellID = 41068,\n        npcID = \"22945\",\n    },\n    \n    TRASH_SHADOWMOON_DEATHCOIL = {\n        cdStart = 5.5,\n        cdWindow = 6.5,\n        spellID = 41070,\n        npcID = \"22882\",\n    },\n    \n    TRASH_WRATHBONE_IGNORED = {\n        cdStart = 6,\n        cdWindow = 11,\n        spellID = 39544,\n        npcID = \"22953\",\n    },\n    \n    TRASH_BONECHEWER_THROWSHIELD = {\n        cdStart = 10,\n        cdWindow = 11.4,\n        spellID = 41213,\n        npcID = \"23236\",\n    },\n    \n    TRASH_BONECHEWER_PROPHECY = {\n        cdStart = 11,\n        cdWindow = 13,\n        spellID = 41230,\n        npcID = \"23237\",\n    },\n    \n    TRASH_ARDENT_SLEEP = {\n        cdStart = 4,\n        cdWindow = 14.6,\n        spellID = 41396,\n        npcID = \"22959\",\n    },\n    \n    TRASH_STEWARD_UPPERCUT = {\n        cdStart = 8,\n        cdWindow = 16,\n        spellID = 41388,\n        npcID = \"22965\",\n    },\n    \n    TRASH_STEWARD_KIDNEY = {\n        cdStart = 6,\n        cdWindow = 13,\n        spellID = 41389,\n        npcID = \"22965\",\n    },\n    \n    TRASH_DEMENTIA_DEMENTIA = {\n        cdStart = 10,\n        cdWindow = 32,\n        spellID = 41404,\n        npcID = \"22957\",\n    },\n    \n    TRASH_DEMENTIA_CONFUSION = {\n        cdStart = 12,\n        cdWindow = 21,\n        spellID = 41397,\n        npcID = \"22957\",\n    },\n    \n    TRASH_WOE_CURSE = {\n        cdStart = 6,\n        cdWindow = 13,\n        spellID = 41351,\n        npcID = \"22962\",\n    },\n    \n    TRASH_ILLIDARI_HOJ = {\n        cdStart = 9,\n        cdWindow = 11,\n        spellID = 13005,\n        npcID = \"23397\",\n    },\n    \n    TRASH_ILLIDARI_BLIZZARD = {\n        cdStart = 9,\n        cdWindow = 11,\n        spellID = 41382,\n        npcID = \"23402\",\n    },\n    \n    TRASH_ILLIDARI_FLAMESTRIKE = {\n        cdStart = 12,\n        cdWindow = 14,\n        spellID = 41379,\n        npcID = \"23402\",\n    },\n    \n    TRASH_ILLIDARI_VANISH = {\n        cdStart = 18,\n        cdWindow = 20,\n        spellID = 39667,\n        npcID = \"23403\",\n    },\n}\n\naura_env.bySpellID = {}\naura_env.byNpcID = {}\naura_env.count = {}\naura_env.firstSeen = {}\naura_env.lastCast = {}\naura_env.debug = false\n\nfor key,data in pairs(aura_env.spells) do\n    data.key = key\n    data.spellName = GetSpellInfo(data.spellID)\n    \n    aura_env.bySpellID[data.spellID] = data\n    \n    if not aura_env.byNpcID[data.npcID] then\n        aura_env.byNpcID[data.npcID] = {}\n    end\n    aura_env.byNpcID[data.npcID][key] = data\n    \n    aura_env.count[key] = {}\n    aura_env.firstSeen[key] = {}\n    aura_env.lastCast[key] = {}\nend\n\nfunction aura_env.debugPrint(msg)\n    if aura_env.debug then\n        print(\"|cff3399ffFojji|r \"..msg)\n    end\nend\n\nfunction aura_env.nuTimer(key,countdown,count,guid)\n    WeakAuras.ScanEvents(\"WA_NUMEN_TIMER\",key,countdown,count,guid)\nend\n\nfunction aura_env.updateState(allstates)\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n    }\nend\n\nfunction aura_env.hideState(allstates)\n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\n    return false\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "for key,guids in pairs(aura_env.count) do\n    for guid in pairs(guids) do\n        aura_env.nuTimer(key,nil,nil,guid)\n    end\nend\n\nfor key in pairs(aura_env.spells) do\n    aura_env.count[key] = {}\n    aura_env.firstSeen[key] = {}\n    aura_env.lastCast[key] = {}\nend",
["do_sound"] = false,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
["do_message"] = false,
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "CLEU:SPELL_CAST_SUCCESS:SPELL_DAMAGE:RANGE_DAMAGE:SPELL_AURA_APPLIED:UNIT_DIED",
["spellIds"] = {
},
["custom"] = "function(allstates,event,...)\n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local _,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId = ...\n        \n        if subEvent == \"SPELL_DAMAGE\" or subEvent == \"RANGE_DAMAGE\" or subEvent == \"SPELL_AURA_APPLIED\" then\n            local npcID = select(6,strsplit(\"-\",destGUID))\n            local npcSpells = aura_env.byNpcID[npcID]\n            \n            if npcSpells then\n                local found = false\n                \n                for key,data in pairs(npcSpells) do\n                    if not aura_env.count[key][destGUID] then\n                        aura_env.firstSeen[key][destGUID] = GetTime()\n                        aura_env.count[key][destGUID] = 1\n                        aura_env.nuTimer(key,data.cdStart,1,destGUID)\n                        found = true\n                    end\n                end\n                \n                if found then\n                    aura_env.updateState(allstates)\n                    return true\n                end\n            end\n        end\n        \n        if subEvent == \"UNIT_DIED\" then\n            local npcID = select(6,strsplit(\"-\",destGUID))\n            local npcSpells = aura_env.byNpcID[npcID]\n            \n            if npcSpells then\n                for key,data in pairs(npcSpells) do\n                    aura_env.count[key][destGUID] = nil\n                    aura_env.firstSeen[key][destGUID] = nil\n                    aura_env.lastCast[key][destGUID] = nil\n                    aura_env.nuTimer(key,nil,nil,destGUID)\n                end\n                \n                return true\n            end\n        end\n        \n        local data = aura_env.bySpellID[spellId]\n        \n        if not data then\n            return false\n        end\n        \n        if subEvent == \"SPELL_CAST_SUCCESS\" then\n            local now = GetTime()\n            local count = aura_env.count[data.key][sourceGUID] or 1\n            \n            if aura_env.lastCast[data.key][sourceGUID] then\n                aura_env.debugPrint(string.format(\"NPC %s - %s (%d): %.1fs after previous.\",data.npcID,data.spellName,count,now-aura_env.lastCast[data.key][sourceGUID]))\n            elseif aura_env.firstSeen[data.key][sourceGUID] then\n                aura_env.debugPrint(string.format(\"NPC %s - First %s (%d): %.1fs after detection.\",data.npcID,data.spellName,count,now-aura_env.firstSeen[data.key][sourceGUID]))\n            end\n            \n            aura_env.lastCast[data.key][sourceGUID] = now\n            \n            aura_env.updateState(allstates)\n            aura_env.nuTimer(data.key,0,count,sourceGUID)\n            aura_env.count[data.key][sourceGUID] = count+1\n            aura_env.nuTimer(data.key,data.cdWindow,aura_env.count[data.key][sourceGUID],sourceGUID)\n            return true\n        end\n    end\n    \n    return false\nend",
