["custom"] = "function(allstates,event,...)\n    if event == \"ENCOUNTER_END\" then\n        local encounterID,_,_,_,success = ...\n        \n        if encounterID == 608 and success == 1 then\n            aura_env.startTimer()\n            aura_env.showState(allstates)\n            return true\n        end\n    end\n    \n    if event == \"STATUS\" then\n        return aura_env.showState(allstates)\n    end\nend",
