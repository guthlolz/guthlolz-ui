["L:[T4][Gruul] Friendly Fire Leaderboard"] = {
["user_y"] = 0,
["iconSource"] = -1,
["user_x"] = 0,
["authorOptions"] = {
},
["displayText_format_t_format"] = "timed",
["yOffset"] = 0,
["foregroundColor"] = {
0.72156862745098,
0.51372549019608,
1,
1,
},
["sparkRotation"] = 0,
["sameTexture"] = true,
["url"] = "https://wago.io/FojjiT4RaidPack/3",
["actions"] = {
["start"] = {
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.throttle = 0\naura_env.spellIDs = {\n    [33671] = true,\n}\n\naura_env.friendlyFireScore = {}\n\nfunction aura_env.sortStates(allstates)\n    local playersCast = {}\n    local playersNotCast = {}\n    for key, state in pairs(allstates) do\n        if key ~= \"total\" and state.player then\n            if state.value > 0 then\n                table.insert(playersCast, state)\n            else\n                table.insert(playersNotCast, state)\n            end\n        end\n    end\n    table.sort(playersCast, function(a, b)\n            return a.value > b.value\n    end)\n    local index = 2\n    for _, state in ipairs(playersCast) do\n        state.index = index\n        state.changed = true\n        index = index + 1\n    end\n    for _, state in ipairs(playersNotCast) do\n        state.index = index\n        state.changed = true\n        index = index + 1\n    end\nend\n\nfunction aura_env.formatShort(n)\n    n = tonumber(n) or 0\n    if n >= 1000000 then\n        return string.format(\"%.1fm\", n / 1000000)\n    elseif n >= 1000 then\n        return string.format(\"%.1fk\", n / 1000)\n    else\n        return tostring(n)\n    end\nend\n\nfunction aura_env.ffSummary()\n    if not aura_env.friendlyFireScore or next(aura_env.friendlyFireScore) == nil then\n        return\n    end\n    \n    local sortable = {}\n    for playerName, amount in pairs(aura_env.friendlyFireScore) do\n        table.insert(sortable, {playerName = playerName, amount = amount})\n    end\n    \n    table.sort(sortable, function(a, b) return a.amount > b.amount end)\n    SendChatMessage(\"Gruul Terrorist Leaderboard:\", \"RAID\")\n    \n    for _, entry in ipairs(sortable) do\n        local message = entry.playerName .. \" - \" .. aura_env.formatShort(entry.amount) .. \" Damage\"\n        SendChatMessage(message, \"RAID\")\n    end\nend\n\nfunction aura_env.updateState(allstates, name)\n    allstates[name] = allstates[name] or {\n        show = true,\n        name = name,\n        value = 0,\n        total = 10000,\n        progressType = \"static\",\n        player = true,\n        index = 2\n    }\n    \n    allstates[name].value = aura_env.friendlyFireScore[name] or 0\n    allstates[name].changed = true\n    \n    local totalDamage = 0\n    for _, v in pairs(aura_env.friendlyFireScore) do\n        totalDamage = totalDamage + v\n    end\n    \n    allstates[\"total\"] = allstates[\"total\"] or {\n        show = true,\n        name = \"Total\",\n        value = 0,\n        total = 10000,\n        progressType = \"static\",\n        player = false,\n        index = 1,\n    }\n    \n    allstates[\"total\"].value = totalDamage\n    allstates[\"total\"].changed = true\n    \n    aura_env.sortStates(allstates)\nend",
["do_custom"] = true,
},
["finish"] = {
["do_custom"] = false,
["custom"] = "\n\n",
},
},
