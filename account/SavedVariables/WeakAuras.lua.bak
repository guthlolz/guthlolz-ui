["unit"] = "player",
["subeventSuffix"] = "_CAST_START",
["spellIds"] = {
},
["custom"] = "function(allstates, event, key, time, count, guid)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            icon = 132339,\n            count = math.random(1,5),\n        }\n    end\n    if event == \"WA_NUMEN_TIMER\" and key == \"TRASH_COILSKAR_BOOMING\" and time == 0 then\n        allstates[guid] = {\n            show = true,\n            changed = true,\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            progressType = \"timed\",\n            icon = 132339,\n            autoHide = true,\n            count = count\n        }\n        return true\n    end\nend",
["events"] = "WA_NUMEN_TIMER",
["check"] = "event",
["subeventPrefix"] = "SPELL",
["debuffType"] = "HELPFUL",
["customVariables"] = "",
},
["untrigger"] = {
