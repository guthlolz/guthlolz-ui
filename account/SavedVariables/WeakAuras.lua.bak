["init"] = {
["custom"] = "aura_env.fallDamage = {}\n\naura_env.getRandomSound = function()\n    local sounds = {\n        \"Interface\\\\AddOns\\\\FojjiCore\\\\sound\\\\fojjiOgreDeath.ogg\",\n        \"Interface\\\\AddOns\\\\FojjiCore\\\\sound\\\\SadTrombone.ogg\",\n    }\n    return sounds[math.random(#sounds)]\nend\n\naura_env.getRandomIcon = function()\n    local icons = {\n        \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\BTTV+FFZ\\\\OMEGALUL.tga\",\n        \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\BTTV+FFZ\\\\MEGALUL.tga\",\n        \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\BTTV+FFZ\\\\LUL.tga\",\n        \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\BTTV+FFZ\\\\gachiGASM.tga\",\n        \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\Pepes\\\\peepoHands.tga\",\n        \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\GuildEmotes\\\\2Head.tga\",\n    }\n    return icons[math.random(#icons)]\nend",
["do_custom"] = true,
},
},
