["custom"] = "function(a, e, ...)\n    if e == \"OPTIONS\" then\n        a[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 8.5,\n            expirationTime = GetTime() + 8.5,\n            guid = WeakAuras.myGUID\n        }\n        return true\n    end\n    \n    if e == \"WA_THALADRED_GAZE_TARGET\" then\n        local guid = ...\n        \n        a[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 8.5,\n            expirationTime = GetTime() + 8.5,\n            guid = guid\n        }\n        return true\n    end\n    \n    if e == \"WA_THALADRED_GAZE_TARGET_NAMEPLATE\" then\n        local guid = ...\n        \n        if a[\"\"] then\n            a[\"\"].guid = guid\n            a[\"\"].changed = true\n        else\n            a[\"\"] = {\n                show = true,\n                changed = true,\n                guid = guid\n            }\n        end\n        return true\n    end\n    \n    if e == \"WA_KAELTHAS_THALADRED_DIED\" or e == \"ENCOUNTER_END\" or e == \"WA_FJI_ENCOUNTER_END\" then\n        if a[\"\"] then\n            a[\"\"].show = false\n            a[\"\"].changed = true\n            return true\n        end\n    end\nend",
