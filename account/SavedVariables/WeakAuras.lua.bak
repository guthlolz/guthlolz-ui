["actions"] = {
["start"] = {
["message"] = "",
["custom"] = "local _, shadowRes = UnitResistance(\"player\", 5)\n\nC_Timer.After(math.max(0, 2 - shadowRes * 0.005), function()\n        SendChatMessage(shadowRes..\" SR\", \"RAID\")\nend)",
["do_sound"] = false,
["message_type"] = "SAY",
["sound"] = "Interface\\Addons\\FojjiCore\\sound\\fojjiPopClick.ogg",
["do_message"] = false,
["do_custom"] = true,
},
["init"] = {
["customOnLoad"] = "aura_env.saved = aura_env.saved or {}\n\nlocal saved = false\n\nfor i = 1,GetNumSavedInstances() do\n    local _,_,_,_,locked,_,_,_,_,_,_,encounterProgress,_,instanceId = GetSavedInstanceInfo(i)\n    \n    if instanceId == 564 and locked and encounterProgress and encounterProgress >= 7 then\n        saved = true\n        break\n    end\nend\n\nif not saved and UnitIsGroupLeader(\"player\") then\n    local now = GetTime()\n    \n    if not aura_env.saved.lastPrint or now-aura_env.saved.lastPrint >= 3600 then\n        aura_env.saved.lastPrint = now\n        print(\"|TInterface\\\\AddOns\\\\FojjiCore\\\\textures\\\\F_icon_teal.png:16:16:0:0|t|cff66b3ffFojji|r|cff5D3FD3SHAHRAZ|r: type !sr in Raid Chat to query players Shadow Resistance at any point. Only Players in the Mother Area will respond.\")\n    end\nend",
["do_custom_load"] = true,
["do_custom"] = false,
["custom"] = "",
},
