},
["custom"] = "function(allstates,event,key,time,count,guid)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 1,\n            expirationTime = GetTime() + 1,\n            autoHide = true,\n        }\n        return true\n    end\n    \n    if event ~= \"WA_NUMEN_TIMER\" or key ~= \"TRASH_SHADOWMOON_FREEZINGTRAP\" or time ~= 0 or not guid then\n        return false\n    end\n    \n    WeakAuras.ScanEvents(\"WA_BT_TRASH_FREEZINGTRAP\")\n    for _, plate in pairs(C_NamePlate.GetNamePlates()) do\n        local unit = plate.UnitFrame and plate.UnitFrame.displayedUnit\n        \n        if unit and UnitGUID(unit) == guid then\n            allstates[unit] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = 1,\n                expirationTime = GetTime() + 1,\n                autoHide = true,\n                unit = unit,\n            }\n            return true\n        end\n    end\nend",
