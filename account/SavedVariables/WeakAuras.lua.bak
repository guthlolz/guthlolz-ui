["trigger"] = {
["type"] = "custom",
["custom_hide"] = "timed",
["custom_type"] = "stateupdate",
["subeventPrefix"] = "SPELL",
["duration"] = "20",
["event"] = "Health",
["unit"] = "player",
["subeventSuffix"] = "_CAST_START",
["custom"] = "function(allstates,event,...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 1,\n            expirationTime = GetTime()+1,\n            autoHide = true,\n            icon = aura_env.icon,\n            hasTarget = true,\n            target = WeakAuras.myGUID,\n        }\n        return true\n    end\n    \n    if event == \"WA_RELIQUARY_DEADEN_CAST\" then\n        local castTime = ...\n        \n        if not castTime then\n            return false\n        end\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = castTime,\n            expirationTime = GetTime()+castTime,\n            autoHide = true,\n            icon = aura_env.icon,\n            hasTarget = false,\n            target = \"\",\n        }\n        return true\n    elseif event == \"WA_RELIQUARY_DEADEN_TARGET\" then\n        local guid = ...\n        \n        if allstates[\"\"] then\n            allstates[\"\"].hasTarget = true\n            allstates[\"\"].target = guid\n            allstates[\"\"].changed = true\n            return true\n        end\n    elseif event == \"WA_RELIQUARY_DEADEN_INTERRUPT\" then\n        if allstates[\"\"] then\n            allstates[\"\"].show = false\n            allstates[\"\"].changed = true\n            return true\n        end\n    end\n    \n    return false\nend",
