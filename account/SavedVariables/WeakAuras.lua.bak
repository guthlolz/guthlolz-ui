["disjunctive"] = "custom",
["customTriggerLogic"] = "function(trigger)\n    -- return false if call comes from 1 sec swing event duration\n    if not (trigger[1] or trigger[2] or trigger[3]) then return false end\n    \n    \n    if aura_env.config[\"wa_debug\"] then\n        if trigger[1] then print(\"Swing absorb detected\") end\n        if trigger[2] then print(\"Swing damage detected\") end\n        if trigger[3] then print(\"Swing miss detected\") end\n    end\n    \n    return aura_env.has_auras() and (trigger[1] or trigger[2] or trigger[3])\nend",
