},
["custom"] = "function(allstates,event)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 180,\n            expirationTime = GetTime()+180,\n            progressType = \"timed\",\n            icon = 136116,\n            autoHide = true,\n        }\n        return true\n    end\n    \n    if event == \"WA_RELIQUARY_P2_START\" then\n        if not UnitIsGroupLeader(\"player\") and not UnitIsGroupAssistant(\"player\") and UnitPowerType(\"player\") ~= 0 then\n            return false\n        end\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 180,\n            expirationTime = GetTime()+180,\n            progressType = \"timed\",\n            icon = 136116,\n            autoHide = true,\n        }\n        return true\n    elseif event == \"WA_RELIQUARY_P2_END\" or event == \"WA_FJI_ENCOUNTER_END\" or event == \"ENCOUNTER_END\" then\n        if allstates[\"\"] then\n            allstates[\"\"].show = false\n            allstates[\"\"].changed = true\n            return true\n        end\n    end\n    \n    return false\nend",
