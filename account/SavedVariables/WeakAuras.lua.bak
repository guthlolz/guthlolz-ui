["N:[BT][Trash] Behemoth Charge Range"] = {
["user_y"] = 0,
["iconSource"] = -1,
["user_x"] = 0,
["xOffset"] = 0,
["adjustedMax"] = "",
["yOffset"] = 0,
["foregroundColor"] = {
0.18823529411765,
0.72156862745098,
1,
1,
},
["displayText_format_p_time_format"] = 0,
["sameTexture"] = true,
["url"] = "https://wago.io/FojjiBT-P1/12",
["actions"] = {
["start"] = {
},
["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.npcID = \"23196\"\naura_env.unsafeMin = 5\naura_env.unsafeMax = 30\n\naura_env.events = {\n    rangeCheck = \"WA_BEHEMOTH_RANGE_CHECK\",\n    unsafe = \"WA_BEHEMOTH_NOT_SAFE\",\n    safe = \"WA_BEHEMOTH_SAFE\",\n}\n\naura_env.unsafe = false\naura_env.blacklist = {}\n\nfunction aura_env.isTrackedUnit(unit)\n    if not unit or not UnitExists(unit) then\n        return false\n    end\n    \n    local guid = UnitGUID(unit)\n    if aura_env.blacklist[guid] then\n        return false\n    end\n    \n    local npcID = select(6,strsplit(\"-\",guid or \"\"))\n    return npcID == aura_env.npcID\nend\n\nfunction aura_env.isUnsafeRange(range)\n    if not range then\n        return false\n    end\n    \n    if aura_env.unsafeMin and range < aura_env.unsafeMin then\n        return false\n    end\n    \n    if aura_env.unsafeMax and range > aura_env.unsafeMax then\n        return false\n    end\n    \n    return true\nend\n\nfunction aura_env.hasActiveNameplateState(allstates)\n    for unit,state in pairs(allstates) do\n        if unit ~= \"\" and state.show then\n            return true\n        end\n    end\n    \n    return false\nend\n\nfunction aura_env.checkTicker(allstates)\n    local hasNameplate = aura_env.hasActiveNameplateState(allstates)\n    local hasTarget = aura_env.isTrackedUnit(\"target\")\n    \n    if (hasNameplate or hasTarget) and not aura_env.ticker then\n        aura_env.ticker = C_Timer.NewTicker(0.2,function()\n                WeakAuras.ScanEvents(aura_env.events.rangeCheck)\n        end)\n    elseif not hasNameplate and not hasTarget and aura_env.ticker then\n        aura_env.ticker:Cancel()\n        aura_env.ticker = nil\n    end\nend\n\nfunction aura_env.updateSafety(allstates)\n    local unsafe = false\n    \n    if aura_env.isTrackedUnit(\"target\") then\n        local range = WeakAuras.GetRange(\"target\")\n        if aura_env.isUnsafeRange(range) then\n            unsafe = true\n        end\n    end\n    \n    if not unsafe then\n        for _,state in pairs(allstates) do\n            if state.show and state.isSafe == false then\n                unsafe = true\n                break\n            end\n        end\n    end\n    \n    if unsafe ~= aura_env.unsafe then\n        aura_env.unsafe = unsafe\n        \n        if unsafe then\n            WeakAuras.ScanEvents(aura_env.events.unsafe)\n        else\n            WeakAuras.ScanEvents(aura_env.events.safe)\n        end\n    end\nend",
},
["finish"] = {
},
},
["useTooltip"] = false,
["keepAspectRatio"] = true,
["wordWrap"] = "WordWrap",
["displayText_format_1.unitName_format"] = "none",
["desaturate"] = false,
["rotation"] = 0,
["font"] = "Numen",
