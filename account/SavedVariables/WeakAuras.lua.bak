["custom"] = "function(allstates,event,eID,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId,_,_,_,amount)\n    if spellId ~= aura_env.blessing then\n        return false\n    end\n    \n    if subEvent == \"SPELL_AURA_APPLIED\" then\n        WeakAuras.ScanEvents(\"WA_KARATHRESS_BLESSING\", 1)\n    elseif subEvent == \"SPELL_AURA_APPLIED_DOSE\" then\n        WeakAuras.ScanEvents(\"WA_KARATHRESS_BLESSING\", amount)\n    end\n    return true\nend",
