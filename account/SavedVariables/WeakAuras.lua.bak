["subeventSuffix"] = "_CAST_START",
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, updatedTriggerNumber, updatedTriggerStates)\n    if event == \"TRIGGER\" and updatedTriggerNumber then\n        local count = 0\n        \n        for _, state in pairs(updatedTriggerStates) do\n            if state.unit then\n                if math.abs(UnitLevel(state.unit) - UnitLevel(\"player\")) <= 10 then\n                    count = count + 1\n                end\n            end\n        end\n        \n        for _, state in pairs(allstates) do\n            state.show = false\n            state.changed = true\n        end\n        \n        allstates[\"\"] = {\n            show = count > 0,\n            changed = true,\n            value = count,\n            progressType = \"static\",\n        }\n        \n        return true\n    end\nend",
