},
},
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["subeventSuffix"] = "_CAST_START",
["spellIds"] = {
},
["events"] = "WA_ALAR_METEOR, WA_FJI_ENCOUNTER_END, ENCOUNTER_END",
["names"] = {
},
["check"] = "event",
["custom"] = "function(a, e)\n    if e == \"WA_ALAR_METEOR\" then\n        aura_env.count = aura_env.count + 1\n        \n        if aura_env.count == 1 then\n            a[\"\"] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = 12.5,\n                expirationTime = GetTime() + 12.5,\n                autoHide = true,\n            }\n            return true\n        end\n    end\n    \n    if e == \"WA_FJI_ENCOUNTER_END\" or e == \"ENCOUNTER_END\" then\n        aura_env.count = 0\n        if a[\"\"] then\n            a[\"\"].show = false\n            a[\"\"].changed = true\n            return true\n        end\n    end\nend",
