["CT:[T4][Magtheridon] Phase Controller"] = {
["outline"] = "OUTLINE",
["wagoID"] = "ASKpBvm6n",
["color"] = {
1,
1,
1,
1,
},
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["shadowYOffset"] = -1,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiT4RaidPack/3",
["actions"] = {
["start"] = {
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.key = \"MAGTHERIDON_P2_START\"\naura_env.key2 = \"MAGTHERIDON_P3_START\"\naura_env.p2Start = 120\naura_env.preWarnTimer = {}\naura_env.p1Count = 1\naura_env.p2Count = 2\n\nfunction aura_env.nuTimer(key, countdown, count)\n    WeakAuras.ScanEvents(\"WA_NUMEN_TIMER\", key, countdown, count)\nend\n\nfunction aura_env.updateState(allstates)\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n    }\nend\n\nfunction aura_env.hideState(allstates)\n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\nend\n\nfunction aura_env.preWarn(key, duration, preWarnTime, count)\n    if not preWarnTime then\n        preWarnTime = 3\n    end\n    \n    if aura_env.preWarnTimer[key] then\n        aura_env.preWarnTimer[key]:Cancel()\n        aura_env.preWarnTimer[key] = nil\n    end\n    aura_env.preWarnTimer[key] = C_Timer.NewTimer(duration - preWarnTime, function()\n            WeakAuras.ScanEvents(\"WA_\" .. key ..\"_PREWARN\", preWarnTime, count)\n            aura_env.preWarnTimer[key] = nil\n    end)\nend\n\nfunction aura_env.preWarnCancel(key)\n    WeakAuras.ScanEvents(\"WA_\" .. key .. \"_PREWARN_CANCEL\")\n    if aura_env.preWarnTimer[key] then\n        aura_env.preWarnTimer[key]:Cancel()\n        aura_env.preWarnTimer[key] = nil\n    end\nend\n\nlocal locale = GetLocale()\n\naura_env.locales = {\n    [\"enUS\"] = {\n        p2 = \"I... am... unleashed!\",\n        p3 = \"I will not be taken so easily! Let the walls of this prison tremble... and fall!\",\n    },\n    [\"frFR\"] = {\n        p2 = \"Me... voilà... déchaîné !\",\n        p3 = \"Que les murs de cette prison tremblent\",\n    },\n    [\"deDE\"] = {\n        p2 = \" Ich... bin... frei!\",\n        p3 = \"Ich lasse mich nicht so leicht bezwingen! Lasst die Mauern dieses Kerkers erzittern... und einstürzen!\",\n    },\n    [\"esES\"] = {\n        p2 = \"¡He... sido... liberado!\",\n        p3 = \"¡No me dejaré encerrar tan fácilmente! ¡Que tiemblen las paredes de esta prisión... y se derrumben!\",\n    },\n    [\"koKR\"] = {\n        p2 = \"내가... 풀려났도다!\",\n        p3 = \"그렇게 쉽게\",\n    },\n    [\"ruRU\"] = {\n        p2 = \"Я… освобожден!\",\n        p3 = \"Пусть стены темницы содрогнутся... и падут!\",\n    },\n    [\"zhCN\"] = {\n        p2 = \"我……自由了！\",\n        p3 = \"我不會這麼輕易就被擊敗!讓這座監獄的牆壁震顫...然後崩塌!\",\n    },\n    [\"zhTW\"] = {\n        p2 = \"我……被……釋放了!\",\n        p3 = \"我不會這麼輕易就被擊敗!讓這座監獄的牆壁震顫...然後崩塌!\",\n    }\n}\n\naura_env.currentLocale = aura_env.locales[locale] or aura_env.locales[\"enUS\"]",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "aura_env.preWarnTimer = {}\naura_env.p1Count = 1\naura_env.p2Count = 2\naura_env.nuTimer(aura_env.key, nil)\naura_env.preWarnCancel(aura_env.key)",
["do_sound"] = false,
["do_message"] = false,
["do_custom"] = true,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["custom_hide"] = "timed",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["unit"] = "player",
["custom"] = "function(allstates, event, ...)\n    if event == \"WA_FJI_ENCOUNTER_START\" then\n        aura_env.updateState(allstates)\n        aura_env.p1Count = 1\n        aura_env.p2Count = 1\n        aura_env.preWarnCancel(aura_env.key)\n        aura_env.preWarn(aura_env.key, aura_env.p2Start, 3, aura_env.p1Count)\n        aura_env.nuTimer(aura_env.key, aura_env.p2Start, aura_env.p1Count)\n        return true\n    elseif event == \"WA_FJI_ENCOUNTER_END\" then\n        aura_env.preWarnCancel(aura_env.key)\n        aura_env.nuTimer(aura_env.key, nil)\n        aura_env.hideState(allstates)\n        return true\n    elseif event == \"PLAYER_REGEN_ENABLED\" then\n        aura_env.preWarnCancel(aura_env.key)\n        aura_env.nuTimer(aura_env.key, nil)\n        aura_env.hideState(allstates)\n        return true\n    end\n    \n    if event == \"CHAT_MSG_MONSTER_YELL\" then\n        local msg = ...\n        if msg:find(aura_env.currentLocale.p2) or msg == aura_env.currentLocale.p2 then\n            aura_env.preWarnCancel(aura_env.key)\n            WeakAuras.ScanEvents(\"WA_MAGTHERIDON_P2_START\")\n            aura_env.nuTimer(aura_env.key, 0, aura_env.p1Count)\n            return true\n        elseif msg:find(aura_env.currentLocale.p3) or msg == aura_env.currentLocale.p3 then\n            WeakAuras.ScanEvents(\"WA_MAGTHERIDON_P3_START\")\n            aura_env.nuTimer(aura_env.key2, 0, aura_env.p2Count)\n            return true\n        end\n    end\nend",
["events"] = "WA_FJI_ENCOUNTER_END, WA_FJI_ENCOUNTER_START, CHAT_MSG_MONSTER_YELL, PLAYER_REGEN_ENABLED",
