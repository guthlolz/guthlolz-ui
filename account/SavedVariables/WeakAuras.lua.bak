},
["custom"] = "function(allstates,event,eID,subEvent,_,sourceGUID,_,_,_,destGUID,destName,_,_,spellId,_,_,_,amount)\n    if spellId ~= aura_env.spellID then\n        return false\n    end\n    \n    if subEvent == \"SPELL_AURA_APPLIED\" or subEvent == \"SPELL_AURA_APPLIED_DOSE\" then\n        WeakAuras.ScanEvents(\"WA_GURTOGG_BLOODBOIL_APPLIED\", destGUID, amount or 1)\n        return false\n    end\n    \n    if subEvent == \"SPELL_AURA_REMOVED\" then\n        WeakAuras.ScanEvents(\"WA_GURTOGG_BLOODBOIL_REMOVED\", destGUID)\n        return false\n    end\nend",
