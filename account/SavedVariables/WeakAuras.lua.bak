["custom"] = "function(allstates, event)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            icon = 132833,\n        }\n    end\n    if event == \"WA_KAELTHAS_REBIRTH\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            progressType = \"timed\",\n            icon = 132833,\n            autoHide = true,\n        }\n        return true\n    end\nend",
