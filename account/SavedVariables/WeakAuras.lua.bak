{
["trigger"] = {
["unit"] = "player",
["type"] = "custom",
["events"] = "WA_MOTHER_SHAHRAZ_FATAL",
["custom_type"] = "stateupdate",
["check"] = "event",
["custom"] = "function(allstates,event,...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"static\",\n            direction = \"LEFT\",\n        }\n        return true\n    end\n    \n    if event == \"WA_MOTHER_SHAHRAZ_FATAL\" then\n        local name1 = ...\n        if WeakAuras.me ~= name1 then\n            return false\n        end\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"static\",\n            direction = \"LEFT\",\n        }\n        return true\n    elseif event == \"WA_FJI_ENCOUNTER_END\" or event == \"ENCOUNTER_END\" then\n        if allstates[\"\"] then\n            allstates[\"\"].show = false\n            allstates[\"\"].changed = true\n            return true\n        end\n    end\nend",
["customVariables"] = "{\n    direction = \"string\",\n}",
["debuffType"] = "HELPFUL",
},
