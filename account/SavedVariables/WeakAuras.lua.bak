["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = aura_env.castTime,\n            expirationTime = GetTime() + aura_env.castTime,\n            autoHide = true,\n            icon = aura_env.icon,\n            hasTarget = true,\n            target = WeakAuras.myGUID,\n            isPlayer = true\n        }\n        return true\n    end\n    \n    if event == \"WA_TERON_SHADOW_DEATH_TARGET\" then\n        local guid, name = ...\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = aura_env.castTime,\n            expirationTime = GetTime() + aura_env.castTime,\n            autoHide = true,\n            icon = aura_env.icon,\n            hasTarget = true,\n            target = guid,\n            isPlayer = guid == WeakAuras.myGUID,\n        }\n        return true\n    end\nend",
