["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        for i = 1,2 do\n            allstates[i] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = 1.9,\n                expirationTime = GetTime() + 1.9,\n                autoHide = true,\n                guid = WeakAuras.myGUID,\n                name = \"player\",\n                icon = 132340,\n            }\n        end\n        return true\n    end\n    \n    if event == \"WA_TRASH_SHATTER_ARMOR_TARGET\" then\n        local sourceGUID, targetGUID, targetUnit = ...\n        local inMyParty = false\n        \n        for unit in WA_IterateGroupMembers(nil, true) do\n            if UnitGUID(unit) == targetGUID then\n                inMyParty = true\n                break\n            end\n        end\n        \n        if not inMyParty then\n            return false\n        end\n        \n        allstates[sourceGUID] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 1.9,\n            expirationTime = GetTime() + 1.9,\n            autoHide = true,\n            guid = targetGUID,\n            name = targetUnit,\n            icon = 132340,\n        }\n        return true\n    end\nend",
