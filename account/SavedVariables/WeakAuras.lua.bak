["group_count"] = "0",
["custom"] = "function(a, e, ...)\n    if e == \"OPTIONS\" then\n        for i = 1,5 do\n            a[i] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = 3,\n                expirationTime = GetTime() + 3,\n                autoHide = true,\n                guid = WeakAuras.myGUID,\n                isPlayer = true,\n            }\n        end\n        return true\n    end\n    \n    if e == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local _,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId = ...\n        \n        if spellId ~= 37433 then\n            return false\n        end\n        \n        a[destGUID] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 0.5,\n            expirationTime = GetTime() + 0.5,\n            autoHide = true,\n            guid = destGUID,\n            isPlayer = destGUID == WeakAuras.myGUID,\n        }\n        \n        if GetTime() - aura_env.throttle >= 2 then\n            aura_env.throttle = GetTime()\n            \n            local soundFile = aura_env.getRandomSound()\n            if soundFile then\n                local willPlay, handle = PlaySoundFile(soundFile, \"Master\")\n                aura_env.lastSoundFile = soundFile\n                aura_env.soundHandle = handle\n            end\n        end\n        return true\n    end\nend",
