["custom_hide"] = "timed",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["unit"] = "player",
["custom"] = "function(allstates, event, key, time, count)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 4,\n            expirationTime = GetTime() + 4,\n            progressType = \"timed\",\n            icon = 135925,\n            autoHide = true,\n            count = count\n        }\n        return true\n    end\n    if event == \"WA_NUMEN_TIMER\" and key == \"GRUUL_REVERBERATION\" and time == 0 then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 4,\n            expirationTime = GetTime() + 4,\n            progressType = \"timed\",\n            icon = 135925,\n            autoHide = true,\n            count = count\n        }\n        return true\n    end\nend",
["events"] = "WA_NUMEN_TIMER",
["customVariables"] = "",
["check"] = "event",
["spellIds"] = {
