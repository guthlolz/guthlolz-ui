["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(a,e,...)\n    if e == \"OPTIONS\" then\n        a[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 1.5,\n            expirationTime = GetTime() + 1.5,\n            state = \"Casting\",\n            interrupter = \"\",\n        }\n        return true\n    end\n    \n    if e == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local _,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId = ...\n        \n        if spellId ~= 11719 then\n            return false\n        end\n        \n        local npcID = select(6, strsplit(\"-\", destGUID))\n        \n        if npcID == \"21964\" then\n            if subEvent == \"SPELL_AURA_APPLIED\" then\n                aura_env.castTime = 1.42\n            elseif subEvent == \"SPELL_AURA_REMOVED\" then\n                aura_env.castTime = 0.85\n            end\n            return\n        end\n    end\n    \n    if e == \"WA_NUMEN_TIMER\" then\n        local key, time, count = ...\n        \n        if key == \"KARATHRESS_HEAL\" and time and time == 0 then\n            a[\"\"] = {\n                progressType = \"timed\",\n                duration = aura_env.castTime,\n                expirationTime = GetTime() + aura_env.castTime,\n                autoHide = true,\n                show = true,\n                changed = true,\n                state = \"Casting\",\n                interrupter = \"\",\n            }\n            return true\n        end\n    end\n    \n    if e == \"WA_KARATHRESS_HEAL_INTERRUPTED\" then\n        local sourceGUID = ...\n        if a[\"\"] then\n            a[\"\"].duration = 1\n            a[\"\"].expirationTime = GetTime() + 1\n            a[\"\"].changed = true\n            a[\"\"].state = \"Kicked\"\n            a[\"\"].interrupter = sourceGUID\n            return true\n        end\n    end\nend",
["spellIds"] = {
},
["events"] = "WA_NUMEN_TIMER, WA_KARATHRESS_HEAL_INTERRUPTED, CLEU:SPELL_AURA_APPLIED:SPELL_AURA_REMOVED",
