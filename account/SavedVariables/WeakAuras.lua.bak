["forceEvents"] = false,
["ignoreOptionsEventErrors"] = false,
},
["actions"] = {
["start"] = {
["message"] = "",
["custom"] = "",
["message_format_c_format"] = "none",
["message_type"] = "SAY",
["do_message"] = false,
["do_custom"] = false,
["message_custom"] = "",
},
["finish"] = {
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.itemID = 24494\naura_env.shown = false\n\nfunction aura_env.isArchimondeAvailable()\n    local _,_,_,_,_,_,_,instanceID = GetInstanceInfo()\n    \n    if instanceID ~= 534 then\n        return false\n    end\n    \n    for i = 1,GetNumSavedInstances() do\n        local _,_,_,_,locked,_,_,_,_,_,_,encounterProgress,_,savedInstanceID = GetSavedInstanceInfo(i)\n        \n        if savedInstanceID == 534 and locked and encounterProgress and encounterProgress >= 4 then\n            return true\n        end\n    end\n    \n    return false\nend\n\nfunction aura_env.createClickable(allstates)\n    if not aura_env.button then\n        local r = WeakAuras.GetRegion(aura_env.id)\n        aura_env.button = CreateFrame(\"Button\",\"Reminder\",r,\"SecureActionButtonTemplate\")\n    end\n    \n    aura_env.button:SetAllPoints()\n    aura_env.button:RegisterForClicks(\"LeftButtonDown\",\"LeftButtonUp\")\n    aura_env.button:SetAttribute(\"type1\",\"macro\")\n    aura_env.button:SetAttribute(\"macrotext1\",\"/use item:\" .. aura_env.itemID)\n    \n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n    }\n    \n    WeakAuras.ScanEvents(\"WA_ARCHIMONDE_TEARS_CLICKABLE_ACTIVE\")\n    print(\"|cff00ccffFojji|r|cff00ff00T6|r - Tears Clickable Frame Created\")\nend\n\nfunction aura_env.scheduleCreate()\n    if aura_env.shown then\n        return\n    end\n    \n    if aura_env.timer then\n        aura_env.timer:Cancel()\n        aura_env.timer = nil\n    end\n    \n    aura_env.timer = C_Timer.NewTimer(1,function()\n            WeakAuras.ScanEvents(\"WA_ARCHIMONDE_CREATE_CLICKABLE\")\n    end)\nend",
["do_custom"] = true,
},
},
},
