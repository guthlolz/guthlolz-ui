["custom"] = "function(allstates, event, source)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 3,\n            expirationTime = GetTime() + 3,\n            progressType = \"timed\",\n            icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\illidandemon.jpg\",\n            autoHide = true,\n        }\n        return true\n    end\n    \n    if event == \"WA_ILLIDAN_DEMON_FORM_DETECT\" then\n        if source ~= \"YELL\" then\n            return false\n        end\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 2.5,\n            expirationTime = GetTime() + 2.5,\n            progressType = \"timed\",\n            icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\illidandemon.jpg\",\n            autoHide = true,\n        }\n        return true\n    end\nend",
