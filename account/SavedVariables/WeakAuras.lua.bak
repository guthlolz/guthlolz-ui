},
{
["subOptions"] = {
{
["type"] = "space",
["variableWidth"] = true,
["height"] = 1,
["width"] = 2,
["useHeight"] = false,
},
{
["fontSize"] = "large",
["text"] = "THIS AURA DOES NOTHING IF YOU RECEIVE RAID LEADER ASSIGNMENTS.",
["type"] = "description",
["width"] = 2,
},
{
["type"] = "header",
["text"] = "",
["useName"] = false,
["width"] = 1,
},
{
["fontSize"] = "medium",
["text"] = "Fallback Bloodboil soak assignment for PUGs or raids without assignments.\n\nSelect your Soak Team and Soak Amount below. The aura will automatically tell you when to start and stop soaking based on the Bloodboil rotation.\n\nIf the Raid Leader sends Bloodboil assignments in Raid Chat at the start of the pull, these settings are automatically ignored.",
["type"] = "description",
["width"] = 2,
},
{
["type"] = "header",
["text"] = "",
["useName"] = false,
["width"] = 1,
},
{
["type"] = "toggle",
["key"] = "enable",
["useDesc"] = false,
["default"] = false,
["name"] = "Enable Personal Soak Warnings",
["width"] = 1,
},
{
["type"] = "space",
["variableWidth"] = true,
["height"] = 1,
["width"] = 1,
["useHeight"] = false,
},
{
["desc"] = "The team you are assigned to soak for. Team 1 > Team 2 > Team 3 is the rotation",
["type"] = "select",
["values"] = {
"Team 1",
"Team 2",
"Team 3",
},
["name"] = "Soak Team #",
["useDesc"] = true,
["default"] = 1,
["key"] = "team",
["width"] = 0.6,
},
{
["desc"] = "The amount of soaks you should do when it's your turn to soak.",
["type"] = "select",
