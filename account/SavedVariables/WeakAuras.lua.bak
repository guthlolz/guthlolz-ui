["displayText"] = "%c",
["customText"] = "function()\n    if(aura_env.inCombat) then\n        return \" Entering Combat \"\n    else\n        return \" Leaving Combat \"\n    end\n    return \"\"\nend\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",
