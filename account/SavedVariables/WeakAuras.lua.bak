["desaturateForeground"] = false,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, ...)\n    if event == \"STATUS\" then\n        if aura_env.ticker then\n            aura_env.ticker:Cancel()\n            aura_env.ticker = nil\n        end\n        \n        aura_env.whitelist = {}\n        aura_env.unsafe = false\n        return true\n    end\n    \n    if event == \"OPTIONS\" then\n        if aura_env.ticker then\n            aura_env.ticker:Cancel()\n            aura_env.ticker = nil\n        end\n        \n        aura_env.whitelist = {}\n        aura_env.unsafe = false\n        \n        local rnd = math.random(1,40)\n        \n        for i = 1, 2 do\n            allstates[i] = {\n                show = true,\n                changed = true,\n                range = rnd,\n                isSafe = rnd and (rnd >= 21) or false,\n                progressType = \"static\",\n                value = rnd,\n                total = 40,\n            }\n        end\n        \n        aura_env.updateSafety(allstates)\n        return true\n    end\n    \n    --[[if event == \"WA_COLOSSUS_ABILITIES_DETECT\" then\n        local spellData, guid = ...\n        if spellData == \"Quake / Infection\" and guid then\n            aura_env.whitelist[guid] = true\n            aura_env.updateState(allstates, guid)\n            aura_env.ensureTicker()\n            aura_env.updateSafety(allstates)\n            return true\n        end\n    end--]]\n    \n    if event == \"WA_COLOSSUS_QUAKE_END\" then\n        local guid = ...\n        \n        aura_env.whitelist[guid] = nil\n        \n        if allstates[guid] then\n            allstates[guid] = {\n                show = false,\n                changed = true,\n                guid = guid,\n            }\n        end\n        \n        aura_env.checkTicker(allstates)\n        aura_env.updateSafety(allstates)\n        return true\n    end\n    \n    if event == \"WA_NUMEN_TIMER\" then\n        local key, time, count, guid = ...\n        \n        if key ~= \"TRASH_QUAKE\" then\n            return false\n        end\n        \n        if guid and time == nil then\n            aura_env.whitelist[guid] = nil\n            \n            if allstates[guid] then\n                allstates[guid] = {\n                    show = false,\n                    changed = true,\n                    guid = guid,\n                }\n            end\n            \n            aura_env.checkTicker(allstates)\n            aura_env.updateSafety(allstates)\n            return true\n        end\n        \n        if guid and time and time == 0 then\n            aura_env.whitelist[guid] = true\n            aura_env.updateState(allstates, guid)\n            aura_env.ensureTicker()\n            aura_env.updateSafety(allstates)\n            aura_env.scheduleEnd(guid)\n            return true\n        end\n    end\n    \n    if event == \"PLAYER_TARGET_CHANGED\" then\n        local guid = UnitGUID(\"target\")\n        \n        if guid and aura_env.whitelist[guid] then\n            aura_env.updateState(allstates, guid)\n            aura_env.ensureTicker()\n            aura_env.updateSafety(allstates)\n            return true\n        end\n    end\n    \n    if event == \"NAME_PLATE_UNIT_ADDED\" then\n        local unit = ...\n        local guid = UnitGUID(unit)\n        \n        if guid and aura_env.whitelist[guid] then\n            aura_env.updateState(allstates, guid, unit)\n            aura_env.ensureTicker()\n            aura_env.updateSafety(allstates)\n            return true\n        end\n    end\n    \n    if event == \"NAME_PLATE_UNIT_REMOVED\" then\n        local unit = ...\n        local guid = UnitGUID(unit)\n        \n        if guid and allstates[guid] then\n            local newUnit = aura_env.findUnitByGUID(guid)\n            \n            if newUnit then\n                aura_env.updateState(allstates, guid, newUnit)\n            else\n                allstates[guid].show = false\n                allstates[guid].changed = true\n                allstates[guid].unit = nil\n            end\n        end\n        \n        aura_env.checkTicker(allstates)\n        aura_env.updateSafety(allstates)\n        return true\n    end\n    \n    if event == \"WA_COLOSSUS_RANGE_CHECK\" then\n        for guid, state in pairs(allstates) do\n            if state.show and aura_env.whitelist[guid] then\n                aura_env.updateState(allstates, guid)\n            end\n        end\n        \n        aura_env.checkTicker(allstates)\n        aura_env.updateSafety(allstates)\n        return true\n    end\nend",
["spellIds"] = {
},
