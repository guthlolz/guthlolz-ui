["N:[BT][Illidari] Reflective Shield"] = {
["user_y"] = 0,
["iconSource"] = -1,
["user_x"] = 0,
["xOffset"] = 0,
["displayText"] = "Use Elixir of Demonslaying?",
["yOffset"] = 10,
["foregroundColor"] = {
0.72156862745098,
0.51372549019608,
1,
1,
},
["sparkRotation"] = 0,
["sameTexture"] = true,
["url"] = "https://wago.io/FojjiBT-P1/12",
["actions"] = {
["start"] = {
["do_custom"] = false,
["custom"] = "",
},
["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.activeShields = {}\n\nfunction aura_env.GetNameplateUnit(guid)\n    for _,plateData in pairs(C_NamePlate.GetNamePlates()) do\n        local unit = plateData.UnitFrame.displayedUnit\n        if unit and UnitGUID(unit) == guid then\n            return unit\n        end\n    end\nend\n\nfunction aura_env.ShowState(allStates,guid)\n    local data = aura_env.activeShields[guid]\n    if not data then\n        return false\n    end\n    \n    local unit = aura_env.GetNameplateUnit(guid)\n    if not unit then\n        return false\n    end\n    \n    allStates[guid] = {\n        changed = true,\n        show = true,\n        progressType = \"static\",\n        value = data.value,\n        total = data.total,\n        unit = unit,\n    }\n    return true\nend\n\nfunction aura_env.HideState(allStates,guid)\n    local state = allStates[guid]\n    if not state then\n        return false\n    end\n    \n    state.show = false\n    state.changed = true\n    return true\nend",
},
["finish"] = {
},
},
