["N:[T5][SSC][Trash] Colossus Type"] = {
["iconSource"] = -1,
["wagoID"] = "gSs1_GQRl",
["parent"] = "[T5]: Nameplates",
["adjustedMax"] = "",
["adjustedMin"] = "",
["yOffset"] = -2,
["anchorPoint"] = "BOTTOMLEFT",
["cooldownSwipe"] = true,
["url"] = "https://wago.io/FojjiT5RaidPack/3",
["actions"] = {
["start"] = {
},
["finish"] = {
},
["init"] = {
["custom"] = "aura_env.guids = {}\n\naura_env.icons = {\n    [\"Frenzy / Atrophic\"] = { icon = 136146, name = \"Frenzy\"},\n    [\"Quake / Infection\"] = { icon = 135801, name = \"Quake\"},\n    [\"Geyser / Parasite\"] = { icon = 135793, name = \"Geyser\"},\n}",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["subeventSuffix"] = "_CAST_START",
["events"] = "TRIGGER:2 PLAYER_REGEN_ENABLED, NAME_PLATE_UNIT_ADDED, NAME_PLATE_UNIT_REMOVED, WA_COLOSSUS_ABILITIES_DETECT, UNIT_SPELLCAST_CHANNEL_STOP:nameplate",
["custom"] = "function(a, event, ...)\n    if event == \"OPTIONS\" then\n        local type = \"Quake / Infection\"\n        local data = aura_env.icons[type]\n        \n        a[\"\"] = {\n            show = true,\n            changed = true,\n            name = type,\n            shortName = data.name,\n            icon = data.icon,\n        }\n        return true\n    end\n    \n    if event == \"UNIT_SPELLCAST_CHANNEL_STOP\" then\n        local unit = ...\n        local guid = UnitGUID(unit)\n        \n        if aura_env.guids[guid] then\n            local type = aura_env.guids[guid]\n            local data = aura_env.icons[type]\n            \n            if not data then\n                return false\n            end\n            \n            a[guid] = {\n                show = true,\n                changed = true,\n                name = type,\n                shortName = data.name,\n                icon = data.icon,\n                unit = unit,\n                guid = guid,\n            }\n            return true\n        end\n    end\n    \n    if event == \"TRIGGER\" then\n        local triggerNumber, triggerStates = ...\n        if not triggerStates then\n            return false\n        end\n        \n        if triggerNumber ~= 2 then\n            return false\n        end\n        \n        for _, state in pairs(triggerStates) do\n            if state.unit then\n                local unit = state.unit\n                local guid = UnitGUID(unit)\n                if a[guid] then\n                    a[guid].show = false\n                    a[guid].changed = true\n                    return true\n                end\n            end\n        end\n    end\n    \n    if event == \"WA_COLOSSUS_ABILITIES_DETECT\" then\n        local type, guid = ...\n        if not guid then\n            return false\n        end\n        \n        local data = aura_env.icons[type]\n        if not data then\n            return false\n        end\n        \n        aura_env.guids[guid] = type\n        \n        for _, plateData in pairs(C_NamePlate.GetNamePlates()) do\n            local unit = plateData.UnitFrame and plateData.UnitFrame.displayedUnit\n            if unit and UnitGUID(unit) == guid then\n                a[guid] = {\n                    show = true,\n                    changed = true,\n                    name = type,\n                    shortName = data.name,\n                    icon = data.icon,\n                    unit = unit,\n                    guid = guid,\n                }\n                return true\n            end\n        end\n    end\n    \n    if event == \"NAME_PLATE_UNIT_ADDED\" then\n        local unit = ...\n        local guid = UnitGUID(unit)\n        \n        if aura_env.guids[guid] then\n            local type = aura_env.guids[guid]\n            local data = aura_env.icons[type]\n            \n            if not data then\n                return false\n            end\n            \n            a[guid] = {\n                show = true,\n                changed = true,\n                name = type,\n                shortName = data.name,\n                icon = data.icon,\n                unit = unit,\n                guid = guid,\n            }\n            return true\n        end\n    end\n    \n    if event == \"NAME_PLATE_UNIT_REMOVED\" then\n        local unit = ...\n        local guid = UnitGUID(unit)\n        \n        if a[guid] then\n            a[guid].show = false\n            a[guid].changed = true\n            a[guid].unit = nil\n            return true\n        end\n    end\n    \n    if event == \"PLAYER_REGEN_ENABLED\" then\n        for _, state in pairs(a) do\n            state.show = false\n            state.changed = true\n            state.unit = nil\n        end\n        \n        wipe(aura_env.guids)\n        return true\n    end\nend",
["subeventPrefix"] = "SPELL",
["check"] = "event",
["unit"] = "player",
["spellIds"] = {
},
["debuffType"] = "HELPFUL",
},
