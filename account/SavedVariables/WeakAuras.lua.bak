["icon_side"] = "LEFT",
["customText"] = "function()\n    local defBonus = GetDodgeBlockParryChanceFromDefense()\n    local miss = defBonus + 5                              \n    local dodge = GetDodgeChance()\n    local parry = GetParryChance()\n    local block = GetBlockChance()\n    \n    local total = miss + dodge + parry + block\n    local crushCap = 102.4\n    \n    if total >= crushCap then\n        return string.format(\"|cff00ff00%.2f / 102.4|r\", total)        \n    else\n        return string.format(\"|cffff0000%.2f / 102.4|r\", total)\n    end\nend",
