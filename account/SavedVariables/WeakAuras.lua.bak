["auraspellids"] = {
},
["events"] = "OPTIONS WA_NUMEN_TIMER WA_ILLIDARI_SEAL_REMOVED",
["custom"] = "function(allstates,event,key,time,count,spellId)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 30,\n            expirationTime = GetTime() + 30,\n            autoHide = true,\n            name = \"Seal of Command\",\n            icon = GetSpellTexture(41469),\n        }\n        return true\n    end\n    \n    if not _G.FJI_TANK and not _G.FJI_HEALER and not UnitIsGroupLeader(\"player\") then\n        return false\n    end\n    \n    if event ~= \"WA_NUMEN_TIMER\" or key ~= aura_env.key then\n        return false\n    end\n    \n    if time == nil then\n        if allstates[\"\"] then\n            allstates[\"\"].show = false\n            allstates[\"\"].changed = true\n            return true\n        end\n        return false\n    end\n    \n    local aura = spellId and aura_env.auras[spellId]\n    if not aura then\n        return false\n    end\n    \n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n        progressType = \"timed\",\n        duration = time,\n        expirationTime = GetTime() + time,\n        autoHide = true,\n        name = aura.name,\n        icon = aura.icon,\n    }\n    return true\nend",
["check"] = "event",
["subeventSuffix"] = "_CAST_START",
