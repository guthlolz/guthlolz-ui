["event"] = "Health",
["unit"] = "player",
["subeventSuffix"] = "_CAST_START",
["spellIds"] = {
},
["custom"] = "function(allstates, event, key, time, count)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 1,\n            expirationTime = GetTime() + 1,\n            progressType = \"timed\",\n            icon = 136222,\n            autoHide = true,\n        }\n        return true\n    end\n    if event == \"WA_NUMEN_TIMER\" and key == \"RELIQUARY_SOUL_DRAIN\" then\n        if time == 0 then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = 1,\n                expirationTime = GetTime() + 1,\n                progressType = \"timed\",\n                icon = 136222,\n                autoHide = true,\n            }\n        elseif time == nil then\n            if allstates[\"\"] then\n                allstates[\"\"].show = false\n                allstates[\"\"].changed = true\n            end\n        end\n        return true\n    end\nend",
["events"] = "WA_NUMEN_TIMER",
["check"] = "event",
["subeventPrefix"] = "SPELL",
["debuffType"] = "HELPFUL",
["customVariables"] = "",
},
["untrigger"] = {
