["CT:[T4][GL] Encounter Start Helper"] = {
["outline"] = "OUTLINE",
["wagoID"] = "ASKpBvm6n",
["color"] = {
1,
1,
1,
1,
},
["displayText_format_p_time_dynamic_threshold"] = 60,
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiT4RaidPack/3",
["actions"] = {
["start"] = {
["do_custom"] = false,
["custom"] = "DisableEvent(RaidBossEmoteFrame, \"RAID_BOSS_EMOTE\")\nDisableEvent(RaidBossEmoteFrame, \"RAID_BOSS_WHISPER\")\nDisableEvent(RaidBossEmoteFrame, \"CLEAR_BOSS_EMOTES\")\nprint(\"unregister\")",
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.NPC_TO_ENCOUNTER = {\n    [\"18831\"] = 649, -- Maulgar\n    [\"18836\"] = 649, -- Blindeye\n    [\"18835\"] = 649, -- Kiggler\n    [\"18834\"] = 649, -- Olm\n    [\"18832\"] = 649, -- Krosh\n    [\"19044\"] = 650, -- Gruul\n}\n\naura_env.HP_THRESHOLD = 0.999\naura_env.activeEncounterID = nil\n\nlocal UnitExists = UnitExists\nlocal UnitGUID = UnitGUID\nlocal UnitHealth = UnitHealth\nlocal UnitHealthMax = UnitHealthMax\nlocal UnitAffectingCombat = UnitAffectingCombat\nlocal UnitCanAttack = UnitCanAttack\nlocal strsplit = strsplit\n\nfunction aura_env.getNpcIDFromGUID(guid)\n    if not guid then\n        return\n    end\n    \n    local _, _, _, _, _, npcId = strsplit(\"-\", guid)\n    return npcId\nend\n\nfunction aura_env.clearActive()\n    aura_env.activeEncounterID = nil\nend\n\nfunction aura_env.isActive()\n    return aura_env.activeEncounterID ~= nil\nend\n\nfunction aura_env.fireStart(encounterID, source, npcID, unit)\n    if aura_env.isActive() then\n        return false\n    end\n    aura_env.activeEncounterID = encounterID\n    WeakAuras.ScanEvents(\"WA_FJI_ENCOUNTER_START\", encounterID, source, npcID, unit)\n    return true\nend\n\nfunction aura_env.checkUnitForFakePull(unit)\n    if aura_env.isActive() then\n        return false\n    end\n    \n    local guid = UnitGUID(unit)\n    if not guid then\n        return false\n    end\n    \n    local npcID = aura_env.getNpcIDFromGUID(guid)\n    local encounterID = npcID and aura_env.NPC_TO_ENCOUNTER[npcID]\n    if not encounterID then\n        return false\n    end\n    \n    local hpMax = UnitHealthMax(unit) or 0\n    if hpMax <= 0 then\n        return false\n    end\n    \n    local hp = UnitHealth(unit) or hpMax\n    local pct = hp / hpMax\n    \n    if pct >= aura_env.HP_THRESHOLD then\n        return false\n    end\n    \n    if not UnitAffectingCombat(\"player\") and not UnitAffectingCombat(unit) then\n        return false\n    end\n    \n    return aura_env.fireStart(encounterID, \"FAKE\", npcID, unit)\nend\n\nfunction aura_env.scanCommonUnits()\n    if aura_env.isActive() then\n        return false\n    end\n    \n    if aura_env.checkUnitForFakePull(\"target\") then\n        return true\n    end\n    if aura_env.checkUnitForFakePull(\"focus\") then\n        return true\n    end\n    \n    for i = 1, 40 do\n        if aura_env.checkUnitForFakePull(\"nameplate\" .. i) then\n            return true\n        end\n    end\n    \n    return false\nend",
["do_custom"] = true,
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_hide"] = "timed",
["subeventSuffix"] = "_CAST_START",
["dynamicDuration"] = false,
["duration"] = "0.1",
["event"] = "Chat Message",
["unit"] = "player",
["custom"] = "function(allstates, event, ...)\n    if event == \"STATUS\" or event == \"PLAYER_REGEN_ENABLED\" then\n        aura_env.clearActive()\n        return false\n    end\n    \n    if event == \"ENCOUNTER_START\" then\n        local encounterID = ...\n        if encounterID then\n            aura_env.fireStart(encounterID, \"REAL\")\n        end\n        return false\n    end\n    \n    if event == \"WA_FJI_ENCOUNTER_END\" then\n        aura_env.clearActive()\n        WeakAuras.ScanEvents(\"WA_FJI_ENCOUNTER_END_CONFIRMED\")\n        return false\n    end\n    \n    if event == \"PLAYER_REGEN_DISABLED\" then\n        aura_env.scanCommonUnits()\n        return false\n    end\n    \n    if event == \"PLAYER_TARGET_CHANGED\" then\n        aura_env.checkUnitForFakePull(\"target\")\n        return false\n    end\n    \n    if event == \"NAME_PLATE_UNIT_ADDED\" then\n        local unit = ...\n        aura_env.checkUnitForFakePull(unit)\n        return false\n    end\n    \n    if event == \"UNIT_HEALTH\" then\n        local unit = ...\n        aura_env.checkUnitForFakePull(unit)\n        return false\n    end\n    \n    return false\nend",
["spellIds"] = {
},
["events"] = "UNIT_HEALTH NAME_PLATE_UNIT_ADDED PLAYER_TARGET_CHANGED WA_FJI_ENCOUNTER_END ENCOUNTER_START PLAYER_REGEN_DISABLED PLAYER_REGEN_ENABLED STATUS",
