["finish"] = {
},
["init"] = {
["custom"] = "aura_env.npcID = \"21214\"\n\nfunction aura_env.getNpcID(guid)\n    local _,_,_,_,_,npcID = strsplit(\"-\", guid)\n    return npcID\nend\n\nfunction aura_env.getKarathressUnit()\n    for _, plateData in pairs(C_NamePlate.GetNamePlates()) do\n        local unit = plateData.UnitFrame and plateData.UnitFrame.displayedUnit\n        if unit and UnitExists(unit) then\n            local guid = UnitGUID(unit)\n            if aura_env.getNpcID(guid) == aura_env.npcID then\n                return unit\n            end\n        end\n    end\n    \n    return nil\nend\n\nfunction aura_env.getKarathressRange()\n    local unit = aura_env.getKarathressUnit()\n    if not unit then\n        return nil\n    end\n    \n    return WeakAuras.GetRange(unit), unit\nend",
["do_custom"] = true,
},
},
