["names"] = {
},
["duration"] = "2",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(a, event, ...)\n    if event == \"OPTIONS\" then aura_env.text = \"MOVE!\"; return end\n    \n    local spellId = select(12, ...)\n    local targetName = select(9, ...)\n    \n    if spellId == 30846 then\n        local sourceGUID = select(4, ...)\n        if WeakAuras.me == targetName then\n            a[sourceGUID] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                autoHide = true,\n                duration = 2,\n                expirationTime = GetTime() + 2,\n                name = \"MOVE!\"\n            }\n            return true\n        elseif IsItemInRange(8149, targetName) == true then\n            a[sourceGUID] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                autoHide = true,\n                duration = 2,\n                expirationTime = GetTime() + 2,\n                name = \"NEAR!\"\n            }\n            return true\n        end\n    end\nend\n\n\n\n",
["customName"] = "function()\n    return aura_env.text or \"\"\nend",
