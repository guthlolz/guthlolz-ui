["desaturateForeground"] = false,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["subeventSuffix"] = "_CAST_START",
["spellIds"] = {
},
["events"] = "CLEU:SPELL_CAST_SUCCESS:SPELL_DAMAGE:SPELL_MISSED:SPELL_AURA_APPLIED:UNIT_DIED, PLAYER_TARGET_CHANGED, PLAYER_REGEN_ENABLED",
["names"] = {
},
["check"] = "event",
["custom"] = "function(allstates,event,_,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId)\n    if event == \"OPTIONS\" then\n        local randomSpell = aura_env.optionSpells[math.random(#aura_env.optionSpells)]\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = aura_env.duration,\n            expirationTime = GetTime() + aura_env.duration,\n            autoHide = true,\n            isTarget = false,\n            spell = randomSpell.spell,\n            icon = randomSpell.icon,\n        }\n        return true\n    end\n    \n    if event == \"PLAYER_REGEN_ENABLED\" then\n        for _, state in pairs(allstates) do\n            state.show = false\n            state.changed = true\n            state.isTarget = false\n        end\n        \n        wipe(aura_env.seen)\n        return true \n    end\n    \n    if event == \"PLAYER_TARGET_CHANGED\" or event == \"STATUS\" then\n        local targetGUID = UnitExists(\"target\") and UnitGUID(\"target\")\n        \n        for guid, state in pairs(allstates) do\n            local isTarget = targetGUID and guid == targetGUID or false\n            if state.isTarget ~= isTarget then\n                state.isTarget = isTarget\n                state.changed = true\n            end\n        end\n        \n        if targetGUID and aura_env.saved.detectedMobs[targetGUID] and not allstates[targetGUID] then\n            local savedData = aura_env.saved.detectedMobs[targetGUID]\n            \n            allstates[targetGUID] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = aura_env.duration,\n                expirationTime = GetTime() + aura_env.duration,\n                autoHide = true,\n                isTarget = true,\n                spell = savedData.spell,\n                icon = savedData.icon,\n            }\n            \n            return true\n        end\n        \n        return true\n    end\n    \n    if subEvent == \"UNIT_DIED\" then\n        if allstates[destGUID] then\n            allstates[destGUID].show = false\n            allstates[destGUID].changed = true\n            allstates[destGUID].isTarget = false\n        end\n        \n        if destGUID then\n            aura_env.saved.detectedMobs[destGUID] = nil\n            aura_env.seen[destGUID] = nil\n        end\n        \n        return true\n    end\n    \n    local spellType = aura_env.spells[subEvent]\n    if not spellType then\n        return false\n    end\n    \n    local spellData = spellType[spellId]\n    if not spellData then\n        return false\n    end\n    \n    local npcID = select(6, strsplit(\"-\", sourceGUID or \"\"))\n    if npcID ~= aura_env.npcID then\n        return false\n    end\n    \n    local notSeen = not aura_env.seen[sourceGUID]\n    \n    aura_env.saved.detectedMobs[sourceGUID] = {\n        spell = spellData.spell,\n        icon = spellData.icon,\n    }\n    \n    allstates[sourceGUID] = {\n        show = true,\n        changed = true,\n        progressType = \"timed\",\n        duration = aura_env.duration,\n        expirationTime = GetTime() + aura_env.duration,\n        autoHide = true,\n        isTarget = UnitExists(\"target\") and UnitGUID(\"target\") == sourceGUID,\n        spell = spellData.spell,\n        icon = spellData.icon,\n    }\n    \n    if not aura_env.seen[sourceGUID] then\n        aura_env.seen[sourceGUID] = true\n        WeakAuras.ScanEvents(\"WA_COLOSSUS_ABILITIES_DETECT\", spellData.spell, sourceGUID)\n    end\n    \n    return true\nend",
["unit"] = "player",
["customVariables"] = "{\n    isTarget = \"bool\",\n    spell = \"string\",\n}",
},
