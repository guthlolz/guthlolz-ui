["custom"] = "function(allstates, event, target)\n    if event == \"WA_SUPREMUS_FIXATE_TARGET\" then\n        if target == WeakAuras.me then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                icon = 136129,\n                unit = target,\n            }\n        else\n            if allstates[\"\"] then\n                allstates[\"\"].show = false\n                allstates[\"\"].changed = true\n            end\n        end\n        return true\n    end\n    \n    if event == \"ENCOUNTER_END\" or event == \"WA_SUPREMUS_TANK_PHASE\" then\n        if allstates[\"\"] then\n            allstates[\"\"].show = false\n            allstates[\"\"].changed = true\n            return true\n        end\n    end\nend",
["match_countOperator"] = ">",
