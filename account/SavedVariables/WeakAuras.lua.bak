["N:[BT][Trash] Whirlwind"] = {
["user_y"] = 0,
["iconSource"] = 0,
["user_x"] = 0,
["xOffset"] = 0,
["adjustedMax"] = "",
["yOffset"] = 10,
["anchorPoint"] = "TOP",
["sameTexture"] = true,
["url"] = "https://wago.io/FojjiBT-P1/12",
["actions"] = {
["start"] = {
},
["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.tickers = {}\naura_env.expirationTime = {}\naura_env.duration = {}\naura_env.range = {}\n\nfunction aura_env.startTicker(unit, guid, duration, safeRange)\n    if not unit or aura_env.tickers[unit] then return end\n    \n    local updatesPerSecond = 10\n    local interval = 1 / updatesPerSecond\n    local iterations = math.ceil(duration * updatesPerSecond)\n    local endTime = GetTime() + duration\n    \n    aura_env.tickers[unit] = C_Timer.NewTicker(interval, function()\n            local now = GetTime()\n            \n            if now > endTime then\n                if aura_env.tickers[unit] then\n                    aura_env.tickers[unit]:Cancel()\n                    aura_env.tickers[unit] = nil\n                end\n                return\n            end\n            \n            if UnitExists(unit) then\n                local range = WeakAuras.GetRange(unit)\n                local safe = range and range >= safeRange\n                WeakAuras.ScanEvents(\"WA_WW_UPDATE\", guid, safe)\n            end\n    end, iterations)\nend",
},
["finish"] = {
},
},
