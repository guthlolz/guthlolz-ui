["message_format_C_format"] = "none",
["do_custom"] = true,
["sound"] = "Interface\\Addons\\FojjiCore\\sound\\fojjiPop1.ogg",
},
["init"] = {
["custom"] = "aura_env.e = \"RELIQUARY_DEADEN\"\naura_env.icon = 136212\naura_env.fallbackTime = 10\naura_env.name = \"DEADEN\"\n\nfunction aura_env.scheduleFallback(time)\n    if aura_env.timer then\n        aura_env.timer:Cancel()\n        aura_env.timer = nil\n    end\n    \n    aura_env.timer = C_Timer.NewTimer(time, function()\n            WeakAuras.ScanEvents(\"WA_\" .. aura_env.e .. \"_PREWARN_FALLBACK\")\n    end)\nend\n\nfunction aura_env.cancelFallback()\n    if aura_env.timer then\n        aura_env.timer:Cancel()\n        aura_env.timer = nil\n    end\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "",
["do_custom"] = false,
},
},
