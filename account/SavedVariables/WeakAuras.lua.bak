{
["trigger"] = {
["auranames"] = {
"Rapid Fire",
},
["dynamicDuration"] = true,
["customIcon"] = "function()\n    return aura_env.icon\nend",
["subeventPrefix"] = "SPELL",
["debuffType"] = "HELPFUL",
["custom_hide"] = "timed",
["type"] = "custom",
["useName"] = true,
["subeventSuffix"] = "_CAST_START",
["custom_type"] = "stateupdate",
["spellIds"] = {
},
["event"] = "Health",
["customStacks"] = "function()\n    return aura_env.stacks\nend",
["customDuration"] = "function()\n    return aura_env.duration, aura_env.expirationTime\nend",
["customName"] = "function()\n    return aura_env.name\nend",
["events"] = "STATUS PLAYER_EQUIPMENT_CHANGED CLEU:SPELL_AURA_APPLIED:SPELL_AURA_REMOVED:SPELL_DAMAGE:SPELL_ENERGIZE:SPELL_HEAL:SPELL_SUMMON",
["custom"] = "function(allstates, event, ...)\n    if event == \"STATUS\" then\n        if aura_env.restoreSavedICD(allstates) then\n            return true\n        end\n        aura_env.setTrinket()\n        return\n    end\n    \n    if event == \"PLAYER_EQUIPMENT_CHANGED\" then\n        local slot = ...\n        if slot ~= aura_env.slot then\n            return\n        end\n        \n        if aura_env.restoreSavedICD(allstates) then\n            return true\n        end\n        \n        allstates[\"\"] = {\n            show = false,\n            changed = true,\n            duration = 0,\n            expirationTime = 0\n        }\n        return true\n    end\n    \n    if event ~= \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        return\n    end\n    \n    if not aura_env.currentTrinket then\n        return\n    end\n    \n    local _, subEvent, _, sourceGUID, _, _, _, destGUID, _, _, _, spellId = ...\n    local trinket = aura_env.currentTrinket\n    \n    if subEvent == \"SPELL_AURA_APPLIED\" and destGUID == WeakAuras.myGUID then\n        local buffIds = trinket.buffIds or (trinket.buffId and { trinket.buffId })\n        if buffIds then\n            for _, id in ipairs(buffIds) do\n                if spellId == id then\n                    aura_env.sendTrinketCD(trinket, spellId)\n                    \n                    if not trinket.excludeICD and trinket.ICD and trinket.ICD > 0 then\n                        return aura_env.startTrinketTimer(allstates, trinket.itemId, spellId, trinket.ICD)\n                    end\n                    if (not trinket.ICD or trinket.ICD == 0) and trinket.CD and trinket.CD > 0 then\n                        aura_env.scheduleTrinketCD(trinket.itemId, trinket.CD)\n                        return true\n                    end\n                    return\n                end\n            end\n        end\n    end\n    \n    if trinket.subEvent and subEvent ~= trinket.subEvent then\n        return\n    end\n    \n    if trinket.procId and spellId == trinket.procId then\n        if sourceGUID ~= WeakAuras.myGUID then\n            return\n        end\n        \n        aura_env.sendTrinketCD(trinket, spellId)\n        \n        if not trinket.excludeICD and trinket.ICD and trinket.ICD > 0 then\n            return aura_env.startTrinketTimer(allstates, trinket.itemId, spellId, trinket.ICD)\n        end\n        if (not trinket.ICD or trinket.ICD == 0) and trinket.CD and trinket.CD > 0 then\n            aura_env.scheduleTrinketCD(trinket.itemId, trinket.CD)\n            return true\n        end\n        return\n    end\nend",
["check"] = "event",
["unit"] = "player",
["names"] = {
},
["customVariables"] = "",
},
["untrigger"] = {
["custom"] = "function(event, unit)\n    local itemId = GetInventoryItemID(\"player\", aura_env.slot)\n    if itemId then\n        for _, trinketInfo in ipairs(aura_env.trinketBuffs) do\n            if trinketInfo.itemId == itemId then\n                if trinketInfo.stackId then\n                    local _, _, _, _, _, _, _, _, _, spellId = WA_GetUnitBuff(\"player\", trinketInfo.stackId)\n                    if spellId == trinketInfo.stackId then\n                        return false\n                    end\n                end\n            end\n        end\n    end\n    return true\nend",
},
},
