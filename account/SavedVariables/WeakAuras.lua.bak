["CT:[MH][Trash] Frost Breath (Frostwyrm)"] = {
["outline"] = "OUTLINE",
["wagoID"] = "2XzLgw2qF",
["authorOptions"] = {
},
["displayText"] = "",
["customText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
["do_glow"] = false,
["do_custom"] = false,
["sound"] = "Interface\\Addons\\FojjiCore\\sound\\fojjiSnap.ogg",
["do_sound"] = false,
},
["finish"] = {
["custom"] = "",
["do_sound"] = false,
["do_message"] = false,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
["do_custom"] = false,
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.key = \"TRASH_FROSTWYRM_BREATH\"\naura_env.spellID = 31688\n\nfunction aura_env.unitTargetScan(sourceGUID)\n    local unit = \"target\"\n    if UnitExists(unit) and UnitGUID(unit) == sourceGUID then\n        return unit\n    end\n    \n    unit = \"focus\"\n    if UnitExists(unit) and UnitGUID(unit) == sourceGUID then\n        return unit\n    end\n    \n    for i = 1,40 do\n        unit = \"nameplate\"..i\n        if UnitExists(unit) and UnitGUID(unit) == sourceGUID then\n            return unit\n        end\n    end\n    \n    for grpUnit in WA_IterateGroupMembers() do\n        unit = grpUnit..\"target\"\n        if UnitExists(unit) and UnitGUID(unit) == sourceGUID then\n            return unit\n        end\n    end\n    \n    return nil\nend",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["custom_type"] = "stateupdate",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(allstates,event,_,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId)\n    if subEvent ~= \"SPELL_CAST_START\" or spellId ~= aura_env.spellID then\n        return false\n    end\n    \n    C_Timer.After(0.05,function()\n            local unit = aura_env.unitTargetScan(sourceGUID)\n            if not unit then\n                return\n            end\n            \n            local target = unit..\"target\"\n            if not UnitExists(target) then\n                return\n            end\n            \n            WeakAuras.ScanEvents(\"WA_FROSTWYRM_BREATH_TARGET\",UnitGUID(target),UnitName(target))\n    end)\n    \n    WeakAuras.ScanEvents(\"WA_NUMEN_TIMER\",aura_env.key,0,1)\n    return false\nend",
