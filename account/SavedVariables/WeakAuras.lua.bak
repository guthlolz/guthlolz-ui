["customTriggerLogic"] = "function(t)\n    if(t[1]) then\n        aura_env.inCombat = true\n        WeakAuras.ScanEvents(\"COMBAT_STATUS\", true)\n        \n    elseif(t[2]) then\n        aura_env.inCombat = false\n        WeakAuras.ScanEvents(\"COMBAT_STATUS\", false)\n    end\n    return t[1] or t[2]\nend\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",
