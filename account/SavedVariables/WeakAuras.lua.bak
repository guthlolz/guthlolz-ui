["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(allstates, event, ...) \n    if event == \"OPTIONS\" then\n        for i = 1, 3 do\n            allstates[i] = {\n                show = true,\n                changed = true,\n                duration = 6,\n                expirationTime = GetTime() + 6,\n                autoHide = true,\n                progressType = \"timed\",\n                icon = i == 1 and 135274 or i == 2 and \n                ((aura_env.GetExpansion() > 6) and 1030900 or 132739) or 136031,\n                name = i == 1 and \"Some Epic Sword\" or i == 2 and \"Damaged Chest\" or \"Metal Hat\",\n                tert = i == 1 and \"|cFF00FFFFLeech|r\" or i == 2 and \"|cFF00FFFFAvoidance|r\" or \"|cFF00FFFFIndestructible|r\",        \n                sock = i == 1 and \"\" or i == 2 and \"|T458977:0|t|cFFFF00FFSocket|r\" or \"\",\n                ilvl = i == 1 and 400 or i == 2 and 425 or 315,\n                isGear = true,\n                stacks = i == 3 and 2 or 1,\n                prio = i == 1 and 4 or i == 3 and 3 or 2,\n                price = i * 12345,\n                rarity = i == 1 and 4 or i == 3 and 3 or 2,\n                source = 3,\n                pQuality = i == 1 and CreateAtlasMarkup('professions-icon-quality-tier5-inv', 32, 32),\n                isOptions = true\n            };\n            --print(i)            \n        end\n        --print(\"Money\")\n        --Money\n        allstates[4] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 5,\n            expirationTime = GetTime() + 6,\n            autoHide = true,\n            stacks = 1,\n            name = \"Money\",\n            icon = 133784,\n            price = 2000000,\n            rarity = 1,\n            prio = -1,\n            source = 1,\n            isOptions = true\n        };\n        --print(\"Currency\")\n        --Currency\n        allstates[5] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 5,\n            expirationTime = GetTime() + 6,\n            autoHide = true,\n            stacks = 40,\n            name = \"Timewarped Badge\",\n            append = \" |r|cffffffff(|r2000|cffffffff)|r\",\n            appendLen = 6,\n            icon = ((aura_env.GetExpansion() > 6) and 463446 or 134156),\n            price = 0,\n            rarity = 6,\n            prio = 9,\n            source = 2,\n            isOptions = true\n        };\n        --print(\"Currency2\")\n        allstates[6] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 5,\n            expirationTime = GetTime() + 6,\n            autoHide = true,\n            stacks = 500,\n            name = \"Honor\",\n            append = \" |r|cffffffff(|r|cffFF000015000 / 15000|r|cffffffff)|r\",\n            appendLen = 15,\n            icon = ((aura_env.GetExpansion() > 6) and 1455894 or 132486),\n            price = 0,\n            rarity = 6,\n            prio = 9,\n            source = 2,\n            isOptions = true\n        };\n        if aura_env.config.showRep then\n            allstates[7] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = 5,\n                expirationTime = GetTime() + 6,\n                autoHide = true,\n                stacks = 80,\n                name = \"Iskaara Tuskarr Rep\",\n                append = \" |r(80 / 3000)\",\n                appendLen = 12,\n                icon = ((aura_env.GetExpansion() > 3) and 236681 or 2056011),\n                price = 0,\n                rarity = 7,\n                prio = 10,\n                source = 5,\n                isOptions = true\n            };\n        end\n        if aura_env.GetExpansion() > 9 then\n            allstates[8] = {\n                show = true,\n                changed = true,\n                duration = 6,\n                expirationTime = GetTime() + 6,\n                autoHide = true,\n                progressType = \"timed\",\n                icon = 5525214,\n                name = (aura_env.config.invCount and aura_env.config.advCount) and \"Mycobloom \" or\n                aura_env.config.invCount and \"Mycobloom (22)\" or \"Mycobloom\",\n                append = (aura_env.config.invCount and aura_env.config.advCount) and \"(|r|cffd17c4b27|A:Professions-ChatIcon-Quality-Tier1:11:11::1|a |r|cffb0b0b022|A:Professions-ChatIcon-Quality-Tier2:11:15::1|a |r|cffffff0011|A:Professions-ChatIcon-Quality-Tier3:12:16::1|a|r)\" or nil,\n                appendLen = (aura_env.config.invCount and aura_env.config.advCount) and 14 or aura_env.config.invCount and 4 or nil,\n                stacks = 3,\n                prio = 1,\n                price = 500000,\n                rarity = 1,\n                source = 3,\n                pQuality = CreateAtlasMarkup('professions-icon-quality-tier2-inv', 32, 32),\n                isOptions = true\n            };\n        end\n        --print(\"end\");\n        return\n    end\n    local receiver;\n    if event == \"CHAT_MSG_LOOT\" and select(5, ...) ~= nil then\n        receiver = select(5, ...);\n        local lastChar, _ = string.find(receiver, \"-\");\n        if lastChar then\n            receiver = strsub(receiver,1,lastChar-1);\n        end\n    end\n    --print(receiver, UnitName(\"player\"));\n    if receiver == UnitName(\"player\") or event ~= \"CHAT_MSG_LOOT\" then\n        local i = 1\n        while allstates[i] do\n            if allstates[i].show then\n                i = i + 1\n            else\n                break\n            end\n        end\n        \n        local function GetDur(type)\n            local dur = aura_env.config.duration;\n            --print(dur[tostring(type)]);\n            return dur[tostring(type)] or 1;\n        end\n        \n        local function IsDup(link, source, byName)\n            local isDup, foundAt = false, nil;\n            if byName then\n                for j,k in pairs(allstates) do\n                    if aura_env.config.debug then \n                        print(\"Original:\",k.name,\n                        \"\\nNew:\",link); \n                    end\n                    if k.show and k.name == link and \n                    k.source ~= source and not foundAt then\n                        isDup = true;\n                    elseif k.show and k.name == link then\n                        isDup = false;\n                        foundAt = j;\n                    end\n                end\n            else\n                for j,k in pairs(allstates) do\n                    if aura_env.config.debug then \n                        print(\"Original:\",k.link:gsub(\"|\", \"||\"),\n                            \"\\nNew:\",link:gsub(\"|\", \"||\")); \n                    end\n                    if k.show and k.link == link and \n                    k.source ~= source and not foundAt then\n                        isDup = true;\n                    elseif k.show and k.link == link then\n                        isDup = false;\n                        foundAt = j;\n                    end\n                end\n            end\n            --print(\"First Element\");\n            return isDup, foundAt;\n        end\n        \n        local function FindMoney()\n            local i = 1;\n            while allstates[i] do\n                --if allstates[i].show then\n                if allstates[i].source == 1 then\n                    return i;\n                end\n                i = i + 1\n                --else\n                --return nil;\n                --end\n            end\n        end\n        \n        local function FindHonor()\n            local i = 1;\n            while allstates[i] do\n                --if allstates[i].show then\n                if allstates[i].source == 7 then\n                    return i;\n                end\n                i = i + 1\n                --else\n                --return nil;\n                --end\n            end\n        end\n        \n        local function IsGear(type)   \n            return type == \"Armor\" or type == \"Weapon\";\n        end\n        \n        local function IsBanned(index, type)\n            --print(\"IsBanned\",link);\n            return aura_env.IsBanned(index, type);\n        end\n        if event == \"WA_LOOT_UPDATE_TEXT\" then\n            return true;\n        end\n        \n        if event == \"PLAYER_MONEY\" then\n            if aura_env.config.debug then print(\"PLAYER_MONEY\", ...); end\n            if aura_env.trackMoney == nil then\n                aura_env.trackMoney = GetMoney()\n            end\n            local dMoney = GetMoney() - aura_env.trackMoney\n            local cur = FindMoney();\n            if cur then\n                dMoney = dMoney + (allstates[cur].price or 0);\n                i = cur;\n            end\n            if dMoney > 0 then\n                local itemIcon = 133788\n                if dMoney > 99 then\n                    if dMoney > 9999 then\n                        itemIcon = 133784\n                    else\n                        itemIcon = 133786\n                    end \n                end\n                if GetDur(\"gold\") <= 0 then return; end\n                allstates[i] = {\n                    show = true,\n                    changed = true,\n                    progressType = \"timed\",\n                    duration = GetDur(\"gold\"),\n                    expirationTime = GetTime() + GetDur(\"gold\"),\n                    autoHide = true,\n                    stacks = 1,\n                    name = \"Money\",\n                    icon = itemIcon,\n                    price = dMoney,\n                    rarity = 1,\n                    prio = -1,\n                    source = 1,\n                }\n            end\n            aura_env.trackMoney = GetMoney()\n        elseif event == \"QUEST_LOOT_RECEIVED\" then\n            if aura_env.config.debug then print(\"QUEST_LOOT_RECEIVED\", ...); end\n        elseif event == \"QUEST_CURRENCY_LOOT_RECEIVED\" then\n            if aura_env.config.debug then print(\"QUEST_CURRENCY_LOOT_RECEIVED\", ...); end\n        elseif event == \"CHAT_MSG_CURRENCY\" then\n            local str = select(1, ...)\n            if str then\n                --print(\"CURRENCY:\",str)\n                local itemLink, count = string.match(str, \"(|c.-|r) ?x?(%d*)\");\n                if count then\n                    local info =  C_CurrencyInfo.GetCurrencyInfoFromLink(itemLink);\n                    if not info then return; end\n                    local itemIcon = info.iconFileID;\n                    local text = info.name;\n                    local isDup, cur = IsDup(itemLink, 2);\n                    if isDup then return; end\n                    if cur then\n                        count = count + tonumber(allstates[cur].stacks);\n                        i = cur;\n                    end\n                    local append = nil;\n                    local appendLen = nil;\n                    if text and info.quantity then\n                        local max = info.maxQuantity;\n                        local count = info.quantity;\n                        local earned = info.totalEarned;\n                        \n                        appendLen = 2 + string.len(count) + \n                        ((max and max ~= 0) and 3 + string.len(max) or 0);\n                        \n                        if earned and info.useTotalEarnedForMaxQty then\n                            appendLen = appendLen + 1 + string.len(earned);\n                            append = \" |r|cffffffff|r\" .. count ..\n                            ((earned == max) and \"|cffFF0000\" or \"\") ..\n                            \" (\" .. earned .. ((max and max ~= 0) and \" / \" .. max or \"\") ..\n                            ((earned == max) and \"|r\" or \"\") ..\n                            \"|cffffffff)|r\";\n                        else\n                            append = \" |r|cffffffff(|r\" .. \n                            ((max and count == max) and \"|cffFF0000\" or \"\") ..\n                            count .. ((max and max ~= 0) and \" / \" .. max or \"\") ..\n                            ((max and count == max) and \"|r\" or \"\") ..\n                            \"|cffffffff)|r\";\n                        end\n                        \n                    end\n                    if aura_env.config.debug then print(\"CHAT_MSG_CURRENCY\", ...); end\n                    if IsBanned(aura_env.GetCurID(text), 2) then return; end\n                    if GetDur(6) <= 0 then return; end\n                    if itemIcon and tonumber(count) ~=0 then\n                        allstates[i] = {\n                            show = true,\n                            changed = true,\n                            progressType = \"timed\",\n                            duration = GetDur(6),\n                            expirationTime = GetTime() + GetDur(6),\n                            autoHide = true,\n                            stacks = tonumber(count),\n                            name = text,\n                            append = append,\n                            appendLen = appendLen,\n                            icon = itemIcon,\n                            price = 0,\n                            rarity = 6,\n                            link = itemLink,\n                            prio = 9,\n                            source = 2,\n                        }  \n                    end    \n                end  \n            end\n        elseif event == \"ENCOUNTER_LOOT_RECEIVED\" then\n            local _, itemID, text, itemStacks, playerName = ...;\n            if not text then return; end\n            --[[\n            print(...);\n            print(\"itemID\", itemID, \"text\", text, \"itemStacks\", itemStacks, \"playerName\", playerName);\n            print(GetUnitName(\"player\"), playerName);\n            --]]\n            local isDup, cur = IsDup(text, 3);\n            if isDup then return; end\n            if playerName ~= GetUnitName(\"player\") then return; end\n            local pQuality = string.match(text, \".*?|A:Professions%-ChatIcon%-Quality%-Tier(%d).?\");\n            local itemStacks = select(5, ...);\n            local isQuest = nil\n            if select(6, GetItemInfo(text)) == \"Quest\" then\n                isQuest = 7\n            end\n            if cur then\n                itemStacks = tonumber(itemStacks) + tonumber(allstates[cur].stacks);\n                i = cur;\n            end\n            \n            local realILvl = GetDetailedItemLevelInfo(text)    \n            local itemStats = aura_env.GetItemStats(text)\n            local _, _, _, _, _, itemType = C_Item.GetItemInfo(text);\n            local isGear = IsGear(itemType);\n            \n            local sockText = \" \";\n            \n            if itemStats then\n                local socket = false\n                \n                if itemStats[\"EMPTY_SOCKET_META\"] then \n                    for i = 1, itemStats[\"EMPTY_SOCKET_META\"] do\n                        sockText = sockText .. \"|T136257:0|t\";\n                    end\n                    socket = true;\n                end\n                \n                if itemStats[\"EMPTY_SOCKET_RED\"] then \n                    for i = 1, itemStats[\"EMPTY_SOCKET_RED\"] do\n                        sockText = sockText .. \"|T136258:0|t\";\n                    end\n                    socket = true;\n                end\n                \n                if itemStats[\"EMPTY_SOCKET_YELLOW\"] then \n                    for i = 1, itemStats[\"EMPTY_SOCKET_YELLOW\"] do\n                        sockText = sockText .. \"|T136259:0|t\";\n                    end\n                    socket = true;\n                end\n                \n                if itemStats[\"EMPTY_SOCKET_BLUE\"] then \n                    for i = 1, itemStats[\"EMPTY_SOCKET_BLUE\"] do\n                        sockText = sockText .. \"|T136256:0|t\";\n                    end\n                    socket = true;\n                end\n                \n                if itemStats[\"EMPTY_SOCKET_PRISMATIC\"] then \n                    for i = 1, itemStats[\"EMPTY_SOCKET_PRISMATIC\"] do\n                        sockText = sockText .. \"|T458977:0|t\";\n                    end\n                    socket = true;\n                end\n                \n                if socket then\n                    sockText = sockText .. \"|cFFFF00FFSocket|r\";\n                end\n            end\n            \n            local tertiary = \"\";\n            if itemStats[\"ITEM_MOD_CR_AVOIDANCE_SHORT\"] then tertiary = tertiary .. \" |cFF00FFFFAvoidance|r\" end\n            if itemStats[\"ITEM_MOD_CR_LIFESTEAL_SHORT\"] then tertiary = tertiary .. \" |cFF00FFFFLeech|r\" end\n            if itemStats[\"ITEM_MOD_CR_SPEED_SHORT\"] then tertiary = tertiary .. \" |cFF00FFFFSpeed|r\" end\n            if itemStats[\"ITEM_MOD_CR_STURDINESS_SHORT\"] then tertiary = tertiary .. \" |cFF00FFFFIndestructible|r\" end\n            \n            if aura_env.config.debug then print(\"ENCOUNTER_LOOT_RECEIVED\", ...); end\n            if IsBanned(text, 1) then return; end\n            if (isQuest and GetDur(7) or GetDur(select(3, GetItemInfo(text)))) <= 0 then return; end\n            allstates[i] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = (isQuest and GetDur(7) or GetDur(select(3, GetItemInfo(text)))),\n                expirationTime = GetTime() + (isQuest and GetDur(7) or GetDur(select(3, C_Item.GetItemInfo(text)))),\n                autoHide = true,\n                stacks = tonumber(itemStacks),\n                name = select(1, C_Item.GetItemInfo(text)),\n                icon = select(10, C_Item.GetItemInfo(text)),\n                price = select(11, C_Item.GetItemInfo(text)),\n                rarity = isQuest or select(3, C_Item.GetItemInfo(text)),\n                link = select(2, C_Item.GetItemInfo(text)),\n                tert = tertiary,\n                sock = (sockText ~= \" \") and sockText,\n                ilvl = realILvl,\n                isGear = isGear or false,\n                pQuality = (pQuality and CreateAtlasMarkup('professions-icon-quality-tier'..pQuality..'-inv', 32, 32)) or nil,\n                prio = isQuest or select(3, GetItemInfo(text)),\n                source = 3,\n            }\n        elseif event == \"CHAT_MSG_LOOT\" then     \n            local text = select(1, ...)\n            text = text:sub(text:find(':') + 2, text:len())\n            local stacks = string.match(text, \".*x(%d*)(%.?)$\");\n            local itemStacks = tonumber(stacks) or 1;\n            local link = select(2, C_Item.GetItemInfo(text));\n            if not link then return; end\n            --print(link, link:gsub(\"|\", \"||\"));\n            local isDup, cur = IsDup(link, 4);\n            if isDup then return; end\n            --print(\"isDup\",isDup, cur);\n            local pQuality = string.match(link, \".*:Professions%-ChatIcon%-Quality%-Tier(%d):?.*\");\n            local isQuest = nil\n            if select(6, C_Item.GetItemInfo(text)) == \"Quest\" then\n                isQuest = 7\n            end\n            if cur then\n                itemStacks = itemStacks + tonumber(allstates[cur].stacks);\n                i = cur;\n            end\n            local realILvl = C_Item.GetDetailedItemLevelInfo(link)    \n            local itemStats = aura_env.GetItemStats(link);\n            local _, _, _, _, _, itemType = C_Item.GetItemInfo(text);\n            local isGear = IsGear(itemType);        \n            \n            local sockText = \" \";\n            \n            if itemStats then\n                local socket = false\n                \n                if itemStats[\"EMPTY_SOCKET_META\"] then \n                    for i = 1, itemStats[\"EMPTY_SOCKET_META\"] do\n                        sockText = sockText .. \"|T136257:0|t\";\n                    end\n                    socket = true;\n                end\n                \n                if itemStats[\"EMPTY_SOCKET_RED\"] then \n                    for i = 1, itemStats[\"EMPTY_SOCKET_RED\"] do\n                        sockText = sockText .. \"|T136258:0|t\";\n                    end\n                    socket = true;\n                end\n                \n                if itemStats[\"EMPTY_SOCKET_YELLOW\"] then \n                    for i = 1, itemStats[\"EMPTY_SOCKET_YELLOW\"] do\n                        sockText = sockText .. \"|T136259:0|t\";\n                    end\n                    socket = true;\n                end\n                \n                if itemStats[\"EMPTY_SOCKET_BLUE\"] then \n                    for i = 1, itemStats[\"EMPTY_SOCKET_BLUE\"] do\n                        sockText = sockText .. \"|T136256:0|t\";\n                    end\n                    socket = true;\n                end\n                \n                if itemStats[\"EMPTY_SOCKET_PRISMATIC\"] then \n                    for i = 1, itemStats[\"EMPTY_SOCKET_PRISMATIC\"] do\n                        sockText = sockText .. \"|T458977:0|t\";\n                    end\n                    socket = true;\n                end\n                \n                if socket then\n                    sockText = sockText .. \"|cFFFF00FFSocket|r\";\n                end\n            end\n            \n            local tertiary = \"\";\n            if itemStats[\"ITEM_MOD_CR_AVOIDANCE_SHORT\"] then tertiary = tertiary .. \" |cFF00FFFFAvoidance|r\" end\n            if itemStats[\"ITEM_MOD_CR_LIFESTEAL_SHORT\"] then tertiary = tertiary .. \" |cFF00FFFFLeech|r\" end\n            if itemStats[\"ITEM_MOD_CR_SPEED_SHORT\"] then tertiary = tertiary .. \" |cFF00FFFFSpeed|r\" end\n            if itemStats[\"ITEM_MOD_CR_STURDINESS_SHORT\"] then tertiary = tertiary .. \" |cFF00FFFFIndestructible|r\" end\n            if aura_env.config.debug then print(\"CHAT_MSG_LOOT\", ...); end\n            --print(link)\n            if IsBanned(link, 1) then return; end\n            if (isQuest and GetDur(7) or GetDur(select(3, C_Item.GetItemInfo(text)))) <= 0 then return; end\n            allstates[i] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = (isQuest and GetDur(7) or GetDur(select(3, C_Item.GetItemInfo(text)))),\n                expirationTime = GetTime() + (isQuest and GetDur(7) or GetDur(select(3, C_Item.GetItemInfo(text)))),\n                autoHide = true,\n                stacks = itemStacks,\n                name = select(1, C_Item.GetItemInfo(text)),\n                icon = select(10, C_Item.GetItemInfo(text)),\n                price = select(11, C_Item.GetItemInfo(text)),\n                rarity = isQuest or select(3, C_Item.GetItemInfo(text)),\n                link = link,\n                tert = tertiary or nil,\n                sock = (sockText ~= \" \") and sockText or nil,\n                ilvl = realILvl or nil,\n                isGear = isGear or false,\n                append = append,\n                appendLen = appendLen,\n                pQuality = (pQuality and CreateAtlasMarkup('professions-icon-quality-tier'..pQuality..'-inv', 32, 32)) or nil,\n                prio = isQuest or select(3, C_Item.GetItemInfo(text)),\n                source = 4,\n            }\n        elseif event == \"CHAT_MSG_COMBAT_FACTION_CHANGE\" and aura_env.config.showRep then\n            local text = select(1, ...);\n            if not text then return; end\n            local suf = \" Rep\"; --\" Rep\" or \" Exp\"\n            \n            --[[\n             0 - Rep\n             1 - Exp (follower exp)\n            --]]\n            local rType = 0; \n            local faction = string.match(text, aura_env.GetRepString(\"incName\")) or string.match(text, aura_env.GetRepString(\"decName\")) or \"\";\n            \n            local stacks = tonumber(string.match(text, aura_env.GetRepString(\"incVal\"))) or (tonumber(string.match(text, aura_env.GetRepString(\"decVal\")) or 0) * -1) or 0;\n            \n            if faction == \"\" then \n                faction = string.match(text, aura_env.GetRepString(\"expName\")) or \"\";\n                if faction ~= \"\" then\n                    rType = 1;\n                    suf = \" Exp\";\n                    stacks = tonumber(string.match(text, aura_env.GetRepString(\"expVal\")));\n                end\n            end\n            local isDup, cur = IsDup(faction .. (rType == 0 and \" Rep\" or \" Exp\"), 5, true);\n            if isDup then return; end\n            if cur then\n                stacks = stacks + tonumber(allstates[cur].stacks);\n                i = cur;\n            end\n            local append, appendLen = aura_env.GetFactionStanding(faction);\n            if aura_env.config.debug then print(\"CHAT_MSG_COMBAT_FACTION_CHANGE\", ...); end\n            if IsBanned(faction, 3) then return; end\n            if aura_env.config.rep <= 0 then return; end\n            allstates[i] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = aura_env.config.rep,\n                expirationTime = GetTime() + aura_env.config.rep,\n                autoHide = true,\n                stacks = stacks,\n                name = faction .. suf,\n                append = append,\n                appendLen = appendLen,\n                icon = ((aura_env.GetExpansion() > 3) and 236681 or 2056011),\n                price = 0,\n                rarity = 7,\n                prio = 10,\n                source = 5,\n            };\n        elseif event == \"CHAT_MSG_COMBAT_HONOR_GAIN\" and aura_env.config.showHonor then\n            local str = select(1, ...)\n            if str then\n                --print(\"Honor:\",str)\n                local count = string.match(str, \"awarded (%d*) honor points\") or string.match(str, \"Estimated Honor Points: (%d*)\");\n                if count then\n                    local cur = FindHonor();\n                    if cur then\n                        count = count + tonumber(allstates[cur].stacks);\n                        i = cur;\n                    end\n                    local append = nil;\n                    local appendLen = nil;\n                    if text and info and info.quantity then\n                        local max = info.maxQuantity;\n                        local count = info.quantity;\n                        local earned = info.totalEarned;\n                        \n                        appendLen = 2 + string.len(count) + \n                        ((max and max ~= 0) and 3 + string.len(max) or 0);\n                        \n                        if earned and info.useTotalEarnedForMaxQty then\n                            appendLen = appendLen + 1 + string.len(earned);\n                            append = \" |r|cffffffff|r\" .. count ..\n                            ((earned == max) and \"|cffFF0000\" or \"\") ..\n                            \" (\" .. earned .. ((max and max ~= 0) and \" / \" .. max or \"\") ..\n                            ((earned == max) and \"|r\" or \"\") ..\n                            \"|cffffffff)|r\";\n                        else\n                            append = \" |r|cffffffff(|r\" .. \n                            ((max and count == max) and \"|cffFF0000\" or \"\") ..\n                            count .. ((max and max ~= 0) and \" / \" .. max or \"\") ..\n                            ((max and count == max) and \"|r\" or \"\") ..\n                            \"|cffffffff)|r\";\n                        end\n                        \n                    end\n                    if aura_env.config.debug then print(\"CHAT_MSG_COMBAT_HONOR_GAIN\", ...); end\n                    if aura_env.config.honor <= 0 then return; end\n                    if tonumber(count) ~=0 then\n                        allstates[i] = {\n                            show = true,\n                            changed = true,\n                            progressType = \"timed\",\n                            duration = aura_env.config.honor or 10,\n                            expirationTime = GetTime() + (aura_env.config.honor or 10), \n                            autoHide = true,\n                            stacks = tonumber(count),\n                            name = \"Honor\",\n                            icon = ((aura_env.GetExpansion() > 3) and 1455894 or 132486),\n                            price = 0,\n                            rarity = 6,\n                            prio = 9,\n                            source = 7,\n                        }  \n                    end    \n                end  \n            end\n        end\n    end\n    return true\nend",
