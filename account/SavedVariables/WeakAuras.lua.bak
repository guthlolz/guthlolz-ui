["icon"] = true,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        aura_env.updateState(allstates, 30317, \"Mace\", 133528, false)\n        return true\n    end\n    \n    if event == \"WA_KAELTHAS_P2_START\" then\n        aura_env.allow = true\n        return\n    end\n    \n    if event == \"WA_KAELTHAS_P3_START\" then\n        aura_env.allow = false\n        return\n    end\n    \n    if not aura_env.allow then\n        return false\n    end\n    \n    if event == \"BAG_UPDATE_DELAYED\" then\n        return aura_env.checkLooted(allstates)\n    end\n    \n    if event == \"PLAYER_EQUIPMENT_CHANGED\" then\n        return aura_env.checkEquipped(allstates)\n    end\n    \n    local mob = aura_env.deathEvents[event]\n    if mob then\n        if aura_env.shouldShowForPlayer(mob.id) then\n            aura_env.updateState(allstates, mob.id, mob.name, mob.icon, false)\n            return true\n        end\n    end\nend",
["spellIds"] = {
},
["events"] = "PLAYER_EQUIPMENT_CHANGED, BAG_UPDATE_DELAYED, WA_KAELTHAS_P2_START, UNIT_INVENTORY_UPDATE:player, WA_KAELTHAS_STAFF_DIED, WA_KAELTHAS_DAGGER_DIED, WA_KAELTHAS_SHIELD_DIED, WA_KAELTHAS_BOW_DIED, WA_KAELTHAS_MACE_DIED, WA_KAELTHAS_SWORD_DIED, WA_KAELTHAS_AXE_DIED, WA_KAELTHAS_P2_START, WA_KAELTHAS_P3_START",
