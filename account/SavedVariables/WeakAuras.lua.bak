["actions"] = {
["start"] = {
["custom"] = "",
["do_custom"] = false,
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.saved = aura_env.saved or {}\naura_env.saved.trinketTimers = aura_env.saved.trinketTimers or {}\n\nfunction aura_env.isEquipped(itemId)\n    if not itemId then return false end\n    \n    local trinket1 = GetInventoryItemID(\"player\", INVSLOT_TRINKET1)\n    local trinket2 = GetInventoryItemID(\"player\", INVSLOT_TRINKET2)\n    \n    return trinket1 == itemId or trinket2 == itemId\nend\n\nfunction aura_env.hideState(allstates, itemId)\n    local state = allstates[itemId]\n    if state then\n        state.show = false\n        state.changed = true\n        state.duration = 0\n        state.expirationTime = 0\n    end\nend\n\nfunction aura_env.showState(allstates, itemId, data)\n    if not data or not data.endTime then\n        aura_env.saved.trinketTimers[itemId] = nil\n        aura_env.hideState(allstates, itemId)\n        return true\n    end\n    \n    local now = GetTime()\n    local remaining = data.endTime - now\n    \n    if remaining <= 0 or remaining > 3600 then\n        aura_env.saved.trinketTimers[itemId] = nil\n        aura_env.hideState(allstates, itemId)\n        return true\n    end\n    \n    local icon = select(10, GetItemInfo(itemId))\n    \n    allstates[itemId] = {\n        show = true,\n        changed = true,\n        progressType = \"timed\",\n        duration = remaining,\n        expirationTime = data.endTime,\n        autoHide = true,\n        icon = icon,\n        itemId = itemId,\n        procId = data.procId,\n    }\n    return true\nend",
["do_custom"] = true,
},
