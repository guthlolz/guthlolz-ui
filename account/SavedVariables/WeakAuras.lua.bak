["CT:[BT][Akama] Adds East"] = {
["outline"] = "OUTLINE",
["wagoID"] = "pbbuhQ899",
["parent"] = "[BT][Akama]",
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiBT-P1/12",
["actions"] = {
["start"] = {
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.key = \"AKAMA_ADDS_EAST\"\naura_env.count = 1\naura_env.cdStart = 13\naura_env.cdWindow = 45\naura_env.preWarnTime = 3\n\nfunction aura_env.nuTimer(countdown,count)\n    WeakAuras.ScanEvents(\"WA_NUMEN_TIMER\",aura_env.key,countdown,count)\nend\n\nfunction aura_env.updateState(allstates)\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n    }\nend\n\nfunction aura_env.hideState(allstates)\n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\n    return false\nend\n\nfunction aura_env.preWarn(duration,preWarnTime,count)\n    preWarnTime = preWarnTime or 3\n    \n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\n    \n    aura_env.preWarnTimer = C_Timer.NewTimer(duration-preWarnTime,function()\n            WeakAuras.ScanEvents(\"WA_\"..aura_env.key..\"_PREWARN\",preWarnTime,count)\n            aura_env.preWarnTimer = nil\n    end)\nend\n\nfunction aura_env.cancelTimers()\n    if aura_env.timer then\n        aura_env.timer:Cancel()\n        aura_env.timer = nil\n    end\n    \n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\n    \n    WeakAuras.ScanEvents(\"WA_\"..aura_env.key..\"_PREWARN_CANCEL\")\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "aura_env.count = 1\naura_env.nuTimer(nil)\naura_env.cancelTimers()",
["do_sound"] = false,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
["do_message"] = false,
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "WA_AKAMA_ACTIVATED, ENCOUNTER_END, WA_FJI_AKAMA_KILLED, WA_AKAMA_ADDS_EAST_SPAWN, WA_AKAMA_P2_START",
["spellIds"] = {
},
["custom"] = "function(allstates,event)\n    if event == \"WA_AKAMA_ACTIVATED\" then\n        aura_env.cancelTimers()\n        aura_env.count = 1\n        \n        aura_env.updateState(allstates)\n        aura_env.preWarn(aura_env.cdStart,aura_env.preWarnTime,aura_env.count)\n        aura_env.nuTimer(aura_env.cdStart,aura_env.count)\n        \n        aura_env.timer = C_Timer.NewTimer(aura_env.cdStart,function()\n                WeakAuras.ScanEvents(\"WA_AKAMA_ADDS_EAST_SPAWN\")\n        end)\n        return true\n    elseif event == \"WA_AKAMA_ADDS_EAST_SPAWN\" then\n        aura_env.timer = nil\n        \n        aura_env.nuTimer(0,aura_env.count)\n        aura_env.count = aura_env.count+1\n        aura_env.preWarn(aura_env.cdWindow,aura_env.preWarnTime,aura_env.count)\n        aura_env.nuTimer(aura_env.cdWindow,aura_env.count)\n        \n        aura_env.timer = C_Timer.NewTimer(aura_env.cdWindow,function()\n                WeakAuras.ScanEvents(\"WA_AKAMA_ADDS_EAST_SPAWN\")\n        end)\n        return false\n    elseif event == \"WA_AKAMA_P2_START\" or event == \"WA_FJI_AKAMA_KILLED\" or event == \"ENCOUNTER_END\" then\n        aura_env.count = 1\n        aura_env.nuTimer(nil)\n        aura_env.cancelTimers()\n        return false\n    end\n    \n    return false\nend",
["check"] = "event",
["subeventPrefix"] = "SPELL",
["custom_hide"] = "timed",
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
},
},
["disjunctive"] = "any",
["customTriggerLogic"] = "",
["activeTriggerMode"] = -10,
},
