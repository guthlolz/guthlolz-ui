["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "{\n    count = \"number\",\n}",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "CLEU:SPELL_DAMAGE, WA_NAJENTUS_NEEDLE_RESULT",
["spellIds"] = {
},
["custom"] = "function(allstates,event,...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 1.5,\n            expirationTime = GetTime() + 1.5,\n            autoHide = true,\n            icon = 135857,\n            count = math.random(1,5),\n        }\n        return true\n    end\n    \n    if event == \"WA_NAJENTUS_NEEDLE_RESULT\" then\n        local count = ...\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 1.5,\n            expirationTime = GetTime() + 1.5,\n            autoHide = true,\n            icon = 135857,\n            count = count,\n        }\n        return true\n    end\n    \n    local timestamp,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId = ...\n    \n    if subEvent ~= \"SPELL_DAMAGE\" or not destGUID then\n        return false\n    end\n    \n    if spellId == 39835 then\n        if destGUID ~= WeakAuras.myGUID then\n            return false\n        end\n        \n        aura_env.needleBatch = {\n            hits = {},\n        }\n        \n        C_Timer.After(0.05, function()\n                local batch = aura_env.needleBatch\n                if not batch then\n                    return\n                end\n                \n                local count = 0\n                \n                for _ in pairs(batch.hits) do\n                    count = count + 1\n                end\n                \n                aura_env.needleBatch = nil\n                WeakAuras.ScanEvents(\"WA_NAJENTUS_NEEDLE_RESULT\", count)\n        end)\n        \n        return false\n    end\n    \n    if spellId == 39968 and aura_env.needleBatch then\n        aura_env.needleBatch.hits[destGUID] = true\n    end\n    \n    return false\nend",
