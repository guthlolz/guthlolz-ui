["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["custom_hide"] = "timed",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["unit"] = "player",
["custom"] = "function(allstates, event, unit)\n    if event == \"OPTIONS\" then\n        if aura_env.ticker then\n            aura_env.ticker:Cancel()\n            aura_env.ticker = nil\n        end\n    end\n    \n    if event == \"NAME_PLATE_UNIT_ADDED\" then\n        local guid = UnitGUID(unit)\n        local npcID = select(6, strsplit(\"-\", guid or \"\"))\n        \n        if npcID == \"18835\" then\n            if not aura_env.ticker then\n                aura_env.ticker = C_Timer.NewTicker(0.2, function()\n                        WeakAuras.ScanEvents(\"WA_KIGGLER_RANGE_CHECK\")\n                end)\n            end\n            \n            local range = WeakAuras.GetRange(unit)\n            \n            allstates[unit] = {\n                show = true,\n                changed = true,\n                unit = unit,\n                range = range,\n                isSafe = range and range > 30 or false,\n            }\n            return true\n        end\n    end\n    \n    if event == \"NAME_PLATE_UNIT_REMOVED\" then\n        if allstates[unit] then\n            allstates[unit].show = false\n            allstates[unit].changed = true\n        end\n        aura_env.checkTicker(allstates)\n        return true\n    end\n    \n    if event == \"WA_KIGGLER_RANGE_CHECK\" then\n        for unit, state in pairs(allstates) do\n            if state.show and UnitExists(unit) then\n                local range = WeakAuras.GetRange(unit)\n                state.range = range\n                state.isSafe = range and range > 30 or false\n                state.changed = true\n            end\n        end\n        return true\n    end\nend",
["events"] = "NAME_PLATE_UNIT_ADDED NAME_PLATE_UNIT_REMOVED WA_KIGGLER_RANGE_CHECK",
["customVariables"] = "{\n    isSafe = \"bool\", \n    range = \"number\",\n}",
