["width"] = 0.6,
},
{
["type"] = "space",
["variableWidth"] = false,
["height"] = 1,
["width"] = 1,
["useHeight"] = false,
},
},
["hideReorder"] = true,
["useDesc"] = false,
["nameSource"] = 0,
["key"] = "option",
["width"] = 1,
["useCollapse"] = true,
["noMerge"] = false,
["collapse"] = true,
["name"] = "|TInterface/Icons/spell_shadow_bloodboil:14:14|t Bloodboil Personal Soak",
["limitType"] = "none",
["groupType"] = "simple",
["type"] = "group",
["size"] = 10,
},
},
["displayText_format_unitName_pad_mode"] = "left",
["yOffset"] = 2,
["anchorPoint"] = "TOP",
["displayText_format_c_abbreviate_max"] = 8,
["displayText_format_p_time_format"] = 0,
["displayText_format_count_format"] = "none",
["actions"] = {
["start"] = {
["message_custom"] = "",
["message_type"] = "TTS",
["do_message"] = false,
["message"] = "",
["message_tts_voice"] = 1,
["custom"] = "",
["do_sound"] = false,
["message_format_c_format"] = "none",
["message_format_C_format"] = "none",
["do_custom"] = false,
["sound"] = "Interface\\Addons\\FojjiCore\\sound\\fojjiPop1.ogg",
},
["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.encounterActive = false\naura_env.assignmentReceived = false\naura_env.timer = nil\naura_env.currentCount = nil\naura_env.expirationTime = nil\naura_env.soaking = false\n\nlocal PRE_SOAK_TIME = 5\nlocal TIMER_KEY = \"GURTOGG_BLOODBOIL\"\nlocal ENCOUNTER_ID = 605\n\nlocal function CancelTimer()\n    if aura_env.timer then\n        aura_env.timer:Cancel()\n        aura_env.timer = nil\n    end\nend\n\nlocal function IsEnabled()\n    return aura_env.config.option.enable == true\nend\n\nlocal function GetConfig()\n    if not IsEnabled() then\n        return nil\n    end\n    \n    local team = tonumber(aura_env.config.option.team)\n    local soakAmount = tonumber(aura_env.config.option.soakAmount)\n    \n    if not team or team < 1 or team > 3 then\n        return nil\n    end\n    \n    if not soakAmount or soakAmount < 1 then\n        return nil\n    end\n    \n    return team,soakAmount\nend\n\nlocal function GetTeamCounts(count)\n    local team,soakAmount = GetConfig()\n    \n    if not team then\n        return nil\n    end\n    \n    local cycleLength = soakAmount * 3\n    local firstCount = ((team - 1) * soakAmount) + 1\n    local lastCount = firstCount + soakAmount - 1\n    \n    if not count then\n        return firstCount,lastCount\n    end\n    \n    local cycle = math.floor((count - 1) / cycleLength)\n    local offset = cycle * cycleLength\n    \n    return firstCount + offset,lastCount + offset\nend\n\nlocal function SendStop(count)\n    if not aura_env.soaking then\n        return\n    end\n    \n    local team = tonumber(aura_env.config.option.team)\n    \n    aura_env.soaking = false\n    WeakAuras.ScanEvents(\"WA_GURTOGG_BLOODBOIL_STOP\",count,team,nil)\nend\n\nlocal function DisableFallback()\n    CancelTimer()\n    aura_env.assignmentReceived = true\n    \n    if aura_env.soaking then\n        SendStop(aura_env.currentCount)\n    end\nend\n\nlocal function ScheduleSoak()\n    CancelTimer()\n    \n    if not IsEnabled() or aura_env.assignmentReceived or not aura_env.encounterActive then\n        return\n    end\n    \n    local team = GetConfig()\n    \n    if not team then\n        return\n    end\n    \n    local count = aura_env.currentCount\n    local expirationTime = aura_env.expirationTime\n    \n    if not count or not expirationTime then\n        return\n    end\n    \n    local firstCount = GetTeamCounts(count)\n    \n    if not firstCount or count ~= firstCount then\n        return\n    end\n    \n    local remaining = expirationTime - GetTime()\n    \n    if remaining <= 0 then\n        return\n    end\n    \n    local delay = remaining - PRE_SOAK_TIME\n    \n    if delay > 0 then\n        aura_env.timer = C_Timer.NewTimer(delay,function()\n                aura_env.timer = nil\n                \n                if not IsEnabled() or aura_env.assignmentReceived or not aura_env.encounterActive then\n                    return\n                end\n                \n                local currentTeam = GetConfig()\n                \n                if not currentTeam then\n                    return\n                end\n                \n                local first = GetTeamCounts(count)\n                \n                if not first or count ~= first then\n                    return\n                end\n                \n                local time = math.max(0,expirationTime - GetTime())\n                \n                aura_env.soaking = true\n                WeakAuras.ScanEvents(\"WA_GURTOGG_BLOODBOIL_SOAK\",time,currentTeam,nil)\n        end)\n    else\n        aura_env.soaking = true\n        WeakAuras.ScanEvents(\"WA_GURTOGG_BLOODBOIL_SOAK\",remaining,team,nil)\n    end\nend\n\nfunction aura_env.CHAT_MSG_RAID_LEADER(allStates,msg)\n    if not IsEnabled() then\n        return false\n    end\n    \n    if msg == \"Bloodboil Soak Teams\" then\n        DisableFallback()\n        return false\n    end\n    \n    if msg:match(\"^({rt[1-8]})TEAM[1-3]%-Soak %d+%-.+$\") or msg:match(\"^TEAM[1-3]%-Soak %d+%-.+$\") then\n        DisableFallback()\n    end\n    \n    return false\nend\n\nfunction aura_env.WA_NUMEN_TIMER(allStates,key,countdown,count)\n    if key ~= TIMER_KEY then\n        return false\n    end\n    \n    if not IsEnabled() or aura_env.assignmentReceived then\n        return false\n    end\n    \n    if countdown == nil then\n        CancelTimer()\n        aura_env.currentCount = nil\n        aura_env.expirationTime = nil\n        return false\n    end\n    \n    if not count then\n        return false\n    end\n    \n    if countdown > 0 then\n        aura_env.currentCount = count\n        aura_env.expirationTime = GetTime() + countdown\n        ScheduleSoak()\n        return false\n    end\n    \n    if countdown == 0 then\n        aura_env.currentCount = nil\n        aura_env.expirationTime = nil\n        CancelTimer()\n        \n        local team = GetConfig()\n        \n        if not team then\n            return false\n        end\n        \n        local _,lastCount = GetTeamCounts(count)\n        \n        if lastCount and count == lastCount then\n            aura_env.soaking = false\n            WeakAuras.ScanEvents(\"WA_GURTOGG_BLOODBOIL_STOP\",count,team,nil)\n        end\n    end\n    \n    return false\nend\n\nfunction aura_env.WA_GURTOGG_RAGE_PHASE()\n    CancelTimer()\n    \n    if aura_env.soaking then\n        SendStop(aura_env.currentCount)\n    end\n    \n    return false\nend\n\nlocal function EncounterStart(eID)\n    if eID ~= ENCOUNTER_ID or aura_env.encounterActive then\n        return false\n    end\n    \n    aura_env.encounterActive = true\n    \n    if not IsEnabled() or aura_env.assignmentReceived then\n        return false\n    end\n    \n    if aura_env.currentCount and aura_env.expirationTime then\n        ScheduleSoak()\n    end\n    \n    return false\nend\n\nfunction aura_env.ENCOUNTER_START(allStates,eID)\n    return EncounterStart(eID)\nend\n\nlocal function EncounterEnd()\n    CancelTimer()\n    \n    aura_env.encounterActive = false\n    aura_env.assignmentReceived = false\n    aura_env.currentCount = nil\n    aura_env.expirationTime = nil\n    aura_env.soaking = false\n    \n    return false\nend\n\nfunction aura_env.ENCOUNTER_END()\n    return EncounterEnd()\nend\n\nfunction aura_env.STATUS()\n    CancelTimer()\n    return false\nend\n\nfunction aura_env.OPTIONS()\n    return false\nend",
},
["finish"] = {
["do_custom"] = false,
["custom"] = "",
},
},
["displayText_format_p_time_mod_rate"] = true,
["displayText_format_c1_format"] = "none",
["displayText_format_c2_abbreviate_max"] = 8,
["displayText_format_name_format"] = "guid",
["displayText_format_guid_pad"] = false,
["font"] = "Numen",
