["CT:[BT][Reliquary] Phase Controller"] = {
["outline"] = "OUTLINE",
["wagoID"] = "pbbuhQ899",
["parent"] = "[BT][Reliquary]",
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiBT-P1/12",
["actions"] = {
["start"] = {
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.phaseEndCount = 0\naura_env.submerge = 28819\naura_env.auraDesire = 41350\naura_env.auraAnger = 41337\n\nlocal locale = GetLocale()\n\naura_env.locales = {\n    [\"enUS\"] = {\n        p1End = \"I don't want to go back!\",\n        p2End = \"I won't be far!\",\n    },\n    [\"frFR\"] = { -- no translation available\n        p1End = \"I don't want to go back!\",\n        p2End = \"I won't be far!\",\n    },\n    [\"deDE\"] = {\n        p1End = \"Ich will nicht zurück!\",\n        p2End = \"Ich bin immer in Eurer Nähe!\",\n    },\n    [\"esES\"] = { -- no translation available\n        p1End = \"I don't want to go back!\",\n        p2End = \"I won't be far!\",\n    },\n    [\"koKR\"] = {\n        p1End = \"나 안 돌아갈래!\",\n        p2End = \"멀리 가진 않겠다...\",\n    },\n    [\"ruRU\"] = {\n        p1End = \"Я не хочу обратно!\",\n        p2End = \"Я буду неподалеку!\",\n    },\n    [\"zhCN\"] = { -- no translation available\n        p1End = \"I don't want to go back!\",\n        p2End = \"I won't be far!\",\n    },\n    [\"zhTW\"] = { -- no translation available\n        p1End = \"I don't want to go back!\",\n        p2End = \"I won't be far!\",\n    }\n}\n\naura_env.currentLocale = aura_env.locales[locale] or aura_env.locales[\"enUS\"]",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "aura_env.preWarnTimer = {}\naura_env.p1Count = 1\naura_env.p2Count = 2\naura_env.nuTimer(aura_env.key, nil)\naura_env.preWarnCancel(aura_env.key)",
["do_sound"] = false,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
["do_message"] = false,
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "WA_FJI_ENCOUNTER_START, ENCOUNTER_START, CLEU:SPELL_CAST_SUCCESS, UNIT_SPELLCAST_SUCCEEDED, CHAT_MSG_MONSTER_YELL",
["spellIds"] = {
},
["custom"] = "function(allstates,event,...)\n    if event == \"WA_FJI_ENCOUNTER_START\" or event == \"ENCOUNTER_START\" then\n        local eID = ...\n        if eID ~= 606 then\n            return false\n        end\n        \n        aura_env.phaseEnd = false\n        aura_env.phaseEndCount = 0\n        return false\n    end\n    \n    if event == \"UNIT_SPELLCAST_SUCCEEDED\" then\n        local unit,_,spellId = ...\n        \n        if spellId ~= aura_env.submerge then\n            return false\n        end\n        \n        if aura_env.phaseEnd then\n            return false\n        end\n        \n        aura_env.phaseEndCount = aura_env.phaseEndCount + 1\n        \n        WeakAuras.ScanEvents(\"WA_RELIQUARY_PHASE_END\")\n        \n        if aura_env.phaseEndCount == 1 then\n            WeakAuras.ScanEvents(\"WA_RELIQUARY_P1_END\")\n        elseif aura_env.phaseEndCount == 2 then\n            WeakAuras.ScanEvents(\"WA_RELIQUARY_P2_END\")\n        end\n        \n        aura_env.phaseEnd = true\n        return false\n    end\n    \n    if event == \"CHAT_MSG_MONSTER_YELL\" then\n        local msg = ...\n        \n        if msg:find(aura_env.currentLocale.p1End) or msg == aura_env.currentLocale.p1End then\n            if not aura_env.phaseEnd then\n                aura_env.phaseEndCount = aura_env.phaseEndCount + 1\n                \n                WeakAuras.ScanEvents(\"WA_RELIQUARY_PHASE_END\")\n                \n                if aura_env.phaseEndCount == 1 then\n                    WeakAuras.ScanEvents(\"WA_RELIQUARY_P1_END\")\n                elseif aura_env.phaseEndCount == 2 then\n                    WeakAuras.ScanEvents(\"WA_RELIQUARY_P2_END\")\n                end\n                \n                aura_env.phaseEnd = true\n                return false\n            end\n        elseif msg:find(aura_env.currentLocale.p2End) or msg == aura_env.currentLocale.p2End then\n            if not aura_env.phaseEnd then\n                aura_env.phaseEndCount = aura_env.phaseEndCount + 1\n                \n                WeakAuras.ScanEvents(\"WA_RELIQUARY_PHASE_END\")\n                \n                if aura_env.phaseEndCount == 1 then\n                    WeakAuras.ScanEvents(\"WA_RELIQUARY_P1_END\")\n                elseif aura_env.phaseEndCount == 2 then\n                    WeakAuras.ScanEvents(\"WA_RELIQUARY_P2_END\")\n                end\n                \n                aura_env.phaseEnd = true\n                return false\n            end\n        end\n    end\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local _,subEvent,_,sourceGUID,_,_,_,destGUID,destName,_,_,spellId = ...\n        \n        if spellId ~= aura_env.auraDesire and spellId ~= aura_env.auraAnger then\n            return false\n        end\n        \n        if subEvent == \"SPELL_CAST_SUCCESS\" then\n            if spellId == aura_env.auraDesire then\n                WeakAuras.ScanEvents(\"WA_RELIQUARY_P2_START\")\n                aura_env.phaseEnd = false\n                return false\n            elseif spellId == aura_env.auraAnger then\n                WeakAuras.ScanEvents(\"WA_RELIQUARY_P3_START\")\n                aura_env.phaseEnd = false\n                return false\n            end\n        end\n    end\nend",
["check"] = "event",
["subeventPrefix"] = "SPELL",
["custom_hide"] = "timed",
["debuffType"] = "HELPFUL",
},
