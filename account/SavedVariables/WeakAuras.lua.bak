["custom"] = "function(allstates, event, key, time, count)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 10,\n            expirationTime = GetTime() + 10,\n            progressType = \"timed\",\n            icon = 136186,\n            autoHide = true,\n        }\n        return true\n    end\n    if event == \"WA_NUMEN_TIMER\" and key == \"AZGALOR_RAIN\" then\n        if time == 0 then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = 10,\n                expirationTime = GetTime() + 10,\n                progressType = \"timed\",\n                icon = 136186,\n                autoHide = true,\n            }\n        elseif time == nil then\n            if allstates[\"\"] then\n                allstates[\"\"].show = false\n                allstates[\"\"].changed = true\n            end\n        end\n        return true\n    end\nend",
