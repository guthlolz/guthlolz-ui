["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 8.5,\n            expirationTime = GetTime() + 8.5,\n            autoHide = true,\n        }\n        return true\n    end\n    \n    if event == \"WA_THALADRED_GAZE_TARGET\" then\n        aura_env.expirationTime = GetTime() + 8.5\n        \n        for unit, state in pairs(allstates) do\n            if state.show and UnitExists(unit) then\n                local guid = UnitGUID(unit)\n                local npcID = select(6, strsplit(\"-\", guid or \"\"))\n                \n                if npcID == \"20064\" then\n                    state.progressType = \"timed\"\n                    state.duration = 8.5\n                    state.expirationTime = aura_env.expirationTime\n                    state.changed = true\n                    return true\n                end\n            end\n        end\n    end\n    \n    if event == \"NAME_PLATE_UNIT_ADDED\" then\n        local unit = ...\n        local guid = UnitGUID(unit)\n        local npcID = select(6, strsplit(\"-\", guid or \"\"))\n        \n        if npcID == \"20064\" then\n            local expirationTime = aura_env.expirationTime or 0\n            local remaining = expirationTime - GetTime()\n            \n            allstates[unit] = {\n                show = true,\n                changed = true,\n                unit = unit,\n                progressType = \"timed\",\n                duration = remaining,\n                expirationTime = GetTime() + remaining,\n            }\n            return true\n        end\n    end\n    \n    if event == \"NAME_PLATE_UNIT_REMOVED\" then\n        local unit = ...\n        \n        if allstates[unit] then\n            allstates[unit].show = false\n            allstates[unit].changed = true\n        end\n        return true\n    end\nend",
