["events"] = "CLEU:DAMAGE_SHIELD:UNIT_DIED",
["check"] = "event",
["custom"] = "function(allstates,event,...)\n    if event == \"OPTIONS\" then\n        for i = 1,2 do\n            allstates[i] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = 3,\n                expirationTime = GetTime()+3,\n                autoHide = true,\n                guid = WeakAuras.myGUID,\n            }\n        end\n        return true\n    end\n    \n    if event ~= \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        return false\n    end\n    \n    local _,subEvent,_,sourceGUID,_,_,_,destGUID,destName,_,_,spellId = ...\n    \n    if subEvent == \"DAMAGE_SHIELD\" and spellId == aura_env.spellID then\n        aura_env.shellHits[destGUID] = GetTime()\n        return false\n    end\n    \n    if subEvent == \"UNIT_DIED\" then\n        local hitTime = aura_env.shellHits[destGUID]\n        \n        if not hitTime or GetTime() - hitTime > 1 then\n            return false\n        end\n        \n        aura_env.shellHits[destGUID] = nil\n        \n        allstates[destGUID] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 2.5,\n            expirationTime = GetTime()+2.5,\n            autoHide = true,\n            guid = destGUID,\n            name = destName,\n        }\n        \n        if GetTime() - aura_env.throttle >= 4 then\n            aura_env.throttle = GetTime()\n            \n            local soundFile = aura_env.getRandomSound()\n            if soundFile then\n                local willPlay,handle = PlaySoundFile(soundFile,\"Master\")\n                aura_env.lastSoundFile = soundFile\n                aura_env.soundHandle = handle\n            end\n        end\n        return true\n    end\n    \n    return false\nend",
["unit"] = "player",
["debuffType"] = "HELPFUL",
},
