["customText"] = "function()\n    if WeakAuras.IsOptionsOpen() then\n        local value1 = aura_env.tarPhase\n        local value2 = string.format(\"|cFFffef7d%.2f%%|r\", math.random() * 5)\n        local value3 = string.format(\"|cFFfff00080%%|r\", math.random() * 5)\n        return value1, value2, value3\n    end\n    \n    local phase\n    local perHP\n    local tarHP\n    \n    if aura_env.states then\n        if aura_env.states[1] and aura_env.states[1].percenthealth ~= nil then\n            perHP = aura_env.states[1].percenthealth - aura_env.tarHP\n            phase = aura_env.tarPhase\n            tarHP = aura_env.tarHP\n        end\n    end\n    \n    local value1 = phase\n    local value2 = string.format(\"|cFFffef7d%.2f%%|r\", perHP or 0)\n    local value3 = string.format(\"|cFFfff000%.2f%%|r\", tarHP or 0)\n    return value1, value2, value3\nend",
