["triggers"] = {
{
["trigger"] = {
["customVariables"] = "{\n  value = true,\n  total = true,\n}",
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_type"] = "stateupdate",
["subeventPrefix"] = "SPELL",
["customStacks"] = "",
["event"] = "Health",
["unit"] = "player",
["customDuration"] = "",
["events"] = "CLEU:SPELL_AURA_APPLIED:SPELL_AURA_REFRESH:SPELL_ABSORBED:SPELL_AURA_REMOVED NAME_PLATE_UNIT_ADDED NAME_PLATE_UNIT_REMOVED",
["custom"] = "function(allStates,event,...)\n    if event == \"OPTIONS\" then\n        allStates[\"\"] = {\n            changed = true,\n            show = true,\n            progressType = \"static\",\n            value = math.random(1,25000),\n            total = 25000,\n            unit = \"nameplate1\",\n        }\n        return true\n    end\n    \n    if event == \"NAME_PLATE_UNIT_ADDED\" then\n        local unit = ...\n        local guid = UnitGUID(unit)\n        local data = guid and aura_env.activeShields[guid]\n        if not data then\n            return false\n        end\n        \n        allStates[guid] = {\n            changed = true,\n            show = true,\n            progressType = \"static\",\n            value = data.value,\n            total = data.total,\n            unit = unit,\n        }\n        return true\n    elseif event == \"NAME_PLATE_UNIT_REMOVED\" then\n        local unit = ...\n        \n        for _,state in pairs(allStates) do\n            if state.unit == unit then\n                state.show = false\n                state.changed = true\n                return true\n            end\n        end\n        return false\n    end\n    \n    local _,subEvent,_,_,_,_,_,destGUID,_,_,_,spellId = ...\n    \n    if subEvent == \"SPELL_AURA_REMOVED\" then\n        if spellId ~= 41475 then\n            return false\n        end\n        \n        aura_env.activeShields[destGUID] = nil\n        return aura_env.HideState(allStates,destGUID)\n    end\n    \n    if subEvent == \"SPELL_AURA_APPLIED\" or subEvent == \"SPELL_AURA_REFRESH\" then\n        if spellId ~= 41475 then\n            return false\n        end\n        \n        aura_env.activeShields[destGUID] = {\n            value = 25000,\n            total = 25000,\n        }\n        \n        return aura_env.ShowState(allStates,destGUID)\n    end\n    \n    if subEvent ~= \"SPELL_ABSORBED\" then\n        return false\n    end\n    \n    local params = {...}\n    local numParams = #params\n    local absorbSpellId = params[numParams - 3]\n    if absorbSpellId ~= 41475 then\n        return false\n    end\n    \n    local data = aura_env.activeShields[destGUID]\n    if not data then\n        return false\n    end\n    \n    local absorbAmount = params[numParams]\n    data.value = math.max(0,data.value - absorbAmount)\n    \n    local state = allStates[destGUID]\n    if state then\n        state.value = data.value\n        state.changed = true\n        state.show = data.value > 0\n    end\n    \n    if data.value <= 0 then\n        aura_env.activeShields[destGUID] = nil\n    end\n    \n    return state ~= nil\nend",
