["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 3,\n            expirationTime = GetTime() + 3,\n            name = \"Emerges\",\n            autoHide = true,\n            icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\Throne of Thunder\\\\ArrowUpWhite.tga\",\n        }\n        return true\n    end\n    \n    if event == \"WA_LURKER_SUBMERGE\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 3,\n            expirationTime = GetTime() + 3,\n            name = \"Submerges\",\n            autoHide = true,\n            icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\Throne of Thunder\\\\ArrowDownWhite.tga\",\n        }\n        return true\n    elseif event == \"WA_LURKER_EMERGE\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 3,\n            expirationTime = GetTime() + 3,\n            name = \"Emerges\",\n            autoHide = true,\n            icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\Throne of Thunder\\\\ArrowUpWhite.tga\",\n        }\n        return true\n    end\nend",
["spellIds"] = {
