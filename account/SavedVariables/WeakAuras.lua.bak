["start"] = {
["sound"] = "Interface\\Addons\\FojjiCore\\sound\\fojjiPop2.ogg",
["custom"] = "if aura_env.state.target == WeakAuras.myGUID then\n    local class = UnitClassBase(\"player\")\n    \n    if class == \"HUNTER\" then\n        local start, duration = GetSpellCooldown(5384)\n        \n        if start == 0 or duration == 0 then\n            C_VoiceChat.SpeakText(_G.FJITTS_SFX_VOICEID, \"Feign\", _G.FJITTS_SFX_RATE, _G.FJITTS_SFX_VOLUME, true)\n        end\n    elseif class == \"ROGUE\" then\n        local start, duration = GetSpellCooldown(1856)\n        \n        if start == 0 or duration == 0 then\n            C_VoiceChat.SpeakText(_G.FJITTS_SFX_VOICEID, \"Vanish\", _G.FJITTS_SFX_RATE, _G.FJITTS_SFX_VOLUME, true)\n        end\n    end\nend",
