["desc"] = "",
["id"] = "L:[T4][MGL] Hellfire Channeler HP",
["actions"] = {
["start"] = {
["do_custom"] = false,
["custom"] = "",
},
["init"] = {
["do_custom"] = true,
["custom"] = "local npcId = \"17256\"\nlocal amountIndexes = {\n    [\"SWING_DAMAGE\"] = 12,\n    [\"RANGE_DAMAGE\"] = 15,\n    [\"SPELL_DAMAGE\"] = 15,\n    [\"SPELL_PERIODIC_DAMAGE\"] = 15,\n    [\"ENVIRONMENTAL_DAMAGE\"] = 13,\n    [\"SPELL_HEAL\"] = 15,\n}\n\nlocal deadCount = 0\nlocal totalHP = 218300\n\nlocal function raidIndexFromRaidFlags(flags)\n    if not flags then return nil end\n    if flags < 0 then flags = flags + 4294967296 end\n    local low = flags % 256\n    if low == 0 then return nil end\n    \n    for i = 1, 8 do\n        local mask = 2 ^ (i - 1)\n        if (low % (mask * 2)) >= mask then\n            return i\n        end\n    end\n    \n    return nil\nend\n\nlocal function setPercent(state)\n    local total = state.total or 0\n    if total > 0 then\n        state.percent = (state.value / total) * 100\n    else state.percent = 0\n    end\nend\n\nlocal function sortStates(allStates)\n    local list = {}\n    for _, state in pairs(allStates) do\n        if state and state.show then\n            list[#list + 1] = state\n        end\n    end\n    table.sort(list, function(a, b)\n            local aDead = a.isDead or (a.value or 0) <= 0\n            local bDead = b.isDead or (b.value or 0) <= 0\n            \n            if aDead ~= bDead then\n                return not aDead\n            end\n            \n            if aDead then\n                return false\n            end\n            \n            return (a.value or 0) < (b.value or 0)\n    end)\n    for i, state in ipairs(list) do\n        if state.index ~= i then\n            state.index = i\n            state.changed = true\n        end\n    end\nend\n\nlocal function update(state, amount, isHeal)\n    amount = amount or 0\n    if isHeal then\n        state.value = (state.value or 0) + amount\n    else\n        state.value = (state.value or 0) - amount\n    end\n    \n    if state.value < 0 then state.value = 0 end\n    if state.total and state.value > state.total then\n        state.value = state.total\n    end\n    \n    setPercent(state)\n    state.changed = true\n    return true\nend\n\nfunction aura_env.WA_FJI_ENCOUNTER_START(allStates)\n    deadCount = 0\n    return true\nend\n\nfunction aura_env.COMBAT_LOG_EVENT_UNFILTERED(allStates, _, subEvent, _, _, _, _, _, destGUID, destName, destFlags, destRaidFlags, ...)\n    if select(6, strsplit(\"-\", destGUID)) ~= npcId then\n        return false\n    end\n    \n    if subEvent == \"UNIT_DIED\" then\n        deadCount = deadCount + 1\n        if deadCount == 5 then\n            for _, state in pairs(allStates) do\n                state.show = false\n                state.changed = true\n            end\n            return true\n        end\n        \n        local state = allStates[destGUID]\n        if state then\n            state.changed = true\n            state.isDead = true\n            state.mark = \"\"\n            sortStates(allStates)\n            return true\n        end\n        return false\n    end\n    \n    local amountIndex = amountIndexes[subEvent]\n    if not amountIndex then\n        return false\n    end\n    \n    local state = allStates[destGUID]\n    if state and state.isDead then\n        return false\n    end\n    \n    if not state then\n        allStates[destGUID] = {\n            show = true,\n            changed = true,\n            progressType = \"static\",\n            value = totalHP,\n            total = totalHP,\n            isDead = false,\n        }\n        setPercent(allStates[destGUID])\n        state = allStates[destGUID]\n    end\n    \n    local raidTargetIndex = raidIndexFromRaidFlags(destRaidFlags)\n    if raidTargetIndex then\n        state.mark = \"{rt\" .. raidTargetIndex .. \"}\"\n    else\n        state.mark = \"\"\n    end\n    local amount = select(amountIndex - 11, ...)\n    local isHeal = subEvent == \"SPELL_HEAL\"\n    update(state, amount, isHeal)\n    sortStates(allStates)\n    return true\nend\n\nfunction aura_env.OPTIONS(allStates)\n    local dead1 = fastrandom(1, 5)\n    local dead2 = fastrandom(1, 5)\n    while dead2 == dead1 do\n        dead2 = fastrandom(1, 5)\n    end\n    \n    for i = 1, 5 do\n        local isDead = (i == dead1 or i == dead2)\n        local percent = isDead and 0 or fastrandom(1, 100)\n        local value = math.floor(totalHP * (percent / 100))\n        \n        allStates[i] = {\n            show = true,\n            changed = true,\n            progressType = \"static\",\n            total = totalHP,\n            value = value,\n            percent = percent,\n            isDead = isDead,\n            mark = \"{rt\" .. i .. \"}\",\n        }\n    end\n    \n    sortStates(allStates)\n    return true\nend\n\nlocal function reset(allStates)\n    for _, state in pairs(allStates) do\n        state.show = false\n        state.changed = true\n        state.isDead = false\n    end\n    deadCount = 0\n    return true\nend\n\nfunction aura_env.WA_FJI_ENCOUNTER_END(allStates)\n    reset(allStates)\n    return true\nend\n\nfunction aura_env.STATUS(allStates)\n    return reset(allStates)\nend",
},
