["custom"] = "aura_env.respond = \"WA_FJI_T5_VERSION_CHECK_RESPOND\"\naura_env.request = \"WA_FJI_T5_VERSION_CHECK_REQUEST\"\naura_env.version = \"1.0.0\"",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["debuffType"] = "HELPFUL",
["duration"] = "1",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["spellIds"] = {
},
["events"] = "WA_FJI_T5_VERSION_CHECK_REQUEST",
["custom_type"] = "stateupdate",
["check"] = "event",
["custom"] = "function(a, e, msg, _, _, _, _, _, _, _, _, _, _, guid)\n    if e == aura_env.request then\n        local raidLeader = nil\n        local index = nil\n        \n        for i = 1, GetNumGroupMembers() do\n            local unit = \"raid\" .. i\n            if UnitExists(unit) then\n                if UnitIsGroupLeader(unit) then\n                    raidLeader = UnitName(unit)\n                end\n                if UnitIsUnit(unit, \"player\") then\n                    index = i\n                end\n            end\n        end\n        \n        local delay = (index / 10)\n        C_Timer.After(delay / 10, function()\n                _G.SyncEvents(\"RAID\", raidLeader, aura_env.respond, WeakAuras.me, aura_env.version)\n        end)\n    end\nend",
["unit"] = "player",
["custom_hide"] = "timed",
},
["untrigger"] = {
},
},
["activeTriggerMode"] = -10,
},
