["custom"] = "function(a,e,...)\n    if e == \"OPTIONS\" then\n        for i = 1,2 do\n            a[i] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = 9,\n                expirationTime = GetTime() + 9,\n                autoHide = true,\n            }\n        end\n        return true\n    end\n    \n    if e == \"WA_NUMEN_TIMER\" then\n        local key,time,count,guid = ...\n        \n        if key == \"TRASH_FEARBRINGER_FLAMES\" and guid and a[guid] then\n            a[guid].show = false\n            a[guid].changed = true\n            return true\n        end\n        return false\n    end\n    \n    local _,subEvent,_,sourceGUID,sourceName,_,_,destGUID,_,_,_,spellId = ...\n    \n    if subEvent == \"SPELL_CAST_SUCCESS\" then\n        if spellId == aura_env.rain then\n            WeakAuras.ScanEvents(\"WA_BT_RAIN_OF_CHAOS\")\n            a[sourceGUID] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = 9,\n                expirationTime = GetTime() + 9,\n                autoHide = true,\n            }\n            return true\n        elseif spellId == aura_env.rainAlt then\n            WeakAuras.ScanEvents(\"WA_BT_RAIN_OF_CHAOS\")\n            a[sourceGUID] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = 6,\n                expirationTime = GetTime() + 6,\n                autoHide = true,\n            }\n            return true\n        end\n    end\n    \n    if subEvent == \"UNIT_DIED\" then\n        if a[destGUID] then\n            a[destGUID].show = false\n            a[destGUID].changed = true\n            return true\n        end\n    end\nend",
