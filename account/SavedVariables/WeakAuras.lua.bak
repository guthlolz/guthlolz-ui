["custom_hide"] = "timed",
["custom"] = "function(event, button)\n    if event ~= \"WA_TRINKET_TRACKER_CLICK_SLOT_1\" then\n        return false\n    end\n    if button ~= \"LeftButton\" then\n        return true\n    end\n    \n    local trinket1 = ItemLocation:CreateFromEquipmentSlot(13)\n    if C_Item.DoesItemExist(trinket1) then\n        aura_env.trinket1ID = C_Item.GetItemID(trinket1)\n    end\n    \n    aura_env.UnequipItemBySlot(13)\n    C_Timer.After(0.5, function()\n            WeakAuras.ScanEvents(\"WA_TRINKET_TRACKER_EQUIP_SLOT_1\", aura_env.trinket1ID)\n    end)\nend",
