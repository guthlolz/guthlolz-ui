["custom"] = "function(allstates,event,class)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 5,\n            expirationTime = GetTime()+5,\n            progressType = \"timed\",\n            autoHide = true,\n            icon = 626004,\n            type = \"BOP\",\n        }\n        return true\n    end\n    \n    if class ~= \"PRIEST\" then\n        return false\n    end\n    \n    local type\n    if event == \"WA_ILLIDARI_BOP_TARGET\" then\n        type = \"BOP\"\n    elseif event == \"WA_ILLIDARI_SPELL_WARDING_TARGET\" then\n        type = \"WARDING\"\n    else\n        return false\n    end\n    \n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n        duration = 2.5,\n        expirationTime = GetTime()+2.5,\n        progressType = \"timed\",\n        autoHide = true,\n        icon = 626004,\n        type = type,\n    }\n    return true\nend",
