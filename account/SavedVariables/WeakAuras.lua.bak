},
["custom"] = "function(event,...)\n    if event == \"ENCOUNTER_START\" then\n        aura_env.throttle = 0\n        return false\n    end\n    \n    if event == \"UNIT_AURA\" then\n        local unit = ...\n        \n        if WA_GetUnitAura(unit,aura_env.spellID,\"HARMFUL\") then\n            local now = GetTime()\n            \n            if now-aura_env.throttle >= 20 then\n                aura_env.throttle = now\n                WeakAuras.ScanEvents(\"WA_ILLIDAN_CAGED\")\n            end\n        end\n    end\n    \n    return false\nend",
