["actions"] = {
["start"] = {
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.absorbSpells = {\n    [17740] = 119, -- [Mage] Mana Shield\n    [17741] = 119, -- [Mage] Mana Shield\n    [1463] = 119, -- [Mage] Mana Shield (Rank 1)\n    [8494] = 209, -- [Mage] Mana Shield (Rank 2)\n    [8495] = 299, -- [Mage] Mana Shield (Rank 3)\n    [10191] = 389, -- [Mage] Mana Shield (Rank 4)\n    [10192] = 479, -- [Mage] Mana Shield (Rank 5)\n    [10193] = 569, -- [Mage] Mana Shield (Rank 6)\n    [27131] = 715, -- [Mage] Mana Shield (Rank 7)\n}\n\nlocal function update(state, amount)\n    state.value = state.value - amount\n    state.show = state.value > 0\n    state.changed = true\n    return true\nend\n\nfunction aura_env.WA_FJI_ABSORB_APPLIED(allStates, total, spellId)\n    if not aura_env.absorbSpells[spellId] then\n        return\n    end\n    \n    allStates[\"\"] = {\n        show = true,\n        changed = true,\n        progressType = \"static\",\n        value = total,\n        total = total,\n    }\n    return true\nend\n\nfunction aura_env.WA_FJI_ABSORB_REMOVED(allStates, spellId)\n    if not aura_env.absorbSpells[spellId] then\n        return\n    end\n    \n    allStates[\"\"] = {\n        show = true,\n        changed = true,\n        progressType = \"static\",\n        value = total,\n        total = total,\n    }\n    return true\nend\n\nfunction aura_env.WA_FJI_ABSORB_UPDATE(allStates, amount, spellId)\n    if not aura_env.absorbSpells[spellId] then\n        return\n    end\n    local state = allStates[\"\"]\n    if state then\n        return update(state, amount)\n    end\nend\n\nfunction aura_env.OPTIONS(allStates)\n    allStates[\"\"] = {\n        show = true,\n        changed = true,\n        progressType = \"static\",\n        value = math.random(1, 826),\n        total = 826,\n    }\n    return true\nend\n\nfunction aura_env.STATUS(allStates)\n    return\nend",
["do_custom"] = true,
},
["finish"] = {
