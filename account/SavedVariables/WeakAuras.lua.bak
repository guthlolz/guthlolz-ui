["type"] = "custom",
["custom_type"] = "stateupdate",
["custom_hide"] = "timed",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["unit"] = "player",
["custom"] = "function(allstates, event, key, time)\n    if event == \"WA_NUMEN_TIMER\" then\n        if aura_env.berserkKeys[key] and time ~= nil and time > 0 then\n            aura_env.updateState(allstates, time, key)\n            return true\n        end\n    elseif event == \"WA_FJI_ENCOUNTER_END\" then\n        aura_env.hideState(allstates)\n        return true\n    end\nend",
["events"] = "WA_NUMEN_TIMER WA_FJI_ENCOUNTER_END",
["customVariables"] = "{\n    expirationTime = \"number\",\n    key = \"string\",\n}",
["check"] = "event",
["spellIds"] = {
