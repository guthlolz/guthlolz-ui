["[BT] Respond - Version Check [Part 1]"] = {
["outline"] = "OUTLINE",
["wagoID"] = "pbbuhQ899",
["color"] = {
1,
1,
1,
1,
},
["displayText"] = "",
["shadowYOffset"] = -1,
["anchorPoint"] = "CENTER",
["displayText_format_name_pad"] = false,
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
["message"] = "",
["do_custom"] = false,
["do_message"] = false,
["message_type"] = "RAID",
},
["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.respond = \"WA_FJI_BT_VERSION_CHECK_RESPOND\"\naura_env.request = \"WA_FJI_BT_VERSION_CHECK_REQUEST\"\n\naura_env.version = \"1.2.2\"\naura_env.part = \"part1\"",
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["duration"] = "1",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["unit"] = "player",
["custom"] = "function(a, e, msg, _, _, _, _, _, _, _, _, _, _, guid)\n    if e == aura_env.request then\n        local raidLeader = nil\n        local index = nil\n        \n        for i = 1, GetNumGroupMembers() do\n            local unit = \"raid\" .. i\n            if UnitExists(unit) then\n                if UnitIsGroupLeader(unit) then\n                    raidLeader = UnitName(unit)\n                end\n                if UnitIsUnit(unit, \"player\") then\n                    index = i\n                end\n            end\n        end\n        \n        local delay = (index / 10)\n        C_Timer.After(delay / 10, function()\n                _G.SyncEvents(\"RAID\", raidLeader, aura_env.respond, WeakAuras.me, aura_env.version, aura_env.part)\n        end)\n    end\nend",
["events"] = "WA_FJI_BT_VERSION_CHECK_REQUEST",
["names"] = {
},
["check"] = "event",
["spellIds"] = {
},
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
},
