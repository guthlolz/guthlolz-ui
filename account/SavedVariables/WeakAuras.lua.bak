["CT:[T4][Gruul] Ground Slam"] = {
["outline"] = "OUTLINE",
["wagoID"] = "ASKpBvm6n",
["color"] = {
1,
1,
1,
1,
},
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["shadowYOffset"] = -1,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiT4RaidPack/3",
["actions"] = {
["start"] = {
},
["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.key = \"GRUUL_GROUND_SLAM\"\naura_env.count = 1\naura_env.cdStart = 40\naura_env.cdWindow = 74\naura_env.groundSlam = 33525\n\nfunction aura_env.nuTimer(countdown, count)\n    WeakAuras.ScanEvents(\"WA_NUMEN_TIMER\", aura_env.key, countdown, count)\nend\n\nfunction aura_env.updateState(allstates)\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n    }\nend\n\nfunction aura_env.hideState(allstates)\n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\nend\n\nfunction aura_env.preWarn(duration, preWarnTime, count)\n    if not preWarnTime then\n        preWarnTime = 3\n    end\n    \n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\n    aura_env.preWarnTimer = C_Timer.NewTimer(duration - preWarnTime, function()\n            WeakAuras.ScanEvents(\"WA_\" .. aura_env.key ..\"_PREWARN\", preWarnTime, count)\n            aura_env.preWarnTimer = nil\n    end)\nend\n\nfunction aura_env.preWarnCancel()\n    WeakAuras.ScanEvents(\"WA_\" .. aura_env.key .. \"_PREWARN_CANCEL\")\n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\nend",
},
["finish"] = {
["custom"] = "aura_env.count = 1\naura_env.nuTimer(nil)\naura_env.preWarnCancel()",
["do_sound"] = false,
["do_message"] = false,
["do_custom"] = true,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["custom_hide"] = "timed",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["unit"] = "player",
["custom"] = "function(allstates,event,eID,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId)\n    if event == \"WA_FJI_ENCOUNTER_START\" or event == \"ENCOUNTER_START\" then\n        if eID ~= 650 then\n            return false\n        end\n        aura_env.updateState(allstates)\n        aura_env.count = 1\n        aura_env.preWarn(aura_env.cdStart, 3, aura_env.count)\n        aura_env.nuTimer(aura_env.cdStart, aura_env.count)\n        return true\n    elseif event == \"WA_FJI_ENCOUNTER_END\" or event == \"ENCOUNTER_END\" then\n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        return true\n    end\n    \n    if spellId ~= aura_env.groundSlam then\n        return false\n    end\n    \n    if subEvent == \"SPELL_CAST_START\" then\n        WeakAuras.ScanEvents(\"WA_GRUUL_GROUND_SLAM_CAST\")\n        aura_env.nuTimer(0, aura_env.count)\n        aura_env.count = aura_env.count + 1\n        aura_env.preWarn(aura_env.cdWindow, 3, aura_env.count)\n        aura_env.nuTimer(aura_env.cdWindow, aura_env.count)\n        return true\n    end\nend",
["events"] = "ENCOUNTER_START, WA_FJI_ENCOUNTER_START, ENCOUNTER_END, WA_FJI_ENCOUNTER_END, CLEU:SPELL_CAST_START",
["customVariables"] = "",
["check"] = "event",
