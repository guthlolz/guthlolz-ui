},
["displayText_format_p_time_dynamic_threshold"] = 60,
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["url"] = "https://wago.io/FojjiAPIRoleTBC/3",
["actions"] = {
["start"] = {
["custom"] = "DisableEvent(RaidBossEmoteFrame, \"RAID_BOSS_EMOTE\")\nDisableEvent(RaidBossEmoteFrame, \"RAID_BOSS_WHISPER\")\nDisableEvent(RaidBossEmoteFrame, \"CLEAR_BOSS_EMOTES\")\nprint(\"unregister\")",
["do_custom"] = false,
},
["init"] = {
["custom"] = "local function getManualRole()\n    local profiles = aura_env.config.option\n    local charName = WeakAuras.me\n    \n    for _, profile in ipairs(profiles) do\n        if profile and profile.charName == charName then\n            local v = profile.role\n            if v == 1 or v == 2 or v == 3 or v == 4 then\n                return v\n            end\n            return nil\n        end\n    end\n    return nil\nend\n\nlocal function clearRole()\n    _G.FJI_HEALER = nil\n    _G.FJI_TANK   = nil\n    _G.FJI_MELEE  = nil\n    _G.FJI_RANGED = nil\nend\n\nlocal function applyManualRole(roleNum)\n    clearRole()\n    \n    if roleNum == 1 then\n        _G.FJI_TANK = true\n        return \"TANK\"\n    elseif roleNum == 2 then\n        _G.FJI_HEALER = true\n        return \"HEALER\"\n    elseif roleNum == 3 then\n        _G.FJI_RANGED = true\n        return \"DAMAGER\"\n    elseif roleNum == 4 then\n        _G.FJI_MELEE = true\n        return \"DAMAGER\"\n    end\n    \n    return nil\nend\n\nlocal function setInternalRole()\n    local override = getManualRole()\n    if override then\n        return applyManualRole(override)\n    end\n    clearRole()\n    \n    local class = UnitClassBase(\"player\")\n    \n    if class == \"DRUID\" then\n        if IsPlayerSpell(17116) then -- Nature's Swiftness\n            _G.FJI_HEALER = true\n        elseif IsPlayerSpell(16896) or IsPlayerSpell(16897) or IsPlayerSpell(16899) or IsPlayerSpell(16900) or IsPlayerSpell(16901) then -- Moonkin Form\n            _G.FJI_RANGED = true\n        elseif IsPlayerSpell(16933) or IsPlayerSpell(16930) or IsPlayerSpell(16932) or IsPlayerSpell(16929) or IsPlayerSpell(16931) then -- Thick Hide talents\n            _G.FJI_TANK = true\n        else\n            _G.FJI_MELEE = true\n        end\n        \n    elseif class == \"HUNTER\" then\n        _G.FJI_RANGED = true\n        \n    elseif class == \"MAGE\" then\n        _G.FJI_RANGED = true\n        \n    elseif class == \"PALADIN\" then\n        if IsPlayerSpell(20930) then -- Holy Shock\n            _G.FJI_HEALER = true\n        elseif IsPlayerSpell(20925) then -- Holy Shield\n            _G.FJI_TANK = true\n        else\n            _G.FJI_MELEE = true\n        end\n        \n    elseif class == \"PRIEST\" then\n        if IsPlayerSpell(15473) then -- Shadowform\n            _G.FJI_RANGED = true\n        else\n            _G.FJI_HEALER = true\n        end\n        \n    elseif class == \"ROGUE\" then\n        _G.FJI_MELEE = true\n        \n    elseif class == \"SHAMAN\" then\n        if IsPlayerSpell(16190) then -- Mana Tide Totem\n            _G.FJI_HEALER = true\n        elseif IsPlayerSpell(16166) then -- Elemental Mastery\n            _G.FJI_RANGED = true\n        else\n            _G.FJI_MELEE = true\n        end\n        \n    elseif class == \"WARLOCK\" then\n        _G.FJI_RANGED = true\n        \n    elseif class == \"WARRIOR\" then\n        if IsPlayerSpell(23922) or IsPlayerSpell(30356) or IsPlayerSpell(25258) then -- Shield Slam\n            _G.FJI_TANK = true\n        else\n            _G.FJI_MELEE = true\n        end\n    end\n    \n    if _G.FJI_TANK then\n        return \"TANK\"\n    elseif _G.FJI_HEALER then\n        return \"HEALER\"\n    else\n        return \"DAMAGER\"\n    end\nend\nsetInternalRole()\n\nlocal function InGroup()\n    return IsInGroup() or IsInRaid()\nend\n\nfunction aura_env.updateRole()\n    local role = setInternalRole()\n    \n    if not InGroup() then\n        return\n    end\n    \n    if UnitGroupRolesAssigned(\"player\") ~= role then\n        UnitSetRole(\"player\", role)\n    end\nend",
["do_custom"] = true,
},
["finish"] = {
},
},
