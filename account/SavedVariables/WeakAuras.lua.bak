},
["actions"] = {
["start"] = {
["custom"] = "local cfg = aura_env.config.option\nlocal state = aura_env.state\n\nif cfg.colorOverride then\n    local color = cfg.color\n    if color then\n        aura_env.region:Color(color[1], color[2], color[3], color[4] or 1)\n    end\nelse\n    if state and state.color then\n        aura_env.region:Color(state.color[1], state.color[2], state.color[3], state.color[4] or 1)\n    end\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "",
["do_sound"] = false,
["do_message"] = false,
["do_custom"] = false,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
},
["init"] = {
["custom"] = "local function createKey(key, guid)\n    return guid and (key .. \"_\" .. guid) or key\nend\n\nfunction aura_env.updateState(allstates, key, duration, count, name, icon, color, autoHide, text, guid, tts)\n    local c = color or {1, 1, 1, 1}\n    local r, g, b, a = c[1] or 1, c[2] or 1, c[3] or 1, c[4] or 1\n    local stateKey = createKey(key, guid)\n    \n    allstates[stateKey] = {\n        show = true,\n        changed = true,\n        duration = duration,\n        expirationTime = GetTime() + duration,\n        progressType = \"timed\",\n        count = count,\n        color = { r, g, b, a },\n        icon = icon,\n        name = name,\n        autoHide = autoHide,\n        text = text or \"\",\n        tts = tts or false,\n        spellKey = key,\n    }\nend\n\nfunction aura_env.hideState(allstates, key, guid)\n    local stateKey = createKey(key, guid)\n    \n    if allstates[stateKey] then\n        allstates[stateKey].show = false\n        allstates[stateKey].changed = true\n        return true\n    end\nend",
["do_custom"] = true,
},
},
