["CT:[BT][Illidan] Flame Blast"] = {
["outline"] = "OUTLINE",
["wagoID"] = "pbbuhQ899",
["parent"] = "[BT][Illidan]",
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiBT-P1/12",
["actions"] = {
["start"] = {
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.debug = false\naura_env.key = \"ILLIDAN_FLAME_BLAST\"\naura_env.cdStart = 17\naura_env.cdWindow = 11\naura_env.preWarnTime = 3\n\naura_env.spellName = \"Flame Blast\"\naura_env.spellID = 40631\naura_env.npcID = \"22997\"\naura_env.encounterID = 609\n\naura_env.startExpiration = nil\naura_env.mobs = {}\naura_env.preWarnTimers = {}\n\nfunction aura_env.debugPrint(message)\n    if aura_env.debug then\n        print(message)\n    end\nend\n\nfunction aura_env.nuTimer(countdown,count,guid)\n    WeakAuras.ScanEvents(\"WA_NUMEN_TIMER\",aura_env.key,countdown,count,guid)\nend\n\nfunction aura_env.updateState(allstates)\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n    }\nend\n\nfunction aura_env.hideState(allstates)\n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\nend\n\nfunction aura_env.preWarn(duration,preWarnTime,count,guid)\n    preWarnTime = preWarnTime or 3\n    \n    if aura_env.preWarnTimers[guid] then\n        aura_env.preWarnTimers[guid]:Cancel()\n        aura_env.preWarnTimers[guid] = nil\n    end\n    \n    if duration <= preWarnTime then\n        WeakAuras.ScanEvents(\"WA_\"..aura_env.key..\"_PREWARN\",math.max(duration,0),count,guid)\n        return\n    end\n    \n    aura_env.preWarnTimers[guid] = C_Timer.NewTimer(duration-preWarnTime,function()\n            WeakAuras.ScanEvents(\"WA_\"..aura_env.key..\"_PREWARN\",preWarnTime,count,guid)\n            aura_env.preWarnTimers[guid] = nil\n    end)\nend\n\nfunction aura_env.preWarnCancel(guid)\n    if guid then\n        WeakAuras.ScanEvents(\"WA_\"..aura_env.key..\"_PREWARN_CANCEL\",guid)\n        \n        if aura_env.preWarnTimers[guid] then\n            aura_env.preWarnTimers[guid]:Cancel()\n            aura_env.preWarnTimers[guid] = nil\n        end\n        return\n    end\n    \n    for mobGUID,timer in pairs(aura_env.preWarnTimers) do\n        WeakAuras.ScanEvents(\"WA_\"..aura_env.key..\"_PREWARN_CANCEL\",mobGUID)\n        timer:Cancel()\n    end\n    \n    wipe(aura_env.preWarnTimers)\nend\n\nfunction aura_env.reset()\n    aura_env.startExpiration = nil\n    aura_env.preWarnCancel()\n    wipe(aura_env.mobs)\nend\n\nfunction aura_env.captureMob(guid)\n    if not guid or aura_env.mobs[guid] then\n        return false\n    end\n    \n    local npcID = select(6,strsplit(\"-\",guid))\n    if npcID ~= aura_env.npcID then\n        return false\n    end\n    \n    local remaining = aura_env.startExpiration and math.max(0,aura_env.startExpiration-GetTime()) or 0\n    \n    aura_env.mobs[guid] = {\n        count = 1,\n        lastCast = nil,\n    }\n    \n    aura_env.debugPrint(string.format(\"Captured %s: %.1fs remaining on initial timer.\",guid,remaining))\n    \n    aura_env.preWarn(remaining,aura_env.preWarnTime,1,guid)\n    aura_env.nuTimer(remaining,1,guid)\n    return true\nend\n\nfunction aura_env.captureNameplates()\n    for _,plateData in pairs(C_NamePlate.GetNamePlates()) do\n        local unit = plateData.UnitFrame.displayedUnit\n        aura_env.captureMob(UnitGUID(unit))\n    end\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "for guid in pairs(aura_env.mobs) do\n    aura_env.nuTimer(nil,nil,guid)\nend\n\naura_env.reset()",
["do_sound"] = false,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
["do_message"] = false,
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "ENCOUNTER_START, ENCOUNTER_END, WA_FJI_ENCOUNTER_END, WA_FJI_ENCOUNTER_START, CLEU:SPELL_CAST_SUCCESS, WA_ILLIDAN_P2_START, WA_ILLIDAN_P3_START, WA_ILLIDAN_P4_START, WA_ILLIDAN_DEMON_FORM, WA_ILLIDAN_HUMAN_FORM, NAME_PLATE_UNIT_ADDED",
["spellIds"] = {
},
["custom"] = "function(allstates,event,eID,subEvent,_,sourceGUID,_,_,_,destGUID,destName,destFlags,_,spellId)\n    if event == \"WA_FJI_ENCOUNTER_START\" or event == \"ENCOUNTER_START\" then\n        if eID ~= aura_env.encounterID then\n            return false\n        end\n\n        aura_env.reset()\n        aura_env.updateState(allstates)\n        return true\n    elseif event == \"WA_ILLIDAN_P2_START\" then\n        aura_env.reset()\n        aura_env.startExpiration = GetTime()+aura_env.cdStart\n        aura_env.captureNameplates()\n        return true\n    elseif event == \"WA_ILLIDAN_P3_START\" then\n        for guid in pairs(aura_env.mobs) do\n            aura_env.nuTimer(nil,nil,guid)\n        end\n\n        aura_env.reset()\n        return false\n    elseif event == \"WA_FJI_ENCOUNTER_END\" or event == \"ENCOUNTER_END\" then\n        for guid in pairs(aura_env.mobs) do\n            aura_env.nuTimer(nil,nil,guid)\n        end\n\n        aura_env.reset()\n        return false\n    elseif event == \"NAME_PLATE_UNIT_ADDED\" then\n        if not aura_env.startExpiration then\n            return false\n        end\n\n        local unit = eID\n        aura_env.captureMob(UnitGUID(unit))\n        return false\n    end\n\n    if subEvent ~= \"SPELL_CAST_SUCCESS\" then\n        return false\n    end\n\n    if not sourceGUID or select(6,strsplit(\"-\",sourceGUID)) ~= aura_env.npcID then\n        return false\n    end\n\n    aura_env.captureMob(sourceGUID)\n\n    if spellId ~= aura_env.spellID then\n        return false\n    end\n\n    local mob = aura_env.mobs[sourceGUID]\n    if not mob then\n        return false\n    end\n\n    local now = GetTime()\n\n    if mob.lastCast then\n        aura_env.debugPrint(string.format(\"Next %s (%d) [%s]: %.1fs after previous.\",aura_env.spellName,mob.count,sourceGUID,now-mob.lastCast))\n    elseif aura_env.startExpiration then\n        local phaseStart = aura_env.startExpiration-aura_env.cdStart\n        aura_env.debugPrint(string.format(\"First %s (%d) [%s]: %.1fs into phase.\",aura_env.spellName,mob.count,sourceGUID,now-phaseStart))\n    end\n\n    mob.lastCast = now\n\n    aura_env.nuTimer(0,mob.count,sourceGUID)\n    mob.count = mob.count+1\n    aura_env.preWarn(aura_env.cdWindow,aura_env.preWarnTime,mob.count,sourceGUID)\n    aura_env.nuTimer(aura_env.cdWindow,mob.count,sourceGUID)\n    return false\nend",
["check"] = "event",
["subeventPrefix"] = "SPELL",
["custom_hide"] = "timed",
