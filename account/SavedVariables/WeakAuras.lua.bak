["T:[MH][Trash] Wave Composition"] = {
["displayText_format_text_format"] = "none",
["authorOptions"] = {
},
["displayText_format_p_time_dynamic_threshold"] = 60,
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_n_abbreviate_max"] = 8,
["displayText_format_p_time_format"] = 0,
["url"] = "https://wago.io/FojjiHyjal/3",
["actions"] = {
["start"] = {
["custom"] = "",
["do_custom"] = false,
},
["finish"] = {
["custom"] = "",
["do_custom"] = false,
},
["init"] = {
["custom"] = "aura_env.throttle = 0\n\naura_env.mobData = {\n    [\"Ghouls\"] = {\n        singular = \"Ghoul\",\n        plural = \"Ghouls\",\n        icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\Ghoul.png\",\n        npcIDs = {[\"17895\"] = true},\n    },\n    [\"Crypt Fiends\"] = {\n        singular = \"Fiend\",\n        plural = \"Fiends\",\n        icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\CryptFiend.png\",\n        npcIDs = {[\"17897\"] = true},\n    },\n    [\"Necromancers\"] = {\n        singular = \"Necro\",\n        plural = \"Necros\",\n        icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\Necromancer.png\",\n        npcIDs = {[\"17899\"] = true},\n    },\n    [\"Abominations\"] = {\n        singular = \"Abom\",\n        plural = \"Aboms\",\n        icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\Abomination.png\",\n        npcIDs = {[\"17898\"] = true},\n    },\n    [\"Banshees\"] = {\n        singular = \"Banshee\",\n        plural = \"Banshees\",\n        icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\Banshee.png\",\n        npcIDs = {[\"17905\"] = true},\n    },\n    [\"Gargoyles\"] = {\n        singular = \"Garg\",\n        plural = \"Gargs\",\n        icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\Gargoyle.png\",\n        npcIDs = {[\"17906\"] = true},\n    },\n    [\"Frost Wyrm\"] = {\n        singular = \"Wyrm\",\n        plural = \"Wyrms\",\n        icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\FrostWyrm.png\",\n        npcIDs = {[\"17907\"] = true},\n    },\n    [\"Fel Stalkers\"] = {\n        singular = \"Stalker\",\n        plural = \"Stalkers\",\n        icon = 136217,\n        npcIDs = {[\"17916\"] = true},\n    },\n    [\"Infernals\"] = {\n        singular = \"Infernal\",\n        plural = \"Infernals\",\n        icon = 136219,\n        npcIDs = {[\"17908\"] = true},\n    },\n}\n\nfunction aura_env.buildWaveText(composition)\n    local sorted = {}\n    \n    for _, mob in ipairs(composition) do\n        sorted[#sorted + 1] = {\n            count = mob.count,\n            name = mob.name,\n        }\n    end\n    \n    table.sort(sorted, function(a, b)\n            if a.count == b.count then\n                return a.name < b.name\n            end\n            \n            return a.count > b.count\n    end)\n    \n    local parts = {}\n    \n    for _, mob in ipairs(sorted) do\n        local data = aura_env.mobData[mob.name]\n        \n        if data then\n            local displayName = mob.count == 1 and data.singular or data.plural\n            parts[#parts + 1] = \"|T\" .. data.icon .. \":16:16|t |cffffff00\" .. mob.count .. \"|r \" .. displayName\n        else\n            parts[#parts + 1] = \"|cffffff00\" .. mob.count .. \"|r \" .. mob.name\n        end\n    end\n    \n    return table.concat(parts, \"  \")\nend",
["do_custom"] = true,
},
},
