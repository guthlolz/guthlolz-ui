["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, amount)\n    if event == \"OPTIONS\" then\n        local rnd = math.random(1,3)\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            progressType = \"timed\",\n            icon = 135833,\n            autoHide = true,\n            damage = rnd * 65\n        }\n        return true\n    end\n    \n    if event == \"WA_KARATHRESS_BLESSING\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            progressType = \"timed\",\n            icon = 135833,\n            autoHide = true,\n            damage = amount * 65\n        }\n        return true\n    end\nend",
