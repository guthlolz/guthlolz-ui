["displayText_format_t_format"] = "timed",
["displayText_format_c1_gcd_hide_zero"] = false,
["yOffset"] = 6.5097680524785,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["url"] = "https://wago.io/sGScXfEv2/48",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "local function GetRotation()\n    -- Cache to only update it once per 0.01s\n    local ltime = GetTime()\n    local cache = _G.cache_rotation\n    if cache then\n        if ltime < cache[1] + 0.01 then\n            return cache[2]\n        end\n    end\n    \n    local attackSpeed = UnitAttackSpeed(\"player\");\n    \n    local _, _, _, gcd, _,  _, _ = GetSpellInfo(19750)\n    if (not gcd) or (gcd >= 1500) then\n        gcd = 1500\n    elseif (gcd < 1000) then\n        gcd = 1000\n    end\n    gcd = gcd / 1000\n    local haste = (1.5-gcd)\n    \n    local output = \"\"\n    \n    if (attackSpeed > 2.6) then\n        output = \"1:2\";\n    elseif (attackSpeed >= math.max(1.9, 2*gcd-0.35) and haste>0.1) then\n        output = \"2:3\";\n    elseif (attackSpeed >= 2.4) or (attackSpeed >= 2.3 and haste>0.05) then\n        output = \"2:2:5\";\n    elseif (attackSpeed >= math.max(1.5, 1.5*gcd+0.05)) and haste>0.1 then\n        output = \"2:4\";\n    elseif (attackSpeed >= 1.9) then\n        output = \"1:3\";\n    elseif (attackSpeed >= (gcd+0.07)) then\n        output = \"2:5\";\n    elseif (attackSpeed > 1.0) then\n        output = \"2:5\";\n    elseif (attackSpeed >= 0.01) then\n        output = \"2007\";\n    end\n    \n    _G.cache_rotation = {ltime, output}\n    return output\nend\n\naura_env.GetRotation = GetRotation\n_G.GetRotation = GetRotation\n\n\nWeakAuras.ScanEvents(\"nextAction_event\", \"CS\") \n\n",
["do_custom"] = true,
},
["finish"] = {
},
},
