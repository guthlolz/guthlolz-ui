["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            autoHide = true,\n            guid = WeakAuras.myGUID,\n            icon = 135734\n        }\n        return true\n    end\n    \n    if event == \"WA_SOLARIAN_WRATH_APPLIED\" then\n        local destGUID = ...\n        allstates[destGUID] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 2.5,\n            expirationTime = GetTime() + 2.5,\n            autoHide = true,\n            guid = destGUID,\n            icon = 135734,\n            isPlayer = destGUID == WeakAuras.myGUID\n        }\n        return true\n    end\nend",
