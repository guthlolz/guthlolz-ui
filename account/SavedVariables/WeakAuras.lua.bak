["parent"] = "[T4]: Special Alerts",
["zoom"] = 0.32,
["adjustedMin"] = "",
["displayText_format_1.npcid_format"] = "none",
["displayText_format_c1_abbreviate"] = false,
["displayText_format_c2_abbreviate"] = false,
["cooldownSwipe"] = true,
["displayText_format_c1_abbreviate_max"] = 8,
["customTextUpdate"] = "event",
["useTooltip"] = false,
["desaturateForeground"] = false,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["customVariables"] = "{\n    count = \"number\",\n    expirationTime = true,\n    isSafe = \"bool\",\n}",
["subeventSuffix"] = "_CAST_START",
["subeventPrefix"] = "SPELL",
["duration"] = "20",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 15,\n            expirationTime = GetTime() + 15,\n            autoHide = true,\n            count = math.random(1, 3),\n            isSafe = true,\n        }\n        return true\n    end\n    \n    if event == \"WA_MAULGAR_WHIRLWIND_REMOVED\" or event == \"ENCOUNTER_END\" or event == \"WA_FJI_ENCOUNTER_END\" then\n        if allstates[\"\"] then\n            allstates[\"\"].show = false\n            allstates[\"\"].changed = true\n            return true\n        end\n        return false\n    end\n    \n    if event == \"WA_NUMEN_TIMER\" then\n        local key, time, count = ...\n        if key ~= \"MAULGAR_WHIRLWIND\" then\n            return false\n        end\n        \n        if time ~= 0 then\n            return false\n        end\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 15,\n            expirationTime = GetTime() + 15,\n            autoHide = true,\n            count = count,\n            isSafe = aura_env.isRangeSafe(),\n        }\n        return true\n    end\n    \n    if event == \"WA_MAULGAR_RANGE_CHECK\" then\n        local guid, safe = ...\n        if allstates[\"\"] then\n            if allstates[\"\"].isSafe ~= safe then\n                allstates[\"\"].isSafe = safe\n                allstates[\"\"].changed = true\n                return true\n            end\n        end\n        return false\n    end\nend",
["spellIds"] = {
},
["events"] = "ENCOUNTER_END WA_FJI_ENCOUNTER_END WA_NUMEN_TIMER WA_MAULGAR_RANGE_CHECK WA_MAULGAR_WHIRLWIND_REMOVED",
