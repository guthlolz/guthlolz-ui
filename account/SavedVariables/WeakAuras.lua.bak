["custom"] = "function(a,e,_,subEvent,_,_,_,_,_,destGUID,destName,_,_,spellId)\n    if subEvent == \"SPELL_DAMAGE\" then\n        if aura_env.spellIDs[spellId] then\n            local duration = aura_env.glowTime\n            a[destName] = {\n                duration = duration,\n                expirationTime = duration + GetTime(),\n                progressType = \"timed\",\n                autoHide = true,\n                unit = Ambiguate(destName, \"short\"),\n                show = true,\n                changed = true,\n            }     \n            return true\n        end\n    end\nend",
