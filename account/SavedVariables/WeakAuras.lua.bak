["custom"] = "function(allstates,event,sourceGUID)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            autoHide = true,\n            icon = 135862\n        }\n        return true\n    end\n    \n    if event == \"WA_TRASH_WATER_ELEMENTAL_TOTEM\" then\n        allstates[sourceGUID] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            autoHide = true,\n            icon = 135862,\n        }\n        return true\n    end\nend",
