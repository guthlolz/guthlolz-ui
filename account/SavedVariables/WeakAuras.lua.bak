["type"] = "custom",
["custom_type"] = "status",
["subeventSuffix"] = "_CAST_START",
["names"] = {
},
["duration"] = "",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(event, ...)\n    if event == \"OPTIONS\" then\n        return true\n    end\n    \n    if event == \"ENCOUNTER_START\" then\n        local eID = ...\n        if eID ~= 601 then\n            return false\n        end\n        \n        aura_env.active = true\n        aura_env.totalHealing = 0\n        aura_env.healCount = 0\n        return true\n    end\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        if not aura_env.active then\n            return false\n        end\n        \n        local _,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId,_,_,amount = ...\n        \n        if subEvent ~= \"SPELL_PERIODIC_HEAL\" then\n            return false\n        end\n        \n        local npcID = destGUID and select(6, strsplit(\"-\", destGUID))\n        if npcID ~= \"22887\" then\n            return false\n        end\n        \n        aura_env.totalHealing = aura_env.totalHealing + (amount or 0)\n        aura_env.healCount = aura_env.healCount + 1\n        return false\n    end\n    \n    if event == \"ENCOUNTER_END\" then\n        local eID = ...\n        if eID ~= 601 then\n            return false\n        end\n        \n        aura_env.active = false\n        C_Timer.After(5, function()\n                print(string.format(\"|TInterface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\najentus.jpg:16:16:0:0|t|cff66b3ffFojji|r|cff61ff9dNAJENTUS|r: Boss Healed for %s\", aura_env.FormatNumber(aura_env.totalHealing or 0)))\n        end)\n        return true\n    end\nend",
["events"] = "ENCOUNTER_START, ENCOUNTER_END, CLEU:SPELL_PERIODIC_HEAL",
["spellIds"] = {
},
["customIcon"] = "function()\n    return 135789\nend",
