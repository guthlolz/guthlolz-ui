["CT:[BT] Encounter End Helper"] = {
["outline"] = "OUTLINE",
["wagoID"] = "pbbuhQ899",
["parent"] = "[BT]: Controllers",
["displayText_format_p_time_dynamic_threshold"] = 60,
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
["do_custom"] = false,
["custom"] = "DisableEvent(RaidBossEmoteFrame, \"RAID_BOSS_EMOTE\")\nDisableEvent(RaidBossEmoteFrame, \"RAID_BOSS_WHISPER\")\nDisableEvent(RaidBossEmoteFrame, \"CLEAR_BOSS_EMOTES\")\nprint(\"unregister\")",
},
["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.ignoreUntil = 0\n\nfunction aura_env.checkGroupCombat()\n    for unit in WA_IterateGroupMembers() do\n        if UnitAffectingCombat(unit) then\n            return true\n        end\n    end\n    return false\nend\n\nfunction aura_env.scheduleCheck()\n    aura_env.cancelTimers()\n    \n    aura_env.timer = C_Timer.NewTimer(3,function()\n            aura_env.timer = nil\n            \n            aura_env.ticker = C_Timer.NewTicker(2,function()\n                    WeakAuras.ScanEvents(\"WA_FJI_COMBAT_CHECK\")\n            end,10)\n    end)\nend\n\nfunction aura_env.cancelTimers()\n    if aura_env.ticker then\n        aura_env.ticker:Cancel()\n        aura_env.ticker = nil\n    end\n    \n    if aura_env.timer then\n        aura_env.timer:Cancel()\n        aura_env.timer = nil\n    end\nend",
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_hide"] = "timed",
["custom_type"] = "status",
["unit"] = "player",
["duration"] = "0.1",
["event"] = "Chat Message",
["dynamicDuration"] = false,
["subeventPrefix"] = "SPELL",
["events"] = "PLAYER_REGEN_ENABLED, PLAYER_DEAD, PLAYER_ALIVE, WA_FJI_COMBAT_CHECK, WA_AKAMA_ACTIVATED",
["spellIds"] = {
},
["custom"] = "function(event)\n    if event == \"WA_AKAMA_ACTIVATED\" then\n        aura_env.ignoreUntil = GetTime()+120\n        aura_env.cancelTimers()\n        return false\n    end\n    \n    if event == \"STATUS\" or event == \"PLAYER_REGEN_ENABLED\" or event == \"PLAYER_DEAD\" or event == \"PLAYER_ALIVE\" then\n        aura_env.scheduleCheck()\n    end\n    \n    if event == \"WA_FJI_COMBAT_CHECK\" then\n        if GetTime() < aura_env.ignoreUntil then\n            return false\n        end\n        \n        if aura_env.checkGroupCombat() then\n            return false\n        end\n        \n        WeakAuras.ScanEvents(\"WA_FJI_ENCOUNTER_END\")\n        aura_env.cancelTimers()\n    end\nend",
["check"] = "event",
["names"] = {
},
