["CT:[T4][MGL] Encounter Start Helper"] = {
["outline"] = "OUTLINE",
["wagoID"] = "ASKpBvm6n",
["color"] = {
1,
1,
1,
1,
},
["displayText_format_p_time_dynamic_threshold"] = 60,
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiT4RaidPack/3",
["actions"] = {
["start"] = {
["do_custom"] = false,
["custom"] = "DisableEvent(RaidBossEmoteFrame, \"RAID_BOSS_EMOTE\")\nDisableEvent(RaidBossEmoteFrame, \"RAID_BOSS_WHISPER\")\nDisableEvent(RaidBossEmoteFrame, \"CLEAR_BOSS_EMOTES\")\nprint(\"unregister\")",
},
["init"] = {
["do_custom"] = true,
["custom"] = "local locale = GetLocale()\n\naura_env.locales = {\n    [\"enUS\"] = {\n        pull = \"%s's bonds begin to weaken!\",\n    },\n    [\"frFR\"] = {\n        pull = \"Les liens de %%s commencent à se relâcher !\",\n    },\n    [\"deDE\"] = {\n        pull = \"Die Fesseln von %%s werden schw\\195\\164cher!\",\n    },\n    [\"esES\"] = {\n        pull = \"¡Las cuerdas de %%s empiezan a aflojarse!\",\n    },\n    [\"koKR\"] = {\n        pull = \"%%s의 속박이 약해지기 시작합니다\",\n    },\n    [\"ruRU\"] = {\n        pull = \"начинает ослабевать!\",\n    },\n    [\"zhCN\"] = {\n        pull = \"%s的禁锢开始变弱！\",\n    },\n    [\"zhTW\"] = {\n        pull = \"束縛開始變弱\",\n    }\n}\n\naura_env.currentLocale = aura_env.locales[locale] or aura_env.locales[\"enUS\"]\n\nfunction aura_env.fireStart(encounterID)\n    aura_env.activeEncounterID = encounterID\n    WeakAuras.ScanEvents(\"WA_FJI_ENCOUNTER_START\", encounterID)\n    return true\nend",
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_hide"] = "timed",
["subeventSuffix"] = "_CAST_START",
["dynamicDuration"] = false,
["duration"] = "0.1",
["event"] = "Chat Message",
["unit"] = "player",
["custom"] = "function(allstates, event, msg)\n    if event == \"CHAT_MSG_MONSTER_EMOTE\" then\n        if msg:find(aura_env.currentLocale.pull) or msg == aura_env.currentLocale.pull then\n            aura_env.fireStart(651)\n        end\n        return false\n    end\nend",
["spellIds"] = {
},
["events"] = "CHAT_MSG_MONSTER_EMOTE",
["custom_type"] = "stateupdate",
["check"] = "event",
["names"] = {
},
