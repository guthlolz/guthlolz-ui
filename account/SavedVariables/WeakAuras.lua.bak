["actions"] = {
["start"] = {
["sound"] = "Interface\\Addons\\FojjiCore\\sound\\Beep.ogg",
["custom"] = "",
["do_custom"] = false,
["do_sound"] = false,
},
["init"] = {
["custom"] = "aura_env.castTime = 1.495\n\nlocal class = UnitClassBase(\"player\")\n\nif class == \"HUNTER\" then\n    aura_env.icon = GetSpellTexture(5384)\nelseif class == \"ROGUE\" then\n    aura_env.icon = GetSpellTexture(1856)\nelse\n    aura_env.icon = 135752\nend",
["do_custom"] = true,
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_hide"] = "timed",
["custom_type"] = "stateupdate",
["subeventPrefix"] = "SPELL",
["duration"] = "20",
["event"] = "Health",
["unit"] = "player",
["subeventSuffix"] = "_CAST_START",
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = aura_env.castTime,\n            expirationTime = GetTime() + aura_env.castTime,\n            autoHide = true,\n            icon = aura_env.icon,\n            name = UnitClassBase(\"player\") == \"HUNTER\" and \"FEIGN\" or \"VANISH\",\n        }\n        return true\n    end\n    \n    if event == \"WA_TERON_SHADOW_DEATH_TARGET\" then\n        local guid, name = ...\n        if guid ~= WeakAuras.myGUID then\n            return false\n        end\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = aura_env.castTime,\n            expirationTime = GetTime() + aura_env.castTime,\n            autoHide = true,\n            icon = aura_env.icon,\n            name = UnitClassBase(\"player\") == \"HUNTER\" and \"FEIGN\" or \"VANISH\",\n        }\n        return true\n    end\nend",
["spellIds"] = {
},
["events"] = "WA_TERON_SHADOW_DEATH_TARGET",
["check"] = "event",
