["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.e = \"TORMENT_SHELL\"\naura_env.timerKey = \"TRASH_TORMENT_SHELL\"\n\naura_env.icon = 136121\naura_env.preWarnDuration = 5\naura_env.fallbackTime = 10.5\naura_env.name = \"SHELL\"\n\naura_env.activePrewarns = {}\naura_env.timers = {}\n\nfunction aura_env.scheduleFallback(guid,time)\n    if aura_env.timers[guid] then\n        aura_env.timers[guid]:Cancel()\n    end\n    \n    aura_env.timers[guid] = C_Timer.NewTimer(time,function()\n            aura_env.timers[guid] = nil\n            WeakAuras.ScanEvents(\"WA_\" .. aura_env.e .. \"_PREWARN_FALLBACK\",guid)\n    end)\nend\n\nfunction aura_env.cancelFallback(guid)\n    if aura_env.timers[guid] then\n        aura_env.timers[guid]:Cancel()\n        aura_env.timers[guid] = nil\n    end\nend",
},
