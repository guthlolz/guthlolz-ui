["CT:[T5][Lurker] Spout"] = {
["outline"] = "OUTLINE",
["wagoID"] = "gSs1_GQRl",
["color"] = {
1,
1,
1,
1,
},
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["shadowYOffset"] = -1,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiT5RaidPack/3",
["actions"] = {
["start"] = {
},
["finish"] = {
["custom"] = "aura_env.count = 1\naura_env.nuTimer(nil)\naura_env.preWarnCancel()",
["do_sound"] = false,
["do_message"] = false,
["do_custom"] = true,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.key = \"LURKER_SPOUT\"\naura_env.count = 1\naura_env.cdStart = 37\naura_env.cdAfterEmerge = 37\naura_env.cdWindow = 50\n\nfunction aura_env.nuTimer(countdown, count)\n    WeakAuras.ScanEvents(\"WA_NUMEN_TIMER\", aura_env.key, countdown, count)\nend\n\nfunction aura_env.updateState(allstates)\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n    }\nend\n\nfunction aura_env.hideState(allstates)\n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\nend\n\nfunction aura_env.preWarn(duration, preWarnTime, count)\n    if not preWarnTime then\n        preWarnTime = 3\n    end\n    \n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\n    \n    aura_env.preWarnTimer = C_Timer.NewTimer(duration - preWarnTime, function()\n            WeakAuras.ScanEvents(\"WA_\" .. aura_env.key .. \"_PREWARN\", preWarnTime, count)\n            aura_env.preWarnTimer = nil\n    end)\nend\n\nfunction aura_env.preWarnCancel()\n    WeakAuras.ScanEvents(\"WA_\" .. aura_env.key .. \"_PREWARN_CANCEL\")\n    if aura_env.preWarnTimer then\n        aura_env.preWarnTimer:Cancel()\n        aura_env.preWarnTimer = nil\n    end\nend\n\nlocal locale = GetLocale()\n\naura_env.locales = {\n    [\"enUS\"] = {\n        lurker = \"The Lurker Below\",\n    },\n    [\"frFR\"] = {\n        lurker = \"Le Rôdeur d'En bas\",\n    },\n    [\"deDE\"] = {\n        lurker = \"Das Grauen aus der Tiefe\",\n    },\n    [\"esES\"] = {\n        lurker = \"El Rondador de abajo\",\n    },\n    [\"koKR\"] = {\n        lurker = \"심연의 잠복꾼\",\n    },\n    [\"ptBR\"] = {\n        lurker = \"O Tocaieiro Subterrâneo\",\n    },\n    [\"ruRU\"] = {\n        lurker = \"Скрытень из глубин\",\n    },\n    [\"zhCN\"] = {\n        lurker = \"鱼斯拉\",\n    },\n    [\"zhTW\"] = {\n        lurker = \"海底潛伏者\",\n    }\n}\n\naura_env.currentLocale = aura_env.locales[locale] or aura_env.locales[\"enUS\"]",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, eID, source)\n    if event == \"WA_FJI_ENCOUNTER_START\" or event == \"ENCOUNTER_START\" then\n        if eID ~= 624 then\n            return false\n        end\n        \n        aura_env.updateState(allstates)\n        aura_env.count = 1\n        \n        aura_env.preWarn(aura_env.cdStart, 3, aura_env.count)\n        aura_env.nuTimer(aura_env.cdStart, aura_env.count)\n        return true\n        \n    elseif event == \"WA_FJI_ENCOUNTER_END\" or event == \"ENCOUNTER_END\" then\n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        return true\n        \n    elseif event == \"WA_LURKER_BELOW_EMERGE\" then\n        aura_env.preWarn(aura_env.cdAfterEmerge, 3, aura_env.count)\n        aura_env.nuTimer(aura_env.cdAfterEmerge, aura_env.count)\n        return true\n        \n    elseif event == \"WA_LURKER_BELOW_SUBMERGE\" then\n        aura_env.preWarnCancel()\n        aura_env.nuTimer(nil)\n        return true\n    end\n    \n    if event == \"RAID_BOSS_EMOTE\" then\n        if (source or \"\") == aura_env.currentLocale.lurker then\n            WeakAuras.ScanEvents(\"WA_LURKER_BELOW_SPOUT\")\n            aura_env.nuTimer(0, aura_env.count)\n            aura_env.count = aura_env.count + 1\n            aura_env.preWarn(aura_env.cdWindow, 3, aura_env.count)\n            aura_env.nuTimer(aura_env.cdWindow, aura_env.count)\n            return true\n        end\n    end\nend",
["spellIds"] = {
},
["events"] = "ENCOUNTER_START, ENCOUNTER_END, WA_FJI_ENCOUNTER_END, WA_FJI_ENCOUNTER_START, RAID_BOSS_EMOTE, WA_LURKER_BELOW_EMERGE, WA_LURKER_BELOW_SUBMERGE",
