["spellIds"] = {
},
["event"] = "Health",
["dynamicDuration"] = true,
["customDuration"] = "function()\n    return aura_env.displayTime, aura_env.castTime + aura_env.displayTime\nend",
["events"] = "ANOU_GCDHISTORY_ADD",
["custom"] = "function(event, register, icon, castTime, interrupted)\n    if register == aura_env.thisRegister then\n        aura_env.icon = icon\n        aura_env.castTime = castTime\n        aura_env.xoff = 0\n        aura_env.interrupted = interrupted and true or false\n\n        if aura_env.interrupted then\n            aura_env.region:SetDesaturated(true)\n            aura_env.region:Color(1, 0.15, 0.15, 1)\n        else\n            aura_env.region:SetDesaturated(false)\n            aura_env.region:Color(1, 1, 1, 1)\n        end\n\n        return true\n    end\n\n    return false\nend",
["customIcon"] = "function()\n    return aura_env.icon\nend",
["check"] = "event",
["unit"] = "player",
["names"] = {
},
["debuffType"] = "HELPFUL",
