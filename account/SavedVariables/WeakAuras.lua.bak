["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "{\n    isCasting = \"bool\",\n    next = \"bool\",\n    expirationTime = true,\n    interrupted = \"bool\",\n}",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "OPTIONS ENCOUNTER_START ENCOUNTER_END CHAT_MSG_RAID_LEADER WA_FJI_ENCOUNTER_START WA_FJI_ENCOUNTER_END WA_RELIQUARY_P2_END WA_RELIQUARY_SS_CAST WA_RELIQUARY_SS_SUCCESS WA_RELIQUARY_SS_INTERRUPT WA_RELIQUARY_INTERRUPT_CLEAR",
["spellIds"] = {
},
["custom"] = "function(a,e,...)\n    if e == \"OPTIONS\" then\n        a[1] = {\n            show = true,\n            changed = true,\n            next = true,\n            label = 1,\n            isCasting = true,\n            progressType = \"timed\",\n            duration = 2,\n            expirationTime = GetTime()+2,\n        }\n        a[2] = {\n            show = true,\n            changed = true,\n            next = true,\n            label = 2,\n            isCasting = false,\n        }\n        a[3] = {\n            show = true,\n            changed = true,\n            next = false,\n            label = 3,\n            isCasting = false,\n        }\n        return true\n    end\n    \n    if e == \"ENCOUNTER_START\" or e == \"WA_FJI_ENCOUNTER_START\" then\n        local eID = ...\n        \n        if eID ~= 606 then\n            return false\n        end\n        \n        aura_env.encounterActive = true\n        aura_env.myTeam = nil\n        aura_env.currentTeam = 1\n        aura_env.teamCount = 0\n        aura_env.nextAlertSent = false\n        \n        for _,state in pairs(a) do\n            state.show = false\n            state.changed = true\n        end\n        \n        return true\n    end\n    \n    if e == \"ENCOUNTER_END\" or e == \"WA_FJI_ENCOUNTER_END\" or e == \"WA_RELIQUARY_P2_END\" then\n        aura_env.Reset(a)\n        return true\n    end\n    \n    if e == \"CHAT_MSG_RAID_LEADER\" then\n        if not aura_env.encounterActive then\n            return false\n        end\n        \n        local msg = ...\n        if not msg then\n            return false\n        end\n        \n        if msg == \"Reliquary Interrupt Rotation\" then\n            aura_env.myTeam = nil\n            aura_env.currentTeam = 1\n            aura_env.teamCount = 0\n            aura_env.nextAlertSent = false\n            \n            for _,state in pairs(a) do\n                state.show = false\n                state.changed = true\n            end\n            \n            return true\n        end\n        \n        local teamNum,playerText = msg:match(\"^TEAM([1-5])%-(.+)$\")\n        if not teamNum or not playerText then\n            return false\n        end\n        \n        local teamIndex = tonumber(teamNum)\n        \n        if teamIndex > aura_env.teamCount then\n            aura_env.teamCount = teamIndex\n        end\n        \n        for _,name in ipairs({ strsplit(\",\",playerText) }) do\n            if strtrim(name) == WeakAuras.me then\n                aura_env.myTeam = teamIndex\n                break\n            end\n        end\n        \n        a[teamIndex] = {\n            show = true,\n            changed = true,\n            next = (teamIndex == aura_env.currentTeam),\n            progressType = \"timed\",\n            duration = 0,\n            expirationTime = 0,\n            label = teamIndex,\n            isCasting = false,\n        }\n        \n        if teamIndex == 1 and aura_env.myTeam == 1 and not aura_env.nextAlertSent then\n            aura_env.nextAlertSent = true\n            WeakAuras.ScanEvents(\"WA_RELIQUARY_PLAYER_KICK_NEXT\",1)\n        end\n        \n        return true\n    end\n    \n    if e == \"WA_RELIQUARY_SS_CAST\" then\n        if not aura_env.encounterActive then\n            return false\n        end\n        \n        local castTime = ...\n        if not castTime then\n            return false\n        end\n        \n        local teamIndex\n        \n        for i = 1,aura_env.teamCount do\n            if a[i] and a[i].next then\n                teamIndex = i\n                break\n            end\n        end\n        \n        if not teamIndex then\n            return false\n        end\n        \n        a[teamIndex].progressType = \"timed\"\n        a[teamIndex].duration = castTime\n        a[teamIndex].expirationTime = GetTime()+castTime\n        a[teamIndex].isCasting = true\n        a[teamIndex].changed = true\n        \n        if aura_env.myTeam == teamIndex then\n            WeakAuras.ScanEvents(\"WA_RELIQUARY_PLAYER_KICK_NOW\",castTime)\n        end\n        \n        return true\n    end\n    \n    if e == \"WA_RELIQUARY_SS_INTERRUPT\" then\n        if not aura_env.encounterActive then\n            return false\n        end\n        \n        local currentIndex\n        \n        for i = 1,aura_env.teamCount do\n            if a[i] and a[i].next then\n                currentIndex = i\n                break\n            end\n        end\n        \n        if not currentIndex then\n            return false\n        end\n        \n        local state = a[currentIndex]\n        \n        state.isCasting = false\n        state.next = false\n        state.changed = true\n        \n        local newIndex = currentIndex%aura_env.teamCount+1\n        aura_env.currentTeam = newIndex\n        \n        if a[newIndex] then\n            a[newIndex].next = true\n            a[newIndex].changed = true\n        end\n        \n        if aura_env.myTeam == newIndex then\n            WeakAuras.ScanEvents(\"WA_RELIQUARY_PLAYER_KICK_NEXT\",newIndex)\n        end\n        \n        return true\n    end\n    \n    if e == \"WA_RELIQUARY_SS_SUCCESS\" then\n        if not aura_env.encounterActive then\n            return false\n        end\n        \n        local currentIndex\n        \n        for i = 1,aura_env.teamCount do\n            if a[i] and a[i].next then\n                currentIndex = i\n                break\n            end\n        end\n        \n        if not currentIndex then\n            return false\n        end\n        \n        a[currentIndex].isCasting = false\n        a[currentIndex].next = false\n        a[currentIndex].changed = true\n        \n        local newIndex = currentIndex%aura_env.teamCount+1\n        aura_env.currentTeam = newIndex\n        \n        if a[newIndex] then\n            a[newIndex].next = true\n            a[newIndex].changed = true\n        end\n        \n        if aura_env.myTeam == newIndex then\n            WeakAuras.ScanEvents(\"WA_RELIQUARY_PLAYER_KICK_NEXT\",newIndex)\n        end\n        \n        return true\n    end\n    \n    return false\nend",
["check"] = "event",
["subeventPrefix"] = "SPELL",
["custom_hide"] = "timed",
["debuffType"] = "HELPFUL",
