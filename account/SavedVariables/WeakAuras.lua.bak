["CT:[BT][Illidari] MAGE: Flamestrike"] = {
["outline"] = "OUTLINE",
["wagoID"] = "pbbuhQ899",
["parent"] = "[BT][Illidari]",
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
