},
["id"] = "ClassicAutoMarker - Mobs",
["semver"] = "1.0.2",
["justify"] = "LEFT",
["sparkHidden"] = "NEVER",
["displayText"] = "%c",
["frameStrata"] = 1,
["anchorFrameType"] = "SCREEN",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "aura_env.mobPriority = {}\naura_env.mobMarks = {}\naura_env.DEFAULT_MOB_KEY = \"DEFAULT\"\n\nfor i, mob in pairs(aura_env.config[\"mobMarks\"]) do\n    if mob.name ~= \"\" then\n        aura_env.mobPriority[mob.name] = i\n        aura_env.mobMarks[mob.name] = {}\n        for i = 1, 8 do\n            local mark = 10 - mob[\"mark_\" .. i]\n            if mark == 9 then\n                break\n            end\n            table.insert(aura_env.mobMarks[mob.name], mark)\n        end\n    end\nend\n\naura_env.hoverNum = 0\naura_env.lastUpdate = 0\n\naura_env.isKeyDown = function(key)\n    if not key or key == \"\" then\n        return false\n    end\n    \n    key = key:upper()\n    \n    if key == \"SHIFT\" then\n        return IsShiftKeyDown()\n    elseif key == \"ALT\" then\n        return IsAltKeyDown()\n    elseif key == \"CTRL\" or key == \"CONTROL\" then\n        return IsControlKeyDown()\n    end\n    \n    return IsKeyDown(key)\nend\n\nfunction handleUnit(allStates, unit, isDiscoverMode, isMarkMode)\n    local guid = UnitGUID(unit)\n    if guid == nil then\n        return false\n    end\n    \n    local state = allStates[guid]\n    \n    local targetMark = GetRaidTargetIndex(unit)\n    if state ~= nil then\n        state.isMarked = targetMark == state.mark\n        state.changed = true\n    end\n    \n    if targetMark ~= nil then\n        for sGuid, s in pairs(allStates) do\n            if s.mark == targetMark then\n                s.isMarked = sGuid == guid\n                s.changed = true\n                break\n            end\n        end\n    end\n    \n    if not (isDiscoverMode or isMarkMode) then\n        return true\n    end\n    \n    if UnitIsPlayer(unit) or UnitIsDead(unit) then\n        return true\n    end\n    \n    if not UnitCanAttack(\"player\", unit) then\n        return true\n    end\n    \n    local name = UnitName(unit)\n    local mobKey = name\n    \n    if not aura_env.mobMarks[mobKey] then\n        if aura_env.config.defaultEnable and aura_env.mobMarks[aura_env.DEFAULT_MOB_KEY] then\n            mobKey = aura_env.DEFAULT_MOB_KEY\n        else\n            return true\n        end\n    end\n    \n    if isDiscoverMode and aura_env.hoverNum == 0 then\n        for _, s in pairs(allStates) do\n            s.show = false\n            s.changed = true\n        end\n    end\n    \n    if state == nil or not state.show then\n        state = {\n            show = true,\n            changed = true,\n            progressType = \"static\",\n            value = 1,\n            total = 1,\n            icon = 0,\n            name = name,\n            mobKey = mobKey,\n            index = math.huge,\n            mark = nil,\n            isMarked = false,\n            priority = aura_env.mobPriority[name] or math.huge,\n            hoverNum = aura_env.hoverNum,\n        }\n        \n        allStates[guid] = state\n        aura_env.hoverNum = aura_env.hoverNum + 1\n    end\n    \n    local markQueue = {}\n    local assignedMarks = {}\n    \n    if isDiscoverMode then\n        for _, s in pairs(allStates) do\n            if s.show then\n                table.insert(markQueue, s)\n            end\n        end\n        \n        table.sort(markQueue, function(a, b)\n                if a.priority ~= b.priority then\n                    return a.priority < b.priority\n                end\n                return a.hoverNum < b.hoverNum\n        end)\n        \n    elseif not state.isMarked then\n        table.insert(markQueue, state)\n        \n        for sGuid, s in pairs(allStates) do\n            if s.mark ~= nil and sGuid ~= guid then\n                assignedMarks[s.mark] = true\n            end\n        end\n    end\n    \n    for _, s in ipairs(markQueue) do\n        local prevMark = s.mark\n        s.mark, s.index = nil, math.huge\n        \n        local key = s.mobKey or s.name\n        local marks = aura_env.mobMarks[key]\n        \n        if marks then\n            for _, mark in ipairs(marks) do\n                if not assignedMarks[mark] then\n                    s.mark, s.index = mark, -mark\n                    assignedMarks[mark] = true\n                    break\n                end\n            end\n        end\n        \n        s.isMarked = s.isMarked and s.mark == prevMark\n    end\n    \n    if isMarkMode and not state.isMarked then\n        SetRaidTarget(unit, state.mark or 0)\n        state.isMarked = true\n    else\n        state.isMarked = targetMark == state.mark\n    end\n    \n    return true\nend\n\naura_env.eventHandlers = {}\n\nfunction aura_env.eventHandlers.WA_FJIAM_RESET(allStates, clearAllMarks)\n    for _, s in pairs(allStates) do\n        s.show = false\n        s.changed = true\n    end\n    \n    if clearAllMarks then\n        for i = 1, 9 do\n            SetRaidTarget(\"player\", i)\n        end\n        \n        C_Timer.After(0.05, function()\n                SetRaidTarget(\"player\", 0)\n        end)\n    end\n    \n    return true\nend\n\nfunction aura_env.eventHandlers.MODIFIER_STATE_CHANGED(allStates, key, down)\n    if down == 1 and (key == \"LALT\" or key == \"LCTRL\" or key == \"RCTRL\" or key == \"RALT\") then\n        aura_env.hoverNum = 0\n    end\n    return false\nend\n\nfunction aura_env.eventHandlers.UPDATE_MOUSEOVER_UNIT(allStates)\n    local isMarkMode = aura_env.isKeyDown(aura_env.config.keybind)\n    local isDiscoverMode = aura_env.isKeyDown(aura_env.config.forceKeybind)\n    \n    return handleUnit(allStates, \"mouseover\", isDiscoverMode, isMarkMode)\nend\n\nfunction aura_env.eventHandlers.COMBAT_LOG_EVENT_UNFILTERED(allStates)\n    local _, event, _, _, _, _, _, destGuid = CombatLogGetCurrentEventInfo()\n    \n    if event ~= \"UNIT_DIED\" then\n        return false\n    end\n    \n    local state = allStates[destGuid]\n    if state ~= nil then\n        state.show = false\n        state.changed = true\n        return true\n    end\n    \n    return false\nend\n\nfunction aura_env.eventHandlers.OPTIONS(allStates)\n    for i = 1, 8 do\n        allStates[i] = {\n            show = true,\n            changed = true,\n            progressType = \"static\",\n            value = 1,\n            total = 1,\n            icon = 0,\n            name = \"Death Talon Flamescale \" .. i,\n            index = i,\n            mark = i,\n            isMarked = true,\n        }\n    end\n    \n    return true\nend",
["do_custom"] = true,
},
["finish"] = {
},
},
