{
["trigger"] = {
["unit"] = "player",
["type"] = "custom",
["custom"] = "function(a, e, ...)\n    if not _G.FJI_HEALER and not UnitIsGroupLeader(\"player\") then\n        return false\n    end\n    \n    if e == \"WA_FJI_ENCOUNTER_START\" or e == \"ENCOUNTER_START\" then\n        local eID = ...\n        if eID ~= 649 then\n            return false\n        end\n        \n        a[\"\"] = {\n            show = true,\n            changed = true,\n            lastKnown = \"none\",\n        }\n        return true\n    elseif e == \"WA_FJI_ENCOUNTER_END\" or e == \"ENCOUNTER_END\" or e == \"WA_MAULGAR_KROSH_DIED\" then\n        if a[\"\"] then\n            a[\"\"].show = false\n            a[\"\"].changed = true\n        end\n        return true\n    end\n    \n    if e == \"WA_MAULGAR_SPELL_SHIELD_APPLIED\" then\n        local guid = ...\n        if a[\"\"] then\n            a[\"\"].lastKnown = guid\n            a[\"\"].changed = true\n            return true\n        end\n    end\nend",
["custom_type"] = "stateupdate",
["check"] = "event",
["events"] = "ENCOUNTER_START, WA_FJI_ENCOUNTER_START, ENCOUNTER_END, WA_FJI_ENCOUNTER_END, WA_MAULGAR_KROSH_DIED, WA_MAULGAR_SPELL_SHIELD_APPLIED",
["debuffType"] = "HELPFUL",
["customVariables"] = "{\n    lastKnown = \"string\",\n}",
},
