["url"] = "https://wago.io/sHcW3qEUL/3",
["customText"] = "function ()\n    local miss = GetDodgeBlockParryChanceFromDefense() + 5\n    local dodge = GetDodgeChance()\n    local parry = GetParryChance()\n    local block = GetBlockChance()\n    local bv = GetShieldBlock()\n    local avoidance = (miss + dodge + parry)\n    local resil = GetCombatRatingBonus(15)\n    local ct = (avoidance + block) - 102.4\n    local ctformat = math.floor(ct * 100)/100\n    local ctcolor = \"|cffff0000\"..ctformat..\"%|r\"\n    local holy = GetSpellBonusDamage(2)\n    if (GetDodgeBlockParryChanceFromDefense() + resil) >= 5.6 then\n        ctcolor = \"|cff00ff00\"..ctformat..\"%|r\"\n    end\n    if (GetDodgeBlockParryChanceFromDefense() + resil) >= 0 then\n        ctcolor = \"|cFFFFA500\"..ctformat..\"%|r\"\n    end\n    return tonumber(string.format(\"%.2f\", miss)), (string.format(\"%.2f\", dodge)), (string.format(\"%.2f\", parry)), (string.format(\"%.2f\", avoidance)), (string.format(\"%.2f\", block)), ctcolor, (string.format(\"%.0f\", bv)), (string.format(\"%.0f\", holy))\nend",
