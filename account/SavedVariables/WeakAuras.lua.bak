["customSort"] = "WeakAuras.SortAscending{\"region\", \"state\", \"prio\"}\n--[[function(a, b)\n    local one = aura_env.child_envs[a.dataIndex]\n    local two = aura_env.child_envs[b.dataIndex]\n    if one.state and two.state then\n        local r1 = one.state.prio and one.state.prio or 0;\n        local r2 = two.state.prio and two.state.prio or 0;\n        print(one.state.link or \"M\",\"<=\",two.state.link or \"M\");\n        return r1 <= r2\n    else\n        print(\"FAIL\");\n        return a.dataIndex <= b.dataIndex\n    end\nend]]",
