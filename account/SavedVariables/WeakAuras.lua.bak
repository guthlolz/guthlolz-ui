["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["names"] = {
},
["duration"] = "20",
["event"] = "Health",
["unit"] = "player",
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 3.7,\n            expirationTime = GetTime() + 3.7,\n            progressType = \"timed\",\n            icon = 136116,\n            autoHide = true,\n            safe = \"unknown\",\n        }\n        return true\n    end\n    \n    if event == \"WA_SENTINEL_RANGE_CHECK\" then\n        local sourceGUID = ...\n        local found = false\n        local safe = \"unknown\"\n        \n        if UnitGUID(\"target\") == sourceGUID then\n            found = true\n            local range = WeakAuras.GetRange(\"target\")\n            \n            if not range then\n                safe = \"unknown\"\n            elseif range <= 9 then\n                safe = \"false\"\n            elseif range >= 15 then\n                safe = \"true\"\n            else\n                safe = \"unknown\"\n            end\n            \n        else\n            for i = 1, 40 do\n                local unit = \"nameplate\" .. i\n                if UnitGUID(unit) == sourceGUID then\n                    found = true\n                    \n                    local range = WeakAuras.GetRange(unit)\n                    \n                    if not range then\n                        safe = \"unknown\"\n                    elseif range <= 9 then\n                        safe = \"false\"\n                    elseif range >= 15 then\n                        safe = \"true\"\n                    else\n                        safe = \"unknown\"\n                    end\n                    \n                    break\n                end\n            end\n        end\n        \n        if allstates[sourceGUID] then\n            allstates[sourceGUID].safe = safe\n            allstates[sourceGUID].changed = true\n        end\n        return true\n    end\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local _,subEvent,_,sourceGUID,_,_,_,destGUID,_,_,_,spellId = ...\n        \n        if subEvent == \"UNIT_DIED\" then\n            if allstates[destGUID] then\n                allstates[destGUID].show = false\n                allstates[destGUID].changed = true\n                return true\n            end\n        end\n        \n        if spellId ~= 37106 then\n            return false\n        end\n        \n        if subEvent == \"SPELL_CAST_START\" then\n            C_Timer.NewTicker(0.1, function()\n                    WeakAuras.ScanEvents(\"WA_SENTINEL_RANGE_CHECK\", sourceGUID)\n            end, 40)\n            \n            allstates[sourceGUID] = {\n                show = true,\n                changed = true,\n                duration = 3.7,\n                expirationTime = GetTime() + 3.7,\n                progressType = \"timed\",\n                icon = 136116,\n                autoHide = true,\n                safe = \"unknown\",\n            }\n            return true\n        end\n    end\nend",
["events"] = "CLEU:SPELL_CAST_START:UNIT_DIED, WA_SENTINEL_RANGE_CHECK",
