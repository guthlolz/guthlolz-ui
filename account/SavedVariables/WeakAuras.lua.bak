["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "aura_env.spellID = 12051\naura_env.baseCast = 8\naura_env.baseTick = 4\naura_env.minManaGain = 500\n\naura_env.lastMana = UnitPower(\"player\", Enum.PowerType.Mana)\n\nfunction aura_env.getTickRate()\n    local haste = UnitSpellHaste(\"player\") / 100\n    local totalCastTime = aura_env.baseCast / (1 + haste)\n    return totalCastTime / aura_env.baseTick\nend",
