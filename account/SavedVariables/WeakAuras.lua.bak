["namerealm"] = "Tariolstrasz",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["use_itemName"] = true,
["use_unit"] = true,
["names"] = {
},
["spellIds"] = {
},
["events"] = "GOSSIP_SHOW MODIFIER_STATE_CHANGED",
["custom_type"] = "status",
["check"] = "event",
["custom"] = "function(event,key,down)\n    if event == \"MODIFIER_STATE_CHANGED\" then\n        if (key ~= \"LSHIFT\" and key ~= \"RSHIFT\") or down ~= 1 then\n            return false\n        end\n    elseif event ~= \"GOSSIP_SHOW\" then\n        return false\n    end\n    \n    if not aura_env.config.option.enable then\n        return false\n    end\n    \n    local options = C_GossipInfo.GetOptions()\n    if not options or #options == 0 then\n        return false\n    end\n    \n    if not IsShiftKeyDown() then\n        print(aura_env.colorFojji .. aura_env.colorRAID .. \": |cFFFFFFFFHold |cFFFFFF00SHIFT|r|cFFFFFFFF to force Auto-Gossip.|r\")\n        return false\n    end\n    \n    C_GossipInfo.SelectOption(options[1].gossipOptionID)\nend",
["unit"] = "target",
["custom_hide"] = "timed",
},
