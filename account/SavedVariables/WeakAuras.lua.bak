["triggers"] = {
{
["trigger"] = {
["customVariables"] = "{\n  value = true,\n  total = true,\n}",
["type"] = "custom",
["unit"] = "player",
["custom_type"] = "stateupdate",
["customStacks"] = "",
["names"] = {
},
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["customDuration"] = "",
["events"] = "WA_BLINDEYE_PRAYER_FINISHED, WA_BLINDEYE_SHIELD_REMOVED CLEU:SPELL_CAST_SUCCESS:SPELL_ABSORBED:SPELL_AURA_REMOVED",
["custom"] = "function(allStates, event, _, subEvent, _, _, _, _, _, destGUID, _, _, _, spellId, ...)\n    if event == \"OPTIONS\" then\n        allStates[1] = {\n            changed = true,\n            show = true,\n            progressType = \"static\",\n            value = math.random(1,25000),\n            total = 25000,\n        }\n        return true\n    end\n    \n    if event == \"WA_BLINDEYE_SHIELD_REMOVED\" or event == \"WA_BLINDEYE_PRAYER_FINISHED\" then\n        if allStates[1] then\n            allStates[1].show = false\n            allStates[1].changed = true\n            return true\n        end\n    end\n    \n    if subEvent == \"SPELL_AURA_REMOVED\" then\n        if not aura_env.shields[spellId] then\n            return false\n        end\n        \n        if allStates[1] then\n            allStates[1].show = false\n            allStates[1].changed = true\n            return true\n        end\n    end\n    \n    if subEvent == \"SPELL_CAST_SUCCESS\" then\n        -- Bail if cast wasn't boss's shield\n        if not aura_env.shields[spellId] then\n            return false\n        end\n        -- Reset shield amount\n        allStates[1] = {\n            changed = true,\n            show = true,\n            progressType = \"static\",\n            value = 25000,\n            total = 25000,\n        }\n        return true\n    end\n    \n    if subEvent ~= \"SPELL_ABSORBED\" then\n        return false\n    end\n    \n    -- SPELL_ABSORBED\n    -- Bail if we don't already have a state (for some reason)\n    local state = allStates[1]\n    if not state then\n        return false\n    end\n    local params = {...}\n    local numParams = #params\n    -- Bail if absorb wasn't from the boss's shield\n    local absorbSpellId = params[numParams - 3]\n    if not aura_env.shields[absorbSpellId] then\n        return false\n    end\n    -- Update shield absorb\n    local absorbAmount = params[numParams]\n    state.changed = true\n    state.value = state.value - absorbAmount\n    state.show = state.value > 0\n    return true\nend",
["spellIds"] = {
},
