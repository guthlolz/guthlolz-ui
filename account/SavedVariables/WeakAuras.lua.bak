["unit"] = "player",
["custom"] = "function(allstates,event,unit,_,spellId)\n    if spellId ~= aura_env.shadowGrasp then\n        return false\n    end\n    \n    local guid = UnitGUID(unit)\n    \n    if event == \"UNIT_SPELLCAST_CHANNEL_START\" then\n        WeakAuras.ScanEvents(\"WA_FJI_MAGTHERIDON_CHANNEL_START\", guid)\n    elseif event == \"UNIT_SPELLCAST_CHANNEL_STOP\" then\n        WeakAuras.ScanEvents(\"WA_FJI_MAGTHERIDON_CHANNEL_STOP\", guid)\n    end\nend",
