["finish"] = {
},
["init"] = {
["custom"] = "function aura_env.unitScan()\n    if UnitExists(\"target\") then\n        local guid = UnitGUID(\"target\")\n        local npcID = guid and select(6, strsplit(\"-\", guid))\n        if npcID == \"20062\" then\n            return \"target\"\n        end\n    end\n    \n    for i = 1, 40 do\n        local unit = \"nameplate\" .. i\n        if UnitExists(unit) then\n            local guid = UnitGUID(unit)\n            local npcID = guid and select(6, strsplit(\"-\", guid))\n            if npcID == \"20062\" then\n                return unit\n            end\n        end\n    end\nend\n\nfunction aura_env.updateRange(allstates)\n    local unit = aura_env.unitScan()\n    local inRange = false\n    \n    if unit then\n        local range = WeakAuras.GetRange(unit)\n        if range and range <= 12 then\n            inRange = true\n        end\n    end\n    \n    if allstates[\"\"] then\n        allstates[\"\"].inRange = inRange\n        allstates[\"\"].changed = true\n    end\nend",
["do_custom"] = true,
},
},
