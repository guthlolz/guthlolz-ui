["duration"] = "",
["event"] = "Health",
["unit"] = "player",
["events"] = "WA_VASHJ_STRIDER_PREWARN, WA_VASHJ_STRIDER_PREWARN_CANCEL, WA_NUMEN_TIMER, WA_FJI_ENCOUNTER_END, WA_FJI_ENCOUNTER_START",
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 5,\n            expirationTime = GetTime() + 5,\n            progressType = \"timed\",\n            icon = 136224,\n            count = math.random(1,10),\n        }\n        return true \n    end\n    \n    if event == \"WA_VASHJ_STRIDER_PREWARN\" then\n        local duration, count = ...\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = duration,\n            expirationTime = GetTime() + duration,\n            progressType = \"timed\",\n            icon = 136224,\n            autoHide = true,\n        }\n        return true\n    elseif event == \"WA_NUMEN_TIMER\" then\n        local key, time = ...\n        if key == \"VASHJ_STRIDER\" and (time == 0 or time == nil) then\n            if allstates[\"\"] then\n                allstates[\"\"].show = false\n                allstates[\"\"].changed = true\n                return true\n            end\n        end\n    elseif event == \"WA_FJI_ENCOUNTER_END\" or event == \"WA_FJI_ENCOUNTER_START\" or event == \"WA_VASHJ_STRIDER_PREWARN_CANCEL\" then\n        if allstates[\"\"] then\n            allstates[\"\"].show = false\n            allstates[\"\"].changed = true\n            return true\n        end\n    end\nend",
