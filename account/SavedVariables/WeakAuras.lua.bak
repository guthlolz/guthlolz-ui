["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["customVariables"] = "{\n    expirationTime = true,\n    status = \"string\",\n}",
["subeventSuffix"] = "_CAST_START",
["subeventPrefix"] = "SPELL",
["duration"] = "20",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            progressType = \"timed\",\n            icon = 135824,\n            autoHide = true,\n            count = math.random(1,10),\n            status = \"Cast\",\n        }\n        return true\n    end\n    if event == \"WA_NUMEN_TIMER\" then\n        local key, time, count = ...\n        if key == \"MAGTHERIDON_BLAST_NOVA\" and time == 0 then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = 2,\n                expirationTime = GetTime() + 2,\n                progressType = \"timed\",\n                icon = 135824,\n                autoHide = true,\n                count = count,\n                status = \"Cast\",\n            }\n            return true\n        end\n    elseif event == \"WA_MAGTHERIDON_BLAST_NOVA_CHANNEL\" then\n        local count = ...\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 10,\n            expirationTime = GetTime() + 10,\n            progressType = \"timed\",\n            icon = 135824,\n            autoHide = true,\n            count = count,\n            status = \"Channel\",\n        }\n        return true\n    end\n    \n    if event == \"WA_MAGTHERIDON_SHADOW_CAGE_APPLIED\" then\n        if allstates[\"\"] then\n            allstates[\"\"].show = false\n            allstates[\"\"].changed = true\n            return true\n        end\n    end\nend",
