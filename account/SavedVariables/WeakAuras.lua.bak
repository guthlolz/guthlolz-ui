["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.key = \"ILLIDAN_BERSERK\"\naura_env.berserk = 1500\n\nfunction aura_env.nuTimer(countdown, count)\n    WeakAuras.ScanEvents(\"WA_NUMEN_TIMER\", aura_env.key, countdown, count)\nend\n\nfunction aura_env.updateState(allstates)\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n    }\nend\n\nfunction aura_env.hideState(allstates)\n    if allstates[\"\"] then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\nend",
},
["finish"] = {
["custom"] = "aura_env.nuTimer(nil)",
["do_sound"] = false,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
["do_message"] = false,
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "ENCOUNTER_START, WA_FJI_ENCOUNTER_START",
["spellIds"] = {
},
["custom"] = "function(allstates,event,eID)\n    if event == \"WA_FJI_ENCOUNTER_START\" or event == \"ENCOUNTER_START\" then\n        if eID ~= 609 then\n            return false\n        end\n        \n        aura_env.updateState(allstates)\n        aura_env.nuTimer(aura_env.berserk, 1)\n        return true\n    end\nend",
