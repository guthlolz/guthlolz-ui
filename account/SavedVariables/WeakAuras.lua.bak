["custom"] = "function(allstates, event)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            icon = 135859,\n        }\n        return true\n    end\n    \n    if event == \"WA_HYDROSS_TOMB_APPLIED\" then  \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            icon = 135859,\n            progressType = \"timed\",\n            autoHide = true,\n            duration = 2.5,\n            expirationTime = GetTime() + 2.5,\n        }\n        return true\n    end\nend",
