["custom"] = "aura_env.has_auras = function()\n    local has_command = C_UnitAuras.GetAuraDataBySpellName('player', 'Seal of Command')\n    local time_command = false\n    if has_command then time_command = (has_command.expirationTime - GetTime()) < 1 end\n    local has_right = C_UnitAuras.GetAuraDataBySpellName('player', 'Seal of Righteousness')\n    local has_blood = C_UnitAuras.GetAuraDataBySpellName('player', 'Seal of Blood') or C_UnitAuras.GetAuraDataBySpellName('player', 'Seal of the Martyr')\n    \n    if aura_env.config[\"wa_debug\"] then\n        if has_command then \n            print(\"SoC Present!\")\n            print((has_command.expirationTime - GetTime()))\n        end\n        if has_right then print(\"SoR Present!\") end\n        if has_blood then print(\"SoB Present!\") end\n    end\n    \n    return (has_command and time_command) and (has_right or has_blood)\nend",
["do_custom"] = true,
},
},
