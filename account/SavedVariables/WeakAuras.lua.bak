["custom"] = "local locale = GetLocale()\n\naura_env.locales = {\n    [\"enUS\"] = {\n        p2 = \"^I become\",\n        split1 = \"I will crush your delusions of grandeur!\",\n        split2 = \"You are hopelessly outmatched!\",\n    },\n    [\"frFR\"] = {\n        p2 = \"^Je ne fais plus\",\n        split1 = \"Je vais balayer vos illusions de grandeur !\",\n        split2 = \"Vous êtes désespérément surclassés !\",\n    },\n    [\"deDE\"] = {\n        p2 = \"Ich werde eins mit der Leere!\",\n        split1 = \"Ich werde Euch Euren Hochmut austreiben!\",\n        split2 = \"Ihr seid eindeutig in der Unterzahl!\",\n    },\n    [\"esES\"] = {\n        p2 = \"Me FUNDO... ¡con el VACÍO!\",\n        split1 = \"¡Aplastaré vuestros delirios de grandeza!\",\n        split2 = \"¡Os superamos con creces!\",\n    },\n    [\"koKR\"] = {\n        p2 = \"나는 공허의\",\n        split1 = \"그 오만한 콧대를 꺾어주마!\",\n        split2 = \"한 줌의 희망마저 짓밟아주마!\",\n    },\n    [\"ruRU\"] = {\n        p2 = \"Я сольюсь... с БЕЗДНОЙ!\",\n        split1 = \"Я навсегда избавлю вас от мании величия!\",\n        split2 = \"Вы безнадежно слабы!\",\n    },\n    [\"zhCN\"] = {\n        p2 = \"^我受够了！现在我要让你们看看宇宙的愤怒！\",\n        split1 = \"我要让你们自以为是的错觉荡然无存！\",\n        split2 = \"你们势单力薄！\",\n    },\n    [\"zhTW\"] = {\n        p2 = \"夠了!現在我要呼喚宇宙中失衡的能量。\",\n        split1 = \"我會粉碎你那偉大的夢想\",\n        split2 = \"我的實力遠勝於你!\",\n    }\n}\n\naura_env.currentLocale = aura_env.locales[locale] or aura_env.locales[\"enUS\"]",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, ...)\n    if event == \"CHAT_MSG_MONSTER_YELL\" then\n        local msg = ...\n        if msg:find(aura_env.currentLocale.p2) or msg == aura_env.currentLocale.p2 then\n            WeakAuras.ScanEvents(\"WA_SOLARIAN_P2_START\")\n            return true\n        elseif msg:find(aura_env.currentLocale.split1) or msg == aura_env.currentLocale.split1 then\n            WeakAuras.ScanEvents(\"WA_SOLARIAN_SPLIT\")\n            return true\n        elseif msg:find(aura_env.currentLocale.split2) or msg == aura_env.currentLocale.split2 then\n            WeakAuras.ScanEvents(\"WA_SOLARIAN_SPLIT\")\n            return true\n        end\n    end\nend",
