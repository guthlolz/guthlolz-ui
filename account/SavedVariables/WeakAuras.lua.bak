["actions"] = {
["start"] = {
["do_custom"] = false,
["sound"] = "Interface\\AddOns\\WeakAuras\\Media\\Sounds\\BikeHorn.ogg",
["custom"] = "",
["do_sound"] = false,
},
["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.spellMaxDamage = {}\naura_env.deaden = false\naura_env.predictedDamage = 0\naura_env.active = false\naura_env.critModifier = 2\n\nfunction aura_env.updateState(allstates)\n    if not aura_env.active then\n        return\n    end\n    \n    local health = UnitHealth(\"player\")\n    local maxHealth = UnitHealthMax(\"player\")\n    local damage = aura_env.predictedDamage or 0\n    \n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n        progressType = \"static\",\n        value = health,\n        total = maxHealth,\n        health = health,\n        maxHealth = maxHealth,\n        damage = damage,\n        lethal = damage > 0 and damage >= health,\n        additionalProgress = {\n            {\n                min = math.max(0,health-damage),\n                max = health,\n            },\n        },\n    }\nend\n\nfunction aura_env.updateCritModifier()\n    aura_env.critModifier = 2\n    \n    local class = UnitClassBase(\"player\")\n    if class == \"MAGE\" then\n        if IsPlayerSpell(11129) then\n            aura_env.critModifier = 1.5\n        elseif IsPlayerSpell(31687) then\n            local _,_,_,_,iceShards = GetTalentInfo(3,15)\n            aura_env.critModifier = 1.5 + (iceShards or 0) * 0.1\n        else\n            local _,_,_,_,spellPower = GetTalentInfo(1,23)\n            aura_env.critModifier = 1.5 + (spellPower or 0) * 0.125\n        end\n    elseif class == \"WARLOCK\" then\n        local _,_,_,_,ruin = GetTalentInfo(3,9)\n        aura_env.critModifier = ruin == 1 and 2 or 1.5\n    elseif class == \"DRUID\" then\n        local _,_,_,_,vengeance = GetTalentInfo(1,12)\n        aura_env.critModifier = 1.5 + (vengeance or 0) * 0.1\n    elseif class == \"SHAMAN\" then\n        local _,_,_,_,elementalFury = GetTalentInfo(1,5)\n        aura_env.critModifier = elementalFury == 1 and 2 or 1.5\n    elseif class == \"PRIEST\" then\n        aura_env.critModifier = 1.5\n    end\nend",
},
["finish"] = {
},
},
