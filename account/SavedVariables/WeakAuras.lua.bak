["triggers"] = {
{
["trigger"] = {
["auranames"] = {
"Rapid Fire",
},
["dynamicDuration"] = true,
["customIcon"] = "function()\n    return aura_env.icon\nend",
["subeventPrefix"] = "SPELL",
["debuffType"] = "HELPFUL",
["custom_hide"] = "timed",
["type"] = "custom",
["useName"] = true,
["subeventSuffix"] = "_CAST_START",
["custom_type"] = "stateupdate",
["spellIds"] = {
},
["event"] = "Health",
["customStacks"] = "function()\n    return aura_env.stacks\nend",
["customDuration"] = "function()\n    return aura_env.duration, aura_env.expirationTime\nend",
["customName"] = "function()\n    return aura_env.name\nend",
["events"] = "PLAYER_EQUIPMENT_CHANGED, UNIT_AURA:player",
["custom"] = "function(allstates, event, ...)\n    if event == \"PLAYER_EQUIPMENT_CHANGED\" then\n        local slot = ...\n        if slot == aura_env.slot then\n            aura_env.buffActive = {}\n            \n            for _, state in pairs(allstates) do\n                state.show = false\n                state.changed = true\n                state.duration = 0\n                state.expirationTime = 0\n            end\n            return true\n        end\n        return\n    end\n    \n    if not aura_env.currentTrinket then\n        return\n    end\n    \n    local trinket = aura_env.currentTrinket\n    local stackId = trinket.stackId\n    local buffIds = trinket.buffIds or (trinket.buffId and { trinket.buffId })\n    \n    if stackId then\n        local name, icon, count, _, duration, expirationTime, _, _, _, spellId = aura_env.getBuffInfo(stackId)\n        if spellId == stackId then\n            local Icon = icon\n            if aura_env.config.trinketIcon then\n                Icon = GetInventoryItemTexture(\"player\", aura_env.slot)\n            end\n            \n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = duration,\n                expirationTime = expirationTime,\n                icon = Icon,\n                name = name,\n                stacks = count,\n                autoHide = true,\n                progressType = \"timed\",\n            }\n            return true\n        end\n    end\n    \n    if buffIds then\n        for _, buffId in ipairs(buffIds) do\n            local name, icon, count, _, duration, expirationTime, _, _, _, spellId = aura_env.getBuffInfo(buffId)\n            if spellId == buffId then\n                local Icon = icon\n                if aura_env.config.trinketIcon then\n                    Icon = GetInventoryItemTexture(\"player\", aura_env.slot)\n                end\n                \n                allstates[\"\"] = {\n                    show = true,\n                    changed = true,\n                    duration = duration,\n                    expirationTime = expirationTime,\n                    icon = Icon,\n                    name = name,\n                    stacks = count,\n                    autoHide = true,\n                    progressType = \"timed\",\n                }\n                return true\n            end\n        end\n    end\n    \n    aura_env.buffActive[trinket.itemId] = nil\n    \n    allstates[\"\"] = {\n        show = false,\n        changed = true,\n        duration = 0,\n        expirationTime = 0,\n    }\n    return true\nend",
["check"] = "event",
["unit"] = "player",
["names"] = {
},
["customVariables"] = "{\n    stacks = \"number\",\n}",
},
["untrigger"] = {
["custom"] = "function(event, unit)\n    local itemId = GetInventoryItemID(\"player\", aura_env.slot)\n    if itemId then\n        for _, trinketInfo in ipairs(aura_env.trinketBuffs) do\n            if trinketInfo.itemId == itemId then\n                local buffIds = type(trinketInfo.buffId) == \"table\" and trinketInfo.buffId or {trinketInfo.buffId}\n                for _, buffId in ipairs(buffIds) do\n                    local _, _, _, _, _, _, _, _, _, spellId = WA_GetUnitBuff(\"player\", buffId)\n                    if spellId == buffId then\n                        return false\n                    end\n                end\n            end\n        end\n    end\n    return true\nend",
},
},
