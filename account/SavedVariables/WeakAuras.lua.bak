{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["names"] = {
},
["subeventSuffix"] = "_CAST_START",
["spellIds"] = {
},
["events"] = "ZONE_CHANGED_INDOORS STATUS UPDATE_INVENTORY_DURABILITY",
["check"] = "event",
["custom"] = "function(allstates,event)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 10,\n            expirationTime = GetTime()+10,\n            autoHide = true,\n            durability = \"42%\",\n        }\n        return true\n    end\n    \n    if event == \"UPDATE_INVENTORY_DURABILITY\" then\n        if allstates[\"\"] and allstates[\"\"].show then\n            allstates[\"\"].show = false\n            allstates[\"\"].changed = true\n            return true\n        end\n    end\n    \n    if event ~= \"STATUS\" and event ~= \"ZONE_CHANGED_INDOORS\" then\n        return false\n    end\n    \n    if GetSubZoneText() ~= \"Sanctuary of Shadows\" then\n        return false\n    end\n    \n    local total = 0\n    local count = 0\n    \n    for slot = 1,18 do\n        local current,max = GetInventoryItemDurability(slot)\n        \n        if current and max and max > 0 then\n            total = total+(current/max)\n            count = count+1\n        end\n    end\n    \n    if count == 0 then\n        return false\n    end\n    \n    local durability = total/count*100\n    \n    if durability < 50 then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 10,\n            expirationTime = GetTime()+10,\n            autoHide = true,\n            durability = string.format(\"%.0f%%\",durability),\n        }\n        return true\n    end\n    \n    return false\nend",
["subeventPrefix"] = "SPELL",
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
