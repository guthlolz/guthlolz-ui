["duration"] = "1",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(a, e, ...)\n    if e == \"OPTIONS\" then\n        a[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 20,\n            expirationTime = GetTime() + 20,\n            autoHide = true,\n        }\n        return true\n    end\n    \n    if e == \"CHAT_MSG_RAID_LEADER\" then\n        local msg, _, _, _, _, _, _, _, _, _, _, guid = ...\n        if msg == aura_env.command and guid == WeakAuras.myGUID then\n            a[\"\"] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = 20,\n                expirationTime = GetTime() + 20,\n                autoHide = true,\n                status = \"Running\",\n            }\n        end\n        return true\n    end\nend",
