["custom"] = "function(allstates, event, key, time, count)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 22,\n            expirationTime = GetTime() + 22,\n            progressType = \"timed\",\n            icon = 136030,\n            autoHide = true,\n        }\n        return true\n    end\n    \n    if event == \"WA_NUMEN_TIMER\" and key == \"VASHJ_TAINTED\" then\n        if time == 0 then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = 22,\n                expirationTime = GetTime() + 22,\n                progressType = \"timed\",\n                icon = 136030,\n                autoHide = true,\n            }\n        elseif time == nil or time > 0 then\n            if allstates[\"\"] then\n                allstates[\"\"].show = false\n                allstates[\"\"].changed = true\n            end\n        end\n        return true\n    end\nend",
