["customTriggerLogic"] = "function(t)\n    if not aura_env.config.option.apShow then\n        return false\n    end\n    \n    if aura_env.config.option.always then\n        return t[1] and t[3]\n    end\n    \n    if aura_env.config.option.missing then\n        return t[2] and t[3]\n    end\nend",
