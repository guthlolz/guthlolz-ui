["custom"] = "function(allstates,event)\n    if event == \"WA_FJI_MOTHER_KILLED\" then\n        aura_env.saved.motherKilledAt = time()\n    end\n    \n    if not aura_env.saved.motherKilledAt or time() - aura_env.saved.motherKilledAt >= 120 then\n        if allstates[\"\"] and allstates[\"\"].show then\n            allstates[\"\"].show = false\n            allstates[\"\"].changed = true\n            return true\n        end\n        return false\n    end\n    \n    for slot = 1,19 do\n        local itemID = GetInventoryItemID(\"player\",slot)\n        \n        if itemID and aura_env.items[itemID] then\n            local name,_,_,_,_,_,_,_,_,icon = GetItemInfo(itemID)\n            \n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                progressType = \"static\",\n                itemID = itemID,\n                name = name,\n                icon = icon,\n            }\n            return true\n        end\n    end\n    \n    if allstates[\"\"] and allstates[\"\"].show then\n        allstates[\"\"].show = false\n        allstates[\"\"].changed = true\n        return true\n    end\n    \n    return false\nend",
["subeventPrefix"] = "SPELL",
["debuffType"] = "HELPFUL",
