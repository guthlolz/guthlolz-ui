["event"] = "Health",
["unit"] = "player",
["custom"] = "function(allstates,event,msg)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 1,\n            expirationTime = GetTime() + 1,\n            autoHide = true,\n        }\n        return true\n    end\n    \n    if event == \"CHAT_MSG_RAID_LEADER\" and msg == \"!sr\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 1,\n            expirationTime = GetTime() + 1,\n            autoHide = true,\n        }\n        return true\n    end\nend",
