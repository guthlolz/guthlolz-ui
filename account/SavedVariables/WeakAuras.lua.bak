["CT:[BT][Illidan] Shadow Blast"] = {
["outline"] = "OUTLINE",
["wagoID"] = "pbbuhQ899",
["parent"] = "[BT][Illidan]",
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/FojjiBT-P1/12",
["actions"] = {
["start"] = {
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.spellID = 41078\n\nfunction aura_env.unitTargetScan(sourceGUID)\n    local unit = \"target\"\n    if UnitExists(unit) and UnitGUID(unit) == sourceGUID then \n        return unit \n    end\n    unit = \"focus\"\n    if UnitExists(unit) and UnitGUID(unit) == sourceGUID then \n        return unit \n    end\n    for i = 1,40 do\n        unit = \"nameplate\"..i\n        if UnitExists(unit) and UnitGUID(unit) == sourceGUID then \n            return unit \n        end\n    end\n    for grpUnit in WA_IterateGroupMembers() do\n        unit = grpUnit .. \"target\"\n        if UnitExists(unit) and UnitGUID(unit) == sourceGUID then\n            return unit\n        end\n    end\n    return nil\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "",
["do_sound"] = false,
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\aggro.ogg",
["do_message"] = false,
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "",
["custom_type"] = "stateupdate",
["event"] = "Health",
["names"] = {
},
["unit"] = "player",
["events"] = "CLEU:SPELL_CAST_START",
["spellIds"] = {
},
["custom"] = "function(allstates,event,_,subEvent,_,sourceGUID,_,_,_,destGUID,destName,destFlags,_,spellId)\n    if spellId ~= aura_env.spellID then\n        return false\n    end\n    \n    if subEvent == \"SPELL_CAST_START\" then\n        WeakAuras.ScanEvents(\"WA_ILLIDAN_SHADOW_BLAST_CAST\")\n        C_Timer.After(0.05,function()\n                local unit = aura_env.unitTargetScan(sourceGUID)\n                if not unit then\n                    return\n                end\n                \n                local target = unit..\"target\"\n                if not UnitExists(target) then\n                    return\n                end\n                WeakAuras.ScanEvents(\"WA_ILLIDAN_SHADOW_BLAST_TARGET\", UnitGUID(target), UnitName(target))\n        end)\n        return false\n    end\n    return false\nend",
["check"] = "event",
["subeventPrefix"] = "SPELL",
["custom_hide"] = "timed",
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
},
},
["disjunctive"] = "any",
["customTriggerLogic"] = "",
