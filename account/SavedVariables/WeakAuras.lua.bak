["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["names"] = {
},
["duration"] = "1",
["event"] = "Health",
["unit"] = "player",
["subeventPrefix"] = "SPELL",
["custom"] = "function(a, e, ...)\n    if e == \"OPTIONS\" then\n        for i = 1, 25 do\n            a[i] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = 10,\n                expirationTime = GetTime() + 10,\n                autoHide = true,\n                name = WeakAuras.me,\n                version = \"No Response\",\n            }\n        end\n        return true\n    end\n    \n    if e == \"CHAT_MSG_RAID_LEADER\" then\n        local msg, _, _, _, _, _, _, _, _, _, _, guid = ...\n        if msg == aura_env.command and guid == WeakAuras.myGUID then\n            if UnitIsGroupLeader(\"player\") then\n                _G.SyncEvents(\"RAID\", nil, aura_env.request)\n            end\n            \n            for unit in WA_IterateGroupMembers() do\n                if UnitExists(unit) then\n                    local name = UnitName(unit)\n                    a[name] = {\n                        show = true,\n                        changed = true,\n                        progressType = \"timed\",\n                        duration = 20,\n                        expirationTime = GetTime() + 20,\n                        autoHide = true,\n                        name = name,\n                        version = \"No Response\",\n                    }\n                end\n            end\n            return true\n        end\n    end\n    \n    if e == aura_env.respond then\n        local name, version = ...\n        \n        if a[name] then\n            a[name].changed = true\n            a[name].version = version\n            return true\n        end\n    end\nend",
