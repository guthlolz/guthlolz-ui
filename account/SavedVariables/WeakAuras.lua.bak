["custom"] = "function(allstates, event)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 3,\n            expirationTime = GetTime() + 3,\n            name = \"Phase 2\",\n            autoHide = true,\n            icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\reliquary.jpg\",\n        }\n        return true\n    end\n    \n    if event == \"WA_RELIQUARY_P2_START\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 3,\n            expirationTime = GetTime() + 3,\n            name = \"Phase 2\",\n            autoHide = true,\n            icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\reliquary.jpg\",\n        }\n        return true\n    elseif event == \"WA_RELIQUARY_P3_START\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 3,\n            expirationTime = GetTime() + 3,\n            name = \"Phase 3\",\n            autoHide = true,\n            icon = \"Interface\\\\AddOns\\\\FojjiCore\\\\textures\\\\TBC Icon\\\\reliquary.jpg\",\n        }\n        return true\n    end\nend",
