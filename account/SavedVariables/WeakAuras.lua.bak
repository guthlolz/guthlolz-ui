["custom"] = "function(allstates, event)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 20,\n            expirationTime = GetTime() + 20,\n            progressType = \"timed\",\n            autoHide = true,\n        }\n        return true\n    end\n    \n    if event == \"WA_SOLARIAN_SPLIT\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 20,\n            expirationTime = GetTime() + 20,\n            progressType = \"timed\",\n            autoHide = true,\n        }\n        return true\n    end\nend",
