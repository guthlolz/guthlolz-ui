["[CL]:Paladin - MH Swing [PROT][v2]"] = {
["sparkWidth"] = 6,
["iconSource"] = -1,
["authorOptions"] = {
{
["text"] = "|TInterface/Icons/classicon_paladin:14:14|t Fojji - Paladin UI [Customization] |TInterface/Icons/classicon_paladin:14:14|t",
["type"] = "description",
["fontSize"] = "large",
["width"] = 2,
},
{
["type"] = "space",
["variableWidth"] = true,
["height"] = 1,
["useHeight"] = false,
["width"] = 2,
},
{
["subOptions"] = {
{
["type"] = "toggle",
["default"] = true,
["key"] = "retAsProt",
["name"] = "Use Ret Swing Timer as Prot",
["useDesc"] = false,
["width"] = 1,
},
},
["hideReorder"] = true,
["useDesc"] = false,
["nameSource"] = 0,
["name"] = "Configure Swing Timer",
["width"] = 1,
["useCollapse"] = true,
["noMerge"] = false,
["collapse"] = false,
["type"] = "group",
["limitType"] = "none",
["groupType"] = "simple",
["key"] = "option",
["size"] = 10,
},
},
["adjustedMax"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["sparkRotation"] = 0,
["url"] = "https://wago.io/FojjiPaladinTBC/25",
["actions"] = {
["start"] = {
["custom"] = "\n\n",
["do_custom"] = false,
},
["finish"] = {
["do_glow"] = false,
["do_sound"] = false,
["sound"] = "Interface\\AddOns\\WeakAuras\\Media\\Sounds\\Applause.ogg",
["glow_frame"] = "WeakAurasOptions",
},
["init"] = {
["custom"] = "aura_env.gcdTickEnd = aura_env.region.subRegions[3]\naura_env.gcdExp = nil\naura_env.swingExp = nil\naura_env.swingDur = nil\n\naura_env.useMeleeSpeed = true -- test\n\nfunction aura_env.getWeaponSpeed()\n    if aura_env.useMeleeSpeed then\n        local mh = select(1, UnitAttackSpeed(\"player\"))\n        if mh and mh > 0 then\n            return mh\n        end\n    end\n    \n    local rs = select(1, UnitRangedDamage(\"player\"))\n    if rs and rs > 0 then\n        return rs\n    end\n    \n    return 0\nend\n\nfunction aura_env.hasActiveSwing(now)\n    return aura_env.swingExp and aura_env.swingDur and (aura_env.swingExp - now) > 0\nend\n\nfunction aura_env.placeTickVirtual()\n    local now = GetTime()\n    local dur = aura_env.getWeaponSpeed()\n    \n    if dur <= 0 or not aura_env.gcdExp then\n        return\n    end\n    \n    local gcdRem = aura_env.gcdExp - now\n    \n    if gcdRem <= 0 then\n        return\n    end\n    \n    local pos = gcdRem\n    if pos > dur then\n        pos = dur\n    end\n    \n    local placement = dur - pos\n    aura_env.gcdTickEnd:SetTickPlacement(placement)\nend\n\nfunction aura_env.placeTickReal()\n    local now = GetTime()\n    \n    if not aura_env.hasActiveSwing(now) then\n        aura_env.placeTickVirtual()\n        return\n    end\n    \n    local swingStart = aura_env.swingExp - aura_env.swingDur\n    local delta = aura_env.gcdExp - swingStart\n    \n    if delta <= 0 then\n        return\n    end\n    \n    local rollover = delta % aura_env.swingDur\n    if rollover == 0 then\n        rollover = aura_env.swingDur\n    end\n    \n    local placement = aura_env.swingDur - rollover\n    aura_env.gcdTickEnd:SetTickPlacement(placement)\nend",
["do_custom"] = true,
},
},
["fontFlags"] = "OUTLINE",
["icon_color"] = {
1,
1,
1,
1,
},
["enableGradient"] = false,
["keepAspectRatio"] = false,
